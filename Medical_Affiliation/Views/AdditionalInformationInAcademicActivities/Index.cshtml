<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

        // =========================================================
    // TOT PROGRAMMES CONDUCTED
    // =========================================================

    function toggleConductedCount() {

        const selected = document.querySelector(
            'input[name="HasTOTProgrammesConducted"]:checked'
        );

        const section = document.getElementById(
            "conductedCountSection"
        );

        const input = document.getElementById(
            "TotprogrammesConducted"
        );

        if (!selected) {
            section.style.display = "none";
            return;
        }

        if (selected.value === "true") {

            // YES → show number field
            section.style.display = "block";

        } else {

            // NO → hide and reset
            section.style.display = "none";

            if (input) {
                input.value = "0";
            }
        }
    }


    // =========================================================
    // TOT PROGRAMMES ATTENDED
    // =========================================================

    function toggleAttendedCount() {

        const selected = document.querySelector(
            'input[name="HasTOTProgrammesAttended"]:checked'
        );

        const section = document.getElementById(
            "attendedCountSection"
        );

        const input = document.getElementById(
            "TotprogrammesAttended"
        );

        if (!selected) {
            section.style.display = "none";
            return;
        }

        if (selected.value === "true") {

            // YES → SHOW number field
            section.style.display = "block";

        } else {

            // NO → HIDE number field
            section.style.display = "none";

            if (input) {
                input.value = "0";
            }
        }
    }


    // =========================================================
    // INITIALIZE WHEN PAGE LOADS
    // =========================================================

    document.addEventListener("DOMContentLoaded", function () {

        toggleConductedCount();
        toggleAttendedCount();

    });


    // ========================================================= 
    // CME FILE 
    // ========================================================= 
    function handleCMEFileChange(input) { 
        const file = input.files[0]; 
        const display = document.getElementById("cmeFileDisplay"); 
        if (!file) { 
            display.style.display = "none"; 
            return; 
        } 
        const isPdf = file.type === "application/pdf" || file.name.toLowerCase().endsWith(".pdf"); 
        if (!isPdf) { 
            Swal.fire({ 
                icon: "error", 
                title: "Invalid File Type", 
                text: "Only PDF files are allowed.", 
                confirmButtonColor: "#1a4c8b" 
            }); 
            input.value = ""; 
            display.style.display = "none"; 
            return; 
        } 
        const maxSize = 2 * 1024 * 1024; 
        if (file.size > maxSize) { 
            Swal.fire({ 
                icon: "error", 
                title: "File Too Large", 
                text: "File size must not exceed 2 MB.", 
                confirmButtonColor: "#1a4c8b" 
            }); input.value = ""; 
            display.style.display = "none"; 
            return; 
        } 
        display.querySelector(".name-text").textContent = file.name; 
        display.style.display = "flex"; 
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <text>
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: '@Html.Raw(TempData["SuccessMessage"])',
                confirmButtonColor: '#1a4c8b',
                confirmButtonText: 'OK'
            });
        </text>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <text>
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: '@Html.Raw(TempData["ErrorMessage"])',
                confirmButtonColor: '#d33',
                confirmButtonText: 'OK'
            });
        </text>
    }


    // =========================================================
    // REMOVE CME FILE
    // =========================================================

    function removeCMEFile() {

        const input =
            document.getElementById("CMEProgrammePdf");

        const display =
            document.getElementById("cmeFileDisplay");

        input.value = "";

        display.style.display = "none";
    }


</script>

<script>

    // =========================================================
    // CONFERENCES CONDUCTED - JavaScript
    // =========================================================

    let conductedConferenceIndex = 0;


    // =========================================================
    // ADD CONFERENCE (Conducted)
    // =========================================================

    function addConductedConference() {

        const container = document.getElementById("conductedConferenceContainer");
        const template = document.getElementById("conductedConferenceTemplate");

        if (!container) {
            console.error("conductedConferenceContainer not found.");
            return;
        }

        if (!template) {
            console.error("conductedConferenceTemplate not found.");
            return;
        }

        // Get template HTML
        let html = template.innerHTML;

        // Replace all __INDEX__ placeholders
        html = html.replace(/__INDEX__/g, conductedConferenceIndex);

        // Add row/card
        container.insertAdjacentHTML("beforeend", html);

        // Increase index for next conference
        conductedConferenceIndex++;

        updateConductedConferenceEmptyState();
        updateConductedConferenceNumbers();
    }


    // =========================================================
    // REMOVE CONFERENCE (Conducted)
    // =========================================================

    function removeConductedConference(button) {

        const item = button.closest(".conference-item");

        if (!item) {
            return;
        }

        Swal.fire({
            icon: "warning",
            title: "Remove Conference?",
            text: "Are you sure you want to remove this conference?",
            showCancelButton: true,
            confirmButtonText: "Yes, Remove",
            cancelButtonText: "Cancel",
            confirmButtonColor: "#dc3545"
        }).then((result) => {

            if (result.isConfirmed) {

                item.remove();

                updateConductedConferenceEmptyState();
                updateConductedConferenceNumbers();
                reindexConductedConferences();

            }

        });
    }


    // =========================================================
    // UPDATE CONFERENCE NUMBERS (Conducted)
    // =========================================================

    function updateConductedConferenceNumbers() {

        const items =
            document.querySelectorAll("#conductedConferenceContainer .conference-item");

        items.forEach((item, index) => {

            const number =
                item.querySelector(".conference-number");

            if (number) {
                number.textContent =
                    String(index + 1).padStart(2, "0");
            }

        });
    }


    // =========================================================
    // REINDEX CONFERENCES (Conducted)
    //
    // Required after removing a row so ASP.NET Core
    // model binding receives:
    //
    // ConferencesConducted[0]
    // ConferencesConducted[1]
    // ConferencesConducted[2]
    //
    // instead of:
    //
    // ConferencesConducted[0]
    // ConferencesConducted[2]
    // =========================================================

    function reindexConductedConferences() {

        const conferences =
            document.querySelectorAll(
                "#conductedConferenceContainer .conference-item"
            );


        conferences.forEach((conference, index) => {

            // ---------------------------------------------
            // Update name attributes
            // ---------------------------------------------

            const inputs =
                conference.querySelectorAll(
                    "input, select, textarea"
                );


            inputs.forEach(input => {

                if (!input.name)
                    return;


                input.name =
                    input.name.replace(
                        /ConferencesConducted\[\d+\]/g,
                        `ConferencesConducted[${index}]`
                    );

            });


            // ---------------------------------------------
            // Update ID attributes if required
            // ---------------------------------------------

            const elements =
                conference.querySelectorAll("[id]");


            elements.forEach(element => {

                if (!element.id)
                    return;

                element.id =
                    element.id.replace(
                        /ConferencesConducted_\d+__/g,
                        `ConferencesConducted_${index}__`
                    );

            });

        });


        // Keep index ready for next addition
        conductedConferenceIndex =
            conferences.length;
    }


    // =========================================================
    // EMPTY STATE (Conducted)
    // =========================================================

    function updateConductedConferenceEmptyState() {

        const container =
            document.getElementById("conductedConferenceContainer");

        const empty =
            document.getElementById("conductedConferenceEmptyState");

        if (!container || !empty) {
            return;
        }

        const items =
            container.querySelectorAll(".conference-item");

        empty.style.display =
            items.length === 0 ? "block" : "none";
    }


    // =========================================================
    // INITIALIZE EXISTING RECORDS (Conducted)
    // =========================================================

    document.addEventListener("DOMContentLoaded", function () {

        const container =
            document.getElementById("conductedConferenceContainer");

        if (container) {

            const items =
                container.querySelectorAll(".conference-item");

            // Continue indexing after existing records
            conductedConferenceIndex = items.length;

        }

        updateConductedConferenceEmptyState();
        updateConductedConferenceNumbers();

    });

</script>

<script>

    /* ==========================================================
       CONFERENCES ATTENDED
       ========================================================== */

    let attendedConferenceIndex = 0;


    /* ==========================================================
       INITIALIZE
       ========================================================== */

    document.addEventListener("DOMContentLoaded", function () {

        const container =
            document.getElementById("attendedConferenceContainer");

        if (container) {

            const existingItems =
                container.querySelectorAll(".conference-item");

            attendedConferenceIndex = existingItems.length;
        }

        updateAttendedConferenceNumbers();
        updateAttendedConferenceEmptyState();
    });


    /* ==========================================================
       ADD CONFERENCE
       ========================================================== */

    function addAttendedConference() {

        const container =
            document.getElementById("attendedConferenceContainer");

        const template =
            document.getElementById("attendedConferenceTemplate");

        if (!container || !template) {

            console.error(
                "Attended conference container/template not found."
            );

            return;
        }


        /* ------------------------------------------------------
           Get template HTML
           ------------------------------------------------------ */

        let html = template.innerHTML;


        /* ------------------------------------------------------
           Replace __INDEX__ with current index
           ------------------------------------------------------ */

        html = html.replace(
            /__INDEX__/g,
            attendedConferenceIndex
        );


        /* ------------------------------------------------------
           Add conference
           ------------------------------------------------------ */

        container.insertAdjacentHTML(
            "beforeend",
            html
        );


        /* ------------------------------------------------------
           Increment index
           ------------------------------------------------------ */

        attendedConferenceIndex++;


        /* ------------------------------------------------------
           Update UI
           ------------------------------------------------------ */

        updateAttendedConferenceNumbers();

        updateAttendedConferenceEmptyState();
    }


    /* ==========================================================
       REMOVE CONFERENCE
       ========================================================== */

    function removeAttendedConference(button) {

        if (!button) {
            return;
        }


        const conferenceItem =
            button.closest(".conference-item");


        if (!conferenceItem) {
            return;
        }


        /* ------------------------------------------------------
           Remove item
           ------------------------------------------------------ */

        conferenceItem.remove();


        /* ------------------------------------------------------
           Update numbering
           ------------------------------------------------------ */

        updateAttendedConferenceNumbers();


        /* ------------------------------------------------------
           Update empty state
           ------------------------------------------------------ */

        updateAttendedConferenceEmptyState();
    }


    /* ==========================================================
       UPDATE CONFERENCE NUMBERS
       ========================================================== */

    function updateAttendedConferenceNumbers() {

        const container =
            document.getElementById("attendedConferenceContainer");

        if (!container) {
            return;
        }


        const items =
            container.querySelectorAll(".conference-item");


        items.forEach(function (item, index) {

            const number =
                item.querySelector(".conference-number");


            if (number) {

                number.textContent =
                    String(index + 1).padStart(2, "0");
            }


            /* --------------------------------------------------
               Update title if required
               -------------------------------------------------- */

            const title =
                item.querySelector(".conference-title strong");


            if (title) {

                title.textContent =
                    "Conference " + (index + 1);
            }

        });
    }


    /* ==========================================================
       EMPTY STATE
       ========================================================== */

    function updateAttendedConferenceEmptyState() {

        const container =
            document.getElementById("attendedConferenceContainer");

        const emptyState =
            document.getElementById(
                "attendedConferenceEmptyState"
            );


        if (!container || !emptyState) {
            return;
        }


        const items =
            container.querySelectorAll(".conference-item");


        if (items.length === 0) {

            emptyState.style.display = "block";

        }
        else {

            emptyState.style.display = "none";
        }
    }


    /* ==========================================================
       PARTICIPANT TOTAL
       
       Total Participants = Students + Teachers
       
       This automatically updates the total field.
       ========================================================== */

    document.addEventListener("input", function (event) {

        if (!event.target.classList.contains("participant-input")) {
            return;
        }


        const conferenceItem =
            event.target.closest(".conference-item");


        if (!conferenceItem) {
            return;
        }


        const studentInput =
            conferenceItem.querySelector(
                '[name*=".StudentParticipants"]'
            );


        const teacherInput =
            conferenceItem.querySelector(
                '[name*=".TeacherParticipants"]'
            );


        const totalInput =
            conferenceItem.querySelector(
                '[name*=".TotalParticipants"]'
            );


        if (!studentInput ||
            !teacherInput ||
            !totalInput) {

            return;
        }


        const students =
            parseInt(studentInput.value) || 0;


        const teachers =
            parseInt(teacherInput.value) || 0;


        totalInput.value =
            students + teachers;
    });


    /* ==========================================================
       PREVENT NEGATIVE PARTICIPANT VALUES
       ========================================================== */

    document.addEventListener("input", function (event) {

        if (!event.target.classList.contains("participant-input")) {
            return;
        }


        if (event.target.value < 0) {

            event.target.value = 0;
        }
    });

</script>

<script>

    /*
