
@model Medical_Affiliation.Models.AdditionalInformationInAcademicActivitiesVM

@{
    ViewData["Title"] = "Additional Information";
    Layout = "~/Views/Shared/_CaLayout.cshtml";
}
<style>
    /* ==========================================================
       ADDITIONAL INFORMATION IN ACADEMIC ACTIVITIES
       PAGE-SPECIFIC CSS
       ========================================================== */
    .aiaa-wrapper {
        width: 100%;
        max-width: 1450px;
        margin: 0 auto;
        padding: 10px 0 35px;
    }


    /* ==========================================================
       HEADER
       ========================================================== */

    .aiaa-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 20px;
        margin-bottom: 16px;
        background: #ffffff;
        border: 1px solid #e1e6ec;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .aiaa-header-left {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .aiaa-header-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #edf4ff;
        color: #1a4c8b;
        border: 1px solid #d8e5f5;
        border-radius: 9px;
        font-size: 20px;
    }

    .aiaa-header h2 {
        margin: 0;
        color: #26384f;
        font-size: 20px;
        font-weight: 700;
    }

    .aiaa-header p {
        margin: 4px 0 0;
        color: #7d8793;
        font-size: 12px;
    }

    .aiaa-course-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 13px;
        background: #f5f8fc;
        border: 1px solid #dbe3ec;
        border-radius: 20px;
        color: #1a4c8b;
        font-size: 12px;
        font-weight: 700;
    }


    /* ==========================================================
       CARD
       ========================================================== */

    .aiaa-card {
        margin-bottom: 15px;
        background: #ffffff;
        border: 1px solid #e1e6ec;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.035);
    }


    /* ==========================================================
       CARD HEADER
       ========================================================== */

    .aiaa-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 16px;
        background: #f8fafc;
        border-bottom: 1px solid #e6ebf0;
    }

    .aiaa-number {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #eaf2ff;
        color: #1a4c8b;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 800;
    }

    .aiaa-card-heading {
        flex: 1;
    }

        .aiaa-card-heading h3 {
            margin: 0;
            color: #344256;
            font-size: 14px;
            font-weight: 700;
        }

        .aiaa-card-heading p {
            margin: 3px 0 0;
            color: #858e99;
            font-size: 11px;
        }

    .aiaa-card-icon {
        color: #1a4c8b;
        font-size: 19px;
    }


    /* ==========================================================
       CARD BODY
       ========================================================== */

    .aiaa-card-body {
        padding: 16px;
    }


    /* ==========================================================
       QUESTION
       ========================================================== */

    .aiaa-question-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        padding: 14px;
        background: #fbfcfe;
        border: 1px solid #e3e8ee;
        border-radius: 8px;
    }

    .aiaa-question {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .aiaa-question-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #edf4ff;
        color: #1a4c8b;
        border-radius: 7px;
    }

    .aiaa-question h4 {
        margin: 0;
        color: #3d4958;
        font-size: 13px;
        font-weight: 600;
    }

    .aiaa-question span {
        display: block;
        margin-top: 3px;
        color: #8b949e;
        font-size: 11px;
    }


    /* ==========================================================
       YES / NO OPTIONS
       ========================================================== */

    .aiaa-options {
        display: flex;
        gap: 8px;
    }

    .aiaa-option {
        position: relative;
        margin: 0;
        cursor: pointer;
    }

        .aiaa-option input {
            position: absolute;
            opacity: 0;
        }

    .aiaa-option-content {
        display: flex;
        align-items: center;
        gap: 7px;
        min-width: 105px;
        padding: 7px 10px;
        background: #ffffff;
        border: 1px solid #d9e0e8;
        border-radius: 7px;
        transition: 0.2s ease;
    }

    .aiaa-option input:checked +
    .aiaa-option-content {
        border-color: #1a4c8b;
        background: #f3f7fd;
        box-shadow: 0 0 0 2px rgba(26, 76, 139, 0.06);
    }

    .aiaa-option-icon {
        width: 27px;
        height: 27px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        font-size: 12px;
    }

    .aiaa-success {
        background: #eaf8f0;
        color: #198754;
    }

    .aiaa-danger {
        background: #fff0f0;
        color: #dc3545;
    }

    .aiaa-option strong {
        display: block;
        color: #3d4857;
        font-size: 11px;
    }

    .aiaa-option small {
        display: block;
        color: #8b949e;
        font-size: 9px;
    }


    /* ==========================================================
       NUMBER INPUT
       ========================================================== */

    .aiaa-input-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 14px;
        background: #fbfcfe;
        border: 1px solid #e3e8ee;
        border-radius: 8px;
    }

    .aiaa-input-information {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .aiaa-input-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #edf4ff;
        color: #1a4c8b;
        border-radius: 7px;
    }

    .aiaa-input-information h4 {
        margin: 0;
        color: #3d4958;
        font-size: 13px;
        font-weight: 600;
    }

    .aiaa-input-information p {
        margin: 3px 0 0;
        color: #8b949e;
        font-size: 11px;
    }

    .aiaa-input-group {
        width: 220px;
    }

        .aiaa-input-group label {
            display: block;
            margin-bottom: 5px;
            color: #4b5665;
            font-size: 11px;
            font-weight: 600;
        }

            .aiaa-input-group label span {
                color: #dc3545;
            }

    .aiaa-number-input {
        width: 100%;
        height: 38px;
        padding: 7px 10px;
        background: #ffffff;
        border: 1px solid #d5dde6;
        border-radius: 6px;
        color: #344054;
        font-size: 12px;
        outline: none;
    }

        .aiaa-number-input:focus {
            border-color: #1a4c8b;
            box-shadow: 0 0 0 3px rgba(26, 76, 139, 0.07);
        }

        .aiaa-number-input::placeholder {
            color: #a7afb9;
        }

    .aiaa-error {
        display: block;
        margin-top: 4px;
        color: #dc3545;
        font-size: 10px;
    }


    /* ==========================================================
       CME UPLOAD
       ========================================================== */

    .aiaa-upload-box {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 18px;
        padding: 15px;
        background: #fbfcfe;
        border: 1px solid #e3e8ee;
        border-radius: 8px;
    }

    .aiaa-upload-info {
        display: flex;
        align-items: flex-start;
        gap: 11px;
    }

    .aiaa-pdf-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #fff0f0;
        color: #dc3545;
        border-radius: 8px;
        font-size: 18px;
    }

    .aiaa-upload-info h4 {
        margin: 2px 0 0;
        color: #3d4958;
        font-size: 13px;
        font-weight: 600;
    }

    .aiaa-upload-info p {
        margin: 4px 0 8px;
        color: #858e99;
        font-size: 11px;
    }

    .aiaa-file-info {
        display: flex;
        gap: 12px;
    }

        .aiaa-file-info span {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            color: #737d89;
            font-size: 10px;
        }

        .aiaa-file-info i {
            color: #1a4c8b;
        }


    /* ==========================================================
       FILE INPUT
       ========================================================== */

    .aiaa-upload-right {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 9px;
        padding: 12px;
        background: #ffffff;
        border: 1px dashed #cbd5e1;
        border-radius: 7px;
    }

    .aiaa-file-input {
        display: none;
    }

    .aiaa-upload-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 38px;
        padding: 7px 14px;
        background: #1a4c8b;
        color: #ffffff;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .aiaa-upload-button:hover {
            background: #143d70;
        }


    /* ==========================================================
       SELECTED FILE
       ========================================================== */

    .aiaa-selected-file {
        width: 100%;
        display: none;
        align-items: center;
        justify-content: space-between;
        padding: 8px 10px;
        background: #f7fafc;
        border: 1px solid #dce3eb;
        border-radius: 6px;
    }

    .aiaa-selected-file-left {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

        .aiaa-selected-file-left > i {
            color: #dc3545;
            font-size: 20px;
        }

        .aiaa-selected-file-left strong {
            display: block;
            max-width: 350px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: #3e4958;
            font-size: 11px;
        }

        .aiaa-selected-file-left small {
            display: block;
            margin-top: 2px;
            color: #929aa4;
            font-size: 9px;
        }

    .aiaa-remove-button {
        width: 27px;
        height: 27px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        background: #fff0f0;
        border: none;
        border-radius: 5px;
        color: #dc3545;
        cursor: pointer;
    }

        .aiaa-remove-button:hover {
            background: #dc3545;
            color: #ffffff;
        }


    /* ==========================================================
       EXISTING FILE
       ========================================================== */

    .aiaa-existing-file {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 10px;
        background: #f8fafc;
        border: 1px solid #dce3eb;
        border-radius: 6px;
    }

    .aiaa-existing-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .aiaa-existing-icon {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff0f0;
        color: #dc3545;
        border-radius: 5px;
        font-size: 15px;
    }

    .aiaa-existing-left strong {
        display: block;
        color: #3e4958;
        font-size: 10px;
    }

    .aiaa-existing-left small {
        display: block;
        margin-top: 2px;
        color: #929aa4;
        font-size: 9px;
    }

    .aiaa-view-button {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        background: #ffffff;
        border: 1px solid #1a4c8b;
        border-radius: 5px;
        color: #1a4c8b;
        font-size: 10px;
        font-weight: 600;
        text-decoration: none;
    }

        .aiaa-view-button:hover {
            background: #1a4c8b;
            color: #ffffff;
        }


    /* ==========================================================
       FOOTER
       ========================================================== */

    .aiaa-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 3px 1px 0;
    }

    .aiaa-footer-note {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #7c8793;
        font-size: 10px;
    }

        .aiaa-footer-note i {
            color: #1a4c8b;
        }

    .aiaa-save-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-width: 155px;
        height: 39px;
        padding: 7px 15px;
        background: #1a4c8b;
        border: none;
        border-radius: 6px;
        color: #ffffff;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 3px 8px rgba(26, 76, 139, 0.15);
        transition: 0.2s ease;
    }

        .aiaa-save-button:hover {
            background: #143d70;
            transform: translateY(-1px);
        }


    /* ==========================================================
       RESPONSIVE
       ========================================================== */

    @@media (max-width: 900px) {

        .aiaa-upload-box {
            grid-template-columns: 1fr;
        }

        .aiaa-question-box,
        .aiaa-input-row {
            align-items: flex-start;
            flex-direction: column;
        }

        .aiaa-input-group {
            width: 100%;
            max-width: 280px;
        }
    }


    @@media (max-width: 600px) {

        .aiaa-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .aiaa-course-badge {
            align-self: flex-start;
        }

        .aiaa-question-box {
            padding: 12px;
        }

        .aiaa-options {
            width: 100%;
        }

        .aiaa-option {
            flex: 1;
        }

        .aiaa-option-content {
            justify-content: center;
            min-width: 0;
        }

        .aiaa-input-group {
            width: 100%;
            max-width: none;
        }

        .aiaa-upload-right {
            flex-direction: column;
        }

        .aiaa-upload-button {
            width: 100%;
        }

        .aiaa-existing-file {
            align-items: flex-start;
            flex-direction: column;
        }

        .aiaa-view-button {
            width: 100%;
            justify-content: center;
        }

        .aiaa-footer {
            align-items: stretch;
            flex-direction: column;
        }

        .aiaa-save-button {
            width: 100%;
        }
    }

/* ==========================================================
   CME RADIO BUTTON GROUP
   ========================================================== */

.aiaa-radio-group {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 8px;
}


/* ==========================================================
   RADIO OPTION
   ========================================================== */

.aiaa-radio-option {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 9px;

    min-width: 90px;
    padding: 10px 18px;

    background: #ffffff;
    border: 1px solid #dfe5ec;
    border-radius: 8px;

    cursor: pointer;

    font-size: 14px;
    font-weight: 500;
    color: #374151;

    transition: all 0.2s ease;
}


/* ==========================================================
   HIDE DEFAULT RADIO
   ========================================================== */

.aiaa-radio-option input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}


/* ==========================================================
   CUSTOM RADIO CIRCLE
   ========================================================== */

.aiaa-radio-option::before {
    content: "";

    width: 18px;
    height: 18px;

    border: 2px solid #b8c2ce;
    border-radius: 50%;

    background: #ffffff;

    flex-shrink: 0;

    transition: all 0.2s ease;
}


/* ==========================================================
   HOVER
   ========================================================== */

.aiaa-radio-option:hover {
    border-color: #6c8db5;
    background: #f8fafc;
}


/* ==========================================================
   SELECTED RADIO
   ========================================================== */

.aiaa-radio-option:has(input[type="radio"]:checked) {
    border-color: #315f8f;
    background: #f4f8fc;
    color: #315f8f;
}


/* ==========================================================
   SELECTED RADIO CIRCLE
   ========================================================== */

.aiaa-radio-option:has(input[type="radio"]:checked)::before {
    border-color: #315f8f;

    background:
        radial-gradient(
            circle,
            #315f8f 0,
            #315f8f 5px,
            #ffffff 6px,
            #ffffff 100%
        );
}


/* ==========================================================
   FOCUS
   ========================================================== */

.aiaa-radio-option:has(input[type="radio"]:focus-visible) {
    outline: 3px solid rgba(49, 95, 143, 0.15);
    outline-offset: 2px;
}


/* ==========================================================
   FORM LABEL
   ========================================================== */

.aiaa-form-label .form-label {
    margin-bottom: 4px;

    font-size: 14px;
    font-weight: 600;
    color: #263445;
}


/* ==========================================================
   CME FORM SECTION
   ========================================================== */

.aiaa-form-section {
    padding: 16px;

    background: #fbfcfe;
    border: 1px solid #e5e9ef;
    border-radius: 10px;
}


/* ==========================================================
   NUMBER INPUT
   ========================================================== */

.aiaa-form-section input[type="number"] {
    max-width: 350px;
    height: 42px;

    border: 1px solid #d7dde5;
    border-radius: 7px;

    padding: 8px 12px;

    font-size: 14px;
    color: #374151;

    transition: border-color 0.2s ease,
                box-shadow 0.2s ease;
}


.aiaa-form-section input[type="number"]:focus {
    border-color: #315f8f;

    box-shadow:
        0 0 0 3px rgba(49, 95, 143, 0.12);

    outline: none;
}


/* ==========================================================
   MOBILE
   ========================================================== */

@@media (max-width: 576px) {

    .aiaa-radio-group {
        width: 100%;
        gap: 10px;
    }

    .aiaa-radio-option {
        flex: 1;
        justify-content: center;
        min-width: 0;
        padding: 10px 14px;
    }

}
</style>
<style>
    /* ==========================================================
       CONFERENCES CONDUCTED
       ========================================================== */

    .conference-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 15px;
        padding: 14px 16px;
        background: #fbfcfe;
        border: 1px solid #e3e8ee;
        border-radius: 8px;
    }

    .conference-toolbar h4 {
        margin: 0;
        color: #344256;
        font-size: 14px;
        font-weight: 700;
    }

    .conference-toolbar p {
        margin: 4px 0 0;
        color: #858e99;
        font-size: 11px;
    }


    /* ==========================================================
       ADD CONFERENCE BUTTON
       ========================================================== */

    .aiaa-add-conference-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-width: 145px;
        height: 37px;
        padding: 7px 14px;
        background: #1a4c8b;
        border: none;
        border-radius: 6px;
        color: #ffffff;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 3px 8px rgba(26, 76, 139, 0.12);
    }

    .aiaa-add-conference-button:hover {
        background: #143d70;
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(26, 76, 139, 0.18);
    }

    .aiaa-add-conference-button i {
        font-size: 13px;
    }


    /* ==========================================================
       CONFERENCE CONTAINER
       ========================================================== */

    #conferenceContainer {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }


    /* ==========================================================
       CONFERENCE ITEM
       ========================================================== */

    .conference-item {
        background: #ffffff;
        border: 1px solid #dfe5ec;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.025);
        transition: border-color 0.2s ease,
                    box-shadow 0.2s ease;
    }

    .conference-item:hover {
        border-color: #cbd7e5;
        box-shadow: 0 3px 9px rgba(0, 0, 0, 0.045);
    }


    /* ==========================================================
       CONFERENCE HEADER
       ========================================================== */

    .conference-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 13px;
        background: #f8fafc;
        border-bottom: 1px solid #e6ebf0;
    }

    .conference-title {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .conference-title strong {
        color: #344256;
        font-size: 12px;
        font-weight: 700;
    }


    /* ==========================================================
       CONFERENCE NUMBER
       ========================================================== */

    .conference-number {
        width: 31px;
        height: 31px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #eaf2ff;
        color: #1a4c8b;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 800;
    }


    /* ==========================================================
       REMOVE BUTTON
       ========================================================== */

    .conference-remove-button {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        background: #fff0f0;
        border: 1px solid #f4d2d2;
        border-radius: 6px;
        color: #dc3545;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .conference-remove-button:hover {
        background: #dc3545;
        border-color: #dc3545;
        color: #ffffff;
    }

    .conference-remove-button i {
        font-size: 12px;
    }


    /* ==========================================================
       CONFERENCE BODY
       ========================================================== */

    .conference-body {
        display: grid;
        grid-template-columns: 1.5fr 1.2fr 0.8fr;
        gap: 15px;
        padding: 15px;
        background: #ffffff;
    }


    /* ==========================================================
       FORM GROUP
