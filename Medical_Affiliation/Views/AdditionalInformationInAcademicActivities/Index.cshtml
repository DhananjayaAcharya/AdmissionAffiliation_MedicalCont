                                                           min="0"
                                                           name="ConferencesAttended[@i].TeacherParticipants"
                                                           value="@conference.TeacherParticipants"
                                                           class="participant-input"
                                                           placeholder="Enter number"
                                                           required />

                                                </div>

                                            </div>


