                                         CONFERENCE PLACE
                                         ============================= -->

                                    <div class="form-group">

                                        <label>
                                            Conference Place
                                            <span class="required">*</span>
                                        </label>

                                        <input type="text"
                                               name="ConferencesAttended[@i].ConferencePlace"
                                               value="@conference.ConferencePlace"
                                               class="form-control"
                                               maxlength="300"
                                               placeholder="Enter conference place"
                                               required />

                                    </div>


                                    <!-- =============================
                                         CONFERENCE DATE
                                         ============================= -->

                                    <div class="form-group">

                                        <label>
                                            Conference Date
                                            <span class="required">*</span>
                                        </label>

                                        <input type="date"
                                               name="ConferencesAttended[@i].ConferenceDate"
                                               value="@(conference.ConferenceDate?.ToString("yyyy-MM-dd"))"
                                               class="form-control"
                                               required />

