                                            onclick="removeAttendedConference(this)">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </div>


                                <!-- BODY -->

                                <div class="conference-body">

                                    <!-- Hidden ID -->

                                    <input type="hidden"
                                           name="ConferencesAttended[@i].Id"
                                           value="@conference.Id" />


                                    <!-- =============================
                                         CONFERENCE NAME
                                         ============================= -->

                                    <div class="form-group">

                                        <label>
                                            Conference Name
                                            <span class="required">*</span>
                                        </label>

