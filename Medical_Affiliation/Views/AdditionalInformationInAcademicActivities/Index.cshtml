            document.getElementById('cmeAttendedYes');

        const container =
            document.getElementById('cmeAttendedCountContainer');

        const input =
            document.getElementById('NoOfCMEProgrammesAttended');


        if (yes && yes.checked) {

            container.style.display = 'block';

            if (input) {
                input.disabled = false;
            }

        } else {

            container.style.display = 'none';

            if (input) {
                input.value = '';
                input.disabled = true;
            }
        }
    }


    /*
     * ==========================================================
     * INITIALIZE ON PAGE LOAD
     * ==========================================================
     */

    document.addEventListener('DOMContentLoaded', function () {

