
@model Medical_Affiliation.Models.AdditionalInformationInAcademicActivitiesVM

@{
    ViewData["Title"] = "Additional Information";
    Layout = "~/Views/Shared/_CaLayout.cshtml";
}
<style>
    /* ==========================================================
       ADDITIONAL INFORMATION IN ACADEMIC ACTIVITIES
       PAGE-SPECIFIC CSS
       ========================================================== */
    .aiaa-wrapper {
        width: 100%;
        max-width: 1450px;
        margin: 0 auto;
        padding: 10px 0 35px;
    }


    /* ==========================================================
       HEADER
       ========================================================== */

    .aiaa-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 20px;
        margin-bottom: 16px;
        background: #ffffff;
        border: 1px solid #e1e6ec;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .aiaa-header-left {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .aiaa-header-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #edf4ff;
        color: #1a4c8b;
        border: 1px solid #d8e5f5;
        border-radius: 9px;
        font-size: 20px;
    }

    .aiaa-header h2 {
        margin: 0;
        color: #26384f;
        font-size: 20px;
        font-weight: 700;
    }

    .aiaa-header p {
        margin: 4px 0 0;
        color: #7d8793;
        font-size: 12px;
    }

    .aiaa-course-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 13px;
        background: #f5f8fc;
        border: 1px solid #dbe3ec;
        border-radius: 20px;
        color: #1a4c8b;
        font-size: 12px;
        font-weight: 700;
    }


    /* ==========================================================
       CARD
       ========================================================== */

    .aiaa-card {
        margin-bottom: 15px;
        background: #ffffff;
        border: 1px solid #e1e6ec;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.035);
    }


    /* ==========================================================
       CARD HEADER
       ========================================================== */

    .aiaa-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 16px;
        background: #f8fafc;
        border-bottom: 1px solid #e6ebf0;
    }

    .aiaa-number {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #eaf2ff;
        color: #1a4c8b;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 800;
    }

    .aiaa-card-heading {
        flex: 1;
    }

        .aiaa-card-heading h3 {
            margin: 0;
            color: #344256;
            font-size: 14px;
            font-weight: 700;
        }

        .aiaa-card-heading p {
            margin: 3px 0 0;
            color: #858e99;
            font-size: 11px;
        }

    .aiaa-card-icon {
        color: #1a4c8b;
        font-size: 19px;
    }


    /* ==========================================================
       CARD BODY
       ========================================================== */

    .aiaa-card-body {
        padding: 16px;
    }


    /* ==========================================================
       QUESTION
       ========================================================== */

    .aiaa-question-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        padding: 14px;
        background: #fbfcfe;
        border: 1px solid #e3e8ee;
        border-radius: 8px;
    }

    .aiaa-question {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .aiaa-question-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #edf4ff;
        color: #1a4c8b;
        border-radius: 7px;
    }

    .aiaa-question h4 {
        margin: 0;
        color: #3d4958;
        font-size: 13px;
        font-weight: 600;
    }

    .aiaa-question span {
        display: block;
        margin-top: 3px;
        color: #8b949e;
        font-size: 11px;
    }


    /* ==========================================================
       YES / NO OPTIONS
       ========================================================== */

    .aiaa-options {
        display: flex;
        gap: 8px;
    }

    .aiaa-option {
        position: relative;
        margin: 0;
        cursor: pointer;
    }

        .aiaa-option input {
            position: absolute;
            opacity: 0;
        }

    .aiaa-option-content {
        display: flex;
        align-items: center;
        gap: 7px;
        min-width: 105px;
        padding: 7px 10px;
        background: #ffffff;
        border: 1px solid #d9e0e8;
        border-radius: 7px;
        transition: 0.2s ease;
    }

    .aiaa-option input:checked +
    .aiaa-option-content {
        border-color: #1a4c8b;
        background: #f3f7fd;
        box-shadow: 0 0 0 2px rgba(26, 76, 139, 0.06);
    }

    .aiaa-option-icon {
        width: 27px;
        height: 27px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        font-size: 12px;
    }

    .aiaa-success {
        background: #eaf8f0;
        color: #198754;
    }

    .aiaa-danger {
        background: #fff0f0;
        color: #dc3545;
    }

    .aiaa-option strong {
        display: block;
        color: #3d4857;
        font-size: 11px;
    }

    .aiaa-option small {
        display: block;
        color: #8b949e;
        font-size: 9px;
    }


    /* ==========================================================
       NUMBER INPUT
       ========================================================== */

    .aiaa-input-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 14px;
        background: #fbfcfe;
        border: 1px solid #e3e8ee;
        border-radius: 8px;
    }

    .aiaa-input-information {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .aiaa-input-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #edf4ff;
        color: #1a4c8b;
        border-radius: 7px;
    }

    .aiaa-input-information h4 {
        margin: 0;
        color: #3d4958;
        font-size: 13px;
        font-weight: 600;
    }

    .aiaa-input-information p {
        margin: 3px 0 0;
        color: #8b949e;
        font-size: 11px;
    }

    .aiaa-input-group {
        width: 220px;
    }

        .aiaa-input-group label {
            display: block;
            margin-bottom: 5px;
            color: #4b5665;
            font-size: 11px;
            font-weight: 600;
        }

            .aiaa-input-group label span {
                color: #dc3545;
            }

    .aiaa-number-input {
        width: 100%;
        height: 38px;
        padding: 7px 10px;
        background: #ffffff;
        border: 1px solid #d5dde6;
        border-radius: 6px;
        color: #344054;
        font-size: 12px;
        outline: none;
    }

        .aiaa-number-input:focus {
            border-color: #1a4c8b;
            box-shadow: 0 0 0 3px rgba(26, 76, 139, 0.07);
        }

        .aiaa-number-input::placeholder {
            color: #a7afb9;
        }

    .aiaa-error {
        display: block;
        margin-top: 4px;
        color: #dc3545;
        font-size: 10px;
    }


    /* ==========================================================
       CME UPLOAD
       ========================================================== */

    .aiaa-upload-box {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 18px;
        padding: 15px;
        background: #fbfcfe;
        border: 1px solid #e3e8ee;
        border-radius: 8px;
    }

    .aiaa-upload-info {
        display: flex;
        align-items: flex-start;
        gap: 11px;
    }

    .aiaa-pdf-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #fff0f0;
        color: #dc3545;
        border-radius: 8px;
        font-size: 18px;
    }

    .aiaa-upload-info h4 {
        margin: 2px 0 0;
        color: #3d4958;
        font-size: 13px;
        font-weight: 600;
    }

    .aiaa-upload-info p {
        margin: 4px 0 8px;
        color: #858e99;
        font-size: 11px;
    }

    .aiaa-file-info {
        display: flex;
        gap: 12px;
    }

        .aiaa-file-info span {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            color: #737d89;
            font-size: 10px;
        }

        .aiaa-file-info i {
            color: #1a4c8b;
        }


    /* ==========================================================
       FILE INPUT
       ========================================================== */

    .aiaa-upload-right {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 9px;
        padding: 12px;
        background: #ffffff;
        border: 1px dashed #cbd5e1;
        border-radius: 7px;
    }

    .aiaa-file-input {
        display: none;
    }

    .aiaa-upload-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 38px;
        padding: 7px 14px;
        background: #1a4c8b;
        color: #ffffff;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .aiaa-upload-button:hover {
            background: #143d70;
        }


    /* ==========================================================
       SELECTED FILE
       ========================================================== */

    .aiaa-selected-file {
        width: 100%;
        display: none;
        align-items: center;
        justify-content: space-between;
        padding: 8px 10px;
        background: #f7fafc;
        border: 1px solid #dce3eb;
        border-radius: 6px;
    }

    .aiaa-selected-file-left {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

        .aiaa-selected-file-left > i {
            color: #dc3545;
            font-size: 20px;
        }

        .aiaa-selected-file-left strong {
            display: block;
            max-width: 350px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: #3e4958;
            font-size: 11px;
        }

        .aiaa-selected-file-left small {
            display: block;
            margin-top: 2px;
            color: #929aa4;
            font-size: 9px;
        }

    .aiaa-remove-button {
        width: 27px;
        height: 27px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        background: #fff0f0;
        border: none;
        border-radius: 5px;
        color: #dc3545;
        cursor: pointer;
    }

        .aiaa-remove-button:hover {
            background: #dc3545;
            color: #ffffff;
        }


    /* ==========================================================
       EXISTING FILE
       ========================================================== */

    .aiaa-existing-file {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 10px;
        background: #f8fafc;
        border: 1px solid #dce3eb;
        border-radius: 6px;
    }

    .aiaa-existing-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .aiaa-existing-icon {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff0f0;
        color: #dc3545;
        border-radius: 5px;
        font-size: 15px;
    }

    .aiaa-existing-left strong {
        display: block;
        color: #3e4958;
        font-size: 10px;
    }

    .aiaa-existing-left small {
        display: block;
        margin-top: 2px;
        color: #929aa4;
        font-size: 9px;
    }

    .aiaa-view-button {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        background: #ffffff;
        border: 1px solid #1a4c8b;
        border-radius: 5px;
        color: #1a4c8b;
        font-size: 10px;
        font-weight: 600;
        text-decoration: none;
    }

        .aiaa-view-button:hover {
            background: #1a4c8b;
            color: #ffffff;
        }


    /* ==========================================================
       FOOTER
       ========================================================== */

    .aiaa-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 3px 1px 0;
    }

    .aiaa-footer-note {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #7c8793;
        font-size: 10px;
    }

        .aiaa-footer-note i {
            color: #1a4c8b;
        }

    .aiaa-save-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-width: 155px;
        height: 39px;
        padding: 7px 15px;
        background: #1a4c8b;
        border: none;
        border-radius: 6px;
        color: #ffffff;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 3px 8px rgba(26, 76, 139, 0.15);
        transition: 0.2s ease;
    }

        .aiaa-save-button:hover {
            background: #143d70;
            transform: translateY(-1px);
        }


    /* ==========================================================
       RESPONSIVE
       ========================================================== */

    @@media (max-width: 900px) {

        .aiaa-upload-box {
            grid-template-columns: 1fr;
        }

        .aiaa-question-box,
        .aiaa-input-row {
            align-items: flex-start;
            flex-direction: column;
        }

        .aiaa-input-group {
            width: 100%;
            max-width: 280px;
        }
    }


    @@media (max-width: 600px) {

        .aiaa-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .aiaa-course-badge {
            align-self: flex-start;
        }

        .aiaa-question-box {
            padding: 12px;
        }

        .aiaa-options {
            width: 100%;
        }

        .aiaa-option {
            flex: 1;
        }

        .aiaa-option-content {
            justify-content: center;
            min-width: 0;
        }

        .aiaa-input-group {
            width: 100%;
            max-width: none;
        }

        .aiaa-upload-right {
            flex-direction: column;
        }

        .aiaa-upload-button {
            width: 100%;
        }

        .aiaa-existing-file {
            align-items: flex-start;
            flex-direction: column;
        }

        .aiaa-view-button {
            width: 100%;
            justify-content: center;
        }

        .aiaa-footer {
            align-items: stretch;
            flex-direction: column;
        }

        .aiaa-save-button {
            width: 100%;
        }
    }
</style>

<div class="aiaa-wrapper">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="aiaa-header">

        <div class="aiaa-header-left">

            <div class="aiaa-header-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <div>
                <h2>Additional Information in Academic Activities</h2>

                <p>
                    Academic activities, Medical Education Unit,
                    TOT programmes and CME details
                </p>
            </div>

        </div>

        <div class="aiaa-course-badge">
            <i class="bi bi-bookmark"></i>
            @Model.CourseLevel
        </div>

    </div>


    <form asp-action="Save"
          method="post"
          enctype="multipart/form-data"
          id="aiaaForm">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="FacultyCode" />
        <input type="hidden" asp-for="CollegeCode" />
        <input type="hidden" asp-for="CourseLevel" />
        <input type="hidden" asp-for="CMEProgrammePdfPath" />


        <!-- =====================================================
             01. MEDICAL EDUCATION UNIT
             ===================================================== -->

        <div class="aiaa-card">

            <div class="aiaa-card-header">

                <div class="aiaa-number">
                    01
                </div>

                <div class="aiaa-card-heading">

                    <h3>Medical Education Unit</h3>

                    <p>
                        Information regarding the Medical Education
                        Unit available in the institution.
                    </p>

                </div>

                <i class="bi bi-building aiaa-card-icon"></i>

            </div>


            <div class="aiaa-card-body">

                <div class="aiaa-question-box">

                    <div class="aiaa-question">

                        <div class="aiaa-question-icon">
                            <i class="bi bi-hospital"></i>
                        </div>

                        <div>

                            <h4>
                                Does the institution have a
                                Medical Education Unit?
                            </h4>

                            <span>
                                Select Yes or No.
                            </span>

                        </div>

                    </div>


                    <div class="aiaa-options">

                        <label class="aiaa-option">

                            <input type="radio"
                                   asp-for="HasMedicalEducationUnit"
                                   value="true" />

                            <span class="aiaa-option-content">

                                <span class="aiaa-option-icon aiaa-success">
                                    <i class="bi bi-check-lg"></i>
                                </span>

                                <span>
                                    <strong>Yes</strong>
                                    <small>Available</small>
                                </span>

                            </span>

                        </label>


                        <label class="aiaa-option">

                            <input type="radio"
                                   asp-for="HasMedicalEducationUnit"
                                   value="false" />

                            <span class="aiaa-option-content">

                                <span class="aiaa-option-icon aiaa-danger">
                                    <i class="bi bi-x-lg"></i>
                                </span>

                                <span>
                                    <strong>No</strong>
                                    <small>Not Available</small>
                                </span>

                            </span>

                        </label>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             02. TOT PROGRAMMES CONDUCTED
             ===================================================== -->

        <!-- TOT PROGRAMMES CONDUCTED -->

        <div class="aiaa-question-box">

            <div class="aiaa-question">
                <div class="aiaa-question-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <div>
                    <h4>Has the institution conducted TOT programmes?</h4>
                    <span>Select Yes or No.</span>
                </div>
            </div>

            <div class="aiaa-options">

                <label class="aiaa-option">
                    <input type="radio"
                           asp-for="HasTOTProgrammesConducted"
                           value="true"
                           onchange="toggleConductedCount()" />

                    <span class="aiaa-option-content">
                        <span class="aiaa-option-icon aiaa-success">
                            <i class="bi bi-check-lg"></i>
                        </span>

                        <span>
                            <strong>Yes</strong>
                            <small>Conducted</small>
                        </span>
                    </span>
                </label>


                <label class="aiaa-option">
                    <input type="radio"
                           asp-for="HasTOTProgrammesConducted"
                           value="false"
                           onchange="toggleConductedCount()" />

                    <span class="aiaa-option-content">
                        <span class="aiaa-option-icon aiaa-danger">
                            <i class="bi bi-x-lg"></i>
                        </span>

                        <span>
                            <strong>No</strong>
                            <small>Not Conducted</small>
                        </span>
                    </span>
                </label>

            </div>

        </div>


        <!-- SHOW ONLY WHEN YES -->

        <div id="conductedCountSection"
             class="aiaa-dependent-section"
             style="display:none;">

            <div class="aiaa-input-row">

                <div class="aiaa-input-information">

                    <div class="aiaa-input-icon">
                        <i class="bi bi-hash"></i>
                    </div>

                    <div>
                        <h4>Number of TOT programmes conducted</h4>
                        <p>Enter the total number of programmes conducted.</p>
                    </div>

                </div>

                <div class="aiaa-input-group">

                    <label asp-for="TOTProgrammesConducted">
                        No. of Programmes
                    </label>

                    <input asp-for="TOTProgrammesConducted"
                           type="number"
                           min="0"
                           class="aiaa-number-input"
                           placeholder="Enter number" />

                    <span asp-validation-for="TOTProgrammesConducted"
                          class="aiaa-error">
                    </span>

                </div>

            </div>

        </div>

        <!-- =====================================================
     03. TOT PROGRAMMES ATTENDED
     ===================================================== -->

        <div class="aiaa-card">

            <div class="aiaa-card-header">

                <div class="aiaa-number">
                    03
                </div>

                <div class="aiaa-card-heading">

                    <h3>TOT Programmes Attended</h3>

                    <p>
                        Training of Trainers programmes attended by the faculty.
                    </p>

                </div>

                <i class="bi bi-people aiaa-card-icon"></i>

            </div>


            <div class="aiaa-card-body">

                <!-- YES / NO -->

                <div class="aiaa-question-box">

                    <div class="aiaa-question">

                        <div class="aiaa-question-icon">
                            <i class="bi bi-person-check"></i>
                        </div>

                        <div>
                            <h4>
                                Has the faculty attended TOT programmes?
                            </h4>

                            <span>
                                Select Yes or No.
                            </span>
                        </div>

                    </div>


                    <div class="aiaa-options">

                        <!-- YES -->

                        <label class="aiaa-option">

                            <input type="radio"
                                   asp-for="HasTOTProgrammesAttended"
                                   value="true"
                                   onchange="toggleAttendedCount()" />

                            <span class="aiaa-option-content">

                                <span class="aiaa-option-icon aiaa-success">
                                    <i class="bi bi-check-lg"></i>
                                </span>

                                <span>
                                    <strong>Yes</strong>
                                    <small>Attended</small>
                                </span>

                            </span>

                        </label>


                        <!-- NO -->

                        <label class="aiaa-option">

                            <input type="radio"
                                   asp-for="HasTOTProgrammesAttended"
                                   value="false"
                                   onchange="toggleAttendedCount()" />

                            <span class="aiaa-option-content">

                                <span class="aiaa-option-icon aiaa-danger">
                                    <i class="bi bi-x-lg"></i>
                                </span>

                                <span>
                                    <strong>No</strong>
                                    <small>Not Attended</small>
                                </span>

                            </span>

                        </label>

                    </div>

                </div>


                <!-- =================================================
             NUMBER OF PROGRAMMES
             SHOWN ONLY WHEN YES IS SELECTED
             ================================================= -->

                <div id="attendedCountSection"
                     class="aiaa-dependent-section"
                     style="display:none;">

                    <div class="aiaa-input-row">

                        <div class="aiaa-input-information">

                            <div class="aiaa-input-icon">
                                <i class="bi bi-hash"></i>
                            </div>

                            <div>

                                <h4>
                                    Number of TOT programmes attended
                                </h4>

                                <p>
                                    Enter the total number of TOT programmes
                                    attended by the faculty.
                                </p>

                            </div>

                        </div>


                        <div class="aiaa-input-group">

                            <label asp-for="TOTProgrammesAttended">
                                No. of Programmes
                            </label>

                            <input asp-for="TOTProgrammesAttended"
                                   type="number"
                                   min="0"
                                   class="aiaa-number-input"
                                   placeholder="Enter number" />

                            <span asp-validation-for="TOTProgrammesAttended"
                                  class="aiaa-error">
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- SHOW ONLY WHEN YES -->

        <div id="attendedCountSection"
             class="aiaa-dependent-section"
             style="display:none;">

            <div class="aiaa-input-row">

                <div class="aiaa-input-information">

                    <div class="aiaa-input-icon">
                        <i class="bi bi-hash"></i>
                    </div>

                    <div>
                        <h4>Number of TOT programmes attended</h4>
                        <p>Enter the total number of programmes attended.</p>
                    </div>

                </div>

                <div class="aiaa-input-group">

                    <label asp-for="TOTProgrammesAttended">
                        No. of Programmes
                    </label>

                    <input asp-for="TOTProgrammesAttended"
                           type="number"
                           min="0"
                           class="aiaa-number-input"
                           placeholder="Enter number" />

                    <span asp-validation-for="TOTProgrammesAttended"
                          class="aiaa-error">
                    </span>

                </div>

            </div>

        </div>

        <!-- =====================================================
             04. CME PROGRAMME
             ===================================================== -->

        <div class="aiaa-card">

            <div class="aiaa-card-header">

                <div class="aiaa-number">
                    04
                </div>

                <div class="aiaa-card-heading">

                    <h3>CME Programme</h3>

                    <p>
                        Upload the supporting CME programme document.
                    </p>

                </div>

                <i class="bi bi-file-earmark-medical aiaa-card-icon"></i>

            </div>


            <div class="aiaa-card-body">

                <div class="aiaa-upload-box">

                    <div class="aiaa-upload-info">

                        <div class="aiaa-pdf-icon">
                            <i class="bi bi-file-earmark-pdf-fill"></i>
                        </div>

                        <div>

                            <h4>CME Programme PDF</h4>

                            <p>
                                Upload the CME programme document
                                in PDF format.
                            </p>

                            <div class="aiaa-file-info">

                                <span>
                                    <i class="bi bi-filetype-pdf"></i>
                                    PDF only
                                </span>

                                <span>
                                    <i class="bi bi-hdd"></i>
                                    Maximum 2 MB
                                </span>

                            </div>

                        </div>

                    </div>


                    <div class="aiaa-upload-right">

                        <label for="CMEProgrammePdf"
                               class="aiaa-upload-button">

                            <i class="bi bi-cloud-arrow-up"></i>

                            Choose PDF

                        </label>

                        <input asp-for="CMEProgrammePdf"
                               type="file"
                               id="CMEProgrammePdf"
                               accept="application/pdf"
                               class="aiaa-file-input"
                               onchange="handleCMEFileChange(this)" />


                        <div id="cmeFileDisplay"
                             class="aiaa-selected-file">

                            <div class="aiaa-selected-file-left">

                                <i class="bi bi-file-earmark-pdf-fill"></i>

                                <div>

                                    <strong class="name-text"></strong>

                                    <small>
                                        PDF selected
                                    </small>

                                </div>

                            </div>

                            <button type="button"
                                    class="aiaa-remove-button"
                                    onclick="removeCMEFile()">

                                <i class="bi bi-x-lg"></i>

                            </button>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(Model.CMEProgrammePdfPath))
                        {
                            <div class="aiaa-existing-file">

                                <div class="aiaa-existing-left">

                                    <div class="aiaa-existing-icon">
                                        <i class="bi bi-file-earmark-pdf-fill"></i>
                                    </div>

                                    <div>

                                        <strong>
                                            Existing CME Programme PDF
                                        </strong>

                                        <small>
                                            Previously uploaded document
                                        </small>

                                    </div>

                                </div>


                                <a asp-action="ViewCMEProgrammePdf"
                                   asp-route-id="@Model.Id"
                                   target="_blank"
                                   class="aiaa-view-button">

                                    <i class="bi bi-eye"></i>

                                    View PDF

                                </a>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             SAVE
             ===================================================== -->

        <div class="aiaa-footer">

            <div class="aiaa-footer-note">

                <i class="bi bi-info-circle"></i>

                Please verify all information before saving.

            </div>


            <button type="submit"
                    class="aiaa-save-button">

                <i class="bi bi-check-circle"></i>

                Save Information

            </button>

        </div>

    </form>

</div>


<script>

        // =========================================================
    // TOT PROGRAMMES CONDUCTED
    // =========================================================

    function toggleConductedCount() {

        const selected = document.querySelector(
            'input[name="HasTOTProgrammesConducted"]:checked'
        );

        const section = document.getElementById(
            "conductedCountSection"
        );

        const input = document.getElementById(
            "TotprogrammesConducted"
        );

        if (!selected) {
            section.style.display = "none";
            return;
        }

        if (selected.value === "true") {

            // YES → show number field
            section.style.display = "block";

        } else {

            // NO → hide and reset
            section.style.display = "none";

            if (input) {
                input.value = "0";
            }
        }
    }


    // =========================================================
    // TOT PROGRAMMES ATTENDED
    // =========================================================

    function toggleAttendedCount() {

        const selected = document.querySelector(
            'input[name="HasTOTProgrammesAttended"]:checked'
        );

        const section = document.getElementById(
            "attendedCountSection"
        );

        const input = document.getElementById(
            "TotprogrammesAttended"
        );

        if (!selected) {
            section.style.display = "none";
            return;
        }

        if (selected.value === "true") {

            // YES → SHOW number field
            section.style.display = "block";

        } else {

            // NO → HIDE number field
            section.style.display = "none";

            if (input) {
                input.value = "0";
            }
        }
    }


    // =========================================================
    // INITIALIZE WHEN PAGE LOADS
    // =========================================================

    document.addEventListener("DOMContentLoaded", function () {

        toggleConductedCount();
        toggleAttendedCount();

    });


    // ========================================================= 
    // CME FILE 
    // ========================================================= 
    function handleCMEFileChange(input) { 
        const file = input.files[0]; 
        const display = document.getElementById("cmeFileDisplay"); 
        if (!file) { 
            display.style.display = "none"; 
            return; 
        } 
        const isPdf = file.type === "application/pdf" || file.name.toLowerCase().endsWith(".pdf"); 
        if (!isPdf) { 
            Swal.fire({ 
                icon: "error", 
                title: "Invalid File Type", 
                text: "Only PDF files are allowed.", 
                confirmButtonColor: "#1a4c8b" 
            }); 
            input.value = ""; 
            display.style.display = "none"; 
            return; 
        } 
        const maxSize = 2 * 1024 * 1024; 
        if (file.size > maxSize) { 
            Swal.fire({ 
                icon: "error", 
                title: "File Too Large", 
                text: "File size must not exceed 2 MB.", 
                confirmButtonColor: "#1a4c8b" 
            }); input.value = ""; 
            display.style.display = "none"; 
            return; 
        } 
        display.querySelector(".name-text").textContent = file.name; 
        display.style.display = "flex"; 
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <text>
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: '@Html.Raw(TempData["SuccessMessage"])',
                confirmButtonColor: '#1a4c8b',
                confirmButtonText: 'OK'
            });
        </text>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <text>
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: '@Html.Raw(TempData["ErrorMessage"])',
                confirmButtonColor: '#d33',
                confirmButtonText: 'OK'
            });
        </text>
    }


    // =========================================================
    // REMOVE CME FILE
    // =========================================================

    function removeCMEFile() {

        const input =
            document.getElementById("CMEProgrammePdf");

        const display =
            document.getElementById("cmeFileDisplay");

        input.value = "";

        display.style.display = "none";
    }


</script>
