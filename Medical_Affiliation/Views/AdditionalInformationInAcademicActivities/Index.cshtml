                <div id="conductedConferenceContainer">

                    @if (Model.ConferencesConducted != null && Model.ConferencesConducted.Any())
                    {
                        for (int i = 0; i < Model.ConferencesConducted.Count; i++)
                        {
                            <div class="conference-item">

                                <div class="conference-header">

                                    <div class="conference-title">

                                        <span class="conference-number">
                                            @((i + 1).ToString("D2"))
                                        </span>

                                        <strong>
                                            Conference @(i + 1)
                                        </strong>

                                    </div>

                                    <button type="button"
                                            class="conference-remove-button"
                                            onclick="removeConductedConference(this)">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </div>


                                <div class="conference-body">

                                    <div class="form-group">

                                        <label>
                                            Conference Name
                                        </label>

                                        <input type="text"
                                               name="ConferencesConducted[@i].ConferenceName"
                                               value="@Model.ConferencesConducted[i].ConferenceName"
                                               class="form-control"
                                               placeholder="Enter conference name" />

                                    </div>


                                    <div class="form-group">

                                        <label>
                                            Conference Place
                                        </label>

                                        <input type="text"
                                               name="ConferencesConducted[@i].ConferencePlace"
                                               value="@Model.ConferencesConducted[i].ConferencePlace"
                                               class="form-control"
                                               placeholder="Enter conference place" />

                                    </div>


                                    <div class="form-group">

                                        <label>
                                            Conference Date
                                        </label>

                                        <input type="date"
                                               name="ConferencesConducted[@i].ConferenceDate"
                                               value="@(Model.ConferencesConducted[i].ConferenceDate?.ToString("yyyy-MM-dd"))"
                                               class="form-control" />

                                    </div>

                                </div>

                            </div>
