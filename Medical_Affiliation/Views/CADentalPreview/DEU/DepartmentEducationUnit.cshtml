@model Medical_Affiliation.Models.DepartmentOfficesMeuPreviewVM

@{
    var FacultyCode = Context.Session.GetString("FacultyCode");
    var AffiliationType = Context.Session.GetString("TypeOfAffiliation");
}

<link rel="stylesheet"
      href="~/css/preview-section-header.css" />

<div class="general-section">

    <!-- ====================================================== -->
    <!-- HEADER -->
    <!-- ====================================================== -->

    <div class="preview-section-header">

        <div class="preview-section-header-content">

            <h4 class="preview-section-title">
                <i class="bi bi-building me-2"></i>
                Department Offices & Education Unit
            </h4>

            <a class="preview-section-edit"
               href="@Url.Action(
                    "Aff_InstituteDetails",
                    "ContinuesAffiliation_Facultybased",
                    new
                    {
                        typeOfAffiliation = @AffiliationType
                    })">

                <i class="bi bi-pencil-square"></i>
                <span>Edit section</span>

            </a>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- DEPARTMENT OFFICES -->
    <!-- ====================================================== -->

    <div class="section-block">

        <div class="section-header-block">

            <div class="section-title-text section-badge">
                <i class="bi bi-door-open"></i>
                Department Offices
            </div>

        </div>

        <div class="data-table-wrapper">

            <table class="table data-table">

                <tbody>

                    <tr>
                        <th>HOD Room with Office & Records</th>
                        <td>
                            @(Model.HasHodRoomWithOfficeAndRecords == true
                                ? "Yes"
                                : "No")
                        </td>
                    </tr>

                    <tr>
                        <th>Rooms for Faculty & Residents</th>
                        <td>
                            @(Model.HasRoomsForFacultyAndResidents == true
                                ? "Yes"
                                : "No")
                        </td>
                    </tr>

                    <tr>
                        <th>Communication / Computer / Internet</th>
                        <td>
                            @(Model.FacultyRoomsHaveCommunicationComputerInternet == true
                                ? "Yes"
                                : "No")
                        </td>
                    </tr>

                    <tr>
                        <th>Rooms for Non-Teaching Staff</th>
                        <td>
                            @(Model.HasRoomsForNonTeachingStaff == true
                                ? "Yes"
                                : "No")
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- DENTAL EDUCATION UNIT -->
    <!-- ====================================================== -->

    @if (Model.Dental != null)
    {
        <div class="section-block">

            <div class="section-header-block">

                <div class="section-title-text section-badge">
                    <i class="bi bi-mortarboard-fill"></i>
                    Dental Education Unit
                </div>

            </div>

            <div class="data-table-wrapper">

                <table class="table data-table">

                    <tbody>

                        <!-- ====================================== -->
                        <!-- DEU AVAILABLE -->
                        <!-- ====================================== -->

                        <tr>
                            <th>Dental Education Unit</th>

                            <td>
                                @(Model.Dental.HasDentalEducationUnit == true
                                    ? "Yes"
                                    : "No")
                            </td>
                        </tr>


                        @if (Model.Dental.HasDentalEducationUnit == true)
                        {
                            <!-- ====================================== -->
                            <!-- AREA -->
                            <!-- ====================================== -->

                            <tr>
                                <th>Area (Sq.m)</th>

                                <td>
                                    @(Model.Dental.DentalEducationUnitAreaSqm?.ToString("0.##") ?? "—")
                                </td>
                            </tr>


                            <!-- ====================================== -->
                            <!-- AUDIO VISUAL -->
                            <!-- ====================================== -->

                            <tr>
                                <th>Audio Visual Facility</th>

                                <td>
                                    @(Model.Dental.DentalEducationUnitHasAudioVisual == true
                                        ? "Yes"
                                        : "No")
                                </td>
                            </tr>


                            <!-- ====================================== -->
                            <!-- INTERNET -->
                            <!-- ====================================== -->

                            <tr>
                                <th>Internet Facility</th>

                                <td>
                                    @(Model.Dental.DentalEducationUnitHasInternet == true
                                        ? "Yes"
                                        : "No")
                                </td>
                            </tr>


                            <!-- ====================================== -->
                            <!-- COORDINATOR NAME -->
                            <!-- ====================================== -->

                            <tr>
                                <th>Coordinator Name</th>

                                <td>
                                    @(string.IsNullOrWhiteSpace(Model.Dental.DeuCoordinatorName)
                                        ? "—"
                                        : Model.Dental.DeuCoordinatorName)
                                </td>
                            </tr>


                            <!-- ====================================== -->
                            <!-- DESIGNATION / DEPARTMENT -->
                            <!-- ====================================== -->

                            <tr>
                                <th>Designation / Department</th>

                                <td>
                                    @(string.IsNullOrWhiteSpace(Model.Dental.DeuCoordinatorDesignationDepartment)
                                        ? "—"
                                        : Model.Dental.DeuCoordinatorDesignationDepartment)
                                </td>
                            </tr>


                            <!-- ====================================== -->
                            <!-- PHONE -->
                            <!-- ====================================== -->

                            <tr>
                                <th>Phone</th>

                                <td>
                                    @(string.IsNullOrWhiteSpace(Model.Dental.DeuCoordinatorPhone)
                                        ? "—"
                                        : Model.Dental.DeuCoordinatorPhone)
                                </td>
                            </tr>


                            <!-- ====================================== -->
                            <!-- EMAIL -->
                            <!-- ====================================== -->

                            <tr>
                                <th>Email</th>

                                <td>
                                    @(string.IsNullOrWhiteSpace(Model.Dental.DeuCoordinatorEmail)
                                        ? "—"
                                        : Model.Dental.DeuCoordinatorEmail)
                                </td>
                            </tr>


                            <!-- ====================================== -->
                            <!-- ACTIVITIES -->
                            <!-- ====================================== -->

                            <tr>
                                <th>Activities Last Academic Year</th>

                                <td>
                                    @(string.IsNullOrWhiteSpace(Model.Dental.DeuActivitiesLastAcademicYear)
                                        ? "—"
                                        : Model.Dental.DeuActivitiesLastAcademicYear)
                                </td>
                            </tr>


                            <!-- ====================================== -->
                            <!-- MEMBERS LIST -->
                            <!-- ====================================== -->

                            <tr>
                                <th>Members List</th>

                                <td>

                                    @if (Model.Dental.HasDeuMembersListFile)
                                    {
                                        <a asp-controller="Medical_ContinuousAffiliation"
                                           asp-action="ViewDeuMembersList"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-file-earmark-pdf"></i>
                                            View PDF

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Not Uploaded
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <!-- ====================================================== -->
        <!-- NO DEU DATA -->
        <!-- ====================================================== -->

        <div class="section-block">

            <div class="empty-state text-center p-4">

                <i class="bi bi-mortarboard"
                   style="font-size: 2rem;"></i>

                <p class="mt-2 mb-0 text-muted">
                    No Dental Education Unit details available.
                </p>

            </div>

        </div>
    }

</div>