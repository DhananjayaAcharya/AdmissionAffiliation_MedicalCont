@await Html.PartialAsync("_DocumentViewer")

<script>
    document.addEventListener('DOMContentLoaded', function() {

        const navigationTabs =
            document.querySelector('.navigation-tabs');

        const navContainer =
            document.querySelector('.nav-tabs-custom');

        const navLinks =
            document.querySelectorAll('.nav-tabs-custom .nav-link');

        const scrollContainer =
            document.querySelector('.ca-body');

        if (!navigationTabs || !navContainer || !navLinks.length || !scrollContainer) {
            return;
        }


        /* =========================================================
           STICKY NAVIGATION SHADOW
           ========================================================= */

        const updateStickyState = () => {

            const rect = navigationTabs.getBoundingClientRect();

            const containerRect =
                scrollContainer.getBoundingClientRect();

            if (rect.top <= 1) {
                navigationTabs.classList.add('is-sticky');
            } else {
                navigationTabs.classList.remove('is-sticky');
            }
        };


        scrollContainer.addEventListener(
            'scroll',
            updateStickyState,
            { passive: true }
        );

        updateStickyState();


        /* =========================================================
           GET SECTIONS FROM NAVIGATION LINKS
           ========================================================= */

        const sections = [];

        navLinks.forEach(link => {

            const targetId =
                link.getAttribute('href');

            if (!targetId || !targetId.startsWith('#')) {
                return;
            }

            const section =
                document.querySelector(targetId);

            if (section) {
                sections.push({
                    id: targetId.substring(1),
                    element: section,
                    link: link
                });
            }
        });


        /* =========================================================
           NAVIGATION CLICK
           ========================================================= */

        navLinks.forEach(link => {

            link.addEventListener('click', function(e) {

                e.preventDefault();

                const targetId =
                    this.getAttribute('href');

                const targetSection =
                    document.querySelector(targetId);

                if (!targetSection) {
                    return;
                }


                const navHeight =
                    navigationTabs.offsetHeight;


                /*
                 * Calculate the exact position.
                 * This prevents the section heading from
                 * hiding underneath the sticky navigation.
                 */

                const containerRect =
                    scrollContainer.getBoundingClientRect();

                const targetPosition =
                    targetSection.offsetTop -
                    navHeight -
                    15;

                scrollContainer.scrollTo({
                    top: Math.max(0, targetPosition),
                    behavior: 'smooth'
                });


                /*
                 * Immediately update active tab
                 */

                navLinks.forEach(item =>
                    item.classList.remove('active')
                );

                this.classList.add('active');


                /*
                 * Keep selected tab visible
                 */

                scrollNavLinkIntoView(this);
            });

        });


        /* =========================================================
           KEEP ACTIVE TAB VISIBLE
           ========================================================= */

        function scrollNavLinkIntoView(link) {

            const containerRect =
                navContainer.getBoundingClientRect();

            const linkRect =
                link.getBoundingClientRect();

            if (linkRect.left < containerRect.left) {

                navContainer.scrollBy({
                    left:
                        linkRect.left -
                        containerRect.left -
                        20,

                    behavior: 'smooth'
                });

            }
            else if (linkRect.right > containerRect.right) {

                navContainer.scrollBy({
                    left:
                        linkRect.right -
                        containerRect.right +
                        20,

                    behavior: 'smooth'
                });
            }
        }


        /* =========================================================
           UPDATE ACTIVE TAB WHILE SCROLLING
           ========================================================= */

        let ticking = false;

        function updateActiveSection() {

            if (!sections.length) {
                return;
            }

            const navHeight =
                navigationTabs.offsetHeight;

            /*
             * Position where a section becomes active.
             */

            const activationPoint =
                navHeight + 40;

            let currentSection = sections[0];


            sections.forEach(section => {

                const rect =
                    section.element.getBoundingClientRect();

                if (rect.top <= activationPoint) {
                    currentSection = section;
                }

            });


            /*
             * Update active tab
             */

            navLinks.forEach(link => {
                link.classList.remove('active');
            });

            if (currentSection) {

                currentSection.link.classList.add('active');

                /*
                 * Automatically bring active tab
                 * into horizontal view.
                 */

                scrollNavLinkIntoView(
                    currentSection.link
                );
            }

            ticking = false;
        }


        scrollContainer.addEventListener('scroll', function() {

            if (!ticking) {

                window.requestAnimationFrame(
                    updateActiveSection
                );

                ticking = true;
            }

        }, { passive: true });


        function updateSectionOffset() {
            const navHeight = navigationTabs.offsetHeight;

            document
                .querySelectorAll('.sections-container > div[id]')
                .forEach(section => {
                    section.style.scrollMarginTop = `${navHeight + 15}px`;
                });
        }

        updateSectionOffset();
        window.addEventListener('resize', updateSectionOffset);


        /* =========================================================
           INITIAL ACTIVE SECTION
           ========================================================= */

        updateActiveSection();

    });
</script>