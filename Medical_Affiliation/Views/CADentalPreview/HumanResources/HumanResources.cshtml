@model Medical_Affiliation.Models.HumanResourcesVM
@{
    var FacultyCode = Context.Session.GetString("FacultyCode");
    var AffiliationType = Context.Session.GetString("TypeOfAffiliation");
}

<link rel="stylesheet"
      href="~/css/preview-section-header.css" />

@if (Model != null)
{
    <div class="general-section">

        <!-- ====================================================== -->
        <!-- HEADER -->
        <!-- ====================================================== -->

        <div class="preview-section-header">

            <div class="preview-section-header-content">

                <div class="preview-section-title">

                    <i class="bi bi-person-workspace"></i>

                    <div>
                        <h4>
                            Faculty Details
                        </h4>
                    </div>

                </div>

                <a class="preview-section-edit"
                   href="@Url.Action(
                        "Repo_FacultyDetails",
                        "DentalFacultyDetails",
                        new
                        {
                            typeOfAffiliation = @AffiliationType
                        })">

                    <i class="bi bi-pencil-square"></i>

                    <span>Edit section</span>

                </a>

            </div>

        </div>

        <!-- ====================================================== -->
        <!-- FACULTY DETAILS -->
        <!-- ====================================================== -->
        @if (Model.FacultyDetails != null &&
                     Model.FacultyDetails.Any())
        {
            @await Html.PartialAsync("HumanResources/_FacultyDetails", Model.FacultyDetails)
        }

        <!-- ====================================================== -->
        <!-- TEACHING FACULTY DEPARTMENT-WISE -->
        <!-- ====================================================== -->
        @* Will be added next *@
        @if (Model.TeachingFacultyDepartments != null)
        {
            @await Html.PartialAsync("HumanResources/_TeachingFacultyDepartmentWise", Model.TeachingFacultyDepartments)
        }

        <!-- ====================================================== -->
        <!-- NON-TEACHING FACULTY DETAILS -->
        <!-- ====================================================== -->
        @* Will be added later *@
        @* @if (Model.NonTeachingFacultyDetails != null)
        {
            <partial name="_NonTeachingFacultyDetails"
                     model="Model.NonTeachingFacultyDetails" />
        } *@

    </div>
}