@model List<Medical_Affiliation.Models.ActionTakenDeficiencyReportPreviewVM>

@{
    var FacultyCode = Context.Session.GetString("FacultyCode");
    var AffiliationType = Context.Session.GetString("TypeOfAffiliation");
}

<link rel="stylesheet"
      href="~/css/preview-section-header.css" />

@if (Model != null && Model.Any())
{

    <div class="preview-section-header">

        <div class="preview-section-header-content">

            <h4 class="preview-section-title">
                <i class="bi bi-building me-2"></i>
                Action Taken Deficiency Report
            </h4>

            <a class="preview-section-edit"
               href="@Url.Action(
                    "Index",
                    "ActiontakenDeficiencyReport",
                    new
                    {
                        typeOfAffiliation = @AffiliationType
                    })">

                <i class="bi bi-pencil-square"></i>
                <span>Edit section</span>

            </a>

        </div>

    </div>
    <div class="section-block">

        <div class="section-header-block">

            <div class="section-title-text section-badge">
                <i class="bi bi-clipboard2-check"></i>
                Action Taken on Deficiency Reports
            </div>

            <p class="section-description">
                Details of deficiencies pointed out and the action taken to remedy them
            </p>

        </div>

        <div class="data-table-wrapper">

            <table class="table data-table table-hover align-middle">

                <thead>
                    <tr>
                        <th style="width: 70px;">
                            Sl. No.
                        </th>

                        <th>
                            Deficiency Pointed Out
                        </th>

                        <th>
                            Extent to Which Deficiency Was Remedied
                        </th>

                        <th class="text-center" style="width: 160px;">
                            Relevant Report
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        var slNo = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @slNo
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.DeficiencyPointedOut))
                                {
                                    @item.DeficiencyPointedOut
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.ExtentRemedied))
                                {
                                    @item.ExtentRemedied
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <td class="text-center">

                                @if (item.HasRelevantReport)
                                {
                                    <a asp-controller="CA_Aff_Dental"
                                       asp-action="ViewActionTakenDeficiencyReport"
                                       asp-route-id="@item.ActionTakenDeficiencyReportId"
                                       target="_blank"
                                       class="status-badge-maintained text-decoration-none">

                                        <i class="bi bi-file-earmark-pdf me-1"></i>
                                        View
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">
                                        Not Uploaded
                                    </span>
                                }

                            </td>

                        </tr>

                        slNo++;
                    }

                </tbody>

            </table>

        </div>

    </div>
}
else
{
    <div class="empty-state">

        <i class="bi bi-clipboard-x"></i>

        <p class="mb-0">
            No action taken deficiency reports available.
        </p>

    </div>
}