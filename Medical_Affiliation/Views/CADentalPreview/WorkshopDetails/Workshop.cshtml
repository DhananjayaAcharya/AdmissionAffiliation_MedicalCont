@model List<Medical_Affiliation.Models.WorkShopDetail>

@{
    var FacultyCode = Context.Session.GetString("FacultyCode");
    var AffiliationType = Context.Session.GetString("TypeOfAffiliation");
}

<link rel="stylesheet" href="~/css/preview.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/preview-section-header.css" asp-append-version="true" />

<div class="general-section">

    <!-- ====================================================== -->
    <!-- HEADER -->
    <!-- ====================================================== -->

    <div class="preview-section-header">

        <div class="preview-section-header-content">

            <div class="preview-section-title">

                <i class="bi bi-list-check"></i>

                <div>
                    <h3>
                        Workshop Details
                    </h3>

                </div>

            </div>

            <a class="preview-section-edit"
               href="@Url.Action(
                    "Aff_HostelDetails",
                    "ContinuesAffiliation_Facultybased",
                    new
                    {
                        typeOfAffiliation = @AffiliationType
                    })">

                <i class="bi bi-pencil-square"></i>

                <span>Edit section</span>

            </a>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- WORKSHOP DETAILS -->
    <!-- ====================================================== -->

    <div class="section-block">

        <div class="section-header-block mb-3">

            <div class="section-title-text section-badge">
                <i class="bi bi-wrench-adjustable-circle"></i>
                Workshop Information
            </div>

            <p class="section-description">
                Details of staff, equipment and scope of work available in the workshop.
            </p>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="data-table-wrapper">

                <table class="table data-table table-bordered align-middle">

                    <thead>
                        <tr>

                            <th class="text-center" style="width: 80px;">
                                Sl.No
                            </th>

                            <th>
                                Staff
                            </th>

                            <th>
                                Equipment
                            </th>

                            <th>
                                Scope of Work
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                        @{
                            var serialNo = 1;
                        }

                        @foreach (var workshop in Model)
                        {
                            <tr>

                                <td class="text-center">
                                    @serialNo
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(workshop.Staff))
                                    {
                                        @workshop.Staff
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(workshop.Equipment))
                                    {
                                        @workshop.Equipment
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(workshop.ScopeOfWork))
                                    {
                                        @workshop.ScopeOfWork
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                            </tr>

                            serialNo++;
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">

                <i class="bi bi-info-circle"
                   style="font-size: 2rem;"></i>

                <p class="mt-2 mb-0">
                    No workshop details available.
                </p>

            </div>
        }

    </div>

</div>