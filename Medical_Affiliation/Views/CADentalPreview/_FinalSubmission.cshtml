@model Medical_Affiliation.Models.DentalFinalSubmissionViewModel

@{
    var isSubmitted = Model.IsSubmitted && Model.IsActive;
}

<style>
    .final-submission-card {
        border: 1px solid #dfc5c8;
        border-radius: 14px;
        overflow: hidden;
        background: #fffafa;
        box-shadow: 0 5px 18px rgba(67, 26, 34, .07);
    }

    .principal-div{
        display: flex;
        align-items: center;
        gap: 0.7rem;
    }
    .final-submission-header {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 12px 25px;
        /* background: #742d35; */
        background: #2f7379;
        color: #fff;
    }

    .submission-header-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 12px;
        background: rgba(255,255,255,.10);
        font-size: 24px;
        flex-shrink: 0;
    }

    .final-submission-header h4 {
        margin: 0 0 5px;
        font-size: 21px;
        font-weight: 700;
    }

    .final-submission-header p {
        margin: 0;
        color: #f4e7e9;
        font-size: 14px;
    }

    .final-submission-body {
        padding: 25px;
    }

    .principal-details {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 17px 20px;
        border: 1px solid #eadbdd;
        border-radius: 10px;
        background: #f8f0f1;
    }

    .principal-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        min-width: 48px;
        height: 48px;
        border-right: 1px solid #eadbdd;
        color: #742d35;
        font-size: 25px;
    }

    .principal-label {
        /* margin-bottom: 5px; */
        font-size: 15px;
        font-weight: 600;
    }

    .principal-name {
        color: #42252a;
        font-size: 17px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    /* Completed state */
    .submission-completed {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 22px;
        border: 1px solid #a8d9b5;
        border-radius: 10px;
        background: #eef9f1;
        color: #17683b;
    }

    .submission-success-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        min-width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #16803c;
        color: #fff;
        font-size: 27px;
    }

    .submission-completed-content {
        flex: 1;
        min-width: 0;
    }

    .submission-completed-content > strong {
        display: block;
        margin-bottom: 7px;
        font-size: 19px;
        font-weight: 700;
    }

    .submission-completed-content > p {
        margin: 0 0 18px;
        color: #294c37;
        font-size: 14px;
        line-height: 1.7;
    }

    .submission-meta {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .submission-meta-item {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
    }

    .submission-meta-item > i {
        color: #2456a6;
        font-size: 27px;
        flex-shrink: 0;
    }

    .submission-meta-item span {
        display: block;
        margin-bottom: 5px;
        color: #53675a;
        font-size: 13px;
    }

    .submission-meta-item strong {
        display: block;
        color: #183d27;
        font-size: 15px;
        overflow-wrap: anywhere;
    }

    /* Existing form */
    .submission-warning {
        padding: 18px;
        border: 1px solid #f0c6ca;
        border-left: 5px solid #b42332;
        border-radius: 9px;
        background: #fff0f1;
        color: #76232b;
    }

    .warning-heading {
        margin-bottom: 10px;
        font-weight: 800;
    }

    .submission-warning p {
        margin-bottom: 10px;
        line-height: 1.7;
        font-size: 14px;
    }

    .consent-check {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        padding: 16px;
        border: 1px solid #e5d9db;
        border-radius: 9px;
        background: #fff;
    }

    .consent-check .form-check-input {
        flex-shrink: 0;
        float: none;
        margin: 4px 0 0;
        width: 19px;
        height: 19px;
        cursor: pointer;
    }

    .consent-check .form-check-label {
        color: #45363a;
        font-size: 14px;
        line-height: 1.8;
        cursor: pointer;
    }

    .final-submit-btn {
        min-width: 200px;
        padding: 12px 22px;
        border-radius: 8px;
        font-weight: 700;
    }

    .final-submit-btn:hover {
        background: #8d2634;
    }

    .submission-footer-note {
        color: #75656a;
        font-size: 12px;
    }

    .submission-error {
        padding: 14px;
        border-radius: 8px;
        background: #fff0f1;
        color: #a12632;
    }

    @@media (max-width: 576px) {
        .final-submission-header,
        .final-submission-body {
            padding: 17px;
        }

        .final-submission-header h4 {
            font-size: 18px;
        }

        .submission-completed {
            padding: 15px;
            gap: 10px;
        }

        .submission-success-icon {
            width: 38px;
            min-width: 38px;
            height: 38px;
            font-size: 22px;
        }

        .submission-completed-content > strong {
            font-size: 16px;
        }

        .submission-meta {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .final-submit-btn {
            width: 100%;
        }
    }
</style>

<div class="final-submission-card my-4">

    <!-- Header -->
    <div class="final-submission-header">
        <div class="submission-header-icon">
            <i class="bi bi-shield-check"></i>
        </div>

        <div>
            <h4>Final Application Submission</h4>
            <p>
                @(isSubmitted
                    ? "Your application submission status."
                    : "Review the declaration carefully before proceeding.")
            </p>
        </div>
    </div>

    <div class="final-submission-body">

        <!-- Principal Details -->
        <div class="principal-details">
            <div class="principal-icon">
                <i class="bi bi-person"></i>
            </div>

            <div class="principal-div">
                <div class="principal-label">Principal Name :</div>
                <div class="principal-name">
                    @(string.IsNullOrWhiteSpace(Model.PrincipalName)
                        ? "Principal name not available"
                        : Model.PrincipalName)
                </div>
            </div>
        </div>

        @if (isSubmitted)
        {
            <!-- SUCCESS STATE -->
            <div class="submission-completed mt-4" role="status">
                <div class="submission-success-icon">
                    <i class="bi bi-check-lg"></i>
                </div>

                <div class="submission-completed-content">
                    <strong>
                        Final Submission Completed Successfully!
                    </strong>

                    <p>
                        Your application has been submitted successfully.
                        All application details are now locked. You cannot
                        edit or submit this application again unless it is
                        reopened by an authorized administrator.
                    </p>

                    <div class="submission-meta">
                        <div class="submission-meta-item">
                            <i class="bi bi-file-earmark-text"></i>
                            <div>
                                <span>Application Number</span>
                                <strong>
                                    @Model.ApplicationNumber
                                </strong>
                            </div>
                        </div>

                        <div class="submission-meta-item">
                            <i class="bi bi-calendar-check"></i>
                            <div>
                                <span>Submitted On</span>
                                <strong>
                                    @(Model.CreatedDate != DateTime.MinValue
                                        ? Model.CreatedDate.ToString("dd-MM-yyyy hh:mm tt")
                                        : "Not available")
                                </strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (string.IsNullOrWhiteSpace(Model.PrincipalName))
        {
            <div class="submission-error mt-3">
                <i class="bi bi-exclamation-triangle-fill"></i>
                Principal details are missing. Please update the
                institution details before final submission.
            </div>
        }
        else
        {
            <!-- SUBMISSION FORM -->
            <form asp-controller="CADentalPreview"
                  asp-action="FinalSubmit"
                  method="post"
                  id="finalSubmissionForm">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="CollegeCode" />
                <input type="hidden" asp-for="FacultyCode" />
                <input type="hidden" asp-for="AffiliationTypeId" />
                <input type="hidden" asp-for="CourseLevel" />
                <input type="hidden" asp-for="AcademicYear" />
                <input type="hidden"
                       asp-for="AffiliationTypeDescription" />

                <div class="submission-warning mt-4">
                    <div class="warning-heading">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Important: Irreversible Submission
                    </div>

                    <p>
                        Once you submit this application, it will be
                        completely frozen for the college. You will no
                        longer be able to add, edit, or delete application
                        details or documents through the college portal.
                    </p>

                    <p class="mb-0">
                        Please verify all details and uploaded documents
                        before proceeding.
                    </p>
                </div>

                <div class="form-check consent-check mt-4">
                    <input class="form-check-input"
                           asp-for="PrincipalConsent"
                           id="PrincipalConsent" />

                    <label class="form-check-label"
                           for="PrincipalConsent">
                        I, <strong>@Model.PrincipalName</strong>, as the
                        Principal of this institution, confirm that all
                        information and documents submitted are correct
                        and complete. I consent to final submission and
                        understand that the application will be frozen.
                    </label>
                </div>

                <button type="button"
                        id="finalSubmitButton"
                        class="btn btn-danger final-submit-btn mt-4">
                    <i class="bi bi-lock-fill"></i>
                    Final Submit
                </button>

                <p class="submission-footer-note mt-3">
                    <i class="bi bi-info-circle"></i>
                    Principal consent is mandatory to continue.
                </p>
            </form>
        }
    </div>
</div>

@if (!isSubmitted && !string.IsNullOrWhiteSpace(Model.PrincipalName))
{
    <div class="modal fade"
         id="finalSubmitConfirmModal"
         tabindex="-1"
         aria-labelledby="finalSubmitConfirmTitle"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content final-confirm-modal">

                <div class="modal-header">
                    <h5 class="modal-title" id="finalSubmitConfirmTitle">
                        Confirm Final Submission
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p>
                        Are you sure you want to submit this application
                        on behalf of <strong>@Model.CollegeName</strong>?
                    </p>

                    <div class="confirm-warning">
                        <i class="bi bi-lock-fill"></i>
                        <span>
                            This action is irreversible. The application
                            will be locked after successful submission.
                        </span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            id="confirmFinalSubmitButton">
                        <i class="bi bi-check-circle"></i>
                        Yes, Submit Application
                    </button>
                </div>

            </div>
        </div>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    (() => {
        const form = document.getElementById("finalSubmissionForm");

        if (!form || form.dataset.initialized === "true") return;

        form.dataset.initialized = "true";

        const consent = document.getElementById("PrincipalConsent");
        const submitButton = document.getElementById("finalSubmitButton");
        const confirmButton = document.getElementById("confirmFinalSubmitButton");
        const modalElement = document.getElementById("finalSubmitConfirmModal");

        if (!consent || !submitButton || !confirmButton || !modalElement) {
            console.error("Final submission form or confirmation modal is missing.");
            return;
        }

        if (typeof bootstrap === "undefined" || !bootstrap.Modal) {
            console.error("Bootstrap JavaScript is not loaded.");
            return;
        }

        let submitting = false;
        const modal = bootstrap.Modal.getOrCreateInstance(modalElement);

        // Click Final Submit
        submitButton.addEventListener("click", () => {
            if (submitting) return;

            if (!consent.checked) {
                Swal.fire({
                    icon: "warning",
                    title: "Principal Consent Required",
                    text: "Please check the principal consent checkbox before proceeding.",
                    confirmButtonColor: "#742d35"
                });
                return;
            }

            modal.show();
        });

        // Confirm submission
        confirmButton.addEventListener("click", () => {
            if (submitting) return;

            if (!consent.checked) {
                Swal.fire({
                    icon: "warning",
                    title: "Consent Required",
                    text: "Principal consent is required.",
                    confirmButtonColor: "#742d35"
                });
                return;
            }

            submitting = true;
            confirmButton.disabled = true;
            submitButton.disabled = true;

            confirmButton.innerHTML =
                '<span class="spinner-border spinner-border-sm me-2"></span>Submitting...';

            // Submit the form after confirmation.
            modal.hide();

            HTMLFormElement.prototype.submit.call(form);
        });

    })();
</script>