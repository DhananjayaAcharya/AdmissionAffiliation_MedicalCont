@model DentalInstitutionBasicDetailsDisplayVM
@{
}

<div class="general-body">
    <div class="section-block">
        <div class="section-header-block mb-3">
            <div class="section-title-text department-badge">
                <i class="bi bi-person-workspace"></i>
                Administrative Authority Details
            </div>
        </div>

        @if (Model != null)
        {
            <div class="data-table-wrapper">
                <table class="table data-table align-middle">
                    <tbody>
                        <tr>
                            <th>Adminstrative Authority Name</th>
                            <td>@Model.AdministrativeAuthorityVM.NameOfAdministrativeAuthority</td>
                        </tr>
                        <tr>
                            <th>Address</th>
                            <td>@Model.AdministrativeAuthorityVM.AddressOfAdministrativeAuthority</td>
                        </tr>
                        <tr>
                            <th>Governing Body/Council Mmembers Document</th>
                            <td>
                                @if (Model.AdministrativeAuthorityVM.hasMembersOfGoverningBodyOrCouncilDocument)
                                {
                                    <a asp-controller = "ContinuesAffiliation_Facultybased"
                                       asp-action = "ViewGoverningBodyDocument"
                                       asp-route-id ="@Model.CollegeCode"
                                       target = "_blank"
                                       class = "btn btn-sm btn-primary"
                                    >
                                        <i class="bi bi-eye"></i>
                                        
                                        View

                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Not Available</span>
                                }
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <p>No Administrative Authority details available.</p>
            </div>
        }
    </div>
</div>