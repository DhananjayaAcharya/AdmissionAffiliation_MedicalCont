@model Medical_Affiliation.Models.CADentalBedDistributionPreviewViewModel

@{
    var FacultyCode = Context.Session.GetString("FacultyCode");
    var AffiliationType = Context.Session.GetString("TypeOfAffiliation");

}
@* <link rel="stylesheet" href="~/css/preview.css" asp-append-version="true" /> *@

<link rel="stylesheet"
      href="~/css/preview-section-header.css" />

<div class="general-section">

    <!-- ====================================================== -->
    <!-- HEADER -->
    <!-- ====================================================== -->


    <div class="preview-section-header">

        <div class="preview-section-header-content">

            <h4 class="preview-section-title">
                <i class="bi bi-building me-2"></i>
                 Bed Distribution
            </h4>

            <a class="preview-section-edit"
               href="@Url.Action(
                    "Medical_DepartmentOfficesAndEducationalUnit",
                    "Medical_ContinuousAffiliation",
                    new
                    {
                        typeOfAffiliation = "Continuation of Affiliation"
                    })">

                <i class="bi bi-pencil-square"></i>
                <span>Edit section</span>

            </a>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- DENTAL BED DISTRIBUTION -->
    <!-- ====================================================== -->

    @if (Model != null && Model.OralMaxillofacialSurgery.HasValue)
    {
        <div class="section-block">

            <div class="section-header-block">
                <div class="section-title-text section-badge">
                    <i class="bi bi-grid-3x3-gap"></i>
                    Dental Bed Distribution
                </div>
            </div>

            <div class="data-table-wrapper">

                <table class="table data-table">

                    <thead>
                        <tr>
                            <th>Department</th>
                            <th class="text-center">Beds Present</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td>
                                Oral &amp; Maxillofacial Surgery
                            </td>

                            <td class="text-center">
                                @Model.OralMaxillofacialSurgery
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="section-block">

            <div class="text-center text-muted py-4">
                <i class="bi bi-info-circle me-1"></i>
                No dental bed distribution details available.
            </div>

        </div>
    }

</div>