@model Medical_Affiliation.Models.DentalFeeStructureViewModel

<link rel="stylesheet" href="~/css/preview.css" asp-append-version="true" />

<style>
    .payment-body {
        padding: 2rem;
        background: white;
    }

    .payment-block {
        background: linear-gradient(135deg, #fffbeb 0%, #fefce8 100%);
        border-radius: 16px;
        padding: 1.5rem;
        border: 1px solid #fde68a;
        margin-bottom: 1.5rem;
    }

    .payment-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #92400e;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .payment-value {
        font-size: 1rem;
        font-weight: 600;
        color: #1f2937;
        word-break: break-word;
    }

    .amount-highlight {
        font-size: 1.4rem;
        font-weight: 700;
        color: #059669;
    }

    .download-btn {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .download-btn:hover {
        color: white;
        opacity: 0.9;
    }

    .empty-state {
        text-align: center;
        padding: 2rem;
        color: #9ca3af;
        border: 2px dashed #e5e7eb;
        border-radius: 12px;
    }

    .academic-header {
        position: relative;
        z-index: 10;
    }

    .edit-button {
        position: relative;
        z-index: 20;
        pointer-events: auto !important;
        cursor: pointer;
    }
</style>

<div class="academic-section">

    <!-- ====================================================== -->
    <!-- HEADER -->
    <!-- ====================================================== -->

    <div class="academic-header d-flex justify-content-between align-items-center">

        <h2 class="academic-title academic-badge">
            <i class="bi bi-credit-card"></i>
            Dental Payment Details
        </h2>

        <a class="edit-button"
           href="@Url.Action("Index", "DentalPayment")">

            <i class="bi bi-pencil-square"></i>
            Edit

        </a>

    </div>


    <!-- ====================================================== -->
    <!-- PAYMENT BODY -->
    <!-- ====================================================== -->

    <div class="payment-body">

        @if (Model != null &&
             Model.PaymentId.HasValue &&
             Model.PaymentId.Value > 0)
        {
            <div class="payment-block">

                <div class="row g-4">

                    <!-- ================================================== -->
                    <!-- AMOUNT PAID -->
                    <!-- ================================================== -->

                    <div class="col-md-4">

                        <div class="payment-label">
                            Amount Paid
                        </div>

                        <div class="amount-highlight">
                            ₹ @Model.AmountPaid.ToString("N2")
                        </div>

                    </div>


                    <!-- ================================================== -->
                    <!-- TRANSACTION ID -->
                    <!-- ================================================== -->

                    <div class="col-md-4">

                        <div class="payment-label">
                            Transaction ID
                        </div>

                        <div class="payment-value">

                            @if (!string.IsNullOrWhiteSpace(Model.TransactionId))
                            {
                                @Model.TransactionId
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }

                        </div>

                    </div>


                    <!-- ================================================== -->
                    <!-- AFFILIATION TYPE ID -->
                    <!-- ================================================== -->

                    <div class="col-md-4">

                        <div class="payment-label">
                            Affiliation Type
                        </div>

                        <div class="payment-value">

                            @if (Model.AffiliationTypeId > 0)
                            {
                                @Model.AffiliationTypeId
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- ================================================== -->
                <!-- PAYMENT RECEIPT -->
                <!-- ================================================== -->

                <div>

                    <div class="payment-label">
                        Payment Receipt
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.TransactionReceiptPath))
                    {
                        <a href="@Url.Action(
                                     "ViewPaymentReceipt",
                                     "DentalPayment",
                                     new
                                     {
                                         path = Model.TransactionReceiptPath
                                     })"
                           target="_blank"
                           class="download-btn">

                            <i class="bi bi-file-earmark-pdf"></i>

                            View Payment Receipt

                        </a>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">

                            <i class="bi bi-file-earmark-x me-1"></i>

                            No payment receipt uploaded

                        </span>
                    }

                </div>

            </div>
        }
        else
        {
            <!-- ====================================================== -->
            <!-- EMPTY STATE -->
            <!-- ====================================================== -->

            <div class="empty-state">

                <i class="bi bi-wallet2"
                   style="font-size:2rem;"></i>

                <p class="mt-2 mb-0">
                    No Dental payment details available.
                </p>

            </div>
        }

    </div>

</div>