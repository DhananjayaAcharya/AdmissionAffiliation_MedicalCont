@model HospitalAffiliationDentalCompositeDisplayVM
@{
    var isDental = Model.FacultyCode == 2;
}

@{
    var FacultyCode = Context.Session.GetString("FacultyCode");
    var AffiliationType = Context.Session.GetString("TypeOfAffiliation");

}
<link rel="stylesheet" href="~/css/preview-section-header.css" asp-append-version="true" />

<div class="general-section">
    <div class="preview-section-header">

        <div class="preview-section-header-content">

            <div class="preview-section-title">

                <i class="bi bi-list-check"></i>

                <div>
                    <h3>
                        Clinical Facilities
                    </h3>
                </div>

            </div>

            <a class="preview-section-edit"
               href="@Url.Action(
                    "ClinicalFacilities",
                    "ContinuationAffiliationClinicalFacilities",
                    new
                    {
                        typeOfAffiliation = @AffiliationType
                    })">

                <i class="bi bi-pencil-square"></i>

                <span>Edit section</span>

            </a>

        </div>

    </div>
    <!-- 🏥 Hospital Summary -->
    @if (Model.ClinicalDentalHospitalDetails != null)
    {
        @await Html.PartialAsync("ClinicalFacilities/_ClinicalHospitalSummary", Model.ClinicalDentalHospitalDetails)
    }

   
    <!-- 🔥 Department-wise Requirements -->
    @if (Model.Sections?.Any() == true)
    {
        @foreach (var deptSection in Model.Sections)
        {
            @await Html.PartialAsync("ClinicalFacilities/_DepartmentSection", deptSection)
        }
    }

    <!-- 📄 Hospital Documents -->
    @if (Model.HospitalDocumentsToBeUploadedList?.Any() == true)
    {
        @await Html.PartialAsync("ClinicalFacilities/_HospitalDocumentsToBeUploaded", Model.HospitalDocumentsToBeUploadedList)
    }

    <!-- Affiliated Hospital Documents  -->
    @if (Model.AffiliatedHospitalDocuments?.Any() == true)
    {

        @await Html.PartialAsync("ClinicalFacilities/_AffiliatedHospitalDocuments", Model.AffiliatedHospitalDocuments)
    }


    <!-- 🛏 Indoor Beds Occupancy -->
    @if (Model.IndoorBedsOccupancy?.Any() == true && Model.FacultyCode == 1)
    {
        @await Html.PartialAsync("ClinicalFacilities/_IndoorBedsOccupancy", Model.IndoorBedsOccupancy)
    }

    <!-- 👩‍⚕️ Supervision in Field Practice Area -->
    @if (Model.SuperVisionInFPa?.Any() == true && Model.FacultyCode == 1)
    {
        @await Html.PartialAsync("ClinicalFacilities/_SuperVisionInFieldPractice", Model.SuperVisionInFPa.First())
    }

    <!-- 📋 Discipline Details -->
    @if (Model.DisciplineDetails?.Disciplines?.Any() == true)
    {
        @await Html.PartialAsync("ClinicalFacilities/_DisciplineDetails", Model.DisciplineDetails)
    }

    @if (Model.EngAlliedServices?.Requirements.Any() != null && isDental)
    {
        @await Html.PartialAsync("ClinicalFacilities/_EngAlliedServices", Model.EngAlliedServices)
    }

    @if (Model.DentalWardBedDistribution?.Any() == true && isDental)
    {
        @await Html.PartialAsync("ClinicalFacilities/_WardBedDistribution", Model.DentalWardBedDistribution)
    }

</div>