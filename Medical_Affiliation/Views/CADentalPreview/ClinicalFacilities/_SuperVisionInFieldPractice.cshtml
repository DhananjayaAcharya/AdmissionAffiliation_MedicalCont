@model List<Medical_Affiliation.Models.DentalFieldPracticeAreaViewModel>

@{
    var FacultyCode = Context.Session.GetString("FacultyCode");
    var AffiliationType = Context.Session.GetString("TypeOfAffiliation");

}

<link rel="stylesheet"
      href="~/css/preview-section-header.css" />
<div class="general-body">

    <div class="preview-section-header">

        <div class="preview-section-header-content">

            <h2 class="preview-section-title">
                <i class="bi bi-building me-2"></i>
                Department-wise Equipment
            </h2>

            <a class="preview-section-edit"
               href="@Url.Action(
                    "Index",
                    "DentalFieldPracticeArea",
                    new
                    {
                        typeOfAffiliation = @AffiliationType
                    })">

                <i class="bi bi-pencil-square"></i>
                <span>Edit section</span>

            </a>

        </div>

    </div>
    @if (Model != null && Model.Any())
    {
        <div class="section-block">

            <div class="section-header-block">
                <div class="section-title-text department-badge">
                    <i class="bi bi-geo-alt-fill"></i>
                    Dental Field Practice Area
                </div>

                <p class="section-description">
                    Details of rural and urban field practice areas
                </p>
            </div>

            <div class="data-table-wrapper">

                <table class="table data-table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Field Type</th>
                            <th>Location</th>
                            <th>Address</th>
                            <th>Managed By</th>
                            <th class="text-center">Population Served</th>
                            <th>Staff List</th>
                            <th>Activities & Services</th>
                            <th>Records Maintained</th>
                            <th>Equipment Available</th>
                            <th>Training Activities</th>
                            <th>Supervision Method</th>
                            <th>Trainee / Supervisor Accommodation</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="fw-semibold text-primary">
                                    @if (item.FieldTypeId.HasValue)
                                    {
                                        var fieldType = item.FieldTypes?
                                            .FirstOrDefault(x =>
                                                x.Value == item.FieldTypeId.Value.ToString());

                                        @(fieldType?.Text ?? "—")
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">—</span>
                                    }
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Location)
                                        ? "—"
                                        : item.Location)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Address)
                                        ? "—"
                                        : item.Address)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.ManagedBy)
                                        ? "—"
                                        : item.ManagedBy)
                                </td>

                                <td class="text-center">
                                    @(item.PopulationServed?.ToString() ?? "—")
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.StaffList))
                                    {
                                        <span class="text-success">
                                            <i class="bi bi-file-earmark-pdf"></i>
                                            Uploaded
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">
                                            Not Uploaded
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.ActivitiesAndServices)
                                        ? "—"
                                        : item.ActivitiesAndServices)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.RecordsMaintained)
                                        ? "—"
                                        : item.RecordsMaintained)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.EquipmentsAvailable)
                                        ? "—"
                                        : item.EquipmentsAvailable)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.TrainingActivities)
                                        ? "—"
                                        : item.TrainingActivities)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.SupervisionMethod)
                                        ? "—"
                                        : item.SupervisionMethod)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.TraineeSupervisorAccommodation)
                                        ? "—"
                                        : item.TraineeSupervisorAccommodation)
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <p class="mb-0">
                No dental field practice area details available.
            </p>
        </div>
    }

</div>