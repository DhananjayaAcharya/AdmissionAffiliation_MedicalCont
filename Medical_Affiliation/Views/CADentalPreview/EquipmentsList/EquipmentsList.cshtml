@model Medical_Affiliation.Models.EquipmentPreviewViewModel
@{
    var FacultyCode = Context.Session.GetString("FacultyCode");
    var AffiliationType = Context.Session.GetString("TypeOfAffiliation");

}

<link rel="stylesheet"
      href="~/css/preview-section-header.css" />

<div class="general-section">

    <!-- ====================================================== -->
    <!-- HEADER -->
    <!-- ====================================================== -->


    <div class="preview-section-header">

        <div class="preview-section-header-content">

            <h2 class="preview-section-title">
                <i class="bi bi-building me-2"></i>
                Department-wise Equipment
            </h2>

            <a class="preview-section-edit"
               href="@Url.Action(
                    "EquipmentList",
                    "Dental",
                    new
                    {
                        typeOfAffiliation = @AffiliationType
                    })">

                <i class="bi bi-pencil-square"></i>
                <span>Edit section</span>

            </a>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- DEPARTMENT EQUIPMENT -->
    <!-- ====================================================== -->
    @if (Model.Departments.Any())
    {
        foreach (var department in Model.Departments)
        {
            <div class="section-block">

                <div class="section-header-block">
                    <div class="section-title-text section-badge">
                        <i class="bi bi-building"></i>
                        @department.DepartmentName
                    </div>
                </div>

                <div class="data-table-wrapper">

                    <table class="table data-table">

                        <thead>

                            <tr>
                                <th>Equipment</th>
                                <th>Specification</th>
                                <th class="text-center">1 Unit Required</th>
                                <th class="text-center">2 Unit Required</th>
                                <th class="text-center">1 Unit Existing</th>
                                <th class="text-center">2 Unit Existing</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in department.Equipments)
                            {
                                <tr>

                                    <td>
                                        @item.EquipmentName
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.Specification)
                                            ? "-"
                                            : item.Specification)
                                    </td>

                                    <td class="text-center">
                                        @(item.OneUnitReq ?? 0)
                                    </td>

                                    <td class="text-center">
                                        @(item.TwoUnitReq ?? 0)
                                    </td>

                                    <td class="text-center">
                                        @(item.OneUnitExisting ?? 0)
                                    </td>

                                    <td class="text-center">
                                        @(item.TwoUnitExisting ?? 0)
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }
    }
    else
    {
        <div class="section-block">

            <div class="text-center text-muted py-4">

                <i class="bi bi-info-circle"></i>

                No equipment details available.

            </div>

        </div>
    }

</div>