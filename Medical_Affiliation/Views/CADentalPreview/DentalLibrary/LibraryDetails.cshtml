@model Medical_Affiliation.Models.DentalLibraryPreviewVM

@{
    var FacultyCode = Context.Session.GetString("FacultyCode");
    var AffiliationType = Context.Session.GetString("TypeOfAffiliation");

}

<link rel="stylesheet"
      href="~/css/preview-section-header.css" />

@* <link rel="stylesheet" href="~/css/preview.css" asp-append-version="true" /> *@

<div class="general-section">

    <!-- ====================================================== -->
    <!-- HEADER -->
    <!-- ====================================================== -->

    <div class="preview-section-header">

       <div class="preview-section-header-content">

            <h3 class="preview-section-title">
                <i class="bi bi-building me-2"></i>
                Library Details
            </h3>

            <a class="preview-section-edit"
                href="@Url.Action(
                    "CA_Med_StaffDetails",
                    "CA_Aff_MedicalLibrary",
                    new
                    {
                        typeOfAffiliation = @AffiliationType
                    })">

                <i class="bi bi-pencil-square"></i>
                <span>Edit section</span>

            </a>

        </div>

    </div>

    
    <!-- ====================================================== -->
    <!-- LIBRARY STAFF -->
    <!-- ====================================================== -->
    @* @if (Model.LibraryStaff.Any())
    {
        <div class="section-block">

            <div class="section-header-block">
                <div class="section-title-text section-badge">
                    <i class="bi bi-people"></i>
                    Library Staff
                </div>
            </div>

            <div class="data-table-wrapper">

                <table class="table data-table">

                    <thead>

                        <tr>

                            <th>Name</th>
                            <th>Designation</th>
                            <th>Qualification</th>
                            <th class="text-center">Experience</th>
                            <th>Category</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.LibraryStaff)
                        {
                            <tr>

                                <td>@item.StaffName</td>
                                <td>@item.Designation</td>
                                <td>@item.Qualification</td>
                                <td class="text-center">@item.Experience</td>
                                <td>@item.Category</td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    } *@

    <!-- ====================================================== -->
    <!-- DEPARTMENT LIBRARIES -->
    <!-- ====================================================== -->
    @if (Model.DepartmentLibraries.Any())
    {
        <div class="section-block">

            <div class="section-header-block">
                <div class="section-title-text section-badge">
                    <i class="bi bi-building"></i>
                    Department Libraries
                </div>
            </div>

            <div class="data-table-wrapper">

                <table class="table data-table">

                    <thead>

                        <tr>

                            <th>Department</th>
                            <th>Total Books</th>
                            <th>Books Added</th>
                            <th>Current Journals</th>
                            <th>Library Staff 1</th>
                            <th>Library Staff 2</th>
                            <th>Titles</th>
                            <th>International Journals</th>
                            <th>Back Volumes</th>
                            <th>Print Journal %</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.DepartmentLibraries)
                        {
                            <tr>

                                <td>@item.DepartmentName</td>
                                <td>@item.TotalBooks</td>
                                <td>@item.BooksAddedInYear</td>
                                <td>@item.CurrentJournals</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.LibraryStaff1))
                                    {
                                        @item.LibraryStaff1
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.LibraryStaff2))
                                    {
                                        @item.LibraryStaff2
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@item.Titles</td>
                                <td>@item.InternationalJournals</td>
                                <td>@item.BackVolumes</td>
                                <td>@item.PrintJournalPercentage</td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

    <!-- ====================================================== -->
    <!-- OTHER DETAILS -->
    <!-- ====================================================== -->
    @* @if (Model.OtherDetails != null)
    {
        <div class="section-block">

            <div class="section-header-block">
                <div class="section-title-text section-badge">
                    <i class="bi bi-info-circle"></i>
                    Other Details
                </div>
            </div>

            <table class="table data-table">

                <tbody>

                    <tr>
                        <th>Digital Valuation Centre</th>
                        <td>@Model.OtherDetails.HasDigitalValuationCentre</td>
                    </tr>

                    <tr>
                        <th>No. of Systems</th>
                        <td>@Model.OtherDetails.NoOfSystems</td>
                    </tr>

                    <tr>
                        <th>Stable Internet</th>
                        <td>@Model.OtherDetails.HasStableInternet</td>
                    </tr>

                    <tr>
                        <th>CCTV Camera System</th>
                        <td>@Model.OtherDetails.HasCccameraSystem</td>
                    </tr>

                    <tr>

                        <th>Special Features</th>

                        <td>

                            @if (Model.OtherDetails.HasSpecialFeatures)
                            {
                                <a asp-controller="@Model.OtherDetails.ViewController"
                                   asp-action="@Model.OtherDetails.ViewAction"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                            }
                            else
                            {
                                <span>No</span>
                            }

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>
    } *@

    <!-- ====================================================== -->
    <!-- DENTAL LIBRARY RECORDS -->
    <!-- ====================================================== -->

    @if (Model.DentalLibraryRecords != null && Model.DentalLibraryRecords.Any())
    {
        <div class="section-block">

            <div class="section-header-block">
                <div class="section-title-text section-badge">
                    <i class="bi bi-folder2-open"></i>
                    Dental Library Records
                </div>

                <p class="section-description">
                    Dental library documents and records
                </p>
            </div>

            <div class="data-table-wrapper">

                <table class="table data-table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Record</th>
                            <th class="text-center" style="width: 180px;">
                                Document
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.DentalLibraryRecords)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @item.RecordName
                                </td>

                                <td class="text-center">

                                    @if (item.HasDocument)
                                    {
                                        <a asp-controller="@item.ViewController"
                                            asp-action="@item.ViewAction"
                                            asp-route-recordId="@item.RecordId"
                                            target="_blank"
                                            class="status-badge-maintained text-decoration-none">
                                            <i class="bi bi-file-earmark-pdf me-1"></i>
                                            View
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">
                                            Not Uploaded
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-folder-x"></i>
            <p class="mb-0">
                No dental library records available.
            </p>
        </div>
    }


    @if (Model.ResearchPublications != null)
    {
        @await Html.PartialAsync( "DentalLibrary/_ResearchPublications", Model.ResearchPublications)
    }


    @if (Model.LibraryInformation != null)
    {
        @await Html.PartialAsync("DentalLibrary/_LibraryInformation", Model.LibraryInformation)
    }

    @if (Model.Expenditures != null && Model.Expenditures.Any())
    {
        @await Html.PartialAsync("DentalLibrary/_LibraryExpenditures", Model.Expenditures)
    }

    @if (Model.Services != null && Model.Services.Any())
    {
        @await Html.PartialAsync("DentalLibrary/_LibraryServices", Model.Services)
    }

    @if (Model.LibraryStaff != null && Model.LibraryStaff.Any())
    {
        @await Html.PartialAsync("DentalLibrary/_LibraryStaff", Model.LibraryStaff)
    }

</div>