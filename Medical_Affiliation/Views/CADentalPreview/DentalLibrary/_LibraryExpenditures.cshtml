@model List<Medical_Affiliation.Models.DentalLibraryExpenditurePreviewVM>

@if (Model != null && Model.Any())
{
    <div class="section-block">

        <div class="section-header-block">

            <div class="section-title-text section-badge">
                <i class="bi bi-cash-stack"></i>
                Library Expenditures
            </div>

            <p class="section-description">
                Proposed expenditure for library items
            </p>

        </div>

        <div class="data-table-wrapper">

            <table class="table data-table table-hover align-middle">

                <thead>
                    <tr>
                        <th style="width: 70px;">Sl. No.</th>
                        <th>Item</th>
                        <th class="text-end">Expenditure Proposed</th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        var slNo = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @slNo
                            </td>

                            <td class="fw-semibold">
                                @item.ItemName
                            </td>

                            <td class="text-end">
                                ₹ @item.ExpenditureProposed.ToString("N2")
                            </td>

                        </tr>

                        slNo++;
                    }

                </tbody>

            </table>

        </div>

    </div>
}