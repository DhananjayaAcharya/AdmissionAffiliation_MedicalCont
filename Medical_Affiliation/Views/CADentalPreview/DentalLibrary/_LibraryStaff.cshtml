@model List<Medical_Affiliation.Models.DentalLibraryStaffPreviewVM>

@if (Model != null && Model.Any())
{
    <div class="section-block">

        <div class="section-header-block">

            <div class="section-title-text section-badge">
                <i class="bi bi-people"></i>
                Library Staff
            </div>

            <p class="section-description">
                Details of library staff
            </p>

        </div>

        <div class="data-table-wrapper">

            <table class="table data-table table-hover align-middle">

                <thead>
                    <tr>
                        <th style="width: 60px;">Sl. No.</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>Qualification</th>
                        <th>Experience</th>
                        <th>Pay Scale</th>
                        <th>Category</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        var slNo = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @slNo
                            </td>

                            <td class="fw-semibold">
                                @item.Name
                            </td>

                            <td>
                                @item.Designation
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Qualification))
                                {
                                    @item.Qualification
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <td>
                                @if (item.ExperienceFrom.HasValue)
                                {
                                    <div>
                                        <strong>From:</strong>
                                        @item.ExperienceFrom.Value.ToString("dd MMM yyyy")
                                    </div>
                                }

                                @if (item.CurrentlyWorking)
                                {
                                    <div>
                                        <strong>To:</strong>
                                        <span class="text-success">Currently Working</span>
                                    </div>
                                }
                                else if (item.ExperienceTo.HasValue)
                                {
                                    <div>
                                        <strong>To:</strong>
                                        @item.ExperienceTo.Value.ToString("dd MMM yyyy")
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.PayScale))
                                {
                                    @item.PayScale
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Category))
                                {
                                    @item.Category
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <td class="text-center">

                                @if (item.CurrentlyWorking)
                                {
                                    <span class="status-badge-maintained">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Currently Working
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">
                                        Not Working
                                    </span>
                                }

                            </td>

                        </tr>

                        slNo++;
                    }

                </tbody>

            </table>

        </div>

    </div>
}