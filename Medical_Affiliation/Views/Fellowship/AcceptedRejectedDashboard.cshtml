@model FellowshipAcceptedRejectedListVm
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Http
@using System.Globalization

@{
    Layout = null;
    ViewData["Title"] = "Accepted / Rejected Fellowship Students";

    var items = (Model.Items ?? new List<FellowshipAcceptedRejectedRowVm>()).ToList();
    var accepted = items.Where(i => string.Equals(i.DR_ApprovalStatus, "Approved", StringComparison.OrdinalIgnoreCase)).ToList();
    var rejected = items.Where(i => string.Equals(i.DR_ApprovalStatus, "Rejected", StringComparison.OrdinalIgnoreCase)).ToList();
    var awaiting = items.Count - accepted.Count - rejected.Count;

    var collegeName = Context.Session.GetString("CollegeName");
    if (string.IsNullOrWhiteSpace(collegeName)) { collegeName = "College"; }
    var facultyCode = Context.Session.GetString("FacultyCode") ?? string.Empty;
}

@functions {
    private static string FmtDate(DateOnly d) =>
        d == DateOnly.MinValue ? "—" : d.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Figtree:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
            :root {
                --ink: #0e1825;
                --ink-mid: #1d3557;
                --slate: #2d4a6e;
                --azure: #14418f;
                --azure-pale: #eef2fa;
                --amber: #d08b2e;
                --amber-pale: #fef8ee;
                --surface: #f3f5f8;
                --card: #ffffff;
                --line: #e4e8ef;
                --muted: #6b7c93;
                --faint: #a8b5c4;
                --danger: #c62828;
                --danger-bg: #fff5f5;
                --success: #1b7a5c;
                --success-bg: #f0fdf8;
                --r-xl: 10px;
                --r-md: 6px;
                --r-sm: 4px;
                --sh: 0 1px 2px rgba(14,24,37,.06), 0 2px 8px rgba(14,24,37,.05);
                --sh-hover: 0 4px 24px rgba(14,24,37,.13);
                --sidebar-w: 240px;
                --navy-deep: #071b3d;
                --navy: #0b2a5b;
                --royal: #14418f;
                --gold: #d4af37;
                --gold-light: #f1d97c;
                --gold-dark: #a8861c;
            }

            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Figtree', 'Segoe UI', sans-serif;
                background: var(--surface);
                color: var(--ink);
                font-size: 13.5px;
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
            }

            /* ═══ SIDEBAR ═══ */
            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                width: var(--sidebar-w);
                background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
                display: flex;
                flex-direction: column;
                z-index: 200;
                border-right: 1px solid rgba(255,255,255,.08);
            }

            .sidebar-brand {
                display: flex;
                align-items: center;
                gap: .8rem;
                padding: 1.3rem 1.15rem 1.15rem;
                border-bottom: 1px solid rgba(255,255,255,.1);
            }

            .sidebar-brand-logo {
                width: 48px;
                height: 48px;
                border-radius: 50%;
                background: #fff;
                border: 1.5px solid rgba(212,175,55,.7);
                padding: 3px;
                object-fit: contain;
                flex-shrink: 0;
            }

            .sidebar-brand-text .t1 {
                font-family: 'Fraunces', Georgia, serif;
                font-size: 1rem;
                font-weight: 700;
                color: #fff;
                letter-spacing: -.1px;
                line-height: 1.2;
            }

            .sidebar-brand-text .t2 {
                font-size: .62rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: .8px;
                color: var(--gold-light);
                opacity: .8;
                margin-top: 3px;
            }

            .sidebar-nav {
                flex: 1;
                padding: 1.2rem .8rem;
                overflow-y: auto;
            }

            .sidebar-section-label {
                font-size: .64rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .8px;
                color: rgba(255,255,255,.4);
                padding: .4rem .6rem .6rem;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: .7rem;
                padding: .65rem .8rem;
                border-radius: var(--r-md);
                color: rgba(255,255,255,.75);
                text-decoration: none;
                font-size: .82rem;
                font-weight: 500;
                margin-bottom: .2rem;
                transition: background .15s, color .15s;
            }

                .sidebar-link svg {
                    width: 16px;
                    height: 16px;
                    flex-shrink: 0;
                    opacity: .75;
                }

                .sidebar-link:hover {
                    background: rgba(255,255,255,.07);
                    color: #fff;
                }

                .sidebar-link.active {
                    background: rgba(255,255,255,.1);
                    color: #fff;
                    font-weight: 600;
                    box-shadow: inset 3px 0 0 var(--gold);
                }

                    .sidebar-link.active svg {
                        color: var(--gold-light);
                        opacity: 1;
                    }

            .sidebar-foot {
                padding: 1rem .95rem 1.2rem;
                border-top: 1px solid rgba(255,255,255,.1);
            }

            .sidebar-college {
                font-size: .68rem;
                color: rgba(255,255,255,.5);
                margin-bottom: .7rem;
                line-height: 1.45;
            }

                .sidebar-college strong {
                    display: block;
                    color: #fff;
                    font-size: .78rem;
                    font-weight: 600;
                    margin-bottom: 2px;
                }

            .sidebar-logout {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: .55rem;
                width: 100%;
                background: rgba(255,255,255,.05);
                border: 1px solid rgba(255,255,255,.22);
                color: rgba(255,255,255,.9);
                font-family: inherit;
                font-size: .78rem;
                font-weight: 600;
                padding: .58rem .75rem;
                border-radius: var(--r-md);
                cursor: pointer;
                transition: background .15s, border-color .15s;
            }

                .sidebar-logout:hover {
                    background: rgba(255,255,255,.12);
                    border-color: rgba(212,175,55,.6);
                }

                .sidebar-logout svg {
                    width: 14px;
                    height: 14px;
                }

            /* ═══ MAIN AREA ═══ */
            .main-area {
                margin-left: var(--sidebar-w);
                min-height: 100vh;
            }

            /* ═══ HEADER ═══ */
            .site-header {
                background: linear-gradient(100deg, var(--navy-deep) 0%, var(--navy) 60%, var(--royal) 100%);
                border-bottom: 2px solid var(--gold-dark);
                padding: .85rem 0;
                position: sticky;
                top: 0;
                z-index: 100;
            }

            .header-inner {
                max-width: 1180px;
                margin: 0 auto;
                padding: 0 1.75rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
            }

            .header-left {
                display: flex;
                align-items: center;
                gap: .9rem;
            }

            .header-logo {
                display: none;
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: #fff;
                border: 1.5px solid rgba(212,175,55,.7);
                padding: 2px;
                object-fit: contain;
                flex-shrink: 0;
            }

            .back-btn {
                display: inline-flex;
                align-items: center;
                gap: .4rem;
                background: rgba(255,255,255,.08);
                border: 1px solid rgba(255,255,255,.28);
                color: #fff;
                font-family: inherit;
                font-size: .78rem;
                font-weight: 600;
                padding: .5rem .9rem;
                border-radius: var(--r-md);
                text-decoration: none;
                transition: background .15s, border-color .15s;
            }

                .back-btn:hover {
                    background: rgba(255,255,255,.16);
                    border-color: rgba(212,175,55,.65);
                }

                .back-btn svg {
                    width: 13px;
                    height: 13px;
                }

            .header-title-block .header-title {
                font-family: 'Fraunces', Georgia, serif;
                font-size: 1.08rem;
                font-weight: 700;
                color: #fff;
                letter-spacing: -.1px;
            }

            .header-title-block .header-sub {
                font-size: .72rem;
                color: rgba(255,255,255,.65);
                margin-top: 1px;
            }

            .header-pill {
                display: inline-flex;
                align-items: center;
                gap: .45rem;
                background: rgba(255,255,255,.08);
                border: 1px solid rgba(212,175,55,.5);
                border-radius: var(--r-sm);
                padding: .34rem .85rem;
                font-size: .7rem;
                font-weight: 700;
                text-transform: uppercase;
                color: var(--gold-light);
                letter-spacing: .6px;
            }

            .pill-dot {
                width: 6px;
                height: 6px;
                background: var(--gold);
                border-radius: 50%;
            }

            /* ═══ PAGE LAYOUT ═══ */
            .page-wrap {
                max-width: 1180px;
                margin: 1.75rem auto 4rem;
                padding: 0 1.75rem;
            }

            .form-banner {
                border: 1px solid var(--line);
                border-left: 4px solid var(--navy);
                background: #f6f8fc;
                border-radius: var(--r-md);
                padding: .85rem 1.1rem;
                margin-bottom: 1.5rem;
            }

            .form-banner-title {
                font-family: 'Fraunces', Georgia, serif;
                font-size: .98rem;
                font-weight: 700;
                color: var(--navy);
            }

            .form-banner-note {
                font-size: .74rem;
                color: var(--muted);
                margin-top: 2px;
            }

            /* ═══ ALERT ═══ */
            .alert-err {
                background: var(--danger-bg);
                border: 1px solid #fca5a5;
                border-left: 4px solid var(--danger);
                color: var(--danger);
                border-radius: var(--r-md);
                padding: .85rem 1rem;
                font-size: .82rem;
                font-weight: 600;
                display: flex;
                align-items: flex-start;
                gap: .6rem;
                margin-bottom: 1.5rem;
                line-height: 1.5;
            }

                .alert-err svg {
                    flex-shrink: 0;
                    margin-top: 3px;
                }

            /* ═══ SUMMARY TILES ═══ */
            .stat-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 1.1rem;
                margin-bottom: 1.75rem;
            }

            .stat-tile {
                background: var(--card);
                border: 1px solid var(--line);
                border-left: 4px solid var(--navy);
                border-radius: var(--r-md);
                box-shadow: var(--sh);
                padding: .95rem 1.2rem;
            }

                .stat-tile.ok {
                    border-left-color: var(--success);
                }

                .stat-tile.no {
                    border-left-color: var(--danger);
                }

            .stat-label {
                font-size: .68rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .6px;
                color: var(--muted);
            }

            .stat-value {
                font-family: 'Fraunces', Georgia, serif;
                font-size: 1.7rem;
                font-weight: 700;
                color: var(--ink);
                line-height: 1.2;
                margin-top: 2px;
            }

            /* ═══ CARD + TABLE ═══ */
            .card {
                background: var(--card);
                border: 1px solid var(--line);
                border-radius: var(--r-xl);
                box-shadow: var(--sh);
                overflow: hidden;
                margin-bottom: 1.75rem;
            }

            .table-header {
                background: var(--navy);
                padding: 1.05rem 1.5rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
            }

            .table-header-text h5 {
                font-family: 'Fraunces', serif;
                font-size: .98rem;
                color: #fff;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: .55rem;
            }

            .table-header-text p {
                font-size: .72rem;
                color: rgba(255,255,255,.55);
                margin-top: 2px;
            }

            .status-dot {
                width: 9px;
                height: 9px;
                border-radius: 50%;
                display: inline-block;
            }

                .status-dot.ok {
                    background: #34d399;
                }

                .status-dot.no {
                    background: #f87171;
                }

            .count-badge {
                background: rgba(255,255,255,.1);
                border: 1px solid rgba(255,255,255,.2);
                color: rgba(255,255,255,.9);
                font-size: .7rem;
                font-weight: 700;
                padding: .25rem .7rem;
                border-radius: var(--r-sm);
                white-space: nowrap;
            }

            .fm-table {
                width: 100%;
                border-collapse: collapse;
                font-size: .78rem;
            }

                .fm-table thead th {
                    background: #f4f6fa;
                    padding: .65rem .85rem;
                    font-size: .65rem;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: .5px;
                    color: var(--muted);
                    white-space: nowrap;
                    text-align: left;
                    border-bottom: 2px solid var(--line);
                }

                .fm-table tbody td {
                    padding: .7rem .85rem;
                    border-bottom: 1px solid #f0f2f6;
                    color: var(--ink);
                    vertical-align: middle;
                    white-space: nowrap;
                }

                .fm-table tbody tr:last-child td {
                    border-bottom: none;
                }

                .fm-table tbody tr:hover td {
                    background: #f8fafd;
                }

            .cell-strong {
                font-weight: 600;
            }

            .cell-mono {
                font-family: monospace;
                font-size: .74rem;
            }

            .cell-remark {
                white-space: normal;
                min-width: 180px;
                max-width: 280px;
            }

                .cell-remark.reject {
                    color: var(--danger);
                }

            .badge-yes {
                background: #dcfce7;
                color: #16a34a;
                font-size: .67rem;
                font-weight: 700;
                padding: .15rem .55rem;
                border-radius: 20px;
                display: inline-block;
            }

            .badge-no {
                background: #f1f5f9;
                color: var(--faint);
                font-size: .67rem;
                font-weight: 600;
                padding: .15rem .55rem;
                border-radius: 20px;
                display: inline-block;
            }

            .dl-link {
                font-size: .72rem;
                font-weight: 600;
                color: var(--azure);
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: .25rem;
            }

                .dl-link:hover {
                    text-decoration: underline;
                }

            .no-doc {
                color: var(--faint);
                font-size: .75rem;
            }

            .empty-state {
                text-align: center;
                padding: 2.5rem 2rem;
                color: var(--faint);
                font-size: .82rem;
            }

            /* ═══ RESPONSIVE ═══ */
            @@media (max-width: 1020px) {
                .header-logo {
                    display: block;
                }

                .sidebar {
                    transform: translateX(-100%);
                    transition: transform .2s;
                }

                .main-area {
                    margin-left: 0;
                }
            }

            @@media (max-width: 700px) {
                .stat-grid {
                    grid-template-columns: 1fr;
                }

                .page-wrap {
                    padding: 0 1rem;
                }

                .header-title-block .header-title {
                    font-size: .88rem;
                }
            }
    </style>
</head>
<body>

    <!-- ═══ SIDEBAR ═══ -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <img src="@Url.Content("~/images/newLogo.jpeg")" alt="RGUHS logo" class="sidebar-brand-logo" />
            <div class="sidebar-brand-text">
                <div class="t1">RGUHS Portal</div>
                <div class="t2">Fellowship Programme</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-section-label">Navigation</div>
            <a asp-controller="Collegelogin" asp-action="Dashboard" class="sidebar-link">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                Dashboard
            </a>
            <a asp-controller="Fellowship" asp-action="FellowshipMedical_Details" class="sidebar-link">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
                Add Students
            </a>
            <a asp-controller="Fellowship" asp-action="FellowshipMedical_Details" asp-fragment="existing-records" class="sidebar-link">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" /></svg>
                Existing Records
            </a>
            <a asp-controller="Fellowship" asp-action="AcceptedRejectedDashboard" class="sidebar-link active">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                Accepted / Rejected
            </a>
        </nav>

        <div class="sidebar-foot">
            <div class="sidebar-college">
                <strong>@collegeName</strong>
                Faculty Code: @facultyCode
            </div>
            <form asp-controller="Fellowship" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="sidebar-logout">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                    Sign Out
                </button>
            </form>
        </div>
    </aside>

    <!-- ═══ MAIN AREA ═══ -->
    <div class="main-area">

        <!-- ═══ HEADER ═══ -->
        <header class="site-header">
            <div class="header-inner">
                <div class="header-left">
                    <img src="@Url.Content("~/images/newLogo.jpeg")" alt="RGUHS logo" class="header-logo" />
                    <a asp-controller="Collegelogin" asp-action="Dashboard" class="back-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" /></svg>
                        Back
                    </a>
                    <div class="header-title-block">
                        <div class="header-title">Accepted / Rejected Fellowship Students</div>
                        <div class="header-sub">University decisions and remarks for your college</div>
                    </div>
                </div>
                <div class="header-pill">
                    <span class="pill-dot"></span>
                    Official Record
                </div>
            </div>
        </header>

        <!-- ═══ PAGE BODY ═══ -->
        <div class="page-wrap">

            @if (TempData["Error"] != null)
            {
                <div class="alert-err" role="alert">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zM7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z" />
                    </svg>
                    <span>@TempData["Error"]</span>
                </div>
            }

            <div class="form-banner">
                <div class="form-banner-title">Fellowship Admission &mdash; Decision Register</div>
                <div class="form-banner-note">Records are limited to your college. Decisions and remarks shown below are as recorded by the University.</div>
            </div>

            <!-- Summary -->
            <div class="stat-grid">
                <div class="stat-tile ok">
                    <div class="stat-label">Accepted</div>
                    <div class="stat-value">@accepted.Count</div>
                </div>
                <div class="stat-tile no">
                    <div class="stat-label">Rejected</div>
                    <div class="stat-value">@rejected.Count</div>
                </div>
                <div class="stat-tile">
                    <div class="stat-label">Awaiting Decision</div>
                    <div class="stat-value">@awaiting</div>
                </div>
            </div>

            <!-- ═══ ACCEPTED ═══ -->
            <div class="card">
                <div class="table-header">
                    <div class="table-header-text">
                        <h5><span class="status-dot ok"></span>Accepted (University Approved)</h5>
                        <p>Students approved by the University</p>
                    </div>
                    <span class="count-badge">@accepted.Count Records</span>
                </div>
                <div style="overflow-x:auto;">
                    <table class="fm-table">
                        <thead>
                            <tr>
                                <th>Student Name</th>
                                <th>DOB</th>
                                <th>Joining</th>
                                <th>Admission Open</th>
                                <th>Ending</th>
                                <th>Course</th>
                                <th>KMC No.</th>
                                <th>Principal</th>
                                <th>Declaration</th>
                                <th>Fellowship Code</th>
                                <th>SSLC</th>
                                <th>KMC</th>
                                <th>Experience</th>
                                <th>Appointment</th>
                                <th>University Remark</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (accepted.Count > 0)
                            {
                                foreach (var item in accepted)
                                {
                                    <tr>
                                        <td class="cell-strong">@item.StudentName</td>
