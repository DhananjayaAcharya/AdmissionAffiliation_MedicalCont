@model CollegeIntake2627UpdateViewModel
@{
    ViewData["Title"] = "Update Intake 2026-27";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Update Intake 2026-27</h2>
            <p class="text-muted mb-0">Update the intake values for a selected college from the master intake table.</p>
        </div>
        <a asp-action="AdminDashboard" asp-controller="Admin" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <form method="get" asp-action="UpdateCollegeIntake2627" asp-controller="Admin" class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label fw-bold">Select College</label>
                    <select name="collegeCode" class="form-select">
                        <option value="">-- Select college --</option>
                        @foreach (var item in Model.CollegeList)
                        {
                            <option value="@item.Value" selected="@(Model.CollegeCode == item.Value ? "selected" : null)">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">Load College</button>
                </div>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.CollegeCode) && Model.IntakeRows != null && Model.IntakeRows.Any())
    {
        <form method="post" asp-action="UpdateCollegeIntake2627" asp-controller="Admin">
            @Html.AntiForgeryToken()
            <input type="hidden" name="collegeCode" value="@Model.CollegeCode" />

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light fw-bold">
                    College: @Model.CollegeCode
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>SLNO</th>
                                <th>Course</th>
                                <th>Course Code</th>
                                <th>UG/PG</th>
                                <th>2025 Intake</th>
                                <th>Intake 26-27</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.IntakeRows.Count; i++)
                            {
                                var row = Model.IntakeRows[i];
                                <tr>
                                    <td>
                                        <input type="hidden" name="rows[@i].Slno" value="@row.Slno" />
                                        @row.Slno
                                    </td>
                                    <td>@row.Course</td>
                                    <td>@row.CourseCode</td>
                                    <td>@row.UgPg</td>
                                    <td>@(row.Intake2025 ?? 0)</td>
                                    <td>
                                        <input type="number" class="form-control" name="rows[@i].Intake2627" value="@(row.Intake2627 ?? 0)" min="0" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-3 d-flex justify-content-end">
                <button type="submit" class="btn btn-success">Save All Updates</button>
            </div>
        </form>
    }
    else if (!string.IsNullOrWhiteSpace(Model.CollegeCode))
    {
        <div class="alert alert-info">No intake rows found for the selected college.</div>
    }
</div>
