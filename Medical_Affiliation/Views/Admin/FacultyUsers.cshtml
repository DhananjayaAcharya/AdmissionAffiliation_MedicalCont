<!-- ===================================================== -->
<!-- DELETE MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="deleteUserModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">

                    <i class="fas fa-trash text-danger me-2"></i>

                    Delete User

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <form asp-controller="Admin"
                  asp-action="DeleteFacultyUser"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden"
                           id="deleteId"
                           name="id" />

                    <p class="mb-1">
                        Are you sure you want to delete:
                    </p>

                    <h5 id="deleteUserName"
                        class="fw-bold text-danger">
                    </h5>

                    <p class="text-muted mb-0">
                        This action cannot be undone.
                    </p>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="fas fa-trash me-1"></i>
                        Delete User

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        const facultySelect =
            document.getElementById("facultySelect");

        const usersContainer =
            document.getElementById("usersContainer");


        // =====================================================
        // FACULTY CHANGE
        // =====================================================

        facultySelect.addEventListener("change", function() {

            const facultyId = this.value;

            if (!facultyId) {

                usersContainer.innerHTML = `
                        <div class="users-card">

                            <div class="empty-state">

                                <i class="bi bi-building"></i>

                                <h5>Select a Faculty</h5>

                                <div>
                                    Select a faculty above to view its users.
                                </div>

                            </div>

                        </div>
                    `;

                return;
            }

            loadUsers(facultyId);

        });


        // =====================================================
        // LOAD USERS
        // =====================================================

        function loadUsers(facultyId) {

            usersContainer.innerHTML = `
                    <div class="users-card">

                        <div class="loading">

                            <div class="spinner-border text-primary">
                            </div>

                            <div class="mt-3">
                                Loading users...
                            </div>

                        </div>

                    </div>
                `;


            fetch(
                '@Url.Action("GetUsersByFaculty", "Admin")'
                + '?facultyId='
                + encodeURIComponent(facultyId)
            )

                .then(response => {

                    if (!response.ok) {
                        throw new Error("Unable to load users.");
                    }

                    return response.json();

                })

                .then(users => {

                    renderUsers(users);

                })

                .catch(error => {

                    console.error(error);

                    usersContainer.innerHTML = `
                        <div class="users-card">

                            <div class="empty-state">

                                <i class="fas fa-exclamation-circle"></i>

                                <h5>Unable to load users</h5>

                                <div>
                                    Please try again.
                                </div>

                            </div>

                        </div>
                    `;

                });

        }


        // =====================================================
        // RENDER USERS
        // =====================================================

        function renderUsers(users) {

            if (!users || users.length === 0) {

                usersContainer.innerHTML = `
                        <div class="users-card">

                            <div class="empty-state">

                                <i class="fas fa-users"></i>

                                <h5>No users found</h5>

                                <div>
                                    This faculty does not have any users.
                                </div>

                                <button type="button"
                                        class="btn btn-primary mt-3"
                                        onclick="openCreateModal()">

                                    <i class="fas fa-plus me-1"></i>

                                    Add User

                                </button>

                            </div>

                        </div>
                    `;

                return;
            }


            let rows = "";


            users.forEach(user => {

                const username = user.userName || "Unknown User";

                const initials = username.substring(0, 2).toUpperCase();


                rows += `

                        <tr class="user-row">

                            <td>

                                <div class="user-info">

                                    <div class="avatar">
                                        ${escapeHtml(initials)}
                                    </div>

                                    <div>

                                        <div class="username">
                                            ${escapeHtml(username)}
                                        </div>

                                        <div class="userid">
                                            User ID: ${user.userId}
                                        </div>

                                    </div>

                                </div>

                            </td>


                            <td class="text-center">

                                ${createToggle( user.id, "IsActive",  user.isActive )}

                            </td>


                            <td class="text-center">

                                ${createToggle( user.id,  "IsFinance", user.isFinance )}

                            </td>


                            <td class="text-center">

                                ${createToggle( user.id, "IsSection", user.isSection )}

                            </td>


                            <td class="text-center">

                                ${createToggle( user.id, "IsAdmin", user.isAdmin )}

                            </td>


                            <td class="text-center">

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger action-btn"
                                        title="Delete"
                                        onclick='openDeleteModal(${user.id}, ${JSON.stringify(username)})'>

                                    <i class="fas fa-trash"></i>

                                </button>

                            </td>

                        </tr>

                    `;

            });


            usersContainer.innerHTML = `

                    <div class="users-card">

                        <div class="users-header">

                            <div>

                                <h5 class="users-title">
                                    Faculty Users
                                </h5>

                                <small class="text-muted">
                                    Manage access and permissions
                                </small>

                            </div>


                            <div class="d-flex align-items-center gap-2">

                                <span class="user-count">
                                    ${users.length} Users
                                </span>


                                <button type="button"
                                        class="btn btn-primary btn-sm"
                                        onclick="openCreateModal()">

                                    <i class="fas fa-plus me-1"></i>

                                    Add User

                                </button>

                            </div>

                        </div>


                        <div class="table-responsive">

                            <table class="table">

                                <thead>

                                    <tr>

                                        <th>
                                            User
                                        </th>

                                        <th class="text-center">
                                            Active
                                        </th>

                                        <th class="text-center">
                                            Finance
                                        </th>

                                        <th class="text-center">
                                            Section
                                        </th>

                                        <th class="text-center">
                                            Admin
                                        </th>

                                        <th class="text-center">
                                            Actions
                                        </th>

                                    </tr>

                                </thead>

                                <tbody>

                                    ${rows}

                                </tbody>

                            </table>

                        </div>

                    </div>

                `;

        }


        // =====================================================
        // TOGGLE
        // =====================================================

        function createToggle(id, property, value) {

            const checked =
                value === true ? "checked" : "";


            const token =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                ).value;


            return `

                    <form method="post"
                          action="@Url.Action("ToggleFacultyUserProperty", "Admin")"
                          class="d-inline">

                        <input type="hidden"
                               name="id"
                               value="${id}" />

                        <input type="hidden"
                               name="propertyName"
                               value="${property}" />

                        <input type="hidden"
                               name="__RequestVerificationToken"
                               value="${token}" />


                        <label class="switch">

                            <input type="checkbox"
                                   ${checked}
                                   onchange="this.form.submit()">

                            <span class="slider"></span>

                        </label>

                    </form>

                `;

        }


        // =====================================================
        // CREATE MODAL
        // =====================================================

        function openCreateModal() {

            const facultyId =
                facultySelect.value;


            if (!facultyId) {

                alert("Please select a faculty first.");

                return;
            }


            document.getElementById("createFaculty").value =
                facultyId;


            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById("createUserModal")
                );


            modal.show();

        }


        // =====================================================
        // EDIT MODAL
        // =====================================================

        function openEditModal(user) {

            document.getElementById("editId").value =
                user.id;

            document.getElementById("editUserId").value =
                user.userId ?? "";

            document.getElementById("editUserName").value =
                user.userName ?? "";

            document.getElementById("editFaculty").value =
                user.faculty ?? facultySelect.value;

            document.getElementById("editFinanceDesignation").value =
                user.financeDesignation ?? "";

            document.getElementById("editDesignationDescription").value =
                user.designationDescription ?? "";

            document.getElementById("editIsActive").checked =
                user.isActive === true;

            document.getElementById("editIsFinance").checked =
                user.isFinance === true;

            document.getElementById("editIsSection").checked =
                user.isSection === true;

            document.getElementById("editIsAdmin").checked =
                user.isAdmin === true;


            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById("editUserModal")
                );


            modal.show();

        }


        // =====================================================
        // DELETE MODAL
        // =====================================================

        function openDeleteModal(id, username) {

            document.getElementById("deleteId").value =
                id;

            document.getElementById("deleteUserName").textContent =
                username;


            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById("deleteUserModal")
                );


            modal.show();

        }


        // =====================================================
        // HTML ESCAPE
        // =====================================================

        function escapeHtml(value) {

            if (value == null) {
                return "";
            }

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");

        }


        // =====================================================
        // INITIAL LOAD
        // =====================================================

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const selectedFacultyId =
                    facultySelect.value;

                if (selectedFacultyId) {

                    loadUsers(selectedFacultyId);

                }

            }
        );

    </script>

