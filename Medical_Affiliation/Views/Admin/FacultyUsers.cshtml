@{
    ViewData["Title"] = "Faculty User Management";

    var faculties =
        ViewBag.Faculties as List<Medical_Affiliation.Models.Faculty>
        ?? new List<Medical_Affiliation.Models.Faculty>();

    int? selectedFacultyId = ViewBag.SelectedFacultyId as int?;
}

<style>

    .faculty-page {
        background: #f6f8fb;
        min-height: calc(100vh - 60px);
        padding: 30px;
    }

    .page-title {
        font-size: 27px;
        font-weight: 700;
        color: #172033;
        margin-bottom: 5px;
    }

    .page-subtitle {
        color: #7b8494;
        font-size: 14px;
        margin-bottom: 25px;
    }

    /* Faculty selector */

    .faculty-selector-card {
        background: #fff;
        border-radius: 14px;
        padding: 22px 25px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
        margin-bottom: 22px;
    }

    .faculty-label {
        font-size: 13px;
        font-weight: 700;
        color: #374151;
        margin-bottom: 8px;
    }

    .faculty-select {
        height: 48px;
        border-radius: 10px;
        border: 1px solid #dfe3e8;
        font-size: 14px;
    }

        .faculty-select:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,.1);
        }

    /* Users */

    .users-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
        overflow: hidden;
    }

    .users-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f3;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .users-title {
        font-size: 18px;
        font-weight: 700;
        margin: 0;
        color: #172033;
    }

    .user-count {
        background: #eef2ff;
        color: #4f46e5;
        border-radius: 20px;
        padding: 5px 12px;
        font-size: 12px;
        font-weight: 700;
    }

    .table {
        margin-bottom: 0;
    }

        .table thead th {
            background: #f8fafc;
            color: #64748b;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            padding: 14px 18px;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
        }

        .table tbody td {
            padding: 14px 18px;
            vertical-align: middle;
            border-color: #f1f3f5;
        }

    .user-row:hover {
        background: #fafbfc;
    }

    /* User */

    .user-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .avatar {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg,#4f46e5,#7c3aed);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 13px;
    }

    .username {
        font-weight: 700;
        color: #1f2937;
    }

    .userid {
        font-size: 12px;
        color: #9ca3af;
        margin-top: 2px;
    }

    /* Toggle */

    .switch {
        position: relative;
        display: inline-block;
        width: 42px;
        height: 23px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background: #d1d5db;
        border-radius: 30px;
        transition: .2s;
    }

        .slider:before {
            content: "";
            position: absolute;
            height: 17px;
            width: 17px;
            left: 3px;
            top: 3px;
            background: white;
            border-radius: 50%;
            transition: .2s;
            box-shadow: 0 1px 3px rgba(0,0,0,.2);
        }

    .switch input:checked + .slider {
        background: #22c55e;
    }

        .switch input:checked + .slider:before {
            transform: translateX(19px);
        }

    /* Action buttons */

    .action-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
    }

    /* Empty */

    .empty-state {
        text-align: center;
        padding: 65px 20px;
        color: #9ca3af;
    }

        .empty-state i {
            font-size: 45px;
            margin-bottom: 15px;
        }

        .empty-state h5 {
            color: #4b5563;
            font-weight: 700;
        }

    .loading {
        text-align: center;
        padding: 50px;
        color: #6b7280;
    }

    /* Modal */

    .modal-content {
        border: 0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 15px 50px rgba(0,0,0,.15);
    }

    .modal-header {
        border-bottom: 1px solid #edf0f3;
        padding: 18px 22px;
    }

    .modal-title {
        font-size: 18px;
        font-weight: 700;
    }

    .modal-body {
        padding: 24px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 700;
        color: #374151;
    }

    .form-control,
    .form-select {
        border-radius: 9px;
        min-height: 44px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,.1);
        }

</style>


<div class="faculty-page">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-start mb-3">

        <div>
            <h1 class="page-title">
                Faculty User Management
            </h1>

            <div class="page-subtitle">
                Select a faculty to manage its users and permissions.
            </div>
        </div>

        <div>
            <a asp-controller="Admin"
               asp-action="AdminDashboard"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Dashboard
            </a>
        </div>

    </div>


    <!-- Faculty -->

    <div class="faculty-selector-card">

        <label class="faculty-label">
            Select Faculty
        </label>

        <select id="facultySelect"
                class="form-select faculty-select">

            <option value="">
                -- Select Faculty --
            </option>

            @foreach (var faculty in faculties)
            {
                if (selectedFacultyId == faculty.FacultyId)
                {
                    <option value="@faculty.FacultyId" selected>
                        @faculty.FacultyName
                    </option>
                }
                else
                {
                    <option value="@faculty.FacultyId">
                        @faculty.FacultyName
                    </option>
                }
            }

        </select>

    </div>


    <!-- Users -->

    <div id="usersContainer">

        <div class="users-card">

            <div class="empty-state">

                <i class="bi bi-building"></i>

                <h5>Select a Faculty</h5>

                <div>
                    Select a faculty above to view its users.
                </div>

            </div>

        </div>

    </div>

</div>


<!-- Anti Forgery -->

<form style="display:none">

    @Html.AntiForgeryToken()

</form>


<!-- ===================================================== -->
<!-- CREATE USER MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="createUserModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h5 class="modal-title">
                        <i class="fas fa-user-plus text-primary me-2"></i>
                        Add Faculty User
                    </h5>

                    <small class="text-muted">
                        Create a new user for the selected faculty.
                    </small>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <form asp-controller="Admin"
                  asp-action="CreateFacultyUser"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden"
                           id="createFaculty"
                           name="Faculty" />


                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                User ID
                            </label>

                            <input type="number"
                                   name="UserId"
                                   class="form-control"
                                   required />

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                User Name
                            </label>

                            <input type="text"
                                   name="UserName"
                                   class="form-control"
                                   maxlength="100"
                                   required />

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Finance Designation
                            </label>

                            <input type="text"
                                   name="FinanceDesignation"
                                   class="form-control"
                                   maxlength="10" />

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Designation Description
                            </label>

                            <input type="text"
                                   name="DesignationDescription"
                                   class="form-control"
                                   maxlength="200" />

                        </div>


                        <div class="col-md-3">

                            <div class="form-check form-switch">

                                <input type="checkbox"
                                       class="form-check-input"
                                       name="IsActive"
                                       value="true"
                                       checked />

                                <label class="form-check-label">
                                    Active
                                </label>

                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="form-check form-switch">

                                <input type="checkbox"
                                       class="form-check-input"
                                       name="IsFinance"
                                       value="true" />

                                <label class="form-check-label">
                                    Finance
                                </label>

                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="form-check form-switch">

                                <input type="checkbox"
                                       class="form-check-input"
                                       name="IsSection"
                                       value="true" />

                                <label class="form-check-label">
                                    Section
                                </label>

                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="form-check form-switch">

                                <input type="checkbox"
                                       class="form-check-input"
                                       name="IsAdmin"
                                       value="true" />

                                <label class="form-check-label">
                                    Admin
                                </label>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fas fa-save me-1"></i>
                        Create User

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


