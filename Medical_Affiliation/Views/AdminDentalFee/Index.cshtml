
@model Medical_Affiliation.Models.AdminDentalFeeViewModel

@{
    ViewData["Title"] = "Admin Dental Fee";
    Layout = "~/Views/Shared/_DentalAdminLayout.cshtml";

    var hasSelection =
        !string.IsNullOrWhiteSpace(Model.CollegeCode) &&
        Model.AffiliationTypeId.HasValue;

    var culture = System.Globalization.CultureInfo.GetCultureInfo("en-IN");

    var lateSubmissionFee = Model.DentalFeeTypes.FirstOrDefault(e => string.Equals(e.FeeType, "Late Submission Fee", StringComparison.OrdinalIgnoreCase));
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<link rel="stylesheet" href="~/css/admin-dental-fee.css"/>

<div class="adf-page">

    <!-- PAGE HEADER -->
    <div class="adf-header">
        <div>
            <h2 class="adf-title">
                <i class="bi bi-receipt-cutoff me-2"></i>
                Admin Dental Fee
            </h2>
            <p class="adf-subtitle">
                Review college fee structures and payment records.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="AdminDashboard"
           class="adf-btn adf-btn-outline">
            <i class="bi bi-arrow-left"></i>
            Back to Dashboard
        </a>
    </div>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }


    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-warning adf-alert">
            <div asp-validation-summary="All"></div>
        </div>
    }

    @if (lateSubmissionFee != null)
    {
        <div class="card my-3">
            <div class="card-header">
                <strong>Late Submission Fee</strong>
            </div>

            <div class="card-body">
                <div class="row align-items-center">

                    <div class="col-md-4">
                        <strong>Course Level</strong>
                        <div>
                            @lateSubmissionFee.CourseLevel
                        </div>
                    </div>

                    <div class="col-md-4">
                        <strong>Activation Date</strong>
                        <div>
                            @if (lateSubmissionFee.ActivationDate.HasValue)
                            {
                                @lateSubmissionFee.ActivationDate.Value.ToString("dd-MM-yyyy HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not configured
                                </span>
                            }
                        </div>
                    </div>

                    <div class="col-md-2">
                        <strong>Status</strong>
                        <div>
                            @if (lateSubmissionFee.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactive
                                </span>
                            }
                        </div>
                    </div>

                    <div class="col-md-2 text-end">
                        <button type="button"
                                class="btn btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#updateLateSubmissionFeeModal"
                                data-id="@lateSubmissionFee.Id"
                                data-course-level="@lateSubmissionFee.CourseLevel"
                                data-activation-date="@(lateSubmissionFee.ActivationDate?.ToString("yyyy-MM-ddTHH:mm"))"
                                data-is-active="@lateSubmissionFee.IsActive">

                            Update
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }

    <!-- SEARCH / FILTER -->
    <div class="adf-card">
        <div class="adf-card-header">
            <h5>
                <i class="bi bi-funnel me-2"></i>
                Search Dental Fee Records
            </h5>
        </div>

        <div class="adf-card-body">
            <form asp-controller="AdminDentalFee"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <div class="col-lg-4 col-md-6">
                        <label asp-for="CollegeCode" class="adf-label">
                            College
                        </label>

                        <select asp-for="CollegeCode"
                                asp-items="Model.Colleges"
                                class="adf-control">
                            <option value="">-- Select College --</option>
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label asp-for="AffiliationTypeId"
                               class="adf-label">
                            Affiliation Type
                        </label>

                        <select asp-for="AffiliationTypeId"
                                asp-items="Model.AffiliationTypes"
                                class="adf-control">
                            <option value="">-- Select Affiliation Type --</option>
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-6">
                        <label asp-for="CourseLevel" class="adf-label">
                            Course Level
                        </label>

                        <select asp-for="CourseLevel"
                                asp-items="Model.CourseLevels"
                                class="adf-control">
                            <option value="">-- Auto / All --</option>
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-6">
                        <div class="adf-filter-actions">
                            <button type="submit"
                                    class="adf-btn adf-btn-primary">
                                <i class="bi bi-search"></i>
                                Search
                            </button>

                            <a asp-controller="AdminDentalFee"
                               asp-action="Index"
                               class="adf-btn adf-btn-outline"
                               title="Clear filters">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

    @if (hasSelection)
    {
        <!-- COLLEGE INFORMATION -->
        <div class="adf-card">
            <div class="adf-info">
                <span>
                    <strong>College Code:</strong>
                    @Model.CollegeCode
                </span>

                <span>
                    <strong>Institution Type:</strong>

                    @if (Model.IsGovernment)
                    {
                        <span class="adf-badge adf-badge-success">
                            Government
                        </span>
                    }
                    else
                    {
                        <span class="adf-badge adf-badge-muted">
                            Private / Other
                        </span>
                    }
                </span>

                <span>
                    <strong>Course Level:</strong>
                    @(Model.CourseLevel ?? "All")
                </span>

                <span>
                    <strong>Affiliation ID:</strong>
                    @Model.AffiliationTypeId
                </span>
            </div>
        </div>

        <!-- SUMMARY CARDS -->
        <div class="adf-summary-grid">

            <div class="adf-summary">
                <div class="adf-summary-label">
                    <i class="bi bi-calculator me-1"></i>
                    Total Applicable Fee
                </div>

                <div class="adf-summary-value">
                    @Model.TotalApplicableFee.ToString("C2", culture)
                </div>

                <div class="adf-summary-note">
                    Active fee records currently eligible under the rules
                </div>
            </div>

            <div class="adf-summary">
                <div class="adf-summary-label">
                    <i class="bi bi-wallet2 me-1"></i>
                    Total Amount Paid
                </div>

                <div class="adf-summary-value">
                    @Model.TotalAmountPaid.ToString("C2", culture)
                </div>

                <div class="adf-summary-note">
                    Sum of active recorded payment amounts
                </div>
            </div>

            <div class="adf-summary">
                <div class="adf-summary-label">
                    <i class="bi bi-arrow-left-right me-1"></i>
                    Difference
                </div>

                <div class="adf-summary-value">
                    @Model.BalanceAmount.ToString("C2", culture)
                </div>

                <div class="adf-summary-note">
                    Applicable fee minus amount paid; positive means outstanding
                </div>
            </div>

        </div>

        <!-- FEE STRUCTURE TABLE -->
        <div class="adf-card">

            <div class="adf-card-header">
                <h5>
                    <i class="bi bi-list-check me-2"></i>
                    Fee Structure Details
                </h5>

                <span class="adf-section-count">
                    @Model.FeeItems.Count record(s)
                </span>
            </div>

            <div class="adf-table-wrap">
                <table class="adf-table" id="feeTable">

                    <thead>
                        <tr>
                            <th data-sort="number">#</th>
                            <th data-sort="number">Record ID</th>
                            <th data-sort="text">Fee Type</th>
                            <th data-sort="text">Course</th>
                            <th data-sort="text">Level</th>
                            <th data-sort="text">Calculation Type</th>
                            <th data-sort="number" class="adf-money">
                                Intake
                            </th>
                            <th data-sort="number" class="adf-money">
                                Amount To Be Paid
                            </th>
                            <th data-sort="number" class="adf-money">
                                Calculated Amount
                            </th>
                            <th data-sort="text">Eligibility</th>
                            <th data-sort="text">Record Status</th>
                            <th data-sort="none">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.FeeItems.Any())
                        {
                            var rowNumber = 0;

                            foreach (var fee in Model.FeeItems)
                            {
                                rowNumber++;

                                <tr>
                                    <td data-value="@rowNumber">
                                        @rowNumber
                                    </td>

                                    <td data-value="@(fee.Id ?? 0)">
                                        @(fee.Id?.ToString() ?? "Not created")
                                    </td>

                                    <td data-value="@fee.FeeTypeName">
                                        <strong>@fee.FeeTypeName</strong>
                                    </td>

                                    <td data-value="@fee.CourseName">
                                        @(fee.CourseName ?? "-")
                                    </td>

                                    <td data-value="@fee.CourseLevel">
                                        @(fee.CourseLevel ?? "-")
                                    </td>

                                    <td data-value="@fee.CalculationType">
                                        @(fee.CalculationType ?? "-")
                                    </td>

                                    <td class="adf-money"
                                        data-value="@(fee.AcademicIntake2026 ?? 0)">
                                        @(fee.AcademicIntake2026?.ToString() ?? "-")
                                    </td>

                                    <td class="adf-money"
                                        data-value="@fee.AmountToBePaid">
                                        @fee.AmountToBePaid.ToString("C2", culture)
                                    </td>

                                    <td class="adf-money"
                                        data-value="@fee.CalculatedAmount">
                                        @fee.CalculatedAmount.ToString("C2", culture)
                                    </td>

                                    <td data-value="@(fee.IsApplicable ? "Applicable" : "Excluded")">
                                        @if (fee.IsApplicable)
                                        {
                                            <span class="adf-badge adf-badge-success">
                                                Applicable
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="adf-badge adf-badge-warning"
                                                  title="@fee.ApplicabilityReason">
                                                Excluded
                                            </span>
                                        }

                                        @if (fee.ActivationDate.HasValue)
                                        {
                                            <div class="text-muted mt-1"
                                                 style="font-size:10px">
                                                Activation:
                                                @fee.ActivationDate.Value.ToString("dd-MMM-yyyy")
                                            </div>
                                        }
                                    </td>

                                    <td data-value="@(fee.IsActive ? "Active" : "Inactive")">
                                        @if (fee.IsActive)
                                        {
                                            <span class="adf-badge adf-badge-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="adf-badge adf-badge-muted">
                                                Inactive
                                            </span>
                                        }
                                    </td>
                                    
                                    
                                    <td data-sort="none">
                                        <div class="d-flex gap-2">

                                            @if (fee.Id.HasValue)
                                            {
                                                
                                                <form asp-controller="AdminDentalFee"
                                                      asp-action="ToggleFeeStatus"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to change this fee record status?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="id" value="@fee.Id.Value" />
                                                    <input type="hidden" name="collegeCode" value="@Model.CollegeCode" />
                                                    <input type="hidden" name="affiliationTypeId" value="@Model.AffiliationTypeId" />
                                                    <input type="hidden" name="courseLevel" value="@Model.CourseLevel" />

                                                    <button type="submit"
                                                            class="btn btn-sm @(fee.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                                        <i class="bi @(fee.IsActive ? "bi-pause-circle" : "bi-check-circle")"></i>
                                                        @(fee.IsActive ? "Deactivate" : "Activate")
                                                    </button>
                                                </form>

                                                <form asp-controller="AdminDentalFee"
                                                      asp-action="DeleteFee"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to permanently delete this fee record?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="id" value="@fee.Id.Value" />
                                                    <input type="hidden" name="collegeCode" value="@Model.CollegeCode" />
                                                    <input type="hidden" name="affiliationTypeId" value="@Model.AffiliationTypeId" />
                                                    <input type="hidden" name="courseLevel" value="@Model.CourseLevel" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i> Delete
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }

                                        </div>
                                    </td>


                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="adf-empty">
                                    <i class="bi bi-inbox"></i>
                                    No saved fee transaction records found
                                    for the selected filters.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div class="adf-table-footer">
                <div class="adf-page-size">
                    Show
                    <select id="feePageSize" aria-label="Fee table page size">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    entries
                    <span id="feeTableInfo"></span>
                </div>

                <div class="adf-pagination" id="feePagination"></div>
            </div>
        </div>

        <!-- PAYMENT TABLE -->
        <div class="adf-card">

            <div class="adf-card-header">
                <h5>
                    <i class="bi bi-credit-card me-2"></i>
                    Payment Details
                </h5>

                <span class="adf-section-count">
                    @Model.Payments.Count record(s)
                </span>
            </div>

            <div class="adf-table-wrap">
                <table class="adf-table" id="paymentTable">

                    <thead>
                        <tr>
                            <th data-sort="number">#</th>
                            <th data-sort="number">Payment ID</th>
                            <th data-sort="text">Transaction ID</th>
                            <th data-sort="text">Course Level</th>
                            <th data-sort="number" class="adf-money">
                                Amount Paid
                            </th>
                            <th data-sort="text">Payment Status</th>
                            <th data-sort="text">Receipt</th>
                            <th data-sort="text">Created By</th>
                            <th data-sort="date">Created Date</th>
                            <th data-sort="text">Modified By</th>
                            <th data-sort="date">Modified Date</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Payments.Any())
                        {
                            var paymentNumber = 0;

                            foreach (var payment in Model.Payments)
                            {
                                paymentNumber++;

                                <tr>
                                    <td data-value="@paymentNumber">
                                        @paymentNumber
                                    </td>

                                    <td data-value="@payment.Id">
                                        @payment.Id
                                    </td>

                                    <td data-value="@payment.TransactionId">
                                        @(payment.TransactionId ?? "-")
                                    </td>

                                    <td data-value="@payment.CourseLevel">
                                        @(payment.CourseLevel ?? "-")
                                    </td>

                                    <td class="adf-money payment-amount-cell"
                                        data-value="@payment.AmountPaid">

                                        <form asp-controller="AdminDentalFee"
                                              asp-action="UpdatePaymentAmount"
                                              method="post"
                                              class="payment-amount-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@payment.Id" />
                                            <input type="hidden" name="collegeCode" value="@Model.CollegeCode" />
                                            <input type="hidden" name="affiliationTypeId" value="@Model.AffiliationTypeId" />
                                            <input type="hidden" name="courseLevel" value="@Model.CourseLevel" />

                                            <input type="number"
                                                   name="amountPaid"
                                                   value="@payment.AmountPaid.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                   class="form-control form-control-sm payment-amount-input"
                                                   min="0"
                                                   max="999999999999"
                                                   step="0.01"
                                                   required
                                                   title="Edit amount and press Enter or click outside to save" />
                                        </form>
                                    </td>

                                    <td data-value="@(payment.IsActive ? "Active" : "Inactive")">
                                        @if (payment.IsActive)
                                        {
                                            <span class="adf-badge adf-badge-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="adf-badge adf-badge-muted">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td data-value="@(string.IsNullOrWhiteSpace(payment.TransactionReceiptPath) ? "Unavailable" : "Available")">
                                        @if (!string.IsNullOrWhiteSpace(payment.TransactionReceiptPath))
                                        {
                                            <a 
                                               asp-action="ViewReceipt"
                                               asp-route-paymentId="@payment.Id"
                                               class="receipt-view-btn"
                                               target="_blank"
                                               rel="noopener noreferrer">

                                                <i class="bi bi-eye me-1"></i>
                                                View Receipt

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <td data-value="@payment.CreatedBy">
                                        @(payment.CreatedBy ?? "-")
                                    </td>

                                    <td data-value="@payment.CreatedDate.ToString("O")">
                                        @payment.CreatedDate.ToString("dd-MMM-yyyy HH:mm")
                                    </td>

                                    <td data-value="@payment.ModifiedBy">
                                        @(payment.ModifiedBy ?? "-")
                                    </td>

                                    <td data-value="@(payment.ModifiedDate?.ToString("O") ?? "")">
                                        @(payment.ModifiedDate?.ToString("dd-MMM-yyyy HH:mm") ?? "-")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="adf-empty">
                                    <i class="bi bi-credit-card-2-front"></i>
                                    No payment records found for the selected filters.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div class="adf-table-footer">
                <div class="adf-page-size">
                    Show
                    <select id="paymentPageSize"
                            aria-label="Payment table page size">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    entries
                    <span id="paymentTableInfo"></span>
                </div>

                <div class="adf-pagination"
                     id="paymentPagination"></div>
            </div>
        </div>
    }
    else
    {
        <div class="adf-card">
            <div class="adf-empty">
                <i class="bi bi-search"></i>
                <strong>Select a college and affiliation type.</strong>
                <div class="mt-2">
                    Click Search to view the dental fee and payment records.
                </div>
            </div>
        </div>
    }

</div>

<div class="modal fade"
     id="updateLateSubmissionFeeModal"
     tabindex="-1"
     aria-labelledby="updateLateSubmissionFeeModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form asp-action="UpdateDentalLateSubmissionFee"
                  asp-controller="AdminDentalFee"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title"
                        id="updateLateSubmissionFeeModalLabel">
                        Update Late Submission Fee
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">

                    <input type="hidden"
                           id="LateFeeId"
                           name="Id" />

                    <input type="hidden"
                           id="LateFeeFacultyCode"
                           name="FacultyCode"
                           value="@Model.FacultyCode" />

                    <input type="hidden"
                           id="LateFeeAffiliationTypeId"
                           name="AffiliationTypeId"
                           value="@Model.AffiliationTypeId" />

                    <input type="hidden"
                           id="LateFeeCourseLevel"
                           name="CourseLevel" />

                    <div class="mb-3">
                        <label class="form-label">
                            Course Level
                        </label>

                        <input type="text"
                               class="form-control"
                               id="LateFeeCourseLevelDisplay"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label for="LateFeeActivationDate"
                               class="form-label">
                            Activation Date
                        </label>

                        <input type="datetime-local"
                               class="form-control"
                               id="LateFeeActivationDate"
                               name="ActivationDate" />
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input"
                               type="checkbox"
                               id="LateFeeIsActive"
                               name="IsActive"
                               value="true" />

                        <label class="form-check-label"
                               for="LateFeeIsActive">
                            Active
                        </label>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

    </div>
</div>

<script src="~/js/admin-dental-fee.js" asp-append-version="true"></script>
