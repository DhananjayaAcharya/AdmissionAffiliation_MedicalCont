@model MedicalLibraryDisplayViewModel

@if (Model.ResearchPublicationsDisplayViewModel != null)
{
    <div class="general-body">
        <div class="section-block">

            <div class="section-header-block mb-3">
                <div class="section-title-text department-badge">
                    <i class="bi bi-journal-text"></i>
                    Research Publications
                </div>
            </div>
            <div class="data-table-wrapper" >
                <table class="table data-table align-middle">
                    <tbody>
                        <tr>
                            <th>Number of Publications</th>
                            <td>@(Model.ResearchPublicationsDisplayViewModel.PublicationsNo ?? 0)</td>
                        </tr>
                        <tr>
                            <th>Principal Investigator</th>
                            <td>@(Model.ResearchPublicationsDisplayViewModel.Pi ?? "—")</td>
                        </tr>
                        <tr>
                            <th>RGUHS Funded Projects</th>
                            <td>@(Model.ResearchPublicationsDisplayViewModel.RguhsFunded ?? 0)</td>
                        </tr>
                        <tr>
                            <th>Externally Funded Projects</th>
                            <td>@(Model.ResearchPublicationsDisplayViewModel.ExternalBodyFunding ?? 0)</td>
                        </tr>
                        <tr>
                            <th>Student RGUHS-Funded Projects</th>
                            <td>@(Model.ResearchPublicationsDisplayViewModel.StudentsRguhsFunded ?? 0)</td>
                        </tr>
                        <tr>
                            <th>Student Externally Funded Projects</th>
                            <td>@(Model.ResearchPublicationsDisplayViewModel.StudentsExternalFunding ?? 0)</td>
                        </tr>
                        <tr>
                            <th>Faculty RGUHS-Funded Projects</th>
                            <td>@(Model.ResearchPublicationsDisplayViewModel.FacultyRguhsFunded ?? 0)</td>
                        </tr>
                        <tr>
                            <th>Faculty Externally Funded Projects</th>
                            <td>@(Model.ResearchPublicationsDisplayViewModel.FacultyExternalFunding ?? 0)</td>
                        </tr>
                        <tr>
                            <th>Publications Document</th>
                            <td>
                                @if (Model.ResearchPublicationsDisplayViewModel.HasPublicationsPdf)
                                {
                                    <a asp-controller="CA_Med_ResearchPublications" asp-action="ViewPublicationsPdf" target="_blank" rel="noopener">View</a>
                                }
                                else { <span>—</span> }
                            </td>
                        </tr>
                        <tr>
                            <th>Projects Document</th>
                            <td>
                                @if (Model.ResearchPublicationsDisplayViewModel.HasProjectsPdf)
                                {
                                    <a asp-controller="CA_Med_ResearchPublications" asp-action="ViewProjectsPdf" target="_blank" rel="noopener">View</a>
                                }
                                else { <span>—</span> }
                            </td>
                        </tr>
                        <tr>
                            <th>Clinical Trials Document</th>
                            <td>
                                @if (Model.ResearchPublicationsDisplayViewModel.HasClinicalTrialsPdf)
                                {
                                    <a asp-controller="CA_Med_ResearchPublications" asp-action="ViewClinicalTrialsPdf" target="_blank" rel="noopener">View</a>
                                }
                                else { <span>—</span> }
                            </td>
                        </tr>
                        <tr>
                            <th>Students Projects Document</th>
                            <td>
                                @if (Model.ResearchPublicationsDisplayViewModel.HasStudentsProjectsPdf)
                                {
                                    <a asp-controller="CA_Med_ResearchPublications" asp-action="ViewStudentsProjectsPdf" target="_blank" rel="noopener">View</a>
                                }
                                else { <span>—</span> }
                            </td>
                        </tr>
                        <tr>
                            <th>Faculty Projects Document</th>
                            <td>
                                @if (Model.ResearchPublicationsDisplayViewModel.HasFacultyProjectsPdf)
                                {
                                    <a asp-controller="CA_Med_ResearchPublications" asp-action="ViewFacultyProjectsPdf" target="_blank" rel="noopener">View</a>
                                }
                                else { <span>—</span> }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>


        </div>
    </div>
}
else
{
    <div class="empty-state">
        <p>No research publications data available.</p>
    </div>
}
