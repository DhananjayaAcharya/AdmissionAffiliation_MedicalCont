@model List<Medical_Affiliation.Models.FacultyDetailDisplayVM>

<div class="general-body">
    <div class="section-block">
        <div class="section-header-block mb-3">
            <div class="section-title-text department-badge">
                <i class="bi bi-people"></i>
                Faculty Details
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="data-table-wrapper">
                <table class="table data-table align-middle">
                    <thead>
                        <tr>
                            <th>Photo</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Designation</th>
                            <th>Qualification</th>
                            <th>Employment</th>
                            <th>Experience</th>
                            <th>Mobile</th>
                            <th>Email</th>
                            <th>Council Reg. No.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.PhotoFilePath))
                                    {
                                        <img src="@Url.Action("Photo", "UGFaculty", new { file = System.IO.Path.GetFileName(item.PhotoFilePath) })" alt="Faculty photo" style="width:48px;height:58px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>@item.NameOfFaculty</td>
                                <td>@(item.DepartmentName ?? item.DepartmentCode ?? "—")</td>
                                <td>@(item.DesignationName ?? item.DesignationCode ?? "—")</td>
                                <td>@(item.ProfessionalQualification ?? "—")</td>
                                <td>@(item.NatureOfEmployment ?? "—")</td>
                                <td>@(item.TeachingExpInYrs ?? "—")</td>
                                <td>@item.Mobile</td>
                                <td>@item.Email</td>
                                <td>@(item.StateCouncilRegNo ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <p>No faculty details available.</p>
            </div>
        }
    </div>
</div>
