            </div>

            <div class="preview-tab-group">
                <div class="preview-tab-group-title">Physical Infrastructure</div>
                <div class="preview-tab-list">
                    <div class="preview-tab-row"><span>Land, Building &amp; Teaching Facilities</span><a href="@Url.Action("Medical_LandBuildingdetails", "Medical_ContinuousAffiliation")">Edit</a></div>
                    <div class="preview-tab-row"><span>Skills Laboratory</span><a href="@Url.Action("Medical_SkillsLaboratory", "Medical_ContinuousAffiliation")">Edit</a></div>
                    <div class="preview-tab-row"><span>Clinical Facilities</span><a href="@Url.Action("ClinicalFacilities", "ContinuationAffiliationClinicalFacilities")">Edit</a></div>
                    @if (isUgPreview)
                    {
                        <div class="preview-tab-row"><span>Bed Distribution - MBBS - UG</span><a href="@Url.Action("MedicalUGBedDistribution", "ContinuesAffiliation_Facultybased")">Edit</a></div>
                    }
                    <div class="preview-tab-row"><span>Department Offices Details</span><a href="@Url.Action("Medical_DepartmentOfficesAndEducationalUnit", "Medical_ContinuousAffiliation")">Edit</a></div>
                    <div class="preview-tab-row"><span>Affiliation Hostel Details</span><a href="@Url.Action("Aff_HostelDetails", "ContinuesAffiliation_Facultybased")">Edit</a></div>
                    <div class="preview-tab-row"><span>Associated Institutions</span><a href="@Url.Action("AssociatedInstitutions", "AffiliationSS")">Edit</a></div>
                    <div class="preview-tab-row"><span>Vehicle Registration &amp; Documents</span><a href="@Url.Action("CA_VehicleDetails", "Aff_AHS_ContinousApplication")">Edit</a></div>
                </div>
            </div>

            <div class="preview-tab-group">
                <div class="preview-tab-group-title">Academic &amp; Admin</div>
                <div class="preview-tab-list">
                    @if (isUgPreview)
                    {
                        <div class="preview-tab-row"><span>Academic Matters - UG</span><a href="@Url.Action("AcademicMatters", "CA_Aff_AcademicMatters")">Edit</a></div>
                    }
                    <div class="preview-tab-row"><span>Account and Fee Details</span><a href="@Url.Action("Med_CA_AccountAndFeeDetails", "Aff_CA_Med_FinanceDetails")">Edit</a></div>
                    <div class="preview-tab-row"><span>Staff Pay Scale Details</span><a href="@Url.Action("CA_Med_StaffDetails", "CA_Med_StaffDetails")">Edit</a></div>
                    @if (isPgPreview)
                    {
                        <div class="preview-tab-row"><span>Academic Matters PG - PG</span><a href="@Url.Action("AcademicMattersPG", "CA_Aff_AcademicMatters")">Edit</a></div>
                    }
                </div>
            </div>

            <div class="preview-tab-group">
                <div class="preview-tab-group-title">Human Resource</div>
                <div class="preview-tab-list">
                    <div class="preview-tab-row"><span>Faculty Details</span><a href="@Url.Action("Repo_FacultyDetails", "FacultyDetails")">Edit</a></div>
                    <div class="preview-tab-row"><span>Non-Teaching Staff Details</span><a href="@Url.Action("NonTeachingStaffDepartmentwise", "ContinuesAffiliation_Facultybased")">Edit</a></div>
                </div>
            </div>

            <div class="preview-tab-group">
                <div class="preview-tab-group-title">Research &amp; Library</div>
                <div class="preview-tab-list">
                    <div class="preview-tab-row"><span>Library Details</span><a href="@Url.Action("MedicalLibrary", "CA_Aff_MedicalLibrary")">Edit</a></div>
                    <div class="preview-tab-row"><span>Research Publications</span><a href="@Url.Action("CA_Med_ResearchPublicationsDetails", "CA_Med_ResearchPublications")">Edit</a></div>
                </div>
            </div>

            <div class="preview-tab-group">
                <div class="preview-tab-group-title">Payment</div>
                <div class="preview-tab-list">
                    <div class="preview-tab-row"><span>Payment Calculation</span><a href="@Url.Action("Index", "PaymentCalculation")">Edit</a></div>
                </div>
            </div>
        </div>

        <!-- ========================= -->
        <!-- SECTIONS CONTAINER -->
        <!-- ========================= -->
        <div class="preview-report">
            <div id="InstitutionDetails" class="preview-report-section">
                <h2 class="preview-report-heading"><span>01 · Institution Details</span><a class="preview-report-edit" href="@Url.Action("Institution_Details", "ContinuesAffiliation_Facultybased")"><i class="bi bi-pencil-square me-1"></i>Edit</a></h2>
                <div class="preview-report-body">
                    @if (Model.InstitutionDetails != null)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm data-table align-middle mb-0">
                                <tbody>
                                    <tr><th>Type of Institution</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.TypeOfInstitution) ? Model.InstitutionDetails.TypeOfInstitution : "—")</td></tr>
                                    <tr><th>Institution Name</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.NameOfInstitution) ? Model.InstitutionDetails.NameOfInstitution : "—")</td></tr>
                                    <tr><th>Address</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.Address) ? Model.InstitutionDetails.Address : "—")</td></tr>
                                    <tr><th>City / Taluk / District</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.VillageTownCity) ? Model.InstitutionDetails.VillageTownCity : "—") / @(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.Taluk) ? Model.InstitutionDetails.Taluk : "—") / @(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.District) ? Model.InstitutionDetails.District : "—")</td></tr>
                                    <tr><th>PIN Code</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.PinCode) ? Model.InstitutionDetails.PinCode : "—")</td></tr>
                                    <tr><th>Mobile / Email</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.MobileNumber) ? Model.InstitutionDetails.MobileNumber : "—") / @(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.EmailId) ? Model.InstitutionDetails.EmailId : "—")</td></tr>
                                    <tr><th>Website</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.Website) ? Model.InstitutionDetails.Website : "—")</td></tr>
                                    <tr><th>Survey / PID No</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.SurveyNoPidNo) ? Model.InstitutionDetails.SurveyNoPidNo : "—")</td></tr>
                                    <tr><th>Minority Institute</th><td>@(Model.InstitutionDetails.MinorityInstitute ? "Yes" : "No")</td></tr>
                                    <tr><th>Attached to Medical College</th><td>@(Model.InstitutionDetails.AttachedToMedicalClg ? "Yes" : "No")</td></tr>
