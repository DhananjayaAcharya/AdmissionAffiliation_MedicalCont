                                    <tr><th>Year of Establishment</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.YearOfEstablishment) ? Model.InstitutionDetails.YearOfEstablishment : "—")</td></tr>
                                    <tr><th>Alternate Landline / Mobile</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.AltLandlineMobile) ? Model.InstitutionDetails.AltLandlineMobile : "—")</td></tr>
                                    <tr><th>Alternate Email</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.AltEmailId) ? Model.InstitutionDetails.AltEmailId : "—")</td></tr>
                                    <tr><th>Nodal Officer Name</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.NodalOfficer_Name) ? Model.InstitutionDetails.NodalOfficer_Name : "—")</td></tr>
                                    <tr><th>Nodal Officer Mobile</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.NodalOfficer_Mob_Number) ? Model.InstitutionDetails.NodalOfficer_Mob_Number : "—")</td></tr>
                                    <tr><th>Nodal Officer Email</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.NodalOfficer_Email) ? Model.InstitutionDetails.NodalOfficer_Email : "—")</td></tr>
                                    <tr><th>Principal Name</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.Principal_Name) ? Model.InstitutionDetails.Principal_Name : "—")</td></tr>
                                    <tr><th>Principal Mobile</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.Principal_Mob_No) ? Model.InstitutionDetails.Principal_Mob_No : "—")</td></tr>
                                    <tr><th>Principal Email</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.Principal_Email) ? Model.InstitutionDetails.Principal_Email : "—")</td></tr>
                                    <tr><th>Course Level</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.CourseLevel) ? Model.InstitutionDetails.CourseLevel : "—")</td></tr>
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">No institution details available.</div>
                    }
                </div>
            </div>

            <div id="TrustInstitutionDetails" class="preview-report-section">
                <h2 class="preview-report-heading"><span>02 · Trust Institution Details</span><a class="preview-report-edit" href="@Url.Action("Aff_InstituteDetails", "ContinuesAffiliation_Facultybased")"><i class="bi bi-pencil-square me-1"></i>Edit</a></h2>
                <div class="preview-report-body">
                    @if (Model.AffInstituteDetails != null)
                    {
                        <div class="table-responsive mb-4">
                            <h5 class="mb-2 fw-bold">Trust / Society Details</h5>
                            <table class="table table-sm data-table align-middle mb-0">
                                <tbody>
                                    <tr><th>Trust Name</th><td>@(!string.IsNullOrWhiteSpace(Model.AffInstituteDetails.TrustName) ? Model.AffInstituteDetails.TrustName : "—")</td></tr>
