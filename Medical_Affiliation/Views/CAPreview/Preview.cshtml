                flex: 1;
                justify-content: center;
            }
    }
    /* key/value tables (no header row) become stacked label-over-value cards on phones */
    @@media (max-width: 640px) {
        .data-table.kv {
            border: 0;
        }

            .data-table.kv, .data-table.kv tbody, .data-table.kv tr {
                display: block;
                width: 100%;
