                                        <tr><th>Trust PAN File</th><td>@(Model.AffInstituteDetails.hasPANFile ? "Uploaded" : "Not Uploaded")</td></tr>
                                        <tr><th>Bank Statement</th><td>@(Model.AffInstituteDetails.hasBankStatementFile ? "Uploaded" : "Not Uploaded")</td></tr>
                                        <tr><th>Registration Certificate</th><td>@(Model.AffInstituteDetails.hasRegistrationCertificateFile ? "Uploaded" : "Not Uploaded")</td></tr>
                                        <tr><th>Audit Statement</th><td>@(Model.AffInstituteDetails.hasAuditStatementFile ? "Uploaded" : "Not Uploaded")</td></tr>
                                    </tbody>
                                </table>
                            </div>
