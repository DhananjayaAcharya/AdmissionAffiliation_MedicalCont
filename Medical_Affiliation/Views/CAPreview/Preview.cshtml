@model Medical_Affiliation.Models.CApreviewViewModel
@inject Medical_Affiliation.DATA.ApplicationDbContext _context
@using Microsoft.EntityFrameworkCore
@using Medical_Affiliation.Models
@{
    ViewData["Title"] = "Details Preview";
    Layout = "~/Views/Shared/_CaLayout.cshtml";
    var previewCourseLevel = (Context.Session.GetString("CourseLevel")
                              ?? Context.Session.GetString("SelectedCourseLevel")
                              ?? Model.ApplyingCourseLevel
                              ?? string.Empty).Trim().ToUpperInvariant();
    var isUgPreview = previewCourseLevel == "UG";
    var isPgPreview = previewCourseLevel == "PG";
    var isSsPreview = previewCourseLevel == "SS";
    var courseLevelLabel = previewCourseLevel switch
    {
        "UG" => "Undergraduate (UG)",
        "PG" => "Postgraduate (PG)",
        "SS" => "Super Specialty (SS)",
        _ => "Not specified"
    };
    var previewApplicationType = (Model.ApplicationType
        ?? Context.Session.GetString("TypeOfAffiliation")
        ?? string.Empty).Trim();
    var previewCollegeCode = (Model.CollegeCode
        ?? Context.Session.GetString("CollegeCode")
        ?? string.Empty).Trim();
    var applicationReadOnly = !string.IsNullOrWhiteSpace(previewCollegeCode)
        && !string.IsNullOrWhiteSpace(previewApplicationType)
        && !string.IsNullOrWhiteSpace(previewCourseLevel)
        && await _context.Database.SqlQuery<int>($@"
            SELECT COUNT(*) AS [Value]
            FROM dbo.ApplicationSubmission
            WHERE CollegeCode = {previewCollegeCode}
              AND LTRIM(RTRIM(TypeOfAffiliation)) = LTRIM(RTRIM({previewApplicationType}))
              AND UPPER(LTRIM(RTRIM(CourseLevel))) = {previewCourseLevel}").FirstOrDefaultAsync() > 0;

    // ---- Section 11: Skills Laboratory (direct from Medical_SkillsLaboratory) ----
    var slFacultyCode = (Model.FacultyCode ?? Context.Session.GetString("FacultyCode") ?? string.Empty).Trim();
    var slAffiliationType = Context.Session.GetInt32("AffiliationType")
        ?? (int.TryParse(Context.Session.GetString("TypeOfAffiliation"), out var slAffType) ? slAffType : 2);

    SkillsLabRow? skillsLab = null;
    if (!string.IsNullOrWhiteSpace(previewCollegeCode) && !string.IsNullOrWhiteSpace(slFacultyCode))
    {
        skillsLab = await _context.Database.SqlQuery<SkillsLabRow>($@"
            SELECT TOP (1) *
            FROM dbo.Medical_SkillsLaboratory
            WHERE LTRIM(RTRIM(CollegeCode)) = {previewCollegeCode}
              AND LTRIM(RTRIM(CAST(FacultyCode AS varchar(20)))) = {slFacultyCode}
            ORDER BY Id DESC").FirstOrDefaultAsync();
    }

    int? slAnnualMbbsIntake = skillsLab?.AnnualMbbsIntake;
    if (isUgPreview && !string.IsNullOrWhiteSpace(previewCollegeCode) && !string.IsNullOrWhiteSpace(slFacultyCode))
    {
        slAnnualMbbsIntake = await _context.Database.SqlQuery<int>($@"
            SELECT TOP (1) COALESCE(TRY_CAST(Intake_26_27 AS int), 0) AS [Value]
            FROM dbo.Mst_MedicalCollegeCourseIntake
            WHERE LTRIM(RTRIM(coll_code)) = {previewCollegeCode}
              AND LTRIM(RTRIM(CAST(Facultycode AS varchar(20)))) = {slFacultyCode}
              AND UPPER(LTRIM(RTRIM(ug_pg))) = {previewCourseLevel}
              AND UPPER(LTRIM(RTRIM(course))) = 'MBBS'
            ORDER BY SLNO DESC").FirstOrDefaultAsync();
    }

    // ---- Section 12: Associated Institutions ----
    List<AssociatedInstitutionRow> associatedInstitutions = new();
    if (!string.IsNullOrWhiteSpace(previewCollegeCode))
    {
        associatedInstitutions = await _context.Database.SqlQuery<AssociatedInstitutionRow>($@"
        SELECT a.Id,
               CAST(a.TypeOfAffiliation AS varchar(100))      AS TypeOfAffiliation,
               CAST(a.CollegeCode AS varchar(50))             AS CollegeCode,
               CAST(a.AssociatedCollegeCode AS varchar(50))   AS AssociatedCollegeCode,
               CAST(cm.CollegeName AS varchar(300))           AS AssociatedCollegeName,
               CAST(a.AssociatedFacultyCode AS varchar(50))   AS AssociatedFacultyCode,
               CAST(a.FacultyCode AS varchar(50))             AS FacultyCode,
               CAST(a.CourseCode AS varchar(50))              AS CourseCode,
               CAST(COALESCE(NULLIF(LTRIM(RTRIM(mc.CourseName)), ''), a.CourseName) AS varchar(300)) AS CourseName,
               CAST(a.CourseLevel AS varchar(50))             AS CourseLevel,
               a.AnnualIntake,
               a.CreatedOn
        FROM dbo.AssociatedInstitutions a
        OUTER APPLY (
            SELECT TOP (1) m.CollegeName
            FROM [Admission_Affiliation].[dbo].[Affiliation_College_Master] m
            WHERE LTRIM(RTRIM(CAST(m.CollegeCode AS varchar(50)))) = LTRIM(RTRIM(CAST(a.AssociatedCollegeCode AS varchar(50))))
            ORDER BY CASE WHEN LTRIM(RTRIM(CAST(m.FacultyCode AS varchar(50)))) = LTRIM(RTRIM(CAST(a.AssociatedFacultyCode AS varchar(50)))) THEN 0 ELSE 1 END
        ) cm
        OUTER APPLY (
            SELECT TOP (1) c.CourseName
            FROM [Admission_Affiliation].[dbo].[Mst_Course] c
            WHERE LTRIM(RTRIM(CAST(c.CourseCode AS varchar(50)))) = LTRIM(RTRIM(CAST(a.CourseCode AS varchar(50))))
            ORDER BY CASE WHEN LTRIM(RTRIM(CAST(c.FacultyCode AS varchar(50)))) = LTRIM(RTRIM(CAST(a.AssociatedFacultyCode AS varchar(50)))) THEN 0 ELSE 1 END
        ) mc
        WHERE LTRIM(RTRIM(CAST(a.CollegeCode AS varchar(50)))) = {previewCollegeCode}
        ORDER BY a.AssociatedCollegeCode, a.CourseName").ToListAsync();
    }

    var vehicleDocs = ViewBag.VehicleDocs as List<VehicleDocRow> ?? new List<VehicleDocRow>();
    var outpatientRows = ViewBag.OutpatientArea as List<OutpatientAreaRow> ?? new List<OutpatientAreaRow>();
    var pgSections = ViewBag.PgSections as List<PgSectionGroup> ?? new List<PgSectionGroup>();
    var pgCourseTables = ViewBag.PgCourseAffiliation as List<PgSectionTable> ?? new List<PgSectionTable>();
    var pgAcademicTable = ViewBag.PgAcademicPerformance as PgSectionTable ?? new PgSectionTable();

    string Yn(bool? v) => v.HasValue ? (v.Value ? "Yes" : "No") : "—";
    string Num(int? v) => v.HasValue ? v.Value.ToString() : "—";
    string Dec(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "—";

    var completionPct = Math.Max(0, Math.Min(100, (int)Model.CompletionPercentage));
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=EB+Garamond:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap');

    :root {
        --ink: #1f2937;
        --navy-deep: #1f2937;
        --navy: #374151;
        --navy-light: #6b7280;
        --navy-soft: #f3f4f6;
        --gold: #9ca3af;
        --gold-soft: #d1d5db;
        --gold-ink: #4b5563;
        --paper: #f3f4f6;
        --surface: #fff;
        --border: #e5e7eb;
        --border-soft: #eceef1;
        --muted: #6b7280;
        --ok: #1e6b3a;
        --shadow: 0 1px 2px rgba(17,24,39,.05), 0 6px 18px rgba(17,24,39,.05);
        --font-serif: 'EB Garamond', Georgia, serif;
        --font-sans: 'DM Sans', -apple-system, 'Segoe UI', sans-serif;
        --pad: clamp(.8rem, 2.2vw, 1.3rem);
    }

    .pv-page {
        font-family: var(--font-sans);
        color: var(--ink);
        padding-bottom: 1.5rem;
    }

        .pv-page > .container-fluid {
            max-width: 1200px;
            padding-left: var(--pad);
            padding-right: var(--pad);
        }

        .pv-page *, .pv-page *::before, .pv-page *::after {
            box-sizing: border-box;
        }

    /* ---------- Hero ---------- */
    .pv-hero {
        position: relative;
        background: linear-gradient(120deg, var(--navy-deep), var(--navy) 55%, var(--navy-light));
        color: #fff;
        border-radius: 16px;
        padding: clamp(1.1rem, 3vw, 1.7rem);
        margin-bottom: 1rem;
        box-shadow: 0 12px 32px rgba(18,51,73,.22);
        overflow: hidden;
    }

        .pv-hero::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 4px;
            background: linear-gradient(90deg, var(--gold), var(--gold-soft), var(--gold));
        }

    .pv-hero-top {
        display: flex;
        gap: 1rem 1.5rem;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .pv-hero-main {
        flex: 1 1 320px;
        min-width: 0;
    }

    .pv-kicker {
        color: var(--gold-soft);
        font-size: .8rem;
        font-weight: 600;
        margin-bottom: .45rem;
        display: flex;
        gap: .4rem;
        align-items: center;
    }

    .pv-title {
        font-family: var(--font-serif);
        font-size: clamp(1.35rem, 4vw, 2rem);
        font-weight: 600;
        line-height: 1.2;
        margin: 0;
        overflow-wrap: anywhere;
    }

    .pv-sub {
        color: rgba(255,255,255,.78);
        font-size: .85rem;
        margin-top: .4rem;
        max-width: 70ch;
    }

    .pv-chips {
        display: flex;
        flex-wrap: wrap;
        gap: .45rem;
        margin-top: 1rem;
    }

    .pv-chip {
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 999px;
        padding: .3rem .75rem;
        font-size: .8rem;
        display: inline-flex;
        gap: .4rem;
        align-items: baseline;
        max-width: 100%;
    }

        .pv-chip small {
            color: rgba(255,255,255,.68);
            font-size: .72rem;
        }

        .pv-chip b {
            font-weight: 600;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .pv-progress {
        margin-top: 1rem;
        max-width: 520px;
    }

    .pv-progress-row {
        display: flex;
        justify-content: space-between;
        font-size: .78rem;
        color: rgba(255,255,255,.85);
        margin-bottom: .3rem;
    }

    .pv-progress-track {
        height: 6px;
        background: rgba(255,255,255,.22);
        border-radius: 999px;
        overflow: hidden;
    }

    .pv-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--gold), var(--gold-soft));
        border-radius: 999px;
    }

    .submit-application-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        background: linear-gradient(135deg, var(--gold-soft), var(--gold));
        border: 1px solid var(--gold);
        border-radius: 10px;
        color: var(--navy-deep);
        font-size: .86rem;
        font-weight: 700;
        padding: .65rem 1.2rem;
        box-shadow: 0 8px 18px rgba(0,0,0,.18);
    }

    .readonly-status {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.4);
        border-radius: 10px;
        color: #fff;
        font-size: .82rem;
        font-weight: 700;
        padding: .6rem .9rem;
        text-decoration: none;
    }

        .readonly-status:hover {
            background: rgba(255,255,255,.24);
            color: #fff;
        }

    /* ---------- Re-upload ---------- */
    .reupload-highlight {
        background: #fffaf0;
        border: 1px solid #ecd48a;
        border-left: 5px solid var(--gold);
        border-radius: 14px;
        box-shadow: var(--shadow);
        margin-bottom: 1rem;
        overflow: hidden;
    }

    .reupload-header {
        display: flex;
        align-items: center;
        gap: .6rem;
        background: linear-gradient(90deg, rgba(18,51,73,.06), rgba(220,174,63,.16));
        border-bottom: 1px solid rgba(220,174,63,.35);
        color: var(--navy-deep);
        font-size: .92rem;
        font-weight: 700;
        padding: .7rem 1rem;
    }

        .reupload-header i {
            color: var(--gold-ink);
        }

    .reupload-body {
        padding: 1rem;
    }

        .reupload-body p {
            font-size: .9rem;
            font-weight: 500;
            margin: 0 0 .8rem;
        }

    .reupload-form {
        display: flex;
        align-items: center;
        gap: .7rem;
        flex-wrap: wrap;
    }

        .reupload-form .form-control {
            flex: 1 1 260px;
            min-width: 0;
            border-color: #d7b861;
        }

    .reupload-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        background: linear-gradient(135deg, var(--gold-soft), var(--gold));
        border: 1px solid #c99828;
        border-radius: 10px;
        color: var(--navy-deep);
        font-weight: 700;
        padding: .62rem 1rem;
        cursor: pointer;
    }

    /* ---------- Toolbar ---------- */
    .pv-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .6rem;
        flex-wrap: wrap;
        margin-bottom: .8rem;
    }

    .pv-toolbar-title {
        font-family: var(--font-serif);
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--navy-deep);
        margin: 0;
    }

    .pv-toolbar-actions {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
    }

    .pv-btn {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        color: var(--navy-deep);
        font-size: .8rem;
        font-weight: 600;
        padding: .45rem .85rem;
        cursor: pointer;
        display: inline-flex;
        gap: .35rem;
        align-items: center;
    }

        .pv-btn:hover {
            border-color: var(--navy);
            background: var(--navy-soft);
        }

    /* ---------- Section cards (collapsible) ---------- */
    .pv-layout {
        display: block;
    }

    .preview-report {
        display: grid;
        gap: .8rem;
        min-width: 0;
    }

    .preview-report-section {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: var(--shadow);
        overflow: hidden;
        min-width: 0;
        scroll-margin-top: 12px;
    }

    .preview-report-heading {
        display: flex;
        align-items: center;
        gap: .6rem;
        margin: 0;
        padding: .75rem 1rem;
        background: linear-gradient(180deg, #f8fbfc, var(--navy-soft));
        border-bottom: 1px solid var(--border);
        color: var(--navy-deep);
        font-family: var(--font-serif);
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        user-select: none;
    }

        .preview-report-heading > span:first-of-type {
            flex: 1;
            min-width: 0;
            display: flex;
            align-items: center;
            gap: .6rem;
            overflow-wrap: anywhere;
        }

    .pv-no {
        flex: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2.1rem;
        height: 1.7rem;
        padding: 0 .45rem;
        border-radius: 8px;
        background: var(--navy);
        color: #fff;
        font-family: var(--font-sans);
        font-size: .76rem;
        font-weight: 700;
    }

    .pv-chev {
        flex: none;
        color: var(--muted);
        transition: transform .2s;
    }

    .preview-report-section.collapsed .pv-chev {
        transform: rotate(-90deg);
    }

    .preview-report-section.collapsed .preview-report-body {
        display: none;
    }

    .preview-report-section.collapsed .preview-report-heading {
        border-bottom: 0;
    }

    .preview-report-edit {
        flex: none;
        background: #fff;
        border: 1px solid var(--navy);
        border-radius: 8px;
        color: var(--navy);
        font-family: var(--font-sans);
        font-size: .75rem;
        font-weight: 700;
        padding: .3rem .7rem;
        text-decoration: none;
        white-space: nowrap;
    }

        .preview-report-edit:hover {
            background: var(--navy);
            color: #fff;
        }

    .application-readonly .preview-report-edit, .application-readonly .submit-application-btn {
        display: none;
    }

    .preview-report-body {
        padding: var(--pad);
        max-width: 100%;
        overflow-x: auto;
    }

        .preview-report-body .general-section, .preview-report-body .general-body, .preview-report-body .section-block {
            border: 0;
            margin: 0;
            padding: 0;
        }

        .preview-report-body .general-header {
            display: none;
        }

        .preview-report-body h5.fw-bold {
            font-family: var(--font-serif);
            color: var(--navy);
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: .55rem;
        }

        .preview-report-body img {
            max-width: 100%;
            height: auto;
        }

    .empty-state {
        color: var(--muted);
        font-size: .87rem;
        padding: .4rem 0;
    }

    /* ---------- Horizontal scroll ---------- */
    .scroll-x, .table-responsive {
        overflow-x: auto;
        overflow-y: hidden;
        max-width: 100%;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: #9db8c6 #eef3f7;
        border-radius: 10px;
    }

        .scroll-x::-webkit-scrollbar, .table-responsive::-webkit-scrollbar, .preview-report-body::-webkit-scrollbar {
            height: 10px;
        }

        .scroll-x::-webkit-scrollbar-track, .table-responsive::-webkit-scrollbar-track, .preview-report-body::-webkit-scrollbar-track {
            background: #eef3f7;
            border-radius: 999px;
        }

        .scroll-x::-webkit-scrollbar-thumb, .table-responsive::-webkit-scrollbar-thumb, .preview-report-body::-webkit-scrollbar-thumb {
            background: #9db8c6;
            border-radius: 999px;
        }

    /* ---------- Tables ---------- */
    .data-table {
        width: 100%;
        border: 1px solid var(--border-soft);
        border-collapse: separate;
        border-spacing: 0;
        font-size: .87rem;
        margin: 0;
    }

        .data-table th, .data-table td {
            padding: .55rem .8rem;
            vertical-align: middle;
            border-bottom: 1px solid var(--border-soft) !important;
            border-top: 0 !important;
        }

        .data-table tbody tr:last-child > * {
            border-bottom: 0 !important;
        }

        .data-table tbody th {
            background: var(--navy-soft);
            color: var(--navy-deep);
            font-weight: 600;
            width: 30%;
            min-width: 170px;
        }

        .data-table thead th {
            background: var(--navy);
            color: #fff;
            font-weight: 600;
            font-size: .8rem;
            white-space: nowrap;
        }

        .data-table tbody tr:nth-child(even) td {
            background: #fafcfd;
        }

        .data-table.wide {
            min-width: max-content;
        }

            .data-table.wide td, .data-table.wide thead th {
                white-space: nowrap;
            }

                .data-table.wide td.wrap {
                    white-space: normal;
                    min-width: 240px;
                }
                /* first column stays visible while a wide table scrolls */
                .data-table.wide tbody td:first-child, .data-table.wide thead th:first-child {
                    position: sticky;
                    left: 0;
                    z-index: 1;
                }

            .data-table.wide tbody td:first-child {
                background: #fff;
            }

            .data-table.wide thead th:first-child {
                background: var(--navy-deep);
            }

    .doc-badge {
