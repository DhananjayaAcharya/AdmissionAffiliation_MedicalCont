<script>
    document.addEventListener('DOMContentLoaded', function() {

        const navigationTabs = document.querySelector('.navigation-tabs');
        const navLinks = document.querySelectorAll('.nav-tabs-custom .nav-link');

        /*
         * ==========================================================
         * STICKY NAVIGATION
         * ==========================================================
         */

        const navigationTop = navigationTabs.offsetTop;

        window.addEventListener('scroll', function() {

            if (window.scrollY >= navigationTop) {
                navigationTabs.classList.add('is-sticky');
            } else {
                navigationTabs.classList.remove('is-sticky');
            }

        });


        /*
         * ==========================================================
         * NAVIGATION CLICK
         * ==========================================================
         */

        navLinks.forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();

                navLinks.forEach(l => l.classList.remove('active'));
                this.classList.add('active');

                const targetId = this.getAttribute('href');
                const targetSection = document.querySelector(targetId);

                if (targetSection) {

                    const navigationTabs =
                        document.querySelector('.navigation-tabs');

                    const body =
                        document.querySelector('.ca-body');

                    const navHeight =
                        navigationTabs.offsetHeight;

                    const targetTop =
                        targetSection.offsetTop -
                        navHeight -
                        20;

                    body.scrollTo({
                        top: targetTop,
                        behavior: 'smooth'
                    });
                }
            });
        });


        /*
         * ==========================================================
         * UPDATE ACTIVE NAVIGATION WHILE SCROLLING
         * ==========================================================
         */

        const sectionSelector = [
            '#department-education-unit-group',
            '#academic-performance-group',
            '#human-resources-group',
            '#equipment-details',
            '#equipment-details-group',
            '#dental-library-group',
            '#vehicle-details-group',
            '#academic-section',
            '#academic-intake-group',
            '#hospital-section',
            '#bed-distribution-group',
            '#chair-distribution-group',
            '#hostel-details-group',
            '#small-group',
            '#library-group',
            '#vehicle-group',
            '#den-land-building-group',
            '#den-skills-lab-group',
            '#finance-group',
            '#admin-group',
            '#fac-group',
            '#payment-group',
            '#basic-section',
            '#trust-details',
            '#trust-member-details',
            '#ug-pg-intake-details',
            '#teaching-faculty-details'
        ].join(',');

        const sections = document.querySelectorAll(sectionSelector);


        window.addEventListener('scroll', function() {

            const navHeight = navigationTabs.offsetHeight;

            let current = '';

            sections.forEach(section => {

                const sectionTop =
                    section.getBoundingClientRect().top +
                    window.pageYOffset;

                if (window.pageYOffset >= sectionTop - navHeight - 40) {
                    current = section.getAttribute('id');
                }

            });


            navLinks.forEach(link => {

                link.classList.remove('active');

                if (link.getAttribute('href') === '#' + current) {
                    link.classList.add('active');
                }

            });

        });

    });
</script>