                                    <tr><th>President Name</th><td>@(!string.IsNullOrWhiteSpace(Model.AffInstituteDetails.PresidentName) ? Model.AffInstituteDetails.PresidentName : "—")</td></tr>
                                    <tr><th>Category of Organisation</th><td>@(!string.IsNullOrWhiteSpace(Model.AffInstituteDetails.CategoryOfOrganisation) ? Model.AffInstituteDetails.CategoryOfOrganisation : "—")</td></tr>
