    }

    .consent-modal .btn-close {
        filter: invert(1);
    }

    .consent-body {
        padding: 1.3rem 1.5rem 1.5rem;
    }

        .consent-body p {
            color: var(--muted);
            font-size: .88rem;
            line-height: 1.65;
            margin-bottom: 1rem;
        }

            .consent-body p strong {
                color: var(--navy-deep);
            }

    .preview-caution {
        display: flex;
        gap: .6rem;
        background: #fff8e6;
        border: 1px solid #f3dfa0;
        border-left: 4px solid var(--gold);
        border-radius: 10px;
        color: var(--gold-ink);
        font-size: .83rem;
        line-height: 1.5;
        margin-bottom: 1.1rem;
        padding: .75rem 1rem;
    }

    .consent-body .form-check {
        display: flex;
        align-items: center;
        gap: .55rem;
        border-top: 1px solid var(--border-soft);
        padding-top: 1rem;
        padding-left: 0;
    }

    .consent-body .form-check-input {
        appearance: none;
        -webkit-appearance: none;
        width: 1.25rem;
        height: 1.25rem;
        margin: 0;
        border: 1.75px solid #8a96a3;
        border-radius: 5px;
        background: #fff;
        cursor: pointer;
        position: relative;
        flex: none;
        float: none;
    }

        .consent-body .form-check-input:checked {
            background: var(--navy);
            border-color: var(--navy);
        }

            .consent-body .form-check-input:checked::after {
                content: "";
                position: absolute;
                left: .36rem;
                top: .14rem;
                width: .32rem;
                height: .62rem;
                border: solid #fff;
                border-width: 0 2px 2px 0;
                transform: rotate(40deg);
            }

    .consent-body .form-check-label {
        font-size: .88rem;
        font-weight: 500;
        cursor: pointer;
    }

    .consent-body .pdf-action {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        width: 100%;
        background: linear-gradient(120deg, var(--navy-deep), var(--navy), var(--navy-light));
        border: 0;
        border-radius: 10px;
