            </a>
        </div>
    </div>
</div>

<div class="modal fade preview-modal" id="tabPreviewModal" tabindex="-1" aria-labelledby="tabPreviewModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="tabPreviewModalTitle">Tab Preview</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close preview"></button>
            </div>
            <div class="modal-body">
                <iframe id="tabPreviewFrame" title="Selected tab preview" loading="lazy"></iframe>
            </div>
            <div class="modal-footer">
                <span class="me-auto text-muted small">Review the selected page below or open it for editing.</span>
                <a id="tabPreviewEdit" href="#">Edit this page</a>
            </div>
        </div>
    </div>
</div>

<!-- ========================= -->
<!-- CONSENT MODAL -->
<!-- ========================= -->
<div class="modal fade consent-modal" id="consentModal" tabindex="-1" aria-labelledby="consentModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="consent-modal-eyebrow">
                        <i class="bi bi-bank2"></i>
                        RGUHS &middot; Continuous Affiliation
                    </div>
                    <h2 class="modal-title" id="consentModalTitle">Declaration and Consent</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body consent-body">
                @{
                    var declPrincipal = Model.InstitutionDetails != null && !string.IsNullOrWhiteSpace(Model.InstitutionDetails.Principal_Name)
                        ? Model.InstitutionDetails.Principal_Name
                        : "the Principal";
                    var declInstitution = Model.InstitutionDetails != null && !string.IsNullOrWhiteSpace(Model.InstitutionDetails.NameOfInstitution)
                        ? Model.InstitutionDetails.NameOfInstitution
                        : "this institution";
                }
                <p>
                    I, <strong>@declPrincipal</strong>, Principal of <strong>@declInstitution</strong>, hereby solemnly declare and undertake
                    that all documents, particulars, statements, declarations and information furnished or uploaded by the College in this
                    application are true, complete, accurate and correct to the best of my knowledge and belief.
                </p>
                <p>
                    I further undertake that no material information has been concealed, suppressed or misrepresented in this application.
                    I understand that any false, misleading, fabricated, incomplete or incorrect information or documentation furnished by
                    the College may result in rejection or cancellation of the application, withdrawal of affiliation/approval, or such other
                    action as may be taken by Rajiv Gandhi University of Health Sciences, Karnataka (RGUHS) in accordance with the applicable
                    rules, regulations, ordinances and notifications.
                </p>
                <div class="preview-caution">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span><strong>Before you proceed:</strong> close this dialog and scroll through every section of the preview, then return here, tick the consent box and click Generate — consent is mandatory to generate the preview PDF.</span>
                </div>
                @if (TempData["PreviewError"] != null)
                {
                    <div class="alert alert-danger">@TempData["PreviewError"]</div>
                }

                <form id="consentForm" asp-controller="CAPreview" asp-action="SubmitApplication" method="post" target="_blank">
                    @Html.AntiForgeryToken()
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="declarationConsent" name="declarationConsent" value="true" />
                        <label class="form-check-label" for="declarationConsent">
                            I confirm and consent to submit the affiliation application.
                        </label>
                    </div>
                    <button type="submit" id="generatePreviewPdf" class="pdf-action" disabled>
                        <i class="bi bi-send-check-fill"></i> Submit Application
                    </button>
                    <div class="pdf-hint">You must tick the consent box above to enable this button.</div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Smooth scroll to section when tab is clicked
    document.addEventListener('DOMContentLoaded', function () {
        const navLinks = document.querySelectorAll('.nav-tabs-custom .nav-link');

        navLinks.forEach(link => {
            link.addEventListener('click', function (e) {
                e.preventDefault();

                navLinks.forEach(l => l.classList.remove('active'));
                this.classList.add('active');

                const targetId = this.getAttribute('href');
                const targetSection = document.querySelector(targetId);

                if (targetSection) {
                    targetSection.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Update active tab based on scroll position
        const sections = document.querySelectorAll('.sections-container > div[id]');

        window.addEventListener('scroll', function () {
            let current = '';

            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                if (pageYOffset >= (sectionTop - 150)) {
                    current = section.getAttribute('id');
                }
            });

            navLinks.forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('href') === '#' + current) {
                    link.classList.add('active');
                }
            });
        });

        const consent = document.getElementById('declarationConsent');
        const pdfAction = document.getElementById('generatePreviewPdf');

        if (consent && pdfAction) {
            consent.addEventListener('change', function () {
                pdfAction.disabled = !consent.checked;
            });
        }

        const consentModalElement = document.getElementById('consentModal');
        const consentModal = consentModalElement && typeof bootstrap !== 'undefined'
            ? bootstrap.Modal.getOrCreateInstance(consentModalElement)
            : null;

        if (consentModalElement) {
            consentModalElement.addEventListener('hidden.bs.modal', function () {
                if (consent) {
                    consent.checked = false;
                }
                if (pdfAction) {
                    pdfAction.disabled = true;
                }
            });
        }

        @if (TempData["PreviewError"] != null)
        {
                            <text>
                                        if (consentModal) {
                                            consentModal.show();
                                        }
                            </text>
        }

        const tabPreviewModalElement = document.getElementById('tabPreviewModal');
        const tabPreviewFrame = document.getElementById('tabPreviewFrame');
        const tabPreviewTitle = document.getElementById('tabPreviewModalTitle');
        const tabPreviewEdit = document.getElementById('tabPreviewEdit');
        const tabPreviewBody = tabPreviewFrame ? tabPreviewFrame.closest('.modal-body') : null;
        const tabPreviewModal = tabPreviewModalElement && typeof bootstrap !== 'undefined'
            ? bootstrap.Modal.getOrCreateInstance(tabPreviewModalElement)
            : null;

        const makeTabPreviewReadOnly = function () {
            if (!tabPreviewFrame || !tabPreviewFrame.contentDocument) {
                return;
            }

            const previewDocument = tabPreviewFrame.contentDocument;
            const previewStyle = previewDocument.createElement('style');
            previewStyle.textContent = `
                .ca-sb { display: none !important; }
                .ca-shell { gap: 0 !important; padding-left: 0 !important; padding-right: 0 !important; }
                .ca-main { margin-left: 0 !important; width: 100% !important; }
                input, select, textarea, button, [contenteditable="true"] { cursor: not-allowed !important; }
                input:not([type="hidden"]), select, textarea { background: #eef2f6 !important; color: #435273 !important; }
                input[type="checkbox"], input[type="radio"] { accent-color: #7d8ea1; }
                button[type="submit"], input[type="submit"], input[type="button"] { display: none !important; }
            `;
            previewDocument.head.appendChild(previewStyle);

            previewDocument.querySelectorAll('input, select, textarea, button, [contenteditable="true"]').forEach(function (field) {
                if (field.matches('input[type="hidden"]')) {
                    return;
                }

                if (field.matches('input[type="checkbox"], input[type="radio"], select, button')) {
                    field.disabled = true;
                } else if ('readOnly' in field) {
                    field.readOnly = true;
                }

                field.setAttribute('aria-readonly', 'true');
            });

            previewDocument.querySelectorAll('form').forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                });
            });

            if (tabPreviewBody) {
                tabPreviewBody.classList.remove('is-loading');
            }
        };

        if (tabPreviewFrame) {
            tabPreviewFrame.addEventListener('load', makeTabPreviewReadOnly);
        }

        document.querySelectorAll('.preview-tab-row span').forEach(function (name) {
            name.setAttribute('role', 'button');
            name.setAttribute('tabindex', '0');

            const openPreview = function () {
                const row = name.closest('.preview-tab-row');
                const editLink = row ? row.querySelector('a[href]') : null;

                if (!editLink || !tabPreviewModal || !tabPreviewFrame || !tabPreviewEdit) {
                    return;
                }

                tabPreviewTitle.textContent = name.textContent.trim() + ' Preview';
                if (tabPreviewBody) {
                    tabPreviewBody.classList.add('is-loading');
                }
                tabPreviewFrame.src = editLink.href;
                tabPreviewEdit.href = editLink.href;
                tabPreviewModal.show();
            };

            name.addEventListener('click', openPreview);
            name.addEventListener('keydown', function (event) {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    openPreview();
                }
            });
        });

        if (tabPreviewModalElement && tabPreviewFrame) {
            tabPreviewModalElement.addEventListener('hidden.bs.modal', function () {
                tabPreviewFrame.src = 'about:blank';
            });
        }
    });
</script>

<script>
    // Principal Seal & Signature re-upload: keep the section, file input and upload button
    // visible and enabled at all times (also after the application is submitted), even if a
    // layout script, other stylesheet or browser extension tries to hide or disable them.
    (function () {
        function force(el, display) {
            if (!el) return;
            el.hidden = false;
            el.removeAttribute('hidden');
            el.removeAttribute('disabled');
            el.removeAttribute('readonly');
            el.removeAttribute('aria-disabled');
            if ('disabled' in el) el.disabled = false;
            el.style.setProperty('display', display, 'important');
            el.style.setProperty('visibility', 'visible', 'important');
            el.style.setProperty('opacity', '1', 'important');
            el.style.setProperty('pointer-events', 'auto', 'important');
        }

        function keepReuploadAvailable() {
            var section = document.getElementById('SealReupload');
            if (!section) return;
            force(section, 'block');
            force(section.querySelector('.reupload-body'), 'block');
            force(section.querySelector('.reupload-form'), 'flex');
            force(section.querySelector('input[type="file"]'), 'block');
            force(section.querySelector('.reupload-btn'), 'inline-flex');
        }

        document.addEventListener('DOMContentLoaded', function () {
            keepReuploadAvailable();
            var section = document.getElementById('SealReupload');
            if (!section) return;
            var options = {
                subtree: true,
                attributes: true,
                attributeFilter: ['style', 'class', 'hidden', 'disabled', 'readonly', 'aria-disabled']
            };
            var observer = new MutationObserver(function () {
                // Pause while we restore state so our own changes don't re-trigger the observer.
                observer.disconnect();
                keepReuploadAvailable();
                observer.observe(section, options);
            });
            observer.observe(section, options);
        });
        window.addEventListener('pageshow', keepReuploadAvailable);
        window.addEventListener('load', keepReuploadAvailable);
    })();
</script>
