                    border: 1px solid var(--border-soft);
                    border-radius: 10px;
                    margin-bottom: .55rem;
                    overflow: hidden;
                }

                .data-table.kv th, .data-table.kv td {
                    display: block;
                    width: 100% !important;
                    min-width: 0 !important;
                    border-bottom: 0 !important;
                    padding: .4rem .8rem;
                }

                .data-table.kv th {
                    padding-bottom: .1rem;
                    font-size: .74rem;
                }

