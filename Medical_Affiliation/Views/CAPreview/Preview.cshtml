                    <div id="PrincipalDetails" class="preview-report-section">
                        <h2 class="preview-report-heading"><span>05 · Staff Particulars - Principal</span><a class="preview-report-edit" href="@Url.Action("Aff_PrincipalDetails", "ContinuesAffiliation_Facultybased")"><i class="bi bi-pencil-square me-1"></i>Edit</a></h2>
