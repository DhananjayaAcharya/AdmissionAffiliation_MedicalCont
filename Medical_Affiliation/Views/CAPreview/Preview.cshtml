@model Medical_Affiliation.Models.CApreviewViewModel
@{
    ViewData["Title"] = "Details Preview";
    Layout = "~/Views/Shared/_CaLayout.cshtml";
    var previewCourseLevel = (Context.Session.GetString("CourseLevel")
                              ?? Context.Session.GetString("SelectedCourseLevel")
                              ?? Model.ApplyingCourseLevel
                              ?? string.Empty).Trim().ToUpperInvariant();
    var isUgPreview = previewCourseLevel == "UG";
    var isPgPreview = previewCourseLevel == "PG";
    var isSsPreview = previewCourseLevel == "SS";
    var courseLevelLabel = previewCourseLevel switch
    {
        "UG" => "Undergraduate (UG)",
        "PG" => "Postgraduate (PG)",
        "SS" => "Super Specialty (SS)",
        _ => "Not specified"
    };
    var applicationReadOnly = string.Equals(
        Context.Session.GetString("CAApplicationReadOnly"),
        "true",
        StringComparison.OrdinalIgnoreCase);
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=EB+Garamond:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap');

    /* ==========================================================
           Palette shared with the continuous-affiliation shell:
           gradient  #173d56 -> #176b87 -> #25859a
           accent    #dcae3f -> #f1d27a -> #dcae3f
           body bg   #eef3f8
           fonts     EB Garamond (display) / DM Sans (body)
           ========================================================== */
    :root {
        --ink: #1d2b3a;
        --navy-deep: #173d56;
        --navy: #176b87;
        --navy-light: #25859a;
        --navy-soft: #e7f3f5;
        --gold: #dcae3f;
        --gold-soft: #f1d27a;
        --gold-ink: #765b18;
        --paper: #eef3f8;
        --surface: #ffffff;
        --border: #d6e0ea;
        --border-soft: #e8eef3;
        --muted: #647386;
        --danger: #a83232;
        --card-shadow: 0 8px 24px rgba(29, 55, 79, 0.08);
        --header-shadow: 0 10px 30px rgba(23, 61, 86, 0.22);
        --font-serif: 'EB Garamond', Georgia, 'Times New Roman', serif;
        --font-sans: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* ========================= */
    /* PAGE SHELL */
    /* ========================= */
    .affiliation-page-container {
        background: transparent;
        min-height: 100vh;
        padding: 0 0 1rem;
        font-family: var(--font-sans);
        color: var(--ink);
    }

        .affiliation-page-container > .container-fluid {
            max-width: 1360px;
        }

    /* ========================= */
    /* HEADER */
    /* ========================= */
    .affiliation-header-wrapper {
        background: linear-gradient(120deg, var(--navy-deep) 0%, var(--navy) 50%, var(--navy-light) 100%);
        border: 0;
        border-radius: 14px;
        box-shadow: var(--header-shadow);
        color: #fff;
        margin-bottom: 1rem;
        overflow: hidden;
        padding: 1.85rem 2.1rem;
        position: relative;
    }

        .affiliation-header-wrapper::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 4px;
            background: linear-gradient(90deg, var(--gold) 0%, var(--gold-soft) 45%, var(--gold) 100%);
        }

    .affiliation-header-content {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
    }

    .affiliation-header-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.75rem;
        flex-wrap: wrap;
    }

    .affiliation-header-primary {
        min-width: 0;
        flex: 1 1 320px;
    }

    .affiliation-header-actions {
        flex-shrink: 0;
        padding-top: 0.15rem;
    }

    .submit-application-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, var(--gold-soft) 0%, var(--gold) 100%);
        border: 1px solid var(--gold);
        border-radius: 8px;
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.18);
        color: var(--navy-deep);
        font-size: 0.85rem;
        font-weight: 700;
        padding: 0.65rem 1.2rem;
        white-space: nowrap;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }

        .submit-application-btn:hover {
            background: linear-gradient(135deg, #fff 0%, var(--gold-soft) 100%);
            box-shadow: 0 10px 22px rgba(0, 0, 0, 0.22);
            transform: translateY(-1px);
        }

        .submit-application-btn i {
            font-size: 0.95rem;
        }

    .affiliation-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(241, 210, 122, 0.55);
        color: #f1d27a;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        margin-bottom: 0.9rem;
    }

    .affiliation-title {
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: clamp(1.5rem, 2.4vw, 2.05rem);
        line-height: 1.25;
        margin: 0;
        max-width: 34ch;
        overflow-wrap: break-word;
    }

    .affiliation-subtitle {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.85rem;
        margin-top: 0.45rem;
    }

    .affiliation-meta {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.6rem;
    }

    .meta-item {
        background: rgba(4, 20, 39, 0.22);
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-left: 2px solid var(--gold-soft);
        border-radius: 6px;
        padding: 0.65rem 0.85rem;
        min-width: 0;
    }

    .meta-label {
        color: rgba(255, 255, 255, 0.65);
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        margin-bottom: 0.2rem;
    }

    .meta-value {
        color: #fff;
        font-weight: 600;
        font-size: 0.92rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ========================= */
    /* BREADCRUMB */
    /* ========================= */
    .breadcrumb-wrapper {
        background: transparent;
        border: 0;
        border-bottom: 1px solid var(--border);
        border-radius: 0;
        margin-bottom: 1.1rem;
        padding: 0.25rem 0 0.75rem;
    }

    .breadcrumb-custom {
        margin: 0;
        background: transparent;
        font-size: 0.82rem;
    }

        .breadcrumb-custom .breadcrumb-item a {
            color: var(--navy-light);
            font-weight: 500;
            text-decoration: none;
        }

            .breadcrumb-custom .breadcrumb-item a:hover {
                text-decoration: underline;
            }

        .breadcrumb-custom .breadcrumb-item.active {
            color: var(--muted);
        }

        .breadcrumb-custom .breadcrumb-item + .breadcrumb-item::before {
            color: #b7c2cd;
        }

    /* ========================= */
    /* INFO ALERT */
    /* ========================= */
    .info-alert {
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 4px solid var(--gold);
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        padding: 0.95rem 1.2rem;
        margin-bottom: 1.15rem;
    }

        .info-alert i {
            color: var(--gold-ink);
            font-size: 1.2rem;
            margin-top: 0.1rem;
        }

    .info-alert-content {
        flex: 1;
    }

    .info-alert-title {
        font-weight: 700;
        color: var(--navy);
        font-size: 0.9rem;
        margin-bottom: 0.15rem;
    }

    .info-alert-text {
        color: var(--muted);
        font-size: 0.85rem;
        line-height: 1.55;
        margin: 0;
    }

    /* ========================= */
    /* TAB DIRECTORY */
    /* ========================= */
    .preview-tab-directory {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem;
        margin-bottom: 1.4rem;
    }

    .preview-tab-group {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--card-shadow);
    }

    .preview-tab-group-title {
        background: var(--navy-soft);
        border-bottom: 1px solid var(--border);
        color: var(--navy);
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        margin: 0;
        padding: 0.65rem 0.85rem;
    }

    .preview-tab-list {
        display: grid;
    }

    .preview-tab-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        background: var(--surface);
        border: 0;
        border-bottom: 1px solid var(--border-soft);
        border-radius: 0;
        padding: 0.55rem 0.85rem;
        transition: background 0.15s ease;
    }

        .preview-tab-row:last-child {
            border-bottom: 0;
        }

        .preview-tab-row:hover {
            background: var(--navy-soft);
        }

        .preview-tab-row span {
            color: var(--navy);
            cursor: pointer;
            font-size: 0.83rem;
            font-weight: 500;
            line-height: 1.35;
        }

            .preview-tab-row span:hover {
                color: var(--navy-light);
                text-decoration: underline;
                text-decoration-thickness: 1px;
                text-underline-offset: 3px;
            }

        .preview-tab-row a {
            flex-shrink: 0;
            background: transparent;
            border: 1px solid var(--navy);
            border-radius: 6px;
            color: var(--navy);
            font-size: 0.72rem;
            font-weight: 600;
            padding: 0.3rem 0.6rem;
            text-decoration: none;
            white-space: nowrap;
        }

            .preview-tab-row a:hover {
                background: var(--navy);
                color: #fff;
            }

    /* ========================= */
    /* REPORT SECTIONS */
    /* ========================= */
    .preview-report {
        display: grid;
        gap: 0.9rem;
    }

    .preview-report-section {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        overflow: hidden;
        scroll-margin-top: 20px;
    }

    .preview-report-heading {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        background: var(--navy-soft);
        border-bottom: 1px solid var(--border);
        color: var(--navy);
        font-family: var(--font-serif);
        font-size: 1.05rem;
        font-weight: 600;
        margin: 0;
        padding: 0.8rem 1.1rem;
    }

    .preview-report-edit {
        flex: 0 0 auto;
        background: #fff;
        border: 1px solid var(--navy);
        border-radius: 6px;
        color: var(--navy);
        font-family: var(--font-sans);
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.3rem 0.65rem;
        text-decoration: none;
    }

        .preview-report-edit:hover {
            background: var(--navy);
            color: #fff;
        }

        .application-readonly .preview-report-edit,
        .application-readonly .preview-tab-row a,
        .application-readonly .submit-application-btn {
            display: none;
        }

        .readonly-status {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            background: rgba(255, 255, 255, .14);
            border: 1px solid rgba(255, 255, 255, .35);
            border-radius: 8px;
            color: #fff;
            font-size: .8rem;
            font-weight: 700;
            padding: .6rem .85rem;
        }

        .preview-report-heading span {
            display: flex;
            align-items: center;
            flex: 1;
        }

            .preview-report-heading span::before {
                content: "";
                display: inline-block;
                width: 3px;
                height: 1.05rem;
                background: var(--gold);
                margin-right: 0.65rem;
                border-radius: 2px;
            }

    .preview-report-body {
        padding: 1.15rem 1.25rem;
    }

        .preview-report-body .general-section,
        .preview-report-body .general-body {
            border: 0;
            margin: 0;
            padding: 0;
        }

        .preview-report-body .general-header {
            display: none;
        }

        .preview-report-body .section-block {
            border: 0;
            margin: 0;
        }

        .preview-report-body .section-header-block {
            margin-top: 0.3rem;
        }

        .preview-report-body .empty-state {
            padding: 0.9rem 0;
        }

    .empty-state {
        color: var(--muted);
        font-size: 0.85rem;
        font-style: italic;
        padding: 0.5rem 0;
    }

    /* ========================= */
    /* DATA TABLES */
    /* ========================= */
    .data-table {
        border: 1px solid var(--border-soft);
        border-radius: 8px;
        overflow: hidden;
        font-size: 0.87rem;
    }

        .data-table th,
        .data-table td {
            padding: 0.55rem 0.85rem;
            vertical-align: middle;
            border-color: var(--border-soft) !important;
        }

        .data-table tbody th {
            background: var(--navy-soft);
            color: var(--navy);
            font-weight: 600;
            width: 30%;
            white-space: nowrap;
        }

        .data-table tbody td {
            color: var(--ink);
        }

        .data-table thead th {
            background: var(--navy);
            color: #fff;
            font-weight: 700;
            font-size: 0.78rem;
            letter-spacing: 0.02em;
            border-bottom: 1px solid var(--navy-deep);
        }

    .preview-report-body h5.fw-bold {
        font-family: var(--font-serif);
        color: var(--navy);
        font-size: 0.98rem;
        font-weight: 600;
        margin-bottom: 0.6rem;
    }

    /* ========================= */
    /* CONSENT MODAL */
    /* ========================= */
    .consent-modal .modal-dialog {
        max-width: 580px;
    }

    .consent-modal .modal-content {
        border: 0;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(9, 40, 78, 0.28);
    }

    .consent-modal .modal-header {
        background: linear-gradient(120deg, var(--navy-deep) 0%, var(--navy) 50%, var(--navy-light) 100%);
        border-bottom: 3px solid var(--gold-soft);
        color: #fff;
        align-items: flex-start;
        padding: 1.3rem 1.5rem;
        position: relative;
    }

    .consent-modal-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: #ffe27a;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 0.4rem;
    }

    .consent-modal .modal-title {
        font-family: var(--font-serif);
        font-size: 1.2rem;
        font-weight: 600;
        margin: 0;
    }

    .consent-modal .btn-close {
        filter: invert(1);
        margin-top: 0.2rem;
    }

    .consent-body {
        padding: 1.4rem 1.6rem 1.6rem;
    }

        .consent-body p {
            color: var(--muted);
            font-size: 0.87rem;
            line-height: 1.65;
            margin-bottom: 1.1rem;
        }

            .consent-body p strong {
                color: var(--navy);
                font-weight: 700;
            }

    .preview-caution {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        background: #fff8e6;
        border: 1px solid #f3dfa0;
        border-left: 4px solid var(--gold);
        border-radius: 8px;
        color: var(--gold-ink);
        font-size: 0.82rem;
        font-weight: 500;
        line-height: 1.5;
        margin-bottom: 1.25rem;
        padding: 0.75rem 1.1rem;
    }

        .preview-caution i {
            color: var(--gold-ink);
            font-size: 1rem;
            flex-shrink: 0;
            margin-top: 0.15rem;
        }

        .preview-caution strong {
            color: var(--gold-ink);
            font-weight: 700;
        }

    .consent-body .form-check {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        border-top: 1px solid var(--border-soft);
        padding-top: 1rem;
        margin-top: 0.2rem;
    }

    .consent-body .form-check-input {
        appearance: none;
        -webkit-appearance: none;
        width: 1.25rem;
        height: 1.25rem;
        margin: 0;
        border: 1.75px solid #8a96a3;
        border-radius: 4px;
        background-color: #fff;
        cursor: pointer;
        position: relative;
        flex-shrink: 0;
        transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }

        .consent-body .form-check-input:hover {
            border-color: var(--navy-light);
        }

        .consent-body .form-check-input:focus-visible {
            outline: none;
            box-shadow: 0 0 0 3px rgba(14, 87, 173, 0.22);
        }

        .consent-body .form-check-input:checked {
            background-color: var(--navy);
            border-color: var(--navy);
            box-shadow: 0 2px 6px rgba(13, 74, 148, 0.28);
        }

            .consent-body .form-check-input:checked::after {
                content: "";
                position: absolute;
                left: 0.36rem;
                top: 0.16rem;
                width: 0.32rem;
                height: 0.62rem;
                border: solid #ffffff;
                border-width: 0 2px 2px 0;
                transform: rotate(40deg);
            }

    .consent-body .form-check-label {
        color: var(--ink);
        font-size: 0.87rem;
        font-weight: 500;
        cursor: pointer;
        transition: color 0.15s ease;
    }

    .consent-body .form-check-input:checked + .form-check-label {
        color: var(--navy);
        font-weight: 600;
    }

    .consent-body .pdf-action {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        width: 100%;
        background: linear-gradient(120deg, var(--navy-deep) 0%, var(--navy) 50%, var(--navy-light) 100%);
        border: 1px solid var(--navy-deep);
        border-radius: 8px;
        box-shadow: 0 8px 18px rgba(13, 74, 148, 0.28);
        color: #fff;
        font-size: 0.88rem;
        font-weight: 700;
        padding: 0.75rem 1.05rem;
        margin-top: 1.1rem;
        cursor: pointer;
        transition: filter 0.15s ease, opacity 0.15s ease;
    }

        .consent-body .pdf-action:hover:not(:disabled) {
            filter: brightness(1.08);
        }

        .consent-body .pdf-action:disabled {
            background: #c3cdd6;
            border-color: #c3cdd6;
            box-shadow: none;
            cursor: not-allowed;
            opacity: 0.85;
        }

    .consent-body .pdf-hint {
        color: var(--muted);
        font-size: 0.74rem;
        text-align: center;
        margin-top: 0.55rem;
    }

    /* ========================= */
    /* FOOTER ACTIONS */
    /* ========================= */
    .page-actions {
        margin-top: 1.25rem;
    }

        .page-actions .btn-secondary {
            background: var(--surface);
            border: 1px solid var(--navy);
            color: var(--navy);
            font-weight: 600;
            font-size: 0.85rem;
            padding: 0.55rem 1.35rem;
            border-radius: 8px;
            transition: all 0.15s ease;
        }

            .page-actions .btn-secondary:hover {
                background: var(--navy);
                color: #fff;
            }

    /* ========================= */
    /* TAB PREVIEW MODAL */
    /* ========================= */
    .preview-modal .modal-dialog {
        max-width: 1120px;
    }

    .preview-modal .modal-content {
        border: 0;
        border-radius: 12px;
        overflow: hidden;
    }

    .preview-modal .modal-header {
        background: linear-gradient(120deg, var(--navy-deep) 0%, var(--navy) 50%, var(--navy-light) 100%);
        border-bottom: 3px solid var(--gold-soft);
        color: #fff;
        padding: 0.8rem 1.1rem;
    }

    .preview-modal .modal-title {
        font-family: var(--font-serif);
        font-size: 1rem;
        font-weight: 600;
    }

    .preview-modal .btn-close {
        filter: invert(1);
    }

    .preview-modal .modal-body {
        background: var(--paper);
        height: min(74vh, 760px);
        padding: 0;
    }

        .preview-modal .modal-body.is-loading {
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .preview-modal .modal-body.is-loading::after {
                content: "Loading preview…";
                color: var(--navy);
                font-size: 0.85rem;
                font-weight: 600;
            }

    .preview-modal iframe {
        background: #fff;
        border: 0;
        height: 100%;
        width: 100%;
    }

    .preview-modal .modal-footer {
        background: #fff;
        border-top: 1px solid var(--border);
        padding: 0.65rem 1rem;
    }

        .preview-modal .modal-footer a {
            background: var(--navy);
            border-radius: 6px;
            color: #fff;
            font-size: 0.76rem;
            font-weight: 600;
            padding: 0.45rem 0.85rem;
            text-decoration: none;
        }

            .preview-modal .modal-footer a:hover {
                background: var(--navy-light);
            }

    /* ========================= */
    /* RESPONSIVE */
    /* ========================= */
    @@media (max-width: 992px) {
        .preview-tab-directory {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .affiliation-meta {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 900px) {
        .affiliation-header-top {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.9rem;
        }

        .submit-application-btn {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 640px) {
        .preview-tab-directory {
            grid-template-columns: 1fr;
        }

        .affiliation-meta {
            grid-template-columns: 1fr;
        }

        .affiliation-header-wrapper {
            padding: 1.4rem 1.25rem;
        }

        .data-table th, .data-table td {
            font-size: 0.82rem;
            padding: 0.5rem 0.6rem;
        }
    }
</style>

<div id="PreviewTop" class="affiliation-page-container @(applicationReadOnly ? "application-readonly" : string.Empty)">
    <div class="container-fluid">

        <!-- ========================= -->
        <!-- OFFICIAL HEADER -->
        <!-- ========================= -->
        <div class="affiliation-header-wrapper">
            <div class="affiliation-header-content">
                <div class="affiliation-header-top">
                    <div class="affiliation-header-primary">
                        <div class="affiliation-badge">
                            <i class="bi bi-patch-check-fill"></i>
                            Continuous Affiliation &middot; Application Preview
                        </div>
                        <h1 class="affiliation-title">
