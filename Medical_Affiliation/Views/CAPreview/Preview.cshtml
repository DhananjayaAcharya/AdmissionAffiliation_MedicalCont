                        else
                        {
                            <div class="empty-state">No trust institution details available.</div>
                        }
                    </div>
                </div>

                @if (Model.InstitutionBasicVM != null)
                {
                    <div id="TrustMemberDetails" class="preview-report-section">
                        <h2 class="preview-report-heading"><span>03 · Trust Member Details</span><a class="preview-report-edit" href="@Url.Action("Aff_TrustMemberDetails", "ContinuesAffiliation_Facultybased")"><i class="bi bi-pencil-square me-1"></i>Edit</a></h2>
                        <div class="preview-report-body">@await Html.PartialAsync("BasicDetails/_TrustMembersDetails", Model.InstitutionBasicVM)</div>
