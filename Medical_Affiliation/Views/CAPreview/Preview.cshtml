</style>

<div id="PreviewTop" class="pv-page affiliation-page-container @(applicationReadOnly ? "application-readonly" : string.Empty)" style="--wm:url('@Url.Content("~/images/newLogo.jpeg")')">
    <div class="container-fluid">

        <!-- ================= HERO ================= -->
        <header class="pv-hero">
            <div class="pv-hero-top">
                <div class="pv-brand pv-hero-main">
                    <img class="pv-logo" src="@Url.Content("~/images/newLogo.jpeg")" alt="RGUHS logo" />
                    <div style="min-width:0">
                        <div class="pv-kicker"><i class="bi bi-patch-check-fill"></i> Continuous Affiliation application preview</div>
                        <h1 class="pv-title">
                            @(Model.InstitutionDetails != null && !string.IsNullOrWhiteSpace(Model.InstitutionDetails.NameOfInstitution)
                                ? Model.InstitutionDetails.NameOfInstitution
                                : "College Affiliation Preview")
                        </h1>
                        <div class="pv-sub">Read-only summary of your application. Use Edit on any section to change it before final submission.</div>
                    </div>
                </div>
                <div>
                    @if (applicationReadOnly)
                    {
                        <a class="readonly-status" href="@Url.Action("SubmitApplication", "CAPreview")" target="_blank" rel="noopener">
                            <i class="bi bi-file-earmark-pdf-fill"></i> View / download final PDF
                        </a>
                    }
                    else if (Model.IsApplicationComplete && Model.CompletionPercentage >= 100)
                    {
                        <button type="button" class="submit-application-btn" data-bs-toggle="modal" data-bs-target="#consentModal">
                            <i class="bi bi-send-check-fill"></i> Submit application
                        </button>
                    }
                </div>
            </div>

            <div class="pv-chips">
                <span class="pv-chip"><small>Course level</small><b>@courseLevelLabel</b></span>
                <span class="pv-chip"><small>Institution type</small><b>@(Model.InstitutionDetails != null && !string.IsNullOrWhiteSpace(Model.InstitutionDetails.TypeOfInstitution) ? Model.InstitutionDetails.TypeOfInstitution : "—")</b></span>
                <span class="pv-chip"><small>District</small><b>@(Model.InstitutionDetails != null && !string.IsNullOrWhiteSpace(Model.InstitutionDetails.District) ? Model.InstitutionDetails.District : "—")</b></span>
                <span class="pv-chip"><small>Generated</small><b>@DateTime.Now.ToString("dd MMM yyyy")</b></span>
            </div>

            <div class="pv-progress" role="progressbar" aria-valuenow="@completionPct" aria-valuemin="0" aria-valuemax="100" aria-label="Application completion">
                <div class="pv-progress-row"><span>Application completion</span><span>@completionPct%</span></div>
                <div class="pv-progress-track"><div class="pv-progress-fill" style="width:@completionPct%"></div></div>
            </div>
        </header>

        <!-- ============ SEAL & SIGNATURE RE-UPLOAD (always available) ============ -->
        <div class="reupload-highlight" id="SealReupload">
            <div class="reupload-header"><i class="bi bi-file-earmark-arrow-up-fill"></i> Principal seal and signature re-upload</div>
            <div class="reupload-body">
                <p>Upload the complete application after the Principal has signed and sealed it.</p>
                @if (Model.HasSealedSignedReupload)
                {
                    <a asp-controller="CAPreview" asp-action="ViewSignedReupload" target="_blank" rel="noopener" class="btn btn-outline-primary mb-3">
                        <i class="bi bi-eye"></i> View uploaded document
                    </a>
                }
                @if (TempData["PreviewError"] != null)
                {
                    <div class="alert alert-danger" role="alert">@TempData["PreviewError"]</div>
                }
                @if (TempData["PreviewSuccess"] != null)
                {
                    <div class="alert alert-success" role="status">@TempData["PreviewSuccess"]</div>
                }
                <form asp-controller="CAPreview" asp-action="ReuploadSignedDocument" method="post" enctype="multipart/form-data" class="reupload-form">
                    @Html.AntiForgeryToken()
                    <input type="file" class="form-control" name="sealedSignedReupload" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                    <button type="submit" class="reupload-btn"><i class="bi bi-upload"></i> Upload signed copy</button>
                </form>
            </div>
        </div>

        <!-- ============ OUTLINE + SECTIONS ============ -->
        <div class="pv-layout">
            <div class="pv-toolbar">
                <h2 class="pv-toolbar-title">Application sections</h2>
                <div class="pv-toolbar-actions">
                    <button type="button" class="pv-btn" id="pvExpandAll"><i class="bi bi-arrows-expand"></i> Expand all</button>
                    <button type="button" class="pv-btn" id="pvCollapseAll"><i class="bi bi-arrows-collapse"></i> Collapse all</button>
                </div>
            </div>

            <div class="preview-report">

                <div id="InstitutionDetails" class="preview-report-section">
                    <h2 class="preview-report-heading"><span>01 · Institution Details</span><a class="preview-report-edit" href="@Url.Action("Institution_Details", "ContinuesAffiliation_Facultybased")"><i class="bi bi-pencil-square me-1"></i>Edit</a></h2>
                    <div class="preview-report-body">
                        @if (Model.InstitutionDetails != null)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm data-table align-middle mb-0">
                                    <tbody>
                                        <tr><th>Type of Institution</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.TypeOfInstitution) ? Model.InstitutionDetails.TypeOfInstitution : "—")</td></tr>
                                        <tr><th>Institution Name</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.NameOfInstitution) ? Model.InstitutionDetails.NameOfInstitution : "—")</td></tr>
                                        <tr><th>Address</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.Address) ? Model.InstitutionDetails.Address : "—")</td></tr>
                                        <tr><th>City / Taluk / District</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.VillageTownCity) ? Model.InstitutionDetails.VillageTownCity : "—") / @(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.Taluk) ? Model.InstitutionDetails.Taluk : "—") / @(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.District) ? Model.InstitutionDetails.District : "—")</td></tr>
                                        <tr><th>PIN Code</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.PinCode) ? Model.InstitutionDetails.PinCode : "—")</td></tr>
                                        <tr><th>Mobile / Email</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.MobileNumber) ? Model.InstitutionDetails.MobileNumber : "—") / @(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.EmailId) ? Model.InstitutionDetails.EmailId : "—")</td></tr>
                                        <tr><th>Website</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.Website) ? Model.InstitutionDetails.Website : "—")</td></tr>
                                        <tr><th>Survey / PID No</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.SurveyNoPidNo) ? Model.InstitutionDetails.SurveyNoPidNo : "—")</td></tr>
                                        <tr><th>Minority Institute</th><td>@(Model.InstitutionDetails.MinorityInstitute ? "Yes" : "No")</td></tr>
                                        <tr><th>Attached to Medical College</th><td>@(Model.InstitutionDetails.AttachedToMedicalClg ? "Yes" : "No")</td></tr>
                                        <tr><th>Rural Institute</th><td>@(Model.InstitutionDetails.RuralInstitute ? "Yes" : "No")</td></tr>
                                        <tr><th>Year of Establishment</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.YearOfEstablishment) ? Model.InstitutionDetails.YearOfEstablishment : "—")</td></tr>
                                        <tr><th>Alternate Landline / Mobile</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.AltLandlineMobile) ? Model.InstitutionDetails.AltLandlineMobile : "—")</td></tr>
                                        <tr><th>Alternate Email</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.AltEmailId) ? Model.InstitutionDetails.AltEmailId : "—")</td></tr>
                                        <tr><th>Nodal Officer Name</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.NodalOfficer_Name) ? Model.InstitutionDetails.NodalOfficer_Name : "—")</td></tr>
                                        <tr><th>Nodal Officer Mobile</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.NodalOfficer_Mob_Number) ? Model.InstitutionDetails.NodalOfficer_Mob_Number : "—")</td></tr>
                                        <tr><th>Nodal Officer Email</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.NodalOfficer_Email) ? Model.InstitutionDetails.NodalOfficer_Email : "—")</td></tr>
                                        <tr><th>Principal Name</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.Principal_Name) ? Model.InstitutionDetails.Principal_Name : "—")</td></tr>
                                        <tr><th>Principal Mobile</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.Principal_Mob_No) ? Model.InstitutionDetails.Principal_Mob_No : "—")</td></tr>
                                        <tr><th>Principal Email</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.Principal_Email) ? Model.InstitutionDetails.Principal_Email : "—")</td></tr>
                                        <tr><th>Course Level</th><td>@(!string.IsNullOrWhiteSpace(Model.InstitutionDetails.CourseLevel) ? Model.InstitutionDetails.CourseLevel : "—")</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">No institution details available.</div>
                        }
                    </div>
                </div>

                <div id="TrustInstitutionDetails" class="preview-report-section">
