@model Medical_Affiliation.Models.CApreviewViewModel
@inject Medical_Affiliation.DATA.ApplicationDbContext _context
@using Microsoft.EntityFrameworkCore
@using Medical_Affiliation.Models
@{
    ViewData["Title"] = "Details Preview";
    Layout = "~/Views/Shared/_CaLayout.cshtml";
    var previewCourseLevel = (Context.Session.GetString("CourseLevel")
                              ?? Context.Session.GetString("SelectedCourseLevel")
                              ?? Model.ApplyingCourseLevel
                              ?? string.Empty).Trim().ToUpperInvariant();
    var isUgPreview = previewCourseLevel == "UG";
    var isPgPreview = previewCourseLevel == "PG";
    var isSsPreview = previewCourseLevel == "SS";
    var courseLevelLabel = previewCourseLevel switch
    {
        "UG" => "Undergraduate (UG)",
        "PG" => "Postgraduate (PG)",
        "SS" => "Super Specialty (SS)",
        _ => "Not specified"
    };
    var previewApplicationType = (Model.ApplicationType
        ?? Context.Session.GetString("TypeOfAffiliation")
        ?? string.Empty).Trim();
    var previewCollegeCode = (Model.CollegeCode
        ?? Context.Session.GetString("CollegeCode")
        ?? string.Empty).Trim();
    var applicationReadOnly = !string.IsNullOrWhiteSpace(previewCollegeCode)
        && !string.IsNullOrWhiteSpace(previewApplicationType)
        && !string.IsNullOrWhiteSpace(previewCourseLevel)
        && await _context.Database.SqlQuery<int>($@"
            SELECT COUNT(*) AS [Value]
            FROM dbo.ApplicationSubmission
            WHERE CollegeCode = {previewCollegeCode}
              AND LTRIM(RTRIM(TypeOfAffiliation)) = LTRIM(RTRIM({previewApplicationType}))
              AND UPPER(LTRIM(RTRIM(CourseLevel))) = {previewCourseLevel}").FirstOrDefaultAsync() > 0;

    // ---- Section 11: Skills Laboratory (direct from Medical_SkillsLaboratory) ----
    var slFacultyCode = (Model.FacultyCode ?? Context.Session.GetString("FacultyCode") ?? string.Empty).Trim();
    var slAffiliationType = Context.Session.GetInt32("AffiliationType")
        ?? (int.TryParse(Context.Session.GetString("TypeOfAffiliation"), out var slAffType) ? slAffType : 2);

    SkillsLabRow? skillsLab = null;
    if (!string.IsNullOrWhiteSpace(previewCollegeCode) && !string.IsNullOrWhiteSpace(slFacultyCode))
    {
        skillsLab = await _context.Database.SqlQuery<SkillsLabRow>($@"
            SELECT TOP (1) *
            FROM dbo.Medical_SkillsLaboratory
            WHERE LTRIM(RTRIM(CollegeCode)) = {previewCollegeCode}
              AND LTRIM(RTRIM(CAST(FacultyCode AS varchar(20)))) = {slFacultyCode}
            ORDER BY Id DESC").FirstOrDefaultAsync();
    }

    // Annual MBBS intake: UG uses Intake_26_27 (same source as Section 10)
    int? slAnnualMbbsIntake = skillsLab?.AnnualMbbsIntake;
    if (isUgPreview && !string.IsNullOrWhiteSpace(previewCollegeCode) && !string.IsNullOrWhiteSpace(slFacultyCode))
    {
        slAnnualMbbsIntake = await _context.Database.SqlQuery<int>($@"
            SELECT TOP (1) COALESCE(TRY_CAST(Intake_26_27 AS int), 0) AS [Value]
            FROM dbo.Mst_MedicalCollegeCourseIntake
            WHERE LTRIM(RTRIM(coll_code)) = {previewCollegeCode}
              AND LTRIM(RTRIM(CAST(Facultycode AS varchar(20)))) = {slFacultyCode}
              AND UPPER(LTRIM(RTRIM(ug_pg))) = {previewCourseLevel}
              AND UPPER(LTRIM(RTRIM(course))) = 'MBBS'
            ORDER BY SLNO DESC").FirstOrDefaultAsync();
    }

    // ---- Section 12: Associated Institutions (from dbo.AssociatedInstitutions, by college code) ----
    // If your connection string does not point at Admission_Affiliation, use
    // [Admission_Affiliation].[dbo].[AssociatedInstitutions] in the FROM clause.
    List<AssociatedInstitutionRow> associatedInstitutions = new();
    if (!string.IsNullOrWhiteSpace(previewCollegeCode))
    {
        associatedInstitutions = await _context.Database.SqlQuery<AssociatedInstitutionRow>($@"
            SELECT Id,
                   CAST(TypeOfAffiliation AS varchar(100))      AS TypeOfAffiliation,
                   CAST(CollegeCode AS varchar(50))             AS CollegeCode,
                   CAST(AssociatedCollegeCode AS varchar(50))   AS AssociatedCollegeCode,
                   CAST(AssociatedFacultyCode AS varchar(50))   AS AssociatedFacultyCode,
                   CAST(FacultyCode AS varchar(50))             AS FacultyCode,
                   CAST(CourseCode AS varchar(50))              AS CourseCode,
                   CAST(CourseName AS varchar(300))             AS CourseName,
                   CAST(CourseLevel AS varchar(50))             AS CourseLevel,
                   AnnualIntake,
                   CreatedOn
            FROM dbo.AssociatedInstitutions
            WHERE LTRIM(RTRIM(CAST(CollegeCode AS varchar(50)))) = {previewCollegeCode}
            ORDER BY AssociatedCollegeCode, CourseName").ToListAsync();
    }

    string Yn(bool? v) => v.HasValue ? (v.Value ? "Yes" : "No") : "—";
    string Num(int? v) => v.HasValue ? v.Value.ToString() : "—";
    string Dec(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "—";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=EB+Garamond:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap');

    /* ==========================================================
                   Palette shared with the continuous-affiliation shell:
                   gradient  #173d56 -> #176b87 -> #25859a
                   accent    #dcae3f -> #f1d27a -> #dcae3f
                   body bg   #eef3f8
                   fonts     EB Garamond (display) / DM Sans (body)
                   ========================================================== */
    :root {
        --ink: #1d2b3a;
        --navy-deep: #173d56;
        --navy: #176b87;
        --navy-light: #25859a;
        --navy-soft: #e7f3f5;
        --gold: #dcae3f;
        --gold-soft: #f1d27a;
        --gold-ink: #765b18;
        --paper: #eef3f8;
        --surface: #ffffff;
        --border: #d6e0ea;
        --border-soft: #e8eef3;
        --muted: #647386;
        --danger: #a83232;
        --card-shadow: 0 8px 24px rgba(29, 55, 79, 0.08);
        --header-shadow: 0 10px 30px rgba(23, 61, 86, 0.22);
        --font-serif: 'EB Garamond', Georgia, 'Times New Roman', serif;
        --font-sans: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* ========================= */
    /* PAGE SHELL */
    /* ========================= */
    .affiliation-page-container {
        background: transparent;
        min-height: 100vh;
        padding: 0 0 1rem;
        font-family: var(--font-sans);
        color: var(--ink);
    }

        .affiliation-page-container > .container-fluid {
            max-width: 1360px;
        }

    /* ========================= */
    /* HEADER */
    /* ========================= */
    .affiliation-header-wrapper {
        background: linear-gradient(120deg, var(--navy-deep) 0%, var(--navy) 50%, var(--navy-light) 100%);
        border: 0;
        border-radius: 14px;
        box-shadow: var(--header-shadow);
        color: #fff;
        margin-bottom: 1rem;
        overflow: hidden;
        padding: 1.85rem 2.1rem;
        position: relative;
    }

        .affiliation-header-wrapper::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 4px;
            background: linear-gradient(90deg, var(--gold) 0%, var(--gold-soft) 45%, var(--gold) 100%);
        }

    .affiliation-header-content {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
    }

    .affiliation-header-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.75rem;
        flex-wrap: wrap;
    }

    .affiliation-header-primary {
        min-width: 0;
        flex: 1 1 320px;
    }

    .affiliation-header-actions {
        flex-shrink: 0;
        padding-top: 0.15rem;
    }

    .submit-application-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, var(--gold-soft) 0%, var(--gold) 100%);
        border: 1px solid var(--gold);
        border-radius: 8px;
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.18);
        color: var(--navy-deep);
        font-size: 0.85rem;
        font-weight: 700;
        padding: 0.65rem 1.2rem;
        white-space: nowrap;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }

        .submit-application-btn:disabled {
            background: #d5dde5;
            border-color: #c3ced8;
            box-shadow: none;
            color: #647386;
            cursor: not-allowed;
            opacity: .85;
            transform: none;
        }

        .submit-application-btn:hover {
            background: linear-gradient(135deg, #fff 0%, var(--gold-soft) 100%);
            box-shadow: 0 10px 22px rgba(0, 0, 0, 0.22);
            transform: translateY(-1px);
        }

        .submit-application-btn i {
            font-size: 0.95rem;
        }

    .affiliation-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(241, 210, 122, 0.55);
        color: #f1d27a;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        margin-bottom: 0.9rem;
    }

    .affiliation-title {
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: clamp(1.5rem, 2.4vw, 2.05rem);
        line-height: 1.25;
        margin: 0;
        max-width: 34ch;
        overflow-wrap: break-word;
    }

    .affiliation-subtitle {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.85rem;
        margin-top: 0.45rem;
    }

    .affiliation-meta {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.6rem;
    }

    .meta-item {
        background: rgba(4, 20, 39, 0.22);
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-left: 2px solid var(--gold-soft);
        border-radius: 6px;
        padding: 0.65rem 0.85rem;
        min-width: 0;
    }

    .meta-label {
        color: rgba(255, 255, 255, 0.65);
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        margin-bottom: 0.2rem;
    }

    .meta-value {
        color: #fff;
        font-weight: 600;
        font-size: 0.92rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ========================= */
    /* BREADCRUMB */
    /* ========================= */
    .breadcrumb-wrapper {
        background: transparent;
        border: 0;
        border-bottom: 1px solid var(--border);
        border-radius: 0;
        margin-bottom: 1.1rem;
        padding: 0.25rem 0 0.75rem;
    }

    .breadcrumb-custom {
        margin: 0;
        background: transparent;
        font-size: 0.82rem;
    }

        .breadcrumb-custom .breadcrumb-item a {
            color: var(--navy-light);
            font-weight: 500;
            text-decoration: none;
        }

            .breadcrumb-custom .breadcrumb-item a:hover {
                text-decoration: underline;
            }

        .breadcrumb-custom .breadcrumb-item.active {
            color: var(--muted);
        }

        .breadcrumb-custom .breadcrumb-item + .breadcrumb-item::before {
            color: #b7c2cd;
        }

    /* ========================= */
    /* INFO ALERT */
    /* ========================= */
    .info-alert {
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 4px solid var(--gold);
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        padding: 0.95rem 1.2rem;
        margin-bottom: 1.15rem;
    }

        .info-alert i {
            color: var(--gold-ink);
            font-size: 1.2rem;
            margin-top: 0.1rem;
        }

    .info-alert-content {
        flex: 1;
    }

    .info-alert-title {
        font-weight: 700;
        color: var(--navy);
        font-size: 0.9rem;
        margin-bottom: 0.15rem;
    }

    .info-alert-text {
        color: var(--muted);
        font-size: 0.85rem;
        line-height: 1.55;
        margin: 0;
    }

    /* ========================= */
    /* TAB DIRECTORY */
    /* ========================= */
    .preview-tab-directory {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem;
        margin-bottom: 1.4rem;
    }

    .preview-tab-group {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--card-shadow);
    }

    .preview-tab-group-title {
        background: var(--navy-soft);
        border-bottom: 1px solid var(--border);
        color: var(--navy);
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        margin: 0;
        padding: 0.65rem 0.85rem;
    }

    .preview-tab-list {
        display: grid;
    }

    .preview-tab-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        background: var(--surface);
        border: 0;
        border-bottom: 1px solid var(--border-soft);
        border-radius: 0;
        padding: 0.55rem 0.85rem;
        transition: background 0.15s ease;
    }

        .preview-tab-row:last-child {
            border-bottom: 0;
        }

        .preview-tab-row:hover {
            background: var(--navy-soft);
        }

        .preview-tab-row span {
            color: var(--navy);
            cursor: pointer;
            font-size: 0.83rem;
            font-weight: 500;
            line-height: 1.35;
        }

            .preview-tab-row span:hover {
                color: var(--navy-light);
                text-decoration: underline;
                text-decoration-thickness: 1px;
                text-underline-offset: 3px;
            }

        .preview-tab-row a {
            flex-shrink: 0;
            background: transparent;
            border: 1px solid var(--navy);
            border-radius: 6px;
            color: var(--navy);
            font-size: 0.72rem;
            font-weight: 600;
            padding: 0.3rem 0.6rem;
            text-decoration: none;
            white-space: nowrap;
        }

            .preview-tab-row a:hover {
                background: var(--navy);
                color: #fff;
            }

    /* ========================= */
    /* REPORT SECTIONS */
    /* ========================= */
    .preview-report {
        display: grid;
        gap: 0.9rem;
    }

    .preview-report-section {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        overflow: hidden;
        scroll-margin-top: 20px;
    }

    .preview-report-heading {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        background: var(--navy-soft);
        border-bottom: 1px solid var(--border);
        color: var(--navy);
        font-family: var(--font-serif);
        font-size: 1.05rem;
        font-weight: 600;
        margin: 0;
        padding: 0.8rem 1.1rem;
    }

    .preview-report-edit {
        flex: 0 0 auto;
        background: #fff;
        border: 1px solid var(--navy);
        border-radius: 6px;
        color: var(--navy);
        font-family: var(--font-sans);
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.3rem 0.65rem;
        text-decoration: none;
    }

        .preview-report-edit:hover {
            background: var(--navy);
            color: #fff;
        }

    /* After submission: hide only the Edit links and the Submit button.
           The Principal Seal & Signature re-upload block is NOT affected and
           stays visible and enabled at all times. */
    /* After submission: hide only the Edit links and the main Submit button.
           The Principal Seal & Signature re-upload block is NOT affected and
           stays visible and enabled at all times. */
    .application-readonly .preview-report-edit,
    .application-readonly .preview-tab-row a,
    .application-readonly .submit-application-btn {
        display: none;
    }

    /* Principal Seal & Signature Re-upload: always visible and always enabled,
           before AND after the application is submitted. */
    #SealReupload {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
        height: auto !important;
        max-height: none !important;
        position: static !important;
    }

        #SealReupload .reupload-body {
            display: block !important;
            visibility: visible !important;
        }

        #SealReupload .reupload-form {
            display: flex !important;
            visibility: visible !important;
            pointer-events: auto !important;
        }

            #SealReupload .reupload-form .form-control {
                display: block !important;
                visibility: visible !important;
                pointer-events: auto !important;
                opacity: 1 !important;
            }

            #SealReupload .reupload-form .reupload-btn {
                display: inline-flex !important;
                visibility: visible !important;
                pointer-events: auto !important;
                opacity: 1 !important;
                cursor: pointer;
            }

    .readonly-status {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: rgba(255, 255, 255, .14);
        border: 1px solid rgba(255, 255, 255, .35);
        border-radius: 8px;
        color: #fff;
        font-size: .8rem;
        font-weight: 700;
        padding: .6rem .85rem;
    }

    .preview-report-heading span {
        display: flex;
        align-items: center;
        flex: 1;
    }

        .preview-report-heading span::before {
            content: "";
            display: inline-block;
            width: 3px;
            height: 1.05rem;
            background: var(--gold);
            margin-right: 0.65rem;
            border-radius: 2px;
        }

    .preview-report-body {
        padding: 1.15rem 1.25rem;
    }

        .preview-report-body .general-section,
        .preview-report-body .general-body {
            border: 0;
            margin: 0;
            padding: 0;
        }

        .preview-report-body .general-header {
            display: none;
        }

        .preview-report-body .section-block {
            border: 0;
            margin: 0;
        }

        .preview-report-body .section-header-block {
            margin-top: 0.3rem;
        }

        .preview-report-body .empty-state {
            padding: 0.9rem 0;
        }

    .empty-state {
        color: var(--muted);
        font-size: 0.85rem;
        font-style: italic;
        padding: 0.5rem 0;
    }

    /* ========================= */
    /* DATA TABLES */
    /* ========================= */
    .data-table {
        border: 1px solid var(--border-soft);
        border-radius: 8px;
        overflow: hidden;
        font-size: 0.87rem;
    }

        .data-table th,
        .data-table td {
            padding: 0.55rem 0.85rem;
            vertical-align: middle;
            border-color: var(--border-soft) !important;
        }

        .data-table tbody th {
            background: var(--navy-soft);
            color: var(--navy);
            font-weight: 600;
            width: 30%;
            white-space: nowrap;
        }

        .data-table tbody td {
            color: var(--ink);
        }

        .data-table thead th {
            background: var(--navy);
            color: #fff;
            font-weight: 700;
            font-size: 0.78rem;
            letter-spacing: 0.02em;
            border-bottom: 1px solid var(--navy-deep);
        }

    .preview-report-body h5.fw-bold {
        font-family: var(--font-serif);
        color: var(--navy);
        font-size: 0.98rem;
        font-weight: 600;
        margin-bottom: 0.6rem;
    }

    /* ========================= */
    /* CONSENT MODAL */
    /* ========================= */
    .consent-modal .modal-dialog {
        max-width: 580px;
    }

    .consent-modal .modal-content {
        border: 0;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(9, 40, 78, 0.28);
    }

    .consent-modal .modal-header {
        background: linear-gradient(120deg, var(--navy-deep) 0%, var(--navy) 50%, var(--navy-light) 100%);
        border-bottom: 3px solid var(--gold-soft);
        color: #fff;
        align-items: flex-start;
        padding: 1.3rem 1.5rem;
        position: relative;
    }

    .consent-modal-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: #ffe27a;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 0.4rem;
    }

    .consent-modal .modal-title {
        font-family: var(--font-serif);
        font-size: 1.2rem;
        font-weight: 600;
        margin: 0;
    }

    .consent-modal .btn-close {
        filter: invert(1);
        margin-top: 0.2rem;
    }

    .consent-body {
        padding: 1.4rem 1.6rem 1.6rem;
    }

        .consent-body p {
            color: var(--muted);
            font-size: 0.87rem;
            line-height: 1.65;
            margin-bottom: 1.1rem;
        }

            .consent-body p strong {
                color: var(--navy);
                font-weight: 700;
            }

    .preview-caution {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        background: #fff8e6;
        border: 1px solid #f3dfa0;
        border-left: 4px solid var(--gold);
        border-radius: 8px;
        color: var(--gold-ink);
        font-size: 0.82rem;
        font-weight: 500;
        line-height: 1.5;
        margin-bottom: 1.25rem;
        padding: 0.75rem 1.1rem;
    }

        .preview-caution i {
            color: var(--gold-ink);
            font-size: 1rem;
            flex-shrink: 0;
            margin-top: 0.15rem;
        }

        .preview-caution strong {
            color: var(--gold-ink);
            font-weight: 700;
        }

    .consent-body .form-check {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        border-top: 1px solid var(--border-soft);
        padding-top: 1rem;
        margin-top: 0.2rem;
    }

    .consent-body .form-check-input {
        appearance: none;
        -webkit-appearance: none;
        width: 1.25rem;
        height: 1.25rem;
        margin: 0;
        border: 1.75px solid #8a96a3;
        border-radius: 4px;
        background-color: #fff;
        cursor: pointer;
        position: relative;
        flex-shrink: 0;
        transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }

        .consent-body .form-check-input:hover {
            border-color: var(--navy-light);
        }

        .consent-body .form-check-input:focus-visible {
            outline: none;
            box-shadow: 0 0 0 3px rgba(14, 87, 173, 0.22);
        }

        .consent-body .form-check-input:checked {
            background-color: var(--navy);
            border-color: var(--navy);
            box-shadow: 0 2px 6px rgba(13, 74, 148, 0.28);
        }

            .consent-body .form-check-input:checked::after {
                content: "";
                position: absolute;
                left: 0.36rem;
                top: 0.16rem;
                width: 0.32rem;
                height: 0.62rem;
                border: solid #ffffff;
                border-width: 0 2px 2px 0;
                transform: rotate(40deg);
            }

    .consent-body .form-check-label {
        color: var(--ink);
        font-size: 0.87rem;
        font-weight: 500;
        cursor: pointer;
        transition: color 0.15s ease;
    }

    .consent-body .form-check-input:checked + .form-check-label {
        color: var(--navy);
        font-weight: 600;
    }

    .consent-body .pdf-action {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        width: 100%;
        background: linear-gradient(120deg, var(--navy-deep) 0%, var(--navy) 50%, var(--navy-light) 100%);
        border: 1px solid var(--navy-deep);
        border-radius: 8px;
        box-shadow: 0 8px 18px rgba(13, 74, 148, 0.28);
        color: #fff;
        font-size: 0.88rem;
        font-weight: 700;
        padding: 0.75rem 1.05rem;
        margin-top: 1.1rem;
        cursor: pointer;
        transition: filter 0.15s ease, opacity 0.15s ease;
    }

        .consent-body .pdf-action:hover:not(:disabled) {
            filter: brightness(1.08);
        }

        .consent-body .pdf-action:disabled {
            background: #c3cdd6;
            border-color: #c3cdd6;
            box-shadow: none;
            cursor: not-allowed;
            opacity: 0.85;
        }

    .consent-body .pdf-hint {
        color: var(--muted);
        font-size: 0.74rem;
        text-align: center;
        margin-top: 0.55rem;
    }

    .reupload-highlight {
        background: linear-gradient(135deg, #fffaf0 0%, #fff4d6 100%);
        border: 1px solid #e7c86d;
        border-left: 5px solid var(--gold);
        border-radius: 12px;
        box-shadow: 0 10px 26px rgba(134, 95, 14, 0.08);
        margin: 0 0 1.25rem;
        overflow: hidden;
    }

    .reupload-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        background: linear-gradient(90deg, rgba(18, 58, 91, 0.08), rgba(200, 155, 60, 0.14));
        border-bottom: 1px solid rgba(200, 155, 60, 0.35);
        color: var(--navy-deep);
        font-size: 0.9rem;
        font-weight: 800;
        letter-spacing: 0.03em;
        padding: 0.8rem 1rem;
        text-transform: uppercase;
    }

        .reupload-header i {
            color: var(--gold-ink);
            font-size: 1rem;
        }

    .reupload-body {
        padding: 1rem 1rem 1.1rem;
    }

        .reupload-body p {
            color: var(--ink);
            font-size: 0.92rem;
            font-weight: 600;
            margin: 0 0 0.9rem;
        }

    .reupload-form {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        flex-wrap: wrap;
    }

        .reupload-form .form-control {
            flex: 1 1 320px;
            min-width: 220px;
            border-color: #d7b861;
            background: rgba(255, 255, 255, 0.8);
        }

            .reupload-form .form-control:focus {
                border-color: var(--navy-light);
                box-shadow: 0 0 0 0.2rem rgba(37, 124, 157, 0.18);
            }

    .reupload-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--gold-soft), var(--gold));
        border: 1px solid #c99828;
        border-radius: 8px;
        color: var(--navy-deep);
        font-weight: 800;
        padding: 0.68rem 1rem;
        box-shadow: 0 8px 18px rgba(134, 95, 14, 0.16);
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

        .reupload-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(134, 95, 14, 0.2);
        }

    /* ========================= */
    /* FOOTER ACTIONS */
    /* ========================= */
    .page-actions {
        margin-top: 1.25rem;
    }

        .page-actions .btn-secondary {
            background: var(--surface);
            border: 1px solid var(--navy);
            color: var(--navy);
            font-weight: 600;
            font-size: 0.85rem;
            padding: 0.55rem 1.35rem;
            border-radius: 8px;
            transition: all 0.15s ease;
        }

            .page-actions .btn-secondary:hover {
                background: var(--navy);
                color: #fff;
            }

    /* ========================= */
    /* TAB PREVIEW MODAL */
    /* ========================= */
    .preview-modal .modal-dialog {
        max-width: 1120px;
    }

    .preview-modal .modal-content {
        border: 0;
        border-radius: 12px;
        overflow: hidden;
    }

    .preview-modal .modal-header {
        background: linear-gradient(120deg, var(--navy-deep) 0%, var(--navy) 50%, var(--navy-light) 100%);
        border-bottom: 3px solid var(--gold-soft);
        color: #fff;
        padding: 0.8rem 1.1rem;
    }

    .preview-modal .modal-title {
        font-family: var(--font-serif);
        font-size: 1rem;
        font-weight: 600;
    }

    .preview-modal .btn-close {
        filter: invert(1);
    }

    .preview-modal .modal-body {
        background: var(--paper);
        height: min(74vh, 760px);
        padding: 0;
    }

        .preview-modal .modal-body.is-loading {
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .preview-modal .modal-body.is-loading::after {
                content: "Loading preview…";
                color: var(--navy);
                font-size: 0.85rem;
                font-weight: 600;
            }

    .preview-modal iframe {
        background: #fff;
        border: 0;
        height: 100%;
        width: 100%;
    }

    .preview-modal .modal-footer {
        background: #fff;
        border-top: 1px solid var(--border);
        padding: 0.65rem 1rem;
    }

        .preview-modal .modal-footer a {
            background: var(--navy);
            border-radius: 6px;
            color: #fff;
            font-size: 0.76rem;
            font-weight: 600;
            padding: 0.45rem 0.85rem;
            text-decoration: none;
        }

            .preview-modal .modal-footer a:hover {
                background: var(--navy-light);
            }

    /* ========================= */
    /* RESPONSIVE */
    /* ========================= */
    @@media (max-width: 992px) {
        .preview-tab-directory {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .affiliation-meta {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 900px) {
        .affiliation-header-top {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.9rem;
        }

        .submit-application-btn {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 640px) {
        .preview-tab-directory {
            grid-template-columns: 1fr;
        }

        .affiliation-meta {
            grid-template-columns: 1fr;
        }

        .affiliation-header-wrapper {
            padding: 1.4rem 1.25rem;
        }

        .data-table th, .data-table td {
            font-size: 0.82rem;
            padding: 0.5rem 0.6rem;
        }
    }
</style>

<div id="PreviewTop" class="affiliation-page-container @(applicationReadOnly ? "application-readonly" : string.Empty)">
    <div class="container-fluid">

        <!-- ========================= -->
        <!-- OFFICIAL HEADER -->
        <!-- ========================= -->
        <div class="affiliation-header-wrapper">
            <div class="affiliation-header-content">
                <div class="affiliation-header-top">
                    <div class="affiliation-header-primary">
                        <div class="affiliation-badge">
                            <i class="bi bi-patch-check-fill"></i>
                            Continuous Affiliation &middot; Application Preview
                        </div>
                        <h1 class="affiliation-title">
                            @(Model.InstitutionDetails != null && !string.IsNullOrWhiteSpace(Model.InstitutionDetails.NameOfInstitution)
                                ? Model.InstitutionDetails.NameOfInstitution
                                : "College Affiliation Preview")
                        </h1>
                        <div class="affiliation-subtitle">Read-only summary generated from your submitted application. Edit any section from the directory below before final submission.</div>
                    </div>
                    <div class="affiliation-header-actions">
                        @if (applicationReadOnly)
                        {
                            <a class="readonly-status" href="@Url.Action("SubmitApplication", "CAPreview")" target="_blank" rel="noopener">
                                <i class="bi bi-file-earmark-pdf-fill"></i> View / Download Final PDF
                            </a>
                        }
                        else if (Model.IsApplicationComplete && Model.CompletionPercentage >= 100)
                        {
                            <button type="button" class="submit-application-btn" data-bs-toggle="modal" data-bs-target="#consentModal" title="Submit application">
                                <i class="bi bi-send-check-fill"></i>
                                Submit Application
                            </button>
                        }
                    </div>
                </div>
                <div class="affiliation-meta">
                    <div class="meta-item">
                        <div class="meta-label">Course Level</div>
                        <div class="meta-value">@courseLevelLabel</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Institution Type</div>
                        <div class="meta-value">@(Model.InstitutionDetails != null && !string.IsNullOrWhiteSpace(Model.InstitutionDetails.TypeOfInstitution) ? Model.InstitutionDetails.TypeOfInstitution : "—")</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">District</div>
                        <div class="meta-value">@(Model.InstitutionDetails != null && !string.IsNullOrWhiteSpace(Model.InstitutionDetails.District) ? Model.InstitutionDetails.District : "—")</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Preview Generated</div>
                        <div class="meta-value">@DateTime.Now.ToString("dd MMM yyyy")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================================================================ -->
        <!-- PRINCIPAL SEAL & SIGNATURE RE-UPLOAD                              -->
        <!-- Always rendered and always enabled (before AND after submission). -->
        <!-- ================================================================ -->
        <div class="reupload-highlight" id="SealReupload">
            <div class="reupload-header">
                <i class="bi bi-file-earmark-arrow-up-fill"></i>
                Principal Seal &amp; Signature Re-upload
            </div>
            <div class="reupload-body">
                <p>Please re-upload the complete application after obtaining the Principal’s seal and signature.</p>
                @if (Model.HasSealedSignedReupload)
                {
                    <a asp-controller="CAPreview" asp-action="ViewSignedReupload" target="_blank" rel="noopener" class="btn btn-outline-primary mb-3">
                        <i class="bi bi-eye"></i> View Uploaded Document
                    </a>
                }
                @if (TempData["PreviewError"] != null)
                {
                    <div class="alert alert-danger" role="alert">@TempData["PreviewError"]</div>
                }
                @if (TempData["PreviewSuccess"] != null)
                {
                    <div class="alert alert-success" role="status">@TempData["PreviewSuccess"]</div>
                }
                <form asp-controller="CAPreview" asp-action="ReuploadSignedDocument" method="post" enctype="multipart/form-data" class="reupload-form">
                    @Html.AntiForgeryToken()
                    <input type="file" class="form-control" name="sealedSignedReupload" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                    <button type="submit" class="reupload-btn">
                        <i class="bi bi-upload"></i> Upload sealed &amp; Signed copy
                    </button>
                </form>
            </div>
        </div>

        <!-- ========================= -->
        <!-- BREADCRUMB NAVIGATION -->
        <!-- ========================= -->
        <div class="breadcrumb-wrapper">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-custom">
                    <li class="breadcrumb-item">
                        <i class="bi bi-house-door me-1"></i>
                        <a href="#" class="text-decoration-none">Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="#" class="text-decoration-none">College Affiliation</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Preview
                    </li>
                </ol>
            </nav>
        </div>

        <!-- ========================= -->
        <!-- INFO ALERT -->
        <!-- ========================= -->
        <div class="info-alert">
            <i class="bi bi-info-circle-fill"></i>
            <div class="info-alert-content">
                <div class="info-alert-title">Review Your Information</div>
                <p class="info-alert-text">
                    This is a preview of your college details. Please review all sections carefully.
                    Use the edit buttons within each section to make any necessary changes.
                </p>
            </div>
        </div>

        <!-- ========================= -->
        <!-- ORDERED TAB DIRECTORY -->
        <!-- ========================= -->
