                                                        <td class="@(apCol == pgAcademicTable.Rows[apRow].Count - 1 && apCell.Length > 40 ? "wrap" : "")">@apCell</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (Model.FacultyDesigNonTeachDisplayVM != null)
                {
                    <div id="FacultyDetails" class="preview-report-section">
                        <h2 class="preview-report-heading"><span>22 · Faculty Details</span><a class="preview-report-edit" href="@Url.Action("Repo_FacultyDetails", "FacultyDetails")"><i class="bi bi-pencil-square me-1"></i>Edit</a></h2>
                        <div class="preview-report-body"><partial name="FacultyDesigNonTeaching/_FacultyDetails" model="Model.FacultyDesigNonTeachDisplayVM.FacultyDetailDisplayVM" /></div>
                    </div>
                    <div id="NonTeachingStaffDetails" class="preview-report-section">
                        <h2 class="preview-report-heading"><span>23 · Non-Teaching Staff Details</span><a class="preview-report-edit" href="@Url.Action("NonTeachingStaffDepartmentwise", "ContinuesAffiliation_Facultybased")"><i class="bi bi-pencil-square me-1"></i>Edit</a></h2>
                        <div class="preview-report-body"><partial name="FacultyDesigNonTeaching/_NonTeachingStaffDetails" model="Model.FacultyDesigNonTeachDisplayVM.NonTeachingStaffSectionVM" /></div>
                    </div>
                }

                @if (Model.LibraryDisplay != null)
                {
                    <div id="ResearchLibrary" class="preview-report-section">
                        <h2 class="preview-report-heading">
                            <span>24 · Research &amp; Library</span>
                            <span class="d-flex gap-2" style="flex:none">
                                <a class="preview-report-edit" href="@Url.Action("MedicalLibrary", "CA_Aff_MedicalLibrary")"><i class="bi bi-pencil-square me-1"></i>Edit Library</a>
                                <a class="preview-report-edit" href="@Url.Action("CA_Med_ResearchPublicationsDetails", "CA_Med_ResearchPublications")"><i class="bi bi-pencil-square me-1"></i>Edit Research</a>
                            </span>
                        </h2>
                        <div class="preview-report-body">@await Html.PartialAsync("Library/LibraryPreview", Model.LibraryDisplay)</div>
                    </div>
                }

                @if (Model.PaymentVM != null || Model.PaymentCalculation?.HasResult == true)
                {
                    <div id="PaymentCalculation" class="preview-report-section">
                        <h2 class="preview-report-heading">
                            <span>25 · Payment Calculation</span>
                            @if (Model.IsApplicationComplete)
                            {
                                <a class="preview-report-edit" href="@Url.Action("Index", "PaymentCalculation")"><i class="bi bi-pencil-square me-1"></i>Edit</a>
                            }
                        </h2>
                        <div class="preview-report-body">
                            @if (Model.PaymentCalculation?.HasResult == true)
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm data-table wide align-middle mb-0">
                                        <thead>
                                            <tr><th>Fee Head</th><th class="text-end">Unit Amount</th><th class="text-end">Quantity</th><th class="text-end">Amount</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var fee in Model.PaymentCalculation.FeeLines)
                                            {
                                                <tr><td>@fee.FeeHeadName</td><td class="text-end">₹ @fee.UnitAmount.ToString("N2")</td><td class="text-end">@fee.Multiplier</td><td class="text-end">₹ @fee.LineAmount.ToString("N2")</td></tr>
                                            }
                                            <tr class="fw-bold"><td colspan="3">Grand Total</td><td class="text-end">₹ @Model.PaymentCalculation.Summary?.GrandTotal.ToString("N2")</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else if (Model.IsApplicationComplete && Model.PaymentVM != null)
                            {
                                @await Html.PartialAsync("PaymentDetails/paymentDetails", Model.PaymentVM)
                            }
                            else
                            {
                                <div class="alert alert-secondary mb-0">
                                    Payment is available after the application reaches 100% completion. Current completion: <strong>@Model.CompletionPercentage%</strong>.
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* <div class="page-actions d-flex justify-content-start align-items-center">
            <a href="@Url.Action("Payment", "AffiliationPayment")" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Previous</a>
        </div> *@
    </div>
</div>

<!-- ============ CONSENT MODAL ============ -->
<div class="modal fade consent-modal" id="consentModal" tabindex="-1" aria-labelledby="consentModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="consent-modal-eyebrow"><i class="bi bi-bank2"></i> RGUHS · Continuous Affiliation</div>
                    <h2 class="modal-title" id="consentModalTitle">Declaration and consent</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body consent-body">
                @{
                    var declPrincipal = Model.InstitutionDetails != null && !string.IsNullOrWhiteSpace(Model.InstitutionDetails.Principal_Name)
                        ? Model.InstitutionDetails.Principal_Name
                        : "the Principal";
                    var declInstitution = Model.InstitutionDetails != null && !string.IsNullOrWhiteSpace(Model.InstitutionDetails.NameOfInstitution)
                        ? Model.InstitutionDetails.NameOfInstitution
                        : "this institution";
                }
                <p>
                    I, <strong>@declPrincipal</strong>, Principal of <strong>@declInstitution</strong>, hereby solemnly declare and undertake
                    that all documents, particulars, statements, declarations and information furnished or uploaded by the College in this
                    application are true, complete, accurate and correct to the best of my knowledge and belief.
                </p>
                <p>
                    I further undertake that no material information has been concealed, suppressed or misrepresented in this application.
                    I understand that any false, misleading, fabricated, incomplete or incorrect information or documentation furnished by
                    the College may result in rejection or cancellation of the application, withdrawal of affiliation/approval, or such other
                    action as may be taken by Rajiv Gandhi University of Health Sciences, Karnataka (RGUHS) in accordance with the applicable
                    rules, regulations, ordinances and notifications.
                </p>
                <div class="preview-caution">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span><strong>Before you proceed:</strong> close this dialog and scroll through every section of the preview, then return here, tick the consent box and click Submit. Consent is mandatory.</span>
                </div>
                @if (TempData["PreviewError"] != null)
                {
                    <div class="alert alert-danger">@TempData["PreviewError"]</div>
                }

                <form id="consentForm" asp-controller="CAPreview" asp-action="SubmitApplication" method="post" target="_blank">
                    @Html.AntiForgeryToken()
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="declarationConsent" name="declarationConsent" value="true" />
                        <label class="form-check-label" for="declarationConsent">I confirm and consent to submit the affiliation application.</label>
                    </div>
                    <button type="submit" id="generatePreviewPdf" class="pdf-action" disabled>
                        <i class="bi bi-send-check-fill"></i> Submit application
                    </button>
                    <div class="pdf-hint">Tick the consent box to enable this button.</div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        /* 1. Wrap bare tables so they scroll horizontally; mark header-less tables as key/value */
        document.querySelectorAll('.preview-report-body table').forEach(function (t) {
            if (!t.closest('.table-responsive, .scroll-x')) {
                var wrap = document.createElement('div');
                wrap.className = 'scroll-x';
                t.parentNode.insertBefore(wrap, t);
                wrap.appendChild(t);
            }
            t.classList.add('data-table');
            if (t.querySelectorAll('thead th').length > 5) t.classList.add('wide');
            if (!t.querySelector('thead')) t.classList.add('kv');
        });

        /* 2. Collapsible sections: click the heading (not its Edit links) */
        var sections = Array.prototype.slice.call(document.querySelectorAll('.preview-report-section'));
        sections.forEach(function (sec) {
            var head = sec.querySelector('.preview-report-heading');
            var label = head && head.querySelector('span');
            if (!head || !label) return;
            var parts = label.textContent.split('\u00b7');
            if (parts.length > 1) {
                var badge = document.createElement('span');
                badge.className = 'pv-no';
                badge.textContent = parts[0].trim();
                var text = document.createElement('span');
                text.textContent = parts.slice(1).join('\u00b7').trim();
                label.textContent = '';
                label.appendChild(badge);
                label.appendChild(text);
            }
            var chev = document.createElement('i');
            chev.className = 'bi bi-chevron-down pv-chev';
            head.appendChild(chev);
            head.setAttribute('role', 'button');
            head.setAttribute('tabindex', '0');
            var toggle = function () {
                var c = sec.classList.toggle('collapsed');
                head.setAttribute('aria-expanded', c ? 'false' : 'true');
            };
            head.setAttribute('aria-expanded', 'true');
            head.addEventListener('click', function (e) { if (!e.target.closest('a')) toggle(); });
            head.addEventListener('keydown', function (e) {
                if ((e.key === 'Enter' || e.key === ' ') && !e.target.closest('a')) { e.preventDefault(); toggle(); }
            });
        });
        var setAll = function (collapse) {
            sections.forEach(function (sec) {
                sec.classList.toggle('collapsed', collapse);
                var h = sec.querySelector('.preview-report-heading');
                if (h) h.setAttribute('aria-expanded', collapse ? 'false' : 'true');
            });
        };
        var ex = document.getElementById('pvExpandAll'), co = document.getElementById('pvCollapseAll');
        if (ex) ex.addEventListener('click', function () { setAll(false); });
        if (co) co.addEventListener('click', function () { setAll(true); });

        /* 4. Consent modal */
        var consent = document.getElementById('declarationConsent');
        var pdfAction = document.getElementById('generatePreviewPdf');
        if (consent && pdfAction) {
            consent.addEventListener('change', function () { pdfAction.disabled = !consent.checked; });
        }
        var consentEl = document.getElementById('consentModal');
        var consentModal = consentEl && typeof bootstrap !== 'undefined' ? bootstrap.Modal.getOrCreateInstance(consentEl) : null;
        if (consentEl) {
            consentEl.addEventListener('hidden.bs.modal', function () {
                if (consent) consent.checked = false;
                if (pdfAction) pdfAction.disabled = true;
            });
        }
        @if (TempData["PreviewError"] != null)
        {
                        <text>if (consentModal) { consentModal.show(); }</text>
        }
    });
</script>

<script>
    // Keep the Principal seal & signature re-upload visible and enabled before AND after submission.
    (function () {
        function force(el, display) {
            if (!el) return;
            el.hidden = false;
            el.removeAttribute('hidden');
            el.removeAttribute('disabled');
            el.removeAttribute('readonly');
            el.removeAttribute('aria-disabled');
            if ('disabled' in el) el.disabled = false;
            el.style.setProperty('display', display, 'important');
            el.style.setProperty('visibility', 'visible', 'important');
            el.style.setProperty('opacity', '1', 'important');
            el.style.setProperty('pointer-events', 'auto', 'important');
        }
        function keepReuploadAvailable() {
            var section = document.getElementById('SealReupload');
            if (!section) return;
            force(section, 'block');
            force(section.querySelector('.reupload-body'), 'block');
            force(section.querySelector('.reupload-form'), 'flex');
            force(section.querySelector('input[type="file"]'), 'block');
            force(section.querySelector('.reupload-btn'), 'inline-flex');
        }
        document.addEventListener('DOMContentLoaded', function () {
            keepReuploadAvailable();
            var section = document.getElementById('SealReupload');
            if (!section) return;
            var options = { subtree: true, attributes: true, attributeFilter: ['style', 'class', 'hidden', 'disabled', 'readonly', 'aria-disabled'] };
            var observer = new MutationObserver(function () {
                observer.disconnect();
                keepReuploadAvailable();
                observer.observe(section, options);
            });
            observer.observe(section, options);
        });
        window.addEventListener('pageshow', keepReuploadAvailable);
        window.addEventListener('load', keepReuploadAvailable);
    })();
</script>
