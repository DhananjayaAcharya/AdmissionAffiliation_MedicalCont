@model Medical_Affiliation.Models.DisciplineDisplayVM

<div class="general-body">

    <div class="section-block mt-4">

        <!-- Header -->
        <div class="section-header-block mb-3">
            <div class="section-title-text section-badge">
                <i class="bi bi-diagram-3"></i>
                Discipline Details
            </div>

            <p class="section-description">
                Selected disciplines available for the affiliated teaching hospital.
            </p>
        </div>

        <div class="data-table-wrapper">

            <table class="table data-table align-middle">

                <thead>
                    <tr>
                        <th style="width:70%">Discipline</th>
                        <th class="text-center" style="width:30%">Selected</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Disciplines.Any())
                    {
                        <tr>
                            <td>
                                <strong>Seat Slab</strong>
                            </td>
                            <td class="text-center">
                                <strong>@Model.SeatSlab</strong>
                            </td>
                        </tr>

                        @foreach (var item in Model.Disciplines)
                        {
                            <tr>
                                <td>@item.DisciplineName</td>

                                <td class="text-center">
                                    @if (item.IsSelected)
                                    {
                                        <span class="status-badge-maintained" title="Selected">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge-not-maintained" title="Not Selected">
                                            <i class="bi bi-x-circle-fill"></i>
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center text-muted">
                                No discipline details available.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>