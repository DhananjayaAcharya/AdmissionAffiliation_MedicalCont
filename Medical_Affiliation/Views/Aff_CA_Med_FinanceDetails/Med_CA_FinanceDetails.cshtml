<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

    /* ===============================
    1. TOTAL FEE CALCULATION (PER SECTION)
    =============================== */
    document.querySelectorAll(".accordion-item").forEach(section => {

    const inputs = section.querySelectorAll(".fee-input");

    const calc = () => {
    let total = 0;

    inputs.forEach(i => {
    total += parseFloat(i.value) || 0;
    });

    const display = section.querySelector(".totalFeeDisplay");
    const hidden = section.querySelector(".totalFeeHidden");

    if (display) display.value = total.toFixed(2);
    if (hidden) hidden.value = total.toFixed(2);
    };

    inputs.forEach(i => i.addEventListener("input", calc));

    calc(); // initial load
    });


    /* ===============================
    2. COPY FROM UG FUNCTIONALITY
    =============================== */
    document.querySelectorAll(".copyFromUG").forEach(cb => {

    cb.addEventListener("change", function () {

    const index = this.dataset.index;

    // 🔥 FIND UG INDEX DYNAMICALLY
    let ugIndex = -1;

    document.querySelectorAll("input[name$='.CourseLevel']").forEach((el, i) => {
    if (el.value.trim().toUpperCase() === "UG") {
    ugIndex = i;
    }
    });

    if (ugIndex === -1) {
    console.warn("UG section not found");
    return;
    }

    if (this.checked) {

    const fields = [
    "AuthorityNameAddress",
    "AuthorityContact",
    "RecurrentAnnual",
    "NonRecurrentAnnual",
    "Deposits",
    "TuitionFee",
    "SportsFee",
    "UnionFee",
    "LibraryFee",
    "OtherFee"
    ];

    fields.forEach(field => {

    const ugField = document.querySelector(`[name="Sections[${ugIndex}].${field}"]`);
    const targetField = document.querySelector(`[name="Sections[${index}].${field}"]`);

    if (ugField && targetField) {
    targetField.value = ugField.value;
    }
    });
    }
    });
    });


    /* ===============================
    3. FILE VALIDATION (PDF + SIZE)
    =============================== */
    document.addEventListener("change", function (e) {

    if (e.target.classList.contains("pdf-file")) {

    const file = e.target.files[0];
    const maxSize = 2 * 1024 * 1024; // 2MB

    if (!file) return;

    // SIZE CHECK
    if (file.size > maxSize) {
    Swal.fire({
    icon: "error",
    title: "File too large",
    text: "Maximum allowed size is 2MB"
    });

    e.target.value = "";
    return;
    }

    // TYPE CHECK
    const ext = file.name.split('.').pop().toLowerCase();

    if (ext !== "pdf") {
    Swal.fire({
    icon: "error",
    title: "Invalid file",
    text: "Only PDF files are allowed"
    });

    e.target.value = "";
    return;
    }
    }
    });


    /* ===============================
    4. CONDITIONAL SECTIONS (OPTIONAL SAFE HANDLING)
    =============================== */
    document.querySelectorAll("select").forEach(select => {

    select.addEventListener("change", function () {

    const section = this.closest(".accordion-item");

    // Account Books
    if (this.name.includes("AccountBooksMaintained")) {
    const div = section.querySelector(".AccountBooksPdfDiv");
    if (div) div.style.display = this.value === "Y" ? "block" : "none";
    }

    // Accounts Audited
    if (this.name.includes("AccountsAudited")) {
    const div = section.querySelector(".AuditedPdfDiv");
    if (div) div.style.display = this.value === "Y" ? "block" : "none";
    }

    // Donation (PG)
    if (this.name.includes("DonationLevied")) {
    const div = section.querySelector(".DonationPdfDiv");
    if (div) div.style.display = this.value === "Y" ? "block" : "none";
    }
    });
    });

    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        /* =========================================================
           ADDITIONAL FEE
           ========================================================= */

        // College and Faculty codes from session (for dynamic row creation)
        const collegeCode = "@collegeCode";
        const facultyCode = "@facultyCode";
        const courseLevel = '@courseLevel';


        const feeYes = document.getElementById("feeYes");
        const feeNo = document.getElementById("feeNo");

        const additionalFeeDetails = document.getElementById("additionalFeeDetails");

        const coursesOfferedDetails = document.getElementById("coursesOfferedDetails");

        const addFeeButton = document.getElementById("addFeeButton");

        const feeRows = document.getElementById("additionalFeeRows");

        const feeEmptyMessage = document.getElementById("noAdditionalFeeRows");


        /* ---------------------------------------------------------
           SHOW / HIDE ADDITIONAL FEE DETAILS
           --------------------------------------------------------- */

        function toggleAdditionalFee() {

            if (!additionalFeeDetails) {
                return;
            }

            if (feeYes && feeYes.checked) {

                additionalFeeDetails.style.display = "block";
                coursesOfferedDetails.style.display = "block";

            } else {

                additionalFeeDetails.style.display = "none";
                coursesOfferedDetails.style.display = "none";
            }

            updateFeeEmptyMessage();
        }


        if (feeYes) {
            feeYes.addEventListener("change", function () {
                toggleAdditionalFee();
            });
        }

        if (feeNo) {
            feeNo.addEventListener("change", function () {
                toggleAdditionalFee();
            });
        }


        /* ---------------------------------------------------------
           ADD ADDITIONAL FEE ROW
           --------------------------------------------------------- */


        if (addFeeButton) {

            addFeeButton.addEventListener("click", function () {

                if (!feeRows) {
                    console.error("additionalFeeRows not found.");
                    return;
                }


                const index = feeRows.querySelectorAll("tr").length;

                const row = document.createElement("tr");


                row.innerHTML = `

                    <input type="hidden"
                            name="DonationFees[${index}].Id"
                            value="0" />

                    <input type="hidden"
                            name="DonationFees[${index}].CollegeCode"
                            value="${collegeCode}" />

                    <input type="hidden"
                            name="DonationFees[${index}].FacultyCode"
                            value="${facultyCode}" />

                    <input type="hidden"
                            name="DonationFees[${index}].CourseLevel"
                            value="${courseLevel}" />

                    <td>
                        <select class="form-select fee-type"
                                name="DonationFees[${index}].FeeType">

                            <option value="">
                                -- Select Fee Type --
                            </option>

                            <option value="Donation">
                                Donation
                            </option>

                            <option value="Capitation Fee">
                                Capitation Fee
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                        <span class="text-danger fee-type-error"></span>

                    </td>


                    <td>

                        <input type="number"
                               step="0.01"
                               min="0"
                               class="form-control fee-amount"
                               name="DonationFees[${index}].FeeAmount"
                               placeholder="Enter amount" />

                    </td>


                    <td class="text-center">

                        <button type="button"
                                class="btn-remove-fee remove-fee-row"
                                title="Remove">

                            <i class="fas fa-trash"></i>

                        </button>

                    </td>

                `;


                feeRows.appendChild(row);

                updateFeeEmptyMessage();

                updateFeeTypeOptions();

            });
        }


        /* ---------------------------------------------------------
           REMOVE ADDITIONAL FEE
           --------------------------------------------------------- */

        if (feeRows) {

            feeRows.addEventListener("click", async function (e) {

                const button =
                    e.target.closest(".remove-fee-row");

                if (!button) {
                    return;
                }

                const row =
                    button.closest("tr");

                if (!row) {
                    return;
                }


                // =====================================================
                // GET ID
                // =====================================================

                const idInput =
                    row.querySelector(
                        'input[name$=".Id"]'
                    );

                const id =
                    idInput
                        ? parseInt(idInput.value || "0")
                        : 0;


                // =====================================================
                // NEW UI ROW
                // Id = 0
                // Just remove from UI
                // =====================================================

                if (!id || id === 0) {

                    row.remove();

                    reindexAdditionalFees();

                    updateFeeEmptyMessage();

                    return;
                }


                // =====================================================
                // EXISTING DATABASE RECORD
                // Id > 0
                // Delete through backend
                // =====================================================

                if (!confirm(
                    "Are you sure you want to delete this fee?"
                )) {
                    return;
                }


                try {

                    const token =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        )?.value;


                    const response = await fetch(
                        '@Url.Action("DeleteAdditionalFee", "Aff_CA_Med_FinanceDetails")',
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/x-www-form-urlencoded; charset=UTF-8"
                            },

                            body:
                                `id=${encodeURIComponent(id)}` +
                                `&__RequestVerificationToken=${encodeURIComponent(token)}`
                        }
                    );


                    const result =
                        await response.json();


                    if (result.success) {

                        // Remove from UI after successful DB deletion
                        row.remove();

                        reindexAdditionalFees();

                        updateFeeEmptyMessage();

                    }
                    else {

                        alert(
                            result.message ||
                            "Unable to delete fee."
                        );
                    }

                }
                catch (error) {

                    console.error(
                        "Delete additional fee error:",
                        error
                    );

                    alert(
                        "An error occurred while deleting the fee."
                    );
                }

            });
        }


        async function deleteExistingCourse(courseId, row) {

            try {

                const token =
                    document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    )?.value;


                const response =
                    await fetch(
                        '@Url.Action("DeleteCourseOffered", "Aff_CA_Med_FinanceDetails")',
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/x-www-form-urlencoded; charset=UTF-8"
                            },

                            body:
                                `id=${encodeURIComponent(courseId)}` +
                                `&__RequestVerificationToken=${encodeURIComponent(token)}`
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "Failed to delete course."
                    );
                }


                const result =
                    await response.json();


                if (result.success) {

                    /*
                       Backend soft delete succeeded.
                       Now remove it from UI.
                    */

                    if (row) {
                        row.remove();
                    }


                    reindexCourses();

                    updateCourseEmptyMessage();
                    updateAddCourseButton();
                    updateAllCourseLevelOptions();

                }
                else {

                    alert(
                        result.message ||
                        "Unable to remove course."
                    );
                }

            }
            catch (error) {

                console.error(
                    "Delete course error:",
                    error
                );

                alert(
                    "Unable to remove the course. Please try again."
                );
            }
        }

        /* ---------------------------------------------------------
           REINDEX ADDITIONAL FEES
           --------------------------------------------------------- */

        function reindexAdditionalFees() {

            if (!feeRows) {
                return;
            }

            const rows = feeRows.querySelectorAll("tr");


            rows.forEach(function (row, index) {

                row.querySelectorAll(
                    "input[name], select[name], textarea[name]"
                ).forEach(function (input) {

                    const name = input.getAttribute("name");

                    if (!name) {
                        return;
                    }

                    input.setAttribute( "name", name.replace( /DonationFees\[\d+\]/, `DonationFees[${index}]`));
                });
            });
        }


        /* ---------------------------------------------------------
           EMPTY FEE MESSAGE
           --------------------------------------------------------- */

        function updateFeeEmptyMessage() {

            if (!feeRows || !feeEmptyMessage) {
                return;
            }

            const hasRows = feeRows.querySelectorAll("tr").length > 0;


            feeEmptyMessage.style.display = hasRows ? "none" : "flex";
        }


        /* =========================================================
           COURSES OFFERED
           ========================================================= */

        const addCourseButton = document.getElementById("addCourseButton");

        const courseRows = document.getElementById("coursesOfferedRows");

        const courseEmptyMessage = document.getElementById("noCoursesMessage");


        /* ---------------------------------------------------------
           ADD COURSE
           --------------------------------------------------------- */

        if (addCourseButton) {

            addCourseButton.addEventListener("click", function () {

                if (!courseRows) {
                    console.error("coursesOfferedRows not found.");
                    return;
                }

                const index = courseRows.querySelectorAll("tr").length;

                const row = document.createElement("tr");

                row.innerHTML = `

                    <!-- Hidden fields -->

                    <input type="hidden"
                            name="CoursesOffered[${index}].Id"
                            value="0" />

                    <input type="hidden"
                            name="CoursesOffered[${index}].CollegeCode"
                            value="${collegeCode}" />

                    <input type="hidden"
                            name="CoursesOffered[${index}].FacultyCode"
                            value="${facultyCode}" />


                    <!-- COURSE LEVEL -->

                    <td>

                        <select class="form-select course-level-select"
                                disabled>

                            <option value="${courseLevel}" selected>
                                ${courseLevel}
                            </option>

                        </select>

                        <input type="hidden"
                                name="CoursesOffered[${index}].CourseLevel"
                                value="${courseLevel}" />

                    </td>


                    <!-- COURSE CODE -->

                    <td>

                        <select class="form-select course-code-select"
                                name="CoursesOffered[${index}].CourseCode">

                            <option value="">
                                -- Select Course --
                            </option>

                        </select>

                    </td>

                    <!-- STARTING YEAR -->

                    <td>

                        <input type="number"
                                class="form-control"
                                name="CoursesOffered[${index}].YearOfStarting"
                                min="1900"
                                max="2100"
                                placeholder="YYYY" />

                    </td>


                    <!-- SANCTIONED -->

                    <td>

                        <input type="number"
                                class="form-control"
                                name="CoursesOffered[${index}].SanctionedAdmissions"
                                min="0"
                                placeholder="0" />

                    </td>


                    <!-- ADMITTED -->

                    <td>

                        <input type="number"
                                class="form-control"
                                name="CoursesOffered[${index}].AdmittedAdmissions"
                                min="0"
                                placeholder="0" />

                    </td>


                    <!-- REMARKS -->

                    <td>

                        <textarea class="form-control"
                                    name="CoursesOffered[${index}].Remarks"
                                    rows="2"
                                    placeholder="Remarks"></textarea>

                    </td>


                    <!-- KARNATAKA GOVERNMENT -->

                    <td>

                        <input type="text"
                                class="form-control mb-2"
                                name="CoursesOffered[${index}].KarnatakaGovernmentPermissionNo"
                                placeholder="Permission No." />

                        <input type="file"
                                class="form-control"
                                name="CoursesOffered[${index}].KarnatakaGovernmentPermissionFile"
                                accept=".pdf" />

                    </td>


                    <!-- COUNCIL -->

                    <td>

                        <input type="text"
                                class="form-control mb-2"
                                name="CoursesOffered[${index}].CouncilPermissionNo"
                                placeholder="Permission No." />

                        <input type="file"
                                class="form-control"
                                name="CoursesOffered[${index}].CouncilPermissionFile"
                                accept=".pdf" />

                    </td>


                    <!-- RGUHS -->

                    <td>

                        <input type="text"
                                class="form-control mb-2"
                                name="CoursesOffered[${index}].RGUHSLastAffiliationNo"
                                placeholder="RGUHS Affiliation No." />

                        <input type="file"
                                class="form-control"
                                name="CoursesOffered[${index}].RGUHSLastAffiliationFile"
                                accept=".pdf" />

                    </td>


                    <!-- GOVERNMENT OF INDIA -->

                    <td>

                        <input type="text"
                                class="form-control mb-2"
                                name="CoursesOffered[${index}].GovernmentOfIndiaPermissionNo"
                                placeholder="Permission No." />

                        <input type="file"
                                class="form-control"
                                name="CoursesOffered[${index}].GovernmentOfIndiaPermissionFile"
                                accept=".pdf" />

                    </td>


                    <!-- DELETE -->

                    <td class="text-center">

                        <button type="button"
                                class="btn-remove-course remove-course-row"
                                title="Remove Course">

                            <i class="fas fa-trash"></i>

                        </button>

                    </td>

                `;

                courseRows.appendChild(row);

                // Setup level -> course loading
                setupCourseRow(row);
                updateAllCourseLevelOptions();
                updateCourseEmptyMessage();

            });

        }


        /* ---------------------------------------------------------
           REMOVE COURSE
           --------------------------------------------------------- */

        if (courseRows) {

            courseRows.addEventListener("click", async function (e) {

                const button =
                    e.target.closest(".remove-course-row");

                if (!button) {
                    return;
                }

                const row = button.closest("tr");

                if (!row) {
                    return;
                }

                const idInput =
                    row.querySelector(
                        'input[name$=".Id"]'
                    );

                const id =
                    idInput ? parseInt(idInput.value || "0") : 0;


                // =====================================================
                // NEW UI ROW
                // Id = 0
                // Just remove from UI
                // =====================================================

                if (!id || id === 0) {

                    row.remove();

                    reindexCourses();

                    updateCourseEmptyMessage();
                    updateAddCourseButton();

                    return;
                }


                // =====================================================
                // EXISTING DB RECORD
                // Id > 0
                // Delete through backend
                // =====================================================

                if (!confirm("Are you sure you want to delete this course?")) {
                    return;
                }


                try {

                    const token =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        )?.value;


                    const response = await fetch(
                        '@Url.Action("DeleteCourseOffered", "Aff_CA_Med_FinanceDetails")',
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/x-www-form-urlencoded; charset=UTF-8"
                            },

                            body:
                                `id=${encodeURIComponent(id)}` +
                                `&__RequestVerificationToken=${encodeURIComponent(token)}`
                        }
                    );


                    const result =
                        await response.json();


                    if (result.success) {

                        row.remove();

                        reindexCourses();

                        updateCourseEmptyMessage();

                    }
                    else {

                        alert(
                            result.message ||
                            "Unable to delete course."
                        );
                    }

                }
                catch (error) {

                    console.error(
                        "Delete course error:",
                        error
                    );

                    alert(
                        "An error occurred while deleting the course."
                    );
                }

            });
        }



        function updateAddCourseButton() {

            if (!addCourseButton || !courseRows) {
                return;
            }

            let ugExists = false;

            courseRows.querySelectorAll("tr").forEach(function (row) {

                const levelSelect =
                    row.querySelector(".course-level-select");

                if (!levelSelect) {
                    return;
                }

                const level =
                    levelSelect.value.trim().toUpperCase();

                if (level === "UG") {
                    ugExists = true;
                }
            });

            // Hide Add Course if UG already exists
            addCourseButton.style.display =
                ugExists ? "none" : "inline-block";
        }

        /* ---------------------------------------------------------
           REINDEX COURSES
           --------------------------------------------------------- */

        function reindexCourses() {

            if (!courseRows) {
                return;
            }
            const rows =  courseRows.querySelectorAll("tr");

            rows.forEach(function (row, index) {

                row.querySelectorAll(
                    "input[name], select[name], textarea[name]"
                ).forEach(function (input) {

                    const name = input.getAttribute("name");

                    if (!name) {
                        return;
                    }


                    input.setAttribute( "name", name.replace(/CoursesOffered\[\d+\]/, `CoursesOffered[${index}]` ));

                });

            });
        }


        /* ---------------------------------------------------------
           COURSE EMPTY MESSAGE
           --------------------------------------------------------- */

        function updateCourseEmptyMessage() {

            if (!courseRows || !courseEmptyMessage) {
                return;
            }


            const hasRows = courseRows.querySelectorAll("tr").length > 0;

            courseEmptyMessage.style.display = hasRows ? "none" : "flex";
        }


        /* =========================================================
           INITIALIZE
           ========================================================= */

        toggleAdditionalFee();

        updateFeeEmptyMessage();

        updateCourseEmptyMessage();
        updateAddCourseButton();

        updateFeeTypeOptions();


        /* =========================================================
            COURSE LEVEL -> COURSE LIST
            ========================================================= */

        async function loadCoursesByLevel(
            level,
            courseSelect,
            selectedCode = "",
            currentRow = null
        ) {

            if (!courseSelect) {
                return;
            }

            courseSelect.innerHTML = `
                <option value="">
                    Loading courses...
                </option>
            `;


            if (!level) {

                courseSelect.innerHTML = `
                    <option value="">
                        -- Select Course --
                    </option>
                `;

                return;
            }


            try {

                const url =
                    '@Url.Action("GetCoursesByLevel", "Aff_CA_Med_FinanceDetails")'
                    + '?courseLevel='
                    + encodeURIComponent(level);


                const response =
                    await fetch(url);


                if (!response.ok) {
                    throw new Error("Failed to load courses.");
                }


                const courses =
                    await response.json();


                courseSelect.innerHTML = `
                    <option value="">
                        -- Select Course --
                    </option>
                `;


                if (!courses || courses.length === 0) {

                    courseSelect.innerHTML = `
                        <option value="">
                            -- No courses available --
                        </option>
                    `;

                    return;
                }


                /*
                   Get courses already used in other rows
                */

                const usedCourseCodes =
                    getUsedCourseCodes(
                        level,
                        currentRow
                    );


                courses.forEach(function (course) {

                    const courseCode =
                        String(course.courseCode).trim();


                    /*
                       Don't hide the currently saved course
                       when editing an existing row.
                    */

                    const isCurrentSavedCourse =
                        selectedCode &&
                        courseCode ===
                        String(selectedCode).trim();


                    /*
                       If this course is already used
                       in another row, don't display it.
                    */

                    if (
                        usedCourseCodes.includes(courseCode) &&
                        !isCurrentSavedCourse
                    ) {
                        return;
                    }


                    const option =
                        document.createElement("option");


                    option.value =
                        courseCode;


                    option.textContent =
                        course.courseName;


                    if (
                        selectedCode &&
                        courseCode ===
                        String(selectedCode).trim()
                    ) {

                        option.selected = true;
                    }


                    courseSelect.appendChild(option);

                });


                /*
                   If everything has already been used
                */

                if (courseSelect.options.length === 1) {

                    courseSelect.innerHTML = `
                        <option value="">
                            -- All courses already added --
                        </option>
                    `;

                    return;
                }


                /*
                   Explicitly select saved course
                */

                if (selectedCode) {

                    const savedOption =
                        Array.from(
                            courseSelect.options
                        ).find(function (option) {

                            return String(option.value).trim()
                                === String(selectedCode).trim();

                        });


                    if (savedOption) {

                        courseSelect.value =
                            savedOption.value;
                    }
                }

            }
            catch (error) {

                console.error(
                    "Error loading courses:",
                    error
                );


                courseSelect.innerHTML = `
                    <option value="">
                        -- Unable to load courses --
                    </option>
                `;
            }
        }

        /* =========================================================
           SETUP COURSE ROW
           ========================================================= */

        function setupCourseRow(row) {

            if (!row) {
                return;
            }

            const courseSelect =
                row.querySelector(".course-code-select");

            if (!courseSelect) {
                return;
            }

            // CourseCode already saved in DB
            const selectedCode =
                courseSelect.dataset.selectedCode || "";

            console.log("Session Course Level:", courseLevel);
            console.log("Saved Course Code:", selectedCode);

            // Load courses dynamically
            loadCoursesByLevel(
                courseLevel,
                courseSelect,
                selectedCode,
                row
            );

            updateAddCourseButton();
        }

        /* =========================================================
           INITIALIZE EXISTING COURSE ROWS
        ========================================================= */

        if (courseRows) {

            courseRows
                .querySelectorAll("tr")
                .forEach(function (row) {
                    setupCourseRow(row); 
                });
        }

        /* =========================================================
           ADDITIONAL FEE TYPE - PREVENT DUPLICATE TYPES
           ========================================================= */

        function updateFeeTypeOptions() {

            if (!feeRows) {
                return;
            }

            const selects =
                feeRows.querySelectorAll(".fee-type");

            // Get all currently selected fee types
            const selectedTypes = [];

            selects.forEach(function (select) {

                const value = select.value;

                if (value) {
                    selectedTypes.push(value);
                }
            });

            // Update every dropdown
            selects.forEach(function (select) {

                const currentValue = select.value;

                select.querySelectorAll("option").forEach(function (option) {

                    // Always keep placeholder enabled
                    if (!option.value) {
                        option.disabled = false;
                        return;
                    }

                    // Don't disable the option selected in THIS row
                    if (option.value === currentValue) {
                        option.disabled = false;
                        return;
                    }

                    // Disable if selected in another row
                    option.disabled =
                        selectedTypes.includes(option.value);

                });

            });
        }

        if (feeRows) {

            feeRows.addEventListener("change", function (e) {

                if (e.target.classList.contains("fee-type")) {

                    updateFeeTypeOptions();

                }

            });
        }


        /* =========================================================
           GET USED COURSE CODES
           ========================================================= */

        function getUsedCourseCodes(level, excludeRow = null) {

            const usedCodes = [];

            if (!courseRows || !level) {
                return usedCodes;
            }

            const normalizedLevel =
                String(level).trim().toUpperCase();

            courseRows.querySelectorAll("tr").forEach(function (row) {

                // Don't consider the current row
                if (row === excludeRow) {
                    return;
                }

                const levelSelect =
                    row.querySelector(".course-level-select");

                const courseSelect =
                    row.querySelector(".course-code-select");

                if (!levelSelect || !courseSelect) {
                    return;
                }

                const rowLevel =
                    String(levelSelect.value)
                        .trim()
                        .toUpperCase();

                // Only check rows having the same level
                if (rowLevel !== normalizedLevel) {
                    return;
                }

                const code =
                    String(courseSelect.value || "").trim();

                if (code) {
                    usedCodes.push(code);
                }

            });

            return usedCodes;
        }

        courseSelect.addEventListener("change", function () {

            const selectedLevel = levelSelect.value;

            // Refresh other course dropdowns of the same level
            courseRows.querySelectorAll("tr").forEach(function (otherRow) {

                if (otherRow === row) {
                    return;
                }

                const otherLevel =
                    otherRow.querySelector(".course-level-select");

                const otherCourse =
                    otherRow.querySelector(".course-code-select");

                if (!otherLevel || !otherCourse) {
                    return;
                }

                if (
                    otherLevel.value.trim().toUpperCase() ===
                    selectedLevel.trim().toUpperCase()
                ) {

                    const currentValue =
                        otherCourse.value;

                    loadCoursesByLevel(
                        selectedLevel,
                        otherCourse,
                        currentValue,
                        otherRow
                    );
                }

            });

        });


        /* =========================================================
           CHECK WHETHER UG IS ALREADY USED
           ========================================================= */

        function isUGAlreadyUsed(excludeRow = null) {

            if (!courseRows) {
                return false;
            }

            return Array.from(
                courseRows.querySelectorAll("tr")
            ).some(function (row) {

                if (row === excludeRow) {
                    return false;
                }

                const levelSelect =
                    row.querySelector(".course-level-select");

                return levelSelect &&
                    levelSelect.value.trim().toUpperCase() === "UG";
            });
        }


        /* =========================================================
           UPDATE COURSE LEVEL OPTIONS
           ========================================================= */

        function updateCourseLevelOptions(levelSelect, currentRow = null) {

            if (!levelSelect) {
                return;
            }

            const ugUsed =
                isUGAlreadyUsed(currentRow);

            const currentValue =
                levelSelect.value;


            Array.from(levelSelect.options).forEach(function (option) {

                if (option.value === "UG") {

                    option.disabled = ugUsed;
                }

            });


            /*
               If this is a new row and UG is already used,
               don't allow UG to remain selected.
            */

            if (
                ugUsed &&
                currentValue === "UG"
            ) {

                levelSelect.value = "";
            }
        }


        function updateAllCourseLevelOptions() {

            if (!courseRows) {
                return;
            }

            courseRows
                .querySelectorAll(".course-level-select")
                .forEach(function (select) {

                    const row =
                        select.closest("tr");

                    updateCourseLevelOptions(
                        select,
                        row
                    );

                });
        }
    });
</script>@if (TempData["Info"] != null)
{
    <script>
        Swal.fire({ icon: 'success', title: 'Saved Successfully!', text: '@TempData["Info"]', timer: 5000, timerProgressBar: true });
    </script>
}
@if (TempData["Error"] != null)
{
    <script>
        Swal.fire({ icon: 'error', title: 'Validation Error', text: '@TempData["Error"]' });
    </script>
}