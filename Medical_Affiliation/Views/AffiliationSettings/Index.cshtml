@model Medical_Affiliation.Controllers.AffiliationSettingsController.SettingsPageVm
@{
    ViewData["Title"] = "Affiliation Settings";
    // Use the layout your admin pages use.
    Layout = "~/Views/Shared/_Layout.cshtml";

    var activeCount = Model.Colleges.Count(c => c.Status);
    var facultyCodes = Model.Colleges
        .Where(c => !string.IsNullOrWhiteSpace(c.FacultyCode))
        .Select(c => c.FacultyCode!)
        .Distinct()
        .OrderBy(x => x)
        .ToList();
}

<style>
    .settings-page {
        padding: .25rem 0 1.5rem;
    }

        .settings-page h1 {
            font-size: 1.6rem;
            color: #0f1d3d;
            margin-bottom: 1rem;
        }

        .settings-page .table th {
            font-size: .76rem;
            text-transform: uppercase;
            color: #435273;
            white-space: nowrap;
        }

        .settings-page .table td {
            vertical-align: middle;
        }

        .settings-page .new-row {
            background: #f4f8fd;
        }

        .settings-page .form-control-sm {
            min-width: 130px;
        }

        .settings-page .w-amount {
            min-width: 120px;
        }

        .settings-page .college-scroll {
            max-height: 65vh;
            overflow-y: auto;
        }

            .settings-page .college-scroll thead th {
                position: sticky;
                top: 0;
                z-index: 1;
            }
</style>

<div class="settings-page">
    <h1>Affiliation Settings</h1>
    @Html.AntiForgeryToken()

    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabSchedule" type="button">Course Level Schedule</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabColleges" type="button">College Status</button>
        </li>
    </ul>

    <div class="tab-content">

        @* ================= Schedule ================= *@
        <div class="tab-pane fade show active" id="tabSchedule">
            <div class="table-responsive">
                <table class="table table-bordered table-sm">
                    <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>Faculty Code</th>
                            <th>Course Level</th>
                            <th>Enabled</th>
                            <th>Start Date</th>
                            <th>Last Date (no fine)</th>
                            <th>Fine Last Date</th>
                            <th>Fine Amount</th>
                            <th>Updated On</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @* Add-new row *@
                        <tr class="new-row" data-id="0">
                            <td class="text-muted">New</td>
                            <td><input type="number" class="form-control form-control-sm f-faculty" min="1" /></td>
                            <td><input type="text" class="form-control form-control-sm f-level" placeholder="UG / PG / SS" /></td>
                            <td class="text-center"><input type="checkbox" class="form-check-input f-enabled" checked /></td>
                            <td><input type="date" class="form-control form-control-sm f-start" /></td>
                            <td><input type="date" class="form-control form-control-sm f-last" /></td>
                            <td><input type="date" class="form-control form-control-sm f-fine-last" /></td>
                            <td><input type="number" step="0.01" min="0" class="form-control form-control-sm w-amount f-amount" /></td>
                            <td></td>
                            <td><button type="button" class="btn btn-sm btn-success btn-save-schedule">Add</button></td>
                        </tr>

                        @foreach (var s in Model.Schedules)
                        {
                            <tr data-id="@s.Id">
                                <td>@s.Id</td>
                                <td><input type="number" class="form-control form-control-sm f-faculty" min="1" value="@s.FacultyCode" /></td>
                                <td><input type="text" class="form-control form-control-sm f-level" value="@s.CourseLevel" /></td>
                                <td class="text-center"><input type="checkbox" class="form-check-input f-enabled" @(s.IsEnabled ? "checked" : null) /></td>
                                <td><input type="date" class="form-control form-control-sm f-start" value="@s.StartDate?.ToString("yyyy-MM-dd")" /></td>
                                <td><input type="date" class="form-control form-control-sm f-last" value="@s.LastDate?.ToString("yyyy-MM-dd")" /></td>
                                <td><input type="date" class="form-control form-control-sm f-fine-last" value="@s.FineLastDate?.ToString("yyyy-MM-dd")" /></td>
                                <td><input type="number" step="0.01" min="0" class="form-control form-control-sm w-amount f-amount" value="@(s.FineAmount?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" /></td>
                                <td class="small text-muted">@s.UpdatedOn?.ToString("dd MMM yyyy HH:mm")</td>
                                <td><button type="button" class="btn btn-sm btn-primary btn-save-schedule">Save</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="small text-muted mb-0">
                Last Date = last day without fine (fine starts the next day, 12:00 AM IST).
                Fine Last Date = last day with fine (payment closes the next day); leave empty for no closing date.
            </p>
        </div>

        @* ================= Colleges ================= *@
        <div class="tab-pane fade" id="tabColleges">
            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                <input type="search" id="collegeSearch" class="form-control form-control-sm" style="max-width: 260px;" placeholder="Search code, name or town" />

                <select id="facultyFilter" class="form-select form-select-sm" style="max-width: 160px;">
                    <option value="">All faculties</option>
                    @foreach (var f in facultyCodes)
                    {
                        <option value="@f">Faculty @f</option>
                    }
                </select>

                <select id="statusFilter" class="form-select form-select-sm" style="max-width: 140px;">
                    <option value="">All status</option>
                    <option value="true">True</option>
                    <option value="false">False</option>
                </select>

                <span class="small text-muted">True: <strong id="countTrue">@activeCount</strong> / @Model.Colleges.Count</span>

                <div class="ms-auto d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-success" id="btnAllTrue">Make all true</button>
                    <button type="button" class="btn btn-sm btn-danger" id="btnAllFalse">Make all false</button>
                </div>
            </div>

            <div class="table-responsive college-scroll">
                <table class="table table-bordered table-sm" id="collegeTable">
                    <thead class="table-light">
                        <tr>
                            <th>College Code</th>
                            <th>College Name</th>
                            <th>Town</th>
                            <th>Faculty</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Colleges)
                        {
                            <tr data-code="@c.CollegeCode" data-faculty="@c.FacultyCode">
                                <td>@c.CollegeCode</td>
                                <td>@c.CollegeName</td>
                                <td>@c.CollegeTown</td>
                                <td>@c.FacultyCode</td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block m-0">
                                        <input type="checkbox" class="form-check-input college-status" role="switch" @(c.Status ? "checked" : null) />
                                    </div>
                                    <span class="status-label small ms-1">@(c.Status ? "true" : "false")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        function notify(ok, text) {
            if (typeof Swal !== 'undefined') {
                return Swal.fire({ icon: ok ? 'success' : 'error', title: ok ? 'Done' : 'Failed', text: text, timer: ok ? 1500 : undefined, showConfirmButton: !ok });
            }
            if (!ok) alert(text);
            return Promise.resolve();
        }

        function confirmAction(text) {
            if (typeof Swal !== 'undefined') {
                return Swal.fire({ icon: 'warning', title: 'Are you sure?', text: text, showCancelButton: true, confirmButtonText: 'Yes' })
                    .then(function (r) { return r.isConfirmed; });
            }
            return Promise.resolve(confirm(text));
        }

        function post(url, body) {
            return fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(body)
            }).then(function (r) { return r.json(); });
        }

        // ---------- Schedule ----------
        document.querySelectorAll('.btn-save-schedule').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var row = btn.closest('tr');
                var id = parseInt(row.dataset.id, 10) || 0;
                var amount = row.querySelector('.f-amount').value;

                var payload = {
                    id: id,
                    facultyCode: parseInt(row.querySelector('.f-faculty').value, 10) || 0,
                    courseLevel: row.querySelector('.f-level').value.trim(),
                    isEnabled: row.querySelector('.f-enabled').checked,
                    startDate: row.querySelector('.f-start').value || null,
                    lastDate: row.querySelector('.f-last').value || null,
                    fineLastDate: row.querySelector('.f-fine-last').value || null,
                    fineAmount: amount === '' ? null : parseFloat(amount)
                };

                btn.disabled = true;
                post('@Url.Action("SaveSchedule", "AffiliationSettings")', payload)
                    .then(function (res) {
                        return notify(res.success, res.message).then(function () {
                            if (res.success) window.location.reload();
                        });
                    })
                    .catch(function () { notify(false, 'Request failed. Please try again.'); })
                    .finally(function () { btn.disabled = false; });
            });
        });

        // ---------- Colleges ----------
        var collegeRows = document.querySelectorAll('#collegeTable tbody tr');

        function updateCount() {
            document.getElementById('countTrue').textContent =
                document.querySelectorAll('#collegeTable .college-status:checked').length;
        }

        function setLabel(row, value) {
            row.querySelector('.status-label').textContent = value ? 'true' : 'false';
        }

        document.querySelectorAll('.college-status').forEach(function (cb) {
            cb.addEventListener('change', function () {
                var row = cb.closest('tr');
                var wanted = cb.checked;
                cb.disabled = true;

                post('@Url.Action("SetCollegeStatus", "AffiliationSettings")', { collegeCode: row.dataset.code, status: wanted })
                    .then(function (res) {
                        if (res.success) {
                            setLabel(row, wanted);
                        } else {
                            cb.checked = !wanted; // revert
                            notify(false, res.message);
                        }
                        updateCount();
                    })
                    .catch(function () { cb.checked = !wanted; notify(false, 'Request failed. Please try again.'); updateCount(); })
                    .finally(function () { cb.disabled = false; });
            });
        });

        function setAll(value) {
            var label = value ? 'true' : 'false';
            confirmAction('This will set the Status of ALL colleges to ' + label + ' (not only the ones visible after filtering).').then(function (ok) {
                if (!ok) return;
                post('@Url.Action("SetAllCollegeStatus", "AffiliationSettings")', { status: value })
                    .then(function (res) {
                        if (res.success) {
                            collegeRows.forEach(function (row) {
                                row.querySelector('.college-status').checked = value;
                                setLabel(row, value);
                            });
                            updateCount();
                        }
                        notify(res.success, res.message);
                    })
                    .catch(function () { notify(false, 'Request failed. Please try again.'); });
            });
        }

        document.getElementById('btnAllTrue').addEventListener('click', function () { setAll(true); });
        document.getElementById('btnAllFalse').addEventListener('click', function () { setAll(false); });

        // Search + faculty + status filters
        var searchBox = document.getElementById('collegeSearch');
        var facultySel = document.getElementById('facultyFilter');
        var statusSel = document.getElementById('statusFilter');

        function applyFilters() {
            var q = searchBox.value.trim().toLowerCase();
            var faculty = facultySel.value;
            var status = statusSel.value;

            collegeRows.forEach(function (row) {
                var cells = row.querySelectorAll('td');
                var text = (cells[0].textContent + ' ' + cells[1].textContent + ' ' + cells[2].textContent).toLowerCase();
                var checked = row.querySelector('.college-status').checked;

                var ok = text.indexOf(q) !== -1
                    && (!faculty || row.dataset.faculty === faculty)
                    && (!status || (status === 'true') === checked);

                row.style.display = ok ? '' : 'none';
            });
        }

        searchBox.addEventListener('input', applyFilters);
        facultySel.addEventListener('change', applyFilters);
        statusSel.addEventListener('change', applyFilters);
    })();
</script>
