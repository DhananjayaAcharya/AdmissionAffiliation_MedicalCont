
@model HospitalFacilitiesViewModel

<style>
    /* ============================================================
           HOSPITAL FACILITIES
           ============================================================ */

    .facilities-section {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .facilities-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 18px;
        padding-bottom: 14px;
        border-bottom: 1px solid #edf0f3;
    }

    .facilities-title {
        margin: 0;
        font-size: 18px;
        font-weight: 600;
        color: #1f2937;
    }

    .facilities-subtitle {
        margin: 4px 0 0;
        font-size: 13px;
        color: #6b7280;
    }

    .required-star {
        color: #dc3545;
        margin-left: 3px;
    }

    /* Counter */
    .facility-counter {
        background: #f1f5f9;
        color: #475569;
        border-radius: 20px;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* Facility cards */
    .facility-card {
        position: relative;
        height: 100%;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        padding: 12px 14px;
        background: #fff;
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .facility-card:hover {
            border-color: #94a3b8;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
            transform: translateY(-1px);
        }

        .facility-card.selected {
            border-color: #0d6efd;
            background: #f4f8ff;
        }

    .facility-check {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        cursor: pointer;
        width: 100%;
    }

        .facility-check .form-check-input {
            width: 18px;
            height: 18px;
            margin: 0;
            flex-shrink: 0;
            cursor: pointer;
        }

        .facility-check .form-check-label {
            font-size: 14px;
            color: #374151;
            font-weight: 500;
            cursor: pointer;
            line-height: 1.4;
        }

    .facility-card.selected .form-check-label {
        color: #0d47a1;
        font-weight: 600;
    }

    /* Save button */
    .facility-actions {
        margin-top: 22px;
        padding-top: 16px;
        border-top: 1px solid #edf0f3;
        text-align: right;
    }

    #saveHospitalFacilitiesBtn {
        min-width: 150px;
        border-radius: 7px;
        font-weight: 600;
        padding: 9px 18px;
        transition: all 0.2s ease;
    }

        #saveHospitalFacilitiesBtn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(13, 110, 253, 0.18);
        }

    /* Responsive */
    @@media (max-width: 767px) {

        .facilities-section {
            padding: 16px;
        }

        .facilities-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .facility-actions {
            text-align: center;
        }

        #saveHospitalFacilitiesBtn {
            width: 100%;
        }
    }
</style>


<div class="form-section facilities-section">

    <div class="facilities-header">

        <div>
            <h5 class="facilities-title">
                Facilities Available
                <span class="required-star">*</span>
            </h5>

            <p class="facilities-subtitle">
                Select the facilities currently available in the hospital.
            </p>
        </div>

        <div class="facility-counter">
            <span id="selectedFacilityCount">0</span>
            selected
        </div>

    </div>


    <form id="hospitalFacilitiesForm">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="HospitalDetailsId" />


        <div class="row g-3">

            @foreach (var f in Model.AvailableFacilities)
            {
                var facilityId = int.Parse(f.Value);

                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12">

                    <div class="facility-card
                        @(Model.SelectedFacilityIds.Contains(facilityId) ? "selected" : "")">

                        <label class="facility-check">

                            <input class="form-check-input facility-checkbox"
                                   type="checkbox"
                                   name="SelectedFacilityIds"
                                   value="@f.Value"
                                   id="facility_@f.Value"
                            @(Model.SelectedFacilityIds.Contains(facilityId) ? "checked" : "") />

                            <span class="form-check-label">
                                @f.Text
                            </span>

                        </label>

                    </div>

                </div>
            }

        </div>


        <div class="facility-actions">

            <button type="button"
                    id="saveHospitalFacilitiesBtn"
                    class="btn btn-primary">

                <i class="bi bi-check-circle me-1"></i>
                Save Facilities

            </button>

        </div>

    </form>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function() {

        const form = document.getElementById("hospitalFacilitiesForm");
        const saveButton = document.getElementById("saveHospitalFacilitiesBtn");
        const countElement = document.getElementById("selectedFacilityCount");

        if (!form || !saveButton) {
            return;
        }


        // ============================================================
        // UPDATE SELECTED COUNT + CARD STYLE
        // ============================================================

        function updateFacilityUI() {

            const checkboxes =
                form.querySelectorAll(".facility-checkbox");

            let selectedCount = 0;

            checkboxes.forEach(function(checkbox) {

                const card =
                    checkbox.closest(".facility-card");

                if (checkbox.checked) {

                    selectedCount++;

                    card?.classList.add("selected");

                } else {

                    card?.classList.remove("selected");

                }

            });

            if (countElement) {
                countElement.textContent = selectedCount;
            }
        }


        // ============================================================
        // CHECKBOX CHANGE
        // ============================================================

        form.querySelectorAll(".facility-checkbox")
            .forEach(function(checkbox) {

                checkbox.addEventListener("change", function() {
                    updateFacilityUI();
                });

            });


        // Initial count
        updateFacilityUI();


        // ============================================================
        // SAVE
        // ============================================================

        saveButton.addEventListener("click", function() {

            const formData = new FormData(form);

            saveButton.disabled = true;

            const originalHtml = saveButton.innerHTML;

            saveButton.innerHTML =
                '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';


            fetch(
                '@Url.Action("SaveHospitalFacilities", "ContinuationAffiliationClinicalFacilities")',
                {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken':
                            form.querySelector(
                                'input[name="__RequestVerificationToken"]'
                            )?.value
                    }
                }
            )
                .then(res => {

                    if (!res.ok) {
                        throw res;
                    }

                    return res.json();

                })
                .then(data => {

                    Swal.fire({
                        title: "Success",
                        text: data.message,
                        icon: "success",
                        confirmButtonText: "OK"
                    });

                })
                .catch(async err => {

                    let errors = [];

                    if (err instanceof Response) {

                        try {

                            const errorData = await err.json();

                            if (
                                errorData.errors &&
                                Array.isArray(errorData.errors)
                            ) {

                                errorData.errors.forEach(function(e) {

                                    if (Array.isArray(e.messages)) {
                                        errors.push(...e.messages);
                                    }

                                });

                            }

                        } catch {

                            errors.push(
                                "An unexpected error occurred."
                            );

                        }

                    } else {

                        errors.push(
                            "An unexpected error occurred."
                        );

                    }


                    Swal.fire({
                        title: "Validation Error",
                        html: errors.length
                            ? errors.join("<br>")
                            : "Failed to save facilities.",
                        icon: "error"
                    });

                })
                .finally(() => {

                    saveButton.disabled = false;
                    saveButton.innerHTML = originalHtml;

                });

        });

    });

</script>