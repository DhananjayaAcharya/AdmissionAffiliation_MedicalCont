@model ClinicalHospitalViewModel

<style>
    /* =========================================================
        HOSPITAL CERTIFICATES & FUTURE DEVELOPMENT
        ========================================================= */

    .hospital-certificates-section {
        margin-top: 1.5rem;
    }

    .hospital-certificates-section .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 18px;
        margin-bottom: 20px;
        border-left: 4px solid #198754;
        border-radius: 8px;
        background: linear-gradient( 135deg, #f0fdf4, #f8fafc );
        color: #1f2937;
        font-size: 17px;
        font-weight: 700;
        letter-spacing: 0.2px;
    }

    .hospital-certificates-section .section-title::before {
        content: "\f56c";
        font-family: "Font Awesome 5 Free";
        font-weight: 900;
        color: #198754;
        font-size: 16px;
    }


    /* =========================================================
        CERTIFICATE CARD
        ========================================================= */

    .hospital-certificate-card {
        height: 100%;
        padding: 18px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #ffffff;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
        transition: all 0.2s ease;
    }

    .hospital-certificate-card:hover {
        border-color: #b7dec7;
        box-shadow: 0 5px 15px rgba(15, 23, 42, 0.08);
        transform: translateY(-1px);
    }


    /* =========================================================
        LABEL
        ========================================================= */

    .hospital-certificate-card .form-label {
        display: block;
        margin-bottom: 8px;
        color: #334155;
        font-size: 14px;
        font-weight: 600;
    }


    /* =========================================================
        FILE INPUT
        ========================================================= */

    .hospital-certificate-card input[type="file"] {
        min-height: 42px;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        background: #f8fafc;
        font-size: 13px;
        cursor: pointer;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .hospital-certificate-card input[type="file"]:hover {
        background: #ffffff;
        border-color: #94a3b8;
    }

    .hospital-certificate-card input[type="file"]:focus {
        background: #ffffff;
        border-color: #198754;
        box-shadow: 0 0 0 3px rgba(25, 135, 84, 0.12);
        outline: none;
    }


    /* =========================================================
        HELP TEXT
        ========================================================= */

    .hospital-certificate-card .text-muted {
        display: block;
        margin-top: 6px;
        color: #64748b !important;
        font-size: 12px;
    }


    /* =========================================================
        EXISTING DOCUMENT AREA
        ========================================================= */

    .hospital-existing-document {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: 12px;
        padding: 9px 11px;
        border: 1px solid #dbeafe;
        border-radius: 7px;
        background: #f8fafc;
    }

    .hospital-existing-document .file-info {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .hospital-existing-document .file-info i {
        color: #dc3545;
        font-size: 16px;
    }

    .hospital-existing-document .file-label {
        color: #475569;
        font-size: 12px;
        font-weight: 500;
    }


    /* =========================================================
        VIEW BUTTON
        ========================================================= */

    .hospital-existing-document .btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    .hospital-existing-document .btn:hover {
        transform: translateY(-1px);
    }


    /* =========================================================
        FUTURE DEVELOPMENT CARD
        ========================================================= */

    .hospital-future-development-card {
        border-left: 3px solid #0d6efd;
    }

    .hospital-future-development-card .form-label {
        color: #1e3a8a;
    }


    /* =========================================================
        MOBILE
        ========================================================= */

    @@media (max-width: 767.98px) {

        .hospital-certificates-section .section-title {
            padding: 12px 14px;
            font-size: 15px;
        }

        .hospital-certificate-card {
            padding: 15px;
        }

        .hospital-existing-document {
            align-items: flex-start;
            flex-direction: column;
        }

        .hospital-existing-document .btn {
            width: 100%;
            justify-content: center;
        }
    }



    /* ============================================================
       ANATOMY ACT, 1969 REGISTRATION
       ============================================================ */

    .anatomy-act-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        margin-top: 8px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    }


    /* ------------------------------------------------------------
       QUESTION
       ------------------------------------------------------------ */

    .anatomy-act-question {
        padding-bottom: 4px;
    }

    .anatomy-act-question .form-label {
        font-weight: 600;
        color: #334155;
        line-height: 1.6;
        margin-bottom: 12px;
    }


    /* ------------------------------------------------------------
       YES / NO OPTIONS
       ------------------------------------------------------------ */

    .anatomy-act-options {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 12px 16px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        width: fit-content;
    }

    .anatomy-act-options .form-check {
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 0;
    }

    .anatomy-act-options .form-check-input {
        width: 18px;
        height: 18px;
        margin: 0;
        cursor: pointer;
    }

    .anatomy-act-options .form-check-label {
        font-weight: 500;
        color: #334155;
        cursor: pointer;
        margin: 0;
    }


    /* ------------------------------------------------------------
       DETAILS SECTION
       ------------------------------------------------------------ */

    .anatomy-act-details {
        margin-top: 20px;
        padding: 18px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        animation: anatomyActFadeIn 0.2s ease-in-out;
    }


    /* ------------------------------------------------------------
        TEXTAREA
    ------------------------------------------------------------ */

    .anatomy-act-details textarea {
        min-height: 110px;
        resize: vertical;
    }

    .anatomy-act-details textarea,
    .anatomy-act-details input[type="file"] {
        border-radius: 8px;
        border: 1px solid #cbd5e1;
    }

    .anatomy-act-details textarea:focus,
    .anatomy-act-details input[type="file"]:focus {
        border-color: #64748b;
        box-shadow: 0 0 0 3px rgba(100, 116, 139, 0.12);
        outline: none;
    }


    /* ------------------------------------------------------------
        FILE HELP TEXT
        ------------------------------------------------------------ */

    .anatomy-act-details small.text-muted {
        display: block;
        margin-top: 6px;
        color: #64748b !important;
        font-size: 12px;
    }


    /* ------------------------------------------------------------
        EXISTING FILE BUTTON
        ------------------------------------------------------------ */

    .anatomy-act-details .btn-outline-success {
        border-radius: 7px;
        font-weight: 500;
        padding: 6px 12px;
    }


    /* ------------------------------------------------------------
       REQUIRED STAR
       ------------------------------------------------------------ */

    .anatomy-act-card .req {
        color: #dc2626;
        font-weight: 600;
    }


    /* ------------------------------------------------------------
       VALIDATION
       ------------------------------------------------------------ */

    .anatomy-act-card .text-danger {
        display: block;
        margin-top: 5px;
        font-size: 12px;
    }


    /* ------------------------------------------------------------
       ANIMATION
       ------------------------------------------------------------ */

    @@keyframes anatomyActFadeIn {

        from {
            opacity: 0;
            transform: translateY(-4px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* ------------------------------------------------------------
       MOBILE
       ------------------------------------------------------------ */

    @@media (max-width: 768px) {

        .anatomy-act-card {
            padding: 15px;
        }

        .anatomy-act-options {
            width: 100%;
            gap: 20px;
        }

        .anatomy-act-details {
            padding: 14px;
        }
    }


     /* ============================================================
       HOSPITAL TIE-UP SECTION
       ============================================================ */

    .tieup-section {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 22px;
        margin-bottom: 24px;
    }

    .tieup-section-header {
        margin-bottom: 18px;
    }

    .tieup-section .section-title {
        font-size: 18px;
        font-weight: 700;
        color: #1f2937;
    }

    .tieup-description {
        font-size: 13px;
        color: #6b7280;
        line-height: 1.6;
    }

    .tieup-examples {
        margin-top: 5px;
        font-size: 12px;
        color: #64748b;
        font-style: italic;
    }


    /* ============================================================
       YES / NO QUESTION
       ============================================================ */

    .tieup-question-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 16px 18px;
        margin-bottom: 20px;
    }

    .tieup-question-card .form-label {
        margin-bottom: 10px;
        color: #334155;
    }

    .tieup-radio-group {
        display: flex;
        gap: 14px;
    }

    .tieup-radio-option {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-width: 90px;
        padding: 8px 16px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        background: #fff;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .tieup-radio-option:hover {
        border-color: #2563eb;
        background: #f8fbff;
    }

    .tieup-radio-option input {
        margin: 0;
        cursor: pointer;
    }


    /* ============================================================
       DETAILS CONTAINER
       ============================================================ */

    .tieup-details-container {
        border: 1px solid #dbe3ec;
        border-radius: 10px;
        background: #fafcff;
        padding: 18px;
    }

    .tieup-details-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 16px;
        padding-bottom: 14px;
        border-bottom: 1px solid #e5e7eb;
    }

    .tieup-details-header h6 {
        font-weight: 700;
        color: #334155;
    }

    .tieup-details-header small {
        color: #64748b;
    }

    .tieup-add-btn {
        white-space: nowrap;
        border-radius: 7px;
        padding: 8px 14px;
        font-size: 13px;
    }


    /* ============================================================
       TABLE
       ============================================================ */

    .hospital-tieup-table {
        margin-bottom: 0;
        vertical-align: middle;
    }

    .hospital-tieup-table thead th {
        background: #f1f5f9;
        color: #334155;
        font-size: 12px;
        font-weight: 700;
        padding: 12px 10px;
        border-bottom: 1px solid #cbd5e1;
        white-space: nowrap;
    }

    .hospital-tieup-table tbody td {
        padding: 10px;
        vertical-align: top;
        border-bottom: 1px solid #e5e7eb;
    }

    .hospital-tieup-table .form-control,
    .hospital-tieup-table .form-select {
        font-size: 13px;
        border-radius: 6px;
        border-color: #d1d5db;
    }

    .hospital-tieup-table textarea {
        resize: vertical;
        min-height: 70px;
    }

    .hospital-tieup-table .form-control:focus,
    .hospital-tieup-table .form-select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 0.15rem rgba(37, 99, 235, 0.10);
    }


    /* ============================================================
       EXISTING DOCUMENT
       ============================================================ */

    .existing-tieup-document {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        font-size: 12px;
    }

    .existing-tieup-document > i {
        color: #dc2626;
    }

    .existing-tieup-document .btn {
        font-size: 11px;
        padding: 4px 8px;
    }


    /* ============================================================
       REMOVE BUTTON
       ============================================================ */

    .btn-remove-tieup {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #fecaca;
        border-radius: 6px;
        background: #fff;
        color: #dc2626;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-remove-tieup:hover {
        background: #fef2f2;
        border-color: #ef4444;
        color: #b91c1c;
    }


    /* ============================================================
       EMPTY MESSAGE
       ============================================================ */

    .tieup-empty-message {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 80px;
        margin-top: 14px;
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
        background: #fff;
        color: #64748b;
        font-size: 13px;
    }

    .tieup-empty-message i {
        font-size: 18px;
        color: #94a3b8;
    }


    /* ============================================================
       REQUIRED
       ============================================================ */

    .tieup-section .req {
        color: #dc2626;
        font-weight: 700;
    }


    /* ============================================================
       RESPONSIVE
       ============================================================ */

    @@media (max-width: 768px) {

        .tieup-section {
            padding: 15px;
        }

        .tieup-details-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .tieup-add-btn {
            width: 100%;
        }

        .tieup-radio-group {
            flex-wrap: wrap;
        }

        .tieup-radio-option {
            flex: 1;
        }

    }
</style>

<div class="form-section">
    <div class="section-title">Affiliated Hospital Information </div>

    <form id="clinicalFacilitiesForm" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Form.HospitalDetailsId" />
        <input type="hidden" asp-for="Form.CollegeCode" />
        <input type="hidden" asp-for="Form.FacultyCode" />
        <input type="hidden" asp-for="Form.AffiliationTypeId" />
        <input type="hidden" asp-for="Form.AffiliationType" />

        <div class="row g-3">
            @if (Model?.Form?.FacultyCode == "3")
            {
                <div class="col-md-3">
                    <label class="required">Parent Medical College Exists</label>
                    <select asp-for="Form.ParentMedicalCollegeExists" class="form-select">
                        <option value="">Select</option>
                        @foreach (var i in Model.ParentMedicalCollegeExistsOptions)
                        {
                            <option value="@i.Value"
                                    selected="@(Model.Form.ParentMedicalCollegeExists?.ToString() == i.Value)">
                                @i.Text
                            </option>
                        }
                    </select>
                </div>
            }

            <div class="col-md-3">
                <label class="required">Hospital Type</label>
                <select asp-for="Form.HospitalType" class="form-select">
                    <option value="">Select</option>
                    @foreach (var i in Model.HospitalTypes)
                    {
                        <option value="@i.Value"
                                selected="@(Model.Form.HospitalType?.ToString() == i.Value)">
                            @i.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="required">Hospital Name</label>
                <input asp-for="Form.HospitalName" class="form-control" placeholder="Enter Hospital name" />
            </div>

            <div class="col-6">
                <label class="required">Hospital Owned By</label>
                <select asp-for="Form.HospitalOwnedBy" class="form-select">
                    <option value="">Select</option>
                    @foreach (var i in Model.HospitalOwnedByOptions)
                    {
                        <option value="@i.Value"
                                selected="@(Model.Form.HospitalOwnedBy?.ToString() == i.Value)">
                            @i.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="required">Hospital Owner Name</label>
                <input asp-for="Form.HospitalOwnerName" class="form-control" placeholder="Enter Hospital Owner Name" />
            </div>

            <div class="col-md-4">
                <label class="required">District</label>
                <select asp-for="Form.HospitalDistrictId" class="form-select">
                    <option value="">Select</option>
                    @foreach (var d in Model.Districts)
                    {
                        <option value="@d.Value"
                                selected="@(Model.Form.HospitalDistrictId?.ToString() == d.Value)">
                            @d.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="required">Taluk</label>
                <select asp-for="Form.HospitalTalukId" class="form-select">
                    <option value="">Select</option>
                    @foreach (var t in Model.Taluks)
                    {
                        <option value="@t.TalukID"
                                data-district="@t.DistrictID"
                                selected="@(Model.Form.HospitalTalukId == t.TalukID)">
                            @t.TalukName
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="required">Location</label>
                <select asp-for="Form.Location" class="form-select">
                    <option value="">Select</option>
                    @foreach (var l in Model.Locations)
                    {
                        <option value="@l"
                                selected="@(Model.Form.Location == l)">
                            @l
                        </option>
                    }
                </select>
            </div>

            @if (Model.Form.FacultyCode == "3")
            {
                <div class="col-md-6">
                    <label class="required">Is Parent Hospital for Other Nursing Institution</label>
                    <select asp-for="Form.IsParentHospitalForOtherNursingInstitution"
                            class="form-select"
                            id="isParentHospitalSelect">
                        <option value="">Select</option>
                        @foreach (var i in Model.IsParentHospitalForOtherNursingInstitutionOptions)
                        {
                            <option value="@i.Value"
                                    selected="@(Model?.Form?.IsParentHospitalForOtherNursingInstitution?.ToString() == i.Value)">
                                @i.Text
                            </option>
                        }
                    </select>
                </div>
            }

            <div class="col-md-6" id="supportingDocSection" style="display: @(Model.Form.IsParentHospitalForOtherNursingInstitution == true ? "block" : "none")">
                <label class="support d-block">Supporting Document (if parent hospital)</label>
                <input asp-for="SupportingDoc"
                       type="file"
                       class="supporting-doc"
                       accept=".pdf"
                       id="supportingDocInput"
                       style="display:none;" />
                <button type="button"
                        class="btn btn-sm btn-outline-primary choose-supporting-file">
                    Upload
                </button>
            </div>

            @if (Model.IsSupportingDocExists)
            {
                <div class="mb-2">
                    <a href="@Url.Action("ViewSupportingHospitalDocument", "ClinicalFacilitiesForAffiliation", new { code = Model.Form.CollegeCode })" target="_blank">
                        View Existing Document
                    </a>
                </div>
            }



            @* ============================================================
               CERTIFICATES & FUTURE DEVELOPMENT DOCUMENTS
               ============================================================ *@

            <div class="col-12 mt-4 hospital-certificates-section">

                <div class="section-title">
                    Hospital Certificates & Future Development
                </div>

            </div>


            @* ============================================================
               1. KPME CERTIFICATE
               ============================================================ *@

            <div class="col-md-6">

                <div class="hospital-certificate-card">
                    <label class="form-label">
                        KPME Certificate
                    </label>

                    <input asp-for="Form.KPMECertificateFile"
                           type="file"
                           class="form-control"
                           accept=".pdf" />

                    <small class="text-muted">
                        Upload KPME Certificate PDF
                    </small>

                    @if (!string.IsNullOrEmpty(Model.Form.KPMECertificatePath))
                    {
                        <div class="mt-2">

                            <a href="@Url.Action(
                                       "ViewHospitalCertificate",
                                       "ContinuationAffiliationClinicalFacilities",
                                       new
                                       {
                                           id = Model.Form.HospitalDetailsId,
                                           type = "kpme"
                                       })"
                               target="_blank"
                               class="btn btn-sm btn-outline-success">

                                <i class="fas fa-file-pdf"></i>
                                View Existing KPME Certificate

                            </a>

                        </div>
                    }

                </div>

            </div>


            @* ============================================================
               2. POLLUTION CONTROL BOARD CERTIFICATE
               ============================================================ *@

            <div class="col-md-6">

                <div class="hospital-certificate-card">
                
                    <label class="form-label">
                        Pollution Control Board Certificate
                    </label>

                    <input asp-for="Form.PollutionControlBoardCertificateFile"
                           type="file"
                           class="form-control"
                           accept=".pdf" />

                    <small class="text-muted">
                        Upload Pollution Control Board Certificate PDF
                    </small>

                    @if (!string.IsNullOrEmpty(Model.Form.PollutionControlBoardCertificatePath))
                    {
                        <div class="mt-2">

                            <a href="@Url.Action(
                                "ViewHospitalCertificate",
                                "ContinuationAffiliationClinicalFacilities",
                                new
                                {
                                    id = Model.Form.HospitalDetailsId,
                                    type = "pollution"
                                })"
                               target="_blank"
                               class="btn btn-sm btn-outline-success">

                                <i class="fas fa-file-pdf"></i>
                                View Existing Certificate

                            </a>

                        </div>
                    }

                </div>

            </div>


            @* ============================================================
               3. BIO-MEDICAL WASTE CERTIFICATE
               ============================================================ *@

            <div class="col-md-6">

                <div class="hospital-certificate-card">
                    <label class="form-label">
                        Bio-Medical Certificate
                    </label>

                    <input asp-for="Form.BioMedicalCertificateFile"
                           type="file"
                           class="form-control"
                           accept=".pdf" />

                    <small class="text-muted">
                        Upload Bio-Medical Certificate PDF
                    </small>

                    @if (!string.IsNullOrEmpty(Model.Form.BioMedicalCertificatePath))
                    {
                        <div class="mt-2">

                            <a href="@Url.Action(
                                       "ViewHospitalCertificate",
                                       "ContinuationAffiliationClinicalFacilities",
                                       new
                                       {
                                           id = Model.Form.HospitalDetailsId,
                                           type = "biomedical"
                                       })"
                               target="_blank"
                               class="btn btn-sm btn-outline-success">

                                <i class="fas fa-file-pdf"></i>
                                View Existing Certificate

                            </a>

                        </div>
                    }
                </div>

            </div>


            @* ============================================================
               4. DRUG FREE CAMPUS CERTIFICATION
               ============================================================ *@

            <div class="col-md-6">
                <div class="hospital-certificate-card">
                    <label class="form-label">
                        Drug Free Campus Certification
                    </label>

                    <input asp-for="Form.DrugFreeCampusCertificationFile"
                           type="file"
                           class="form-control"
                           accept=".pdf" />

                    <small class="text-muted">
                        Upload Drug Free Campus Certification PDF
                    </small>

                    @if (!string.IsNullOrEmpty(Model.Form.DrugFreeCampusCertificationPath))
                    {
                        <div class="mt-2">

                            <a href="@Url.Action(
                                    "ViewHospitalCertificate",
                                    "ContinuationAffiliationClinicalFacilities",
                                    new
                                    {
                                        id = Model.Form.HospitalDetailsId,
                                        type = "drugfree"
                                    })"
                               target="_blank"
                               class="btn btn-sm btn-outline-success">

                                <i class="fas fa-file-pdf"></i>
                                View Existing Certification

                            </a>

                        </div>
                    }

                </div>


            </div>

            @* ============================================================
               5. PROPOSED PLANS FOR FUTURE DEVELOPMENTS
               ============================================================ *@

            <div class="col-md-6">
                <div class="hospital-certificate-card hospital-future-development-card">
                    <label class="form-label">
                        Proposed Plans for Future Developments
                    </label>

                    <input asp-for="Form.ProposedPlansForFutureDevelopmentsFile"
                           type="file"
                           class="form-control"
                           accept=".pdf" />

                    <small class="text-muted">
                        Upload Proposed Plans for Future Developments PDF
                    </small>

                    @if (!string.IsNullOrEmpty(Model.Form.ProposedPlansForFutureDevelopmentsPath))
                    {
