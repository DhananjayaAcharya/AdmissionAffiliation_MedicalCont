                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            @* ============================================================
               HOSPITAL TIE-UP DETAILS
               ============================================================ *@

            <div class="col-12 mt-4">

                <div class="tieup-section">

                    <div class="tieup-section-header">
                        <div>
                            <div class="section-title mb-1">
                                Details of Tie-up with Other Hospital
                            </div>

                            <div class="tieup-description">
                                Where necessary, furnish details of tie-up with
                                other hospitals and attach supporting documents.
                            </div>

                            <div class="tieup-examples">
                                Examples: Psychiatry and Mental Health, Tuberculosis,
                                Leprosy, Burns, etc.
                            </div>
                        </div>
                    </div>


                    @* ========================================================
                       HAS TIE-UP
                       ======================================================== *@

                    <div class="tieup-question-card">

                        <label class="form-label fw-semibold">
                            Does the institution have a tie-up with other hospital?
                            <span class="req">*</span>
                        </label>

                        <div class="tieup-radio-group">

                            <label class="tieup-radio-option">
                                <input type="radio"
                                       asp-for="Form.HasHospitalTieUp"
                                       value="true"
                                       id="hospitalTieUpYes" />

                                <span>Yes</span>
                            </label>

                            <label class="tieup-radio-option">
                                <input type="radio"
                                       asp-for="Form.HasHospitalTieUp"
                                       value="false"
                                       id="hospitalTieUpNo" />

