                        </span>

                    </div>


                    @* ========================================================
                        DETAILS - SHOWN ONLY WHEN YES
                        ======================================================== *@

                    <div id="anatomyActDetails"
                         class="anatomy-act-details">

                        <div class="row g-4">


                            @* ==================================================
                                REGISTRATION DETAILS
                                ================================================== *@

                            <div class="col-md-12">

                                <div class="anatomy-field-card">

                                    <label class="form-label">

                                        Anatomy Act Registration Details

                                    </label>

                                    <textarea asp-for="Form.AnatomyActRegistrationDetails"
