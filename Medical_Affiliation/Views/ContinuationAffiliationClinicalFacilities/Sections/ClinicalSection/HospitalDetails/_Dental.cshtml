                                                        <option value="Tuberculosis"
                                                                selected="@(Model.Form.HospitalTieUps[i].TieUpType == "Tuberculosis" ? "selected" : null)">
                                                            Tuberculosis
                                                        </option>

                                                        <option value="Leprosy"
                                                                selected="@(Model.Form.HospitalTieUps[i].TieUpType == "Leprosy" ? "selected" : null)">
                                                            Leprosy
                                                        </option>

                                                        <option value="Burns"
                                                                selected="@(Model.Form.HospitalTieUps[i].TieUpType == "Burns" ? "selected" : null)">
                                                            Burns
                                                        </option>

                                                        <option value="Other"
                                                                selected="@(Model.Form.HospitalTieUps[i].TieUpType == "Other" ? "selected" : null)">
                                                            Other
                                                        </option>

                                                    </select>

                                                </td>


                                                @* HOSPITAL NAME *@

                                                <td>

                                                    <input type="text"
                                                           class="form-control"
                                                           name="Form.HospitalTieUps[@i].HospitalName"
                                                           value="@Model.Form.HospitalTieUps[i].HospitalName"
                                                           placeholder="Enter hospital name" />

                                                </td>


                                                @* HOSPITAL ADDRESS *@

                                                <td>

                                                    <textarea class="form-control"
                                                              name="Form.HospitalTieUps[@i].HospitalAddress"
                                                              rows="2"
                                                              placeholder="Enter hospital address">@Model.Form.HospitalTieUps[i].HospitalAddress</textarea>

                                                </td>


                                                @* TIE-UP DETAILS *@

                                                <td>

                                                    <textarea class="form-control"
                                                              name="Form.HospitalTieUps[@i].TieUpDetails"
                                                              rows="2"
                                                              placeholder="Enter details of tie-up">@Model.Form.HospitalTieUps[i].TieUpDetails</textarea>

                                                </td>


                                                @* SUPPORTING DOCUMENT *@

                                                <td>

                                                    <input type="file"
                                                           class="form-control"
                                                           name="Form.HospitalTieUps[@i].SupportingDocumentFile"
                                                           accept=".pdf" />

                                                    @if (!string.IsNullOrWhiteSpace(
                                                        Model.Form.HospitalTieUps[i].SupportingDocumentPath))
                                                    {
                                                        <div class="existing-tieup-document mt-2">

                                                            <i class="fas fa-file-pdf"></i>

                                                            <a href="@Url.Action(
                                                                "ViewHospitalTieUpDocument",
                                                                "ContinuationAffiliationClinicalFacilities",
                                                                new
                                                                {
                                                                    id = Model.Form.HospitalTieUps[i].Id
                                                                })"
                                                               target="_blank"
                                                               class="btn btn-sm btn-outline-success">

                                                                <i class="fas fa-eye"></i>
                                                                View File

                                                            </a>

                                                        </div>
                                                    }

                                                </td>


                                                @* DELETE *@

                                                <td class="text-center">

                                                    <button type="button"
                                                            class="btn-remove-tieup remove-tieup-row"
                                                            title="Remove Tie-up">

                                                        <i class="fas fa-trash"></i>

                                                    </button>

                                                </td>

                                            </tr>
                                        }
                                    }

                                </tbody>

                            </table>

                        </div>


                        <div id="noHospitalTieUpMessage"
                             class="tieup-empty-message">

                            <i class="fas fa-hospital"></i>

                            <span>
                                No hospital tie-up details added yet.
                            </span>

                        </div>

                    </div>

                </div>

            </div>
        </div>

        <div class="text-center mt-3">
            <button type="button" id="saveClinicalFacilitiesBtn" class="btn btn-primary">Save Section</button>
        </div>
    </form>
</div>

<script>

    const parentHospitalSelect = document.getElementById("isParentHospitalSelect");
    const supportingDocSection = document.getElementById("supportingDocSection");
    const supportLabel = document.querySelector(".support");

    if (parentHospitalSelect && supportingDocSection) {
        parentHospitalSelect.addEventListener("change", function () {
            if (this.value === "true") {
                supportingDocSection.style.display = "block";
                supportLabel?.classList.add("required");
            } else {
                supportingDocSection.style.display = "none";
                supportLabel?.classList.remove("required");
            }
        });
    }

    const chooseFileBtn = document.querySelector(".choose-supporting-file");
    const supportingDocInput = document.getElementById("supportingDocInput");
    const selectedFileName = document.getElementById("selectedFileName");

    if (chooseFileBtn && supportingDocInput) {
        chooseFileBtn.addEventListener("click", function () {
            supportingDocInput.click();
        });
    }

    if (supportingDocInput && selectedFileName) {
        supportingDocInput.addEventListener("change", function () {
            selectedFileName.textContent =
                this.files.length > 0 ? this.files[0].name : "";
        });
    }

    document.addEventListener("click", function (e) {
        if (!e.target.matches("#saveClinicalFacilitiesBtn")) return;

        const form = e.target.closest("form");
        if (!(form instanceof HTMLFormElement)) return;

        const formData = new FormData(form);

        fetch('@Url.Action("SaveClinicalHospitalDetails", "ContinuationAffiliationClinicalFacilities")', {
            method: 'POST',
            body: formData,
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            }
        })
        .then(res => {
            if (!res.ok) throw res;
            return res.json();
        })
        .then(data => {
            Swal.fire("Success", data.message, "success")
                .then(() => {
                location.reload(); // Reload page after OK
            });
        })
        .catch(async err => {
            if (err.json) {
                const errData = await err.json();
                let errors = [];
                if (Array.isArray(errData.errors)) {
                    errData.errors.forEach(e => {
                        if (Array.isArray(e.messages)) {
                            errors.push(...e.messages);
                        }
                    });
                }
                Swal.fire("Validation Errors", errors.join("<br>"), "error");
            } else {
                Swal.fire("Error", "Failed to save section.", "error");
            }
        });
    });

</script>

<script>
    document.addEventListener("DOMContentLoaded", function() {

        document.querySelectorAll('input[type="file"]').forEach(function(input) {

            input.addEventListener("change", function() {

                const file = this.files[0];

                if (!file) {
                    return;
                }

                const maxSize = 2 * 1024 * 1024; // 2 MB

                // PDF validation
                // if (file.type !== "application/pdf") {
                //     alert("Only PDF files are allowed.");
                //     this.value = "";
                //     return;
                // }

                // 2 MB size validation
                if (file.size > maxSize) {
                    alert("File size must not exceed 2 MB.");
                    this.value = "";
                    return;
                }

            });

        });

    });
</script>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const anatomyYes =
            document.getElementById("anatomyActYes");

        const anatomyNo =
            document.getElementById("anatomyActNo");

        const anatomyDetails =
            document.getElementById("anatomyActDetails");


        function toggleAnatomyActDetails() {

            if (!anatomyDetails) {
                return;
            }


            if (anatomyYes && anatomyYes.checked) {

                anatomyDetails.style.display = "block";

            }
            else {

                anatomyDetails.style.display = "none";

            }

        }


        if (anatomyYes) {

            anatomyYes.addEventListener(
                "change",
                toggleAnatomyActDetails
            );

        }


        if (anatomyNo) {

            anatomyNo.addEventListener(
                "change",
                toggleAnatomyActDetails
            );

        }


        // Important when editing existing data
        toggleAnatomyActDetails();


          /* ============================================================
           HOSPITAL TIE-UP
           ============================================================ */

        const tieUpYes =
            document.getElementById("hospitalTieUpYes");

        const tieUpNo =
            document.getElementById("hospitalTieUpNo");

        const tieUpDetailsSection =
            document.getElementById("hospitalTieUpDetails");

        const addHospitalTieUpButton =
            document.getElementById("addHospitalTieUpButton");

        const hospitalTieUpRows =
            document.getElementById("hospitalTieUpRows");

        const noHospitalTieUpMessage =
            document.getElementById("noHospitalTieUpMessage");


        /* ============================================================
           TOGGLE TIE-UP DETAILS
           ============================================================ */

        function toggleHospitalTieUp() {

            if (!tieUpDetailsSection) {
                return;
            }

            if (tieUpYes && tieUpYes.checked) {

                tieUpDetailsSection.style.display = "block";

                updateHospitalTieUpEmptyMessage();

            }
            else {

                tieUpDetailsSection.style.display = "none";

            }
        }


        /* ============================================================
           UPDATE EMPTY MESSAGE
           ============================================================ */

        function updateHospitalTieUpEmptyMessage() {

            if (!hospitalTieUpRows ||
                !noHospitalTieUpMessage) {
                return;
            }

            const rows =
                hospitalTieUpRows.querySelectorAll("tr");

            noHospitalTieUpMessage.style.display =
                rows.length > 0 ? "none" : "flex";
        }


        /* ============================================================
           ADD HOSPITAL TIE-UP
           ============================================================ */

        if (addHospitalTieUpButton) {

            addHospitalTieUpButton.addEventListener(
                "click",
                function () {

                    if (!hospitalTieUpRows) {
                        return;
                    }

                    const index =
                        hospitalTieUpRows.querySelectorAll("tr").length;

                    const row =
                        document.createElement("tr");

                    row.innerHTML = `

                        <input type="hidden"
                               name="Form.HospitalTieUps[${index}].Id"
                               value="0" />

                        <input type="hidden"
                               name="Form.HospitalTieUps[${index}].HospitalDetailsId"
                               value="${document.querySelector('[name="Form.HospitalDetailsId"]')?.value || 0}" />

                        <input type="hidden"
                               name="Form.HospitalTieUps[${index}].CollegeCode"
                               value="${document.querySelector('[name="Form.CollegeCode"]')?.value || ''}" />

                        <input type="hidden"
                               name="Form.HospitalTieUps[${index}].FacultyCode"
                               value="${document.querySelector('[name="Form.FacultyCode"]')?.value || ''}" />


                        <!-- TIE-UP TYPE -->

                        <td>

                            <select class="form-select tieup-type"
                                    name="Form.HospitalTieUps[${index}].TieUpType">

                                <option value="">
                                    -- Select Type --
                                </option>

                                <option value="Psychiatry and Mental Health">
                                    Psychiatry and Mental Health
                                </option>

                                <option value="Tuberculosis">
                                    Tuberculosis
                                </option>

                                <option value="Leprosy">
                                    Leprosy
                                </option>

                                <option value="Burns">
                                    Burns
                                </option>

                                <option value="Other">
                                    Other
                                </option>

                            </select>

                        </td>


                        <!-- HOSPITAL NAME -->

                        <td>

                            <input type="text"
                                   class="form-control"
                                   name="Form.HospitalTieUps[${index}].HospitalName"
                                   placeholder="Enter hospital name" />

                        </td>


                        <!-- HOSPITAL ADDRESS -->

                        <td>

                            <textarea class="form-control"
                                      name="Form.HospitalTieUps[${index}].HospitalAddress"
                                      rows="2"
                                      placeholder="Enter hospital address"></textarea>

                        </td>


                        <!-- TIE-UP DETAILS -->

                        <td>

                            <textarea class="form-control"
                                      name="Form.HospitalTieUps[${index}].TieUpDetails"
                                      rows="2"
                                      placeholder="Enter details of tie-up"></textarea>

                        </td>


                        <!-- SUPPORTING DOCUMENT -->

                        <td>

                            <input type="file"
                                   class="form-control"
                                   name="Form.HospitalTieUps[${index}].SupportingDocumentFile"
                                   accept=".pdf" />

                        </td>


                        <!-- DELETE -->

                        <td class="text-center">

                            <button type="button"
                                    class="btn-remove-tieup remove-tieup-row"
                                    title="Remove Tie-up">

                                <i class="fas fa-trash"></i>

                            </button>

                        </td>

                    `;

                    hospitalTieUpRows.appendChild(row);
                    const tieUpTypeSelect = row.querySelector(".tieup-type");

                    if (tieUpTypeSelect) {
                        tieUpTypeSelect.value = "";
                    }

                    updateHospitalTieUpEmptyMessage();

                }
            );

        }


        /* ============================================================
           REMOVE HOSPITAL TIE-UP
           ============================================================ */

        if (hospitalTieUpRows) {

            hospitalTieUpRows.addEventListener(
                "click",
                function (e) {

                    const button =
                        e.target.closest(".remove-tieup-row");

                    if (!button) {
                        return;
                    }

                    const row =
                        button.closest("tr");

                    if (!row) {
                        return;
                    }

                    /*
                     * If Id = 0, it is a newly added row.
                     * Just remove it from UI.
                     */

                    const idInput =
                        row.querySelector(
                            'input[name$=".Id"]'
                        );

                    const id =
                        idInput
                            ? parseInt(idInput.value || "0")
                            : 0;


                    if (id === 0) {

                        row.remove();

                        reindexHospitalTieUps();

                        updateHospitalTieUpEmptyMessage();

                    }
                    else {

                        /*
                         * Existing database record.
                         *
                         * Don't simply remove it from UI.
                         * Call your backend delete method.
                         */

                        const deleteUrl =
                            '@Url.Action(
                                "DeleteHospitalTieUp",
                                "ContinuationAffiliationClinicalFacilities"
                                )'
                            + '?id='
                            + id;

                        fetch(deleteUrl, {
                            method: "POST",
                            headers: {
                                "RequestVerificationToken":
                                    document.querySelector(
                                        'input[name="__RequestVerificationToken"]'
                                    )?.value
                            }
                        })
                        .then(response => {

                            if (!response.ok) {
                                throw new Error(
                                    "Failed to delete tie-up."
                                );
                            }

                            row.remove();

                            reindexHospitalTieUps();

                            updateHospitalTieUpEmptyMessage();

                        })
                        .catch(error => {

                            console.error(
                                "Error deleting hospital tie-up:",
                                error
                            );

                            alert(
                                "Unable to delete hospital tie-up."
                            );

                        });

                    }

                }
            );

        }


        /* ============================================================
           REINDEX TIE-UP ROWS
           ============================================================ */

        function reindexHospitalTieUps() {

            if (!hospitalTieUpRows) {
                return;
            }

            const rows =
                hospitalTieUpRows.querySelectorAll("tr");

            rows.forEach(function (row, index) {

                row.querySelectorAll(
                    "input[name], select[name], textarea[name]"
                )
                .forEach(function (input) {

                    const name =
                        input.getAttribute("name");

                    if (!name) {
                        return;
                    }

                    input.setAttribute(
                        "name",
                        name.replace(
                            /Form\.HospitalTieUps\[\d+\]/,
                            `Form.HospitalTieUps[${index}]`
                        )
                    );

                });

            });

        }


        /* ============================================================
           CHANGE EVENTS
           ============================================================ */

        if (tieUpYes) {

            tieUpYes.addEventListener(
                "change",
                toggleHospitalTieUp
            );

        }

        if (tieUpNo) {

            tieUpNo.addEventListener(
                "change",
                toggleHospitalTieUp
            );

        }


        /* ============================================================
           INITIALIZE
           ============================================================ */

        toggleHospitalTieUp();

        updateHospitalTieUpEmptyMessage();

    });
</script>