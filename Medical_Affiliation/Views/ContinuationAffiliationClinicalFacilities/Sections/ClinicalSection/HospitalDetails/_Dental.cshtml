                                        </th>

                                        <th style="width:18%;">
                                            Hospital Name
                                            <span class="req">*</span>
                                        </th>

                                        <th style="width:20%;">
                                            Hospital Address
                                        </th>

                                        <th style="width:22%;">
                                            Tie-up Details
                                        </th>

                                        <th style="width:18%;">
                                            Supporting Document
                                        </th>

                                        <th style="width:5%;">
