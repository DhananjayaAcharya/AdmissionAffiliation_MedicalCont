                            <div class="form-check">

                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="Form.HasAnatomyActRegistration"
                                       value="false"
                                       id="anatomyActNo" />

                                <label class="form-check-label"
                                       for="anatomyActNo">
