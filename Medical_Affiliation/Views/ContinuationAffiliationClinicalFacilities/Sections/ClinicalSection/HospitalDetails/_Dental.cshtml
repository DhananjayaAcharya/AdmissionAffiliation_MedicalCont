<script>

    document.addEventListener("DOMContentLoaded", function () {

        const anatomyYes =
            document.getElementById("anatomyActYes");

        const anatomyNo =
            document.getElementById("anatomyActNo");

        const anatomyDetails =
            document.getElementById("anatomyActDetails");


        function toggleAnatomyActDetails() {

            if (!anatomyDetails) {
                return;
            }


            if (anatomyYes && anatomyYes.checked) {

                anatomyDetails.style.display = "block";

            }
            else {

                anatomyDetails.style.display = "none";

            }

        }


        if (anatomyYes) {

            anatomyYes.addEventListener(
                "change",
                toggleAnatomyActDetails
            );

        }


        if (anatomyNo) {

            anatomyNo.addEventListener(
                "change",
                toggleAnatomyActDetails
            );

        }


        // Important when editing existing data
        toggleAnatomyActDetails();

    });

</script>