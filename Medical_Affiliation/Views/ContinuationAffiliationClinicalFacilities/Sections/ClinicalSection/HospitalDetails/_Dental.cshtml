                                              rows="5"
                                              placeholder="Enter registration details">
                                            </textarea>

                                    <span asp-validation-for="Form.AnatomyActRegistrationDetails"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            @* ==================================================
                                REGISTRATION CERTIFICATE
                                ================================================== *@

                            <div class="col-md-12">

                                <div class="anatomy-field-card">

                                    <label class="form-label">

                                        Anatomy Act Registration Certificate

                                    </label>

                                    <input asp-for="Form.AnatomyActRegistrationPdfFile"
                                           type="file"
                                           class="form-control"
                                           accept=".pdf" />

                                    <div class="anatomy-file-help">

                                        <i class="fas fa-info-circle"></i>

                                        Upload Anatomy Act, 1969 Registration
                                        Certificate in PDF format.

                                    </div>


                                    @* Existing document *@

                                    @if (!string.IsNullOrWhiteSpace(
                                        Model.Form.AnatomyActRegistrationPdfPath))
                                    {

                                        <div class="anatomy-existing-file">

                                            <div class="existing-file-info">

                                                <i class="fas fa-file-pdf"></i>

                                                <span>
                                                    Existing registration certificate
                                                </span>

                                            </div>


                                            <a href="@Url.Action(
                                                    "ViewHospitalCertificate",
                                                    "ContinuationAffiliationClinicalFacilities",
