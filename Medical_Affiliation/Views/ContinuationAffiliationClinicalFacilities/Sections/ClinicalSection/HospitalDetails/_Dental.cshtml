                                                <input type="hidden"
                                                       name="Form.HospitalTieUps[@i].CollegeCode"
                                                       value="@Model.Form.CollegeCode" />

                                                <input type="hidden"
                                                       name="Form.HospitalTieUps[@i].FacultyCode"
                                                       value="@Model.Form.FacultyCode" />


                                                @* TIE-UP TYPE *@

                                                <td>

                                                    <select class="form-select tieup-type"
                                                            name="Form.HospitalTieUps[@i].TieUpType">

                                                        <option value="">
