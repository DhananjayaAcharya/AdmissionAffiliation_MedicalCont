@model Medical_Affiliation.Models.IndoorDepartmentRequirementsPostVM
<style>
    .separation {
        margin: 0.5rem 0;
        border: 1px solid #d0d0d0d6;
        border-radius: 5px;
        padding: 5px;
    }
</style>
@* Anti-forgery token *@
<div class="form-section">
    <div class="section-title required">
        Indoor Department Requirements
    </div>
    <form id="IndoorDepartmentForm" class="mt-3">
        @Html.AntiForgeryToken()
        @* Hidden fields *@
        <input type="hidden" id="CollegeCode" value="@Model.CollegeCode" />
        <input type="hidden" id="FacultyCode" value="@Model.FacultyCode" />
        <input type="hidden" id="AffiliationTypeId" value="@Model.AffiliationTypeId" />
        <input type="hidden" id="HospitalDetailsId" value="@Model.HospitalDetailsId" />

        @if (Model.Requirements != null && Model.Requirements.Any())
        {
            for (int i = 0; i < Model.Requirements.Count; i++)
            {
                var req = Model.Requirements[i];
                var yesId = $"req_{req.RequirementId}_yes";
                var noId = $"req_{req.RequirementId}_no";

                <div class="col-md-12 d-flex align-items-center justify-content-between separation">

                    <label class="form-check-label" for="@yesId">
                        @req.RequirementName
                    </label>

                    <div class="d-flex gap-3">
                        <label>
                            <input type="radio"
                                   id="@yesId"
                                   class="Indoor-radio"
                                   name="req_@req.RequirementId"
                                   data-id="@req.RequirementId"
                                   data-name="@req.RequirementName"
                                   value="true"
                            @(req.IsAvailable == true ? "checked" : "") />
                            Yes
                        </label>

                        <label>
                            <input type="radio"
                                   id="@noId"
                                   class="Indoor-radio"
                                   name="req_@req.RequirementId"
                                   data-id="@req.RequirementId"
                                   data-name="@req.RequirementName"
                                   value="false"
                            @(req.IsAvailable == false ? "checked" : "") />
                            No
                        </label>
                    </div>

                </div>
            }
        }
        else
        {
            <p class="text-muted">No Indoor Department Requirements available.</p>
        }
        <div class="text-center mt-3">
            <button type="button"
                    id="SaveIDBtn"
                    class="btn btn-primary">
                Save Indoor Department Requirements
            </button>
        </div>
    </form>
</div>
<script>
    document.getElementById('SaveIDBtn').addEventListener('click', saveIDRequirements);

    function saveIDRequirements() {

        const token =
            document.querySelector('input[name="__RequestVerificationToken"]').value;

        const requirements = [];

        document.querySelectorAll('.Indoor-radio:checked').forEach(radio => {
            requirements.push({
                requirementId: parseInt(radio.dataset.id),
                requirementName: radio.dataset.name,
                isAvailable: radio.value === "true"
            });
        });

        const payload = {
            collegeCode: document.getElementById('CollegeCode').value,
            facultyCode: parseInt(document.getElementById('FacultyCode').value),
            affiliationTypeId: parseInt(document.getElementById('AffiliationTypeId').value),
            hospitalDetailsId: parseInt(document.getElementById('HospitalDetailsId').value),
            Requirements: requirements
        };

        fetch('@Url.Action("SaveIndoorRequirements", "ContinuationAffiliationClinicalFacilities")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(payload)
        })
            .then(response => {
                if (!response.ok)
                    throw new Error('Request failed');
                return response.json();
            })
            .then(result => {
                if (result.success) {
                    Swal.fire({
                        icon: "success",
                        title: "saved",
                        text: result.message || 'Indoor Requirements saved successfully',
                        confirmButtonText: 'OK'
                    });
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Failed",
                        text: result.message || 'Failed to save Indoor Requirements',
                        confirmButtonText: 'OK'
                    });
                }
            })
            .catch(error => {
                console.error(error);
                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: 'Error while saving Indoor Requirements data.',
                    confirmButtonText: 'OK'
                })
            });
    }
</script>
