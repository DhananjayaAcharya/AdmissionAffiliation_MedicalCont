@model Medical_Affiliation.Models.MedicalCollegeCourseIntakeViewModel
@{
    ViewData["Title"] = "Course Intake List";
    Layout = "~/Views/Shared/_CaLayout.cshtml";
    var facultyCode = Context.Session.GetString("FacultyCode");
    var selectedLevels = (Context.Session.GetString("ExistingCourseLevels") ?? string.Empty)
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Select(level => level.ToUpperInvariant())
        .ToHashSet();

    var currentCourseLevel = (Model.CourseLevel ?? Context.Session.GetString("SelectedCourseLevel") ?? "UG")
        .Trim()
        .ToUpperInvariant();

    string nextController = "Medical_ContinuousAffiliation";
    string nextAction = "Medical_LandBuildingdetails";

    if (currentCourseLevel == "PG")
    {
        nextController = "pgcourses";
        nextAction = "SubjectSelection";
    }

    string previousController = "ContinuesAffiliation_Facultybased";
    string previousAction = "Aff_HostelDetails";

    if (currentCourseLevel == "PG")
    {
        previousController = "AffiliationPgCourse";
        previousAction = "PgCourses";
    }
    else if (currentCourseLevel == "UG")
    {
        previousController = "ContinuesAffiliation_Facultybased";
        previousAction = "Details_Of_MBBS";
    }
    else if (currentCourseLevel == "SS")
    {
        previousController = "Aff_CA_SS_CoursesAppliedSS";
        previousAction = "CA_SS_CoursesApplied";
    }
    else if (selectedLevels.Contains("SS"))
    {
        previousController = "Aff_CA_SS_CoursesAppliedSS";
        previousAction = "CA_SS_CoursesApplied";
    }
    else if (selectedLevels.Contains("PG"))
    {
        previousController = "AffiliationPgCourse";
        previousAction = "PgCourses";
    }
    else if (selectedLevels.Contains("UG"))
    {
        previousController = "ContinuesAffiliation_Facultybased";
        previousAction = "Details_Of_MBBS";
    }

    var currentControllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var levelLabel = currentCourseLevel switch
    {
        "UG" => "Undergraduate",
        "PG" => "Postgraduate",
        "SS" => "Super Speciality",
        _ => currentCourseLevel
    };

    // Fixed set of allowed "Increased Intake" values shown in the dropdown
    var increasedIntakeOptions = new[] { 50, 100, 150, 200, 250 };
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

<style>
    :root {
        --navy: #102b4c;
        --navy-deep: #0a1c36;
        --blue: #1a4bbd;
        --blue-soft: #eaf1ff;
        --gold: #c9a24b;
        --gold-soft: #f5e7b7;
        --surface: #f2f6fb;
        --card: #ffffff;
        --bdr: #d7e1ee;
        --txt: #1f2d3d;
        --muted: #667b93;
        --ok: #127c5f;
        --ok-bg: #eaf8f3;
        --err: #be3b32;
        --err-bg: #fdeceb;
        --fh: 'Georgia', 'Times New Roman', serif;
        --fb: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        --radius: 10px;
    }

    .course-intake-page {
        min-height: 100%;
        padding: 0 0 2.5rem;
        background: linear-gradient(180deg, #edf3f8 0%, #f7f9fc 100%);
        color: var(--txt);
        font-family: var(--fb);
    }

    .gov-strip {
        height: 5px;
        background: linear-gradient(90deg, var(--navy) 0%, var(--navy) 34%, var(--gold) 34%, var(--gold) 66%, var(--navy) 66%, var(--navy) 100%);
    }

    .page-header {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        padding: 1.25rem 2.2rem;
        background: linear-gradient(135deg, var(--navy) 0%, #173d69 55%, #1d4d84 100%);
        color: #fff;
        border-bottom: 4px solid var(--gold);
        box-shadow: 0 10px 22px rgba(16, 43, 76, 0.08);
    }

    .gov-emblem {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 52px;
        height: 52px;
        background: rgba(255, 255, 255, .12);
        border: 1.5px solid rgba(201, 150, 44, .65);
        border-radius: 50%;
        color: var(--gold);
        font-family: var(--fh);
        font-weight: 900;
        font-size: 1.05rem;
    }

    .page-header-text .eyebrow {
        margin: 0 0 .2rem;
        color: rgba(255, 255, 255, .68);
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .12em;
        text-transform: uppercase;
    }

    .page-header-text h1 {
        margin: 0 0 .6rem;
        font-family: var(--fh);
        font-size: clamp(1.35rem, 2.6vw, 1.85rem);
        font-weight: 900;
        line-height: 1.2;
    }

    .page-meta {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem 1.4rem;
        color: rgba(255, 255, 255, .8);
        font-size: .82rem;
    }

        .page-meta strong {
            color: #fff;
            font-weight: 700;
        }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: .4rem;
        padding: .65rem 2.4rem;
        background: #fff;
        border-bottom: 1px solid var(--bdr);
        color: var(--muted);
        font-size: .78rem;
    }

        .breadcrumb .current {
            color: var(--maroon);
            font-weight: 700;
        }

    .content {
        max-width: 1180px;
        margin: 0 auto;
        padding: 1.6rem 1.4rem 0;
    }

    /* ---------- Alerts ---------- */
    .alert {
        display: flex;
        align-items: center;
        gap: .6rem;
        margin: 0 0 1.1rem;
        padding: .85rem 1.2rem;
        border-radius: 10px;
        font-size: .87rem;
        font-weight: 600;
    }

    .success-msg {
        background: var(--ok-bg);
        border: 1px solid var(--ok);
        color: var(--ok);
    }

    .error-msg {
        background: var(--err-bg);
        border: 1px solid var(--err);
        color: var(--err);
    }

    /* ---------- Card ---------- */
    .card {
        overflow: hidden;
        background: var(--card);
        border: 1px solid var(--bdr);
        border-radius: var(--radius);
        box-shadow: 0 4px 18px rgba(12, 31, 63, .08);
    }

    .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.15rem 1.6rem;
        border-bottom: 1px solid var(--bdr);
        background: #f8f9fd;
    }

    .card-header-text {
        display: flex;
        flex-direction: column;
        gap: .15rem;
    }

        .card-header-text h2 {
            margin: 0;
            color: var(--navy);
            font-family: var(--fh);
            font-size: 1.05rem;
            font-weight: 700;
        }

        .card-header-text span {
            color: var(--muted);
            font-size: .78rem;
        }

    .level-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 90px;
        padding: 0.38rem 0.8rem;
        border-radius: 999px;
        background: var(--blue-soft);
        border: 1px solid rgba(26, 75, 189, 0.18);
        color: var(--blue);
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .table-wrap {
        overflow-x: auto;
        background: var(--card);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: .87rem;
    }

    th {
        position: sticky;
        top: 0;
        padding: .8rem 1rem;
        background: linear-gradient(180deg, #143b67 0%, #0f2d51 100%);
        color: rgba(255, 255, 255, .95);
        font-size: .71rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-align: left;
        text-transform: uppercase;
        white-space: nowrap;
    }

        th:last-child,
        td:last-child {
            text-align: center;
        }

    td {
        padding: .82rem 1.1rem;
        border-bottom: 1px solid var(--bdr);
    }

        td:first-child {
            color: var(--muted);
            font-variant-numeric: tabular-nums;
        }

    tbody tr:nth-child(even) {
        background: #f7f9fd;
    }

    tbody tr:hover {
        background: #eef2fb;
    }

    .course-name {
        color: var(--navy);
        font-weight: 600;
    }

    .intake-value {
        display: inline-block;
        min-width: 2.4rem;
        padding: .15rem .55rem;
        background: var(--ok-bg);
        border-radius: 6px;
        color: var(--ok);
        font-size: .92rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .empty {
        padding: 3rem 1rem;
        color: var(--muted);
        text-align: center;
        font-size: .92rem;
    }

    /* ---------- Fields ---------- */
    .readonly-field {
        width: 110px;
        padding: .45rem .6rem;
        background: #eef1f7;
        border: 1px solid var(--bdr);
        border-radius: 7px;
        color: var(--muted);
        font-family: var(--fb);
        font-size: .85rem;
        text-align: center;
        cursor: not-allowed;
    }

    .editable-field {
        width: 110px;
        padding: .45rem .6rem;
        background: #fff;
        border: 1.5px solid var(--bdr);
        border-radius: 7px;
        color: var(--txt);
        font-family: var(--fb);
        font-size: .85rem;
        font-weight: 600;
        text-align: center;
        transition: border-color .15s, box-shadow .15s;
    }

        .editable-field:focus {
            outline: none;
            border-color: var(--navy-2);
            box-shadow: 0 0 0 3px rgba(20, 49, 94, .14);
        }

    select.editable-field {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path d='M0 0L5 6L10 0Z' fill='%23667b93'/></svg>");
        background-repeat: no-repeat;
        background-position: right .6rem center;
        background-size: .6rem .4rem;
        padding-right: 1.6rem;
        cursor: pointer;
    }

    /* ---------- Buttons ---------- */
    .actions {
        display: flex;
        justify-content: flex-end;
        padding: 1.1rem 1.6rem;
        border-top: 1px solid var(--bdr);
        background: #f8f9fd;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .72rem 1.3rem;
        border: 1px solid transparent;
        border-radius: 8px;
        font-family: var(--fb);
        font-size: .8rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-decoration: none;
        text-transform: uppercase;
        cursor: pointer;
        transition: all .15s ease;
    }

        .btn:active {
            transform: scale(.98);
        }

    .btn-primary {
        background: linear-gradient(135deg, var(--navy) 0%, #1e4f8b 100%);
        color: #fff;
        box-shadow: 0 8px 18px rgba(16, 43, 76, 0.15);
    }

        .btn-primary:hover {
            color: #fff;
            opacity: .96;
        }

    .btn-outline {
        border-color: var(--navy);
        background: #fff;
        color: var(--navy);
    }

        .btn-outline:hover {
            background: #f3f8ff;
            text-decoration: none;
        }

    .page-navigation {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1.3rem;
        padding-top: 0;
    }

    /* ---------- Previous details ---------- */
    .previous-details-card {
        margin-top: 1.4rem;
    }

        .previous-details-card tbody tr:nth-child(even),
        .previous-details-card tbody tr:hover {
            background: transparent;
        }

        .previous-details-card td.merged {
            vertical-align: top;
            border-right: 1px solid var(--bdr);
            background: #fff;
        }

        .previous-details-card .slab-label {
            display: inline-block;
            min-width: 4.5rem;
            padding: .15rem .55rem;
            background: var(--blue-soft);
            border-radius: 6px;
            color: var(--blue);
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

        .previous-details-card input[type=file] {
            max-width: 210px;
            font-size: .78rem;
        }

        .previous-details-card .doc-link {
            display: block;
            margin-bottom: .25rem;
            color: var(--blue);
            font-size: .78rem;
            font-weight: 700;
        }

        .previous-details-card .hint {
            margin: 0;
            padding: .8rem 1.6rem 0;
            color: var(--muted);
            font-size: .76rem;
        }

    @@media (max-width: 768px) {
        .page-header {
            flex-wrap: wrap;
            padding: 1.3rem 1.2rem;
        }

        .breadcrumb {
            padding: .6rem 1.2rem;
        }

        .content {
            padding: 1.2rem .8rem 0;
        }

        .card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .page-navigation {
            align-items: stretch;
            flex-direction: column;
        }

            .page-navigation .actions,
            .page-navigation .btn {
                justify-content: center;
            }

            .page-navigation .actions {
                padding: 0;
                border-top: none;
                background: transparent;
            }

        .readonly-field,
        .editable-field {
            width: 90px;
        }
    }
</style>

<div class="course-intake-page">
    <div class="gov-strip"></div>

    <header class="page-header">
        <div class="gov-emblem">RGUHS</div>
        <div class="page-header-text">
            <p class="eyebrow">Rajiv Gandhi University of Health Sciences &middot; Admission &amp; Affiliation Cell</p>
            <h1>College Course Intake</h1>
            <div class="page-meta">
                <span><strong>College:</strong> @Model.CollegeName</span>
                <span><strong>Code:</strong> @Model.CollegeCode</span>
                <span><strong>Faculty:</strong> @Model.FacultyCode</span>
            </div>
        </div>
    </header>

    <nav class="breadcrumb" aria-label="Breadcrumb">
        <span>Continuous Affiliation</span>
        <span aria-hidden="true">›</span>
        <span>@levelLabel Courses</span>
        <span aria-hidden="true">›</span>
        <span class="current">Course Intake</span>
    </nav>

    <main class="content">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert success-msg">@TempData["SuccessMessage"]</div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert error-msg">@TempData["ErrorMessage"]</div>
        }

        <section class="card">
            <div class="card-header">
                <div class="card-header-text">
                    <h2>Courses and Intake for 2027-28</h2>
                    <span>Sanctioned intake as recorded for the academic year 2026-27</span>
                </div>
                <span class="level-badge">@Model.CourseLevel</span>
            </div>

            @if (Model.Courses.Count == 0)
            {
                <div class="empty">No courses are available for this college and course level.</div>
            }
            else
            {
                <form asp-action="SaveIncreasedIntake" asp-controller="@currentControllerName" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CollegeCode" />
                    <input type="hidden" asp-for="CollegeName" />
                    <input type="hidden" asp-for="FacultyCode" />
                    <input type="hidden" asp-for="CourseLevel" />
                    <input type="hidden" asp-for="ShowIncreasedIntakeFields" />

                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Sl. No.</th>
                                    <th>Course Name</th>
                                    <th>Intake 2026-27</th>
                                    @if (Model.ShowIncreasedIntakeFields)
                                    {
                                        <th>Increasing Intake</th>
                                        <th>Academic Year</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var displaySlno = 1;
                                }
                                @for (var i = 0; i < Model.Courses.Count; i++)
                                {
                                    var course = Model.Courses[i];
                                    <tr>
                                        <td>@displaySlno</td>
                                        <td class="course-name">@course.CourseName</td>
                                        <td><span class="intake-value">@course.Intake2627</span></td>

                                        @if (Model.ShowIncreasedIntakeFields)
                                        {
                                            <td>
                                                <input type="hidden" asp-for="Courses[i].Slno" />
                                                <input type="hidden" asp-for="Courses[i].CourseCode" />
                                                <input type="hidden" asp-for="Courses[i].CourseName" />
                                                <input type="hidden" asp-for="Courses[i].Intake2627" />
                                                <select class="editable-field" asp-for="Courses[i].IncreasedIntake">
                                                    <option value="">Select</option>
                                                    @foreach (var option in increasedIntakeOptions)
                                                    {
                                                        <option value="@option">@option</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <input type="text" readonly
                                                       class="readonly-field"
                                                       asp-for="Courses[i].AcademicYear"
                                                       value="2027-28" />
                                            </td>
                                        }
                                    </tr>
                                    displaySlno++;
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.ShowIncreasedIntakeFields)
                    {
                        <div class="actions">
                            <button type="submit" class="btn btn-primary">Save & Apply</button>
                        </div>
                    }
                </form>
            }
        </section>

        @* ═══════════ Previous details (separate multipart form – must stay outside the form above) ═══════════ *@
        @if (Model.PreviousDetails != null && Model.PreviousDetails.Count > 0)
        {
            var lopYears = Enumerable.Range(1950, DateTime.Now.Year - 1950 + 1).Reverse().ToList();

            <section class="card previous-details-card">
                <div class="card-header">
                    <div class="card-header-text">
                        <h2>Previous details</h2>
                        <span>Enclose previous years notification copies</span>
                    </div>
                    <span class="level-badge">@Model.CourseLevel</span>
                </div>

                <form asp-action="SavePreviousDetails" asp-controller="@currentControllerName"
                      method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <p class="hint">Select the year of obtaining LOP and upload the NMC document (PDF, max 5 MB) for each applicable intake. Leave a row empty if it does not apply.</p>

                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Sl. No.</th>
                                    <th>Course</th>
                                    <th>Intake</th>
                                    <th>Year of obtaining LOP</th>
                                    <th>Selected Year</th>
                                    <th>Upload NMC Doc</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var c = 0; c < Model.PreviousDetails.Count; c++)
                                {
                                    var prevCourse = Model.PreviousDetails[c];

                                    for (var s = 0; s < prevCourse.Slabs.Count; s++)
                                    {
                                        var slab = prevCourse.Slabs[s];
                                        <tr>
                                            @if (s == 0)
                                            {
                                                <td class="merged" rowspan="@prevCourse.Slabs.Count">
                                                    @(c + 1)
                                                    <input type="hidden" asp-for="PreviousDetails[c].CourseCode" />
                                                    <input type="hidden" asp-for="PreviousDetails[c].CourseName" />
                                                </td>
                                                <td class="merged course-name" rowspan="@prevCourse.Slabs.Count">@prevCourse.CourseName</td>
                                            }

                                            <td>
                                                <span class="slab-label">@slab.IntakeSlab</span>
                                                <input type="hidden" asp-for="PreviousDetails[c].Slabs[s].IntakeSlab" />
                                            </td>

                                            <td>
                                                <select class="editable-field" asp-for="PreviousDetails[c].Slabs[s].LopYear">
                                                    <option value="">Select</option>
                                                    @foreach (var y in lopYears)
                                                    {
                                                        <option value="@y">@y</option>
                                                    }
                                                </select>
                                            </td>

                                            <td class="selected-lop-year">
                                                @(slab.LopYear?.ToString() ?? "-")
                                            </td>

                                            <td>
                                                @if (slab.HasDocument)
                                                {
                                                    <a class="doc-link" target="_blank"
                                                       asp-action="ViewPreviousNmcDocument" asp-route-id="@slab.Id">
                                                        View @(string.IsNullOrWhiteSpace(slab.DocumentName) ? "uploaded document" : slab.DocumentName)
                                                    </a>
                                                }
                                                <input type="file" accept="application/pdf"
                                                       asp-for="PreviousDetails[c].Slabs[s].NmcDocument" />
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="actions">
                        <button type="submit" class="btn btn-primary">Save Previous Details</button>
                    </div>
                </form>
            </section>
        }

        <nav class="page-navigation" aria-label="Course intake navigation">
            <div class="actions">
                <a class="btn btn-outline" asp-action="@previousAction" asp-controller="@previousController">
                    <span aria-hidden="true">←</span> Previous
                </a>
            </div>

            <a class="btn btn-primary" asp-controller="@nextController" asp-action="@nextAction">
                Next <span aria-hidden="true">→</span>
            </a>
        </nav>

        <script>
            document.querySelectorAll('select[name$=".LopYear"]').forEach(select => {
                select.addEventListener('change', () => {
                    const selectedYearCell = select.closest('tr').querySelector('.selected-lop-year');
                    selectedYearCell.textContent = select.value || '-';
                });
            });
        </script>
    </main>
</div>
