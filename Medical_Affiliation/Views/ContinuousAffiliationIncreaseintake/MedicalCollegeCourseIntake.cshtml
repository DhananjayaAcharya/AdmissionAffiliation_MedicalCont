@model Medical_Affiliation.Models.MedicalCollegeCourseIntakeViewModel
@{
    ViewData["Title"] = "Course Intake List";
    Layout = "~/Views/Shared/_CaLayout.cshtml";
    var facultyCode = Context.Session.GetString("FacultyCode");
    var selectedLevels = (Context.Session.GetString("ExistingCourseLevels") ?? string.Empty)
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Select(level => level.ToUpperInvariant())
        .ToHashSet();

    var currentCourseLevel = (Model.CourseLevel ?? Context.Session.GetString("SelectedCourseLevel") ?? "UG")
        .Trim()
        .ToUpperInvariant();

    string nextController = "Medical_ContinuousAffiliation";
    string nextAction = "Medical_LandBuildingdetails";

    if (currentCourseLevel == "PG")
    {
        nextController = "pgcourses";
        nextAction = "SubjectSelection";
    }

    string previousController = "ContinuesAffiliation_Facultybased";
    string previousAction = "Aff_HostelDetails";

    if (currentCourseLevel == "PG")
    {
        previousController = "AffiliationPgCourse";
        previousAction = "PgCourses";
    }
    else if (currentCourseLevel == "UG")
    {
        previousController = "ContinuesAffiliation_Facultybased";
        previousAction = "Details_Of_MBBS";
    }
    else if (currentCourseLevel == "SS")
    {
        previousController = "Aff_CA_SS_CoursesAppliedSS";
        previousAction = "CA_SS_CoursesApplied";
    }
    else if (selectedLevels.Contains("SS"))
    {
        previousController = "Aff_CA_SS_CoursesAppliedSS";
        previousAction = "CA_SS_CoursesApplied";
    }
    else if (selectedLevels.Contains("PG"))
    {
        previousController = "AffiliationPgCourse";
        previousAction = "PgCourses";
    }
    else if (selectedLevels.Contains("UG"))
    {
        previousController = "ContinuesAffiliation_Facultybased";
        previousAction = "Details_Of_MBBS";
    }

    var currentControllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var levelLabel = currentCourseLevel switch
    {
        "UG" => "Undergraduate",
        "PG" => "Postgraduate",
        "SS" => "Super Speciality",
        _ => currentCourseLevel
    };

    // Fixed set of allowed "Increased Intake" values shown in the dropdown (UG / SS)
    var increasedIntakeOptions = new[] { 50, 100, 150, 200, 250 };

    // Enhancement of Seats / Increase in Intake + PG  ->  free number entry instead of dropdown.
    // Model.ShowIncreasedIntakeFields is set by the controller from IsEnhancementApplicationSelectedAsync(),
    // i.e. it is true exactly when the application type is "Enhancement of Seats / Increase in Intake".
    var useIntakeTextBox = Model.ShowIncreasedIntakeFields && currentCourseLevel == "PG";

    // Converts any saved value (int, int?, decimal, decimal?, string like "100" or "100.00")
    // to an int so it can be compared with the dropdown option values.
    Func<object, int?> toInt = value =>
    {
        if (value == null) return null;
        var text = Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture);
        return decimal.TryParse(text,
                                System.Globalization.NumberStyles.Any,
                                System.Globalization.CultureInfo.InvariantCulture,
                                out var number)
               ? (int?)Convert.ToInt32(number)
               : null;
    };

    // Summary numbers for the header strip
    var totalCourses = Model.Courses?.Count ?? 0;
    var totalIntake = Model.Courses == null ? 0 : Model.Courses.Sum(c => toInt(c.Intake2627) ?? 0);
    var logoUrl = Url.Content("~/images/newLogo.jpeg");
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=EB+Garamond:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap');

    .ci-page {
        --ink: #1f2937;
        --ink-2: #374151;
        --muted: #6b7280;
        --line: #e5e7eb;
        --line-soft: #eceef1;
        --bg: #f3f4f6;
        --soft: #f9fafb;
        --card: #ffffff;
        --accent: #374151;
        --accent-dark: #1f2937;
        --ok: #1e6b3a;
        --ok-bg: #e9f5ee;
        --err: #b42318;
        --err-bg: #fdecea;
        --shadow: 0 1px 2px rgba(17,24,39,.05), 0 6px 18px rgba(17,24,39,.05);
        --font-serif: 'EB Garamond', Georgia, serif;
        --font-sans: 'DM Sans', -apple-system, 'Segoe UI', sans-serif;
        --pad: clamp(.8rem, 2.2vw, 1.3rem);
        position: relative;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-sans);
        padding: 1rem 0 2rem;
        border-radius: 12px;
    }

        .ci-page *, .ci-page *::before, .ci-page *::after {
            box-sizing: border-box;
        }

        /* logo watermark */
        .ci-page::after {
            content: "";
            position: fixed;
            inset: 0;
            z-index: 5;
            pointer-events: none;
            background: var(--wm) center center / min(480px, 60vw) auto no-repeat;
            opacity: .07;
            mix-blend-mode: multiply;
            filter: grayscale(1);
        }

    .ci-wrap {
        position: relative;
        z-index: 1;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 var(--pad);
    }

    /* ---------- Header ---------- */
    .ci-hero {
        position: relative;
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 16px;
        box-shadow: var(--shadow);
        padding: clamp(1.1rem, 3vw, 1.6rem);
        overflow: hidden;
        margin-bottom: 1rem;
    }

        .ci-hero::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 4px;
            background: linear-gradient(90deg, #374151, #9ca3af, #374151);
        }

    .ci-brand {
        display: flex;
        gap: 1rem;
        align-items: center;
        min-width: 0;
    }

    .ci-logo {
        flex: none;
        width: clamp(56px, 9vw, 80px);
        height: clamp(56px, 9vw, 80px);
        object-fit: contain;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: #fff;
        padding: 5px;
    }

    .ci-eyebrow {
        margin: 0 0 .25rem;
        color: var(--muted);
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .ci-title {
        margin: 0;
        font-family: var(--font-serif);
        font-size: clamp(1.4rem, 3.6vw, 2rem);
        font-weight: 600;
        line-height: 1.2;
        color: var(--ink);
        overflow-wrap: anywhere;
    }

    .ci-chips {
        display: flex;
        flex-wrap: wrap;
        gap: .45rem;
        margin-top: 1rem;
    }

    .ci-chip {
        display: inline-flex;
        gap: .4rem;
        align-items: baseline;
        max-width: 100%;
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: .3rem .8rem;
        font-size: .8rem;
    }

        .ci-chip small {
            color: var(--muted);
            font-size: .72rem;
        }

        .ci-chip b {
            font-weight: 600;
            overflow-wrap: anywhere;
        }

    .ci-crumbs {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .4rem;
        margin: 0 0 1rem;
        color: var(--muted);
        font-size: .8rem;
    }

        .ci-crumbs .current {
            color: var(--ink);
            font-weight: 600;
        }

    /* ---------- Stats ---------- */
    .ci-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .8rem;
        margin-bottom: 1rem;
    }

    .ci-stat {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        box-shadow: var(--shadow);
        padding: .85rem 1rem;
    }

        .ci-stat small {
            display: block;
            color: var(--muted);
            font-size: .74rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .05em;
        }

        .ci-stat b {
            display: block;
            margin-top: .15rem;
            font-family: var(--font-serif);
            font-size: 1.6rem;
            font-weight: 600;
            color: var(--ink);
            font-variant-numeric: tabular-nums;
        }

    /* ---------- Alerts ---------- */
    .ci-alert {
        display: flex;
        align-items: center;
        gap: .6rem;
        margin: 0 0 1rem;
        padding: .8rem 1.1rem;
        border-radius: 12px;
        font-size: .87rem;
        font-weight: 600;
    }

    .ci-ok {
        background: var(--ok-bg);
        border: 1px solid #b7dfc2;
        color: var(--ok);
    }

    .ci-err {
        background: var(--err-bg);
        border: 1px solid #f3c1bc;
        color: var(--err);
    }

    /* ---------- Cards ---------- */
    .ci-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        box-shadow: var(--shadow);
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .ci-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .8rem;
        flex-wrap: wrap;
        padding: .85rem 1.1rem;
        background: linear-gradient(180deg, #fff, #f3f4f6);
        border-bottom: 1px solid var(--line);
    }

        .ci-card-head h2 {
            margin: 0;
            font-family: var(--font-serif);
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--ink);
            display: flex;
            align-items: center;
            gap: .6rem;
        }

            .ci-card-head h2::before {
                content: "";
                width: 4px;
                height: 1.1rem;
                background: #9ca3af;
                border-radius: 2px;
            }

        .ci-card-head span.sub {
            display: block;
            color: var(--muted);
            font-size: .78rem;
            margin-top: .1rem;
        }

    .ci-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 64px;
        padding: .3rem .8rem;
        border-radius: 999px;
        background: var(--accent);
        color: #fff;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .ci-hint {
        margin: 0;
        padding: .8rem 1.1rem 0;
        color: var(--muted);
        font-size: .8rem;
    }

    /* ---------- Tables (horizontal scroll) ---------- */
    .ci-scroll {
        overflow-x: auto;
        max-width: 100%;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: #9ca3af #f3f4f6;
    }

        .ci-scroll::-webkit-scrollbar {
            height: 10px;
        }

        .ci-scroll::-webkit-scrollbar-track {
            background: #f3f4f6;
        }

        .ci-scroll::-webkit-scrollbar-thumb {
            background: #9ca3af;
            border-radius: 999px;
        }

    .ci-table {
        width: 100%;
        min-width: 640px;
        border-collapse: separate;
        border-spacing: 0;
        font-size: .88rem;
        margin: 0;
    }

        .ci-table th {
            padding: .7rem 1rem;
            background: var(--accent);
            color: #fff;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .05em;
            text-align: left;
            text-transform: uppercase;
            white-space: nowrap;
        }

            .ci-table th:first-child {
                border-top-left-radius: 0;
            }

        .ci-table td {
            padding: .75rem 1rem;
            border-bottom: 1px solid var(--line-soft);
            vertical-align: middle;
            background: #fff;
        }

        .ci-table tbody tr:nth-child(even) td {
            background: #fafafa;
        }

        .ci-table tbody tr:hover td {
            background: #f3f4f6;
        }

        .ci-table td:first-child {
            color: var(--muted);
            font-variant-numeric: tabular-nums;
            width: 64px;
        }

        .ci-table .name {
            color: var(--ink);
            font-weight: 600;
            min-width: 200px;
        }

        .ci-table .center {
            text-align: center;
        }

    .ci-pill {
        display: inline-block;
        min-width: 2.6rem;
        padding: .15rem .65rem;
        border-radius: 8px;
        background: var(--ok-bg);
        color: var(--ok);
        font-weight: 700;
        text-align: center;
        font-variant-numeric: tabular-nums;
    }

    .ci-slab {
        display: inline-block;
        min-width: 4.5rem;
        padding: .15rem .65rem;
        border-radius: 8px;
        background: #eef0f3;
        color: var(--ink-2);
        font-weight: 700;
        text-align: center;
        font-variant-numeric: tabular-nums;
    }

    .ci-table td.merged {
        vertical-align: top;
        border-right: 1px solid var(--line-soft);
        background: #fff !important;
    }

    .ci-empty {
        padding: 2.5rem 1rem;
        text-align: center;
        color: var(--muted);
        font-size: .92rem;
    }

    /* ---------- Fields ---------- */
    .ci-field, .ci-readonly {
        width: 120px;
        max-width: 100%;
        padding: .45rem .65rem;
        border-radius: 8px;
        font-family: var(--font-sans);
        font-size: .86rem;
        font-weight: 600;
        text-align: center;
    }

    .ci-field {
        background-color: #fff;
        border: 1.5px solid #d1d5db;
        color: var(--ink);
        transition: border-color .15s, box-shadow .15s;
    }

        .ci-field:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(55,65,81,.15);
        }

    /* number box used for PG enhancement: hide spinner arrows, keep it clean */
    input.ci-field[type=number] {
        -moz-appearance: textfield;
        appearance: textfield;
    }

        input.ci-field[type=number]::-webkit-outer-spin-button,
        input.ci-field[type=number]::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        input.ci-field[type=number]::placeholder {
            color: #9ca3af;
            font-weight: 500;
        }

    .ci-readonly {
        background: #f3f4f6;
        border: 1px solid var(--line);
        color: var(--muted);
        cursor: not-allowed;
    }

    select.ci-field {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        cursor: pointer;
        padding-right: 1.7rem;
        text-align-last: center;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path d='M0 0L5 6L10 0Z' fill='%236b7280'/></svg>");
        background-repeat: no-repeat;
        background-position: right .6rem center;
        background-size: .6rem .4rem;
    }

    .ci-file {
        max-width: 230px;
        font-size: .78rem;
    }

        .ci-file::file-selector-button {
            margin-right: .6rem;
            padding: .35rem .7rem;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            background: #f3f4f6;
            color: var(--ink-2);
            font-weight: 600;
            cursor: pointer;
        }

            .ci-file::file-selector-button:hover {
                background: #e5e7eb;
            }

    .ci-doc-link {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        margin-bottom: .35rem;
        color: var(--accent-dark);
        font-size: .78rem;
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    /* ---------- Buttons ---------- */
    .ci-actions {
        display: flex;
        justify-content: flex-end;
        padding: 1rem 1.1rem;
        border-top: 1px solid var(--line);
        background: var(--soft);
    }

    .ci-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        padding: .65rem 1.3rem;
        border-radius: 10px;
        border: 1px solid transparent;
        font-family: var(--font-sans);
        font-size: .82rem;
        font-weight: 700;
        letter-spacing: .03em;
        text-decoration: none;
        cursor: pointer;
        transition: background .15s, color .15s, transform .1s;
    }

        .ci-btn:active {
            transform: scale(.98);
        }

    .ci-btn-primary {
        background: var(--accent-dark);
        color: #fff;
        border-color: var(--accent-dark);
        box-shadow: 0 6px 14px rgba(17,24,39,.16);
    }

        .ci-btn-primary:hover {
            background: var(--accent);
            color: #fff;
            text-decoration: none;
        }

    .ci-btn-outline {
        background: #fff;
        color: var(--accent);
        border-color: var(--accent);
    }

        .ci-btn-outline:hover {
            background: var(--accent);
            color: #fff;
            text-decoration: none;
        }

    .ci-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .8rem;
        margin-top: .4rem;
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 768px) {
        .ci-stats {
            grid-template-columns: 1fr 1fr;
        }

            .ci-stats .ci-stat:first-child {
                grid-column: 1 / -1;
            }

        .ci-nav {
            flex-direction: column-reverse;
            align-items: stretch;
        }

            .ci-nav .ci-btn {
                width: 100%;
            }

        .ci-actions {
            justify-content: stretch;
        }

            .ci-actions .ci-btn {
                width: 100%;
            }

        .ci-field, .ci-readonly {
            width: 100px;
        }
    }

    @@media (max-width: 480px) {
        .ci-stats {
            grid-template-columns: 1fr;
        }

        .ci-brand {
            align-items: flex-start;
        }
    }

    @@media print {
        .ci-nav, .ci-actions {
            display: none !important;
        }

        .ci-page {
            background: #fff;
        }

        .ci-scroll {
            overflow: visible;
        }
    }
</style>

<div class="ci-page" style="--wm:url('@logoUrl')">
    <div class="ci-wrap">

        <header class="ci-hero">
            <div class="ci-brand">
                <img class="ci-logo" src="@logoUrl" alt="RGUHS logo" />
                <div style="min-width:0">
                    <p class="ci-eyebrow">Rajiv Gandhi University of Health Sciences &middot; Admission &amp; Affiliation Cell</p>
                    <h1 class="ci-title">College Course Intake</h1>
                </div>
            </div>
            <div class="ci-chips">
                <span class="ci-chip"><small>College</small><b>@Model.CollegeName</b></span>
                <span class="ci-chip"><small>Code</small><b>@Model.CollegeCode</b></span>
                <span class="ci-chip"><small>Faculty</small><b>@Model.FacultyCode</b></span>
                <span class="ci-chip"><small>Level</small><b>@levelLabel</b></span>
            </div>
        </header>

        <nav class="ci-crumbs" aria-label="Breadcrumb">
            <span>Continuous Affiliation</span>
            <span aria-hidden="true">›</span>
            <span>@levelLabel Courses</span>
            <span aria-hidden="true">›</span>
            <span class="current">Course Intake</span>
        </nav>

        <div class="ci-stats">
            <div class="ci-stat"><small>Courses</small><b>@totalCourses</b></div>
            <div class="ci-stat"><small>Total intake 2026-27</small><b>@totalIntake</b></div>
            <div class="ci-stat"><small>Applying for</small><b>2027-28</b></div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="ci-alert ci-ok" role="status">@TempData["SuccessMessage"]</div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="ci-alert ci-err" role="alert">@TempData["ErrorMessage"]</div>
        }

        <section class="ci-card">
            <div class="ci-card-head">
                <div>
                    <h2>Courses and Intake for 2027-28</h2>
                    <span class="sub">Sanctioned intake as recorded for the academic year 2026-27</span>
                </div>
                <span class="ci-badge">@Model.CourseLevel</span>
            </div>

            @if (Model.Courses.Count == 0)
            {
                <div class="ci-empty">No courses are available for this college and course level.</div>
            }
            else
            {
                <form asp-action="SaveIncreasedIntake" asp-controller="@currentControllerName" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CollegeCode" />
                    <input type="hidden" asp-for="CollegeName" />
                    <input type="hidden" asp-for="FacultyCode" />
                    <input type="hidden" asp-for="CourseLevel" />
                    <input type="hidden" asp-for="ShowIncreasedIntakeFields" />

                    <div class="ci-scroll">
                        <table class="ci-table">
                            <thead>
                                <tr>
                                    <th>Sl. No.</th>
                                    <th>Course Name</th>
                                    <th class="center">Intake 2026-27</th>
                                    @if (Model.ShowIncreasedIntakeFields)
                                    {
                                        <th class="center">Increasing Intake</th>
                                        <th class="center">Academic Year</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var displaySlno = 1;
                                }
                                @for (var i = 0; i < Model.Courses.Count; i++)
                                {
                                    var course = Model.Courses[i];
                                    var selectedIncreased = toInt(course.IncreasedIntake);
                                    <tr>
                                        <td>@displaySlno</td>
                                        <td class="name">@course.CourseName</td>
                                        <td class="center"><span class="ci-pill">@course.Intake2627</span></td>

                                        @if (Model.ShowIncreasedIntakeFields)
                                        {
                                            <td class="center">
                                                <input type="hidden" asp-for="Courses[i].Slno" />
                                                <input type="hidden" asp-for="Courses[i].CourseCode" />
                                                <input type="hidden" asp-for="Courses[i].CourseName" />
                                                <input type="hidden" asp-for="Courses[i].Intake2627" />

                                                @if (useIntakeTextBox)
                                                {
                                                    @* PG + Enhancement of Seats / Increase in Intake: free number entry *@
                                                    <input type="number"
                                                           class="ci-field"
                                                           name="Courses[@i].IncreasedIntake"
                                                           id="Courses_@(i)__IncreasedIntake"
                                                           value="@(selectedIncreased?.ToString() ?? "")"
                                                           min="0"
                                                           step="1"
                                                           inputmode="numeric"
                                                           placeholder="Enter seats"
                                                           aria-label="Increasing intake for @course.CourseName" />
                                                }
                                                else
                                                {
                                                    @* UG / SS: fixed dropdown. asp-for removed on purpose: selected option is set explicitly so saved values always show *@
                                                    <select class="ci-field"
                                                            name="Courses[@i].IncreasedIntake"
                                                            id="Courses_@(i)__IncreasedIntake"
                                                            aria-label="Increasing intake for @course.CourseName">
                                                        <option value="" selected="@(!selectedIncreased.HasValue)">Select</option>
                                                        @foreach (var option in increasedIntakeOptions)
                                                        {
                                                            <option value="@option" selected="@(selectedIncreased == option)">@option</option>
                                                        }
                                                    </select>
                                                }
                                            </td>
                                            <td class="center">
                                                <input type="text" readonly
                                                       class="ci-readonly"
                                                       asp-for="Courses[i].AcademicYear"
                                                       value="2027-28" />
                                            </td>
                                        }
                                    </tr>
                                    displaySlno++;
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.ShowIncreasedIntakeFields)
                    {
                        <div class="ci-actions">
                            <button type="submit" class="ci-btn ci-btn-primary">Save &amp; Apply</button>
                        </div>
                    }
                </form>
            }
        </section>

        @* ═══════════ Previous details (separate multipart form – must stay outside the form above) ═══════════ *@
        @if (Model.PreviousDetails != null && Model.PreviousDetails.Count > 0)
        {
            var lopYears = Enumerable.Range(1950, DateTime.Now.Year - 1950 + 1).Reverse().ToList();

            <section class="ci-card">
                <div class="ci-card-head">
                    <div>
                        <h2>Previous details</h2>
                        <span class="sub">Enclose previous years notification copies</span>
                    </div>
                    <span class="ci-badge">@Model.CourseLevel</span>
                </div>

                <form asp-action="SavePreviousDetails" asp-controller="@currentControllerName"
                      method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <p class="ci-hint">Select the year of obtaining LOP and upload the NMC document (PDF, max 5 MB) for each applicable intake. Leave a row empty if it does not apply.</p>

                    <div class="ci-scroll" style="margin-top:.8rem">
                        <table class="ci-table" style="min-width:820px">
                            <thead>
                                <tr>
                                    <th>Sl. No.</th>
                                    <th>Course</th>
                                    <th class="center">Intake</th>
                                    <th class="center">Year of obtaining LOP</th>
                                    <th class="center">Selected Year</th>
                                    <th>Upload NMC Doc</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var c = 0; c < Model.PreviousDetails.Count; c++)
                                {
                                    var prevCourse = Model.PreviousDetails[c];

                                    for (var s = 0; s < prevCourse.Slabs.Count; s++)
                                    {
                                        var slab = prevCourse.Slabs[s];
                                        var selectedLopYear = toInt(slab.LopYear);
                                        <tr>
                                            @if (s == 0)
                                            {
                                                <td class="merged" rowspan="@prevCourse.Slabs.Count">
                                                    @(c + 1)
                                                    <input type="hidden" asp-for="PreviousDetails[c].CourseCode" />
                                                    <input type="hidden" asp-for="PreviousDetails[c].CourseName" />
                                                </td>
                                                <td class="merged name" rowspan="@prevCourse.Slabs.Count">@prevCourse.CourseName</td>
                                            }

                                            <td class="center">
                                                <span class="ci-slab">@slab.IntakeSlab</span>
                                                <input type="hidden" asp-for="PreviousDetails[c].Slabs[s].IntakeSlab" />
                                            </td>

                                            <td class="center">
                                                @* asp-for removed on purpose: selected option is set explicitly so saved values always show *@
                                                <select class="ci-field"
                                                        name="PreviousDetails[@c].Slabs[@s].LopYear"
                                                        id="PreviousDetails_@(c)__Slabs_@(s)__LopYear"
                                                        aria-label="Year of obtaining LOP">
                                                    <option value="" selected="@(!selectedLopYear.HasValue)">Select</option>
                                                    @foreach (var y in lopYears)
                                                    {
                                                        <option value="@y" selected="@(selectedLopYear == y)">@y</option>
                                                    }
                                                </select>
                                            </td>

                                            <td class="center selected-lop-year">
                                                @(selectedLopYear?.ToString() ?? "-")
                                            </td>

                                            <td>
                                                @if (slab.HasDocument)
                                                {
                                                    <a class="ci-doc-link" target="_blank"
                                                       asp-action="ViewPreviousNmcDocument" asp-route-id="@slab.Id">
                                                        View @(string.IsNullOrWhiteSpace(slab.DocumentName) ? "uploaded document" : slab.DocumentName)
                                                    </a>
                                                    <br />
                                                }
                                                <input type="file" class="ci-file" accept="application/pdf"
                                                       asp-for="PreviousDetails[c].Slabs[s].NmcDocument" />
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="ci-actions">
                        <button type="submit" class="ci-btn ci-btn-primary">Save Previous Details</button>
                    </div>
                </form>
            </section>
        }

        <nav class="ci-nav" aria-label="Course intake navigation">
            <a class="ci-btn ci-btn-outline" asp-action="@previousAction" asp-controller="@previousController">
                <span aria-hidden="true">←</span> Previous
            </a>
            <a class="ci-btn ci-btn-primary" asp-controller="@nextController" asp-action="@nextAction">
                Next <span aria-hidden="true">→</span>
            </a>
        </nav>

        <script>
                    document.querySelectorAll('select[name$=".LopYear"]').forEach(function (select) {
                        select.addEventListener('change', function () {
                            var cell = select.closest('tr').querySelector('.selected-lop-year');
                            if (cell) cell.textContent = select.value || '-';
                        });
                    });
        </script>
    </div>
</div>
