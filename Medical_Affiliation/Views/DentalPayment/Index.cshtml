
@model Medical_Affiliation.Models.DentalFeeStructureViewModel

@{
    ViewData["Title"] = "Dental Fee Calculation";

    Layout = "~/Views/Shared/_CaLayout.cshtml";

    var allCourseFees = Model.FeeTypes
        .SelectMany(e => e.CourseFees ?? new List<DentalCourseFeeViewModel>())
        .ToList();

    var grandTotal = allCourseFees.Sum(e => e.CalculatedAmount);
}

<style>
    .payment-calculation-page{
        padding: .25rem 0 1.5rem;
    }

    .payment-calculation-heading{
        border-bottom : 1px solid #d8e3fs;
        padding-bottom: 1rem;
        margin-bottom: 1.25rem;
    }

    .payment-calculation-heading h1{
        color: #0f1d3d;
        font-family:'EB Garamond', serif;
        font-size: 1.8rem;
        margin: 0;
    }

    .payment-calculation-heading p{
        color: #7d8aa9;
        margin: .25rem 0 0;
    }

    .payment-panel{
        border: 1px solid #d8e3f5;
        border-radius: 8px;
        background: #fff;
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .payment-panel-header{
        background: #f4f8fd;
        border-bottom: 1px solid #d8e3f5;
        padding: .8rem 1rem;
        color: #0a3d91;
        font-weight: 700;
    }

    .payment-panel-body{
        padding: 1rem;
    }

    .payment-calculation-page .table{
        margin-bottom: 0;
        vertical-align: middle;
    }

    .payment-calculation-page .table th{
        color: #435273;
        font-size: .76rem;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .fee-type-row{
        background: #f8f9fa;
        font-weight: 700;
        color: #0a3d91;
    }

    .summary-row{
        background: #f4f8fd;
        font-weight: 700;
    }

</style>

<div class="payment-calculation-page">

    @* PAGE HEADING *@

    <div class="payment-calculation-heading">

        <h1>
            <i class="bi bi-cash-coin me-2" aria-hidden="true"></i>
            Dental Fee Calculation
        </h1>

        <p>
            Review the applicable affiliation fee based on the selected affiliation type and course level.
        </p>
    </div>

    <!-- ============================================
         APPLICABLE COURSES
    ============================================= -->

    @if (allCourseFees.Any())
    {
        <div class="payment-panel">
            <div class="payment-panel-header">
                Applicable Courses
                (@allCourseFees.Select(e=> e.CourseCode).Distinct().Count())
            </div>

            <div class="payment-panel-body table-responsive">
                <table class="table table-bordered table-sm">
                    <thead class="table-light">
                        <tr>
                            <th>Course Name</th>
                            <th>Course Level</th>
                            <th class="text-end">Academic Intake 2026</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var course in allCourseFees.GroupBy(e => e.CourseCode).Select(e => e.First()))
                        {
                            <tr>
                                <td>
                                    @course.CourseName
                                </td>
                                <td>
                                    @course.CourseLevel
                                </td>
                                <td class="text-end">
                                    @course.AcademicIntake2026
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ============================================
         FEE BREAKDOWN
    ============================================= -->

    <div class="payment-panel">

        <div class="payment-panel-header">
            Fee Breakdown
        </div>

        <div class="payment-panel-body table-responsive">

            <table class="table table-bordered table-sm">
                <thead class="table-light">
                    <tr>
                        <th>Fee Head</th>
                        <th>Course</th>
                        <th>Course Level</th>
                        <th class="text-end">
                            Intake
                        </th>
                        <th class="text-end">Unit Amount </th>
                        <th>Basics</th>
                        <th class="text-end">
                            Line Amount
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var feeType in Model.FeeTypes
                    .OrderBy(e => e.DisplayOrder))
                    {
                        @if(feeType.CourseFees != null &&
                            feeType.CourseFees.Any() )
                        {
                            @foreach(var fee in feeType.CourseFees)
                            {
                                var multiplier = string.Equals(fee.CalculationType, "Per Seat", StringComparison.OrdinalIgnoreCase) ? fee.AcademicIntake2026 : 1;

                                <tr>
                                    <td>
                                        @feeType.FeeType
                                    </td>
                                    <td>@fee.CourseName</td>
                                    <td>@fee.CourseLevel</td>
                                    <td class="text-end">
                                        @fee.AcademicIntake2026
                                    </td>

                                    <td class="text-end">
                                        ₹ @fee.AmountToBePaid.GetValueOrDefault().ToString("N2")
                                    </td>
                                    <td>
                                        @if(string.Equals(fee.CalculationType, "Per Course", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span>Per Course</span>
                                        }
                                        else if(string.Equals(fee.CalculationType, "Per Seat", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span>Per Seat</span>
                                        }
                                        else
                                        {
                                            <span>
                                                Fixed
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        @multiplier
                                    </td>

                                    <td class="text-end">
                                        ₹ @fee.CalculatedAmount.ToString("N2")
                                    </td>
                                </tr>
                            }
                        }
                    }

                    @if (!allCourseFees.Any())
                    {
                        <tr>
                            <td class="text-center text-muted" colspan="8">
                                No applicable fee structure found for this affiliation type and course level.
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr class="table-secondary fw-bold">
                        <td class="text-end" colspan="7">
                            Grand Total
                        </td>

                        <td class="text-end">
                            ₹ @grandTotal.ToString("N2")
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>


    <!-- ============================================
         SUMMARY
    ============================================= -->

    @if (allCourseFees.Any())
    {
        <div class="payment-panel">
            <div class="payment-panel-header">
                Summary
            </div>

            <div class="payment-panel-body">
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <strong>Affiliation Type: </strong>
                        <br />
                        @Model.AffiliationCategory
                    </div>

                    <div class="col-md-4 mb-2">
                        <strong>
                            Applicable Courses: 
                        </strong>
                        <br />
                        @allCourseFees.Select(e => e.CourseCode).Distinct().Count()
                    </div>

                    <div class="col-md-4 mb-2">
                        <strong>Grand Total: </strong>
                        <br />
                        ₹ @grandTotal.ToString("N2")
                    </div>
                </div>
            </div>
        </div>

    }

</div>