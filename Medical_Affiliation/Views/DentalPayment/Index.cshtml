</style>

<div class="payment-calculation-page">

    @* PAGE HEADING *@

    <div class="payment-calculation-heading">

        <h1>
            <i class="bi bi-cash-coin me-2" aria-hidden="true"></i>
            Dental Fee Calculation
        </h1>

        <p>
            Review the applicable affiliation fee based on the selected affiliation type and course level.
        </p>
    </div>

    <!-- ============================================
         APPLICABLE COURSES
    ============================================= -->
    @if (applicableCourses.Any())
    {
        <div class="payment-panel">

            <div class="payment-panel-header">
                Applicable Courses (@applicableCourseCount)
            </div>

            <div class="payment-panel-body table-responsive">

                <table class="table table-bordered table-sm">

                    <thead class="table-light">
                        <tr>
                            <th>Course Name</th>
                            <th>Course Level</th>
                            <th class="text-end">
                                Academic Intake 2026
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var course in applicableCourses
                            .OrderBy(e => e.CourseName))
                        {
                            <tr>

                                <td>
                                    @course.CourseName
                                </td>

                                <td>
                                    @course.CourseLevel
                                </td>

                                <td class="text-end">
                                    @course.Ay2026TotalIntake
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="payment-panel">

            <div class="payment-panel-header">
                Applicable Courses
            </div>

            <div class="payment-panel-body">

                <div class="text-center text-muted py-3">
                    No courses found for the selected course level.
                </div>

            </div>

        </div>
    }
    <!-- ============================================
         FEE BREAKDOWN
    ============================================= -->

    <div class="payment-panel">

        <div class="payment-panel-header">
            Fee Breakdown
        </div>

        <div class="payment-panel-body table-responsive">

            <table class="table table-bordered table-sm">
                <thead class="table-light">
                    <tr>
                        <th>Fee Head</th>
                        <th>Course</th>
                        <th>Course Level</th>
                        <th class="text-end">
                            Intake
                        </th>
                        <th class="text-end">Unit Amount </th>
                        <th>Basis</th>
                        <th class="text-end">
                            Multiplier
                        </th>
                        <th class="text-end">
                            Line Amount
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var feeType in Model.FeeTypes
                    .OrderBy(e => e.DisplayOrder))
                    {
                        @if(feeType.CourseFees != null &&
                            feeType.CourseFees.Any() )
                        {
                            @foreach(var fee in feeType.CourseFees)
                            {
                                var multiplier = string.Equals(fee.CalculationType, "Per Seat", StringComparison.OrdinalIgnoreCase) ? fee.AcademicIntake2026 : 1;

                                <tr>
                                    <td>
                                        @feeType.FeeType
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(fee.CourseName))
                                        {
                                            @fee.CourseName
                                        }
                                        else
                                        {
                                            <span class="text-muted">All @fee.CourseLevel Courses</span>
                                        }
                                    </td>
                                    <td>@fee.CourseLevel</td>
                                    <td class="text-end">
                                        @if (string.Equals(
                                            fee.CalculationType,
                                            "Per Seat",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            @fee.AcademicIntake2026
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        ₹ @fee.AmountToBePaid.GetValueOrDefault().ToString("N2")
                                    </td>
                                    <td>
                                        @if(string.Equals(fee.CalculationType, "Per Course", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span>Per Course</span>
                                        }
                                        else if(string.Equals(fee.CalculationType, "Per Seat", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span>Per Seat</span>
                                        }
                                        else
                                        {
                                            <span>
                                                Fixed
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        @multiplier
                                    </td>

                                    <td class="text-end">
                                        ₹ @fee.CalculatedAmount.ToString("N2")
                                    </td>
                                </tr>
                            }
                        }
                    }

                    @if (!allCourseFees.Any())
                    {
                        <tr>
                            <td class="text-center text-muted" colspan="8">
                                No applicable fee structure found for this affiliation type and course level.
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr class="table-secondary fw-bold">
                        <td class="text-end" colspan="7">
                            Grand Total
                        </td>

                        <td class="text-end">
                            ₹ @grandTotal.ToString("N2")
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <form asp-action="Index"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="AffiliationTypeId"
               value="@Model.AffiliationTypeId" />


        <!-- =========================================
         PAYMENT / TRANSACTION DETAILS
    ========================================= -->

        <div class="payment-panel transaction-panel">

            <!-- PANEL HEADER -->
            <div class="payment-panel-header d-flex align-items-center">

                <i class="bi bi-credit-card me-2"></i>

                <span>
                    Transaction Details
                </span>

            </div>


            <!-- PANEL BODY -->
            <div class="payment-panel-body">


                <!-- =====================================
                 PAYMENT INFORMATION
            ====================================== -->

                <div class="transaction-form-card">

                    <div class="transaction-form-heading">

                        <div>

                            <h6>
                                Payment Information
                            </h6>

                            <p>
                                Enter the transaction reference and
                                upload the payment receipt.
                            </p>

                        </div>


                        <!-- TOTAL PAYABLE -->
                        <div class="transaction-amount-badge">

                            <span>
                                Total Payable
                            </span>

                            <strong>
                                ₹ @grandTotal.ToString("N2")
                            </strong>

                        </div>

                    </div>


                    <!-- =====================================
                     TRANSACTION INPUTS
                ====================================== -->

                    <div class="row g-3 mt-1">

                        <!-- TRANSACTION ID -->

                        <div class="col-md-6">

                            <label class="form-label">
                                Transaction ID
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="TransactionId"
                                   value="@Model.TransactionId"
                                   placeholder="Enter transaction ID"
                                   autocomplete="off"
                                   required />

                        </div>


                        <!-- AMOUNT PAID -->

                        <div class="col-md-6">

                            <label class="form-label">
                                Amount Paid
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    ₹
                                </span>

                                <input type="text"
                                       class="form-control"
                                       name="AmountPaid"
                                       value="@(Model.AmountPaid > 0
                                                                        ? Model.AmountPaid.ToString("N2")
                                                                        : grandTotal.ToString("N2"))"
                                       readonly />

                            </div>

                            <small class="text-muted">
                                Amount is calculated automatically.
                            </small>

                        </div>

                    </div>

                </div>


                <!-- =====================================
                 RECEIPT SECTION
            ====================================== -->

                <div class="receipt-section mt-4">

                    <div class="receipt-section-heading">

                        <div>

                            <label class="form-label mb-1">
                                Transaction Receipt
                                <span class="text-danger">*</span>
                            </label>

                            <div class="receipt-help-text">
                                Upload the receipt generated after payment.
                            </div>

                        </div>

                    </div>


                    <!-- =====================================
                     UPLOAD BOX
                ====================================== -->

                    <label class="receipt-upload-box"
                           for="TransactionReceipt">

                        <div class="receipt-upload-icon">

                            <i class="bi bi-cloud-arrow-up"></i>

                        </div>


                        <div class="receipt-upload-content">

                            <div class="receipt-upload-title">

                                Upload Payment Receipt

                            </div>

                            <div class="receipt-upload-subtitle">

                                PDF, JPG or PNG

                                <span class="receipt-dot">
                                    •
                                </span>

                                Maximum 1 MB

                            </div>

                        </div>


                        <input type="file"
                               id="TransactionReceipt"
                               name="TransactionReceipt"
                               accept=".pdf,.jpg,.jpeg,.png"
                               hidden />

                    </label>


                    <!-- =====================================
                     SELECTED FILE
                ====================================== -->

                    <div id="selectedFileName"
                         class="receipt-file-name">

                        <div class="selected-file-info">

                            <i class="bi bi-file-earmark-x"
                               id="selectedFileIcon"></i>

                            <span id="selectedFileText">
                                No file selected
                            </span>

                        </div>


                        <button type="button"
                                id="removeSelectedFile"
                                class="remove-file-btn"
                                title="Remove selected file"
                                style="display:none;">

                            <i class="bi bi-x-lg"></i>

                        </button>

                    </div>


                    <!-- =====================================
                     EXISTING RECEIPT
                ====================================== -->
                    @if (!string.IsNullOrWhiteSpace(Model.TransactionReceiptPath)
                                        && Model.PaymentId.HasValue)
                    {
                        <div class="receipt-existing">

                            <div class="receipt-existing-icon">

                                <i class="bi bi-check-circle-fill"></i>

                            </div>


                            <div class="receipt-existing-content">

                                <strong>
                                    Receipt already uploaded
                                </strong>

                                <span>
                                    A payment receipt is available
                                    for this transaction.
                                </span>

                            </div>


                            <a href="javascript:void(0);"
                               class="receipt-view-btn"
                               onclick="openReceiptViewer(@Model.PaymentId)">

                                <i class="bi bi-eye me-1"></i>
                                View Receipt

                            </a>

                        </div>
                    }

                </div>

            </div>


            <!-- =========================================
             PANEL FOOTER
        ========================================== -->

            <div class="transaction-panel-footer">

                <button type="submit"
                        class="btn btn-primary transaction-submit-btn">

                    <i class="bi bi-check-circle me-2"></i>

                    Save & Submit Payment

                </button>

            </div>

        </div>

    </form>

    <div class="modal fade"
         id="receiptViewerModal"
         tabindex="-1"
         aria-labelledby="receiptViewerModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-xl modal-dialog-centered">

            <div class="modal-content receipt-viewer-modal">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="receiptViewerModalLabel">

                        <i class="bi bi-file-earmark-text me-2"></i>
                        Transaction Receipt

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <div class="modal-body p-0"
                     id="receiptViewerContainer">

                    <div class="receipt-viewer-loading">

                        <div class="spinner-border"
                             role="status">

                            <span class="visually-hidden">
                                Loading...
                            </span>

                        </div>

                        <span>
                            Loading receipt...
                        </span>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>
@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const fileInput =
                document.getElementById("TransactionReceipt");

            const fileText =
                document.getElementById("selectedFileText");

            const removeButton =
                document.getElementById("removeSelectedFile");

            const fileIcon =
                document.getElementById("selectedFileIcon");


            // ==========================================
            // FILE SELECTED
            // ==========================================

            fileInput.addEventListener("change", function() {

                if (this.files && this.files.length > 0) {

                    const file = this.files[0];

                    // ----------------------------------
                    // CHECK FILE SIZE
                    // Maximum 1 MB
                    // ----------------------------------

                    if (file.size > 1024 * 1024) {

                        alert(
                            "File size should not exceed 1 MB."
                        );

                        this.value = "";

                        fileText.textContent =
                            "No file selected";

                        removeButton.style.display =
                            "none";

                        return;
                    }


                    // ----------------------------------
                    // SHOW FILE NAME
                    // ----------------------------------

                    fileText.textContent =
                        file.name;

                    removeButton.style.display =
                        "flex";

                    fileIcon.className =
                        "bi bi-file-earmark-check"
                }

            });


            // ==========================================
            // REMOVE SELECTED FILE
            // ==========================================

            removeButton.addEventListener("click", function() {

                fileInput.value = "";

                fileText.textContent =
                    "No file selected";

                removeButton.style.display =
                    "none";

                fileIcon.className =
                    "bi bi-file-earmark-x"

            });

        });

        function openReceiptViewer(paymentId) {

            const container =
                document.getElementById(
                    "receiptViewerContainer"
                );

            container.innerHTML = `
                    <div class="receipt-viewer-loading">

                        <div class="spinner-border"
                             role="status">
                        </div>

                        <span>
                            Loading receipt...
                        </span>

                    </div>
                `;

            const modalElement =
                document.getElementById(
                    "receiptViewerModal"
                );

            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    modalElement
                );

            modal.show();

            fetch(
                '@Url.Action("ViewReceipt", "DentalPayment")'
                + '?paymentId='
                + paymentId
            )
                .then(response => {

                    if (!response.ok) {
                        throw new Error(
                            "Unable to load receipt."
                        );
                    }

                    return response.text();
                })
                .then(html => {

                    container.innerHTML = html;

                })
                .catch(error => {

                    container.innerHTML = `
                        <div class="alert alert-danger m-3">
                            ${error.message}
                        </div>
                    `;

                });
        }
    </script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: '@Html.Raw(TempData["SuccessMessage"])',
                confirmButtonText: 'OK'
            });
        </script>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: '@Html.Raw(TempData["ErrorMessage"])',
                confirmButtonText: 'OK'
            });
        </script>
    }

}