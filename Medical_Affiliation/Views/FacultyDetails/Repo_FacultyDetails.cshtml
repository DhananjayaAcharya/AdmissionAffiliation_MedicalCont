@model IReadOnlyList<Medical_Affiliation.Models.ApiFacultyViewModel>

@{
    Layout = "~/Views/Shared/_CaLayout.cshtml";
    ViewData["Title"] = "Faculty Details";
    var collegeCode = ViewBag.CollegeCode as string ?? "";
}

<style>
    .faculty-page {
        max-width: 1500px;
        margin: 0 auto;
    }

    .faculty-intro {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

        .faculty-intro h1 {
            margin: 0;
            color: #102a43;
            font-size: clamp(1.35rem, 2vw, 1.9rem);
            font-weight: 700;
        }

        .faculty-intro p {
            margin: .35rem 0 0;
            color: #627d98;
            font-size: .9rem;
        }

    .college-code {
        color: #1769aa;
        font-weight: 700;
        font-size: .85rem;
        white-space: nowrap;
    }

    .faculty-caution {
        display: flex;
        align-items: flex-start;
        gap: .65rem;
        margin-bottom: 1.25rem;
        padding: .9rem 1rem;
        border: 1px solid #f0c36d;
        border-left: 4px solid #d9822b;
        border-radius: 8px;
        background: #fff8e8;
        color: #6b4f1d;
        font-size: .9rem;
        line-height: 1.5;
    }

    .faculty-caution i {
        color: #d9822b;
        font-size: 1.05rem;
        margin-top: .1rem;
    }

    .faculty-caution a {
        color: #1769aa;
        font-weight: 700;
    }

    .faculty-panel {
        border: 1px solid #d9e2ec;
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 8px 24px rgba(16, 42, 67, .07);
    }

    .faculty-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: .9rem 1.1rem;
        background: #f7f9fc;
        border-bottom: 1px solid #d9e2ec;
    }

        .faculty-panel-head strong {
            color: #243b53;
        }

    .department-group-row td {
        padding: .7rem 1rem;
        background: #eaf2fb;
        border-top: 2px solid #c9d9ea;
        border-bottom: 1px solid #c9d9ea;
        color: #102a43;
        font-size: .82rem;
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .department-group-count {
        float: right;
        color: #627d98;
        font-size: .75rem;
        font-weight: 600;
        letter-spacing: 0;
        text-transform: none;
    }

    .faculty-count {
        color: #627d98;
        font-size: .82rem;
    }

    .faculty-table-wrap {
        overflow-x: auto;
    }

    .faculty-table {
        width: 100%;
        min-width: 950px;
        border-collapse: collapse;
        color: #243b53;
        font-size: .86rem;
    }

        .faculty-table th {
            padding: .8rem .95rem;
            background: #102a43;
            color: #fff;
            text-align: left;
            font-size: .72rem;
            letter-spacing: .04em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .faculty-table td {
            padding: .85rem .95rem;
            border-bottom: 1px solid #e6edf3;
            vertical-align: middle;
        }

        .faculty-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .faculty-table tbody tr:hover {
            background: #f7fbff;
        }

    .faculty-name {
        font-weight: 700;
        color: #102a43;
    }

    .faculty-id {
        color: #829ab1;
        font-size: .76rem;
    }

    .faculty-photo {
        width: 58px;
        height: 70px;
        object-fit: cover;
        border: 1px solid #d9e2ec;
        border-radius: 6px;
        background: #f7f9fc;
    }

    .faculty-photo-empty {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 58px;
        height: 70px;
        border: 1px solid #d9e2ec;
        border-radius: 6px;
        color: #829ab1;
        font-size: .72rem;
        text-align: center;
    }

    .contact {
        color: #486581;
        white-space: nowrap;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        color: #147d64;
        font-weight: 700;
    }

        .status::before {
            content: '';
            width: .45rem;
            height: .45rem;
            border-radius: 50%;
            background: currentColor;
        }

        .status.declared {
            color: #9a6700;
        }

    .id-doc {
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .empty-state {
        padding: 3rem 1rem;
        text-align: center;
        color: #627d98;
    }

        .empty-state i {
            display: block;
            margin-bottom: .75rem;
            color: #9fb3c8;
            font-size: 2rem;
        }

    @@media (max-width: 600px) {
        .faculty-intro {
            align-items: start;
            flex-direction: column;
        }

        .faculty-panel-head {
            align-items: start;
            flex-direction: column;
        }
    }
</style>

<section class="faculty-page" aria-labelledby="faculty-heading">
    <div class="faculty-intro">
        <div>
            <h1 id="faculty-heading">Faculty Details</h1>

    <div class="faculty-caution" role="note">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <div>
            <strong>Faculty addition is mandatory.</strong>
            Please use the following link to add or update faculty details:
            <a href="https://rguhsaca.karnataka.gov.in/admissionaffiliation/UGFaculty/AddFaculty" target="_blank" rel="noopener noreferrer">
                Add or Update Faculty Details
            </a>
        </div>
    </div>
            <p>Faculty directory for the registered institution</p>
        </div>
        <div class="college-code">College code: @collegeCode</div>
    </div>

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-warning" role="alert"><i class="bi bi-exclamation-triangle me-2"></i>@errorMessage</div>
    }

    <div class="faculty-panel">
        <div class="faculty-panel-head">
            <strong><i class="bi bi-people me-2"></i>Faculty Directory</strong>
            <span class="faculty-count">@Model.Count record@(Model.Count == 1 ? "" : "s")</span>
        </div>
        @if (Model.Count == 0)
        {
            <div class="empty-state"><i class="bi bi-person-lines-fill"></i>No faculty records found for this college.</div>
        }
        else
        {
            <div class="faculty-table-wrap">
                <table class="faculty-table">
                    <thead>
                        <tr>
                            <th>Slno</th>
                            <th>Photo</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Designation</th>
                            <th>DOB</th>
                            <th>Appointment Date</th>
                            <th>Aadhaar No.</th>
                            <th>PAN No.</th>
                            <th>Qualification</th>
                            <th>Employment</th>
                            <th>Experience</th>
                            <th>Mobile / Email</th>
                            <th>Council Reg. No.</th>
                            <th>AEBAS ID</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var serialNumber = 0; }
                        @foreach (var departmentGroup in Model
                            .GroupBy(faculty => string.IsNullOrWhiteSpace(faculty.Department) ? "Unassigned Department" : faculty.Department)
                            .OrderBy(group => group.Key))
                        {
                            <tr class="department-group-row">
                                <td colspan="16">
                                    <i class="bi bi-diagram-3 me-2"></i>@departmentGroup.Key
                                    <span class="department-group-count">@departmentGroup.Count() record@(departmentGroup.Count() == 1 ? "" : "s")</span>
                                </td>
                            </tr>

                            @foreach (var faculty in departmentGroup)
                            {
                                serialNumber++;
                                <tr>
                                <td>@serialNumber</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(faculty.PhotoFilePath))
                                    {
                                        <img class="faculty-photo" src="@Url.Action("ViewFacultyPhoto", "FacultyDetails", new { id = faculty.Id })" alt="Photo of @faculty.Name" />
                                    }
                                    else
                                    {
                                        <span class="faculty-photo-empty">No photo</span>
                                    }
                                </td>
                                <td><div class="faculty-name">@faculty.Name</div><div class="faculty-id">ID: @faculty.Id</div></td>
                                <td>@faculty.Department</td>
                                <td>@faculty.Designation</td>
                                <td>@(string.IsNullOrWhiteSpace(faculty.Dob) ? "—" : faculty.Dob)</td>
                                <td>@(string.IsNullOrWhiteSpace(faculty.DateOfAppointment) ? "—" : faculty.DateOfAppointment)</td>
                                <td class="id-doc">@(string.IsNullOrWhiteSpace(faculty.AadhaarNo) ? "—" : faculty.AadhaarNo)</td>
                                <td class="id-doc">@(string.IsNullOrWhiteSpace(faculty.PanNo) ? "—" : faculty.PanNo)</td>
                                <td>@(string.IsNullOrWhiteSpace(faculty.ProfessionalQualification) ? "—" : faculty.ProfessionalQualification)</td>
                                <td>@(string.IsNullOrWhiteSpace(faculty.NatureOfEmployment) ? "—" : faculty.NatureOfEmployment)</td>
                                <td>@(string.IsNullOrWhiteSpace(faculty.TeachingExpInYrs) ? "—" : faculty.TeachingExpInYrs)</td>
                                <td class="contact">@faculty.Mobile<br />@faculty.Email</td>
                                <td>@(string.IsNullOrWhiteSpace(faculty.StateCouncilRegNo) ? "—" : faculty.StateCouncilRegNo)</td>
                                <td>@(string.IsNullOrWhiteSpace(faculty.AebasAttendId) ? "—" : faculty.AebasAttendId)</td>
                                <td>
                                    <span class="status @(faculty.Status == "Declared" ? "declared" : "")">@faculty.Status</span>
                                </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>