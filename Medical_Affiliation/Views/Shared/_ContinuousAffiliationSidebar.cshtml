@* Views/Shared/_ContinuousAffiliationSidebar.cshtml *@
@using Medical_Affiliation.DATA
@inject IHttpContextAccessor HttpContextAccessor
@inject ApplicationDbContext _context
@using System.Text.Json
@using Microsoft.EntityFrameworkCore

@{
    var collegeCode = HttpContextAccessor.HttpContext.Session.GetString("CollegeCode");
    var collegeName = HttpContextAccessor.HttpContext.Session.GetString("CollegeName");
    var facultyCode = Context.Session.GetString("FacultyCode");

    // FIX: removed Session.GetString("AffiliationType") from this chain.
    // AffiliationType is stored via Session.SetInt32(), never as a string.
    // Reading an int-backed key with GetString() decodes the raw bytes as
    // UTF8 and returns garbled non-null/non-whitespace text, which
    // short-circuited the ?? chain and skipped the int-based DB lookup below.
    var typeOfAffiliation = HttpContextAccessor.HttpContext?.Session?.GetString("TypeOfAffiliation")
    ?? HttpContextAccessor.HttpContext?.Request?.Cookies["TypeOfAffiliation"]
    ?? HttpContextAccessor.HttpContext?.User?.FindFirst("TypeOfAffiliation")?.Value;

    if (string.IsNullOrWhiteSpace(typeOfAffiliation))
    {
        var typeId = HttpContextAccessor.HttpContext?.Session?.GetInt32("AffiliationType");
        if (!typeId.HasValue)
        {
            var typeIdString = HttpContextAccessor.HttpContext?.Session?.GetString("TypeOfAffiliationId")
                               ?? HttpContextAccessor.HttpContext?.Request?.Cookies["AffiliationTypeId"];
            if (!string.IsNullOrWhiteSpace(typeIdString) && int.TryParse(typeIdString, out var parsedId))
            {
                typeId = parsedId;
            }
        }

        if (typeId.HasValue)
        {
            typeOfAffiliation = await _context.TypeOfAffiliations
                .Where(t => t.TypeId == typeId.Value)
                .Select(t => t.TypeDescription)
                .FirstOrDefaultAsync();
        }
    }

    // ------------------------------------------------------------------
    // Determine the course levels (UG / PG / SS) offered by this college
    // so we can show/hide level-specific steps.
    // ------------------------------------------------------------------
    var levels = await (
        from ai in _context.AcademicIntakes
        join mc in _context.MstCourses on ai.Courses equals mc.CourseCode.ToString()
        where ai.CollegeCode == collegeCode && ai.FacultyCode == facultyCode
        select mc.CourseLevel
    ).Distinct().ToListAsync();

    var selectedLevel = Context.Session.GetString("SelectedCourseLevel")?.ToLower();

    bool ShowUgTab = selectedLevel == "ug";
    bool ShowPgTab = selectedLevel == "pg";
    bool ShowSSTab = selectedLevel == "ss";

    var selectedCourseCode = Context.Request.Query["courseCode"].ToString();
    if (string.IsNullOrWhiteSpace(selectedCourseCode))
    {
        selectedCourseCode = Context.Session.GetString("CourseCode");
    }

    bool hasSelectedCourse = !string.IsNullOrWhiteSpace(selectedCourseCode);

    // fallback from AcademicIntake
    if (!levels.Any())
    {
        levels = await (
            from ai in _context.AcademicIntakes
            join cm in _context.MstCourses on ai.Courses equals cm.CourseCode.ToString()
            where ai.CollegeCode == collegeCode
                  && ai.Ay2026TotalIntake > 0
                  && !string.IsNullOrEmpty(ai.Courses)
            select cm.CourseLevel
        ).Distinct().ToListAsync();
    }

    levels = levels
        .Where(l => !string.IsNullOrWhiteSpace(l))
        .Select(l => l.Trim().ToUpperInvariant())
        .Distinct()
        .ToList();

    var selectedCourseLevel = HttpContextAccessor.HttpContext?.Session?.GetString("CourseLevel")?.Trim().ToUpperInvariant();

    var institutionRecord = await _context.AffInstitutionsDetails
        .AsNoTracking()
        .FirstOrDefaultAsync(x =>
            x.CollegeCode == collegeCode &&
            x.FacultyCode == facultyCode &&
            (string.IsNullOrWhiteSpace(selectedCourseLevel) || x.CourseLevel == selectedCourseLevel));

    string? organizationCategory = null;
    if (institutionRecord != null && int.TryParse(institutionRecord.TypeOfInstitution, out var selectedTypeId) && selectedTypeId > 0)
    {
        organizationCategory = await _context.MstInstitutionTypes
            .AsNoTracking()
            .Where(x => x.InstitutionTypeId == selectedTypeId)
            .Select(x => x.OrganizationCategory)
            .FirstOrDefaultAsync();
    }

    bool showTrustSteps = true;
    if (!string.IsNullOrWhiteSpace(organizationCategory))
    {
        showTrustSteps = string.Equals(organizationCategory.Trim(), "P", StringComparison.OrdinalIgnoreCase);
    }

    var doneSteps = _context.CaProgresses
        .Where(x => x.CollegeCode == collegeCode
                    && levels.Contains(x.CourseLevel.Trim().ToUpper())
                    && x.IsCompleted == true)
        .Select(x => x.StepKey)
        .ToList();

    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // ==================================================================
    // STEP DEFINITION — flat list, grouped for display via `Group`
    // ==================================================================
    var allSteps = new List<StepItem>
    {
        // ---- Basic Details ----
        new StepItem{ Key="Institution", Label="Institution Details", Group="Basic Details", Ctrl="ContinuesAffiliation_Facultybased", Act="Institution_Details" },
        // Trust pages are shown only for private/other private-like institutions.
        showTrustSteps ? new StepItem{ Key="TrustDetails", Label="Trust Details", Group="Basic Details", Ctrl="ContinuesAffiliation_Facultybased", Act="Aff_InstituteDetails" } : null,
        showTrustSteps ? new StepItem{ Key="TrustMemberDetails", Label="Trust Member Details", Group="Basic Details", Ctrl="ContinuesAffiliation_Facultybased", Act="Aff_TrustMemberDetails" } : null,
        // MBBS/BDS course-details step is inserted dynamically below based on faculty + level
        new StepItem{ Key="DeanDetails", Label="Dean / Director Details", Group="Basic Details", Ctrl="ContinuesAffiliation_Facultybased", Act="Dean_DirectorDetails" },
        new StepItem{ Key="PrincipalDetails", Label="Principal Details", Group="Basic Details", Ctrl="ContinuesAffiliation_Facultybased", Act="Aff_PrincipalDetails" },

        // ---- Intake Details ----
        new StepItem{ Key="IntakeDetails", Label="Course-wise Intake Details", Group="Intake Details", Ctrl="ContinuousAffiliationIncreaseintake", Act="IncreaseIntake" },
        new StepItem{ Key="CourseSubjectSelection", Label="Select Subject", Group="Coursewise Application(Form-B)", Ctrl="pgcourses", Act="SubjectSelection", Levels = new List<string>{ "PG" } },
        // Course-specific Form-B tabs are shown only after a course is selected.
        // The `courseCode` can come from query string or from session state.
        hasSelectedCourse ? new StepItem{ Key="CourseGeneralDetails", Label="Course General Details", Group="Coursewise Application(Form-B)", Ctrl="pgcourses", Act="GeneralDetails", Levels = new List<string>{ "PG" } } : null,
        hasSelectedCourse ? new StepItem{ Key="CourseInfrastructureDetails", Label="Infrastructure Details", Group="Coursewise Application(Form-B)", Ctrl="pgcourses", Act="InfrastructureDetails", Levels = new List<string>{ "PG" } } : null,
        hasSelectedCourse ? new StepItem{ Key="CourseSummaryDetails", Label="Course Summary Details", Group="Coursewise Application(Form-B)", Ctrl="pgcourses", Act="SummaryDetails", Levels = new List<string>{ "PG" } } : null,
        hasSelectedCourse ? new StepItem{ Key="CourseAcademicActivities", Label="Academic Activities", Group="Coursewise Application(Form-B)", Ctrl="pgcourses", Act="AcademicActivities", Levels = new List<string>{ "PG" } } : null,
        hasSelectedCourse ? new StepItem{ Key="CourseServicesWorkload", Label="Services & Workload", Group="Coursewise Application(Form-B)", Ctrl="pgcourses", Act="ServicesWorkload", Levels = new List<string>{ "PG" } } : null,
        hasSelectedCourse ? new StepItem{ Key="CourseStaffDetails", Label="Staff Details", Group="Coursewise Application(Form-B)", Ctrl="pgcourses", Act="StaffDetails", Levels = new List<string>{ "PG" } } : null,
        // new StepItem{ Key="SsCoursesOffered", Label="Affiliation – SS Courses", Group="Intake Details", Ctrl="AffiliationSS", Act="CoursesOffered", Levels = new List<string>{ "SS" } },

        // ---- Physical Infrastructure ----
        new StepItem{ Key="EquipmentMaster", Label="Additional Equipment Details", Group="Physical Infrastructure", Ctrl="Medical_ContinuousAffiliation", Act="Medical_EquipmentMaster" },
        new StepItem{ Key="ClinicalFacilities", Label="Clinical Facilities", Group="Physical Infrastructure", Ctrl="ContinuationAffiliationClinicalFacilities", Act="ClinicalFacilities" },
        new StepItem{ Key="BedDistribution", Label="Bed Distribution", Group="Physical Infrastructure", Ctrl="ContinuesAffiliation_Facultybased", Act="MedicalUGBedDistribution" },
        new StepItem{ Key="DepartmentUnits", Label="Department / Clinics / Labs", Group="Physical Infrastructure", Ctrl="Medical_ContinuousAffiliation", Act="Medical_DepartmentOfficesAndEducationalUnit" },
        new StepItem{ Key="Hostel", Label="Hostel Details", Group="Physical Infrastructure", Ctrl="ContinuesAffiliation_Facultybased", Act="Aff_HostelDetails" },
        new StepItem{ Key="AssociatedInstitutions", Label="Associated Institutions", Group="Physical Infrastructure", Ctrl="AffiliationSS", Act="AssociatedInstitutions" },

        // ================= ACADEMIC & ADMIN =================v v  v
        new StepItem{ Key="AcademicMatters", Label="UG Academic Performance", Group="Academic & Admin", Ctrl="CA_Aff_AcademicMatters", Act="AcademicMatters", Levels = new List<string>{ "UG" } },
        new StepItem{ Key="PGAcademicMatters", Label="PG Academic Performance", Group="Academic & Admin", Ctrl="CA_Aff_AcademicMatters", Act="AcademicMattersPG", Levels = new List<string>{ "PG" } },
        new StepItem{ Key="Finance", Label="Financial Details", Group="Academic & Admin", Ctrl="Aff_CA_Med_FinanceDetails", Act="Med_CA_AccountAndFeeDetails" },
        new StepItem{ Key="StaffDetails", Label="Staff Particular Details", Group="Academic & Admin", Ctrl="CA_Med_StaffDetails", Act="CA_Med_StaffDetails" },

        // ---- Research & Library ----
        new StepItem{ Key="LibraryServices", Label="Library Services", Group="Research & Library", Ctrl="CA_Aff_MedicalLibrary", Act="MedicalLibrary" },
        new StepItem{ Key="Research", Label="Research & Publications", Group="Research & Library", Ctrl="CA_Med_ResearchPublications", Act="CA_Med_ResearchPublicationsDetails" },
        new StepItem{ Key="Library", Label="Library Details", Group="Research & Library", Ctrl="Aff_CA_MedicalLibrary", Act="Aff_CA_Medical_LibraryDetails" },

        // ---- Human Resources ----
        new StepItem{ Key="FacultyDetails", Label="Faculty Details", Group="Human Resources", Ctrl="FacultyDetails", Act="Repo_FacultyDetails" },
        new StepItem{ Key="NonTeachingStaff", Label="Non-Teaching Staff Dept Wise", Group="Human Resources", Ctrl="ContinuesAffiliation_Facultybased", Act="NonTeachingStaffDepartmentwise" },

        // ---- Final Preview ----
        new StepItem{ Key="PreviewMode", Label="Preview", Group="Final Preview", Ctrl="CAPreview", Act="Preview" },
    };

    // ------------------------------------------------------------------
    // FIX: Remove any null entries (from the conditional TrustDetails /
    // TrustMemberDetails steps above) IMMEDIATELY, before any FindIndex,
    // Insert, or lambda that reads x.Key touches this list. Doing this
    // filtering later (as before) caused a NullReferenceException because
    // FindIndex(x => x.Key == "...") evaluates the lambda against every
    // element — including the literal nulls added when showTrustSteps
    // was false.
    // ------------------------------------------------------------------
    allSteps = allSteps.Where(step => step != null).ToList();

    // ------------------------------------------------------------------
    // Faculty-specific insertions (Dental = facultyCode "2")
    // ------------------------------------------------------------------
    bool isDental = facultyCode == "2";

    // Classroom & Laboratory (placed relative to "EquipmentMaster")
    var skillsIndex = allSteps.FindIndex(x => x.Key == "EquipmentMaster");
    if (skillsIndex < 0) skillsIndex = allSteps.Count;

    allSteps.Insert(skillsIndex, isDental
        ? new StepItem { Key = "DentalSkillsLab", Label = "Classroom & Laboratory", Group = "Physical Infrastructure", Ctrl = "PhysicalInfrastructure", Act = "DentalSkillsLaboratory" }
        : new StepItem { Key = "SkillsLab", Label = "Classroom & Laboratory", Group = "Physical Infrastructure", Ctrl = "Medical_ContinuousAffiliation", Act = "Medical_SkillsLaboratory" });

    // Vehicle Details — inserted right after Equipment for Dental, appended at the end otherwise
    if (isDental)
    {
        var vehicleIndex = allSteps.FindIndex(x => x.Key == "EquipmentMaster");
        if (vehicleIndex >= 0)
        {
            allSteps.Insert(vehicleIndex + 1, new StepItem { Key = "Vehicle", Label = "Vehicle Details", Group = "Physical Infrastructure", Ctrl = "Aff_AHS_ContinousApplication", Act = "CA_VehicleDetails" });
        }
    }
    else
    {
        allSteps.Add(new StepItem { Key = "Vehicle", Label = "Vehicle Details", Group = "Physical Infrastructure", Ctrl = "Aff_AHS_ContinousApplication", Act = "CA_VehicleDetails" });
    }

    // Land & Building — placed just before the Classroom/Lab step
    var landInsertIndex = allSteps.FindIndex(x => x.Key == (isDental ? "DentalSkillsLab" : "SkillsLab"));
    if (landInsertIndex < 0) landInsertIndex = allSteps.Count;

    allSteps.Insert(landInsertIndex, isDental
        ? new StepItem { Key = "LandBuilding", Label = "Land & Building", Group = "Physical Infrastructure", Ctrl = "PhysicalInfrastructure", Act = "DentalCollegeLandBuildingDetail" }
        : new StepItem { Key = "LandBuilding", Label = "Land & Building", Group = "Physical Infrastructure", Ctrl = "Medical_ContinuousAffiliation", Act = "Medical_LandBuildingdetails" });

    // Teaching Staff Dept Wise — placed just before Non-Teaching Staff
    var nonTeachingIndex = allSteps.FindIndex(x => x.Key == "NonTeachingStaff");
    if (nonTeachingIndex < 0) nonTeachingIndex = allSteps.Count;

    allSteps.Insert(nonTeachingIndex, isDental
        ? new StepItem { Key = "TeachingStaff", Label = "Teaching Staff Dept Wise", Group = "Human Resources", Ctrl = "Dental", Act = "TeachingStaffDepartmentWise" }
        : new StepItem { Key = "TeachingStaff", Label = "Teaching Staff Dept Wise", Group = "Human Resources", Ctrl = "ContinuesAffiliation_Facultybased", Act = "TeachingStaffDepartmentWise" });

    // Equipment Details / Equipment List
    var equipmentIndex = allSteps.FindIndex(x => x.Key == "EquipmentMaster");
    if (equipmentIndex < 0) equipmentIndex = allSteps.Count;

    allSteps.Insert(equipmentIndex, isDental
        ? new StepItem { Key = "DentalEquipmentDetails", Label = "Equipment List", Group = "Physical Infrastructure", Ctrl = "Dental", Act = "EquipmentList" }
        : new StepItem { Key = "EquipmentDetails", Label = "Equipment Details", Group = "Physical Infrastructure", Ctrl = "Medical_ContinuousAffiliation", Act = "Medical_EquimentDetails" });

    // UG course-details step (MBBS for Medical, BDS for Dental)
    if (levels.Contains("UG") && facultyCode == "1" && ShowUgTab)
    {
        allSteps.Insert(1, new StepItem { Key = "MBBSDetails", Label = "Details of MBBS Course", Group = "Intake Details", Ctrl = "ContinuesAffiliation_Facultybased", Act = "Details_Of_MBBS", Levels = new List<string> { "UG" } });
    }
    else if (levels.Contains("UG") && isDental)
    {
        allSteps.Insert(1, new StepItem { Key = "BDSDetails", Label = "Details of BDS Course", Group = "Intake Details", Ctrl = "ContinuesAffiliation_Facultybased", Act = "Ug_Course_Details", Levels = new List<string> { "UG" } });
    }

    // Faculty Repository (Dental only)
    if (isDental)
    {
        var intakeIndex = allSteps.FindIndex(x => x.Key == "IntakeDetails");
        if (intakeIndex >= 0)
        {
            allSteps.Insert(intakeIndex + 1, new StepItem { Key = "DentalFacultyDetails", Label = "Faculty Repository", Group = "Intake Details", Ctrl = "DentalRepository", Act = "TeachingFacultyDetails" });
        }
    }

    // ✅ Add PG-specific steps
    if (ShowPgTab)
    {
        var pgSteps = new List<StepItem>
        {
            // new
            // {
            //     Key = "PgCoursesOffered",
            //     Label = "Courses Offered",
            //     Group = "PG Details",
            //     Ctrl = "AffiliationPgCourse",
            //     Act = "PgCourses"
            // },
            new StepItem
            {
                Key = "PgCourses",
                Label = "PG Course Details",
                Group = "Intake Details",
                Ctrl = "AffiliationPgCourse",
                Act = "PgCourses",
            },
        };

        // 👉 Find last index of "Basic Details"
        var lastBasicIndex = allSteps
            .Select((step, index) => new { step, index })
            .Where(x => x.step.Group == "Basic Details")
            .Select(x => x.index)
            .LastOrDefault();

        // 👉 Insert AFTER Basic Details
        allSteps.InsertRange(lastBasicIndex + 1, pgSteps);
    }

    void InsertAfterBasicDetails(List<StepItem> newSteps)
    {
        var lastBasicIndex = allSteps
            .Select((step, index) => new { step, index })
            .Where(x => x.step.Group == "Basic Details")
            .Select(x => x.index)
            .LastOrDefault();

        if (lastBasicIndex >= 0)
            allSteps.InsertRange(lastBasicIndex + 1, newSteps);
    }

    // PG-specific step
    if (levels.Contains("PG") && ShowPgTab)
    {
        InsertAfterBasicDetails(new List<StepItem>
        {
            new StepItem { Key = "PgCourses", Label = "PG Course Affiliation", Group = "Intake Details", Ctrl = "AffiliationPgCourse", Act = "PgCourses", Levels = new List<string>{ "PG" } },
        });
    }

    // Super Specialty (SS)-specific step
    if (levels.Contains("SS") && ShowSSTab)
    {
        InsertAfterBasicDetails(new List<StepItem>
        {
            new StepItem { Key = "SsCoursesApplied", Label = "Super Specialty Courses", Group = "Intake Details", Ctrl = "Aff_CA_SS_CoursesAppliedSS", Act = "CA_SS_CoursesApplied", Levels = new List<string>{ "SS" } },
        });
    }

    // Insert Additional Courses step when either:
    // - the user previously selected the 'Additional' affiliation type, OR
    // - the current route is CourseAffiliation/Index (so the step remains visible when the user reloads the page)
    var sessionTypeOfAff = typeOfAffiliation;
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";

    bool isAdditionalCoursesType = !string.IsNullOrWhiteSpace(sessionTypeOfAff) &&
                                        sessionTypeOfAff.IndexOf("Additional", StringComparison.OrdinalIgnoreCase) >= 0;

    bool isOnAdditionalCoursesPage = currentController.Equals("CourseAffiliation", StringComparison.OrdinalIgnoreCase) &&
                                      currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase);

    if (isAdditionalCoursesType || isOnAdditionalCoursesPage)
    {
        InsertAfterBasicDetails(new List<StepItem>
        {
            new StepItem { Key = "AdditionalCourses", Label = "Additional Courses", Group = "Intake Details", Ctrl = "CourseAffiliation", Act = "Index" },
        });
    }

    // Filter out steps that don't apply to the selected course level and the college's offered levels
    allSteps = allSteps
        .Where(step =>
            step.Levels == null
            || step.Levels.Count == 0
            || step.Levels.Any(l =>
                levels.Contains(l)
                && (string.IsNullOrEmpty(selectedCourseLevel) || l.Equals(selectedCourseLevel, StringComparison.OrdinalIgnoreCase))
            ))
        .ToList();

    // Progress % excludes the "Course-wise Intake Details" step
    var progressSteps = allSteps.Where(s => s.Key != "IntakeDetails").ToList();
    int total = progressSteps.Count;
    int done = progressSteps.Count(s => doneSteps.Contains(s.Key));
    int pct = total > 0 ? (int)Math.Round((double)done / total * 100) : 0;

    if (isDental)
    {
        // Chair Distribution — right after Classroom & Laboratory
        var chairIndex = allSteps.FindIndex(x => x.Key == "DentalSkillsLab");
        if (chairIndex >= 0)
        {
            allSteps.Insert(chairIndex + 1, new StepItem { Key = "ChairDistribution", Label = "Chair Distribution", Group = "Physical Infrastructure", Ctrl = "PhysicalInfrastructure", Act = "ChairDistribution" });
        }

        // Associated Institutions is not applicable to Dental
        allSteps = allSteps.Where(x => x.Key != "AssociatedInstitutions").ToList();

        // --- Final display order fix-ups for Dental ---
        var physicalOrder = new List<string>
        {
            "ClinicalFacilities", "LandBuilding", "DentalSkillsLab", "ChairDistribution",
            "BedDistribution", "Hostel", "DepartmentUnits", "DentalEquipmentDetails",
            "EquipmentMaster", "Vehicle"
        };

        var physicalSteps = allSteps.Where(x => x.Group == "Physical Infrastructure").ToList();
        var orderedPhysicalSteps = physicalOrder.Select(key => physicalSteps.FirstOrDefault(x => x.Key == key)).Where(x => x != null).ToList();
        var remainingPhysicalSteps = physicalSteps.Where(x => !physicalOrder.Contains(x.Key)).ToList();

        allSteps.RemoveAll(x => x.Group == "Physical Infrastructure");
        var insertAt = allSteps.FindIndex(x => x.Group != "Basic Details" && x.Group != "Intake Details");
        if (insertAt < 0) insertAt = allSteps.Count;
        allSteps.InsertRange(insertAt, orderedPhysicalSteps.Concat(remainingPhysicalSteps));

        // Move Course-wise Intake Details into Basic Details as the first step
        var intakeStep = allSteps.FirstOrDefault(x => x.Key == "IntakeDetails");
        if (intakeStep != null)
        {
            allSteps.Remove(intakeStep);
            intakeStep.Group = "Basic Details";
            allSteps.Insert(0, intakeStep);
        }

        var intakeOrder = new List<string> { "BDSDetails", "PgCourses", "SsCoursesApplied", "DentalFacultyDetails" };
        var intakeSteps = allSteps.Where(x => x.Group == "Intake Details").ToList();
        var orderedIntakeSteps = intakeOrder.Select(key => intakeSteps.FirstOrDefault(x => x.Key == key)).Where(x => x != null).ToList();
        var remainingIntakeSteps = intakeSteps.Where(x => !intakeOrder.Contains(x.Key)).ToList();

        allSteps.RemoveAll(x => x.Group == "Intake Details");
        var basicLastIndex = allSteps
            .Select((step, index) => new { step, index })
            .Where(x => x.step.Group == "Basic Details")
            .Select(x => x.index)
            .LastOrDefault();
        allSteps.InsertRange(basicLastIndex + 1, orderedIntakeSteps.Concat(remainingIntakeSteps));
    }

    var groupedSteps = allSteps.GroupBy(s => s.Group).ToList();
}
<link rel="stylesheet" href="~/css/common-form.css" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600&family=DM+Sans:wght@300;400;500;600&display=swap');

    :root {
        --ca-navy: #0a3d91;
        --ca-navy-light: #1d5fd6;
        --ca-ink: #0f1d3d;
        --ca-text: #435273;
        --ca-muted: #7d8aa9;
        --ca-faint: #a3b0c9;
        --ca-border: #d8e3f5;
        --ca-bg-tint: #f4f8fd;
        --ca-accent-bg: #eaf2ff;
        --ca-accent-bg-strong: #d6e6fc;
        --ca-success: #157347;
        --ca-radius-sm: 6px;
        --ca-radius-md: 8px;
    }

    /* ══════════════════════════════
                                   CA SIDEBAR
      ══════════════════════════════ */
    .ca-sb {
        width: 18vw;
        min-width: 260px;
        max-width: 340px;
        min-height: 100vh;
        height: 100vh;
        background: #ffffff;
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        font-family: 'DM Sans', sans-serif;
        position: sticky;
        top: 0;
        overflow-y: auto;
        border-right: 1px solid var(--ca-border);
    }

        .ca-sb::-webkit-scrollbar {
            width: 6px;
        }

        .ca-sb::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 999px;
        }

    /* Brand */
    .ca-sb-top {
        padding: 20px 18px 14px;
        border-bottom: 1px solid var(--ca-border);
        flex-shrink: 0;
    }

    .ca-sb-title {
        font-family: 'EB Garamond', serif;
        font-size: 1.15rem;
        color: var(--ca-ink);
        font-weight: 600;
        letter-spacing: 0.3px;
        line-height: 1.3;
    }

    .ca-sb-subtitle {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ca-muted);
        margin-top: 4px;
    }

    .ca-sb-affiliation {
        margin-top: 4px;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--ca-navy);
    }

    /* Progress */
    .ca-sb-prog {
        padding: 14px 18px 12px;
        border-bottom: 1px solid var(--ca-border);
        flex-shrink: 0;
        background: var(--ca-bg-tint);
    }

    .ca-sb-prog-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 6px;
    }

    .ca-sb-prog-lbl {
        font-size: 0.6rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ca-muted);
    }

    .ca-sb-prog-pct {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--ca-navy);
        font-variant-numeric: tabular-nums;
    }

    .ca-sb-track {
        height: 5px;
        background: var(--ca-border);
        border-radius: 999px;
        overflow: hidden;
    }

    .ca-sb-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--ca-navy), var(--ca-navy-light));
        transition: width 0.4s ease;
    }

    .ca-sb-prog-note {
        font-size: 0.62rem;
        color: var(--ca-faint);
        text-align: right;
        margin-top: 5px;
    }

    /* Accordion / nav groups */
    .accordion-container {
        width: 100%;
        flex: 1;
        overflow: visible;
        padding-bottom: 8px;
    }

        .accordion-container::-webkit-scrollbar {
            width: 6px;
        }

        .accordion-container::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 999px;
        }

    .accordion-item {
        background: transparent;
        border-bottom: 1px solid var(--ca-border);
    }

    .accordion-header {
        font-size: 0.86rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--ca-text);
        padding: 12px 18px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        border: none;
        width: 100%;
        text-align: left;
        font-family: 'DM Sans', sans-serif;
        transition: color 0.15s;
    }

        .accordion-header:hover {
            color: var(--ca-navy);
        }

        .accordion-header:focus-visible {
            outline: 2px solid var(--ca-navy);
            outline-offset: -2px;
        }

        .accordion-header.active-tab {
            color: var(--ca-navy);
            font-weight: 700;
        }

            .accordion-header.active-tab .toggle-icon {
                transform: rotate(180deg);
                color: var(--ca-navy);
            }

    .toggle-icon {
        margin-left: auto;
        font-size: 0.75rem;
        color: var(--ca-muted);
        transition: transform 0.3s ease;
    }

    .accordion-header:hover .toggle-icon {
        color: var(--ca-navy);
    }

    .accordion-group-badge {
        font-size: 0.62rem;
        font-weight: 700;
        color: var(--ca-muted);
        background: var(--ca-bg-tint);
        border: 1px solid var(--ca-border);
        border-radius: 999px;
        padding: 1px 7px;
        font-variant-numeric: tabular-nums;
    }

    .accordion-content {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
    }

    /* Step link */
    .ca-sb-nav-list {
        list-style: none;
        margin: 0;
        padding: 4px 0 8px;
    }

    .ca-sb-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 18px 8px 22px;
        text-decoration: none;
        color: var(--ca-text);
        font-size: 0.82rem;
        font-weight: 500;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
        border-left: 3px solid transparent;
    }

        .ca-sb-link:hover {
            background: var(--ca-accent-bg);
            color: var(--ca-navy);
            text-decoration: none;
        }

        .ca-sb-link:focus-visible {
            outline: 2px solid var(--ca-navy);
            outline-offset: -2px;
        }

        .ca-sb-link.is-active {
            background: var(--ca-accent-bg-strong);
            border-left-color: var(--ca-navy);
            color: var(--ca-navy);
            font-weight: 700;
            padding-left: 19px;
        }

    /* Step dot */
    .ca-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.58rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .ca-dot-done {
        background: var(--ca-success);
        color: #fff;
    }

    .ca-dot-current {
        background: var(--ca-navy);
        color: #fff;
        box-shadow: 0 0 0 3px rgba(29, 95, 214, 0.18);
    }

    .ca-dot-pending {
        background: #f1f5f9;
        border: 1.5px solid #cbd5e1;
        color: var(--ca-faint);
    }

    .ca-sb-check {
        font-size: 0.7rem;
        color: var(--ca-success);
        margin-left: auto;
        flex-shrink: 0;
    }

    .ca-sb-label {
        flex: 1;
    }

    /* Footer */
    .ca-sb-footer {
        padding: 12px 18px;
        border-top: 1px solid var(--ca-border);
        flex-shrink: 0;
        background: var(--ca-bg-tint);
        text-align: center;
    }

    .ca-sb-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--ca-navy);
        text-decoration: none;
        padding: 6px 10px;
        border-radius: var(--ca-radius-sm);
        transition: background 0.15s, color 0.15s;
    }

        .ca-sb-back:hover {
            background: var(--ca-accent-bg);
            text-decoration: none;
            color: var(--ca-navy);
        }

        .ca-sb-back:focus-visible {
            outline: 2px solid var(--ca-navy);
            outline-offset: 2px;
        }

    @@media (max-width: 991px) {
        .ca-sb {
            width: 100%;
            max-width: none;
            min-height: auto;
            height: auto;
            position: static;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ca-sb-fill,
        .accordion-content,
        .toggle-icon,
        .ca-sb-link {
            transition: none;
        }
    }
</style>

<aside class="ca-sb" aria-label="Continuous affiliation navigation">

    <div class="ca-sb-top">
        <div class="ca-sb-title">College Details</div>
        <div class="ca-sb-subtitle">Type of Affiliation</div>
        <div class="ca-sb-affiliation">@(string.IsNullOrWhiteSpace(typeOfAffiliation) ? "Not available" : typeOfAffiliation)</div>
    </div>

    <div class="ca-sb-prog">
        <div class="ca-sb-prog-top">
            <span class="ca-sb-prog-lbl">Completion</span>
            <span class="ca-sb-prog-pct">@pct%</span>
        </div>
        <div class="ca-sb-track" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" aria-label="Application completion">
            <div class="ca-sb-fill" style="width:@pct%"></div>
        </div>
        <div class="ca-sb-prog-note">@done of @total steps completed</div>
    </div>

    <nav class="accordion-container" aria-label="Application steps">
        @foreach (var group in groupedSteps)
        {
            var groupId = group.Key.Replace(" ", "");
            var groupDone = group.Count(s => doneSteps.Contains(s.Key));
            var groupTotal = group.Count();

            <div class="accordion-item">
                <button type="button"
                        class="accordion-header tab-header"
                        id="header-@groupId"
                        data-tab="@groupId"
                        aria-expanded="false"
                        aria-controls="content-@groupId"
                        onclick="toggleAccordion('@groupId')">
                    <span>@group.Key</span>
                    <span class="accordion-group-badge">@groupDone/@groupTotal</span>
                    <i class="bi bi-chevron-down toggle-icon" aria-hidden="true"></i>
                </button>

                <div class="accordion-content tab-content"
                     id="content-@groupId"
                     role="region"
                     aria-labelledby="header-@groupId"
                     data-tab-content="@groupId">
                    <ul class="ca-sb-nav-list">
                        @foreach (var step in group)
                        {
                            var isActive = string.Equals(currentCtrl, step.Ctrl, StringComparison.OrdinalIgnoreCase)
                                           && string.Equals(currentAct, step.Act, StringComparison.OrdinalIgnoreCase);
                            var isDone = doneSteps.Contains(step.Key);

                            string dotCls = isActive ? "ca-dot ca-dot-current" : isDone ? "ca-dot ca-dot-done" : "ca-dot ca-dot-pending";
                            string linkCls = "ca-sb-link" + (isActive ? " is-active" : "");

                            <li>
                                @{
                                    var routeValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary();
                                    var currentCourseCode = Context?.Request?.Query["courseCode"].ToString();
                                    var currentTypeOfAffiliation = Context?.Request?.Query["typeOfAffiliation"].ToString();
                                    if (string.IsNullOrEmpty(currentCourseCode))
                                    {
                                        currentCourseCode = Context?.Session?.GetString("CourseCode");
                                    }
                                    if (string.IsNullOrEmpty(currentTypeOfAffiliation))
                                    {
                                        currentTypeOfAffiliation = Context?.Session?.GetString("TypeOfAffiliation")
                                            ?? Context?.Session?.GetString("SelectedTypeOfAffiliation");
                                    }
                                    if (!string.IsNullOrEmpty(currentCourseCode)) routeValues["courseCode"] = currentCourseCode;
                                    if (!string.IsNullOrEmpty(currentTypeOfAffiliation)) routeValues["typeOfAffiliation"] = currentTypeOfAffiliation;
                                }
                                <a href="@Url.Action(step.Act, step.Ctrl, routeValues)"
                                   class="@linkCls"
                                   aria-current="@(isActive ? "page" : null)">
                                    <span class="@dotCls" aria-hidden="true">
                                        @if (isDone)
                                        {
                                            <text>&#10003;</text>
                                        }
                                    </span>
                                    <span class="ca-sb-label">@step.Label</span>
                                    @if (isDone && !isActive)
                                    {
                                        <span class="ca-sb-check" aria-hidden="true">&#10003;</span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </nav>

    <div class="ca-sb-footer">
        <a asp-action="Dashboard" asp-controller="Collegelogin" class="ca-sb-back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Back to Dashboard
        </a>
    </div>

</aside>

<script>
    function toggleAccordion(groupId) {
        const currentContent = document.querySelector(`[data-tab-content="${groupId}"]`);
        const currentHeader = document.querySelector(`[data-tab="${groupId}"]`);
        const isOpen = currentHeader.classList.contains("active-tab");

        document.querySelectorAll(".tab-content").forEach(c => c.style.maxHeight = null);
        document.querySelectorAll(".tab-header").forEach(h => {
            h.classList.remove("active-tab");
            h.setAttribute("aria-expanded", "false");
        });

        if (isOpen) {
            sessionStorage.removeItem("activeTab");
            return;
        }

        sessionStorage.setItem("activeTab", groupId);

        if (currentContent) {
            currentContent.style.maxHeight = currentContent.scrollHeight + "px";
        }
        if (currentHeader) {
            currentHeader.classList.add("active-tab");
            currentHeader.setAttribute("aria-expanded", "true");
        }
    }

    // Auto-open the group containing the active step (or the last opened group)
    window.addEventListener("DOMContentLoaded", function () {
        let activeTab = sessionStorage.getItem("activeTab");

        if (!activeTab) {
            const activeLink = document.querySelector(".ca-sb-link.is-active");
            if (activeLink) {
                const parent = activeLink.closest(".tab-content");
                if (parent) {
                    activeTab = parent.getAttribute("data-tab-content");
                }
            }
        }

        if (activeTab && document.querySelector(`[data-tab="${activeTab}"]`)) {
            toggleAccordion(activeTab);
        }
    });
</script>
