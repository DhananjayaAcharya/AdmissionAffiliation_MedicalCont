@* Views/Shared/_CaLayout.cshtml *@
@inject IHttpContextAccessor HttpContextAccessor
@inject Medical_Affiliation.DATA.ApplicationDbContext _context
@using Microsoft.EntityFrameworkCore
@{
    var CollegeName = HttpContextAccessor.HttpContext?.Session?.GetString("CollegeName")
        ?? HttpContextAccessor.HttpContext?.User?.Identity?.Name;
    var CollegeCode = HttpContextAccessor.HttpContext?.Session?.GetString("CollegeCode")
        ?? HttpContextAccessor.HttpContext?.User?.FindFirst("CollegeCode")?.Value;

    // FIX: removed Session.GetString("AffiliationType") from this chain.
    // AffiliationType is stored via Session.SetInt32(), never as a string.
    // Reading an int key with GetString() returns garbled non-null text
    // (raw bytes decoded as UTF8), which short-circuited the ?? chain and
    // prevented the int-based lookup below from ever running.
    var typeOfAffiliation = HttpContextAccessor.HttpContext?.Session?.GetString("TypeOfAffiliation")
    ?? HttpContextAccessor.HttpContext?.Request?.Cookies["TypeOfAffiliation"]
    ?? HttpContextAccessor.HttpContext?.User?.FindFirst("TypeOfAffiliation")?.Value;

    if (string.IsNullOrWhiteSpace(typeOfAffiliation))
    {
        var typeId = HttpContextAccessor.HttpContext?.Session?.GetInt32("AffiliationType");
        if (!typeId.HasValue)
        {
            var typeIdString = HttpContextAccessor.HttpContext?.Session?.GetString("TypeOfAffiliationId")
                               ?? HttpContextAccessor.HttpContext?.Request?.Cookies["AffiliationTypeId"];
            if (!string.IsNullOrWhiteSpace(typeIdString) && int.TryParse(typeIdString, out var parsedId))
            {
                typeId = parsedId;
            }
        }

        if (typeId.HasValue)
        {
            typeOfAffiliation = await _context.TypeOfAffiliations
                .Where(t => t.TypeId == typeId.Value)
                .Select(t => t.TypeDescription)
                .FirstOrDefaultAsync();
        }
    }

    var courseLevel = HttpContextAccessor.HttpContext?.Session?.GetString("CourseLevel")
        ?? HttpContextAccessor.HttpContext?.User?.FindFirst("CourseLevel")?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Continuous Affiliation</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />


    <style>
            html, body {
                margin: 0;
                padding: 0;
                min-height: 100%;
                background: #f4f7fb;
                color: #1f2937;
                font-family: 'Segoe UI', 'Arial', sans-serif;
            }

            body {
                padding-top: 7.8rem;
            }

            .page-wrapper {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            .ca-shell {
                display: flex;
                align-items: flex-start;
                width: 100%;
                max-width: 1500px;
                margin: 0 auto;
                padding: 0 1.25rem 2rem;
                box-sizing: border-box;
                gap: 1.25rem;
            }

            .ca-main {
                flex: 1;
                min-width: 0;
                display: flex;
                flex-direction: column;
            }

            .ca-body {
                flex: 1;
                min-width: 0;
                background: #ffffff;
                overflow-y: auto;
                padding: 1.25rem;
                border-radius: 1.15rem;
                box-shadow: 0 16px 34px rgba(15, 23, 42, 0.08);
                border: 1px solid rgba(13, 71, 161, 0.12);
            }

            .ca-topbar {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 1030;
                background: linear-gradient(135deg, #0d47a1 0%, #0f4b95 45%, #0f5bb7 100%);
                color: #fff;
                border-bottom: 1px solid rgba(255,255,255,0.16);
                padding: 1.1rem 1.35rem;
                box-shadow: 0 12px 42px rgba(11, 54, 93, 0.16);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                flex-wrap: wrap;
            }

            .ca-shell > .ca-sb {
                flex-shrink: 0;
                width: min(320px, 100%);
                background: #ffffff;
                border: 1px solid rgba(13, 71, 161, 0.12);
                border-radius: 1rem;
                box-shadow: 0 16px 34px rgba(15, 23, 42, 0.08);
                min-height: auto !important;
                height: auto !important;
                position: sticky !important;
                top: 7.8rem !important;
                align-self: flex-start;
                z-index: 2;
            }

            .ca-topbar-left {
                display: flex;
                align-items: center;
                gap: 0.9rem;
                min-width: 260px;
            }

            .ca-logo {
                width: 56px;
                height: 56px;
                object-fit: contain;
                background: #fff;
                border-radius: 18px;
                padding: 0.35rem;
            }

            .ca-topbar-title h4 {
                margin: 0;
                color: #fff;
                font-weight: 700;
            }

            .ca-topbar-title h2 {
                margin: 0;
                font-size: 1.28rem;
                letter-spacing: 0.01em;
                line-height: 1.1;
            }

            .ca-topbar-page {
                display: block;
                margin-top: 0.25rem;
                color: rgba(255,255,255,0.86);
                font-size: 0.92rem;
                font-weight: 500;
            }

            .ca-topbar-title p {
                margin: 0.2rem 0 0;
                color: rgba(255,255,255,0.86);
                font-size: 0.92rem;
            }

            .ca-topbar-center {
                flex: 1;
                display: flex;
                flex-direction: column;
                justify-content: center;
                min-width: 260px;
            }

            .ca-topbar-right {
                display: flex;
                flex-direction: column;
                align-items: flex-end;
                justify-content: center;
                min-width: 240px;
                text-align: right;
                gap: 0.4rem;
            }

            .ca-topbar-college {
                font-weight: 700;
                font-size: 1.05rem;
                color: #fff;
                margin-top: 0.45rem;
            }

            .ca-topbar-meta {
                display: inline-flex;
                align-items: center;
                gap: 1.4rem;
                flex-wrap: wrap;
                justify-content: flex-end;
                color: rgba(255,255,255,0.9);
                font-size: 0.87rem;
            }

                .ca-topbar-meta span {
                    display: inline-flex;
                    align-items: center;
                    gap: 0.45rem;
                    white-space: nowrap;
                    padding: 0.15rem 0.3rem;
                    border-radius: 0.7rem;
                    background: rgba(255,255,255,0.08);
                }

            .ca-topbar-item-label,
            .ca-topbar-course,
            .ca-topbar-affiliation {
                font-weight: 700;
            }

            .ca-topbar-item-label {
                color: rgba(255,255,255,0.95);
            }

            .ca-topbar-page {
                font-size: 1rem;
                font-weight: 700;
                color: #fff;
            }

            .ca-topbar-course,
            .ca-topbar-affiliation {
                font-size: 0.87rem;
                color: rgba(255,255,255,0.88);
            }

            .ca-pill {
                background: rgba(255,255,255,0.16);
                border: 1px solid rgba(255,255,255,0.22);
                border-radius: 999px;
                padding: 0.5rem 0.85rem;
                font-weight: 600;
                color: #fff;
            }

            @@media (max-width: 991px) {
                body {
                    padding-top: 10rem;
                }

                .ca-topbar {
                    flex-direction: column;
                    align-items: stretch;
                }

                .ca-shell {
                    flex-direction: column;
                }

                .ca-shell > .ca-sb {
                    width: 100%;
                    position: static;
                }
            }
    </style>

    <link rel="stylesheet" href="~/css/common-form.css" />
</head>
<body>

    <header class="ca-topbar">
        <div class="ca-topbar-left">
            <img src="~/images/newLogo.jpeg" class="ca-logo" alt="University Logo" />
            <div class="ca-topbar-title">
                <h2><b>Rajiv Gandhi University of Health Sciences</b></h2>
                <div class="ca-topbar-college">@(string.IsNullOrEmpty(CollegeName) ? "—" : CollegeName)</div>
            </div>
        </div>

        <div class="ca-topbar-right">
            <span class="ca-topbar-page">@ViewData["Title"]</span>
            <div class="ca-topbar-meta">
                <span class="ca-topbar-course"><span class="ca-topbar-item-label">Applying Course Level:</span> @(string.IsNullOrWhiteSpace(courseLevel) ? "Not selected" : courseLevel.ToUpper())</span>
                <span class="ca-topbar-affiliation"><span class="ca-topbar-item-label">Application Type:</span> @(string.IsNullOrWhiteSpace(typeOfAffiliation) ? "Not available" : typeOfAffiliation)</span>
            </div>
        </div>
    </header>

    <div class="ca-shell">
        @await Html.PartialAsync("_ContinuousAffiliationSidebar")
        <div class="ca-main">
            <main class="ca-body">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>