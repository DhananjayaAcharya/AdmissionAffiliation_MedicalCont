@* Views/Shared/_CaLayout.cshtml *@
@inject IHttpContextAccessor HttpContextAccessor
@{
    var CollegeName = HttpContextAccessor.HttpContext?.Session?.GetString("CollegeName");
    var CollegeCode = HttpContextAccessor.HttpContext?.Session?.GetString("CollegeCode");
    var typeOfAffiliation = HttpContextAccessor.HttpContext?.Session?.GetString("TypeOfAffiliation")
        ?? HttpContextAccessor.HttpContext?.User?.FindFirst("TypeOfAffiliation")?.Value;
    var courseLevel = HttpContextAccessor.HttpContext?.Session?.GetString("CourseLevel");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Continuous Affiliation</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />


    <style>
            html, body {
                margin: 0;
                padding: 0;
                min-height: 100%;
                background: #f4f7fb;
                color: #1f2937;
                font-family: 'Segoe UI', 'Arial', sans-serif;
            }

            .page-wrapper {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            .ca-shell {
                display: flex;
                min-height: calc(100vh - 92px);
                width: 100%;
                max-width: 1500px;
                margin: 0 auto;
                background: var(--page-bg, #f4f7fb);
                padding: 0 1.25rem 1.5rem;
                box-sizing: border-box;
                gap: 1.25rem;
            }

            .ca-main {
                flex: 1;
                min-width: 0;
                display: flex;
                flex-direction: column;
                background: transparent;
            }

            .ca-body {
                flex: 1;
                min-width: 0;
                background: var(--surface, #ffffff);
                overflow-y: auto;
                padding: 1.75rem;
                border-radius: 1rem;
                box-shadow: 0 16px 32px rgba(15, 23, 42, 0.08);
                border: 1px solid rgba(15, 23, 42, 0.08);
            }

            .ca-topbar {
                background: linear-gradient(135deg, #0d47a1 0%, #0f5bb7 45%, #0f64c7 100%);
                color: #fff;
                border-bottom: 1px solid rgba(255,255,255,0.16);
                padding: 1.1rem 1.35rem;
                box-shadow: 0 10px 28px rgba(15, 23, 42, 0.12);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                flex-wrap: wrap;
                position: sticky;
                top: 0;
                width: 100%;
                z-index: 1030;
            }

            .ca-shell > .ca-sb {
                flex-shrink: 0;
                width: 280px;
                background: var(--surface, #fff);
                border: 1px solid rgba(15, 23, 42, 0.08);
                border-radius: 1rem;
                min-height: calc(100vh - 92px);
                position: sticky;
                top: 92px;
                align-self: flex-start;
                box-shadow: 0 14px 30px rgba(15, 23, 42, 0.07);
            }

            /* Override sidebar partial defaults so it stays below the global header */
            .ca-shell > .ca-sb {
                position: sticky !important;
                top: 92px !important;
                min-height: calc(100vh - 92px) !important;
                height: auto !important;
            }

            @@media (max-width: 991px) {
                .ca-shell {
                    flex-direction: column;
                }

                .ca-shell > .sidebar {
                    position: static;
                    width: 100%;
                    border-right: none;
                    border-bottom: 1px solid rgba(0,0,0,0.06);
                }
            }

            .ca-topbar-left {
                display: flex;
                align-items: center;
                gap: 0.9rem;
                min-width: 260px;
            }

            .ca-logo {
                width: 56px;
                height: 56px;
                object-fit: contain;
                background: #fff;
                border-radius: 18px;
                padding: 0.35rem;
            }

            .ca-topbar-title h4 {
                margin: 0;
                color: #fff;
                font-weight: 700;
            }
            .ca-topbar-title h2 {
                margin: 0;
                font-size: 1.28rem;
                letter-spacing: 0.01em;
                line-height: 1.1;
            }

            .ca-topbar-page {
                display: block;
                margin-top: 0.25rem;
                color: rgba(255,255,255,0.86);
                font-size: 0.92rem;
                font-weight: 500;
            }
            .ca-topbar-title p {
                margin: 0.2rem 0 0;
                color: rgba(255,255,255,0.86);
                font-size: 0.92rem;
            }

            .ca-topbar-center {
                flex: 1;
                display: flex;
                flex-direction: column;
                justify-content: center;
                min-width: 260px;
            }

            .ca-topbar-right {
                display: flex;
                flex-direction: column;
                align-items: flex-end;
                justify-content: center;
                min-width: 240px;
                text-align: right;
                gap: 0.4rem;
            }

            .ca-topbar-college {
                font-weight: 700;
                font-size: 1.05rem;
                color: #fff;
                margin-top: 0.45rem;
            }

            .ca-topbar-meta {
                display: inline-flex;
                align-items: center;
                gap: 1.4rem;
                flex-wrap: wrap;
                justify-content: flex-end;
                color: rgba(255,255,255,0.9);
                font-size: 0.87rem;
            }

            .ca-topbar-meta span {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                white-space: nowrap;
                padding: 0.15rem 0.3rem;
                border-radius: 0.7rem;
                background: rgba(255,255,255,0.08);
            }

            .ca-topbar-item-label,
            .ca-topbar-course,
            .ca-topbar-affiliation {
                font-weight: 700;
            }

            .ca-topbar-item-label {
                color: rgba(255,255,255,0.95);
            }

            .ca-topbar-page {
                font-size: 1rem;
                font-weight: 700;
                color: #fff;
            }

            .ca-topbar-course,
            .ca-topbar-affiliation {
                font-size: 0.87rem;
                color: rgba(255,255,255,0.88);
            }

            .ca-pill {
                background: rgba(255,255,255,0.16);
                border: 1px solid rgba(255,255,255,0.22);
                border-radius: 999px;
                padding: 0.5rem 0.85rem;
                font-weight: 600;
                color: #fff;
            }

            @@media (max-width: 991px) {
                .ca-topbar {
                    flex-direction: column;
                    align-items: stretch;
                    position: static; /* avoid sticky quirks once stacked on mobile */
                }
            }
    </style>

    <link rel="stylesheet" href="~/css/common-form.css" />
</head>
<body>

    <header class="ca-topbar">
        <div class="ca-topbar-left">
            <img src="~/images/newLogo.jpeg" class="ca-logo" alt="University Logo" />
            <div class="ca-topbar-title">
                <h2><b>Rajiv Gandhi University of Health Sciences</b></h2>
                <div class="ca-topbar-college">@(string.IsNullOrEmpty(CollegeName) ? "—" : CollegeName)</div>
            </div>
        </div>

        <div class="ca-topbar-right">
            <span class="ca-topbar-page">@ViewData["Title"]</span>
            <div class="ca-topbar-meta">
                <span class="ca-topbar-course"><span class="ca-topbar-item-label">Applying Course Level:</span> @(string.IsNullOrWhiteSpace(courseLevel) ? "Not selected" : courseLevel)</span>
                <span class="ca-topbar-affiliation"><span class="ca-topbar-item-label">Application Type:</span> @(string.IsNullOrWhiteSpace(typeOfAffiliation) ? "Not available" : typeOfAffiliation)</span>
            </div>
        </div>
    </header>

    <div class="ca-shell">
        @await Html.PartialAsync("_ContinuousAffiliationSidebar")
        <div class="ca-main">
            <main class="ca-body">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>