@model SidebarViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    var isSubmitDisplayString = HttpContextAccessor.HttpContext.Session.GetString("IsSubmitDisplay");
    var ugCourse = HttpContextAccessor.HttpContext.Session.GetString("UgCourse");
    var facultyCode = HttpContextAccessor.HttpContext.Session.GetString("FacultyCode");
    var collegecode = HttpContextAccessor.HttpContext.Session.GetString("CollegeCode");
    bool isSubmitDisplay = false;
    var showNodalOfficer = HttpContextAccessor.HttpContext.Session.GetString("ShowNodalOfficer");
    var showIntakeDetails = HttpContextAccessor.HttpContext.Session.GetString("ShowIntakeDetails");
    var showRepository = HttpContextAccessor.HttpContext.Session.GetString("ShowRepository");
    var sidebarActionMethod = HttpContextAccessor.HttpContext.Session.GetString("sidebarActionMethod");
    var sidebarController = HttpContextAccessor.HttpContext.Session.GetString("sidebarController");

    if (!string.IsNullOrEmpty(isSubmitDisplayString))
    {
        bool.TryParse(isSubmitDisplayString, out isSubmitDisplay);
    }

    string currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<style>
    :root {
        /* Aligned to the RGUHS portal design system (navy / gold / teal) */
        --sb-navy: #0a3d91;
        --sb-navy-mid: #0d4fb0;
        --sb-navy-deep: #082f70;
        --sb-gold: #1d5fd6;
        --sb-gold-lt: #7fb0ff;
        --sb-gold-ring: rgba(29,95,214,.18);
        --sb-teal: #0e7490;
        --sb-text: #d9e5f7;
        --sb-text-muted: #8ea3c4;
        --sb-hover: rgba(255,255,255,.06);
        --sb-active: linear-gradient(135deg, var(--sb-gold) 0%, var(--sb-navy-mid) 100%);
        --sb-border: rgba(255,255,255,.09);
        --header-height: 71px; /* 68px topbar + 3px gov strip — must match Dashboard header exactly */
        --sb-radius: 8px;
        --sb-radius-lg: 10px;
        --sb-ease: cubic-bezier(.4,0,.2,1);
        --sb-dur: .2s;
        --sb-width: 280px;
        --sb-width-collapsed: 68px;
    }

    .sidebar {
        position: fixed;
        top: var(--header-height);
        left: 0;
        width: var(--sb-width);
        height: calc(100vh - var(--header-height));
        background: linear-gradient(180deg, var(--sb-navy-deep) 0%, var(--sb-navy) 55%, var(--sb-navy-mid) 100%);
        color: var(--sb-text);
        box-shadow: 4px 0 24px rgba(5,15,40,.35);
        padding: 0 0 1.25rem;
        display: flex;
        flex-direction: column;
        z-index: 900;
        overflow-y: auto;
        overflow-x: hidden;
        border-right: 1px solid var(--sb-border);
        font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
        transition: width var(--sb-dur) var(--sb-ease);
    }

        .sidebar::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,.14);
            border-radius: 10px;
        }

        /* ── Collapsed state ────────────────────────────────────── */
        .sidebar.collapsed {
            width: var(--sb-width-collapsed) !important;
        }

    /* ── Collapse / expand handle — always visible, sits in the
           header corner in both states so it's never possible to get
           "stuck" collapsed with no way back. ──────────────────── */
    .sidebar-handle {
        position: absolute;
        top: 14px;
        right: 20px;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: none;
        background: var(--sb-gold);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        box-shadow: 0 2px 8px rgba(29,95,214,.45);
        transition: background var(--sb-dur) var(--sb-ease), box-shadow var(--sb-dur) var(--sb-ease), transform var(--sb-dur) var(--sb-ease);
    }

        .sidebar-handle:hover {
            background: var(--sb-gold-lt);
            box-shadow: 0 3px 10px rgba(29,95,214,.55);
            transform: translateY(-1px);
        }

        .sidebar-handle:active {
            transform: translateY(0);
        }

        .sidebar-handle:focus-visible {
            outline: 2px solid var(--sb-gold-lt);
            outline-offset: 2px;
        }

        .sidebar-handle i {
            font-size: .7rem;
            transition: transform .25s ease;
        }

    .sidebar.collapsed .sidebar-handle i {
        transform: rotate(180deg);
    }

    /* ── Official header strip ─────────────────────────────── */
    .sidebar-header {
        position: relative;
        text-align: left;
        padding: 22px 52px 18px 20px;
        border-bottom: 1px solid var(--sb-border);
        background: rgba(0,0,0,.12);
        transition: padding var(--sb-dur) var(--sb-ease);
    }

        .sidebar-header::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--sb-gold), var(--sb-gold-lt) 45%, transparent);
        }

    .sidebar.collapsed .sidebar-header {
        padding: 52px 0 12px;
    }

    .sidebar.collapsed .sidebar-header-top,
    .sidebar.collapsed .sidebar-official-badge {
        display: none;
    }

    .sidebar-header-top {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
    }

    .sidebar-header-ico {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: var(--sb-gold-ring);
        border: 1px solid rgba(29,95,214,.32);
        display: grid;
        place-items: center;
        color: var(--sb-gold-lt);
        font-size: 15px;
        flex-shrink: 0;
    }

    .sidebar-header h4 {
        font-family: 'Playfair Display', 'Inter', serif;
        font-size: 1.02rem;
        font-weight: 700;
        margin: 0;
        color: #fff;
        letter-spacing: .2px;
        line-height: 1.25;
    }

    .sidebar-header-sub {
        font-size: 10px;
        color: rgba(255,255,255,.42);
        text-transform: uppercase;
        letter-spacing: 1.1px;
        margin-top: 1px;
    }

    .sidebar-official-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: var(--sb-gold-lt);
        background: var(--sb-gold-ring);
        border: 1px solid rgba(29,95,214,.30);
        padding: 3px 9px;
        border-radius: 20px;
        margin-top: 2px;
    }

        .sidebar-official-badge i {
            font-size: 10px;
        }

    /* ── Section label ──────────────────────────────────────── */
    .sidebar-section-label {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: rgba(255,255,255,.32);
        padding: 16px 20px 8px;
        white-space: nowrap;
    }

    .sidebar.collapsed .sidebar-section-label {
        display: none;
    }

    /* ── Menu ────────────────────────────────────────────────── */
    .sidebar-menu {
        list-style: none;
        padding: 4px 12px 0;
        margin: 0;
        flex: 1;
    }

    .sidebar.collapsed .sidebar-menu {
        padding: 4px 10px 0;
    }

    .sidebar-item {
        margin-bottom: 0.3rem;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        padding: 0.75rem 0.85rem;
        color: var(--sb-text);
        text-decoration: none;
        border-radius: var(--sb-radius);
        font-weight: 500;
        font-size: 0.9rem;
        letter-spacing: .1px;
        transition: background var(--sb-dur) var(--sb-ease), color var(--sb-dur) var(--sb-ease), padding var(--sb-dur) var(--sb-ease), justify-content var(--sb-dur) var(--sb-ease);
        cursor: pointer;
        user-select: none;
        border: 1px solid transparent;
    }

        .sidebar-link i:first-child {
            margin-right: 12px;
            font-size: 1.02rem;
            width: 20px;
            text-align: center;
            color: var(--sb-text-muted);
            transition: color var(--sb-dur) var(--sb-ease), margin var(--sb-dur) var(--sb-ease);
            flex-shrink: 0;
        }

        .sidebar-link:hover {
            background: var(--sb-hover);
            color: #fff;
            border-color: var(--sb-border);
        }

            .sidebar-link:hover i:first-child {
                color: var(--sb-gold-lt);
            }

        .sidebar-link.active {
            background: var(--sb-active);
            color: #fff;
            font-weight: 600;
            box-shadow: 0 4px 14px rgba(29,95,214,.32);
            border-color: transparent;
        }

            .sidebar-link.active i:first-child {
                color: #fff;
            }

        .sidebar-link .chevron {
            margin-left: auto;
            transition: transform 0.25s ease;
            font-size: 0.72rem;
            color: var(--sb-text-muted);
        }

        .sidebar-link.expanded .chevron {
            transform: rotate(180deg);
            color: var(--sb-gold-lt);
        }

    /* Collapsed menu items become centred icon-only tiles with a
           native tooltip (title attribute) standing in for the label. */
    .sidebar.collapsed .sidebar-link {
        justify-content: center;
        padding: 0.75rem 0;
    }

        .sidebar.collapsed .sidebar-link i:first-child {
            margin-right: 0;
        }

    .sidebar.collapsed .sidebar-link-label,
    .sidebar.collapsed .chevron {
        display: none;
    }

    /* ── Custom dropdown panel (replaces native select) ─────── */
    .affiliation-dropdown {
        margin: 0.3rem 0 0.4rem 0.35rem;
        padding: 0.35rem;
        border-radius: var(--sb-radius);
        background: rgba(0,0,0,.14);
        border: 1px solid var(--sb-border);
        overflow: hidden;
        max-height: 0;
        opacity: 0;
        transition: max-height 0.28s ease, opacity 0.2s ease, padding 0.28s ease, margin 0.28s ease;
    }

        .affiliation-dropdown.open {
            max-height: fit-content;
            opacity: 1;
        }

        .affiliation-dropdown.d-none-collapsed {
            max-height: 0;
            opacity: 0;
            padding: 0;
            margin-top: 0;
            margin-bottom: 0;
            border: none;
        }

    /* Flyout panels have nowhere to sit at 68px wide — collapse the
           sidebar keeps the item clickable (it auto-expands, see JS) but
           hides the inline panel until then. */
    .sidebar.collapsed .affiliation-dropdown {
        display: none !important;
    }

    .affiliation-option {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0.58rem 0.75rem;
        font-size: 0.85rem;
        color: var(--sb-text);
        border-radius: 7px;
        cursor: pointer;
        transition: background 0.18s ease, color 0.18s ease;
    }

        .affiliation-option:hover {
            background: rgba(29,95,214,.20);
            color: #fff;
        }

        .affiliation-option.disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

            .affiliation-option.disabled:hover {
                background: transparent;
                color: var(--sb-text);
            }

        .affiliation-option i {
            font-size: 0.68rem;
            color: var(--sb-text-muted);
        }

    .affiliation-loading {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0.7rem 0.8rem;
        font-size: 0.83rem;
        color: var(--sb-text-muted);
    }

        .affiliation-loading .spinner-border {
            width: 0.8rem;
            height: 0.8rem;
            border-width: 2px;
        }

    /* ── UG / PG submenu ─────────────────────────────────────── */
    .affiliation-submenu {
        margin-top: 0.25rem;
        padding-left: 1.4rem;
        background: rgba(0,0,0,.10);
        border-radius: var(--sb-radius);
        overflow: hidden;
        max-height: 0;
        opacity: 0;
        transition: max-height 0.25s ease, opacity 0.2s ease, padding 0.2s ease;
    }

        .affiliation-submenu.show {
            max-height: 6.5rem;
            opacity: 1;
            padding-left: 1.4rem;
        }

    .affiliation-subitem {
        display: block;
        padding: 0.42rem 0.6rem;
        font-size: 0.82rem;
        color: var(--sb-text);
        text-decoration: none;
        border-radius: 6px;
        transition: background 0.18s ease, color 0.18s ease;
    }

        .affiliation-subitem:hover {
            background: rgba(29,95,214,.20);
            color: #fff;
        }

        .affiliation-subitem.active {
            background: var(--sb-active);
            color: #fff;
            font-weight: 600;
        }

    .affiliation-option i.bi-chevron-right {
        transition: transform 0.2s ease;
    }

    .affiliation-option.expanded i.bi-chevron-right {
        transform: rotate(90deg);
    }

    /* ── Footer — Account controls ──────────────────────────── */
    .sidebar-footer {
        margin-top: 1rem;
        padding: 16px 16px 4px;
        border-top: 1px solid var(--sb-border);
        display: flex;
        flex-direction: column;
        gap: 8px;
        transition: padding var(--sb-dur) var(--sb-ease);
    }

    .sidebar.collapsed .sidebar-footer {
        padding: 12px 10px 4px;
    }

    .sidebar-footer-label {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.1px;
        color: rgba(255,255,255,.30);
        margin-bottom: 2px;
        padding: 0 2px;
        white-space: nowrap;
    }

    .sidebar.collapsed .sidebar-footer-label {
        display: none;
    }

    .sidebar-action-btn {
        width: 100%;
        background: rgba(255,255,255,.04);
        border: 1px solid var(--sb-border);
        color: var(--sb-text);
        font-weight: 600;
        font-size: 0.86rem;
        padding: 0.68rem 0.8rem;
        border-radius: var(--sb-radius);
        transition: all var(--sb-dur) var(--sb-ease);
        display: flex;
        align-items: center;
        gap: 0.55rem;
        text-align: left;
        cursor: pointer;
    }

        .sidebar-action-btn i {
            font-size: .95rem;
            width: 18px;
            text-align: center;
            flex-shrink: 0;
            color: var(--sb-text-muted);
            transition: color var(--sb-dur) var(--sb-ease);
        }

        .sidebar-action-btn:hover {
            background: var(--sb-gold-ring);
            border-color: rgba(29,95,214,.35);
            color: #fff;
        }

            .sidebar-action-btn:hover i {
                color: var(--sb-gold-lt);
            }

        /* Primary emphasis for the password action */
        .sidebar-action-btn.primary {
            background: rgba(29,95,214,.10);
            border-color: rgba(29,95,214,.30);
            color: var(--sb-gold-lt);
        }

            .sidebar-action-btn.primary i {
                color: var(--sb-gold-lt);
            }

            .sidebar-action-btn.primary:hover {
                background: var(--sb-gold);
                border-color: var(--sb-gold);
                color: #fff;
                box-shadow: 0 4px 14px rgba(29,95,214,.35);
            }

                .sidebar-action-btn.primary:hover i {
                    color: #fff;
                }

    .sidebar.collapsed .sidebar-action-btn {
        justify-content: center;
        padding: 0.68rem 0;
    }

        .sidebar.collapsed .sidebar-action-btn i {
            margin: 0;
        }

    .sidebar.collapsed .sidebar-action-label {
        display: none;
    }

    /* Compliance micro-footer */
    .sidebar-compliance {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 10px;
        padding-top: 12px;
        border-top: 1px solid var(--sb-border);
        font-size: 9.5px;
        color: rgba(255,255,255,.28);
        letter-spacing: .3px;
        text-transform: uppercase;
    }

    .password-modal .modal-dialog {
        max-width: 460px;
    }

    .password-modal .modal-content {
        border: 1px solid #dbe7f5;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 22px 55px rgba(5, 25, 65, .25);
    }

    .password-modal .modal-header {
        padding: 1.35rem 1.5rem;
        background: linear-gradient(135deg, var(--sb-navy-deep), var(--sb-navy));
        border-bottom: 2px solid var(--sb-gold);
    }

    .password-modal .modal-header-inner {
        display: flex;
        align-items: center;
        gap: .8rem;
    }

    .password-modal .modal-ico {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        color: var(--sb-gold-lt);
        background: var(--sb-gold-ring);
        border: 1px solid rgba(127,176,255,.35);
        font-size: 1.15rem;
    }

    .password-modal .modal-title {
        color: #fff;
        font-size: 1.08rem;
        font-weight: 700;
    }

    .password-modal .modal-sub {
        margin-top: .18rem;
        color: rgba(255,255,255,.68);
        font-size: .76rem;
    }

    .password-modal .modal-body {
        padding: 1.5rem;
        background: #fff;
    }

    .password-modal .password-field-label {
        display: flex;
        justify-content: space-between;
        gap: .75rem;
        margin-bottom: .45rem;
        color: #243b53;
        font-size: .8rem;
        font-weight: 700;
    }

    .password-modal .password-required {
        color: #b42318;
        font-size: .7rem;
        font-weight: 500;
    }

    .password-modal .password-input-wrap {
        position: relative;
    }

    .password-modal .password-input-wrap .form-control {
        height: 44px;
        padding-right: 3rem;
        border-color: #cbd8e8;
        border-radius: 8px;
        color: #102a43;
    }

    .password-modal .password-input-wrap .form-control:focus {
        border-color: var(--sb-gold);
        box-shadow: 0 0 0 3px rgba(29,95,214,.13);
    }

    .password-modal .password-visibility {
        position: absolute;
        top: 50%;
        right: .7rem;
        width: 30px;
        height: 30px;
        transform: translateY(-50%);
        border: 0;
        background: transparent;
        color: #627d98;
        cursor: pointer;
    }

    .password-modal .password-visibility:hover {
        color: var(--sb-navy);
    }

    .password-modal .password-rules {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .45rem .8rem;
        margin-top: .85rem;
        padding: .85rem;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #f8fafc;
        color: #627d98;
        font-size: .72rem;
    }

    .password-modal .password-rule {
        display: flex;
        align-items: center;
        gap: .35rem;
    }

    .password-modal .password-rule i {
        color: #9fb3c8;
    }

    .password-modal .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: .65rem;
        padding: 1rem 1.5rem 1.35rem;
        border-top: 1px solid #e2e8f0;
        background: #f8fafc;
    }

        .sidebar-compliance i {
            color: var(--sb-teal);
            font-size: 11px;
        }

    /* Mobile / responsive */
    @@media (max-width: 991px) {
        .sidebar {
            position: relative;
            width: 100%;
            height: auto;
            top: 0;
            left: 0;
            box-shadow: none;
            border-right: none;
            border-bottom: 1px solid var(--sb-border);
        }
        /* The icon-only collapsed rail is a desktop affordance — the
               sidebar already stacks full-width and inline on mobile, so
               collapsing it would just hide the nav with no space saved. */
        .sidebar-handle {
            display: none;
        }

        .sidebar.collapsed {
            width: 100% !important;
        }

            .sidebar.collapsed .sidebar-header-top,
            .sidebar.collapsed .sidebar-official-badge,
            .sidebar.collapsed .sidebar-section-label,
            .sidebar.collapsed .sidebar-link-label,
            .sidebar.collapsed .chevron,
            .sidebar.collapsed .sidebar-footer-label,
            .sidebar.collapsed .sidebar-action-label {
                display: revert;
            }

            .sidebar.collapsed .sidebar-link,
            .sidebar.collapsed .sidebar-action-btn {
                justify-content: flex-start;
                padding: 0.75rem 0.85rem;
            }
    }

    @@media (max-width: 1200px) and (min-width: 992px) {
        .sidebar {
            width: 240px;
        }

        .sidebar-link {
            font-size: 0.87rem;
            padding: 0.68rem 0.8rem;
        }
    }

    @@media (min-width: 1024px) {
        .sidebar {
            height: calc(100vh - var(--header-height));
            overflow-y: auto;
            scrollbar-width: thin;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .sidebar,
        .sidebar-header,
        .sidebar-link,
        .sidebar-handle,
        .sidebar-handle i,
        .sidebar-footer {
            transition: none;
        }
    }

    .sidebar .dropdown-menu {
        position: static !important;
        display: block;
        margin-left: 10px;
        background: transparent;
        border: none;
    }

    .sidebar .dropdown-item {
        color: var(--sb-text);
        padding-left: 20px;
    }

        .sidebar .dropdown-item:hover {
            background: var(--sb-hover);
        }

    .d-none {
        display: none !important;
    }
</style>

@if (!string.IsNullOrEmpty(Model.FacultyCode))
{
    <aside class="sidebar">

        <button type="button"
                class="sidebar-handle"
                onclick="toggleSidebar()"
                aria-expanded="true"
                aria-label="Collapse sidebar"
                title="Collapse sidebar">
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </button>

        <div class="sidebar-header">
            <div class="sidebar-header-top">
                <div class="sidebar-header-ico"><i class="bi bi-mortarboard-fill"></i></div>
                <div class="sidebar-header-text">
                    <h4>College Workspace</h4>
                    <div class="sidebar-header-sub">Affiliation Management</div>
                </div>
            </div>
            <span class="sidebar-official-badge"><i class="bi bi-patch-check-fill"></i> Official Portal</span>
        </div>

        <div class="sidebar-section-label">Navigation</div>

        <ul class="sidebar-menu">

            @if (facultyCode == "1" || facultyCode == "2")
            {
                <li class="sidebar-item">
                    <a href="#" id="admissionAffiliationToggle"
                       class="sidebar-link @(currentController == "CollegeBasicDetails" ? "active" : "")"
                       title="Admission Affiliation"
                       onclick="toggleAffiliationDropdown(event)">

                        <i class="bi bi-building"></i>
                        <span class="sidebar-link-label">Admission Affiliation</span>
                        <i class="bi bi-chevron-down chevron"></i>
                    </a>

                    <div id="affiliationDropdownPanel" class="affiliation-dropdown d-none-collapsed">
                        <!-- options injected here -->
                    </div>
                </li>

                <li class="sidebar-item">
                    <a asp-controller="ContinuousAffiliationIncreaseintake"
                       asp-action="IncreaseIntake"
                       class="sidebar-link @(currentController == "ContinuousAffiliationIncreaseintake" && currentAction == "MedicalCollegeCourseIntake" ? "active" : "")"
                       title="View Course Intake List">
                        <i class="bi bi-list-check"></i>
                        <span class="sidebar-link-label">View Course Intake List</span>
                    </a>
                </li>

                @if (facultyCode == "1")
                {
                    <li class="sidebar-item">
                        <a asp-controller="Home"
                           asp-action="Dashboard"
                           class="sidebar-link @(currentController == "UGFaculty" ? "active" : "")"
                           title="Update UG Medical Faculty Details">

                            <i class="bi bi-building"></i>
                            <span class="sidebar-link-label">Update UG Medical Faculty Details</span>
                        </a>
                    </li>
                }
            }

            @if (facultyCode == "12")
            {
                <li class="sidebar-item">
                    <a asp-controller="Fellowship" asp-action="FellowshipMedical_Details"
                       class="sidebar-link @(currentController == "Fellowship" ? "active" : "")"
                       title="Fellowship Application">
                        <i class="bi bi-mortarboard"></i>
                        <span class="sidebar-link-label">Fellowship Application</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="Fellowship" asp-action="AcceptedRejectedDashboard"
                       class="sidebar-link"
                       title="Approved / Rejected Applications">
                        <i class="bi bi-check2-circle"></i>
                        <span class="sidebar-link-label">Approved / Rejected Applications</span>
                    </a>
                </li>
            }

            <!-- Digital Repository – shown conditionally based on faculty -->

        </ul>

        <!-- Account controls -->
        <div class="sidebar-footer">
            <div class="sidebar-footer-label">Account</div>

            <button class="sidebar-action-btn" onclick="goToCollegeProfile(event)" title="College Profile">
                <i class="bi bi-person-vcard"></i> <span class="sidebar-action-label">College Profile</span>
            </button>

            <button class="sidebar-action-btn primary" data-bs-toggle="modal" data-bs-target="#updatePasswordModal" title="Update Password">
                <i class="bi bi-lock"></i> <span class="sidebar-action-label">Update Password</span>
            </button>

        </div>
    </aside>

    <!-- Update Password Modal -->
    <div class="modal fade password-modal" id="updatePasswordModal" tabindex="-1" aria-labelledby="updatePasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="UpdatePassword" asp-controller="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="updatePasswordModalLabel">Change Password</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="CollegeCode" value="@collegecode" />
                        <div class="password-field">
                            <label for="NewPassword" class="password-field-label">
                                <span>New password</span>
                                <span class="password-required">Required</span>
                            </label>
                            <div class="password-input-wrap">
                                <input type="password" class="form-control" id="NewPassword" name="UpdatedPassword" required minlength="8" maxlength="20" pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&])[A-Za-z\d@@$!%*?&]{8,20}$" title="Password must be 8-20 characters and include uppercase, lowercase, number, and special character." autocomplete="new-password" />
                                <button type="button" class="password-visibility toggle-password" aria-label="Show password" title="Show password"><i class="bi bi-eye" id="toggleIcon"></i></button>
                            </div>
                            <div class="password-rules" aria-label="Password requirements">
                                <span class="password-rule"><i class="bi bi-check2-circle"></i>8 to 20 characters</span>
                                <span class="password-rule"><i class="bi bi-check2-circle"></i>Uppercase letter</span>
                                <span class="password-rule"><i class="bi bi-check2-circle"></i>Lowercase letter</span>
                                <span class="password-rule"><i class="bi bi-check2-circle"></i>Number and symbol</span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Update Password</button>
                    </div>
                </form>
                <!-- Hidden form that will POST the level & affiliation‑type id -->
                <form id="setLevelForm"
                      asp-controller="ContinuesAffiliation_Facultybased"
                      asp-action="SetCourseLevel"
                      method="post"
                      style="display:none;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="level" id="hiddenLevel" />
                    <input type="hidden" name="affiliationTypeId" id="hiddenAffiliationId" />
                    <input type="hidden" name="facultyCode" id="hiddenFacultyCode" />
                </form>


            </div>
        </div>
    </div>
}

<script>
     const currentFacultyCode = "@facultyCode";
     document.addEventListener("DOMContentLoaded", function () {
         const toggleBtn = document.querySelector(".toggle-password");
         const passwordInput = document.getElementById("NewPassword");
         const toggleIcon = document.getElementById("toggleIcon");
        console.log(currentFacultyCode);

         if (toggleBtn && passwordInput && toggleIcon) {
             toggleBtn.addEventListener("click", function () {
                 const type = passwordInput.getAttribute("type") === "password" ? "text" : "password";
                 passwordInput.setAttribute("type", type);
                 toggleIcon.className = type === "password" ? "bi bi-eye" : "bi bi-eye-slash";
             });
         }

         // Restore the collapsed/expanded sidebar state. Collapsing is a
         // desktop affordance only — below the 992px breakpoint the
         // sidebar stacks full-width, so a stored "collapsed" flag from a
         // previous desktop session is deliberately ignored here.
         if (window.innerWidth >= 992) {
             setSidebarCollapsed(localStorage.getItem("rguhsSidebarCollapsed") === "true");
         }
     });

     // Keep the sidebar usable if the viewport is resized down while collapsed.
     window.addEventListener("resize", function () {
         if (window.innerWidth < 992 && isSidebarCollapsed()) {
             setSidebarCollapsed(false);
         }
     });

     function isSidebarCollapsed() {
         const sidebar = document.querySelector(".sidebar");
         return !!sidebar && sidebar.classList.contains("collapsed");
     }

     // Applies (or clears) the collapsed state, keeps the handle's a11y
     // attributes in sync, persists the choice, and notifies the rest of
     // the page (e.g. a layout that needs to adjust its own margin-left
     // to match the sidebar's current width) via a CustomEvent.
     function setSidebarCollapsed(collapsed) {
         const sidebar = document.querySelector(".sidebar");
         const handle = document.querySelector(".sidebar-handle");
         if (!sidebar || !handle) return;

         sidebar.classList.toggle("collapsed", collapsed);
         document.body.classList.toggle("app-sidebar-collapsed", collapsed);

         localStorage.setItem("rguhsSidebarCollapsed", collapsed ? "true" : "false");

         handle.setAttribute("aria-expanded", collapsed ? "false" : "true");
         handle.setAttribute("aria-label", collapsed ? "Expand sidebar" : "Collapse sidebar");
         handle.setAttribute("title", collapsed ? "Expand sidebar" : "Collapse sidebar");

         window.dispatchEvent(new CustomEvent("sidebarToggle", { detail: { collapsed: collapsed } }));
     }

     function toggleSidebar() {
         setSidebarCollapsed(!isSidebarCollapsed());
     }

     function toggleMenu(e, id) {
         e.preventDefault();
         const menu = document.getElementById(id);
         if (!menu) return;
         menu.classList.toggle("d-none");
     }

     // ---- Admission Affiliation: custom dropdown, opens directly on first click ----

     let affiliationTypesLoaded = false;
     let affiliationOptionsCache = [];

     const getAffiliationTypesUrl = '@Url.Action("GetAffiliationTypes", "ContinuesAffiliation_Facultybased")';

    // Map TypeId -> destination route. Only entries with a mapped route are selectable.
    const affiliationRouteMap = {
        "2": '@Url.Action("Institution_Details", "ContinuesAffiliation_Facultybased")',
        "1": '@Url.Action("Institution_Details", "ContinuesAffiliation_Facultybased")',
        "3": '@Url.Action("IncreaseIntake", "ContinuousAffiliationIncreaseintake")',
        "4": '@Url.Action("Index", "CourseAffiliation")',
        // "5": '@Url.Action("Institution_Details", "ChangeOfName_Facultybased")',
        // "6": '@Url.Action("Institution_Details", "ChangeOfAddress_Facultybased")',
        // "7": '@Url.Action("Institution_Details", "ChangeOfNameAndAddress_Facultybased")',
        // "8": '@Url.Action("Institution_Details", "RenewalOfConsent_Facultybased")',
    };

     const affiliationBaseUrlMap = {
         "2": '@Url.Action("Institution_Details", "ContinuesAffiliation_Facultybased")',
         "3": '@Url.Action("IncreaseIntake", "ContinuousAffiliationIncreaseintake")',
         "4": '@Url.Action("Institution_Details", "ContinuesAffiliation_Facultybased")',
          "1": '@Url.Action("Institution_Details", "ContinuesAffiliation_Facultybased")',
     };

     // -----------------------------------------------------------------
     // Map: level (ug / pg) → query‑string that will be appended to the base URL
     // -----------------------------------------------------------------
     const levelQueryMap = {
         ug: "?level=ug",
         pg: "?level=pg",
         ss: "?level=ss"
     };

     /* --------------------------------------------------------------
        Render the affiliation types (parent rows) + their UG/PG sub‑menus
        -------------------------------------------------------------- */
     function renderAffiliationOptions(items) {
         const panel = document.getElementById("affiliationDropdownPanel");
         panel.innerHTML = "";

         if (!items || items.length === 0) {
             const empty = document.createElement("div");
             empty.className = "affiliation-loading";
             empty.textContent = "No affiliation types available.";
             panel.appendChild(empty);
             return;
         }

         items.forEach(item => {
             const hasRoute = !!affiliationBaseUrlMap[item.typeId];
             const isDisabled = !hasRoute;               // disabled when we have no URL for it

             /* ---------- Parent row (affiliation type) ---------- */
             const parentDiv = document.createElement("div");
             parentDiv.className = `affiliation-option${isDisabled ? " disabled" : ""}`;
             parentDiv.innerHTML = `
                 <i class="bi bi-dot"></i>
                 <span>${item.typeDescription}</span>
                 <i class="bi bi-chevron-right ms-auto"></i>
             `;
             parentDiv.dataset.typeId = item.typeId;      // store for later use
             parentDiv.addEventListener("click", toggleUgPgSubmenu);
             panel.appendChild(parentDiv);

             /* ---------- Sub‑menu (UG / PG) – only for enabled rows ---------- */
             const facultyCode = "@facultyCode";

            const showSubMenu =
                facultyCode === "1" ||
                facultyCode === "2";

            const createSubMenu = !isDisabled && showSubMenu;
            const getCourseLevelsUrl = '@Url.Action("GetCourseLevels", "ContinuesAffiliation_Facultybased")';


            if (createSubMenu) {

                const subMenu = document.createElement("div");
                subMenu.className = "affiliation-submenu";
                subMenu.dataset.parentId = item.typeId;

                let levels = [];

                if (facultyCode === "2") {
                    levels = ["ug", "pg"];
                }
                else if (facultyCode === "1") {
                    fetch(getCourseLevelsUrl)
                    .then(res => res.json())
                    .then(data => {
                        data.forEach(level => {
                            const link = document.createElement("a");
                            link.href = "#";
                            link.className = "affiliation-subitem";
                            link.dataset.level = level.toLowerCase();
                            link.textContent = level;
                            link.addEventListener("click", navigateToLevel);

                            subMenu.appendChild(link);
                        });
                    });

                    panel.appendChild(subMenu);
                    return;

                }
                levels.forEach(level => {
                    const link = document.createElement("a");
                    link.href = "#";
                    link.className = "affiliation-subitem";
                    link.dataset.level = level;
                    link.textContent = level.toUpperCase();
                    link.addEventListener("click", navigateToLevel);

                    subMenu.appendChild(link);
                });

                panel.appendChild(subMenu);
            }
             // If the row is disabled we simply do **not** add a submenu element.
         });
     }

     /* --------------------------------------------------------------
        Open/close a specific UG/PG submenu (accordion style)
        -------------------------------------------------------------- */
     function toggleUgPgSubmenu(e) {
         e.stopPropagation();                     // stop bubbling to the document
         const parent = e.currentTarget;

         // ---- 1️⃣  Ignore clicks on disabled rows ----
         if (parent.classList.contains("disabled")) {
             return;                               // do nothing – the option is not selectable
         }

         const typeId = parent.dataset.typeId;

         const panel = document.getElementById("affiliationDropdownPanel");
         const subMenu = panel.querySelector(
             `.affiliation-submenu[data-parent-id="${typeId}"]`
         );
         if (!subMenu) return;                    // safety – should never happen for enabled rows

         // Close any other open submenu (accordion style)
         document.querySelectorAll(".affiliation-submenu").forEach(m => {
             if (m !== subMenu) m.classList.remove("show");
         });

         // Toggle this one
         subMenu.classList.toggle("show");
     }


     // --------------------------------------------------------------
     // Helper: fetch the anti‑forgery token that MVC renders in the form
     // --------------------------------------------------------------
     function getAntiForgeryToken() {
         const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
         return tokenInput ? tokenInput.value : '';
     }

     /* --------------------------------------------------------------
    Persist level & affiliation‑type‑id via a **normal form POST**
    -------------------------------------------------------------- */
     function navigateToLevel(e) {
         e.preventDefault();
         e.stopPropagation();               // stop bubbling to the parent row

         const level      = e.currentTarget.dataset.level;          // "ug" or "pg"

         // ---- 1️⃣ Get the affiliation‑type id from the submenu ----
         const subMenu = e.currentTarget.closest('.affiliation-submenu');
         if (!subMenu) {
             console.error('Unable to find affiliation submenu for the clicked link');
             return;
         }
         const typeId = subMenu.dataset.parentId;                  // e.g. "2"

         // ---- 2️⃣ Resolve the target URL for this affiliation type ----
         const baseUrl = affiliationBaseUrlMap[typeId];
         if (!baseUrl) {
             alert('No URL configured for this affiliation type.');
             return;
         }

         // ---- 3️⃣ Fill the hidden form fields (level + affiliationTypeId) ----
         document.getElementById('hiddenLevel').value = level;
         document.getElementById('hiddenAffiliationId').value = typeId;

        document.getElementById('hiddenFacultyCode').value = currentFacultyCode;

         // ---- 4️⃣ Submit the form – a normal browser POST, **no fetch/XHR** ----
         document.getElementById('setLevelForm').submit();
     }


     // --------------------------------------------------------------
     // Toggle the main affiliation dropdown (unchanged, except that a
     // collapsed sidebar is now auto-expanded first — there's nowhere
     // for the inline panel to render at 68px wide).
     // --------------------------------------------------------------
     function toggleAffiliationDropdown(e) {
         e.preventDefault();

         if (isSidebarCollapsed()) {
             setSidebarCollapsed(false);
             window.setTimeout(function () { toggleAffiliationDropdown(e); }, 90);
             return;
         }

         const panel = document.getElementById("affiliationDropdownPanel");
         const toggleLink = document.getElementById("admissionAffiliationToggle");
         const isOpen = panel.classList.contains("open");

         if (isOpen) {
             panel.classList.remove("open");
             panel.classList.add("d-none-collapsed");
             toggleLink.classList.remove("expanded");
             return;
         }

         panel.classList.remove("d-none-collapsed");
         panel.classList.add("open");
         toggleLink.classList.add("expanded");

         if (!affiliationTypesLoaded) {
             panel.innerHTML = '<div class="affiliation-loading"><span class="spinner-border" role="status"></span> Loading...</div>';

             fetch(getAffiliationTypesUrl)
                 .then(res => {
                     if (!res.ok) throw new Error("Network response was not ok");
                     return res.json();
                 })
                 .then(data => {
                     affiliationOptionsCache = data;
                     affiliationTypesLoaded = true;
                     renderAffiliationOptions(data);
                 })
                 .catch(err => {
                     console.error("Failed to load affiliation types:", err);
                     panel.innerHTML = '<div class="affiliation-loading">Failed to load. Try again.</div>';
                 });
         } else {
             renderAffiliationOptions(affiliationOptionsCache);
         }
     }


     function handleAffiliationTypeSelect(typeId) {
         if (!typeId) return;

        const separator = baseUrl.indexOf('?') !== -1 ? '&' : '?';
        window.location.href = baseUrl + separator + 'courseLevel=' + encodeURIComponent(courseLevel);
    }
</script>
