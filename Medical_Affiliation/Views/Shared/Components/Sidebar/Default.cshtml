@model SidebarViewModel
@{
    // ── Session values (single source of truth, null-safe) ───────────────────
    string S(string key) => Context.Session.GetString(key) ?? "";

    // Model wins; session is the fallback, so the menu and the guard below never disagree
    var facultyCode = !string.IsNullOrEmpty(Model?.FacultyCode) ? Model.FacultyCode : S("FacultyCode");
    var collegeCode = S("CollegeCode");
    var currentLevel = S("CourseLevel").Trim().ToLowerInvariant();   // set by SetCourseLevel
    var currentTypeId = S("TypeOfAffiliationId");                      // set by SetCourseLevel

    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    // Controllers that belong to the "Application for Affiliation" flow
    var affiliationControllers = new[]
    {
        "CollegeBasicDetails",
        "ContinuesAffiliation_Facultybased",
        "ContinuousAffiliationIncreaseintake",
        "CourseAffiliation"
    };
    bool affiliationActive = affiliationControllers.Contains(currentController);
}

<style>
    :root {
        --sb-navy: #0a3d91;
        --sb-navy-mid: #0d4fb0;
        --sb-navy-deep: #082f70;
        --sb-gold: #1d5fd6;
        --sb-gold-lt: #7fb0ff;
        --sb-gold-ring: rgba(29,95,214,.18);
        --sb-teal: #0e7490;
        --sb-text: #d9e5f7;
        --sb-text-muted: #8ea3c4;
        --sb-hover: rgba(255,255,255,.06);
        --sb-active: linear-gradient(135deg, var(--sb-gold) 0%, var(--sb-navy-mid) 100%);
        --sb-border: rgba(255,255,255,.09);
        --header-height: 71px; /* 68px topbar + 3px gov strip — must match Dashboard header */
        --sb-radius: 8px;
        --sb-ease: cubic-bezier(.4,0,.2,1);
        --sb-dur: .2s;
        --sb-width: 280px;
        --sb-width-collapsed: 68px;
    }

    .sidebar {
        position: fixed;
        top: var(--header-height);
        left: 0;
        width: var(--sb-width);
        height: calc(100vh - var(--header-height));
        background: linear-gradient(180deg, var(--sb-navy-deep) 0%, var(--sb-navy) 55%, var(--sb-navy-mid) 100%);
        color: var(--sb-text);
        box-shadow: 4px 0 24px rgba(5,15,40,.35);
        padding: 0 0 1.25rem;
        display: flex;
        flex-direction: column;
        z-index: 900;
        overflow-y: auto;
        overflow-x: hidden;
        border-right: 1px solid var(--sb-border);
        font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
        transition: width var(--sb-dur) var(--sb-ease);
        scrollbar-width: thin;
    }

        .sidebar::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,.14);
            border-radius: 10px;
        }

        .sidebar.collapsed {
            width: var(--sb-width-collapsed) !important;
        }

    /* Collapse / expand handle — always visible so the sidebar can never get "stuck" */
    .sidebar-handle {
        position: absolute;
        top: 14px;
        right: 20px;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: none;
        background: var(--sb-gold);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        box-shadow: 0 2px 8px rgba(29,95,214,.45);
        transition: background var(--sb-dur) var(--sb-ease), box-shadow var(--sb-dur) var(--sb-ease), transform var(--sb-dur) var(--sb-ease);
    }

        .sidebar-handle:hover {
            background: var(--sb-gold-lt);
            box-shadow: 0 3px 10px rgba(29,95,214,.55);
            transform: translateY(-1px);
        }

        .sidebar-handle:active {
            transform: translateY(0);
        }

        .sidebar-handle:focus-visible {
            outline: 2px solid var(--sb-gold-lt);
            outline-offset: 2px;
        }

        .sidebar-handle i {
            font-size: .7rem;
            transition: transform .25s ease;
        }

    .sidebar.collapsed .sidebar-handle i {
        transform: rotate(180deg);
    }

    /* Header strip */
    .sidebar-header {
        position: relative;
        text-align: left;
        padding: 22px 52px 18px 20px;
        border-bottom: 1px solid var(--sb-border);
        background: rgba(0,0,0,.12);
        transition: padding var(--sb-dur) var(--sb-ease);
    }

        .sidebar-header::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--sb-gold), var(--sb-gold-lt) 45%, transparent);
        }

    .sidebar.collapsed .sidebar-header {
        padding: 52px 0 12px;
    }

    .sidebar.collapsed .sidebar-header-top,
    .sidebar.collapsed .sidebar-official-badge {
        display: none;
    }

    .sidebar-header-top {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
    }

    .sidebar-header-ico {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: var(--sb-gold-ring);
        border: 1px solid rgba(29,95,214,.32);
        display: grid;
        place-items: center;
        color: var(--sb-gold-lt);
        font-size: 15px;
        flex-shrink: 0;
    }

    .sidebar-header h4 {
        font-family: 'Playfair Display', 'Inter', serif;
        font-size: 1.02rem;
        font-weight: 700;
        margin: 0;
        color: #fff;
        letter-spacing: .2px;
        line-height: 1.25;
    }

    .sidebar-header-sub {
        font-size: 10px;
        color: rgba(255,255,255,.42);
        text-transform: uppercase;
        letter-spacing: 1.1px;
        margin-top: 1px;
    }

    .sidebar-official-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: var(--sb-gold-lt);
        background: var(--sb-gold-ring);
        border: 1px solid rgba(29,95,214,.30);
        padding: 3px 9px;
        border-radius: 20px;
        margin-top: 2px;
    }

        .sidebar-official-badge i {
            font-size: 10px;
        }

    .sidebar-section-label {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: rgba(255,255,255,.32);
        padding: 16px 20px 8px;
        white-space: nowrap;
    }

    .sidebar.collapsed .sidebar-section-label {
        display: none;
    }

    /* Menu */
    .sidebar-menu {
        list-style: none;
        padding: 4px 12px 0;
        margin: 0;
        flex: 1;
    }

    .sidebar.collapsed .sidebar-menu {
        padding: 4px 10px 0;
    }

    .sidebar-item {
        margin-bottom: 0.3rem;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        padding: 0.75rem 0.85rem;
        color: var(--sb-text);
        text-decoration: none;
        border-radius: var(--sb-radius);
        font-weight: 500;
        font-size: 0.9rem;
        letter-spacing: .1px;
        transition: background var(--sb-dur) var(--sb-ease), color var(--sb-dur) var(--sb-ease), padding var(--sb-dur) var(--sb-ease);
        cursor: pointer;
        user-select: none;
        border: 1px solid transparent;
    }

        .sidebar-link i:first-child,
        .sidebar-link .notification-nav-icon i {
            margin-right: 12px;
            font-size: 1.02rem;
            width: 20px;
            text-align: center;
            color: var(--sb-text-muted);
            transition: color var(--sb-dur) var(--sb-ease), margin var(--sb-dur) var(--sb-ease);
            flex-shrink: 0;
        }

        .sidebar-link:hover {
            background: var(--sb-hover);
            color: #fff;
            border-color: var(--sb-border);
        }

            .sidebar-link:hover i:first-child,
            .sidebar-link:hover .notification-nav-icon i {
                color: var(--sb-gold-lt);
            }

        .sidebar-link.active {
            background: var(--sb-active);
            color: #fff;
            font-weight: 600;
            box-shadow: 0 4px 14px rgba(29,95,214,.32);
            border-color: transparent;
        }

            .sidebar-link.active i:first-child,
            .sidebar-link.active .notification-nav-icon i {
                color: #fff;
            }

        .sidebar-link .chevron {
            margin-left: auto;
            transition: transform 0.25s ease;
            font-size: 0.72rem;
            color: var(--sb-text-muted);
        }

        .sidebar-link.expanded .chevron {
            transform: rotate(180deg);
            color: var(--sb-gold-lt);
        }

    .sidebar.collapsed .sidebar-link {
        justify-content: center;
        padding: 0.75rem 0;
    }

        .sidebar.collapsed .sidebar-link i:first-child,
        .sidebar.collapsed .sidebar-link .notification-nav-icon i {
            margin-right: 0;
        }

    .sidebar.collapsed .sidebar-link-label,
    .sidebar.collapsed .chevron {
        display: none;
    }

    /* Affiliation dropdown */
    .affiliation-dropdown {
        margin: 0.3rem 0 0.4rem 0.35rem;
        padding: 0.35rem;
        border-radius: var(--sb-radius);
        background: rgba(0,0,0,.14);
        border: 1px solid var(--sb-border);
        overflow: hidden;
        max-height: 0;
        opacity: 0;
        transition: max-height 0.28s ease, opacity 0.2s ease, padding 0.28s ease, margin 0.28s ease;
    }

        .affiliation-dropdown.open {
            max-height: 640px;
            opacity: 1;
        }

        .affiliation-dropdown.d-none-collapsed {
            max-height: 0;
            opacity: 0;
            padding: 0;
            margin-top: 0;
            margin-bottom: 0;
            border: none;
        }

    .sidebar.collapsed .affiliation-dropdown {
        display: none !important;
    }

    .affiliation-option {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0.58rem 0.75rem;
        font-size: 0.85rem;
        color: var(--sb-text);
        border-radius: 7px;
        cursor: pointer;
        transition: background 0.18s ease, color 0.18s ease;
    }

        .affiliation-option:hover {
            background: rgba(29,95,214,.20);
            color: #fff;
        }

        .affiliation-option.disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

            .affiliation-option.disabled:hover {
                background: transparent;
                color: var(--sb-text);
            }

        .affiliation-option i {
            font-size: 0.68rem;
            color: var(--sb-text-muted);
        }

            .affiliation-option i.bi-chevron-right {
                transition: transform 0.2s ease;
            }

        .affiliation-option.expanded i.bi-chevron-right {
            transform: rotate(90deg);
        }

    .affiliation-loading {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0.7rem 0.8rem;
        font-size: 0.83rem;
        color: var(--sb-text-muted);
    }

        .affiliation-loading .spinner-border {
            width: 0.8rem;
            height: 0.8rem;
            border-width: 2px;
        }

    .affiliation-submenu {
        margin-top: 0.25rem;
        padding-left: 1.4rem;
        background: rgba(0,0,0,.10);
        border-radius: var(--sb-radius);
        overflow: hidden;
        max-height: 0;
        opacity: 0;
        transition: max-height 0.25s ease, opacity 0.2s ease;
    }

        .affiliation-submenu.show {
            max-height: 8rem;
            opacity: 1;
        }

    .affiliation-subitem {
        display: block;
        padding: 0.42rem 0.6rem;
        font-size: 0.82rem;
        color: var(--sb-text);
        text-decoration: none;
        border-radius: 6px;
        transition: background 0.18s ease, color 0.18s ease;
    }

        .affiliation-subitem:hover {
            background: rgba(29,95,214,.20);
            color: #fff;
        }

        .affiliation-subitem.active {
            background: var(--sb-active);
            color: #fff;
            font-weight: 600;
        }

        .affiliation-subitem.readonly {
            color: var(--sb-text-muted);
            cursor: default;
            opacity: 0.65;
        }

            .affiliation-subitem.readonly:hover {
                background: transparent;
                color: var(--sb-text-muted);
            }

    /* Footer */
    .sidebar-footer {
        margin-top: 1rem;
        padding: 16px 16px 4px;
        border-top: 1px solid var(--sb-border);
        display: flex;
        flex-direction: column;
        gap: 8px;
        transition: padding var(--sb-dur) var(--sb-ease);
    }

    .sidebar.collapsed .sidebar-footer {
        padding: 12px 10px 4px;
    }

    .sidebar-footer-label {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.1px;
        color: rgba(255,255,255,.30);
        margin-bottom: 2px;
        padding: 0 2px;
        white-space: nowrap;
    }

    .sidebar.collapsed .sidebar-footer-label {
        display: none;
    }

    .sidebar-action-btn {
        width: 100%;
        background: rgba(255,255,255,.04);
        border: 1px solid var(--sb-border);
        color: var(--sb-text);
        font-weight: 600;
        font-size: 0.86rem;
        padding: 0.68rem 0.8rem;
        border-radius: var(--sb-radius);
        transition: all var(--sb-dur) var(--sb-ease);
        display: flex;
        align-items: center;
        gap: 0.55rem;
        text-align: left;
        cursor: pointer;
    }

        .sidebar-action-btn i {
            font-size: .95rem;
            width: 18px;
            text-align: center;
            flex-shrink: 0;
            color: var(--sb-text-muted);
            transition: color var(--sb-dur) var(--sb-ease);
        }

        .sidebar-action-btn:hover {
            background: var(--sb-gold-ring);
            border-color: rgba(29,95,214,.35);
            color: #fff;
        }

            .sidebar-action-btn:hover i {
                color: var(--sb-gold-lt);
            }

        .sidebar-action-btn.primary {
            background: rgba(29,95,214,.10);
            border-color: rgba(29,95,214,.30);
            color: var(--sb-gold-lt);
        }

            .sidebar-action-btn.primary i {
                color: var(--sb-gold-lt);
            }

            .sidebar-action-btn.primary:hover {
                background: var(--sb-gold);
                border-color: var(--sb-gold);
                color: #fff;
                box-shadow: 0 4px 14px rgba(29,95,214,.35);
            }

                .sidebar-action-btn.primary:hover i {
                    color: #fff;
                }

    .sidebar.collapsed .sidebar-action-btn {
        justify-content: center;
        padding: 0.68rem 0;
    }

        .sidebar.collapsed .sidebar-action-btn i {
            margin: 0;
        }

    .sidebar.collapsed .sidebar-action-label {
        display: none;
    }

    /* Password modal */
    .password-modal {
        z-index: 2000;
    }

        .password-modal .modal-dialog {
            max-width: 460px;
        }

        .password-modal .modal-content {
            border: 1px solid #dbe7f5;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 22px 55px rgba(5, 25, 65, .25);
        }

        .password-modal .modal-header {
            padding: 1.35rem 1.5rem;
            background: linear-gradient(135deg, var(--sb-navy-deep), var(--sb-navy));
            border-bottom: 2px solid var(--sb-gold);
        }

        .password-modal .modal-title {
            color: #fff;
            font-size: 1.08rem;
            font-weight: 700;
        }

        .password-modal .btn-close {
            filter: invert(1) grayscale(1) brightness(2);
        }

        .password-modal .modal-body {
            padding: 1.5rem;
            background: #fff;
        }

        .password-modal .password-field-label {
            display: flex;
            justify-content: space-between;
            gap: .75rem;
            margin-bottom: .45rem;
            color: #243b53;
            font-size: .8rem;
            font-weight: 700;
        }

        .password-modal .password-required {
            color: #b42318;
            font-size: .7rem;
            font-weight: 500;
        }

        .password-modal .password-input-wrap {
            position: relative;
        }

            .password-modal .password-input-wrap .form-control {
                height: 44px;
                padding-right: 3rem;
                border-color: #cbd8e8;
                border-radius: 8px;
                color: #102a43;
            }

                .password-modal .password-input-wrap .form-control:focus {
                    border-color: var(--sb-gold);
                    box-shadow: 0 0 0 3px rgba(29,95,214,.13);
                }

        .password-modal .password-visibility {
            position: absolute;
            top: 50%;
            right: .7rem;
            width: 30px;
            height: 30px;
            transform: translateY(-50%);
            border: 0;
            background: transparent;
            color: #627d98;
            cursor: pointer;
        }

            .password-modal .password-visibility:hover {
                color: var(--sb-navy);
            }

        .password-modal .password-rules {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: .45rem .8rem;
            margin-top: .85rem;
            padding: .85rem;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            background: #f8fafc;
            color: #627d98;
            font-size: .72rem;
        }

        .password-modal .password-rule {
            display: flex;
            align-items: center;
            gap: .35rem;
        }

            .password-modal .password-rule i {
                color: #9fb3c8;
            }

            .password-modal .password-rule.ok {
                color: #1e7e4e;
            }

                .password-modal .password-rule.ok i {
                    color: #1e7e4e;
                }

        .password-modal .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: .65rem;
            padding: 1rem 1.5rem 1.35rem;
            border-top: 1px solid #e2e8f0;
            background: #f8fafc;
        }

    /* Notification badge */
    .notification-nav-icon {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .notification-badge {
        position: absolute;
        top: -8px;
        right: -4px;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 20px;
        background: #dc2626;
        color: #fff;
        font-size: 10px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid var(--sb-navy);
    }

    /* Responsive */
    @@media (max-width: 991px) {
        .sidebar {
            position: relative;
            width: 100%;
            height: auto;
            top: 0;
            left: 0;
            box-shadow: none;
            border-right: none;
            border-bottom: 1px solid var(--sb-border);
        }

        .sidebar-handle {
            display: none;
        }

        .sidebar.collapsed {
            width: 100% !important;
        }

            .sidebar.collapsed .sidebar-header-top,
            .sidebar.collapsed .sidebar-official-badge,
            .sidebar.collapsed .sidebar-section-label,
            .sidebar.collapsed .sidebar-link-label,
            .sidebar.collapsed .chevron,
            .sidebar.collapsed .sidebar-footer-label,
            .sidebar.collapsed .sidebar-action-label {
                display: revert;
            }

            .sidebar.collapsed .sidebar-link,
            .sidebar.collapsed .sidebar-action-btn {
                justify-content: flex-start;
                padding: 0.75rem 0.85rem;
            }

            .sidebar.collapsed .affiliation-dropdown {
                display: block !important;
            }
    }

    @@media (max-width: 1200px) and (min-width: 992px) {
        .sidebar {
            width: 240px;
        }

        .sidebar-link {
            font-size: 0.87rem;
            padding: 0.68rem 0.8rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .sidebar, .sidebar-header, .sidebar-link, .sidebar-handle, .sidebar-handle i, .sidebar-footer {
            transition: none;
        }
    }
</style>

@if (!string.IsNullOrEmpty(facultyCode))
{
    <aside class="sidebar" aria-label="Sidebar navigation">

        <button type="button"
                class="sidebar-handle"
                onclick="toggleSidebar()"
                aria-expanded="true"
                aria-label="Collapse sidebar"
                title="Collapse sidebar">
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </button>

        <div class="sidebar-header">
            <div class="sidebar-header-top">
                <div class="sidebar-header-ico"><i class="bi bi-mortarboard-fill"></i></div>
                <div class="sidebar-header-text">
                    <h4>College Workspace</h4>
                    <div class="sidebar-header-sub">Affiliation Management</div>
                </div>
            </div>
            <span class="sidebar-official-badge"><i class="bi bi-patch-check-fill"></i> Official Portal</span>
        </div>

        <div class="sidebar-section-label">Navigation</div>

        <ul class="sidebar-menu">

            @if (facultyCode == "1" || facultyCode == "2" || facultyCode == "4")
            {
                <li class="sidebar-item">
                    <a href="#" id="admissionAffiliationToggle"
                       role="button"
                       aria-expanded="false"
                       aria-controls="affiliationDropdownPanel"
                       class="sidebar-link @(affiliationActive ? "active" : "")"
                       title="Application for Affiliation"
                       onclick="toggleAffiliationDropdown(event)">
                        <i class="bi bi-building"></i>
                        <span class="sidebar-link-label">Application for Affiliation</span>
                        <i class="bi bi-chevron-down chevron"></i>
                    </a>

                    <div id="affiliationDropdownPanel" class="affiliation-dropdown d-none-collapsed">
                        <!-- options injected here -->
                    </div>
                </li>

                <li class="sidebar-item">
                    <a asp-controller="AffiliationNotifications"
                       asp-action="Index"
                       class="sidebar-link @(currentController == "AffiliationNotifications" ? "active" : "")"
                       title="Notifications">
                        <span class="notification-nav-icon">
                            <i class="bi bi-bell-fill"></i>
                            <span id="sidebarNotificationBadge" class="notification-badge" style="display:none;"></span>
                        </span>
                        <span class="sidebar-link-label">Notifications</span>
                    </a>
                </li>

                @if (facultyCode == "1")
                {
                    <li class="sidebar-item">
                        <a asp-controller="Home"
                           asp-action="Dashboard"
                           class="sidebar-link @(currentController == "Home" && currentAction == "Dashboard" ? "active" : "")"
                           title="Update UG Medical Faculty Details">
                            <i class="bi bi-building"></i>
                            <span class="sidebar-link-label">Update UG Medical Faculty Details</span>
                        </a>
                    </li>
                }
            }

            @if (facultyCode == "12")
            {
                <li class="sidebar-item">
                    <a asp-controller="Fellowship" asp-action="FellowshipMedical_Details"
                       class="sidebar-link @(currentController == "Fellowship" && currentAction == "FellowshipMedical_Details" ? "active" : "")"
                       title="Fellowship Application">
                        <i class="bi bi-mortarboard"></i>
                        <span class="sidebar-link-label">Fellowship Application</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="Fellowship" asp-action="AcceptedRejectedDashboard"
                       class="sidebar-link @(currentController == "Fellowship" && currentAction == "AcceptedRejectedDashboard" ? "active" : "")"
                       title="Approved / Rejected Applications">
                        <i class="bi bi-check2-circle"></i>
                        <span class="sidebar-link-label">Approved / Rejected Applications</span>
                    </a>
                </li>
            }
        </ul>

        <!-- Account controls -->
        <div class="sidebar-footer">
            <div class="sidebar-footer-label">Account</div>

            <button type="button" class="sidebar-action-btn" onclick="goToCollegeProfile(event)" title="College Profile">
                <i class="bi bi-person-vcard"></i> <span class="sidebar-action-label">College Profile</span>
            </button>

            <button type="button" class="sidebar-action-btn primary" data-bs-toggle="modal" data-bs-target="#updatePasswordModal" title="Update Password">
                <i class="bi bi-lock"></i> <span class="sidebar-action-label">Update Password</span>
            </button>
        </div>
    </aside>

    <!-- Hidden form: persists level + affiliation type in SESSION via SetCourseLevel.
         (asp-* + method=post already emits the anti-forgery token.) -->
    <form id="setLevelForm"
          asp-controller="ContinuesAffiliation_Facultybased"
          asp-action="SetCourseLevel"
          method="post"
          style="display:none;">
        <input type="hidden" name="level" id="hiddenLevel" />
        <input type="hidden" name="affiliationTypeId" id="hiddenAffiliationId" />
        <input type="hidden" name="facultyCode" id="hiddenFacultyCode" />
    </form>

    <!-- Update Password Modal -->
    <div class="modal fade password-modal" id="updatePasswordModal" tabindex="-1" aria-labelledby="updatePasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="UpdatePassword" asp-controller="Login" method="post" id="updatePasswordForm">
                    <div class="modal-header">
                        <h5 class="modal-title" id="updatePasswordModalLabel">Change Password</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="CollegeCode" value="@collegeCode" />
                        <div class="password-field">
                            <label for="NewPassword" class="password-field-label">
                                <span>New password</span>
                                <span class="password-required">Required</span>
                            </label>
                            <div class="password-input-wrap">
                                <input type="password" class="form-control" id="NewPassword" name="UpdatedPassword"
                                       required minlength="8" maxlength="20"
                                       pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&])[A-Za-z\d@@$!%*?&]{8,20}$"
                                       title="Password must be 8-20 characters and include uppercase, lowercase, number, and special character."
                                       autocomplete="new-password" />
                                <button type="button" class="password-visibility toggle-password" aria-label="Show password" title="Show password">
                                    <i class="bi bi-eye" id="toggleIcon"></i>
                                </button>
                            </div>
                            <div class="password-rules" aria-label="Password requirements">
                                <span class="password-rule" data-rule="length"><i class="bi bi-check2-circle"></i>8 to 20 characters</span>
                                <span class="password-rule" data-rule="upper"><i class="bi bi-check2-circle"></i>Uppercase letter</span>
                                <span class="password-rule" data-rule="lower"><i class="bi bi-check2-circle"></i>Lowercase letter</span>
                                <span class="password-rule" data-rule="numsym"><i class="bi bi-check2-circle"></i>Number and symbol</span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<script>
    // ── Values coming from the server session (safely JSON-encoded) ──────────
    const currentFacultyCode = @Html.Raw(Json.Serialize(facultyCode ?? ""));
    const currentLevel       = @Html.Raw(Json.Serialize(currentLevel));
    const currentTypeId      = @Html.Raw(Json.Serialize(currentTypeId));

    const getAffiliationTypesUrl = @Html.Raw(Json.Serialize(Url.Action("GetAffiliationTypes", "ContinuesAffiliation_Facultybased")));
    const getCourseLevelsUrl     = @Html.Raw(Json.Serialize(Url.Action("GetCourseLevels", "ContinuesAffiliation_Facultybased")));
    const loginUrl               = @Html.Raw(Json.Serialize(Url.Action("Login", "Account")));

    // Only affiliation types listed here are selectable (value = destination, kept for reference;
    // the actual redirect is done by SetCourseLevel on the server).
    const affiliationBaseUrlMap = {
        "2": @Html.Raw(Json.Serialize(Url.Action("Institution_Details", "ContinuesAffiliation_Facultybased"))),
        "3": @Html.Raw(Json.Serialize(Url.Action("IncreaseIntake", "ContinuousAffiliationIncreaseintake")))
    };

    const SIDEBAR_KEY = "rguhsSidebarCollapsed";

    // ── Small storage helpers (localStorage can throw in private mode) ───────
    function readStored(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }
    function writeStored(key, val) { try { localStorage.setItem(key, val); } catch (e) { /* ignore */ } }

    // ── Sidebar collapse / expand ────────────────────────────────────────────
    function isSidebarCollapsed() {
        const sidebar = document.querySelector(".sidebar");
        return !!sidebar && sidebar.classList.contains("collapsed");
    }

    function setSidebarCollapsed(collapsed) {
        const sidebar = document.querySelector(".sidebar");
        const handle = document.querySelector(".sidebar-handle");
        if (!sidebar || !handle) return;

        sidebar.classList.toggle("collapsed", collapsed);
        document.body.classList.toggle("app-sidebar-collapsed", collapsed);
        writeStored(SIDEBAR_KEY, collapsed ? "true" : "false");

        handle.setAttribute("aria-expanded", collapsed ? "false" : "true");
        handle.setAttribute("aria-label", collapsed ? "Expand sidebar" : "Collapse sidebar");
        handle.setAttribute("title", collapsed ? "Expand sidebar" : "Collapse sidebar");

        window.dispatchEvent(new CustomEvent("sidebarToggle", { detail: { collapsed: collapsed } }));
    }

    function toggleSidebar() { setSidebarCollapsed(!isSidebarCollapsed()); }

    window.addEventListener("resize", function () {
        if (window.innerWidth < 992 && isSidebarCollapsed()) setSidebarCollapsed(false);
    });

    // ── Fetch helper: handles expired session (redirect to login) ────────────
    async function fetchJson(url) {
        const res = await fetch(url, {
            credentials: "same-origin",
            headers: { "Accept": "application/json", "X-Requested-With": "XMLHttpRequest" }
        });

        // An expired session makes the server redirect to the login page (HTML)
        if (res.redirected || res.status === 401 || res.status === 403) {
            window.location.href = res.redirected ? res.url : loginUrl;
            throw new Error("Session expired");
        }
        if (!res.ok) throw new Error("Request failed (" + res.status + ")");
        return res.json();
    }

    // ── Affiliation dropdown ────────────────────────────────────────────────
    let affiliationOptionsCache = null;
    let courseLevelsPromise = null;

    function loadCourseLevels() {
        if (!courseLevelsPromise) {
            courseLevelsPromise = fetchJson(getCourseLevelsUrl).catch(function (err) {
                courseLevelsPromise = null;   // allow retry
                throw err;
            });
        }
        return courseLevelsPromise;
    }

    function isLevelClickable(level) {
        return level === "ug" || (level === "pg" && currentFacultyCode === "2");
    }

    function addLevelItem(subMenu, rawLevel, typeId) {
        const level = String(rawLevel).trim().toLowerCase();
        const clickable = isLevelClickable(level);
        const isCurrent = clickable && level === currentLevel && String(typeId) === String(currentTypeId);

        const el = document.createElement(clickable ? "a" : "span");
        el.className = "affiliation-subitem" + (clickable ? "" : " readonly") + (isCurrent ? " active" : "");
        el.textContent = level.toUpperCase();

        if (clickable) {
            el.href = "#";
            el.dataset.level = level;
            el.addEventListener("click", navigateToLevel);
        }
        subMenu.appendChild(el);

        if (isCurrent) {
            subMenu.classList.add("show");
            const parent = subMenu.previousElementSibling;
            if (parent) parent.classList.add("expanded");
        }
    }

    function renderAffiliationOptions(items) {
        const panel = document.getElementById("affiliationDropdownPanel");
        panel.innerHTML = "";

        if (!items || items.length === 0) {
            const empty = document.createElement("div");
            empty.className = "affiliation-loading";
            empty.textContent = "No affiliation types available.";
            panel.appendChild(empty);
            return;
        }

        const showSubMenu = ["1", "2", "4"].includes(currentFacultyCode);

        items.forEach(function (item) {
            const typeId = String(item.typeId);
            const hasRoute = !!affiliationBaseUrlMap[typeId];
            const isDisabled = !hasRoute || (currentFacultyCode === "2" && typeId === "3");

            // Parent row (built with DOM APIs, so text can never inject HTML)
            const parentDiv = document.createElement("div");
            parentDiv.className = "affiliation-option" + (isDisabled ? " disabled" : "");
            parentDiv.dataset.typeId = typeId;

            const dot = document.createElement("i");
            dot.className = "bi bi-dot";
            const label = document.createElement("span");
            label.textContent = item.typeDescription;
            const arrow = document.createElement("i");
            arrow.className = "bi bi-chevron-right ms-auto";

            parentDiv.append(dot, label, arrow);
            parentDiv.addEventListener("click", toggleUgPgSubmenu);
            panel.appendChild(parentDiv);

            if (isDisabled || !showSubMenu) return;

            const subMenu = document.createElement("div");
            subMenu.className = "affiliation-submenu";
            subMenu.dataset.parentId = typeId;
            panel.appendChild(subMenu);

            if (currentFacultyCode === "1") {
                // Faculty 1: levels depend on the college, fetched once and cached
                loadCourseLevels()
                    .then(function (levels) { (levels || []).forEach(function (l) { addLevelItem(subMenu, l, typeId); }); })
                    .catch(function () {
                        const err = document.createElement("span");
                        err.className = "affiliation-subitem readonly";
                        err.textContent = "Unable to load levels";
                        subMenu.appendChild(err);
                        subMenu.classList.add("show");
                    });
            } else {
                ["ug", "pg"].forEach(function (l) { addLevelItem(subMenu, l, typeId); });
            }
        });
    }

    function toggleUgPgSubmenu(e) {
        e.stopPropagation();
        const parent = e.currentTarget;
        if (parent.classList.contains("disabled")) return;

        const panel = document.getElementById("affiliationDropdownPanel");
        const subMenu = panel.querySelector('.affiliation-submenu[data-parent-id="' + parent.dataset.typeId + '"]');
        if (!subMenu) return;

        // Accordion: close the others
        panel.querySelectorAll(".affiliation-submenu").forEach(function (m) { if (m !== subMenu) m.classList.remove("show"); });
        panel.querySelectorAll(".affiliation-option").forEach(function (o) { if (o !== parent) o.classList.remove("expanded"); });

        subMenu.classList.toggle("show");
        parent.classList.toggle("expanded", subMenu.classList.contains("show"));
    }

    // Stores level + type in the SESSION (server side) with a normal form POST
    let levelSubmitting = false;
    function navigateToLevel(e) {
        e.preventDefault();
        e.stopPropagation();
        if (levelSubmitting) return;

        const level = e.currentTarget.dataset.level;
        const subMenu = e.currentTarget.closest(".affiliation-submenu");
        const typeId = subMenu ? subMenu.dataset.parentId : null;

        if (!typeId || !affiliationBaseUrlMap[typeId]) {
            alert("No URL configured for this affiliation type.");
            return;
        }

        levelSubmitting = true;
        document.getElementById("hiddenLevel").value = level;
        document.getElementById("hiddenAffiliationId").value = typeId;
        document.getElementById("hiddenFacultyCode").value = currentFacultyCode;
        document.getElementById("setLevelForm").submit();
    }

    function openAffiliationDropdown() {
        const panel = document.getElementById("affiliationDropdownPanel");
        const toggleLink = document.getElementById("admissionAffiliationToggle");
        if (!panel || !toggleLink) return;

        panel.classList.remove("d-none-collapsed");
        panel.classList.add("open");
        toggleLink.classList.add("expanded");
        toggleLink.setAttribute("aria-expanded", "true");

        if (affiliationOptionsCache) {
            renderAffiliationOptions(affiliationOptionsCache);
            return;
        }

        panel.innerHTML = '<div class="affiliation-loading"><span class="spinner-border" role="status"></span> Loading...</div>';

        fetchJson(getAffiliationTypesUrl)
            .then(function (data) {
                affiliationOptionsCache = data;
                renderAffiliationOptions(data);
            })
            .catch(function (err) {
                if (err && err.message === "Session expired") return;   // already redirecting
                console.error("Failed to load affiliation types:", err);
                panel.innerHTML = '<div class="affiliation-loading">Failed to load. Click again to retry.</div>';
                panel.classList.remove("open");
                panel.classList.add("d-none-collapsed");
                toggleLink.classList.remove("expanded");
                toggleLink.setAttribute("aria-expanded", "false");
            });
    }

    function closeAffiliationDropdown() {
        const panel = document.getElementById("affiliationDropdownPanel");
        const toggleLink = document.getElementById("admissionAffiliationToggle");
        if (!panel || !toggleLink) return;
        panel.classList.remove("open");
        panel.classList.add("d-none-collapsed");
        toggleLink.classList.remove("expanded");
        toggleLink.setAttribute("aria-expanded", "false");
    }

    function toggleAffiliationDropdown(e) {
        e.preventDefault();

        // A collapsed 68px rail has no room for the panel: expand first, then open
        if (isSidebarCollapsed()) {
            setSidebarCollapsed(false);
            window.setTimeout(openAffiliationDropdown, 90);
            return;
        }

        const panel = document.getElementById("affiliationDropdownPanel");
        if (panel.classList.contains("open")) closeAffiliationDropdown();
        else openAffiliationDropdown();
    }

    // Lets the notifications code update the bell badge:  setSidebarNotificationCount(5)
    function setSidebarNotificationCount(count) {
        const badge = document.getElementById("sidebarNotificationBadge");
        if (!badge) return;
        const n = Number(count) || 0;
        badge.textContent = n > 99 ? "99+" : String(n);
        badge.style.display = n > 0 ? "flex" : "none";
    }

    // ── Page init ────────────────────────────────────────────────────────────
    document.addEventListener("DOMContentLoaded", function () {

        // Modal must live directly under <body> to sit above the fixed sidebar
        const passwordModal = document.getElementById("updatePasswordModal");
        if (passwordModal && passwordModal.parentElement !== document.body) {
            document.body.appendChild(passwordModal);
        }

        // Show / hide password
        const toggleBtn = document.querySelector(".toggle-password");
        const passwordInput = document.getElementById("NewPassword");
        const toggleIcon = document.getElementById("toggleIcon");

        if (toggleBtn && passwordInput && toggleIcon) {
            toggleBtn.addEventListener("click", function () {
                const hidden = passwordInput.getAttribute("type") === "password";
                passwordInput.setAttribute("type", hidden ? "text" : "password");
                toggleIcon.className = hidden ? "bi bi-eye-slash" : "bi bi-eye";
                toggleBtn.setAttribute("aria-label", hidden ? "Hide password" : "Show password");
            });
        }

        // Live password-rule feedback
        if (passwordInput) {
            const rules = {
                length: function (v) { return v.length >= 8 && v.length <= 20; },
                upper:  function (v) { return /[A-Z]/.test(v); },
                lower:  function (v) { return /[a-z]/.test(v); },
                numsym: function (v) { return /\d/.test(v) && /[@@$!%*?&]/.test(v); }
            };
            passwordInput.addEventListener("input", function () {
                document.querySelectorAll(".password-rule").forEach(function (el) {
                    const fn = rules[el.dataset.rule];
                    el.classList.toggle("ok", !!fn && fn(passwordInput.value));
                });
            });
        }

        // Restore collapsed state (desktop only)
        if (window.innerWidth >= 992) {
            setSidebarCollapsed(readStored(SIDEBAR_KEY) === "true");
        }
    });
</script>
