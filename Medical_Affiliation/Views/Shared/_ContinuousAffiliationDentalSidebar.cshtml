                    Key = "AdditionalCourses",
                    Label = "Additional Courses",
                    Group = "Intake Details",
                    Ctrl = "CourseAffiliation",
                    Act = "Index"
                }
            });
    }

    // ============================================================
    // LEVEL FILTER
    // ============================================================

    // allSteps = allSteps
    //     .Where(step =>
    //         step.Levels == null
    //         || step.Levels.Count == 0
    //         || step.Levels.Any(l =>
    //             levels.Contains(l)
    //             &&
    //             (
    //                 isDental
    //                 || string.IsNullOrEmpty(activeLevel)
    //                 || l.Equals(
    //                     activeLevel,
    //                     StringComparison.OrdinalIgnoreCase)
    //             )
    //         ))
    //     .ToList();

    allSteps = allSteps
        .Where(step =>
            step.Levels == null
            || step.Levels.Count == 0
            || (
                !string.IsNullOrEmpty(activeLevel)
                && step.Levels.Any(l =>
                    l.Equals(
                        activeLevel,
                        StringComparison.OrdinalIgnoreCase))
            )
            || (
                string.IsNullOrEmpty(activeLevel)
                && step.Levels.Any(l =>
                    levels.Contains(
                        l,
                        StringComparer.OrdinalIgnoreCase))
            )
        )
        .ToList();

    // ============================================================
    // DENTAL-SPECIFIC CLEANUP
    // ============================================================

    if (isDental)
    {
        // Associated Institutions and SS Courses Offered are not required
        allSteps = allSteps
            .Where(x =>
                x.Key != "AssociatedInstitutions"
                && x.Key != "SsCoursesOffered")
            .ToList();

        // Chair Distribution after Classroom & Laboratory
        var chairIndex =
            allSteps.FindIndex(x =>
                x.Key == "DentalSkillsLab");

        if (chairIndex >= 0)
        {
            allSteps.Insert(
                chairIndex + 1,
                new StepItem
                {
                    Key = "ChairDistribution",
                    Label = "Chair Distribution",
                    Group = "Physical Infrastructure",
                    Ctrl = "PhysicalInfrastructure",
                    Act = "ChairDistribution"
                });
        }

        // ========================================================
        // FINAL PHYSICAL INFRASTRUCTURE ORDER
        // ========================================================

        var physicalOrder = new List<string>
        {
            "ClinicalFacilities",
            "LandBuilding",
            "DentalSkillsLab",
            "ChairDistribution",
            "BedDistribution",
            "Hostel",
            "DepartmentUnits",
            "DentalEquipmentDetails",
            "Vehicle"
        };

        var physicalSteps = allSteps
            .Where(x =>
                x.Group == "Physical Infrastructure")
            .ToList();

        var orderedPhysicalSteps = physicalOrder
            .Select(key =>
                physicalSteps.FirstOrDefault(x =>
                    x.Key == key))
            .Where(x => x != null)
            .ToList();

        var remainingPhysicalSteps = physicalSteps
            .Where(x =>
                !physicalOrder.Contains(x.Key))
            .ToList();

        allSteps.RemoveAll(x =>
            x.Group == "Physical Infrastructure");

        var insertAt = allSteps.FindIndex(x =>
            x.Group != "Basic Details"
            && x.Group != "Intake Details");

        if (insertAt < 0)
            insertAt = allSteps.Count;

        allSteps.InsertRange(
            insertAt,
            orderedPhysicalSteps.Concat(
                remainingPhysicalSteps));

        // ========================================================
        // MOVE INTAKE DETAILS INTO BASIC DETAILS
        // ========================================================

        var intakeStep =
            allSteps.FirstOrDefault(x =>
                x.Key == "IntakeDetails");

        if (intakeStep != null)
        {
            allSteps.Remove(intakeStep);

            intakeStep.Group = "Basic Details";

            allSteps.Insert(0, intakeStep);
        }

        // ========================================================
        // FINAL INTAKE ORDER
        // ========================================================

        var intakeOrder = new List<string>
        {
            "BDSDetails",
            "PgCourses",
            "SsCoursesApplied",
            "DentalFacultyDetails"
        };

        var intakeSteps = allSteps
            .Where(x =>
                x.Group == "Intake Details")
            .ToList();

        var orderedIntakeSteps = intakeOrder
            .Select(key =>
                intakeSteps.FirstOrDefault(x =>
                    x.Key == key))
            .Where(x => x != null)
            .ToList();

        var remainingIntakeSteps = intakeSteps
            .Where(x =>
                !intakeOrder.Contains(x.Key))
            .ToList();

        allSteps.RemoveAll(x =>
            x.Group == "Intake Details");

        var basicLastIndex = allSteps
            .Select((step, index) =>
                new { step, index })
            .Where(x =>
                x.step.Group == "Basic Details")
            .Select(x => x.index)
            .DefaultIfEmpty(-1)
            .Max();

        if (basicLastIndex >= 0)
        {
            allSteps.InsertRange(
                basicLastIndex + 1,
                orderedIntakeSteps.Concat(
                    remainingIntakeSteps));
        }
    }

    // ============================================================
    // PROGRESS
    // Exclude Intake Details and Preview
    // ============================================================

    var progressSteps = allSteps
        .Where(s =>
            // s.Key != "IntakeDetails"
            // && 
            s.Key != "PreviewMode")
        .ToList();

    int total = progressSteps.Count;

    int done = progressSteps.Count(s =>
        doneSteps.Contains(s.Key));

    int pct = total > 0
        ? (int)Math.Round(
            (double)done / total * 100)
        : 0;

    // ============================================================
    // GROUPING
    // ============================================================

    var groupedSteps = allSteps
        .GroupBy(s => s.Group)
        .ToList();

    // ============================================================
    // GROUP ICONS
    // ============================================================

    string GetGroupIcon(string groupName) => groupName switch
    {
        "Basic Details" => "bi-building",
        "Intake Details" => "bi-mortarboard",
        "Coursewise Application(Form-B)" => "bi-journal-text",
        "Physical Infrastructure" => "bi-house-gear",
        "Academic & Admin" => "bi-clipboard-data",
        "Research & Library" => "bi-book",
        "Human Resources" => "bi-people",
        "Payment" => "bi-cash-coin",
        "Final Preview" => "bi-eye",
        _ => "bi-folder2"
    };
}

<link rel="stylesheet" href="~/css/common-form.css" />
<link rel="stylesheet" href="/css/dental-sidebar.css">

<aside class="ca-sb" aria-label="Continuous affiliation navigation">

    <button type="button"
            class="ca-sb-handle"
            onclick="toggleCaSidebar()"
            aria-expanded="true"
            aria-label="Collapse sidebar"
            title="Collapse sidebar">
        <i class="bi bi-chevron-left" aria-hidden="true"></i>
    </button>

    <div class="ca-sb-top">
        <div class="ca-sb-top-row">
            <div class="ca-sb-title">College Details</div>
        </div>
        <div class="ca-sb-subtitle">Type of Affiliation</div>
        <div class="ca-sb-affiliation">@(string.IsNullOrWhiteSpace(typeOfAffiliation) ? "Not available" : typeOfAffiliation)</div>
    </div>

    <div class="ca-sb-prog">
        <div class="ca-sb-prog-top">
            <span class="ca-sb-prog-lbl">Completion</span>
            <span class="ca-sb-prog-pct">@pct%</span>
        </div>
        <div class="ca-sb-track" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" aria-label="Application completion">
            <div class="ca-sb-fill" style="width:@pct%"></div>
        </div>
        <div class="ca-sb-prog-note">@done of @total steps completed</div>
    </div>

    <nav class="accordion-container" aria-label="Application steps">
        @foreach (var group in groupedSteps)
        {
            var groupId = group.Key.Replace(" ", "");
            var groupDone = group.Count(s => doneSteps.Contains(s.Key));
            var groupTotal = group.Count();

            <div class="accordion-item">
                <button type="button"
                        class="accordion-header tab-header @(isSidebarLocked && group.Key == "Final Preview" ? "active-tab" : "")"
                        id="header-@groupId"
                        data-tab="@groupId"
                        aria-expanded="@(isSidebarLocked && group.Key == "Final Preview" ? "true" : "false")"
                        aria-controls="content-@groupId"
                        disabled="@(isSidebarLocked && group.Key != "Final Preview")"
                        onclick="toggleAccordion('@groupId')">

                    <span>@group.Key</span>
                    <span class="accordion-group-badge">@groupDone/@groupTotal</span>

                    <i class="bi bi-chevron-down toggle-icon" aria-hidden="true"></i>
                </button>

                <div class="accordion-content tab-content"
                     id="content-@groupId"
                     role="region"
                     aria-labelledby="header-@groupId"
                     data-tab-content="@groupId"
                     style="@(isSidebarLocked && group.Key == "Final Preview"
                                    ? "max-height: 1000px;"
                                    : null)">

                    <ul class="ca-sb-nav-list">
                        @foreach (var step in group)
                        {
                            var isActive = string.Equals(currentCtrl, step.Ctrl, StringComparison.OrdinalIgnoreCase)
                                           && string.Equals(currentAct, step.Act, StringComparison.OrdinalIgnoreCase);
                            var isDone = doneSteps.Contains(step.Key);

                            string dotCls = isActive ? "ca-dot ca-dot-current" : isDone ? "ca-dot ca-dot-done" : "ca-dot ca-dot-pending";
                            string linkCls = "ca-sb-link" + (isActive ? " is-active" : "");

                            <li>
                                @{
                                    var routeValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary();
                                    var currentCourseCode = Context?.Request?.Query["courseCode"].ToString();
                                    var currentTypeOfAffiliation = Context?.Request?.Query["typeOfAffiliation"].ToString();
                                    if (string.IsNullOrEmpty(currentCourseCode))
                                    {
                                        currentCourseCode = Context?.Session?.GetString("CourseCode");
                                    }
                                    if (string.IsNullOrEmpty(currentTypeOfAffiliation))
                                    {
                                        currentTypeOfAffiliation = Context?.Session?.GetString("TypeOfAffiliation")
                                            ?? Context?.Session?.GetString("SelectedTypeOfAffiliation");
                                    }
                                    if (!string.IsNullOrEmpty(currentCourseCode)) routeValues["courseCode"] = currentCourseCode;
                                    if (!string.IsNullOrEmpty(currentTypeOfAffiliation)) routeValues["typeOfAffiliation"] = currentTypeOfAffiliation;
                                }
                                @if (isSidebarLocked && step.Key != "PreviewMode")
                                {
                                    <span class="ca-sb-link is-locked"
                                          aria-disabled="true"
                                          title="This application is locked after final submission">
                                        <span class="@dotCls" aria-hidden="true">
                                            @if (isDone)
                                            {
                                                <text>&#10003;</text>
                                            }
                                        </span>
                                        <span class="ca-sb-label">@step.Label</span>
                                        <i class="bi bi-lock-fill ms-1" aria-hidden="true"></i>
                                    </span>
                                }
                                else
                                {
                                    <a href="@Url.Action(step.Act, step.Ctrl, routeValues)"
                                       class="@linkCls"
                                       aria-current="@(isActive ? "page" : null)">
                                        <span class="@dotCls" aria-hidden="true">
                                            @if (isDone)
                                            {
                                                <text>&#10003;</text>
                                            }
                                        </span>
                                        <span class="ca-sb-label">@step.Label</span>
                                        @if (isDone && (!isActive ||
                                            step.Key == "WorkshopDetails" ||
                                            step.Key == "AnimalHouseDetails" ||
                                            step.Key == "DentalFieldPracticeArea" ||
                                            step.Key == "ActionTakenReport"))
                                        {
                                            <span class="ca-sb-check" aria-hidden="true">&#10003;</span>
                                        }
                                    </a>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </nav>

    @* Collapsed icon rail — mirrors the accordion groups above so the
       sidebar stays fully navigable even at 56px. Clicking an icon
       expands the sidebar and opens that group. *@
    <div class="ca-sb-rail" aria-hidden="true">
        <div class="ca-sb-rail-progress" style="--pct:@pct;" title="@pct% complete">
            <span>@pct%</span>
        </div>
        @foreach (var group in groupedSteps)
        {
            var groupId = group.Key.Replace(" ", "");
            var groupDone = group.Count(s => doneSteps.Contains(s.Key));
            var groupTotal = group.Count();

            <button type="button"
                    class="ca-sb-rail-item"
                    title="@group.Key (@groupDone/@groupTotal)"
                    onclick="expandToGroup('@groupId')">
                <i class="bi @GetGroupIcon(group.Key)" aria-hidden="true"></i>
                @if (groupTotal > 0 && groupDone == groupTotal)
                {
                    <span class="rail-badge"></span>
                }
            </button>
        }
    </div>

    <div class="ca-sb-footer">
        <a asp-action="Dashboard" asp-controller="Collegelogin" class="ca-sb-back" title="Back to Dashboard">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span class="ca-sb-footer-label">Back to Dashboard</span>
        </a>
    </div>

</aside>

<script>
    // Applies (or clears) the collapsed state on both the shell wrapper
    // (if present) and the sidebar itself, keeps the handle's a11y
    // attributes in sync, and persists the choice for the session.
    function setSidebarCollapsed(collapsed) {
        const shell = document.querySelector(".ca-shell");
        const sidebar = document.querySelector(".ca-sb");
        const handle = document.querySelector(".ca-sb-handle");
        if (!sidebar || !handle) return;

        if (shell) shell.classList.toggle("sidebar-collapsed", collapsed);
        sidebar.classList.toggle("sidebar-collapsed", collapsed);

        sessionStorage.setItem("caSidebarCollapsed", collapsed ? "true" : "false");

        handle.setAttribute("aria-expanded", collapsed ? "false" : "true");
        handle.setAttribute("aria-label", collapsed ? "Expand sidebar" : "Collapse sidebar");
        handle.setAttribute("title", collapsed ? "Expand sidebar" : "Collapse sidebar");
    }

    function toggleCaSidebar() {
        const sidebar = document.querySelector(".ca-sb");
        if (!sidebar) return;
        const isCollapsed = sidebar.classList.contains("sidebar-collapsed");
        setSidebarCollapsed(!isCollapsed);
    }

    // Called from the collapsed icon rail: expand the sidebar, then open
    // the matching accordion group once the width transition has started.
    function expandToGroup(groupId) {
        setSidebarCollapsed(false);
        window.setTimeout(function() {
            toggleAccordion(groupId);
        }, 80);
    }

    function toggleAccordion(groupId) {
        const currentContent = document.querySelector(`[data-tab-content="${groupId}"]`);
        const currentHeader = document.querySelector(`[data-tab="${groupId}"]`);
        if (!currentContent || !currentHeader) return;
        const isOpen = currentHeader.classList.contains("active-tab");

        document.querySelectorAll(".tab-content").forEach(c => c.style.maxHeight = null);
        document.querySelectorAll(".tab-header").forEach(h => {
            h.classList.remove("active-tab");
            h.setAttribute("aria-expanded", "false");
        });

        if (isOpen) {
            sessionStorage.removeItem("activeTab");
            return;
        }

        sessionStorage.setItem("activeTab", groupId);

        currentContent.style.maxHeight = currentContent.scrollHeight + "px";
        currentHeader.classList.add("active-tab");
        currentHeader.setAttribute("aria-expanded", "true");
    }

    // Auto-open the group containing the active step (or the last opened group)
    window.addEventListener("DOMContentLoaded", function() {
        const isCollapsed = sessionStorage.getItem("caSidebarCollapsed") === "true";
        setSidebarCollapsed(isCollapsed);

        let activeTab = sessionStorage.getItem("activeTab");

        if (!activeTab) {
            const activeLink = document.querySelector(".ca-sb-link.is-active");
            if (activeLink) {
                const parent = activeLink.closest(".tab-content");
                if (parent) {
                    activeTab = parent.getAttribute("data-tab-content");
                }
            }
        }

        if (activeTab && document.querySelector(`[data-tab="${activeTab}"]`)) {
            toggleAccordion(activeTab);
        }
    });
</script>
