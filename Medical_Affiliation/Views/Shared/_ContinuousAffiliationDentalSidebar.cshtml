@* Views/Shared/_ContinuousAffiliationSidebar.cshtml *@
@using Medical_Affiliation.DATA
@inject IHttpContextAccessor HttpContextAccessor
@inject ApplicationDbContext _context
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@{
    var collegeCode = HttpContextAccessor.HttpContext?.Session.GetString("CollegeCode");
    var collegeName = HttpContextAccessor.HttpContext?.Session.GetString("CollegeName");
    var facultyCode = Context.Session.GetString("FacultyCode");

    bool isDental = facultyCode == "2";

    // ============================================================
    // TYPE OF AFFILIATION
    // ============================================================

    var typeOfAffiliation =
        HttpContextAccessor.HttpContext?.Session?.GetString("TypeOfAffiliation")
        ?? HttpContextAccessor.HttpContext?.Request?.Cookies["TypeOfAffiliation"]
        ?? HttpContextAccessor.HttpContext?.User?.FindFirst("TypeOfAffiliation")?.Value;

    if (string.IsNullOrWhiteSpace(typeOfAffiliation))
    {
        var typeId =
            HttpContextAccessor.HttpContext?.Session?.GetInt32("AffiliationType");

        if (!typeId.HasValue)
        {
            var typeIdString =
                HttpContextAccessor.HttpContext?.Session?.GetString("TypeOfAffiliationId")
                ?? HttpContextAccessor.HttpContext?.Request?.Cookies["AffiliationTypeId"];

            if (!string.IsNullOrWhiteSpace(typeIdString)
                && int.TryParse(typeIdString, out var parsedId))
            {
                typeId = parsedId;
            }
        }

        if (typeId.HasValue)
        {
            typeOfAffiliation = await _context.TypeOfAffiliations
                .Where(t => t.TypeId == typeId.Value)
                .Select(t => t.TypeDescription)
                .FirstOrDefaultAsync();
        }
    }

    // ============================================================
    // COURSE LEVELS
    // Dental -> CaProgresses
    // Others -> AcademicIntakes
    // ============================================================

    var levels = new List<string>();

    if (isDental)
    {
        levels = await _context.CaProgresses
            .Where(x =>
                x.CollegeCode == collegeCode &&
                x.IsCompleted == true &&
                !string.IsNullOrEmpty(x.CourseLevel))
            .Select(x => x.CourseLevel.Trim().ToUpper())
            .Distinct()
            .ToListAsync();
    }
    else
    {
        levels = await (
            from ai in _context.AcademicIntakes
            join mc in _context.MstCourses
                on ai.Courses equals mc.CourseCode.ToString()
            where ai.CollegeCode == collegeCode
                  && ai.FacultyCode == facultyCode
            select mc.CourseLevel
        )
        .Distinct()
        .ToListAsync();

        // Fallback for non-Dental faculties
        if (!levels.Any())
        {
            levels = await (
                from ai in _context.AcademicIntakes
                join cm in _context.MstCourses
                    on ai.Courses equals cm.CourseCode.ToString()
                where ai.CollegeCode == collegeCode
                      && ai.Ay2026TotalIntake > 0
                      && !string.IsNullOrEmpty(ai.Courses)
                select cm.CourseLevel
            )
            .Distinct()
            .ToListAsync();
        }
    }

    levels = levels
        .Where(l => !string.IsNullOrWhiteSpace(l))
        .Select(l => l.Trim().ToUpperInvariant())
        .Distinct()
        .ToList();

    // ============================================================
    // SELECTED LEVEL
    // ============================================================

    var selectedLevel =
        Context.Session.GetString("SelectedCourseLevel")?
            .Trim()
            .ToUpperInvariant();

    var selectedCourseLevel =
        HttpContextAccessor.HttpContext?.Session?
            .GetString("CourseLevel")?
            .Trim()
            .ToUpperInvariant();

    // Always prefer the currently selected CourseLevel
    var activeLevel = selectedCourseLevel ?? selectedLevel;

    bool ShowUgTab = activeLevel == "UG";
    bool ShowPgTab = activeLevel == "PG";
    bool ShowSSTab = activeLevel == "SS";

    // ============================================================
    // SELECTED COURSE
    // ============================================================

    var selectedCourseCode =
        Context.Request.Query["courseCode"].ToString();

    if (string.IsNullOrWhiteSpace(selectedCourseCode))
    {
        selectedCourseCode =
            Context.Session.GetString("CourseCode");
    }

    bool hasSelectedCourse =
        !string.IsNullOrWhiteSpace(selectedCourseCode);


    // ============================================================
    // DENTAL FINAL SUBMISSION LOCK STATUS
    // ============================================================

    bool isSidebarLocked = false;

    if (isDental && !string.IsNullOrWhiteSpace(collegeCode))
    {
        int? affiliationTypeId =
            Context.Session.GetInt32("AffiliationType");

        if (!affiliationTypeId.HasValue)
        {
            var typeIdString =
                Context.Session.GetString("TypeOfAffiliationId")
                ?? Context.Request.Cookies["AffiliationTypeId"];

            if (int.TryParse(typeIdString, out var parsedTypeId))
                affiliationTypeId = parsedTypeId;
        }

        if (affiliationTypeId.HasValue &&
            !string.IsNullOrWhiteSpace(activeLevel))
        {
            isSidebarLocked = await _context.FinalDentalSubmissions
                .AsNoTracking()
                .AnyAsync(x =>
                    x.CollegeCode == collegeCode &&
                    x.FacultyCode == 2 &&
                    x.CourseLevel == activeLevel &&
                    x.AffiliationTypeId == affiliationTypeId.Value &&
                    x.IsActive &&
                    x.IsLocked);
        }
    }

    // ============================================================
    // TRUST / ORGANIZATION TYPE
    // ============================================================

    var institutionRecord = await _context.AffInstitutionsDetails
        .AsNoTracking()
        .FirstOrDefaultAsync(x =>
            x.CollegeCode == collegeCode &&
            x.FacultyCode == facultyCode &&
            (
                string.IsNullOrWhiteSpace(selectedCourseLevel)
                || x.CourseLevel == selectedCourseLevel
            ));

    string? organizationCategory = null;

    if (institutionRecord != null
        && int.TryParse(
            institutionRecord.TypeOfInstitution,
            out var selectedTypeId)
        && selectedTypeId > 0)
    {
        organizationCategory = await _context.MstInstitutionTypes
            .AsNoTracking()
            .Where(x =>
                x.InstitutionTypeId == selectedTypeId)
            .Select(x => x.OrganizationCategory)
            .FirstOrDefaultAsync();
    }

    bool showTrustSteps = true;

    if (!string.IsNullOrWhiteSpace(organizationCategory))
    {
        showTrustSteps =
            string.Equals(
