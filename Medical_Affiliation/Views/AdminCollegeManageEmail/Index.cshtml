@model CollegeEmailUpdateViewModel

@{
    ViewData["Title"] = "Update College Email";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


<style>

    .page-wrapper{
        padding-top: 0;
    }
    .college-email-page {
        --email-ink: #18324b;
        --email-muted: #6b7d90;
        --email-blue: #1769aa;
        --email-blue-dark: #0e4d80;
        --email-line: #dce7f0;
        min-height: calc(100vh - 8rem);
        padding: 1.5rem 0 3rem;
        color: var(--email-ink);
        background: #f4f8fb;
    }

    .page-wrapper:has(.college-email-page) .page-shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0;
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0 1.25rem 2rem;
    }

    .page-wrapper:has(.college-email-page) .portal-sidebar-shell { display: none; }
    .page-wrapper:has(.college-email-page) .page-content,
    .page-wrapper:has(.college-email-page) .portal-main-card {
        width: 100%;
        max-width: none;
        min-width: 0;
        margin-left: 0;
    }

    .college-email-page .page-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
        padding: 1.75rem 2rem;
        color: #fff;
        border-radius: 0.75rem;
        background: linear-gradient(120deg, var(--email-blue-dark), var(--email-blue));
        box-shadow: 0 0.75rem 1.75rem rgba(24, 50, 75, 0.14);
    }

    .college-email-page .eyebrow {
        margin-bottom: 0.4rem;
        color: #a9d7f3;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .college-email-page .page-heading h1 {
        margin: 0;
        font-size: clamp(1.5rem, 2.2vw, 2rem);
        font-weight: 700;
    }

    .college-email-page .page-heading p {
        max-width: 42rem;
        margin: 0.5rem 0 0;
        color: rgba(255, 255, 255, 0.78);
    }

    .college-email-page .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
        padding: 0.6rem 0.9rem;
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: 0.45rem;
        background: rgba(255, 255, 255, 0.1);
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    .college-email-page .back-link:hover,
    .college-email-page .back-link:focus-visible {
        color: #fff;
        border-color: rgba(255, 255, 255, 0.7);
        background: rgba(255, 255, 255, 0.2);
    }

    .college-email-page .filter-card,
    .college-email-page .results-card,
    .college-email-page .empty-card {
        border: 1px solid var(--email-line) !important;
        border-radius: 0.7rem;
        background: #fff;
        box-shadow: 0 0.5rem 1.5rem rgba(34, 67, 96, 0.07) !important;
    }

    .college-email-page .filter-card {
        margin-bottom: 1.25rem;
    }

    .college-email-page .section-label {
        color: var(--email-muted);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .college-email-page .form-select,
    .college-email-page .form-control {
        border-color: var(--email-line);
        border-radius: 0.45rem;
    }

    .college-email-page .form-select:focus,
    .college-email-page .form-control:focus {
        border-color: #6daed5;
        box-shadow: 0 0 0 0.2rem rgba(23, 105, 170, 0.12);
    }

    .college-email-page .results-card .card-header {
        padding: 1.25rem 1.5rem;
        background: #fbfdff !important;
        border-bottom: 1px solid var(--email-line) !important;
    }

    .college-email-page .results-card .table {
        color: var(--email-ink);
    }

    .college-email-page .results-card thead th {
        padding-top: 0.85rem;
        padding-bottom: 0.85rem;
        color: var(--email-muted);
        background: #f1f6fa;
        border-bottom: 1px solid var(--email-line);
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .college-email-page .results-card tbody tr {
        border-color: #edf2f6;
    }

    .college-email-page .results-card tbody tr:hover {
        background: #f8fbfd;
    }

    .college-email-page .results-card .card-footer {
        border-top: 1px solid var(--email-line) !important;
    }

    .college-email-page .update-email-btn {
        border-radius: 0.4rem;
        background: var(--email-blue);
        border-color: var(--email-blue);
    }

    .college-email-page .update-email-btn:hover,
    .college-email-page .update-email-btn:focus-visible {
        background: var(--email-blue-dark);
        border-color: var(--email-blue-dark);
    }

    .college-email-page .pagination .page-link {
        color: var(--email-blue);
        border-color: var(--email-line);
    }

    .college-email-page .pagination .active .page-link {
        color: #fff;
        background: var(--email-blue);
        border-color: var(--email-blue);
    }

    .college-email-page .empty-card {
        color: var(--email-muted);
    }

    /* Email cell editing */

    .email-cell {
        cursor: text;
    }

    /* Readonly email  */
    .email-input[readonly] {
        background-color: transparent;
        border-color: transparent;
        cursor: text;
        box-shadow: none;
    }

    .email-input[readonly]:hover {
        background-color: #f8f9fa;
        border-color: #dee2e6;
    }

    /* Editing */
    .email-input.email-editing {
        background-color: #fff;
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.12);
    }

    .email-wrapper {
        min-width: 18rem;
    }

    /* ==============================
       PASSWORD FIELD
       ============================== */

    .password-wrapper {
        min-width: 18rem;
    }

    .password-input {
        background-color: #f8fafc !important;
        border-color: var(--email-line) !important;
        letter-spacing: 0.08em;
        font-family: monospace;
    }

    .password-input:focus {
        box-shadow: none !important;
    }

    .password-toggle-btn,
    .password-copy-btn {
        min-width: 42px;
        background: #fff;
        border-color: var(--email-line);
        color: var(--email-muted);
    }

    .password-toggle-btn:hover,
    .password-copy-btn:hover {
        background: #f1f6fa;
        color: var(--email-blue);
        border-color: #b9d2e3;
    }

    .password-toggle-btn:focus,
    .password-copy-btn:focus {
        box-shadow: 0 0 0 0.15rem rgba(23, 105, 170, 0.12);
    }


    /* ==========================================
       EMAIL STATUS HIGHLIGHT
       ========================================== */

    .college-email-page .college-has-email {
        background: #f5fbf7;
    }

    .college-email-page .college-has-email:hover {
        background: #edf8f1 !important;
    }

    .college-email-page .college-has-email td:first-child {
        border-left: 3px solid #3aa76d;
    }

    .college-email-page .email-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        margin-top: 0.35rem;
        padding: 0.2rem 0.5rem;
        border-radius: 999px;
        font-size: 0.68rem;
        font-weight: 700;
        line-height: 1;
    }

    .college-email-page .email-status-badge.available {
        color: #26734d;
        background: #e5f6ec;
    }

    .college-email-page .email-status-badge.missing {
        color: #8a5a00;
        background: #fff4d6;
    }

    @@media (max-width: 767.98px) {
        .college-email-page {
            padding-top: 1rem;
        }

        .college-email-page .page-heading {
            align-items: flex-start;
            flex-direction: column;
            padding: 1.35rem;
        }

        .college-email-page .back-link {
            order: -1;
        }

        .college-email-page .filter-card .card-body,
        .college-email-page .results-card .card-header {
            padding: 1rem;
        }
    }

</style>

<div class="college-email-page">
    <div class="container-fluid">
        <div class="page-heading">
            <div>
                <div class="eyebrow">Administration</div>
                <h1>Update College Email</h1>
                <p>Select a faculty to review and update registered college email addresses.</p>
            </div>
            <a class="back-link" href="@Url.Action("AdminDashboard", "Admin")">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Back to dashboard
            </a>
        </div>

        <div class="card filter-card border-0 mb-4">
            <div class="card-body p-4">

                <div class="d-flex align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">
                            Import College Master
                        </h5>

                        <small class="text-muted">
                            Upload the college master Excel file containing college code,
                            college name, email and other details.
                        </small>
                    </div>
                </div>

                <form id="collegeImportForm"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div class="row align-items-end g-3">

                        <div class="col-md-8">

                            <label class="section-label d-block mb-2">
                                College Master File
                            </label>

                            <input type="file"
                                   id="collegeMasterFile"
                                   name="file"
                                   class="form-control"
                                   accept=".xlsx,.xls,.csv" />

                            <small class="text-muted">
                                Supported formats: Excel (.xlsx, .xls) or CSV.
                            </small>

                        </div>

                        <div class="col-md-4">

                            <button type="button"
                                    id="importCollegeBtn"
                                    class="btn btn-primary w-100">

                                <i class="bi bi-upload me-1"></i>
                                Import College Data

                            </button>

                        </div>

                    </div>

                </form>

            </div>
        </div>

        <div class="card filter-card border-0">
            <div class="card-body p-4">
                <div class="row align-items-end">
                    <div class="col-md-6">
                        <label asp-for="FacultyCode" class="section-label d-block mb-2">Faculty</label>
                        <select asp-for="FacultyCode" asp-items="Model.Faculties" class="form-select" id="facultyDropdown">
                            <option value="">-- Select Faculty --</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

    <!-- ============================= -->
    <!-- COLLEGE TABLE -->
    <!-- ============================= -->

    <div id="collegeTableCard" class="card results-card border-0 shadow-sm d-none">
        <!-- ============================= -->
        <!-- EMAIL SUMMARY -->
        <!-- ============================= -->

        <div class="email-summary px-4 pt-4">
            <div class="row g-3">

                <!-- TOTAL -->
                <div class="col-md-4">
                    <div class="email-stat-card total-stat">
                        <div class="stat-icon">
                            <i class="bi bi-buildings"></i>
                        </div>

                        <div>
                            <div class="stat-label">Total Colleges</div>
                            <div class="stat-value" id="totalCollegeCount">0</div>
                        </div>
                    </div>
                </div>

                <!-- EMAIL AVAILABLE -->
                <div class="col-md-4">
                    <div class="email-stat-card email-available-stat">
                        <div class="stat-icon">
                            <i class="bi bi-envelope-check"></i>
                        </div>

                        <div>
                            <div class="stat-label">Email Available</div>
                            <div class="stat-value" id="emailAvailableCount">0</div>
                        </div>
                    </div>
                </div>

                <!-- EMAIL MISSING -->
                <div class="col-md-4">
                    <div class="email-stat-card email-missing-stat">
                        <div class="stat-icon">
                            <i class="bi bi-envelope-x"></i>
                        </div>

                        <div>
                            <div class="stat-label">Email Missing</div>
                            <div class="stat-value" id="emailMissingCount">0</div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="card-header bg-white border-0 p-4">
            <div class="row align-items-center">
                <div class="col-lg-4">
                    <h5 class="fw-bold mb-1">
                        College Email Details
                    </h5>
                    <small class="text-muted">
                        Click an email address to edit it.
                    </small>
                </div>
                <div class="col-lg-8 mt-3 mt-lg-0">
                    <div class="row g-2">
                        <!-- SEARCH -->
                        <div class="col-md-5">
                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-search"></i>
                                </span>

                                <input type="text"
                                        class="form-control"
                                        id="collegeSearch"
                                        placeholder="Search college code, name or email..." />

                            </div>

                        </div>


                        <!-- EMAIL STATUS -->
                        <div class="col-md-3">
                            <select class="form-select"
                                    id="emailStatusFilter">
                                <option value="all">
                                    All Colleges
                                </option>

                                <option value="available">
                                    Email Available
                                </option>

                                <option value="missing">
                                    Email Missing
                                </option>

                            </select>

                        </div>


                        <!-- SORT -->
                        <div class="col-md-4">

                            <select class="form-select"
                                    id="collegeSort">

                                <option value="code-asc">
                                    College Code ↑
                                </option>

                                <option value="code-desc">
                                    College Code ↓
                                </option>

                                <option value="name-asc">
                                    College Name A–Z
                                </option>

                                <option value="name-desc">
                                    College Name Z–A
                                </option>

                                <option value="email-first">
                                    Email Available First
                                </option>

                                <option value="email-last">
                                    Email Missing First
                                </option>

                            </select>

                        </div>

                    </div>

                </div>

            </div>

        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">
                                Sl NO
                            </th>
                            <th>
                                College Code
                            </th>
                            <th>
                                College Name
                            </th>
                            <th style="min-width: 320px;">
                                Email
                            </th>
                            <th style="min-width: 320px;">
                                Password
                            </th>

                            <th class="text-center">
                                Action
                            </th>
                        </tr>
                    </thead>
                    <tbody id="collegeTableBody">
                    </tbody>
                </table>
                <div class="card-footer bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                        <div id="paginationInfo" class="text-muted small">
                            Showing 0 of 0 colleges
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0" id="collegePagination">
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ============================= -->
    <!-- NO DATA -->
    <!-- ============================= -->

    <div id="noCollegeMessage" class="card empty-card border-0 shadow-sm d-none">
        <div class="card-body text-center py-5">
            <i class="bi bi-building fs-1 text-muted"></i>

            <h5 class="mt-3">
                No Colleges found
            </h5>

            <p class="text-muted mb-0">
                No colleges are available for the selected faculty.
            </p>
        </div>
    </div>
</div>
</div>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>



@section Scripts {
    <script>
        const facultyDropdown = document.getElementById("facultyDropdown");

        const collegeTableCard = document.getElementById("collegeTableCard");

        const collegeTableBody = document.getElementById("collegeTableBody");

        const noCollegeMessage = document.getElementById("noCollegeMessage");

        const collegeSearch = document.getElementById("collegeSearch");

        const collegePagination = document.getElementById("collegePagination");
        const paginationInfo = document.getElementById("paginationInfo");

        let allColleges = [];
        let currentPage = 1;
        const pageSize = 10;

        const emailStatusFilter =
            document.getElementById("emailStatusFilter");

        const collegeSort =
            document.getElementById("collegeSort");

        const totalCollegeCount =
            document.getElementById("totalCollegeCount");

        const emailAvailableCount =
            document.getElementById("emailAvailableCount");

        const emailMissingCount =
            document.getElementById("emailMissingCount");

        function hasCollegeEmail(college) {
            return !!(
                college.collegeEmail &&
                college.collegeEmail.trim() !== ""
            );
        }


        function updateEmailCounts() {
            const total = allColleges.length;

            const available = allColleges.filter(
                college => hasCollegeEmail(college)
            ).length;

            const missing = total - available;

            totalCollegeCount.textContent = total;

            emailAvailableCount.textContent = available;

            emailMissingCount.textContent = missing;
        }

        function sortColleges(colleges) {
            const sortValue = collegeSort.value;

            return [...colleges].sort((a, b) => {

                const codeA = String(a.collegeCode ?? "").toLowerCase();
                const codeB = String(b.collegeCode ?? "").toLowerCase();

                const nameA = String(a.collegeName ?? "").toLowerCase();
                const nameB = String(b.collegeName ?? "").toLowerCase();

                const emailA = hasCollegeEmail(a);
                const emailB = hasCollegeEmail(b);

                switch (sortValue) {

                    case "code-asc":
                        return codeA.localeCompare(codeB, undefined, {
                            numeric: true
                        });

                    case "code-desc":
                        return codeB.localeCompare(codeA, undefined, {
                            numeric: true
                        });

                    case "name-asc":
                        return nameA.localeCompare(nameB);

                    case "name-desc":
                        return nameB.localeCompare(nameA);

                    case "email-first":
                        return Number(emailB) - Number(emailA);

                    case "email-last":
                        return Number(emailA) - Number(emailB);

                    default:
                        return 0;
                }
            });
        }
        // ===============================
        // FACULTY CHANGED
        // ===============================

        facultyDropdown.addEventListener("change", function() {
            const facultyCode = this.value;

            collegeTableBody.innerHTML = "";

            collegeTableCard.classList.add("d-none");
            noCollegeMessage.classList.add("d-none");

            collegeSearch.value = "";

            
            if (!facultyCode) {
                return;
            }

            collegeTableCard.classList.remove("d-none");

            collegeTableBody.innerHTML = `
                        <tr>
                            <td colspan = "5" class="text-center py-5">
                                <div class="spinner-border text-primary">
                                </div>

                                <div class="mt-2 text-muted">
                                    Loading colleges...
                                </div>


                            </td>
                        </tr>
                    `;

            fetch(`@Url.Action("GetColleges", "AdminCollegeManageEmail")` + `?facultyCode=` + encodeURIComponent(facultyCode))
                .then(response => {
                    if (!response.ok) {
                        throw new Error(
                            "Unable to load colleges."
                        );
                    }
                    return response.json()
                })
                .then(data => {
                    collegeTableBody.innerHTML = ``;

                    if (!data || data.length === 0) {
                        collegeTableCard.classList.add("d-none");
                        noCollegeMessage.classList.remove("d-none");
                        return;
                    }

                    allColleges = data;
                    currentPage = 1;
                    collegeSearch.value = "";

                    emailStatusFilter.value = "all";

                    collegeSort.value = "code-asc";

                    renderCollegeTable();
                    updateEmailCounts();
                })
                .catch(error => {
                    console.error("error Message ", error);

                    collegeTableBody.innerHTML = `
                            <tr>
                                <td colspan = "5" class="text-center text-danger py-5">
                                    <i class="bi bi-exclamation-triangle fs-3"></i>

                                    <div class="mt-2">
                                        Unable to load colleges.
                                    </div>
                                </td>
                            </tr>
                        `;
                });
        });

        // ================================
        // COLLEGE ROW CREATION
        // ================================

        function createCollegeRow(college, index) {
            const row = document.createElement("tr");

            const hasEmail =
                college.collegeEmail &&
                college.collegeEmail.trim() !== "";

            row.dataset.collegeCode = college.collegeCode;

            if (hasEmail) {
                row.classList.add("college-has-email");
            }

            row.innerHTML = `
                        <td class="ps-4">
                            ${index + 1}
                        </td>

                        <td>
                            <span class="fw-semibold">
                                ${escapeHtml(college.collegeCode)}
                            </span>
                        </td>

                        <td>
                            ${escapeHtml(college.collegeName ?? "-")}
                        </td>

                        <td class="email-cell" title="Click to edit email">
                            <div class="email-wrapper">
                                <input type="email"
                                       class="form-control form-control-sm email-input"
                                       value="${escapeHtml(college.collegeEmail ?? "")}"
                                       placeholder="Email not available"
                                       readonly
                                />
                            </div>
                        </td>

                        <td>
                            <div class="password-wrapper">
                                <div class="input-group input-group-sm">

                                    <input type="password"
                                           class="form-control password-input"
                                           value="${escapeHtml(college.collegePassword ?? "")}"
                                           readonly />

                                    <button type="button"
                                            class="btn btn-outline-secondary password-toggle-btn"
                                            title="Show password">
                                        <i class="bi bi-eye"></i>
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-secondary password-copy-btn"
                                            title="Copy password">
                                        <i class="bi bi-clipboard"></i>
                                    </button>

                                </div>
                            </div>
                        </td>

                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-primary update-email-btn">
                                <i class="bi bi-save me-1" ></i>
                                Update
                            </button>
                        </td>
                    `;

            const emailCell = row.querySelector(".email-cell");

            const emailInput = row.querySelector(".email-input");


            const updateButton = row.querySelector(".update-email-btn");

            const passwordInput = row.querySelector(".password-input");
            const passwordToggleButton = row.querySelector(".password-toggle-btn");
            const passwordCopyButton = row.querySelector(".password-copy-btn");


            // ======================================
            // SHOW / HIDE PASSWORD
            // ======================================

            passwordToggleButton.addEventListener("click", function (e) {

                e.stopPropagation();

                if (passwordInput.type === "password") {

                    passwordInput.type = "text";

                    passwordToggleButton.innerHTML = ` <i class="bi bi-eye-slash"></i>`;

                    passwordToggleButton.title = "Hide password";

                } else {

                    passwordInput.type = "password";

                    passwordToggleButton.innerHTML = `<i class="bi bi-eye"></i>`;

                    passwordToggleButton.title = "Show password";
                }
            });


            // ======================================
            // COPY PASSWORD
            // ======================================

            passwordCopyButton.addEventListener("click", async function (e) {

                e.stopPropagation();

                const password = passwordInput.value;

                if (!password) {

                    showEmailAlert(
                        "warning",
                        "Password is not available."
                    );

                    return;
                }

                try {

                    await navigator.clipboard.writeText(password);

                    passwordCopyButton.innerHTML = `
                        <i class="bi bi-check-lg"></i>
                    `;

                    passwordCopyButton.title = "Copied";

                    showEmailAlert(
                        "success",
                        "Password copied to clipboard."
                    );

                    setTimeout(() => {

                        passwordCopyButton.innerHTML = `
                            <i class="bi bi-clipboard"></i>
                        `;

                        passwordCopyButton.title = "Copy password";

                    }, 1500);

                } catch (error) {

                    console.error("Copy password failed:", error);

                    showEmailAlert(
                        "error",
                        "Unable to copy password."
                    );
                }
            });

            // ======================================
            // CLICK EMAIL CELL
            // ======================================

            emailCell.addEventListener("click", function() {
                enableEmailEditing(emailInput);
            });

            // =====================================
            // UDPATE BUTTON
            // =====================================

            updateButton.addEventListener("click", function() {
                updateCollegeEmail(college, row, emailInput, updateButton);
            });

            collegeTableBody.appendChild(row);
        }

        // ==========================================
        // EMAIL STATUS FILTER
        // ==========================================

        emailStatusFilter.addEventListener("change", function () {

            currentPage = 1;

            renderCollegeTable();

        });


        // ==========================================
        // SORT
        // ==========================================

        collegeSort.addEventListener("change", function () {

            currentPage = 1;

            renderCollegeTable();

        });
        function renderCollegeTable() {

            collegeTableBody.innerHTML = "";

            const searchText =
                collegeSearch.value.toLowerCase().trim();

            const status =
                emailStatusFilter.value;


            // ==========================================
            // SEARCH + STATUS FILTER
            // ==========================================

            let filteredColleges = allColleges.filter(college => {

                const collegeCode =
                    (college.collegeCode ?? "").toLowerCase();

                const collegeName =
                    (college.collegeName ?? "").toLowerCase();

                const collegeEmail =
                    (college.collegeEmail ?? "").toLowerCase();


                const matchesSearch =
                    collegeCode.includes(searchText) ||
                    collegeName.includes(searchText) ||
                    collegeEmail.includes(searchText);


                const hasEmail =
                    hasCollegeEmail(college);


                let matchesStatus = true;


                if (status === "available") {
                    matchesStatus = hasEmail;
                }

                else if (status === "missing") {
                    matchesStatus = !hasEmail;
                }


                return matchesSearch && matchesStatus;

            });


            // ==========================================
            // SORT
            // ==========================================

            filteredColleges =
                sortColleges(filteredColleges);


            // ==========================================
            // NO RESULTS
            // ==========================================

            if (filteredColleges.length === 0) {

                collegeTableBody.innerHTML = `
                    <tr>
                        <td colspan="6"
                            class="text-center text-muted py-5">

                            <i class="bi bi-search fs-3"></i>

                            <div class="mt-2">
                                No colleges found.
                            </div>

                        </td>
                    </tr>
                `;

                collegePagination.innerHTML = "";

                paginationInfo.textContent =
                    "Showing 0 of 0 colleges";

                return;
            }


            // ==========================================
            // PAGINATION
            // ==========================================

            const totalRecords =
                filteredColleges.length;

            const totalPages =
                Math.ceil(totalRecords / pageSize);


            if (currentPage > totalPages) {
                currentPage = totalPages;
            }


            const startIndex =
                (currentPage - 1) * pageSize;

            const endIndex =
                Math.min(
                    startIndex + pageSize,
                    totalRecords
                );


            const pageColleges =
                filteredColleges.slice(
                    startIndex,
                    endIndex
                );


            // ==========================================
            // CREATE ROWS
            // ==========================================

            pageColleges.forEach((college, index) => {

                createCollegeRow(
                    college,
                    startIndex + index
                );

            });


            // ==========================================
            // PAGINATION
            // ==========================================

            renderPagination(
                totalPages,
                totalRecords,
                startIndex,
                endIndex
            );
        }

        function renderPagination(totalPages, totalRecords, startIndex, endIndex) {
            collegePagination.innerHTML = "";

            // INFORMATION

            paginationInfo.textContent = `Showing ${startIndex + 1}-${endIndex} of ${totalRecords} colleges`;

            // PREVIOUS

            const previousLi = document.createElement("li");

            previousLi.className = `page-item ${currentPage === 1 ? "disabled" : ""}`;
            previousLi.innerHTML = `
                        <button class="page-link" type="button">
                            <i class = "bi bi-chevron-left"></i>
                        </button>
                    `;

            previousLi.querySelector("button").addEventListener("click", function() {
                if (currentPage > 1) {
                    currentPage--;
                    renderCollegeTable();
                }
            });

            collegePagination.appendChild(previousLi);

            // pageSize NUMBERS

            const pages = getPaginatedPages(currentPage, totalPages);

            pages.forEach(page => {
                if (page === "...") {
                    const li = document.createElement("li");

                    li.className = "page-item disabled";

                    li.innerHTML = `
                                <span class="page-link">
                                    ...
                                </span>
                            `;

                    collegePagination.appendChild(li);

                    return;
                }

                const li = document.createElement("li");

                li.className = `page-item ${page === currentPage ? "active" : ""}`;

                li.innerHTML = `
                            <button class="page-link" type="button">
                                ${page}
                            </button>
                        `;
                li.querySelector("button").addEventListener("click", function() {
                    currentPage = page;
                    renderCollegeTable();
                });

                collegePagination.appendChild(li);
            });

            // NEXT

            const nextLi = document.createElement("li");

            nextLi.classList = `page-item ${currentPage === totalPages ? "disabled" : ""}`;

            nextLi.innerHTML = `
                        <button class="page-link" type="button">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    `;

            nextLi.querySelector("button").addEventListener("click", function() {
                if (currentPage < totalPages) {
                    currentPage++;
                    renderCollegeTable();
                }
            });

            collegePagination.appendChild(nextLi);
        }

        function getPaginatedPages(current, total) {
            const pages = [];

            // FEW PAGES

            if (total <= 7) {
                for (let i = 1; i <= total; i++) {
                    pages.push(i);
                }
                return pages;
            }

            // FIRST PAGES

            if (current <= 4) {
                pages.push(1);
                pages.push(2);
                pages.push(3);
                pages.push(4);
                pages.push(5);
                pages.push("...");
                pages.push(total);

                return pages;
            }

            // LAST PAGES

            if (current >= total - 3) {
                pages.push(1);
                pages.push("...");
                pages.push(total - 4);
                pages.push(total - 3);
                pages.push(total - 2);
                pages.push(total - 1);
                pages.push(total);
                return pages;
            }

            // MIDDLE PAGES

            pages.push(1);
            pages.push("...");
            pages.push(current - 1);
            pages.push(current);
            pages.push(current + 1);
            pages.push("...");
            pages.push(total);
            return pages;
        }


        // ==========================================
        // ENABLE EMAIL EDITING
        // ==========================================

        function enableEmailEditing(input) {
            if (!input.readOnly) {
                return;
            }

            input.readOnly = false;

            input.classList.add("email-editing");

            input.focus();

            input.select();
        }

        // ==========================================
        // CLICK OUTSIDE EMAIL
        // ==========================================

        document.addEventListener("click", function(e) {
            const emailInputs = document.querySelectorAll(".email-input");

            emailInputs.forEach(
                input => {
                    const emailCell = input.closest(".email-cell");

                    if (!emailCell.contains(e.target)) {
                        if (!input.value.trim()) input.value = "";

                        input.readOnly = true;

                        input.classList.remove('email-editing');
                    }
                }
            )

        });

        // ==============================
        // UPDATE EMAIL
        // ==============================

        function updateCollegeEmail(college, row, emailInput, updateButton) {

            const email = emailInput.value.trim();

            // =============================
            // VALIDATION
            // =============================

            if (!email) {
                showEmailAlert("warning", "Email address is required.");

                enableEmailEditing(emailInput);

                return;
            }

            if (!emailInput.checkValidity()) {
                showEmailAlert("warning", "Please enter a valid email address.");
                enableEmailEditing(emailInput);
                return;
            }
            // ==========================
            // BUTTON LOADING
            // ==========================

            updateButton.disabled = true;
            updateButton.innerHTML = `
                        <span class="spinner-border spinner-border-sm me-1">
                        </span>

                        Saving...
                    `;

            // ANTI FORGERY TOKEN

            const token = document.querySelector(`#antiForgeryForm input[name="__RequestVerificationToken"]`).value;

            const formData = new URLSearchParams();

            formData.append("collegeCode", college.collegeCode);

            formData.append("email", email);

            formData.append("__RequestVerificationToken", token);

            fetch(`@Url.Action("UpdateEmail", "AdminCollegeManageEmail")`,
                {
                    method: "post",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },

                    body: formData
                }
            )
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Unable to update email.");
                    }

                    return response.json();
                })
                .then(result => {
                    if (!result.success) {
                        throw new Error(result.noCollegeMessage);
                    }

                    // UPDATE LOCAL DATA

                    college.collegeEmail = email;

                    updateEmailCounts();

                    emailInput.readOnly = true;

                    emailInput.classList.remove("email-editing");

                    showEmailAlert("success", result.noCollegeMessage || "College email updated successfully.");
                    renderCollegeTable();
                })
                .catch(error => {
                    console.error(error);

                    showEmailAlert("error", error.message || "Unable to update email.");
                })
                .finally(() => {
                    updateButton.disabled = false;

                    updateButton.innerHTML = `
                            <i class="bi bi-save me-1"></i>
                            Update
                        `;
                });

        }
        // ==========================================
        // SWEETALERT MESSAGES
        // ==========================================

        function showEmailAlert(icon, message) {
            Swal.fire({
                icon: icon,
                text: message,
                toast: true,
                position: "top-end",
                showConfirmButton: false,
                timer: icon === "success" ? 2500 : 3500,
                timerProgressBar: true
            });
        }

        // SEARCH

        collegeSearch.addEventListener("input", function() {
            currentPage = 1;
            renderCollegeTable();
        });

        // HTML ENCODE

        function escapeHtml(value) {
            if (value == null) return "";

            return String(value)
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

            const importCollegeBtn =
                document.getElementById("importCollegeBtn");

            const collegeMasterFile =
                document.getElementById("collegeMasterFile");


            importCollegeBtn.addEventListener("click", async function () {

                const file = collegeMasterFile.files[0];

                if (!file) {

                    showEmailAlert(
                        "warning",
                        "Please select an Excel file."
                    );

                    return;
                }

                const formData =
                    new FormData();

                formData.append("file", file);

                const token =
                    document.querySelector(
                        '#collegeImportForm input[name="__RequestVerificationToken"]'
                    ).value;

                formData.append(
                    "__RequestVerificationToken",
                    token
                );

                importCollegeBtn.disabled = true;

                importCollegeBtn.innerHTML = `
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    Importing...
                `;

                try {

                    const response =
                        await fetch(
                            '@Url.Action("ImportCollegeMaster", "AdminCollegeManageEmail")',
                            {
                                method: "POST",
                                body: formData
                            }
                        );

                    const result =
                        await response.json();

                    if (!result.success) {

                        throw new Error(
                            result.message ||
                            "Unable to import college data."
                        );
                    }

                    showEmailAlert(
                        "success",
                        `${result.message} Inserted: ${result.inserted}, Updated: ${result.updated}, Skipped: ${result.skipped}`
                    );

                    collegeMasterFile.value = "";

                    // Reload current faculty data if selected
                    if (facultyDropdown.value) {
                        facultyDropdown.dispatchEvent(
                            new Event("change")
                        );
                    }

                }
                catch (error) {

                    console.error(
                        "College import error:",
                        error
                    );

                    showEmailAlert(
                        "error",
                        error.message ||
                        "Unable to import college data."
                    );

                }
                finally {

                    importCollegeBtn.disabled = false;

                    importCollegeBtn.innerHTML = `
                        <i class="bi bi-upload me-1"></i>
                        Import College Data
                    `;
                }

            });
    </script>
        }