@model AffiliationPgCourseViewModel
@{
    ViewData["Title"] = "PG Course Affiliation";
    Layout = "~/Views/Shared/_CaLayout.cshtml";

    var facultyCode = Context.Session.GetString("FacultyCode") ?? "";
    var isMedical = facultyCode == "1";
    var isDental = facultyCode == "2";
    var facultyLabel = isDental ? "Dental" : "Medical";

    var degreeCount = Model.PgDegreeCourses.Count();
    var diplomaCount = Model.PgDiplomaCourses.Count();

    // Only one save message is ever set per redirect; reading it here marks it as consumed
    var flashMessage = new[]
    {
        TempData["pgparticulars"], TempData["GokSavemsg"], TempData["Rguhs"], TempData["others"], TempData["Lic"]
    }
    .Select(x => x?.ToString())
    .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<link rel="stylesheet" href="~/css/common-form.css" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700;800&display=swap');

    /* Everything is scoped to .pgc so nothing leaks into the layout or sidebar */
    .pgc {
        --navy: #0b2a5b;
        --blue: #1456c4;
        --blue-deep: #0f45a0;
        --blue-soft: #e9f0fc;
        --red: #c8312b;
        --ink: #17233a;
        --muted: #5a6a84;
        --rule: #cfd8e6;
        --ground: #f2f5fa;
        --paper: #ffffff;
        --ok: #1c7a4a;
        font-family: 'Libre Franklin', 'Segoe UI', system-ui, sans-serif;
        color: var(--ink);
        background: var(--ground);
        min-height: 100vh;
        line-height: 1.5;
    }

        .pgc *, .pgc *::before, .pgc *::after {
            box-sizing: border-box;
        }

        .pgc h1, .pgc h2, .pgc p, .pgc dl, .pgc dd, .pgc dt {
            margin: 0;
        }

    /* ── Page body ──────────────────────────────────────────── */
    .pgc-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 24px 28px 64px;
    }

    .pgc-alert {
        margin-top: 24px;
        padding: 12px 16px;
        background: #fdecea;
        border-left: 4px solid var(--red);
        color: #7d1d19;
        font-size: .92rem;
    }

        .pgc-alert.validation-summary-valid {
            display: none;
        }

        .pgc-alert ul {
            margin: 0;
            padding-left: 18px;
        }

    .pgc-pair {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 28px;
        margin-bottom: 28px;
    }

        .pgc-pair .pgc-sheet {
            margin-bottom: 0;
            min-width: 0;
        }

    /* Overview lists: compact cards with their own scroll bar */
    .pgc-pair {
        align-items: start;
    }

        .pgc-pair .pgc-sheet-head {
            padding: 14px 20px 12px;
        }

            .pgc-pair .pgc-sheet-head h2 {
                font-size: 1.05rem;
            }

        .pgc-pair .pgc-table-wrap {
            max-height: 300px;
            overflow-y: auto;
        }

        .pgc-pair .pgc-table {
            font-size: .88rem;
        }

            .pgc-pair .pgc-table th {
                padding: 8px 20px;
            }

            .pgc-pair .pgc-table td {
                padding: 7px 20px;
            }

    /* ── Form sheets ────────────────────────────────────────── */
    .pgc-sheet {
        background: var(--paper);
        border: 1px solid var(--rule);
        border-top: 3px solid var(--navy);
        margin-bottom: 28px;
    }

    .pgc-sheet-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        padding: 20px 24px 16px;
        border-bottom: 1px solid var(--rule);
    }

        .pgc-sheet-head h2 {
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: -.01em;
            color: var(--navy);
        }

        .pgc-sheet-head p {
            margin-top: 4px;
            max-width: 68ch;
            font-size: .92rem;
            color: var(--muted);
        }

    .pgc-count {
        font-size: .9rem;
        font-weight: 600;
        color: var(--muted);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .pgc-table-wrap {
        max-height: 420px;
        overflow: auto;
    }

        .pgc-table-wrap::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .pgc-table-wrap::-webkit-scrollbar-thumb {
            background: #b9c5d9;
            border-radius: 4px;
        }

    .pgc-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .94rem;
    }

        .pgc-table th {
            position: sticky;
            top: 0;
            z-index: 2;
            background: var(--blue-soft);
            color: var(--navy);
            text-align: left;
            font-weight: 600;
            font-size: .85rem;
            padding: 11px 24px;
            border-bottom: 1px solid var(--rule);
            white-space: nowrap;
        }

        .pgc-table td {
            padding: 12px 24px;
            border-bottom: 1px solid #e4eaf3;
            vertical-align: middle;
        }

        .pgc-table tbody tr:hover {
            background: #f7f9fd;
        }

        .pgc-table .num {
            text-align: right;
            font-variant-numeric: tabular-nums;
            font-weight: 600;
        }

        .pgc-table th.num {
            text-align: right;
        }

        .pgc-table .center {
            text-align: center;
        }

    .pgc-table--form {
        min-width: 780px;
    }

    .pgc-course {
        font-weight: 500;
    }

    .pgc-empty td {
        padding: 40px 24px;
        text-align: center;
        color: var(--muted);
    }

    .pgc-sheet-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 14px 24px;
        border-top: 1px solid var(--rule);
        background: #fafbfd;
    }

    .pgc-hint {
        font-size: .86rem;
        color: var(--muted);
    }

    /* ── Controls ───────────────────────────────────────────── */
    .pgc-input {
        width: 100%;
        min-width: 140px;
        font: inherit;
        font-size: .92rem;
        color: var(--ink);
        background: #fff;
        border: 1px solid #b9c5d9;
        border-radius: 4px;
        padding: 8px 10px;
    }

        .pgc-input:focus {
            outline: 3px solid rgba(20,86,196,.25);
            border-color: var(--blue);
        }

    .pgc-input--num {
        max-width: 130px;
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .pgc-search {
        max-width: 260px;
    }

    .pgc-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font: inherit;
        font-size: .9rem;
        font-weight: 600;
        line-height: 1.2;
        padding: 9px 16px;
        border-radius: 4px;
        border: 1px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition: background .15s, border-color .15s;
    }

    .pgc .pgc-btn-primary, .pgc a.pgc-btn-primary {
        background: var(--blue);
        color: #fff;
    }

        .pgc .pgc-btn-primary:hover, .pgc a.pgc-btn-primary:hover {
            background: var(--blue-deep);
            color: #fff;
        }

    .pgc .pgc-btn-quiet {
        background: #fff;
        color: var(--navy);
        border-color: #9fb0cc;
    }

        .pgc .pgc-btn-quiet:hover {
            background: var(--blue-soft);
            border-color: var(--blue);
        }

    .pgc .pgc-btn-ghost, .pgc a.pgc-btn-ghost {
        background: #fff;
        color: var(--navy);
        border-color: var(--rule);
    }

        .pgc .pgc-btn-ghost:hover, .pgc a.pgc-btn-ghost:hover {
            border-color: var(--navy);
            color: var(--navy);
        }

    .pgc .pgc-btn:focus-visible, .pgc .pgc-file:focus-visible + .pgc-btn, .pgc .pgc-link:focus-visible {
        outline: 3px solid rgba(20,86,196,.35);
        outline-offset: 2px;
    }

    /* Document upload: native input stays focusable but visually hidden */
    .pgc-upload {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px 12px;
    }

    .pgc-file {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        overflow: hidden;
    }

    .pgc-filename {
        max-width: 240px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: .86rem;
        color: var(--navy);
    }

    .pgc-clear {
        border: 0;
        background: transparent;
        color: var(--red);
        font-size: 1.1rem;
        line-height: 1;
        cursor: pointer;
        padding: 2px 6px;
    }

        .pgc-clear[hidden] {
            display: none;
        }

    .pgc-onfile {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: .86rem;
        font-weight: 600;
        color: var(--ok);
    }

    .pgc .pgc-link {
        font-size: .88rem;
        font-weight: 600;
        color: var(--blue);
        text-decoration: underline;
        text-underline-offset: 3px;
    }

        .pgc .pgc-link:hover {
            color: var(--blue-deep);
        }

    .pgc-switch {
        -webkit-appearance: none;
        appearance: none;
        position: relative;
        display: inline-block;
        vertical-align: middle;
        width: 44px;
        height: 24px;
        margin: 0;
        border: 0;
        border-radius: 12px;
        background: #b9c5d9;
        cursor: pointer;
        transition: background .15s;
    }

        .pgc-switch::after {
            content: "";
            position: absolute;
            top: 3px;
            left: 3px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #fff;
            transition: transform .15s;
        }

        .pgc-switch:checked {
            background: var(--ok);
        }

            .pgc-switch:checked::after {
                transform: translateX(20px);
            }

        .pgc-switch:focus-visible {
            outline: 3px solid rgba(20,86,196,.35);
            outline-offset: 2px;
        }

    .pgc-toolbar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px 12px;
        padding: 14px 24px;
        border-bottom: 1px solid var(--rule);
        background: #fafbfd;
    }

    .pgc-toolbar-label {
        font-size: .9rem;
        font-weight: 600;
        color: var(--navy);
    }

    .pgc-picker {
        width: auto;
        min-width: 280px;
        max-width: 100%;
        flex: 1 1 280px;
    }

    .pgc-rowx {
        border: 1px solid var(--rule);
        background: #fff;
        color: var(--red);
        width: 32px;
        height: 32px;
        border-radius: 4px;
        cursor: pointer;
    }

        .pgc-rowx:hover {
            background: #fdecea;
            border-color: var(--red);
        }

        .pgc-rowx:focus-visible {
            outline: 3px solid rgba(20,86,196,.35);
            outline-offset: 2px;
        }

    .pgc-table tr[hidden], .pgc-table tr.pgc-empty[hidden] {
        display: none;
    }

    .pgc-sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
    }

    .pgc-pager {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding-top: 8px;
    }

    /* ── Responsive ─────────────────────────────────────────── */
    @@media (max-width: 991px) {
        .pgc-pair {
            grid-template-columns: 1fr;
        }

        .pgc-wrap {
            padding: 0 16px 48px;
        }
    }

    @@media (max-width: 640px) {
        .pgc-sheet-head, .pgc-sheet-foot, .pgc-pager {
            flex-direction: column;
            align-items: stretch;
        }

        .pgc-search {
            max-width: none;
        }

        .pgc-btn {
            justify-content: center;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .pgc *, .pgc *::before, .pgc *::after {
            transition: none !important;
        }
    }
</style>

<div class="pgc">

    <div class="pgc-wrap">

        <div asp-validation-summary="ModelOnly" class="pgc-alert"></div>

        <!-- Courses and intake overview -->
        <div class="pgc-pair">
            <section class="pgc-sheet" aria-labelledby="h-degree">
                <div class="pgc-sheet-head">
                    <h2 id="h-degree">PG degree courses</h2>
                    <span class="pgc-count">@degreeCount @(degreeCount == 1 ? "course" : "courses")</span>
                </div>
                <div class="pgc-table-wrap">
                    <table class="pgc-table">
                        <thead>
                            <tr>
                                <th scope="col">Course</th>
                                <th scope="col" class="num">Intake</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (degreeCount > 0)
                            {
                                foreach (var course in Model.PgDegreeCourses)
                                {
                                    <tr>
                                        <td><span class="pgc-course">@course.CourseName</span></td>
                                        <td class="num">@course.CollegeIntake</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="pgc-empty"><td colspan="2">No PG degree courses are listed for this college.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="pgc-sheet" aria-labelledby="h-diploma">
                <div class="pgc-sheet-head">
                    <h2 id="h-diploma">PG diploma courses</h2>
                    <span class="pgc-count">@diplomaCount @(diplomaCount == 1 ? "course" : "courses")</span>
                </div>
                <div class="pgc-table-wrap">
                    <table class="pgc-table">
                        <thead>
                            <tr>
                                <th scope="col">Course</th>
                                <th scope="col" class="num">Intake</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (diplomaCount > 0)
                            {
                                foreach (var course in Model.PgDiplomaCourses)
                                {
                                    <tr>
                                        <td><span class="pgc-course">@course.CourseName</span></td>
                                        <td class="num">@course.CollegeIntake</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="pgc-empty"><td colspan="2">No PG diploma courses are listed for this college.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <!-- Course particulars and recognition -->
        <section class="pgc-sheet" aria-labelledby="h-particulars">
            <form asp-action="SavePgCourseParticulars" method="post">
                <input type="hidden" name="CollegeCode" value="@Model.CollegeCode" />

                <div class="pgc-sheet-head">
                    <div>
                        <h2 id="h-particulars">Course particulars and recognition</h2>
                        <p>Enter the letter of permission (LOP) date and the @(isDental ? "DCI" : "NMC") recognition date for each course. Courses with no dates entered are skipped.</p>
                    </div>
                </div>

                <div class="pgc-table-wrap">
                    <table class="pgc-table pgc-table--form">
                        <thead>
                            <tr>
                                <th scope="col">Course</th>
                                <th scope="col">Date of LOP</th>
                                @if (isMedical)
                                {
                                    <th scope="col">Date of NMC recognition</th>
                                }
                                @if (isDental)
                                {
                                    <th scope="col">Date of DCI recognition</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var index = 0;
                            }
                            @foreach (var course in Model.AllCourses)
                            {
                                <tr>
                                    <td>
                                        <span class="pgc-course">@course.CourseName</span>
                                        <input type="hidden" name="Courses[@index].CourseCode" value="@course.CourseCode" />
                                        <input type="hidden" name="Courses[@index].CourseName" value="@course.CourseName" />
                                        <input type="hidden" name="Courses[@index].CourseLevel" value="@course.CourseLevel" />
                                        <input type="hidden" name="Courses[@index].CoursePrefix" value="@course.CoursePrefix" />
                                        <input type="hidden" name="Courses[@index].CollegeCode" value="@Model.CollegeCode" />
                                        <input type="hidden" name="Courses[@index].CollegeIntake" value="@course.CollegeIntake" />
                                        <input type="hidden" name="Courses[@index].RguhsIntake" value="@course.RguhsIntake" />
                                    </td>
                                    <td>
                                        <input type="date" class="pgc-input" name="Courses[@index].DateofLOP"
                                               aria-label="Date of LOP, @course.CourseName"
                                               value="@(course.DateofLOP?.ToString("yyyy-MM-dd") ?? "")" />
                                    </td>
                                    @if (isMedical)
                                    {
                                        <td>
                                            <input type="date" class="pgc-input" name="Courses[@index].DateofRecognitionByNMC"
                                                   aria-label="Date of NMC recognition, @course.CourseName"
                                                   value="@(course.DateofRecognitionByNMC?.ToString("yyyy-MM-dd") ?? "")" />
                                        </td>
                                    }
                                    @if (isDental)
                                    {
                                        <td>
                                            <input type="date" class="pgc-input" name="Courses[@index].DateofRecognitionByDCI"
                                                   aria-label="Date of DCI recognition, @course.CourseName"
                                                   value="@(course.DateofRecognitionByDCI?.ToString("yyyy-MM-dd") ?? "")" />
                                        </td>
                                    }
                                </tr>
                                index++;
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pgc-sheet-foot">
                    <p class="pgc-hint">Dates you saved earlier appear here again.</p>
                    <button type="submit" class="pgc-btn pgc-btn-primary">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i> Save particulars
                    </button>
                </div>
            </form>
        </section>

        <!-- GOK details -->
        <section class="pgc-sheet" aria-labelledby="h-gok">
            <form asp-action="SavePgCoursesForGOK" method="post" enctype="multipart/form-data">
                <input type="hidden" name="CollegeCode" value="@Model.CollegeCode" />

                <div class="pgc-sheet-head">
                    <div>
                        <h2 id="h-gok">Government order (GOK) details</h2>
                        <p>For each course, enter the date of the Government of Karnataka order and its academic year, then attach the order. A course is saved only when its academic year is filled in.</p>
                    </div>
                </div>

                <div class="pgc-table-wrap">
                    <table class="pgc-table pgc-table--form">
                        <thead>
                            <tr>
                                <th scope="col">Course</th>
                                <th scope="col" class="num">Sanctioned intake</th>
                                <th scope="col">Date of GOK</th>
                                <th scope="col">Academic year</th>
                                <th scope="col">GOK document</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var gokIndex = 0;
                            }
                            @if (!Model.PgCoursesGOK.Any())
                            {
                                <tr class="pgc-empty"><td colspan="5">No PG courses are listed for this college.</td></tr>
                            }
                            @foreach (var course in Model.PgCoursesGOK)
                            {
                                <tr>
                                    <td>
                                        <span class="pgc-course">@course.CourseName</span>
                                        <input type="hidden" name="PgCoursesGOK[@gokIndex].CourseCode" value="@course.CourseCode" />
                                        <input type="hidden" name="PgCoursesGOK[@gokIndex].CourseName" value="@course.CourseName" />
                                        <input type="hidden" name="PgCoursesGOK[@gokIndex].CourseLevel" value="@course.CourseLevel" />
                                        <input type="hidden" name="PgCoursesGOK[@gokIndex].CoursePrefix" value="@course.CoursePrefix" />
                                        <input type="hidden" name="PgCoursesGOK[@gokIndex].CollegeCode" value="@Model.CollegeCode" />
                                        <input type="hidden" name="PgCoursesGOK[@gokIndex].CollegeIntake" value="@course.CollegeIntake" />
                                        <input type="hidden" name="PgCoursesGOK[@gokIndex].RguhsIntake" value="@course.RguhsIntake" />
                                    </td>
                                    <td class="num">@course.RguhsIntake</td>
                                    <td>
                                        <input type="date" class="pgc-input" name="PgCoursesGOK[@gokIndex].DateofGOK"
                                               aria-label="Date of GOK, @course.CourseName"
                                               value="@(course.DateofGOK?.ToString("yyyy-MM-dd") ?? "")" />
                                    </td>
                                    <td>
                                        <input type="text" class="pgc-input" name="PgCoursesGOK[@gokIndex].AcademicYear"
                                               aria-label="Academic year, @course.CourseName"
                                               value="@course.AcademicYear" placeholder="2026-27" />
                                    </td>
                                    <td>
                                        <div class="pgc-upload">
                                            <input type="file" class="pgc-file" id="gokFile_@gokIndex"
                                                   name="PgCoursesGOK[@gokIndex].GOKDocumentFile"
                                                   accept=".pdf,application/pdf"
                                                   data-doc="GOK document" data-name-el="gokFileName_@gokIndex" data-size-el="gokFileSize_@gokIndex"
                                                   onchange="pgcDocSelected(this)" />
                                            <label for="gokFile_@gokIndex" class="pgc-btn pgc-btn-quiet">
                                                <i class="bi bi-upload" aria-hidden="true"></i> Choose PDF
                                            </label>
                                            <input type="hidden" id="gokFileSize_@gokIndex" name="PgCoursesGOK[@gokIndex].GOKDocumentSize" />
                                            <span id="gokFileName_@gokIndex" class="pgc-filename" aria-live="polite"></span>
                                            <button type="button" class="pgc-clear" hidden aria-label="Remove selected file" onclick="pgcClearDoc(this)">&times;</button>
                                            @if (course.HasGOKDocument)
                                            {
                                                <span class="pgc-onfile"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> On file</span>
                                                <a asp-action="ViewGokDocument" asp-route-courseCode="@course.CourseCode"
                                                   asp-route-collegecode="@Model.CollegeCode" target="_blank" rel="noopener" class="pgc-link">View</a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                gokIndex++;
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pgc-sheet-foot">
                    <p class="pgc-hint">PDF only, up to 1 MB per document.</p>
                    <button type="submit" class="pgc-btn pgc-btn-primary">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i> Save GOK details
                    </button>
                </div>
            </form>
        </section>

        <!-- RGUHS permission -->
        <section class="pgc-sheet" aria-labelledby="h-rguhs">
            <form asp-action="SavePgCoursesRguhs" method="post" enctype="multipart/form-data">
                <input type="hidden" name="CollegeCode" value="@Model.CollegeCode" />

                <div class="pgc-sheet-head">
                    <div>
                        <h2 id="h-rguhs">RGUHS permission</h2>
                        <p>Confirm the sanctioned intake for each course and attach the RGUHS permission order. A course is saved only when a document is attached.</p>
                    </div>
                </div>

                <div class="pgc-table-wrap">
                    <table class="pgc-table pgc-table--form">
                        <thead>
                            <tr>
                                <th scope="col">Course</th>
                                <th scope="col" class="num">Sanctioned intake</th>
                                <th scope="col">RGUHS document</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var rguhsIndex = 0;
                            }
                            @if (!Model.PgCoursesRguhs.Any())
                            {
                                <tr class="pgc-empty"><td colspan="3">No PG courses are listed for this college.</td></tr>
                            }
                            @foreach (var course in Model.PgCoursesRguhs)
                            {
                                <tr>
                                    <td>
                                        <span class="pgc-course">@course.CourseName</span>
                                        <input type="hidden" name="PgCoursesRguhs[@rguhsIndex].CourseCode" value="@course.CourseCode" />
                                        <input type="hidden" name="PgCoursesRguhs[@rguhsIndex].CourseName" value="@course.CourseName" />
                                        <input type="hidden" name="PgCoursesRguhs[@rguhsIndex].CourseLevel" value="@course.CourseLevel" />
                                        <input type="hidden" name="PgCoursesRguhs[@rguhsIndex].CoursePrefix" value="@course.CoursePrefix" />
                                    </td>
                                    <td class="num">
                                        <input type="number" class="pgc-input pgc-input--num" min="0"
                                               name="PgCoursesRguhs[@rguhsIndex].RguhsIntake" value="@course.RguhsIntake"
                                               aria-label="Sanctioned intake, @course.CourseName" />
                                    </td>
                                    <td>
                                        <div class="pgc-upload">
                                            <input type="file" class="pgc-file" id="rguhsFile_@rguhsIndex"
                                                   name="PgCoursesRguhs[@rguhsIndex].RGUHSDocumentFile"
                                                   accept=".pdf,application/pdf"
                                                   data-doc="RGUHS document" data-name-el="rguhsFileName_@rguhsIndex" data-size-el="rguhsFileSize_@rguhsIndex"
                                                   onchange="pgcDocSelected(this)" />
                                            <label for="rguhsFile_@rguhsIndex" class="pgc-btn pgc-btn-quiet">
                                                <i class="bi bi-upload" aria-hidden="true"></i> Choose PDF
                                            </label>
                                            <input type="hidden" id="rguhsFileSize_@rguhsIndex" name="PgCoursesRguhs[@rguhsIndex].RGUHSDocumentSize" />
                                            <span id="rguhsFileName_@rguhsIndex" class="pgc-filename" aria-live="polite"></span>
                                            <button type="button" class="pgc-clear" hidden aria-label="Remove selected file" onclick="pgcClearDoc(this)">&times;</button>
                                            @if (course.HasRguhsDocument)
                                            {
                                                <span class="pgc-onfile"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> On file</span>
                                                <a asp-action="ViewRguhsDocument" asp-route-courseCode="@course.CourseCode"
                                                   target="_blank" rel="noopener" class="pgc-link">View</a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                rguhsIndex++;
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pgc-sheet-foot">
                    <p class="pgc-hint">PDF only, up to 1 MB per document.</p>
                    <button type="submit" class="pgc-btn pgc-btn-primary">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i> Save RGUHS details
                    </button>
                </div>
            </form>
        </section>

        <!-- Other courses permitted by NMC (medical faculty only) -->
        @if (isMedical)
        {
            // A course is "already added" once it has any saved value; the rest are added with Add row
            var nmcCourses = Model.OtherCoursesPermittedByNMC.ToList();
            var addedCount = nmcCourses.Count(c => c.PermissionByNMC || c.HasNMCdocument || c.AdmissionsPerYear > 0);
            var availableCount = nmcCourses.Count - addedCount;

            <section class="pgc-sheet" aria-labelledby="h-nmc">
                <form asp-action="SaveOtherDeptCourses" method="post" enctype="multipart/form-data">

                    <div class="pgc-sheet-head">
                        <div>
                            <h2 id="h-nmc">Other courses permitted by NMC</h2>
                            <p>Pick a course and select Add row, then switch on the permission, enter the admissions per year, and attach the NMC order. A new course is saved only when a document is attached.</p>
                        </div>
                        <span class="pgc-count" id="nmcCount">@addedCount @(addedCount == 1 ? "course" : "courses") added</span>
                    </div>

                    <div class="pgc-toolbar">
                        <label for="nmcPicker" class="pgc-toolbar-label">Course</label>
                        <select id="nmcPicker" class="pgc-input pgc-picker" aria-label="Course to add">
                            <option value="">Select a course</option>
                            @{
                                var optIndex = 0;
                            }
                            @foreach (var course in nmcCourses)
                            {
                                var added = course.PermissionByNMC || course.HasNMCdocument || course.AdmissionsPerYear > 0;
                                if (!added)
                                {
                                    <option value="@optIndex">@course.CourseName</option>
                                }
                                optIndex++;
                            }
                        </select>
                        <button type="button" id="nmcAdd" class="pgc-btn pgc-btn-quiet">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add row
                        </button>
                    </div>

                    <div class="pgc-table-wrap">
                        <table class="pgc-table pgc-table--form">
                            <thead>
                                <tr>
                                    <th scope="col">Course</th>
                                    <th scope="col" class="center">NMC permission</th>
                                    <th scope="col" class="num">Admissions per year</th>
                                    <th scope="col">NMC document</th>
                                    <th scope="col"><span class="pgc-sr">Remove</span></th>
                                </tr>
                            </thead>
                            <tbody id="nmcBody">
                                @{
                                    var nmcIndex = 0;
                                }
                                @foreach (var course in nmcCourses)
                                {
                                    var added = course.PermissionByNMC || course.HasNMCdocument || course.AdmissionsPerYear > 0;
                                    <tr data-nmc-row data-index="@nmcIndex" data-saved="@(added ? "1" : "0")" hidden="@(!added)">
                                        <td>
                                            <span class="pgc-course">@course.CourseName</span>
                                            <input type="hidden" name="OtherCoursesPermittedByNMC[@nmcIndex].CourseCode" value="@course.CourseCode" />
                                            <input type="hidden" name="OtherCoursesPermittedByNMC[@nmcIndex].CourseName" value="@course.CourseName" />
                                            <input type="hidden" name="OtherCoursesPermittedByNMC[@nmcIndex].CourseLevel" value="@course.CourseLevel" />
                                            <input type="hidden" name="OtherCoursesPermittedByNMC[@nmcIndex].CoursePrefix" value="@course.CoursePrefix" />
                                            <input type="hidden" name="OtherCoursesPermittedByNMC[@nmcIndex].CollegeCode" value="@Model.CollegeCode" />
                                            <input type="hidden" name="OtherCoursesPermittedByNMC[@nmcIndex].FacultyCode" value="@course.FacultyCode" />
                                        </td>
                                        <td class="center">
                                            <input type="checkbox" class="pgc-switch" value="true"
                                                   name="OtherCoursesPermittedByNMC[@nmcIndex].PermissionByNMC"
                                                   aria-label="NMC permission, @course.CourseName"
                                                   checked="@course.PermissionByNMC" />
                                        </td>
                                        <td class="num">
                                            <input type="number" class="pgc-input pgc-input--num" min="0"
                                                   name="OtherCoursesPermittedByNMC[@nmcIndex].AdmissionsPerYear" value="@course.AdmissionsPerYear"
                                                   aria-label="Admissions per year, @course.CourseName" />
                                        </td>
                                        <td>
                                            <div class="pgc-upload">
                                                <input type="file" class="pgc-file" id="nmcFile_@nmcIndex"
                                                       name="OtherCoursesPermittedByNMC[@nmcIndex].NMCdocumentFile"
                                                       accept=".pdf,application/pdf"
                                                       data-doc="NMC document" data-name-el="nmcFileName_@nmcIndex" data-size-el="nmcFileSize_@nmcIndex"
                                                       onchange="pgcDocSelected(this)" />
                                                <label for="nmcFile_@nmcIndex" class="pgc-btn pgc-btn-quiet">
                                                    <i class="bi bi-upload" aria-hidden="true"></i> Choose PDF
                                                </label>
                                                <input type="hidden" id="nmcFileSize_@nmcIndex" name="OtherCoursesPermittedByNMC[@nmcIndex].NMCdocumentSize" />
                                                <span id="nmcFileName_@nmcIndex" class="pgc-filename" aria-live="polite"></span>
                                                <button type="button" class="pgc-clear" hidden aria-label="Remove selected file" onclick="pgcClearDoc(this)">&times;</button>
                                                @if (course.HasNMCdocument)
                                                {
                                                    <span class="pgc-onfile"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> On file</span>
                                                    <a asp-action="ViewNMCDocument" asp-route-courseCode="@course.CourseCode"
                                                       target="_blank" rel="noopener" class="pgc-link">View</a>
                                                }
                                            </div>
                                        </td>
                                        <td class="center">
                                            @if (!added)
                                            {
                                                <button type="button" class="pgc-rowx" data-nmc-remove aria-label="Remove row, @course.CourseName" title="Remove row">
                                                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                    nmcIndex++;
                                }
                                <tr class="pgc-empty" id="nmcEmpty" hidden="@(addedCount > 0)">
                                    <td colspan="5">@(availableCount > 0 ? "No courses added yet. Pick a course above and select Add row." : "No other PG courses are available to add.")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="pgc-sheet-foot">
                        <p class="pgc-hint">PDF only, up to 1 MB per document.</p>
                        <button type="submit" class="pgc-btn pgc-btn-primary">
                            <i class="bi bi-check2-circle" aria-hidden="true"></i> Save NMC details
                        </button>
                    </div>
                </form>
            </section>
        }

        <!-- Page navigation -->
        @if (isMedical)
        {
            <nav class="pgc-pager" aria-label="Form navigation">
                <a asp-action="Aff_PrincipalDetails" asp-controller="ContinuesAffiliation_Facultybased" class="pgc-btn pgc-btn-ghost">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i> Previous: Principal details
                </a>
                <a asp-action="IncreaseIntake" asp-controller="ContinuousAffiliationIncreaseintake" class="pgc-btn pgc-btn-primary">
                    Next: Increase intake <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
            </nav>
        }
        @if (isDental)
        {
            <nav class="pgc-pager" aria-label="Form navigation">
                <a asp-action="Ug_Course_Details" asp-controller="ContinuesAffiliation_Facultybased" class="pgc-btn pgc-btn-ghost">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i> Previous: UG course details
                </a>
                <a asp-action="TeachingFacultyDetails" asp-controller="DentalRepository" class="pgc-btn pgc-btn-primary">
                    Next: Teaching faculty details <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
            </nav>
        }

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (function () {
        var MAX_BYTES = 1 * 1024 * 1024;   // 1 MB, matches the limit shown on every section

        function notify(icon, title, text) {
        if (window.Swal) { Swal.fire({ icon: icon, title: title, text: text, confirmButtonColor: '#1456c4' }); }
        else { alert(title + ': ' + text); }
        }

        function formatSize(bytes) {
        return bytes < 1024 * 1024
        ? Math.max(1, Math.round(bytes / 1024)) + ' KB'
        : (bytes / (1024 * 1024)).toFixed(2) + ' MB';
        }

        function resetUpload(input) {
        var wrap = input.closest('.pgc-upload');
        var nameEl = document.getElementById(input.dataset.nameEl);
        var sizeEl = document.getElementById(input.dataset.sizeEl);
        var clearBtn = wrap ? wrap.querySelector('.pgc-clear') : null;
        input.value = '';
        if (nameEl) { nameEl.textContent = ''; }
        if (sizeEl) { sizeEl.value = ''; }
        if (clearBtn) { clearBtn.hidden = true; }
        }

        // Shared by the GOK, RGUHS and NMC upload controls
        window.pgcDocSelected = function (input) {
        var wrap = input.closest('.pgc-upload');
        var nameEl = document.getElementById(input.dataset.nameEl);
        var sizeEl = document.getElementById(input.dataset.sizeEl);
        var clearBtn = wrap ? wrap.querySelector('.pgc-clear') : null;
        var label = input.dataset.doc || 'Document';

        if (!input.files || input.files.length === 0) { resetUpload(input); return; }

        var file = input.files[0];

        if (!/\.pdf$/i.test(file.name)) {
        resetUpload(input);
        notify('error', 'PDF files only', label + ' must be a PDF. Choose a file ending in .pdf.');
        return;
        }

        if (file.size > MAX_BYTES) {
        resetUpload(input);
        notify('error', 'File is too large', label + ' must be 1 MB or smaller. This file is ' + formatSize(file.size) + '.');
        return;
        }

        if (nameEl) { nameEl.textContent = file.name + ' (' + formatSize(file.size) + ')'; nameEl.title = file.name; }
        if (sizeEl) { sizeEl.value = file.size; }
        if (clearBtn) { clearBtn.hidden = false; }
        };

        window.pgcClearDoc = function (btn) {
        var wrap = btn.closest('.pgc-upload');
        var input = wrap ? wrap.querySelector('input[type="file"]') : null;
        if (input) { resetUpload(input); }
        };

        // Other courses permitted by NMC: Add row / remove row
        var picker = document.getElementById('nmcPicker');
        var addBtn = document.getElementById('nmcAdd');
        var nmcBody = document.getElementById('nmcBody');
        var emptyRow = document.getElementById('nmcEmpty');
        var countEl = document.getElementById('nmcCount');

        function visibleNmcRows() {
        return Array.prototype.filter.call(nmcBody.querySelectorAll('[data-nmc-row]'), function (r) { return !r.hidden; });
        }

        function refreshNmc() {
        var n = visibleNmcRows().length;
        if (emptyRow) { emptyRow.hidden = n > 0; }
        if (countEl) { countEl.textContent = n + (n === 1 ? ' course added' : ' courses added'); }
        if (addBtn) { addBtn.disabled = picker.options.length <= 1; }
        }

        function sortPickerOptions() {
        var opts = Array.prototype.slice.call(picker.options, 1);
        opts.sort(function (a, b) { return a.text.localeCompare(b.text); });
        opts.forEach(function (o) { picker.appendChild(o); });
        }

        if (picker && addBtn && nmcBody) {
        addBtn.addEventListener('click', function () {
        if (!picker.value) {
        notify('info', 'Pick a course first', 'Choose a course from the list, then select Add row.');
        picker.focus();
        return;
        }
        var row = nmcBody.querySelector('[data-nmc-row][data-index="' + picker.value + '"]');
        if (!row) { return; }
        row.hidden = false;
        var sw = row.querySelector('.pgc-switch');
        if (sw) { sw.checked = true; }
        picker.remove(picker.selectedIndex);
        picker.value = '';
        refreshNmc();
        var firstField = row.querySelector('input[type="number"]');
        if (firstField) { firstField.focus(); }
        });

        nmcBody.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-nmc-remove]');
        if (!btn) { return; }
        var row = btn.closest('[data-nmc-row]');
        if (!row) { return; }
        var sw = row.querySelector('.pgc-switch');
        var num = row.querySelector('input[type="number"]');
        var file = row.querySelector('input[type="file"]');
        if (sw) { sw.checked = false; }
        if (num) { num.value = 0; }
        if (file) { resetUpload(file); }
        row.hidden = true;
        var opt = document.createElement('option');
        opt.value = row.dataset.index;
        opt.textContent = row.querySelector('.pgc-course').textContent;
        picker.appendChild(opt);
        sortPickerOptions();
        refreshNmc();
        });

        refreshNmc();
        }

        // Save confirmation from the previous request
        var flash = @Html.Raw(Json.Serialize(flashMessage));
        if (flash && window.Swal) {
        Swal.fire({ icon: 'success', title: 'Saved', text: flash, timer: 3500, timerProgressBar: true, showConfirmButton: false });
        }
        })();
    </script>
}
