@model Medical_Affiliation.Models.StaffDetailsViewModel
@{
    Layout = "~/Views/Shared/_CaLayout.cshtml";
    ViewData["Title"] = "Staff Details & Student Exam Results";

    var facultyList = ViewBag.DepartmentFaculty as List<Medical_Affiliation.Models.FacultyDisplayRowVM>
                      ?? new List<Medical_Affiliation.Models.FacultyDisplayRowVM>();
    var departmentCode = ViewBag.DepartmentCode as string;
    var departmentName = ViewBag.DepartmentName as string;
    var courseLevel = ViewBag.CourseLevel as string;
    var facultyCodeUsed = ViewBag.FacultyCodeUsed as string;
    var collegeCodeUsed = ViewBag.CollegeCodeUsed as string;
    var collegeDepartmentCodes = ViewBag.CollegeDepartmentCodes as string;
    int collegeFacultyCount = Convert.ToInt32(ViewBag.CollegeFacultyCount ?? 0);
    bool departmentMatched = ViewBag.DepartmentMatched is bool matchedFlag && matchedFlag;

    string Dash(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
}

<div class="container-fluid py-3 py-md-4 px-2 px-sm-3">

    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
        <div>
            <h5 class="h5 h4-md mb-0">Staff Details &amp; Student Exam Results</h5>
            <small class="text-muted">Section F &mdash; Staff particulars and student exam results</small>
        </div>
        <span class="badge bg-secondary align-self-start align-self-sm-auto">Section F &mdash; STAFF</span>
    </div>

    <div class="alert alert-light border d-flex flex-wrap gap-2 gap-md-4 align-items-center py-2 mb-3">
        <div>
            <span class="text-muted">Selected department:</span>
            <strong>@(string.IsNullOrWhiteSpace(departmentName) ? "(not found)" : departmentName)</strong>
        </div>
        @if (!string.IsNullOrWhiteSpace(courseLevel))
        {
            <div><span class="text-muted">Course level:</span> <strong>@courseLevel</strong></div>
        }
        <div><span class="text-muted">College code:</span> <strong>@collegeCodeUsed</strong></div>
        <div><span class="text-muted">Faculty code:</span> <strong>@facultyCodeUsed</strong></div>
        @if (departmentMatched && !string.IsNullOrWhiteSpace(departmentCode))
        {
            <div><span class="text-muted">Department code:</span> <strong>@departmentCode</strong></div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @* The form tag helper adds the anti-forgery token automatically *@
    <form asp-action="StaffDetails" asp-controller="pgcourses" method="post">
        <input type="hidden" asp-for="FacultyCode" />
        <input type="hidden" asp-for="CollegeCode" />
        <input type="hidden" asp-for="CourseCode" />
        <input type="hidden" asp-for="TypeOfAffiliation" />

        <!-- F.i. Unit-wise faculty and Senior Resident details (read-only, from UG_Faculty_Details) -->
        <div class="card mb-4">
            <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                <span class="fw-semibold">i. Unit-wise faculty and Senior Resident details</span>
                <span class="badge bg-light text-dark border">@facultyList.Count faculty</span>
            </div>
            <div class="card-body p-2 p-md-3">

                <div class="small text-muted mb-3">
                    @if (departmentMatched)
                    {
                        <span>
                            Showing the @facultyList.Count faculty of this department for the logged-in college and faculty.
                            This list is fetched from the faculty master and cannot be edited here.
                        </span>
                    }
                    else if (collegeFacultyCount > 0)
                    {
                        <span class="text-warning-emphasis">
                            No faculty in the faculty master are mapped to department code <strong>@departmentCode</strong>,
                            so all @collegeFacultyCount faculty of this college are listed (each shows its own department).
                            Department codes in the master for this college: @collegeDepartmentCodes.
                        </span>
                    }
                    else
                    {
                        <span class="text-danger">
                            No rows found in the faculty master for faculty code <strong>@facultyCodeUsed</strong>
                            and college code <strong>@collegeCodeUsed</strong>.
                        </span>
                    }
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-sm-mobile mb-0" id="facultyTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width:4%">Sr.No</th>
                                <th class="text-nowrap">Department</th>
                                <th class="text-nowrap">Name of the Faculty</th>
                                <th class="text-nowrap">Designation</th>
                                <th class="text-nowrap">DOB</th>
                                <th class="text-nowrap">Date of Appointment</th>
                                <th class="text-nowrap">Aadhaar No.</th>
                                <th class="text-nowrap">PAN No.</th>
                                <th class="text-nowrap">Mobile No.</th>
                                <th class="text-nowrap">E-mail</th>
                                <th class="text-nowrap">State Council Reg. No.</th>
                                <th class="text-nowrap">AEBAS Attend Id</th>
                                <th class="text-nowrap">Professional Qualification</th>
                                <th class="text-nowrap">Nature of Employment</th>
                                <th class="text-nowrap">Teaching Exp. (Yrs)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (facultyList.Count == 0)
                            {
                                <tr>
                                    <td colspan="15" class="text-center text-muted py-3">No faculty records found.</td>
                                </tr>
                            }
                            @for (int i = 0; i < facultyList.Count; i++)
                            {
                                var f = facultyList[i];
                                <tr>
                                    <td class="align-middle text-center">@(i + 1)</td>
                                    <td class="align-middle">
                                        @Dash(f.DepartmentName)
                                        @if (!string.IsNullOrWhiteSpace(f.DepartmentCode))
                                        {
                                            <div class="small text-muted">@f.DepartmentCode</div>
                                        }
                                    </td>
                                    <td class="align-middle fw-semibold">@Dash(f.Name)</td>
                                    <td class="align-middle">@Dash(f.Designation)</td>
                                    <td class="align-middle text-nowrap">@Dash(f.Dob)</td>
                                    <td class="align-middle text-nowrap">@Dash(f.DateOfAppointment)</td>
                                    <td class="align-middle text-nowrap">@Dash(f.AadhaarNo)</td>
                                    <td class="align-middle text-nowrap">@Dash(f.PanNo)</td>
                                    <td class="align-middle text-nowrap">@Dash(f.MobileNo)</td>
                                    <td class="align-middle">@Dash(f.EmailId)</td>
                                    <td class="align-middle text-nowrap">@Dash(f.StateCouncilRegNo)</td>
                                    <td class="align-middle text-nowrap">@Dash(f.AebasAttendId)</td>
                                    <td class="align-middle">@Dash(f.ProfessionalQualification)</td>
                                    <td class="align-middle">@Dash(f.NatureOfEmployment)</td>
                                    <td class="align-middle text-center">@Dash(f.TeachingExpInYrs)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

        <!-- F.ii. Total eligible faculties and Senior Residents -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">
                ii. Total eligible faculties and Senior Residents (fulfilling the TEQ requirement, attendance requirement and other requirements prescribed by NMC from time-to-time) available in the department
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-nowrap">Designation</th>
                                <th class="text-nowrap" style="width:10%">Number</th>
                                <th class="text-nowrap" style="width:20%">Name</th>
                                <th class="text-nowrap" style="width:15%">Total number of Admission (Seats)</th>
                                <th class="text-nowrap" style="width:15%">Adequate / Not Adequate for number of Admission</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.EligibleFaculty.Count; i++)
                            {
                                // Reduce the saved value to letters/digits so "Not adequate", "adequate " etc. still match
                                var adequacy = Model.EligibleFaculty[i].IsAdequateForAdmission;
                                var adequacyKey = new string((adequacy ?? "").Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
                                var isAdequate = adequacyKey == "adequate" || adequacyKey == "y" || adequacyKey == "yes";
                                var isNotAdequate = adequacyKey == "notadequate" || adequacyKey == "inadequate" || adequacyKey == "n" || adequacyKey == "no";

                                <tr>
                                    <td class="align-middle fw-semibold text-nowrap">
                                        @Model.EligibleFaculty[i].Designation
                                        <input type="hidden" asp-for="EligibleFaculty[i].Designation" />
                                        <input type="hidden" asp-for="EligibleFaculty[i].DesignationSequence" />
                                    </td>
                                    <td><input asp-for="EligibleFaculty[i].NumberOfFaculty" type="number" min="0" class="form-control form-control-sm" /></td>
                                    <td><input asp-for="EligibleFaculty[i].Names" class="form-control form-control-sm" /></td>
                                    <td><input asp-for="EligibleFaculty[i].TotalAdmissionSeats" type="number" min="0" class="form-control form-control-sm" /></td>
                                    <td>
                                        @* Explicit selection (no asp-for) so the saved value always wins over stale ModelState *@
                                        <select name="EligibleFaculty[@i].IsAdequateForAdmission" class="form-select form-select-sm">
                                            <option value="">--</option>
                                            <option value="Adequate" selected="@isAdequate">Adequate</option>
                                            <option value="Not Adequate" selected="@isNotAdequate">Not Adequate</option>
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- F.iii. No. of PG students presently studying -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">iii. No. of PG students presently studying in the Department</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0" style="max-width:500px;">
                        <thead class="table-light">
                            <tr><th>Years</th><th>No. of students</th></tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.PgStudentsByYear.Count; i++)
                            {
                                <tr>
                                    <td class="align-middle fw-semibold">
                                        @Model.PgStudentsByYear[i].YearLabel
                                        <input type="hidden" asp-for="PgStudentsByYear[i].YearLabel" />
                                        <input type="hidden" asp-for="PgStudentsByYear[i].YearSequence" />
                                    </td>
                                    <td><input asp-for="PgStudentsByYear[i].NumberOfStudents" type="number" min="0" class="form-control form-control-sm" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- H. List of Students appeared for exams -->
        <div class="card mb-4">
            <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                <span class="fw-semibold">H. List of Students appeared for exams during the previous years</span>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addExamRow()">+ Add Row</button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0" id="examTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width:10%">Sl. No.</th>
                                <th>Name</th>
                                <th style="width:20%">Result (Pass/Fail)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.ExamResults.Count; i++)
                            {
                                <tr>
                                    <td class="align-middle text-center">@(i + 1)</td>
                                    <td><input name="ExamResults[@i].StudentName" value="@Model.ExamResults[i].StudentName" class="form-control form-control-sm" /></td>
                                    <td>
                                        <select name="ExamResults[@i].Result" class="form-select form-select-sm">
                                            <option value="">--</option>
                                            <option value="Pass" selected="@(Model.ExamResults[i].Result == "Pass")">Pass</option>
                                            <option value="Fail" selected="@(Model.ExamResults[i].Result == "Fail")">Fail</option>
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="d-flex flex-column-reverse flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 mt-4">
            <a asp-action="ServicesWorkload" asp-controller="pgcourses"
               asp-route-facultyCode="@Model.FacultyCode"
               asp-route-collegeCode="@Model.CollegeCode"
               asp-route-courseCode="@Model.CourseCode"
               asp-route-typeOfAffiliation="@Model.TypeOfAffiliation"
               class="btn btn-outline-secondary px-4 w-100 w-sm-auto">
                <i class="bi bi-arrow-left"></i> Previous
            </a>
            <button type="submit" class="btn btn-primary px-4 w-100 w-sm-auto">
                Save &amp; Continue <i class="bi bi-arrow-right"></i>
            </button>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <style>
        /* Responsive tightening for small screens */
        @@media (max-width: 575.98px) {
            .container-fluid {
                padding-left: 8px;
                padding-right: 8px;
            }

            .card-header {
                font-size: 0.9rem;
            }

            .table-bordered th,
            .table-bordered td {
                font-size: 0.78rem;
                padding: 0.35rem;
            }

            .form-control-sm,
            .form-select-sm {
                font-size: 0.78rem;
                min-width: 110px;
            }

            .badge {
                font-size: 0.7rem;
            }
        }

        @@media (min-width: 576px) and (max-width: 767.98px) {
            .table-bordered th,
            .table-bordered td {
                font-size: 0.85rem;
            }
        }

        /* Force horizontal scrolling for wide tables */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
            display: block;
        }

            .table-responsive table {
                min-width: 980px;
                width: 100%;
            }

        /* The faculty list has 15 columns - let it scroll sideways instead of squeezing */
        #facultyTable {
            min-width: 1700px;
        }

        #examTable {
            min-width: 980px;
        }

        @@media (min-width: 768px) {
            .table-responsive table {
                min-width: 0;
            }

            #facultyTable {
                min-width: 1700px;
            }
        }
    </style>
    <script>
        /* ---------- exam rows ---------- */
        function addExamRow() {
            const tbody = document.querySelector('#examTable tbody');
            const index = tbody.querySelectorAll('tr').length;
            const html = `<tr>
                <td class="align-middle text-center">${index + 1}</td>
                <td><input name="ExamResults[${index}].StudentName" class="form-control form-control-sm" /></td>
                <td>
                    <select name="ExamResults[${index}].Result" class="form-select form-select-sm">
                        <option value="">--</option>
                        <option value="Pass">Pass</option>
                        <option value="Fail">Fail</option>
                    </select>
                </td>
            </tr>`;
            tbody.insertAdjacentHTML('beforeend', html);
        }

        /* ---------- block double-submits (a double click saved twice) ---------- */
        (function () {
            const form = document.getElementById('examTable').closest('form');
            form.addEventListener('submit', function (e) {
                if (form.dataset.submitting === '1') { e.preventDefault(); return; }
                form.dataset.submitting = '1';
                setTimeout(function () { form.dataset.submitting = ''; }, 4000);
            });
        })();
    </script>
}
