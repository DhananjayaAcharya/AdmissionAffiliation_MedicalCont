@model Medical_Affiliation.Models.PaymentCalculationViewModel
@{
    ViewData["Title"] = "Payment Calculation";
    Layout = "~/Views/Shared/_CaLayout.cshtml";

    // Sourced the same way BaseController reads them (claims + session) since
    // PaymentCalculationViewModel doesn't currently carry these fields.
    // Swap these for Model properties instead if you thread them through the VM.
    var payCollegeCode = Context.Session.GetString("CollegeCode")
        ?? User.FindFirst("CollegeCode")?.Value ?? string.Empty;
    var payFacultyCode = Context.Session.GetString("FacultyCode")
        ?? User.FindFirst("FacultyCode")?.Value ?? "0";
    var payCourseLevel = Context.Session.GetString("CourseLevel")
                          ?? Context.Session.GetString("SelectedCourseLevel")
                          ?? User.FindFirst("CourseLevel")?.Value
                          ?? User.FindFirst("SelectedCourseLevel")?.Value
                          ?? "PG";
    var payAffiliationTypeId = Context.Session.GetString("AffiliationTypeId") ?? "0";
    var payApplicationType = Context.Session.GetString("TypeOfAffiliation")
        ?? Model.TypeOfAffiliation
        ?? Context.Session.GetString("ApplicationType")
        ?? string.Empty;
    var normalizedPayCourseLevel = payCourseLevel.Trim();
    var normalizedAppType = payApplicationType.Trim();
    var isAdditionalCoursesType = normalizedAppType.Contains("Additional", StringComparison.OrdinalIgnoreCase)
        || normalizedAppType.Contains("Add Course", StringComparison.OrdinalIgnoreCase)
        || normalizedAppType.Contains("Addl", StringComparison.OrdinalIgnoreCase)
        || payAffiliationTypeId == "4";
    var isContinuationType = normalizedAppType.Contains("Continuation", StringComparison.OrdinalIgnoreCase)
        || normalizedAppType.Contains("Continuation of Affiliation", StringComparison.OrdinalIgnoreCase)
        || payAffiliationTypeId == "1";
    var isIncreaseIntakeType = normalizedAppType.Contains("Enhancement", StringComparison.OrdinalIgnoreCase)
        || normalizedAppType.Contains("Increase", StringComparison.OrdinalIgnoreCase)
        || normalizedAppType.Contains("Intake", StringComparison.OrdinalIgnoreCase)
        || payAffiliationTypeId == "3";
}

<style>
    .payment-calculation-page {
        padding: .25rem 0 1.5rem;
    }

    .payment-calculation-heading {
        border-bottom: 1px solid #d8e3f5;
        padding-bottom: 1rem;
        margin-bottom: 1.25rem;
    }

        .payment-calculation-heading h1 {
            color: #0f1d3d;
            font-family: 'EB Garamond', serif;
            font-size: 1.8rem;
            margin: 0;
        }

        .payment-calculation-heading p {
            color: #7d8aa9;
            margin: .25rem 0 0;
        }

    .payment-panel {
        border: 1px solid #d8e3f5;
        border-radius: 8px;
        background: #fff;
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .payment-panel-header {
        background: #f4f8fd;
        border-bottom: 1px solid #d8e3f5;
        padding: .8rem 1rem;
        color: #0a3d91;
        font-weight: 700;
    }

    .payment-panel-body {
        padding: 1rem;
    }

    .payment-disclaimer {
        margin: 0 0 1.25rem;
        padding: .9rem 1rem;
        border: 1px solid #f0c36d;
        border-left: 4px solid #d98b00;
        border-radius: 6px;
        background: #fff8e1;
        color: #5f4300;
        font-size: .9rem;
        font-weight: 600;
    }

    .payment-calculation-page .form-label {
        color: #435273;
        font-size: .82rem;
        font-weight: 600;
    }

    .payment-calculation-page .payment-amount-readonly {
        background-color: #eef2f6;
        border-color: #b8c4d1;
        color: #435273;
        font-weight: 600;
        cursor: not-allowed;
    }

    .payment-calculation-page .table {
        margin-bottom: 0;
        vertical-align: middle;
    }

        .payment-calculation-page .table th {
            color: #435273;
            font-size: .76rem;
            text-transform: uppercase;
        }

    .payment-calculation-page .separation {
        margin: 0.5rem 0;
        border: 1px solid #d0d0d0d6;
        border-radius: 5px;
        padding: 5px;
    }
</style>

<div class="payment-calculation-page">
    <div class="payment-calculation-heading">
        <h1><i class="bi bi-cash-coin me-2" aria-hidden="true"></i>Payment Calculation</h1>
        <p>Calculate the applicable affiliation fee for the selected college and course details.</p>
    </div>
    @{
        var snapshotData = new
        {
            collegeName = (string?)null,
            courseLevel = Model.Summary?.CourseLevelGroup,
            affiliationTypeName = Context.Session.GetString("TypeOfAffiliation"),
            matchedCourses = Model.MatchedCourses.Select(c => new { courseName = c.CourseName, courseLevel = c.RawCourseLevel, intake = c.Intake_26_27 }),
            feeLines = Model.FeeLines.Select(f => new { feeHead = f.FeeHeadName, unitAmount = f.UnitAmount, basis = f.IsPerCourse ? "Per course" : f.IsPerSeat ? "Per seat" : "Fixed", multiplier = f.Multiplier, lineAmount = f.LineAmount }),
            grandTotal = Model.Summary?.GrandTotal ?? 0
        };
    }
    <input type="hidden" id="pd_CalculationSnapshot" value="@Html.Raw(Json.Serialize(snapshotData))" />
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.HasResult)
    {
        var applicationTypeName = Model.TypeOfAffiliation
            ?? Context.Session.GetString("TypeOfAffiliation")
            ?? Context.Session.GetString("ApplicationType")
            ?? string.Empty;

        var isEnhancementApplication = Model.AffiliationTypeId == 3
            || applicationTypeName.Contains("Enhancement", StringComparison.OrdinalIgnoreCase)
            || applicationTypeName.Contains("Increase in Intake", StringComparison.OrdinalIgnoreCase)
            || (applicationTypeName.Contains("Increase", StringComparison.OrdinalIgnoreCase)
                && applicationTypeName.Contains("Intake", StringComparison.OrdinalIgnoreCase));

        var showIncreasedIntakeColumns = isEnhancementApplication
    && Model.MatchedCourses.Any(c => !string.IsNullOrWhiteSpace(c.IncreasedIntake) || !string.IsNullOrWhiteSpace(c.AcademicYear));

        var activeCollegeCode = Context.Session.GetString("CollegeCode") ?? Model.CollegeCode ?? payCollegeCode;
        var activeFacultyCode = Context.Session.GetString("FacultyCode") ?? payFacultyCode;
        var activeCourseLevel = Context.Session.GetString("CourseLevel")
            ?? Context.Session.GetString("SelectedCourseLevel")
            ?? Model.CourseLevel
            ?? payCourseLevel;
        var activeApplicationType = Context.Session.GetString("TypeOfAffiliation")
            ?? Model.TypeOfAffiliation
            ?? payApplicationType
            ?? string.Empty;

        <div class="payment-panel">
            @* <div class="payment-panel-header d-flex justify-content-between align-items-center">
                <span>Matched Courses (@Model.MatchedCourses.Count)</span>
                <a href="@Url.Action("DownloadPdf", "PaymentCalculation")" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener noreferrer">
                    <i class="bi bi-file-earmark-pdf me-1" aria-hidden="true"></i> Download PDF
                </a>
            </div> *@
            <div class="payment-panel-body table-responsive">
                <table class="table table-bordered table-sm">
                    <thead class="table-light">
                        <tr>
                            <th>Course Name</th>
                            <th>Course (Intake sheet)</th>
                            <th>Course Level</th>
                            <th>Intake (26-27)</th>
                            @if (showIncreasedIntakeColumns)
                            {
                                <th>Increased Intake</th>
                                <th>Academic Year</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.MatchedCourses)
                        {
                            <tr>
                                <td>@c.CourseName</td>
                                <td>@c.course</td>
                                <td>@c.RawCourseLevel</td>
                                <td>@c.Intake_26_27</td>
                                @if (showIncreasedIntakeColumns)
                                {
                                    <td>@(!string.IsNullOrWhiteSpace(c.IncreasedIntake) ? c.IncreasedIntake : "-")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(c.AcademicYear) ? c.AcademicYear : "-")</td>
                                }
                            </tr>
                        }
                        @if (!Model.MatchedCourses.Any())
                        {
                            <tr><td colspan="@(showIncreasedIntakeColumns ? 7 : 5)" class="text-center text-muted">No courses matched for this college / affiliation type.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="payment-panel">
            <div class="payment-panel-header d-flex justify-content-between align-items-center">
                <span>Fee Breakdown</span>
                <small class="text-muted">College: @activeCollegeCode &nbsp;|&nbsp; Level: @activeCourseLevel &nbsp;|&nbsp; Type: @activeApplicationType</small>
            </div>
            <div class="payment-panel-body table-responsive">
                @if (Model.FeeLines.Any())
                {
                    <table class="table table-bordered table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Fee Head</th>
                                <th>Unit Amount</th>
                                <th>Basis</th>
                                <th>Multiplier</th>
                                <th>Calculation</th>
                                <th class="text-end">Line Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.FeeLines)
                            {
                                var basisText = f.IsPerCourse ? "Per course" : f.IsPerSeat ? "Per seat" : "Fixed";
                                var multiplierValue = f.Multiplier > 0 ? f.Multiplier.ToString() : "1";
                                var formulaText = f.IsPerCourse
                                    ? $"{f.UnitAmount:N2} × {multiplierValue} course(s)"
                                    : f.IsPerSeat
                                        ? $"{f.UnitAmount:N2} × {multiplierValue} seat(s)"
                                        : $"{f.UnitAmount:N2} × 1";

                                <tr>
                                    <td>@f.FeeHeadName</td>
                                    <td>@f.UnitAmount.ToString("N2")</td>
                                    <td>@basisText</td>
                                    <td>@multiplierValue</td>
                                    <td>@formulaText</td>
                                    <td class="text-end">@f.LineAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-secondary fw-bold">
                                <td colspan="5" class="text-end">Grand Total</td>
                                <td class="text-end">@((Model.Summary?.GrandTotal ?? Model.FeeLines.Sum(x => x.LineAmount)).ToString("N2"))</td>
                            </tr>
                        </tfoot>
                    </table>
                }
                else if (isAdditionalCoursesType)
                {
                    <table class="table table-bordered table-sm">
                        <tbody>
                            <tr><th style="width: 60%;">Fee Head</th><th style="width: 20%;">Multiplier</th><th class="text-end" style="width: 20%;">Amount</th></tr>
                            @if (normalizedPayCourseLevel.Equals("PG", StringComparison.OrdinalIgnoreCase))
                            {
                                <tr><td>Application fee</td><td>1</td><td class="text-end">3,000-00</td></tr>
                                <tr><td>Course identification fee</td><td>1</td><td class="text-end">10-00</td></tr>
                                <tr><td>PG fresh course affiliation fee <strong>(per course)</strong></td><td>@Model.MatchedCourses.Count</td><td class="text-end">4,00,000-00</td></tr>
                            }
                            else if (normalizedPayCourseLevel.Equals("SS", StringComparison.OrdinalIgnoreCase))
                            {
                                <tr><td>Application fee</td><td>1</td><td class="text-end">3,000-00</td></tr>
                                <tr><td>Course identification fee</td><td>1</td><td class="text-end">10-00</td></tr>
                                <tr><td>Fresh PG Super Specialty course <strong>(per course)</strong></td><td>@Model.MatchedCourses.Count</td><td class="text-end">4,00,000-00</td></tr>
                            }
                            else
                            {
                                <tr><td>Application fee</td><td>1</td><td class="text-end">3,000-00</td></tr>
                                <tr><td>Course identification fee</td><td>1</td><td class="text-end">10-00</td></tr>
                                <tr><td>UG additional course affiliation fee <strong>(per course)</strong></td><td>@Model.MatchedCourses.Count</td><td class="text-end">1,00,000-00</td></tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-secondary fw-bold">
                                <td colspan="2" class="text-end">Grand Total</td>
                                <td class="text-end">@((Model.Summary?.GrandTotal ?? 0m).ToString("N2"))</td>
                            </tr>
                        </tfoot>
                    </table>
                }
                else
                {
                    <table class="table table-bordered table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Fee Head</th>
                                <th>Unit Amount</th>
                                <th>Basis</th>
                                <th>Multiplier</th>
                                <th class="text-end">Line Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.FeeLines)
                            {
                                <tr>
                                    <td>@f.FeeHeadName</td>
                                    <td>@f.UnitAmount.ToString("N2")</td>
                                    <td>
                                        @if (f.IsPerCourse)
                                        {
                                            <span>Per course</span>
                                        }
                                        else if (f.IsPerSeat)
                                        {
                                            <span>Per seat</span>
                                        }
                                        else
                                        {
                                            <span>Fixed</span>
                                        }
                                    </td>
                                    <td>@(f.Multiplier > 0 ? f.Multiplier.ToString() : "1")</td>
                                    <td class="text-end">@f.LineAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-secondary fw-bold">
                                <td colspan="4" class="text-end">Grand Total</td>
                                <td class="text-end">@((Model.Summary?.GrandTotal ?? Model.FeeLines.Sum(x => x.LineAmount)).ToString("N2"))</td>
                            </tr>
                        </tfoot>
                    </table>
                }

                <div class="row mt-3">
                    <div class="col-md-3"><strong>Matched Courses:</strong> @Model.Summary?.MatchedCourseCount</div>
                    <div class="col-md-3"><strong>Total Intake Seats:</strong> @Model.Summary?.TotalIntakeSeats</div>
                    <div class="col-md-3"><strong>Course Level Group:</strong> @Model.Summary?.CourseLevelGroup</div>
                    <div class="col-md-3"><strong>College Code:</strong> @activeCollegeCode</div>
                </div>
            </div>
        </div>

        <div class="payment-disclaimer" role="note">
            <strong>Disclaimer:</strong> The fee details provided are for reference purposes only. Please verify the applicable fees against the latest fee structure and prevailing RGUHS norms before proceeding.
        </div>

        <div class="payment-panel">
            <div class="payment-panel-header">How to Complete Payment</div>
            <div class="payment-panel-body">
                <ol class="mb-0">
                    <li>
                        Click <a href="https://payments.billdesk.com/bdcollect/bd/rguohsc/2632" target="_blank" rel="noopener noreferrer"><strong>Pay securely through BillDesk</strong></a>; the official RGUHS payment page opens in a new tab.
                    </li>
                    <li>Complete the payment for the exact Grand Total displayed on this page.</li>
                    <li>Save the successful receipt or take a clear screenshot showing the reference number, payment date and amount.</li>
                    <li>Return here, enter the reference number and payment date, then choose the receipt or screenshot.</li>
                    <li>Verify every detail before saving. Accepted formats: PDF, PNG, JPG and JPEG.</li>
                </ol>
            </div>
        </div>

        <div class="payment-panel">
            <div class="payment-panel-header">Payment Details</div>
            <div class="payment-panel-body">
                <form id="PaymentDocumentForm" method="post" action="@Url.Action("SavePaymentDocument", "PaymentDocument")" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="pd_CollegeCode" value="@payCollegeCode" />
                    <input type="hidden" id="pd_FacultyCode" value="@payFacultyCode" />
                    <input type="hidden" id="pd_CourseLevel" value="@payCourseLevel" />
                    <input type="hidden" id="pd_AffiliationTypeId" value="@payAffiliationTypeId" />

                    <div class="row separation">
                        <div class="col-md-4">
                            <label for="pd_TransactionId" class="form-label required">Transaction ID</label>
                            <input type="text" id="pd_TransactionId" class="form-control" maxlength="100" required />
                        </div>

                        <div class="col-md-4">
                            <label for="pd_PaymentAmount" class="form-label">Payment Amount</label>
                            <input type="number" step="0.01" id="pd_PaymentAmount" class="form-control payment-amount-readonly" value="@Model.Summary?.GrandTotal.ToString("0.00")" readonly aria-readonly="true" />
                        </div>

                        <div class="col-md-4">
                            <label for="pd_PaymentDate" class="form-label">Payment Date</label>
                            <input type="date" id="pd_PaymentDate" class="form-control" />
                        </div>
                    </div>

                    <div class="row separation">
                        <div class="col-md-6">
                            <label for="pd_ScreenshotFile" class="form-label required">
                                Payment Screenshot (JPG, PNG, or PDF — max 2MB)
                            </label>
                            <input type="file" id="pd_ScreenshotFile" class="form-control" accept=".jpg,.jpeg,.png,.pdf" />
                        </div>

                        <div class="col-md-6" id="pd_ExistingScreenshotWrap" style="display:none;">
                            <label class="form-label">Currently Uploaded</label>
                            <div>
                                <span id="pd_ExistingFileName" class="me-2"></span>
                                <a href="#" id="pd_ViewExistingBtn" target="_blank" class="btn btn-sm btn-outline-primary">View</a>
                                <a href="#" id="pd_DownloadExistingBtn" class="btn btn-sm btn-outline-secondary">Download</a>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-3">
                        @if (!Model.PaymentSaved)
                        {
                            <button type="submit" id="pd_SaveBtn" class="btn btn-primary">
                                Save Payment Details
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    }
</div>

<script>
    (function () {
        var pageSnapshot = @Html.Raw(Json.Serialize(snapshotData));

        // Falls back to a plain alert if SweetAlert2 (Swal) isn't loaded on this
        // page's layout — avoids "Swal is not defined" breaking the save flow.
        function showAlert(opts) {
            if (typeof Swal !== 'undefined') {
                return Swal.fire(opts);
            }
            alert((opts.title ? opts.title + ': ' : '') + (opts.text || ''));
            return Promise.resolve();
        }

        function initializePaymentDocument() {
            loadExistingPaymentDocument();

            var paymentForm = document.getElementById('PaymentDocumentForm');
            if (paymentForm) {
                paymentForm.addEventListener('submit', function (event) {
                    event.preventDefault();
                    savePaymentDocument();
                });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializePaymentDocument);
        } else {
            initializePaymentDocument();
        }

        function getContext() {
            return {
                collegeCode: document.getElementById('pd_CollegeCode').value,
                facultyCode: document.getElementById('pd_FacultyCode').value,
                courseLevel: document.getElementById('pd_CourseLevel').value,
                affiliationTypeId: document.getElementById('pd_AffiliationTypeId').value
            };
        }

        function loadExistingPaymentDocument() {
            var ctxEl = document.getElementById('pd_CollegeCode');
            if (!ctxEl) return; // section not rendered (no HasResult yet)

            var ctx = getContext();
            var url = '@Url.Action("GetPaymentDocument", "PaymentDocument")'
                + '?collegeCode=' + encodeURIComponent(ctx.collegeCode)
                + '&facultyCode=' + ctx.facultyCode
                + '&courseLevel=' + encodeURIComponent(ctx.courseLevel)
                + '&affiliationTypeId=' + ctx.affiliationTypeId;

            fetch(url)
                .then(function (r) { return r.json(); })
                .then(function (result) {
                    if (result.success && result.data) {
                        document.getElementById('pd_TransactionId').value = result.data.transactionId || '';
                        document.getElementById('pd_PaymentAmount').value = result.data.paymentAmount || '';
                        if (result.data.paymentDate) {
                            document.getElementById('pd_PaymentDate').value = result.data.paymentDate.substring(0, 10);
                        }

                        if (result.data.hasScreenshot) {
                            document.getElementById('pd_ExistingScreenshotWrap').style.display = 'block';
                            document.getElementById('pd_ExistingFileName').textContent = result.data.screenshotFileName || 'Uploaded file';

                            var viewUrl = '@Url.Action("ViewPaymentDocument", "PaymentDocument")'
                                + '?paymentDocumentId=' + result.data.paymentDocumentId + '&mode=view';
                            var downloadUrl = '@Url.Action("ViewPaymentDocument", "PaymentDocument")'
                                + '?paymentDocumentId=' + result.data.paymentDocumentId + '&mode=download';

                            document.getElementById('pd_ViewExistingBtn').href = viewUrl;
                            document.getElementById('pd_DownloadExistingBtn').href = downloadUrl;

                            document.getElementById('pd_ScreenshotFile').removeAttribute('required');
                        }
                    }
                })
                .catch(function (err) { console.error('Failed to load existing payment document', err); });
        }

        function savePaymentDocument() {
            var form = document.getElementById('PaymentDocumentForm');
            var tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            var token = tokenInput ? tokenInput.value : '';
            var ctx = getContext();

            if (!token) {
                showAlert({ icon: "error", title: "Security token missing", text: "Please refresh the page and try again." });
                return;
            }

            var transactionId = document.getElementById('pd_TransactionId').value.trim();
            if (!transactionId) {
                showAlert({ icon: "error", title: "Missing Transaction ID", text: "Please enter the Transaction ID." });
                return;
            }

            var fileInput = document.getElementById('pd_ScreenshotFile');
            var hasExisting = document.getElementById('pd_ExistingScreenshotWrap').style.display !== 'none';

            if (!hasExisting && (!fileInput.files || fileInput.files.length === 0)) {
                showAlert({ icon: "error", title: "Missing Screenshot", text: "Please upload the payment screenshot." });
                return;
            }

            var formData = new FormData();
            formData.append('CollegeCode', ctx.collegeCode);
            formData.append('FacultyCode', ctx.facultyCode);
            formData.append('CourseLevel', ctx.courseLevel);
            formData.append('AffiliationTypeId', ctx.affiliationTypeId);
            formData.append('TransactionId', transactionId);

            var snapshotJson = JSON.stringify(pageSnapshot || {});
            formData.append('CalculationSnapshotJson', snapshotJson);

            var amount = document.getElementById('pd_PaymentAmount').value;
            if (amount) formData.append('PaymentAmount', amount);

            var date = document.getElementById('pd_PaymentDate').value;
            if (date) formData.append('PaymentDate', date);

            if (fileInput.files && fileInput.files.length > 0) {
                formData.append('ScreenshotFile', fileInput.files[0]);
            }

            var saveBtn = document.getElementById('pd_SaveBtn');
            saveBtn.disabled = true;
            saveBtn.textContent = 'Saving...';

            fetch(form.action, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                    // Do NOT set Content-Type manually — the browser sets the
                    // multipart/form-data boundary automatically for FormData.
                },
                body: formData
            })
            .then(function (response) {
                return response.json().then(function (result) {
                    if (!response.ok) {
                        var msg = result.errors
                            ? result.errors.map(function (e) { return e.Messages.join(', '); }).join(' | ')
                            : (result.message || 'Request failed');
                        throw new Error(msg);
                    }
                    return result;
                });
            })
            .then(function (result) {
                if (result.success) {
                    showAlert({
                        icon: result.whatsAppSent ? "success" : "warning",
                        title: result.whatsAppSent ? "Saved and Sent" : "Saved, WhatsApp Not Sent",
                        text: (result.message || 'Payment details saved successfully') + "\n" + (result.whatsAppStatus || result.whatsAppMessage || ''),
                        confirmButtonText: 'OK'
                    }).then(function () { window.location.reload(); });
                } else {
                    showAlert({
                        icon: "error",
                        title: "Failed",
                        text: result.message || 'Failed to save payment details',
                        confirmButtonText: 'OK'
                    });
                }
            })
            .catch(function (error) {
                console.error(error);
                showAlert({
                    icon: "error",
                    title: "Error",
                    text: error.message || 'Error while saving payment details.',
                    confirmButtonText: 'OK'
                });
            })
            .finally(function () {
                saveBtn.disabled = false;
                saveBtn.textContent = 'Save Payment Details';
            });
        }
    })();
</script>
