@model Medical_Affiliation.Models.DentalLibraryUserPageViewModel

@{
    ViewData["Title"] = "Library User Details";
    Layout = "~/Views/Shared/_CaLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .library-user-page { min-height: calc(100vh - 8rem); padding: 1.5rem 0 3rem; background: #f4f8fb; color: #18324b; }
    .library-user-page .page-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; padding: 1.5rem 1.75rem; color: #fff; border-radius: .75rem; background: linear-gradient(120deg, #0e4d80, #1769aa); }
    .library-user-page .page-heading h1 { margin: 0; font-size: 1.8rem; }
    .library-user-page .page-heading p { margin: .35rem 0 0; color: rgba(255,255,255,.78); }
    .library-user-page .panel { border: 1px solid #dce7f0; border-radius: .7rem; box-shadow: 0 .5rem 1.5rem rgba(34,67,96,.07); }
    .library-user-page .form-label { color: #526b80; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
    .library-user-page .count-input { max-width: 10rem; }
    .library-user-page .yes-no .btn { min-width: 6rem; }
    @@media (max-width: 767.98px) {
        .library-user-page .page-heading { align-items: start; flex-direction: column; padding: 1.25rem; }
        .library-user-page .count-input { max-width: none; }
    }
</style>

<div class="library-user-page">
    <div class="container-fluid">
        <div class="page-heading">
            <div>
                <h1>Library User Details</h1>
                <p>Enter user counts and programme availability for the current course level.</p>
            </div>
            <span class="small">College: @Model.CollegeCode</span>
        </div>

        <div class="panel border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="mb-1">User details</h5>
                        <span class="text-muted small">Course level is taken from the current session: <strong>@Model.CourseLevel</strong></span>
                    </div>
                </div>

                <form asp-action="Save" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-4"><label asp-for="Form.NoOfTeachingStaff" class="form-label"></label><input asp-for="Form.NoOfTeachingStaff" class="form-control count-input" min="0" /></div>
                        <div class="col-md-4"><label asp-for="Form.NoOfResearchScholarsAssistants" class="form-label"></label><input asp-for="Form.NoOfResearchScholarsAssistants" class="form-control count-input" min="0" /></div>
                        <div class="col-md-4"><label asp-for="Form.NoOfPostGraduateStudents" class="form-label"></label><input asp-for="Form.NoOfPostGraduateStudents" class="form-control count-input" min="0" /></div>
                        <div class="col-md-4"><label asp-for="Form.NoOfUnderGraduateStudents" class="form-label"></label><input asp-for="Form.NoOfUnderGraduateStudents" class="form-control count-input" min="0" /></div>
                        <div class="col-md-4"><label asp-for="Form.NoOfAdministrativeStaff" class="form-label"></label><input asp-for="Form.NoOfAdministrativeStaff" class="form-control count-input" min="0" /></div>
                        <div class="col-md-4"><label asp-for="Form.NoOfParaMedicalStaff" class="form-label"></label><input asp-for="Form.NoOfParaMedicalStaff" class="form-control count-input" min="0" /></div>
                        <div class="col-md-4"><label asp-for="Form.NoOfOutsiders" class="form-label"></label><input asp-for="Form.NoOfOutsiders" class="form-control count-input" min="0" /></div>
                        <div class="col-md-8 d-flex align-items-end">
                            <div>
                                <label class="form-label d-block">Provide user education programmes</label>
                                <div class="btn-group yes-no" role="group" aria-label="User education programme availability">
                                    <input asp-for="Form.ProvideUserEducationProgrammes" value="true" class="btn-check" id="education-yes" autocomplete="off" />
                                    <label class="btn btn-outline-success" for="education-yes"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Yes</label>
                                    <input asp-for="Form.ProvideUserEducationProgrammes" value="false" class="btn-check" id="education-no" autocomplete="off" />
                                    <label class="btn btn-outline-secondary" for="education-no"><i class="bi bi-x-lg me-1" aria-hidden="true"></i>No</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1" aria-hidden="true"></i> Save user details</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (TempData["Success"] is string successMessage)
    {
        <script>Swal.fire({ icon: "success", text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)), toast: true, position: "top-end", showConfirmButton: false, timer: 2500, timerProgressBar: true });</script>
    }
}
