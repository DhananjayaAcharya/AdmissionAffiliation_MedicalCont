 @model Medical_Affiliation.Models.DentalFinalSubmissionReportViewModel

@{
    ViewData["Title"] = "Dental Final Submission Report";
}

<link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<link rel="stylesheet" href="~/css/ca-dental-submission-report.css" />

<div class="dental-report">

    <!-- Page Header -->
    <div class="dr-header">
        <div>
            <h1 class="dr-title">
                Dental Final Submission Report
            </h1>
            <p class="dr-subtitle">
                View final submission statistics for Dental colleges.
            </p>
        </div>

        <div class="dr-header-actions">
            <span class="dr-module-badge">
                <i class="bi bi-shield-check"></i>
                Dental Administration
            </span>

            <a asp-controller="Admin"
               asp-action="AdminDashboard"
               class="btn btn-outline-secondary dr-btn">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Dashboard
            </a>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-outline-danger dr-btn">
                    <i class="bi bi-box-arrow-right me-1"></i>
                    Logout
                </button>
            </form>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 g-xl-4 mb-4">

        <div class="col-12 col-md-6">
            <div class="dr-summary-card dr-total-card">
                <div class="dr-summary-content">
                    <div class="dr-summary-icon">
                        <i class="bi bi-buildings"></i>
                    </div>

                    <div>
                        <div class="dr-summary-label">
                            Total Colleges
                        </div>

                        <h2 class="dr-summary-number">
                            @Model.TotalColleges.ToString("N0")
                        </h2>

                        <div class="dr-summary-description">
                            Registered Dental colleges
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="dr-summary-card dr-submitted-card">
                <div class="dr-summary-content">
                    <div class="dr-summary-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    <div>
                        <div class="dr-summary-label">
                            Submitted Colleges
                        </div>

                        <h2 class="dr-summary-number">
                            @Model.SubmittedColleges.ToString("N0")
                        </h2>

                        <div class="dr-summary-description">
                            Colleges with completed final submissions
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Filter Section -->
    <div class="dr-filter-card">

        <div class="dr-filter-header">
            <div class="dr-filter-icon">
                <i class="bi bi-sliders2"></i>
            </div>

            <div>
                <h2 class="dr-filter-title">
                    Filter Submissions
                </h2>

                <p class="dr-filter-description">
                    Select academic year, course level and affiliation type.
                </p>
            </div>
        </div>

        <div class="dr-filter-body">
            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <div class="col-12 col-md-6 col-xl-4">
                        <label asp-for="AcademicYear" class="form-label">
                            Academic Year
                        </label>

                        <select asp-for="AcademicYear"
                                asp-items="Model.AcademicYears"
                                class="form-select">
                            <option value="">All Academic Years</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-xl-4">
                        <label asp-for="CourseLevel" class="form-label">
                            Course Level
                        </label>

                        <select asp-for="CourseLevel"
                                asp-items="Model.CourseLevels"
                                class="form-select">
                            <option value="">All Course Levels</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-xl-4">
                        <label asp-for="AffiliationTypeId"
                               class="form-label">
                            Affiliation Type
                        </label>

                        <select asp-for="AffiliationTypeId"
                                asp-items="Model.AffiliationTypes"
                                class="form-select">
                            <option value="">All Affiliation Types</option>
                        </select>
                    </div>

                </div>

                <div class="dr-filter-footer">
                    <a asp-action="Index"
                       class="btn dr-btn dr-btn-reset">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Reset Filters
                    </a>

                    <button type="submit"
                            class="btn dr-btn dr-btn-primary">
                        <i class="bi bi-funnel me-1"></i>
                        Apply Filters
                    </button>
                </div>

            </form>
        </div>
    </div>

    <div class="dr-table-card mt-4">
        <div class="dr-table-header">
            <div>
                <h2 class="dr-filter-title">Final Submission Records</h2>
                <p class="dr-filter-description">
                    View and Search college Submission details
                </p>
            </div>
            <div class="dr-table-count">
                <i class="bi bi-files me-1"></i>
                <span id="dr-record-count">
                    @Model.Submissions.Count
                </span> records
            </div>
        </div>

        @* SEARCH AND PAGE SIZE  *@
        <div class="dr-table-toolbar">
            <div class="dr-search-box">
                <i class="bi bi-search"></i>
                <input 
                    type="text" 
                    class="form-control" 
                    placeholder="Search College, application number, course..." 
                    autocomplete="off" 
                    aria-label="Search submissions"
                    id="dr-table-search"
                />

                <button type="button" class="dr-clear-search" id="dr-clear-search" aria-label="Clear Search" title="Clear Search">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <button type="button" id="dr-export-pdf" class="btn btn-danger">
                <i class="bi bi-file-earmark-pdf-fill"></i>
                Export PDF
            </button>
            <div class="dr-page-size">
                <label for="dr-page-size-select">Show</label>
                <select id="dr-page-size-select" class="form-select">
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <span>entries</span>
            </div>
        </div>

        @* RESPONSIVE TABLE *@
        <div class="table-responsive dr-table-responsive">
            <table class="table align-middle dr-submission-table mb-0" id="dr-submissions-table">
                <thead>
                    <tr>
                        <th class="dr-sortable" data-sort="number"># <span class="sort-icon">↕</span></th>
                        <th class="dr-sortable" data-sort="text">College Name <span class="sort-icon">↕</span></th>
                        <th class="dr-sortable" data-sort="text">Application Number <span class="sort-icon">↕</span></th>
                        <th class="dr-sortable" data-sort="text">Academic Year <span class="sort-icon">↕</span></th>
                        <th class="dr-sortable" data-sort="text">Course Level <span class="sort-icon">↕</span></th>
                        <th class="dr-sortable" data-sort="text">Affiliation Type <span class="sort-icon">↕</span></th>
                        <th class="dr-sortable" data-sort="text">Principal Consent <span class="sort-icon">↕</span></th>
                        <th class="dr-sortable" data-sort="text">Submission Status <span class="sort-icon">↕</span></th>
                        <th class="dr-sortable" data-sort="date">Submitted Date <span class="sort-icon">↕</span></th>
                    </tr>
                </thead>
                <tbody id="dr-submissions-body">
                    @if (Model.Submissions.Any())
                    {
                        var slno = 0;
                        foreach(var item in Model.Submissions)
                        {
                            slno++;
                            <tr data-submission-row>
                                <td class="serial-number">
                                    @slno
                                </td>
                                <td class="dr-college-name">
                                    @item.CollegeName
                                </td>
                                <td class="dr-application-number">
                                    @item.ApplicationNumber
                                </td>
                                <td>
                                    <span class="dr-year-badge">
                                        @item.AcademicYear
                                    </span>
                                </td>
                                <td>
                                    <span class="dr-year-badge">
                                        @item.CourseLevel
                                    </span>
                                </td>
                                <td>
                                    @(item.AffiliationType ?? "---")
                                </td>
                                <td>
                                    @if(item.PrincipalConsent == true)
                                    {
                                        <span class="dr-status dr-status-success">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Yes
                                        </span>
                                    }
                                    else if(item.PrincipalConsent == false)
                                    {
                                        <span class="dr-status dr-status-neutral">
                                            <i class="bi bi-dash-circle"></i>
                                            No
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            ---
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsSubmitted)
                                    {
                                         <span class="dr-status dr-status-success">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Submitted
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="dr-status dr-status-pending">
                                            <i class="bi bi-clock"></i>
                                            Not Submitted
                                        </span>
                                    }
                                </td>

                                <td class="dr-date">
                                    @if (item.SubmittedDate.HasValue)
                                    {
                                        @item.SubmittedDate.Value.ToString("dd MM yyyy, hh:mm tt")
                                    }
                                    else
                                    {
                                        <span class="text-muted">---</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div id="dr-no-results" class="dr-no-results" hidden="">
                <div class="dr-empty-icon">
                    <i class="bi bi-search"></i>
                </div>
                <h5>
                    No matching submission found.
                </h5>
                <p>
                    Try a different search term or change the selected filters.
                </p>
            </div>
        </div>

        @* PAGINATION FOOTER *@

        <div class="dr-table-footer">
            <div id="dr-table-info" class="dr-table-info" aria-live="polite">

            </div>

            <nav aria-label="Submission table pagination">
                <ul class="pagination dr-pagination mb-0"
                    id="dr-pagination">
                </ul>
            </nav>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>

<script src="https://unpkg.com/jspdf@2.5.2/dist/jspdf.umd.min.js"></script>
<script src="https://unpkg.com/jspdf-autotable@3.8.4/dist/jspdf.plugin.autotable.min.js"></script>

<script>
    window.dentalSubmissionReportData = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.Submissions.Select(x => new
            {
                CollegeName = x.CollegeName,
                CollegeCode = x.CollegeCode,
                ApplicationNumber = x.ApplicationNumber,
                AcademicYear = x.AcademicYear,
                CourseLevel = x.CourseLevel,
                AffiliationType = x.AffiliationType,
                IsSubmitted = x.IsSubmitted,
                SubmittedDate = x.SubmittedDate
            })
        )
    );
</script>

<script src="~/js/ca-dental-submission-status.js"></script>