    <!-- ════ COLLEGE COURSES DRAWER ════ -->
    <dialog id="collegeDlg" aria-labelledby="dlgTitle">
        <div class="d-head">
            <img src="~/images/newLogo.jpeg" alt="" aria-hidden="true" />
            <div class="d-eyebrow"><i class="bi bi-building"></i> Affiliated College · RGUHS Karnataka</div>
            <h3 class="d-title" id="dlgTitle">—</h3>
            <div class="d-meta" id="dlgMeta"></div>
            <button type="button" class="d-close" id="dlgClose" aria-label="Close"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="d-body">
            <div class="d-sub">
                <h4><i class="bi bi-journal-bookmark-fill"></i> Courses Offered</h4>
                <span class="d-count" id="dlgCount" hidden></span>
            </div>
            <div class="d-state" id="dlgSpin"><div class="spin"></div>Fetching courses…</div>
            <div class="d-state" id="dlgErr" hidden><i class="bi bi-exclamation-triangle"></i>Could not load data. Close this panel and try again.</div>
            <div class="d-state" id="dlgEmpty" hidden><i class="bi bi-inbox"></i>No course records available for this college.</div>
            <ol class="courses" id="dlgList" hidden></ol>
        </div>
        <div class="d-foot"><i class="bi bi-shield-check"></i> Data sourced from RGUHS Affiliation Records</div>
    </dialog>

    <script>
            (function () {
                var grid = document.getElementById('collegeGrid');
                var dlg = document.getElementById('collegeDlg');
                var coursesUrl = '@Url.Action("CollegeCourses", "MainDashboard")';
                var $ = function (id) { return document.getElementById(id); };


                /* ── Count-up for hero total ── */
                var cn = document.querySelector('[data-count]');
                if (cn && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    var target = parseInt(cn.getAttribute('data-count'), 10) || 0, t0 = null;
                    if (target > 0) {
                        cn.textContent = '0';
                        requestAnimationFrame(function step(t) {
                            if (!t0) t0 = t;
                            var p = Math.min((t - t0) / 1100, 1);
                            cn.textContent = Math.round(target * (1 - Math.pow(1 - p, 3)));
                            if (p < 1) requestAnimationFrame(step);
                        });
                    }
                }

                /* ── Instant client-side filter (on top of server search) ── */
                var input = $('searchInput');
                var cards = grid ? Array.prototype.slice.call(grid.querySelectorAll('.card')) : [];
                if (input && cards.length) {
                    var timer;
                    input.addEventListener('input', function () {
                        clearTimeout(timer);
                        timer = setTimeout(function () {
                            var q = input.value.trim().toLowerCase(), shown = 0;
                            cards.forEach(function (c) {
                                var hit = !q || c.getAttribute('data-s').indexOf(q) !== -1;
                                c.hidden = !hit;
                                if (hit) shown++;
                            });
                            $('countNum').textContent = shown;
                            $('countTxt').textContent = 'college' + (shown !== 1 ? 's' : '') + ' found';
                            $('liveEmpty').style.display = shown === 0 ? 'block' : 'none';
                        }, 120);
                    });
                }

                /* ── Course drawer ── */
                function show(id, on) { $(id).hidden = !on; }

                function openCollege(card) {
                    $('dlgTitle').textContent = card.getAttribute('data-name');
                    var meta = $('dlgMeta');
                    meta.textContent = '';
                    [['bi-geo-alt-fill', card.getAttribute('data-town')], ['bi-mortarboard-fill', card.getAttribute('data-fac')]].forEach(function (m) {
                        var s = document.createElement('span');
                        var i = document.createElement('i'); i.className = 'bi ' + m[0];
                        s.appendChild(i); s.appendChild(document.createTextNode(m[1]));
                        meta.appendChild(s);
                    });

                    show('dlgSpin', true); show('dlgErr', false); show('dlgEmpty', false); show('dlgList', false); show('dlgCount', false);
                    if (!dlg.open) dlg.showModal();

                    fetch(coursesUrl + '?collegeCode=' + encodeURIComponent(card.getAttribute('data-code')))
                        .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                        .then(function (data) {
                            show('dlgSpin', false);
                            if (!data || !data.length) { show('dlgEmpty', true); return; }
                            var list = $('dlgList');
                            list.textContent = '';
                            var frag = document.createDocumentFragment();
                            data.forEach(function (row, i) {
                                var li = document.createElement('li');
                                var n = document.createElement('span'); n.className = 'n'; n.textContent = i + 1;
                                var t = document.createElement('span'); t.textContent = row.courseName || '—';
                                li.appendChild(n); li.appendChild(t);
                                frag.appendChild(li);
                            });
                            list.appendChild(frag);
                            $('dlgCount').textContent = data.length + ' Course' + (data.length !== 1 ? 's' : '');
                            show('dlgCount', true); show('dlgList', true);
                        })
                        .catch(function () { show('dlgSpin', false); show('dlgErr', true); });
                }

                if (grid) {
                    grid.addEventListener('click', function (e) {
                        var card = e.target.closest('.card');
                        if (card) openCollege(card);
                    });
                }
                $('dlgClose').addEventListener('click', function () { dlg.close(); });
                dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
            })();
    </script>
