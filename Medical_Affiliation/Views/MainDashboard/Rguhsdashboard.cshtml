                    bool isActive = Model.ActiveFaculty == fac.FacultyId;
                    string facUrl = Url.Action("Rguhsdashboard", new { faculty = fac.FacultyId, search = Model.SearchTerm }) + "#colleges";
                    <a class="stream @(isActive ? "active" : "")" href="@facUrl" @(isActive ? "aria-current=page" : "")>
                        <span class="ic">@fac.Icon</span>
                        <span class="nm">@fac.FacultyName</span>
