@using static Medical_Affiliation.Controllers.MainDashboardController
@model RguhsDashboardViewModel
@{
    ViewData["Title"] = "RGUHS – College Details Portal";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <meta name="description" content="Rajiv Gandhi University of Health Sciences – Affiliated College Details Portal" />
    <title>RGUHS – College Details | Karnataka</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
            /* ══════════════════════════════════
                                           DESIGN TOKENS — LIGHT / OFFICIAL
                                        ══════════════════════════════════ */
            :root {
                /* Institutional navy — used sparingly, for header/footer/text only */
                --navy-950: #0a1b33;
                --navy-900: #0e2645;
                --navy-800: #133257;
                --navy-700: #1a4172;
                --navy-600: #23528c;
                --navy-500: #2f66a8;
                --blue-400: #3b74b8;
                --blue-300: #5c8fc9;
                --blue-200: #9fbedd;
                --blue-100: #dce9f6;
                /* Maroon/crimson — Karnataka govt. seal accent, used as the single warm note */
                --crimson-700: #7a1f2b;
                --crimson-600: #932533;
                --crimson-500: #ad2c3b;
                --crimson-100: #f7e8ea;
                /* Muted gold — official seal / medal tone, used only for thin rules & tiny marks */
                --gold-600: #8a6a1f;
                --gold-500: #a9832a;
                --gold-300: #cba24a;
                --gold-100: #f4ead0;
                --white: #ffffff;
                --paper: #fbfbfa;
                --paper-alt: #f4f5f7;
                --line: #e2e5eb;
                --line-strong: #ccd2dc;
                --ink-900: #12161f;
                --ink-700: #2c3341;
                --ink-500: #5b6472;
                --ink-400: #8891a0;
                --ink-300: #b6bcc7;
                --green: #1a7a4a;
                --red: #b3261e;
                --fd: 'Source Serif 4', Georgia, serif;
                --fb: 'Inter', system-ui, sans-serif;
                --fm: 'IBM Plex Mono', 'Courier New', monospace;
                --r-sm: 5px;
                --r: 8px;
                --r-lg: 12px;
                --r-xl: 18px;
                --shadow-xs: 0 1px 2px rgba(18,22,31,.04);
                --shadow-sm: 0 2px 6px rgba(18,22,31,.06);
                --shadow-md: 0 6px 20px rgba(18,22,31,.08);
                --shadow-lg: 0 16px 44px rgba(18,22,31,.10);
            }

            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html {
                scroll-behavior: smooth;
                font-size: 15px;
            }

            body {
                font-family: var(--fb);
                background: var(--paper);
                color: var(--ink-900);
                overflow-x: hidden;
                -webkit-font-smoothing: antialiased;
            }

            /* ══════════════ UTILITY BAR ══════════════ */
            .util-bar {
                background: var(--navy-950);
                border-bottom: 1px solid rgba(255,255,255,.06);
            }

            .util-inner {
                max-width: 100%;
                padding: 0 40px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                height: 36px;
                gap: 8px;
            }

            .util-links {
                display: flex;
                gap: 0;
                align-items: center;
            }

                .util-links a {
                    color: rgba(255,255,255,.55);
                    text-decoration: none;
                    font-size: 11px;
                    letter-spacing: .2px;
                    font-weight: 400;
                    transition: color .18s, background .18s;
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    padding: 0 15px;
                    height: 36px;
                    border-right: 1px solid rgba(255,255,255,.08);
                }

                    .util-links a:first-child {
                        border-left: 1px solid rgba(255,255,255,.08);
                    }

                    .util-links a:hover {
                        color: var(--gold-300);
                        background: rgba(255,255,255,.04);
                    }

                    .util-links a i {
                        font-size: 11px;
                    }

            .util-right {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .live-clock {
                color: rgba(255,255,255,.45);
                font-size: 11px;
                font-family: var(--fm);
                letter-spacing: .3px;
            }

            .lang-sel {
                background: rgba(255,255,255,.08);
                border: 1px solid rgba(255,255,255,.14);
                color: rgba(255,255,255,.65);
                padding: 4px 10px 4px 8px;
                border-radius: 5px;
                font-size: 11px;
                font-family: var(--fb);
                cursor: pointer;
                outline: none;
            }

            /* ══════════════ HEADER (white, official) ══════════════ */
            .site-header {
                background: var(--white);
                border-bottom: 1px solid var(--line);
                position: relative;
            }

            .header-inner {
                padding: 20px 40px;
                display: flex;
                align-items: center;
                gap: 24px;
                position: relative;
            }

            .header-rule {
                width: 1px;
                height: 60px;
                background: var(--line-strong);
                flex-shrink: 0;
            }

            .university-logo {
                height: 68px;
                width: auto;
                object-fit: contain;
                border-radius: var(--r-sm);
                flex-shrink: 0;
            }

            .header-text {
                flex: 1;
                min-width: 0;
            }

            .univ-eyebrow {
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 2.4px;
                text-transform: uppercase;
                color: var(--crimson-600);
                margin-bottom: 6px;
            }

            .univ-name {
                font-family: var(--fd);
                font-size: clamp(17px, 1.9vw, 26px);
                color: var(--navy-900);
                font-weight: 600;
                line-height: 1.22;
                letter-spacing: .1px;
            }

            .univ-sub {
                font-size: 11.5px;
                color: var(--ink-500);
                margin-top: 7px;
                letter-spacing: .1px;
                display: flex;
                align-items: center;
                gap: 6px;
            }

                .univ-sub i {
                    font-size: 10px;
                    color: var(--blue-400);
                }

            .header-badges {
                display: flex;
                gap: 7px;
                margin-top: 11px;
                flex-wrap: wrap;
            }

            .hbadge {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                padding: 3px 11px;
                border-radius: 4px;
                font-size: 9.5px;
                font-weight: 600;
                letter-spacing: .6px;
                text-transform: uppercase;
                border: 1px solid;
                white-space: nowrap;
            }

            .hbadge-gold {
                background: var(--gold-100);
                border-color: #e4cf9a;
                color: var(--gold-600);
            }

            .hbadge-blue {
                background: var(--blue-100);
                border-color: var(--blue-200);
                color: var(--navy-600);
            }

            .header-cta {
                flex-shrink: 0;
                display: flex;
                flex-direction: column;
                align-items: flex-end;
                gap: 10px;
            }

            .btn-portal {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 12px 22px;
                background: linear-gradient(135deg, var(--navy-900) 0%, var(--navy-700) 100%);
                color: var(--white);
                border: 1px solid rgba(255,255,255,.18);
                border-radius: 999px;
                font-size: 13px;
                font-weight: 700;
                font-family: var(--fb);
                letter-spacing: .22px;
                text-decoration: none;
                cursor: pointer;
                transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
                white-space: nowrap;
                box-shadow: 0 12px 28px rgba(10,27,51,.16);
            }

                .btn-portal:hover {
                    background: linear-gradient(135deg, var(--navy-700) 0%, var(--navy-600) 100%);
                    transform: translateY(-2px);
                    color: var(--white);
                    box-shadow: 0 16px 32px rgba(10,27,51,.2);
                }

            .header-status {
                font-size: 10.5px;
                color: var(--ink-500);
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .pulse-dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--green);
                box-shadow: 0 0 0 3px rgba(26,122,74,.14);
                animation: pulseAnim 2.4s ease-in-out infinite;
            }

            @@keyframes pulseAnim {
                0%, 100% {
                    opacity: 1;
                    box-shadow: 0 0 0 3px rgba(26,122,74,.14);
                }

                50% {
                    opacity: .6;
                    box-shadow: 0 0 0 6px rgba(26,122,74,.04);
                }
            }

            /* ══════════════ TOP RULE ══════════════ */
            .header-stripe {
                height: 3px;
                background: linear-gradient(90deg, var(--navy-900) 0%, var(--crimson-600) 50%, var(--navy-900) 100%);
            }

            /* ══════════════ TICKER ══════════════ */
            .ticker-bar {
                background: var(--navy-900);
                display: flex;
                align-items: stretch;
                overflow: hidden;
                height: 38px;
            }

            .ticker-label {
                background: var(--crimson-600);
                color: var(--white);
                padding: 0 18px;
                font-size: 9px;
                font-weight: 700;
                letter-spacing: 2px;
                white-space: nowrap;
                display: flex;
                align-items: center;
                gap: 8px;
                flex-shrink: 0;
                text-transform: uppercase;
            }

            .blink-dot {
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: #fff;
                animation: blinkAnim 1.1s ease-in-out infinite;
            }

            @@keyframes blinkAnim {
                0%, 100% {
                    opacity: 1
                }

                50% {
                    opacity: .2
                }
            }

            .ticker-track {
                overflow: hidden;
                flex: 1;
                display: flex;
                align-items: center;
            }

            .ticker-inner {
                display: flex;
                white-space: nowrap;
                animation: tickerScroll 55s linear infinite;
            }

                .ticker-inner:hover {
                    animation-play-state: paused;
                }

            @@keyframes tickerScroll {
                0% {
                    transform: translateX(0)
                }

                100% {
                    transform: translateX(-50%)
                }
            }

            .t-item {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-size: 11.5px;
                font-weight: 500;
                color: rgba(255,255,255,.65);
                padding-right: 60px;
            }

                .t-item i {
                    color: var(--gold-300);
                    font-size: 10px;
                }

                .t-item a {
                    color: rgba(255,255,255,.85);
                    text-decoration: none;
                    transition: color .18s;
                }

                    .t-item a:hover {
                        color: var(--gold-300);
                    }

            /* ══════════════ HERO STRIP (photo, subdued) ══════════════ */
            .rguhs-carousel {
                width: 100%;
                overflow: hidden;
                background: var(--navy-950);
                line-height: 0;
                border-bottom: 3px solid var(--gold-300);
            }

            .carousel-img {
                width: 100%;
                height: clamp(180px, 26vw, 330px);
                object-fit: cover;
                object-position: center;
                display: block;
                filter: brightness(.7) saturate(.9);
                transition: filter .5s;
            }

            .rguhs-carousel:hover .carousel-img {
                filter: brightness(.66) saturate(.9);
            }

            .carousel-caption-custom {
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                padding: clamp(16px,2.6vw,40px) clamp(24px,5vw,68px);
                background: linear-gradient(to top, rgba(10,27,51,.90) 0%, rgba(10,27,51,.35) 65%, transparent 100%);
                text-align: left;
                line-height: 1;
            }

            .cc-tag {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                background: var(--white);
                color: var(--navy-900);
                font-size: 9px;
                font-weight: 800;
                letter-spacing: 1.6px;
                text-transform: uppercase;
                padding: 5px 14px;
                border-radius: 3px;
                margin-bottom: clamp(8px,1.5vw,16px);
            }

            .cc-title {
                font-family: var(--fd);
                font-size: clamp(16px, 2.4vw, 34px);
                font-weight: 600;
                color: #fff;
                line-height: 1.2;
                margin-bottom: clamp(6px,1vw,11px);
            }

            .cc-sub {
                font-size: clamp(10px, 1.1vw, 13px);
                color: rgba(255,255,255,.65);
                letter-spacing: .2px;
            }

            .rguhs-carousel .carousel-indicators {
                margin-bottom: clamp(12px, 2vw, 22px);
                gap: 4px;
            }

                .rguhs-carousel .carousel-indicators button {
                    width: clamp(16px, 2vw, 26px);
                    height: 3px;
                    border-radius: 2px;
                    background: rgba(255,255,255,.32);
                    border: none;
                    transition: background .25s, width .25s;
                }

                    .rguhs-carousel .carousel-indicators button.active {
                        background: var(--gold-300);
                        width: clamp(24px, 3.4vw, 44px);
                    }

            .rguhs-ctrl {
                width: clamp(34px,3.6vw,46px);
                opacity: 0;
                transition: opacity .22s;
            }

            .rguhs-carousel:hover .rguhs-ctrl {
                opacity: 1;
            }

            .rguhs-carousel .carousel-control-prev-icon,
            .rguhs-carousel .carousel-control-next-icon {
                background-color: rgba(10,27,51,.55);
                border-radius: 50%;
                padding: 13px;
                background-size: 46%;
                border: 1px solid rgba(255,255,255,.18);
            }

            /* ══════════════ STATS STRIP ══════════════ */
            .stats-strip {
                background: var(--white);
                border-bottom: 1px solid var(--line);
            }

            .stats-inner {
                display: flex;
                padding: 0 40px;
            }

            .stat-item {
                flex: 1;
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 20px 26px;
                border-right: 1px solid var(--line);
                transition: background .2s;
            }

                .stat-item:first-child {
                    padding-left: 0;
                }

                .stat-item:last-child {
                    border-right: none;
                }

                .stat-item:hover {
                    background: var(--paper-alt);
                }

            .stat-icon {
                width: 42px;
                height: 42px;
                border-radius: 10px;
                background: var(--blue-100);
                border: 1px solid var(--blue-200);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

                .stat-icon i {
                    color: var(--navy-700);
                    font-size: 17px;
                }

            .stat-num {
                font-family: var(--fd);
                font-size: 29px;
                color: var(--navy-900);
                font-weight: 600;
                line-height: 1;
                letter-spacing: -.3px;
            }

            .stat-lbl {
                font-size: 9.5px;
                color: var(--ink-400);
                margin-top: 4px;
                letter-spacing: 1.1px;
                text-transform: uppercase;
            }

            /* ══════════════ STREAM SHOWCASE — SLIDESHOW ══════════════ */
            .stream-showcase {
                background: var(--white);
                padding: 40px 40px 44px;
                border-bottom: 1px solid var(--line);
            }

            .stream-showcase-inner {
                max-width: 1500px;
                margin: 0 auto;
            }

            .stream-showcase .sec-head {
                margin-bottom: 24px;
            }

            .stream-carousel {
                position: relative;
                border: 1px solid var(--line);
                border-radius: var(--r-lg);
                background: var(--paper-alt);
                padding: 22px 54px 40px;
                box-shadow: var(--shadow-xs);
            }

            .stream-grid {
                display: grid;
                grid-template-columns: repeat(6, 1fr);
                gap: 14px;
            }

            .stream-card {
                position: relative;
                border-radius: var(--r-lg);
                overflow: hidden;
                aspect-ratio: 4 / 5;
                background: linear-gradient(150deg, var(--navy-800) 0%, var(--navy-600) 100%);
                box-shadow: var(--shadow-xs);
                cursor: default;
                transition: transform .25s cubic-bezier(.22,1,.36,1), box-shadow .25s;
                text-decoration: none;
                display: block;
            }

                .stream-card:hover {
                    transform: translateY(-4px);
                    box-shadow: var(--shadow-md);
                }

                .stream-card img {
                    position: absolute;
                    inset: 0;
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    filter: brightness(.55) saturate(1.05);
                    transition: filter .3s, transform .35s;
                }

                .stream-card:hover img {
                    filter: brightness(.46) saturate(1.12);
                    transform: scale(1.05);
                }

            .stream-overlay {
                position: absolute;
                left: 0;
                right: 0;
                bottom: 0;
                padding: 14px 12px 12px;
                background: linear-gradient(to top, rgba(10,27,51,.94) 10%, rgba(10,27,51,.15) 75%, transparent 100%);
                z-index: 2;
            }

            .stream-icon-badge {
                width: 28px;
                height: 28px;
                border-radius: 7px;
                background: rgba(255,255,255,.14);
                border: 1px solid rgba(255,255,255,.26);
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 8px;
                font-size: 14px;
                line-height: 1;
            }

            .stream-name {
                font-family: var(--fb);
                font-size: 10.5px;
                font-weight: 700;
                color: #fff;
                letter-spacing: .5px;
                text-transform: uppercase;
                line-height: 1.3;
            }

            .stream-tag {
                position: absolute;
                top: 10px;
                right: 10px;
                z-index: 2;
                background: rgba(255,255,255,.92);
                color: var(--navy-900);
                font-size: 8px;
                font-weight: 800;
                letter-spacing: .8px;
                text-transform: uppercase;
                padding: 3px 8px;
                border-radius: 4px;
            }

            /* carousel chrome */
            .stream-carousel .carousel-control-prev,
            .stream-carousel .carousel-control-next {
                width: 40px;
                opacity: 1;
            }

            .stream-carousel .carousel-control-prev-icon,
            .stream-carousel .carousel-control-next-icon {
                background-color: var(--navy-900);
                border-radius: 50%;
                padding: 16px;
                background-size: 42%;
                border: 1px solid var(--navy-900);
                box-shadow: var(--shadow-sm);
            }

            .stream-carousel .carousel-control-prev:hover .carousel-control-prev-icon,
            .stream-carousel .carousel-control-next:hover .carousel-control-next-icon {
                background-color: var(--navy-700);
            }

            .stream-carousel .carousel-indicators {
                bottom: 6px;
                gap: 5px;
                margin-bottom: 0;
            }

                .stream-carousel .carousel-indicators button {
                    width: 22px;
                    height: 3px;
                    border-radius: 2px;
                    background: var(--line-strong);
                    border: none;
                    opacity: 1;
                    transition: background .25s, width .25s;
                }

                    .stream-carousel .carousel-indicators button.active {
                        background: var(--crimson-600);
                        width: 32px;
                    }

            @@media (max-width: 1300px) {
                .stream-grid {
                    grid-template-columns: repeat(4, 1fr);
                }
            }

            @@media (max-width: 767px) {
                .stream-showcase {
                    padding: 28px 16px 32px;
                }

                .stream-carousel {
                    padding: 16px 40px 36px;
                }

                .stream-grid {
                    grid-template-columns: repeat(3, 1fr);
                    gap: 10px;
                }
            }

            @@media (max-width: 480px) {
                .stream-grid {
                    grid-template-columns: repeat(2, 1fr);
                }

                .stream-carousel {
                    padding: 14px 34px 34px;
                }
            }

            /* ══════════════ BODY LAYOUT ══════════════ */
            .body-layout {
                display: flex;
                overflow: hidden;
                width: 100%;
            }

            /* ══════════════ MAIN PANE ══════════════ */
            .main-pane {
                flex: 1;
                min-width: 0;
                overflow-y: auto;
                padding: 32px 32px 60px;
                scrollbar-width: thin;
                scrollbar-color: var(--line-strong) transparent;
            }

                .main-pane::-webkit-scrollbar {
                    width: 5px;
                }

                .main-pane::-webkit-scrollbar-thumb {
                    background: var(--line-strong);
                    border-radius: 4px;
                }

            /* Section heading */
            .sec-head {
                display: flex;
                align-items: center;
                gap: 14px;
                margin-bottom: 22px;
            }

                .sec-head h3 {
                    font-family: var(--fd);
                    font-size: 22px;
                    color: var(--navy-900);
                    font-weight: 600;
                    white-space: nowrap;
                    letter-spacing: .1px;
                }

            .sec-line {
                flex: 1;
                height: 1px;
                background: var(--line);
            }

            .sec-chip {
                background: var(--navy-900);
                color: var(--gold-300);
                font-size: 9px;
                font-weight: 700;
                padding: 4px 13px;
                border-radius: 4px;
                letter-spacing: 1.1px;
                text-transform: uppercase;
                white-space: nowrap;
            }

            /* ── Faculty Chips ── */
            .faculty-scroll {
                display: flex;
                gap: 7px;
                overflow-x: auto;
                padding-bottom: 4px;
                margin-bottom: 22px;
                scrollbar-width: none;
            }

                .faculty-scroll::-webkit-scrollbar {
                    display: none;
                }

            .fac-chip {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 8px 16px;
                border-radius: var(--r);
                border: 1.5px solid var(--line);
                background: var(--white);
                color: var(--ink-700);
                text-decoration: none;
                font-size: 12.5px;
                font-weight: 500;
                white-space: nowrap;
                flex-shrink: 0;
                transition: all .2s;
                box-shadow: var(--shadow-xs);
            }

                .fac-chip:hover {
                    border-color: var(--blue-300);
                    color: var(--navy-700);
                    box-shadow: var(--shadow-sm);
                }

                .fac-chip.active {
                    background: var(--navy-900);
                    border-color: var(--navy-900);
                    color: #fff;
                    box-shadow: var(--shadow-sm);
                }

            .chip-cnt {
                background: rgba(18,22,31,.06);
                border-radius: 4px;
                padding: 1px 7px;
                font-size: 10.5px;
                font-weight: 700;
                font-family: var(--fm);
            }

            .fac-chip.active .chip-cnt {
                background: rgba(255,255,255,.16);
            }

            /* ── Filter Bar ── */
            .filter-bar {
                display: flex;
                gap: 9px;
                align-items: center;
                margin-bottom: 24px;
                flex-wrap: wrap;
            }

            .search-field {
                position: relative;
                flex: 1;
                min-width: 200px;
                max-width: 420px;
            }

                .search-field input {
                    width: 100%;
                    padding: 11px 14px 11px 40px;
                    border: 1.5px solid var(--line);
                    border-radius: var(--r);
                    font-size: 13px;
                    font-family: var(--fb);
                    background: var(--white);
                    color: var(--ink-900);
                    outline: none;
                    box-shadow: var(--shadow-xs);
                    transition: border-color .2s, box-shadow .2s;
                }

                    .search-field input:focus {
                        border-color: var(--blue-300);
                        box-shadow: 0 0 0 3px rgba(59,116,184,.12);
                    }

                    .search-field input::placeholder {
                        color: var(--ink-400);
                    }

                .search-field .si {
                    position: absolute;
                    left: 13px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--ink-400);
                    font-size: 13px;
                    pointer-events: none;
                }

            .btn-srch {
                background: var(--navy-900);
                color: #fff;
                border: none;
                padding: 11px 22px;
                border-radius: var(--r);
                font-size: 13px;
                font-weight: 600;
                font-family: var(--fb);
                cursor: pointer;
                transition: background .2s, transform .15s;
                display: flex;
                align-items: center;
                gap: 6px;
                letter-spacing: .2px;
            }

                .btn-srch:hover {
                    background: var(--navy-700);
                    transform: translateY(-1px);
                }

            .btn-clr {
                background: var(--white);
                color: var(--ink-500);
                border: 1.5px solid var(--line);
                padding: 11px 16px;
                border-radius: var(--r);
                font-size: 13px;
                font-family: var(--fb);
                cursor: pointer;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: border-color .2s, color .2s;
            }

                .btn-clr:hover {
                    border-color: var(--blue-300);
                    color: var(--ink-900);
                }

            .res-badge {
                background: var(--white);
                border: 1px solid var(--line);
                border-radius: var(--r);
                padding: 11px 16px;
                font-size: 12px;
                color: var(--ink-500);
                white-space: nowrap;
                box-shadow: var(--shadow-xs);
                font-family: var(--fm);
            }

                .res-badge strong {
                    color: var(--navy-800);
                    font-weight: 700;
                }

            /* ── College Cards ── */
            .college-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                max-height: 540px;
                overflow-y: auto;
                scroll-behavior: smooth;
                padding-right: 4px;
            }

                .college-grid::-webkit-scrollbar {
                    width: 5px;
                }

                .college-grid::-webkit-scrollbar-thumb {
                    background: var(--line-strong);
                    border-radius: 4px;
                }

            .c-card {
                background: var(--white);
                border: 1px solid var(--line);
                border-radius: var(--r-lg);
                padding: 20px 22px 44px;
                position: relative;
                overflow: hidden;
                box-shadow: var(--shadow-xs);
                transition: transform .22s cubic-bezier(.22,1,.36,1), box-shadow .22s, border-color .22s;
                animation: cardFadeUp .35s ease both;
                cursor: pointer;
            }

                .c-card:hover {
                    transform: translateY(-3px);
                    box-shadow: var(--shadow-md);
                    border-color: var(--line-strong);
                }
                /* Left accent on hover */
                .c-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    bottom: 0;
                    width: 3px;
                    background: var(--crimson-600);
                    opacity: 0;
                    transition: opacity .22s;
                }

                .c-card:hover::before {
                    opacity: 1;
                }

            @@keyframes cardFadeUp {
                from {
                    opacity: 0;
                    transform: translateY(12px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .c-card:nth-child(1) {
                animation-delay: .04s
            }

            .c-card:nth-child(2) {
                animation-delay: .08s
            }

            .c-card:nth-child(3) {
                animation-delay: .12s
            }

            .c-card:nth-child(4) {
                animation-delay: .16s
            }

            .c-card:nth-child(5) {
                animation-delay: .20s
            }

            .c-card:nth-child(6) {
                animation-delay: .24s
            }

            .c-card:nth-child(n+7) {
                animation-delay: .28s
            }

            .c-name {
                font-size: 13px;
                font-weight: 600;
                color: var(--navy-800);
                line-height: 1.55;
                margin-bottom: 12px;
            }

            .c-meta {
                position: absolute;
                bottom: 14px;
                left: 22px;
                right: 22px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 6px;
            }

            .c-town {
                display: flex;
                align-items: center;
                gap: 4px;
                font-size: 10.5px;
                color: var(--ink-500);
            }

                .c-town i {
                    color: var(--blue-400);
                    font-size: 10px;
                }

            .c-fac {
                display: inline-flex;
                align-items: center;
                gap: 3px;
                background: var(--paper-alt);
                border: 1px solid var(--line);
                border-radius: 4px;
                padding: 2px 9px;
                font-size: 10px;
                font-weight: 500;
                color: var(--ink-500);
            }

            .c-arrow {
                position: absolute;
                bottom: 13px;
                right: 18px;
                font-size: 11px;
                color: var(--navy-700);
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 3px;
                opacity: 0;
                transform: translateX(4px);
                transition: opacity .2s, transform .2s;
            }

            .c-card:hover .c-arrow {
                opacity: 1;
                transform: translateX(0);
            }

            .empty-state {
                grid-column: 1/-1;
                text-align: center;
                padding: 64px 20px;
                color: var(--ink-400);
            }

                .empty-state .em-ico {
                    font-size: 44px;
                    opacity: .25;
                    margin-bottom: 14px;
                }

                .empty-state h4 {
                    font-size: 16px;
                    font-weight: 600;
                    margin-bottom: 6px;
                    color: var(--navy-800);
                }

            /* ══════════════ SIDEBAR ══════════════ */
            .side-pane {
                width: 300px;
                flex-shrink: 0;
                background: var(--white);
                border-left: 1px solid var(--line);
                overflow-y: auto;
                scrollbar-width: thin;
                scrollbar-color: var(--line-strong) transparent;
            }

                .side-pane::-webkit-scrollbar {
                    width: 4px;
                }

                .side-pane::-webkit-scrollbar-thumb {
                    background: var(--line-strong);
                    border-radius: 4px;
                }

            .widget {
                border-bottom: 1px solid var(--line);
            }

                .widget:last-child {
                    border-bottom: none;
                }

            .w-head {
                padding: 13px 18px;
                display: flex;
                align-items: center;
                gap: 9px;
                background: var(--paper-alt);
                border-bottom: 1px solid var(--line);
            }

                .w-head h4 {
                    font-family: var(--fd);
                    color: var(--navy-800);
                    font-size: 14.5px;
                    font-weight: 600;
                    letter-spacing: .1px;
                }

                .w-head i {
                    color: var(--navy-700);
                    font-size: 13.5px;
                }

            /* Updates */
            .upd-list {
                list-style: none;
            }

            .upd-item {
                border-bottom: 1px solid var(--line);
                padding: 12px 18px;
                transition: background .14s;
            }

                .upd-item:last-child {
                    border-bottom: none;
                }

                .upd-item:hover {
                    background: var(--paper-alt);
                }

                .upd-item a {
                    display: block;
                    text-decoration: none;
                    color: var(--ink-700);
                    font-size: 12px;
                    line-height: 1.6;
                    font-weight: 500;
                }

                    .upd-item a:hover {
                        color: var(--navy-700);
                    }

            .upd-date {
                font-size: 10px;
                color: var(--ink-400);
                margin-top: 4px;
                display: flex;
                align-items: center;
                gap: 4px;
            }

            .u-tag {
                display: inline-block;
                font-size: 8.5px;
                font-weight: 700;
                padding: 2px 7px;
                border-radius: 3px;
                letter-spacing: .7px;
                margin-bottom: 5px;
                text-transform: uppercase;
            }

            .tag-new {
                background: var(--crimson-100);
                color: var(--crimson-700);
                border: 1px solid #e8c3c8;
            }

            .tag-imp {
                background: var(--gold-100);
                color: var(--gold-600);
                border: 1px solid #e4cf9a;
            }

            .tag-info {
                background: var(--blue-100);
                color: var(--navy-700);
                border: 1px solid var(--blue-200);
            }

            /* Quick links */
            .qlink-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 1px;
                background: var(--line);
            }

            .qlink {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 6px;
                padding: 15px 8px;
                background: var(--white);
                text-decoration: none;
                color: var(--ink-700);
                font-size: 10.5px;
                font-weight: 600;
                text-align: center;
                transition: background .14s, color .14s;
            }

                .qlink:hover {
                    background: var(--paper-alt);
                    color: var(--navy-700);
                }

                .qlink i {
                    font-size: 20px;
                    color: var(--navy-700);
                }

            /* Helpline */
            .hl-body {
                padding: 14px 18px;
                display: flex;
                flex-direction: column;
                gap: 13px;
            }

            .hl-row {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .hl-icon {
                width: 34px;
                height: 34px;
                border-radius: 9px;
                background: var(--paper-alt);
                border: 1px solid var(--line);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

                .hl-icon i {
                    font-size: 13px;
                    color: var(--navy-700);
                }

            .hl-lbl {
                font-size: 9.5px;
                color: var(--ink-400);
                margin-bottom: 2px;
                letter-spacing: .4px;
            }

            .hl-val {
                font-size: 12px;
                font-weight: 600;
                color: var(--navy-800);
            }

                .hl-val a {
                    color: var(--navy-600);
                    text-decoration: none;
                }

                    .hl-val a:hover {
                        text-decoration: underline;
                    }

            /* ══════════════ MODAL ══════════════ */
            .modal-course-header {
                background: var(--navy-900);
                border: none;
                padding: 24px 28px;
            }

            .modal-summary-strip {
                display: flex;
                border-bottom: 1px solid var(--line);
                background: var(--paper-alt);
            }

            .modal-summary-pill {
                flex: 1;
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 17px 24px;
                border-right: 1px solid var(--line);
            }

                .modal-summary-pill:last-child {
                    border-right: none;
                }

            .msp-icon {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                background: var(--navy-900);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

                .msp-icon i {
                    color: var(--gold-300);
                    font-size: 16px;
                }

            .msp-num {
                font-family: var(--fd);
                font-size: 25px;
                font-weight: 600;
                color: var(--navy-800);
                line-height: 1;
            }

            .msp-lbl {
                font-size: 9px;
                color: var(--ink-400);
                letter-spacing: 1.1px;
                text-transform: uppercase;
                margin-top: 3px;
            }

            .course-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 12.5px;
            }

                .course-table thead tr {
                    background: var(--navy-900);
                }

                .course-table thead th {
                    padding: 11px 15px;
                    color: rgba(255,255,255,.65);
                    font-size: 9.5px;
                    font-weight: 700;
                    letter-spacing: 1px;
                    text-transform: uppercase;
                    border: none;
                    white-space: nowrap;
                }

                    .course-table thead th:last-child {
                        text-align: center;
                    }

                .course-table tbody tr {
                    border-bottom: 1px solid var(--line);
                    transition: background .12s;
                }

                    .course-table tbody tr:last-child {
                        border-bottom: none;
                    }

                    .course-table tbody tr:nth-child(even) {
                        background: var(--paper-alt);
                    }

                    .course-table tbody tr:nth-child(odd) {
                        background: var(--white);
                    }

                    .course-table tbody tr:hover {
                        background: var(--blue-100);
                    }

                .course-table tbody td {
                    padding: 11px 15px;
                    color: var(--ink-700);
                    vertical-align: middle;
                }

            .td-num {
                color: var(--ink-400);
                font-size: 11px;
                width: 36px;
                font-family: var(--fm);
            }

            .col-course-code {
                display: none;
            }

            .td-code {
                font-family: var(--fm);
                font-size: 10.5px;
                color: var(--navy-700);
                background: var(--blue-100);
                padding: 3px 9px;
                border-radius: 4px;
                white-space: nowrap;
                display: inline-block;
                border: 1px solid var(--blue-200);
            }

            .intake-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 44px;
                height: 28px;
                border-radius: 6px;
                font-size: 13px;
                font-weight: 700;
                font-family: var(--fm);
            }

            .intake-badge-filled {
                background: var(--blue-100);
                color: var(--navy-700);
                border: 1px solid var(--blue-200);
            }

            .intake-badge-zero {
                background: var(--paper-alt);
                color: var(--ink-400);
                border: 1px solid var(--line);
            }

            /* ══════════════ FOOTER ══════════════ */
            .site-footer {
                background: var(--navy-950);
                border-top: 3px solid var(--gold-300);
            }

            .footer-grid {
                padding: 38px 40px 24px;
                display: grid;
                grid-template-columns: 2.2fr 1fr 1fr 1fr;
                gap: 32px;
            }

            .foot-brand {
                display: flex;
                align-items: center;
                gap: 13px;
                margin-bottom: 13px;
            }

            .foot-monogram {
                width: 48px;
                height: 48px;
                border-radius: 11px;
                background: rgba(203,162,74,.12);
                border: 1px solid rgba(203,162,74,.28);
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: var(--fd);
                font-size: 18px;
                color: var(--gold-300);
                font-weight: 700;
                flex-shrink: 0;
            }

            .foot-name {
                font-family: var(--fd);
                color: #fff;
                font-size: 14px;
                line-height: 1.3;
                font-weight: 500;
            }

                .foot-name span {
                    display: block;
                    font-size: 10px;
                    color: rgba(255,255,255,.4);
                    font-family: var(--fb);
                    margin-top: 3px;
                    letter-spacing: .3px;
                }

            .foot-desc {
                font-size: 11.5px;
                color: rgba(255,255,255,.45);
                line-height: 1.85;
            }

            .foot-col h5 {
                font-size: 9.5px;
                font-weight: 700;
                color: var(--gold-300);
                letter-spacing: 1.6px;
                text-transform: uppercase;
                margin-bottom: 14px;
                padding-bottom: 9px;
                border-bottom: 1px solid rgba(203,162,74,.2);
            }

            .foot-col ul {
                list-style: none;
                display: flex;
                flex-direction: column;
                gap: 9px;
            }

                .foot-col ul li a {
                    color: rgba(255,255,255,.5);
                    text-decoration: none;
                    font-size: 12px;
                    transition: color .18s;
                    display: flex;
                    align-items: center;
                    gap: 7px;
                }

                    .foot-col ul li a::before {
                        content: '';
                        display: block;
                        width: 3px;
                        height: 3px;
                        border-radius: 50%;
                        background: rgba(203,162,74,.45);
                        flex-shrink: 0;
                    }

                    .foot-col ul li a:hover {
                        color: var(--gold-300);
                    }

            .footer-bar {
                padding: 14px 40px;
                border-top: 1px solid rgba(255,255,255,.08);
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 14px;
                flex-wrap: wrap;
            }

                .footer-bar p {
                    font-size: 10.5px;
                    color: rgba(255,255,255,.35);
                }

                .footer-bar a {
                    color: var(--gold-300);
                    text-decoration: none;
                }

                    .footer-bar a:hover {
                        text-decoration: underline;
                    }

            /* ══════════════ RESPONSIVE ══════════════ */
            @@media (min-width: 1400px) {
                .header-inner, .stats-inner, .footer-grid, .footer-bar {
                    padding-left: 60px;
                    padding-right: 60px;
                }

                .main-pane {
                    padding: 36px 38px 64px;
                }

                .util-inner {
                    padding: 0 60px;
                }
            }

            @@media (max-width: 1199px) {
                .body-layout {
                    flex-direction: column;
                    height: auto !important;
                    overflow: visible;
                }

                .main-pane {
                    overflow: visible;
                }

                .side-pane {
                    width: 100%;
                    border-left: none;
                    border-top: 1px solid var(--line);
                    overflow: visible;
                }

                .footer-grid {
                    grid-template-columns: 1fr 1fr;
                }

                .stats-inner {
                    padding: 0 24px;
                }

                .college-grid {
                    grid-template-columns: 1fr 1fr 1fr;
                }
            }

            @@media (max-width: 991px) {
                .header-inner {
                    padding: 16px 20px;
                    flex-wrap: wrap;
                }

                .university-logo {
                    height: 58px;
                }

                .univ-name {
                    font-size: 18px;
                }

                .univ-sub {
                    display: none;
                }

                .stats-inner {
                    flex-wrap: wrap;
                    padding: 0 20px;
                }

                .stat-item {
                    min-width: 45%;
                    border-bottom: 1px solid var(--line);
                }

                .footer-grid {
                    padding: 24px 20px;
                }

                .footer-bar {
                    padding: 12px 20px;
                }

                .college-grid {
                    grid-template-columns: 1fr 1fr;
                }

                .modal-summary-strip {
                    flex-wrap: wrap;
                }

                .modal-summary-pill {
                    min-width: 50%;
                    border-bottom: 1px solid var(--line);
                }
            }

            @@media (max-width: 767px) {
                .util-inner {
                    padding: 0 16px;
                }

                .util-links a span {
                    display: none;
                }

                .header-inner {
                    padding: 14px 16px;
                }

                .university-logo {
                    height: 52px;
                }

                .univ-name {
                    font-size: 16px;
                }

                .main-pane {
                    padding: 20px 14px 48px;
                }

                .college-grid {
                    grid-template-columns: 1fr;
                    max-height: none;
                }

                .footer-grid {
                    grid-template-columns: 1fr;
                    padding: 20px 16px;
                }

                .footer-bar {
                    padding: 12px 16px;
                    flex-direction: column;
                    align-items: flex-start;
                }

                .carousel-img {
                    height: clamp(170px,50vw,280px);
                }
            }

            @@media (max-width: 599px) {
                .header-inner {
                    flex-direction: column;
                    align-items: center;
                    text-align: center;
                    padding: 18px 16px;
                }

                .header-rule {
                    display: none;
                }

                .university-logo {
                    height: 64px;
                }

                .univ-name {
                    font-size: 17px;
                    text-align: center;
                }

                .univ-sub {
                    display: flex;
                    justify-content: center;
                    font-size: 10px;
                }

                .header-badges {
                    justify-content: center;
                }

                .header-cta {
                    width: 100%;
                    align-items: center;
                }

                .btn-portal {
                    width: 100%;
                    justify-content: center;
                    font-size: 14px;
                    padding: 13px 20px;
                }

                .stats-inner {
                    flex-direction: column;
                }

                .stat-item {
                    width: 100%;
                    border-right: none;
                }
            }
    </style>
</head>
<body>

    <!-- ════ UTILITY BAR ════ -->
    <div class="util-bar">
        <div class="util-inner">
            <div class="util-links">
                <a href="https://www.rguhs.ac.in" target="_blank"><i class="bi bi-globe2"></i><span>www.rguhs.ac.in</span></a>
                <a href="https://rguhs.karnataka.gov.in/rguhsec/" target="_blank"><i class="bi bi-file-earmark-check"></i><span>Eligibility Certificate</span></a>
                <a href="https://rguhs.karnataka.gov.in/rguhs_online/" target="_blank"><i class="bi bi-bar-chart-line"></i><span>Results Portal</span></a>
                <a href="https://www.rguhs.ac.in/notification_circulars_rguhs.html" target="_blank"><i class="bi bi-bell"></i><span>Notifications</span></a>
                <a href="https://www.rguhs.ac.in" target="_blank"><i class="bi bi-headset"></i><span>Help Desk</span></a>
            </div>
