                        <div class="count" aria-live="polite"><b id="countNum">@Model.Colleges.Count</b> <span id="countTxt">college@(Model.Colleges.Count != 1 ? "s" : "") found</span></div>
                    </form>

                    <div class="grid" id="collegeGrid">
                        @if (Model.Colleges.Count == 0)
                        {
                            <div class="empty">
                                <i class="bi bi-search"></i>
