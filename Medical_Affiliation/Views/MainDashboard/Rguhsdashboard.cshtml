    <!-- ════ COLLEGE COURSES MODAL ════ -->
    <div class="modal fade" id="collegeModal" tabindex="-1" aria-labelledby="collegeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content" style="border:none;border-radius:16px;overflow:hidden;box-shadow:var(--shadow-lg);">

                <div class="modal-header modal-course-header">
                    <div style="flex:1;min-width:0;">
                        <div style="font-size:9px;color:rgba(255,255,255,.5);letter-spacing:2px;text-transform:uppercase;margin-bottom:7px;display:flex;align-items:center;gap:6px;">
                            <i class="bi bi-building"></i> Affiliated College &nbsp;·&nbsp; RGUHS Karnataka
                        </div>
                        <h5 class="modal-title" id="collegeModalLabel"
                            style="font-family:'Source Serif 4',Georgia,serif;color:#fff;font-size:21px;font-weight:600;line-height:1.3;margin:0;letter-spacing:.1px;">
                            —
                        </h5>
                        <div id="modalMeta" style="font-size:11.5px;color:rgba(255,255,255,.55);margin-top:8px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;"></div>
                    </div>
                    <button type="button" class="btn-close btn-close-white ms-3" data-bs-dismiss="modal" aria-label="Close" style="opacity:.55;flex-shrink:0;"></button>
                </div>

                <div class="modal-summary-strip" id="modalSummary"></div>

                <div class="modal-body" style="padding:0;">
                    <div style="padding:24px 28px 28px;">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:8px;">
                            <div style="font-family:'Source Serif 4',Georgia,serif;font-size:17px;font-weight:600;color:var(--navy-900);display:flex;align-items:center;gap:9px;letter-spacing:.1px;">
                                <i class="bi bi-journal-bookmark-fill" style="color:var(--navy-700);font-size:15px;"></i>
                                Courses &amp; Intake Details
                            </div>
                            <div id="modalCourseCount"
                                 style="background:var(--navy-900);color:var(--gold-300);font-size:9px;font-weight:700;padding:4px 14px;border-radius:4px;letter-spacing:1.2px;"></div>
                        </div>

                        <div id="modalSpinner" class="text-center py-5">
                            <div class="spinner-border" role="status"
                                 style="width:2.2rem;height:2.2rem;border-width:.2em;color:var(--navy-700);">
                                <span class="visually-hidden">Loading…</span>
                            </div>
                            <div style="font-size:12px;color:var(--ink-400);margin-top:14px;letter-spacing:.3px;">Fetching course data…</div>
                        </div>

                        <div id="modalError" style="display:none;text-align:center;padding:44px 0;">
                            <div style="font-size:36px;color:var(--red);opacity:.5;margin-bottom:14px;"><i class="bi bi-exclamation-triangle"></i></div>
                            <div style="font-size:14px;font-weight:600;color:var(--navy-900);margin-bottom:5px;">Could not load data</div>
                            <div style="font-size:12px;color:var(--ink-400);">Please check your connection and try again.</div>
                        </div>

                        <div id="modalEmpty" style="display:none;text-align:center;padding:44px 0;">
                            <div style="font-size:36px;color:var(--ink-300);margin-bottom:14px;"><i class="bi bi-inbox"></i></div>
                            <div style="font-size:14px;font-weight:600;color:var(--navy-900);margin-bottom:5px;">No courses found</div>
                            <div style="font-size:12px;color:var(--ink-400);">No course records are available for this college.</div>
                        </div>

                        <div id="modalTableWrap" style="display:none;overflow-x:auto;border-radius:10px;border:1px solid var(--line);box-shadow:var(--shadow-sm);">
                            <table class="course-table">
                                <thead>
                                    <tr>
                                        <th style="width:40px;">Sl.</th>
                                        <th class="col-course-code">Code</th>
                                        <th>Course Name</th>
                                        <th style="width:120px;text-align:center;">Intake</th>
                                    </tr>
                                </thead>
                                <tbody id="modalTableBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="modal-footer" style="border-top:1px solid var(--line);padding:13px 28px;background:var(--paper-alt);justify-content:space-between;flex-wrap:wrap;gap:8px;">
                    <div style="font-size:10.5px;color:var(--ink-400);display:flex;align-items:center;gap:5px;">
                        <i class="bi bi-shield-check" style="color:var(--navy-700);"></i>
                        Data sourced from RGUHS Affiliation Records
                    </div>
                    <button type="button" class="btn-clr" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script>
        /* ── Live clock ── */
        function tick() {
        var el = document.getElementById('liveClock');
        if (!el) return;
        var now = new Date();
        el.textContent =
        now.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) + '  ' +
        now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        }
        tick(); setInterval(tick, 1000);

        /* ── Body layout height (desktop) ── */
        function fitLayout() {
        var bl = document.getElementById('bodyLayout');
        if (!bl) return;
        if (window.innerWidth < 1200) { bl.style.height = 'auto'; return; }
        var offsetTop = bl.getBoundingClientRect().top + window.scrollY;
        var footerH   = document.querySelector('.site-footer').offsetHeight;
        var totalH    = document.documentElement.scrollHeight;
        bl.style.height = (totalH - offsetTop - footerH) + 'px';
        }
        fitLayout();
        window.addEventListener('resize', fitLayout);

        /* ── College modal ── */
        var _modal = new bootstrap.Modal(document.getElementById('collegeModal'));
        var _collegeCoursesUrl = '@Url.Action("CollegeCourses", "MainDashboard")';

        function openCollegeModal(code, name, town, faculty) {
        document.getElementById('collegeModalLabel').textContent = name;
        document.getElementById('modalMeta').innerHTML =
        '<span style="display:inline-flex;align-items:center;gap:4px;"><i class="bi bi-geo-alt-fill" style="color:#9fbedd;font-size:10px;"></i>' + town + '</span>' +
        '<span style="opacity:.35;">·</span>' +
        '<span style="display:inline-flex;align-items:center;gap:4px;"><i class="bi bi-mortarboard-fill" style="color:#9fbedd;font-size:10px;"></i>' + faculty + '</span>';

        document.getElementById('modalSummary').innerHTML       = '';
        document.getElementById('modalSpinner').style.display   = 'block';
        document.getElementById('modalError').style.display     = 'none';
        document.getElementById('modalEmpty').style.display     = 'none';
        document.getElementById('modalTableWrap').style.display = 'none';
        document.getElementById('modalCourseCount').textContent = '';

        _modal.show();

        fetch(_collegeCoursesUrl + '?collegeCode=' + encodeURIComponent(code))
        .then(function(res) { if (!res.ok) throw new Error('HTTP ' + res.status); return res.json(); })
        .then(function(data) {
        document.getElementById('modalSpinner').style.display = 'none';
        if (!data || data.length === 0) {
        document.getElementById('modalEmpty').style.display = 'block'; return;
        }
        var totalIntake = data.reduce(function(s,x) { return s + (x.existingIntake || 0); }, 0);
        document.getElementById('modalSummary').innerHTML =
        makePill('bi-journal-bookmark-fill', data.length, 'Total Courses') +
        makePill('bi-people-fill', totalIntake, 'Total Intake');
        document.getElementById('modalCourseCount').textContent = data.length + ' COURSE' + (data.length !== 1 ? 'S' : '');

        var rows = data.map(function(row, i) {
        var intake = (row.existingIntake !== null && row.existingIntake !== undefined) ? row.existingIntake : null;
        var cell = intake !== null && intake > 0
        ? '<span class="intake-badge intake-badge-filled">' + intake + '</span>'
        : '<span class="intake-badge intake-badge-zero">—</span>';
        return '<tr>' +
        '<td class="td-num">' + (i+1) + '</td>' +
        '<td class="col-course-code"><span class="td-code">' + (row.courseCode||'—') + '</span></td>' +
        '<td style="font-weight:500;line-height:1.6;color:var(--ink-700);">' + (row.courseName||'—') + '</td>' +
        '<td style="text-align:center;">' + cell + '</td>' +
        '</tr>';
        }).join('');

        document.getElementById('modalTableBody').innerHTML = rows;
        document.getElementById('modalTableWrap').style.display = 'block';
        })
        .catch(function() {
        document.getElementById('modalSpinner').style.display = 'none';
        document.getElementById('modalError').style.display   = 'block';
        });
        }

        function makePill(icon, value, label) {
        return '<div class="modal-summary-pill">' +
        '<div class="msp-icon"><i class="bi ' + icon + '"></i></div>' +
        '<div><div class="msp-num">' + value + '</div><div class="msp-lbl">' + label + '</div></div>' +
        '</div>';
        }
    </script>
</body>
</html>
