@using static Medical_Affiliation.Controllers.MainDashboardController
@model RguhsDashboardViewModel
@{
    ViewData["Title"] = "RGUHS – College Details Portal";
    Layout = null;
    bool allActive = Model.ActiveFaculty == "ALL";
    string allUrl = Url.Action("Rguhsdashboard", new { faculty = "ALL", search = Model.SearchTerm }) + "#colleges";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Rajiv Gandhi University of Health Sciences – Affiliated College Details Portal" />
    <title>RGUHS – College Details | Karnataka</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
            :root {
                --navy: #0b2a6f;
                --navy-d: #061a4a;
                --royal: #2563eb;
                --gold: #f5b301;
                --gold-2: #fcd34d;
                --gold-d: #a87500;
                --ink: #0b1220;
                --text: #1e293b;
                --sub: #52607a;
                --muted: #8a97ae;
                --line: rgba(15,35,90,.10);
                --glass: rgba(255,255,255,.80);
                --bg: #eef2f9;
                --green: #059669;
                --red: #e11d48;
                --ease: cubic-bezier(.22,.8,.3,1);
                --fd: 'Plus Jakarta Sans', system-ui, sans-serif;
                --fb: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
                --sh: 0 1px 2px rgba(11,42,111,.05), 0 10px 30px -10px rgba(11,42,111,.18);
                --sh-lg: 0 2px 4px rgba(11,42,111,.06), 0 24px 50px -16px rgba(11,42,111,.30);
            }

            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0
            }

            [hidden] {
                display: none !important
            }

            html {
                scroll-behavior: smooth;
                font-size: 15px
            }

            body {
                font-family: var(--fb);
                color: var(--text);
                background: var(--bg);
                -webkit-font-smoothing: antialiased;
                overflow-x: hidden;
                line-height: 1.5
            }

            a {
                color: inherit
            }

            :focus-visible {
                outline: 3px solid var(--gold);
                outline-offset: 2px;
                border-radius: 6px
            }

            .wrap {
                max-width: 1400px;
                margin: 0 auto;
                padding: 0 28px
            }

            /* ═══ LOGO WATERMARK (whole page) ═══ */
            .wm {
                position: fixed;
                inset: 0;
                display: grid;
                place-items: center;
                pointer-events: none;
                z-index: 0
            }

                .wm img {
                    width: min(70vw, 720px);
                    opacity: .08;
                    mix-blend-mode: multiply;
                    filter: saturate(.8)
                }

                .wm::after {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: radial-gradient(60% 50% at 50% 50%, transparent 40%, var(--bg) 100%);
                    opacity: .55
                }

            header, section, main, footer, .ann {
                position: relative;
                z-index: 1
            }

            /* ═══ HEADER (floating glass) ═══ */
            .top {
                position: sticky;
                top: 0;
                z-index: 50;
                padding: 12px 0 0
            }

            .top-bar {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 10px 12px 10px 14px;
                background: var(--glass);
                backdrop-filter: blur(18px) saturate(1.4);
                -webkit-backdrop-filter: blur(18px) saturate(1.4);
                border: 1px solid rgba(255,255,255,.9);
                border-radius: 20px;
                box-shadow: var(--sh)
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                min-width: 0
            }

            .brand-logo {
                width: 46px;
                height: 46px;
                border-radius: 14px;
                background: #fff;
                border: 1px solid var(--line);
                display: grid;
                place-items: center;
                overflow: hidden;
                flex-shrink: 0;
                box-shadow: 0 0 0 3px rgba(245,179,1,.22)
            }

                .brand-logo img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain
                }

            .brand small {
                display: block;
                font-size: 11px;
                font-weight: 600;
                color: var(--gold-d)
            }

            .brand b {
                display: block;
                font: 800 16px/1.2 var(--fd);
                color: var(--navy);
                letter-spacing: -.2px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis
            }

            .nav {
                display: flex;
                gap: 2px;
                margin-left: auto
            }

                .nav a {
                    text-decoration: none;
                    font-size: 13px;
                    font-weight: 500;
                    color: var(--sub);
                    padding: 9px 13px;
                    border-radius: 999px;
                    transition: all .2s var(--ease);
                    white-space: nowrap
                }

                    .nav a:hover {
                        background: #eaf0ff;
                        color: var(--navy)
                    }

            .btn-login {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                flex-shrink: 0;
                background: linear-gradient(135deg, var(--navy), var(--royal));
                color: #fff;
                font-size: 13px;
                font-weight: 700;
                text-decoration: none;
                padding: 11px 20px;
                border-radius: 999px;
                box-shadow: 0 10px 22px -6px rgba(37,99,235,.55);
                transition: transform .25s var(--ease), box-shadow .25s var(--ease)
            }

                .btn-login:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 16px 28px -6px rgba(37,99,235,.65)
                }

                .btn-login i {
                    color: var(--gold-2)
                }

            /* ═══ ANNOUNCEMENT ═══ */
            .ann {
                margin-top: 12px
            }

            .ann-box {
                display: flex;
                height: 42px;
                border-radius: 14px;
                overflow: hidden;
                background: var(--glass);
                backdrop-filter: blur(14px);
                -webkit-backdrop-filter: blur(14px);
                border: 1px solid rgba(255,255,255,.9);
                box-shadow: var(--sh)
            }

            .ann-l {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 0 18px;
                background: linear-gradient(135deg, var(--gold), var(--gold-2));
                color: var(--navy);
                font: 800 12px var(--fd);
                flex-shrink: 0
            }

                .ann-l .dot {
                    width: 7px;
                    height: 7px;
                    border-radius: 50%;
                    background: var(--navy);
                    animation: blink 1.3s ease-in-out infinite
                }

            .ann-track {
                flex: 1;
                overflow: hidden;
                display: flex;
                align-items: center
            }

            .ann-in {
                display: flex;
                white-space: nowrap;
                animation: scroll 55s linear infinite
            }

                .ann-in:hover {
                    animation-play-state: paused
                }

                .ann-in a {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    padding-right: 64px;
                    font-size: 12.5px;
                    font-weight: 500;
                    color: var(--text);
                    text-decoration: none
                }

                    .ann-in a i {
                        color: var(--royal)
                    }

                    .ann-in a:hover {
                        color: var(--royal)
                    }

            @@keyframes blink {
                50% {
                    opacity: .2
                }
            }

            @@keyframes scroll {
                to {
                    transform: translateX(-50%)
                }
            }

            /* ═══ HERO ═══ */
            .hero {
                margin-top: 12px
            }

            .hero-card {
                position: relative;
                isolation: isolate;
                overflow: hidden;
                border-radius: 34px;
                color: #fff;
                padding: 52px;
                display: grid;
                grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
                gap: 44px;
                align-items: center;
                background: linear-gradient(135deg, #051642, #0b2a6f 58%, #12399a);
                box-shadow: var(--sh-lg)
            }

            .aur {
                position: absolute;
                inset: 0;
                z-index: -1;
                overflow: hidden;
                pointer-events: none
            }

                .aur span {
                    position: absolute;
                    border-radius: 50%;
                    filter: blur(70px);
                    opacity: .55;
                    animation: drift 16s ease-in-out infinite alternate
                }

                    .aur span:nth-child(1) {
                        width: 420px;
                        height: 420px;
                        right: -80px;
                        top: -140px;
                        background: #3b82f6
                    }

                    .aur span:nth-child(2) {
                        width: 340px;
                        height: 340px;
                        left: -90px;
                        bottom: -150px;
                        background: #f5b301;
                        opacity: .30;
                        animation-delay: -6s
                    }

                    .aur span:nth-child(3) {
                        width: 260px;
                        height: 260px;
                        left: 42%;
                        top: 55%;
                        background: #7c3aed;
                        opacity: .28;
                        animation-delay: -11s
                    }

                .aur::after {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background-image: linear-gradient(rgba(255,255,255,.055) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.055) 1px, transparent 1px);
                    background-size: 44px 44px;
                    -webkit-mask-image: radial-gradient(80% 90% at 70% 30%, #000 20%, transparent 75%);
                    mask-image: radial-gradient(80% 90% at 70% 30%, #000 20%, transparent 75%)
                }

            @@keyframes drift {
                to {
                    transform: translate(50px, 36px) scale(1.15)
                }
            }

            .hero-top {
                display: flex;
                align-items: center;
                gap: 10px;
                flex-wrap: wrap
            }

            .badge {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-size: 12px;
                font-weight: 600;
                padding: 7px 15px;
                border-radius: 999px;
                background: rgba(255,255,255,.10);
                border: 1px solid rgba(255,255,255,.26);
                color: var(--gold-2);
                backdrop-filter: blur(8px)
            }

                .badge.alt {
                    color: #fff;
                    background: rgba(255,255,255,.06)
                }

            .hero h1 {
                font: 800 clamp(30px, 4.2vw, 54px)/1.06 var(--fd);
                letter-spacing: -1.6px;
                margin-top: 22px;
                max-width: 640px
            }

                .hero h1 span {
                    background: linear-gradient(90deg, var(--gold), var(--gold-2));
                    -webkit-background-clip: text;
                    background-clip: text;
                    color: transparent
                }

            .hero-l > p {
                margin-top: 16px;
                max-width: 540px;
                color: rgba(255,255,255,.76);
                font-size: 15.5px;
                line-height: 1.7
            }

            .hs {
                display: grid;
                grid-template-columns: minmax(0, 1fr) auto auto;
                align-items: center;
                margin-top: 28px;
                max-width: 660px;
                background: #fff;
                border-radius: 20px;
                padding: 6px;
                box-shadow: 0 28px 56px -14px rgba(0,0,0,.55), 0 0 0 4px rgba(255,255,255,.10)
            }

            .hs-field {
                display: flex;
                align-items: center;
                gap: 10px;
                padding-left: 16px;
                color: var(--muted);
                min-width: 0
            }

                .hs-field input {
                    flex: 1;
                    min-width: 0;
                    border: 0;
                    outline: 0;
                    background: transparent;
                    font: 500 14.5px var(--fb);
                    color: var(--ink);
                    padding: 14px 4px
                }

            .hs-sel {
                position: relative;
                display: flex;
                align-items: center;
                height: 44px;
                margin: 0 6px;
                padding-left: 14px;
                border-left: 1px solid var(--line);
                color: var(--sub)
            }

                .hs-sel select {
                    appearance: none;
                    -webkit-appearance: none;
                    border: 0;
                    outline: 0;
                    background: transparent;
                    font: 600 13px var(--fb);
                    color: var(--navy);
                    padding: 0 26px 0 8px;
                    max-width: 170px;
                    text-overflow: ellipsis;
                    cursor: pointer
                }

                .hs-sel::after {
                    content: '\F282';
                    font-family: 'bootstrap-icons';
                    position: absolute;
                    right: 6px;
                    font-size: 11px;
                    pointer-events: none
                }

            .hs button {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                border: 0;
                cursor: pointer;
                font: 700 13.5px var(--fb);
                color: var(--navy);
                background: linear-gradient(135deg, var(--gold), var(--gold-2));
                padding: 14px 24px;
                border-radius: 15px;
                transition: transform .2s var(--ease), box-shadow .2s var(--ease)
            }

                .hs button:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 10px 20px -6px rgba(245,179,1,.7)
                }

            .pop {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-wrap: wrap;
                margin-top: 18px;
                font-size: 12.5px;
                color: rgba(255,255,255,.62)
            }

                .pop a {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    text-decoration: none;
                    color: #fff;
                    font-weight: 500;
                    padding: 6px 13px;
                    border-radius: 999px;
                    background: rgba(255,255,255,.09);
                    border: 1px solid rgba(255,255,255,.18);
                    transition: all .2s var(--ease)
                }

                    .pop a:hover {
                        background: var(--gold);
                        border-color: var(--gold);
                        color: var(--navy);
                        transform: translateY(-2px)
                    }

            .trust {
                display: flex;
                flex-wrap: wrap;
                gap: 8px 22px;
                margin-top: 24px;
                padding-top: 20px;
                border-top: 1px solid rgba(255,255,255,.14);
                max-width: 660px
            }

                .trust span {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    font-size: 12.5px;
                    color: rgba(255,255,255,.72)
                }

                .trust i {
                    color: var(--gold-2)
                }

            .glance {
                position: relative;
                padding: 26px;
                border-radius: 28px;
                background: linear-gradient(160deg, rgba(255,255,255,.16), rgba(255,255,255,.05));
                border: 1px solid rgba(255,255,255,.26);
                backdrop-filter: blur(20px) saturate(1.3);
                -webkit-backdrop-filter: blur(20px) saturate(1.3);
                box-shadow: inset 0 1px 0 rgba(255,255,255,.3), 0 30px 60px -20px rgba(0,0,0,.5)
            }

            .gl-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                font: 700 13px var(--fd);
                color: rgba(255,255,255,.85)
            }

                .gl-head em {
                    display: inline-flex;
                    align-items: center;
                    gap: 7px;
                    font: 600 11.5px var(--fb);
                    color: #86efac;
                    font-style: normal
                }

                    .gl-head em::before {
                        content: '';
                        width: 7px;
                        height: 7px;
                        border-radius: 50%;
                        background: #4ade80;
                        box-shadow: 0 0 0 4px rgba(74,222,128,.25);
                        animation: blink 1.6s ease-in-out infinite
                    }

            .gl-num {
                display: flex;
                align-items: flex-end;
                gap: 14px;
                margin-top: 18px
            }

                .gl-num b {
                    font: 800 clamp(48px, 6vw, 72px)/.9 var(--fd);
                    letter-spacing: -3px;
                    font-variant-numeric: tabular-nums;
                    background: linear-gradient(180deg, #fff, #cfe0ff);
                    -webkit-background-clip: text;
                    background-clip: text;
                    color: transparent
                }

                .gl-num span {
                    font-size: 13px;
                    line-height: 1.35;
                    color: rgba(255,255,255,.7);
                    padding-bottom: 6px
                }

            .gl-mini {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 10px;
                margin-top: 20px
            }

                .gl-mini div {
                    display: flex;
                    align-items: center;
                    gap: 11px;
                    padding: 12px 14px;
                    border-radius: 16px;
                    background: rgba(255,255,255,.08);
                    border: 1px solid rgba(255,255,255,.14)
                }

                .gl-mini i {
                    width: 34px;
                    height: 34px;
                    display: grid;
                    place-items: center;
                    border-radius: 11px;
                    background: rgba(252,211,77,.18);
                    color: var(--gold-2);
                    font-size: 15px;
                    flex-shrink: 0
                }

                .gl-mini b {
                    display: block;
                    font: 800 17px/1.1 var(--fd)
                }

                .gl-mini small {
                    font-size: 11px;
                    color: rgba(255,255,255,.62)
                }

            .gl-list {
                margin-top: 20px;
                display: flex;
                flex-direction: column;
                gap: 4px
            }

                .gl-list h4 {
                    font: 600 11.5px var(--fb);
                    color: rgba(255,255,255,.55);
                    margin-bottom: 6px
                }

            .gl-row {
                display: grid;
                grid-template-columns: 26px minmax(0, 1fr) auto;
                gap: 4px 10px;
                align-items: center;
                padding: 8px 10px;
                margin: 0 -10px;
                border-radius: 12px;
                text-decoration: none;
                transition: background .2s
            }

                .gl-row:hover {
                    background: rgba(255,255,255,.10)
                }

                .gl-row .ic {
                    grid-row: span 2;
                    font-size: 17px;
                    text-align: center
                }

                .gl-row .nm {
                    font-size: 12.5px;
                    font-weight: 600;
                    color: #fff;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis
                }

                .gl-row .ct {
                    font: 700 12px var(--fb);
                    color: var(--gold-2);
                    font-variant-numeric: tabular-nums
                }

            .bar {
                grid-column: 2 / -1;
                height: 5px;
                border-radius: 999px;
                background: rgba(255,255,255,.12);
                overflow: hidden
            }

                .bar i {
                    display: block;
                    height: 100%;
                    width: var(--w);
                    border-radius: inherit;
                    background: linear-gradient(90deg, var(--gold), var(--gold-2));
                    animation: grow 1.1s var(--ease) .3s both
                }

            @@keyframes grow {
                from {
                    width: 0
                }
            }

            @@media (max-width: 1100px) {
                .hero-card {
                    grid-template-columns: 1fr;
                    padding: 40px 32px;
                    gap: 34px
                }
            }

            @@media (max-width: 720px) {
                .hero-card {
                    padding: 28px 18px;
                    border-radius: 26px
                }

                .hs {
                    grid-template-columns: 1fr;
                    border-radius: 18px;
                    gap: 4px
                }

                .hs-sel {
                    margin: 0;
                    border-left: 0;
                    border-top: 1px solid var(--line);
                    padding-left: 16px
                }

                    .hs-sel select {
                        max-width: none;
                        width: 100%
                    }

                .hs button {
                    justify-content: center
                }

                .glance {
                    padding: 20px
                }

                .gl-mini {
                    grid-template-columns: 1fr
                }
            }

            /* ═══ MAIN ═══ */
            main {
                padding: 44px 0 20px
            }

            .sec-head {
                display: flex;
                align-items: center;
                gap: 14px;
                margin-bottom: 18px
            }

                .sec-head h2 {
                    font: 800 24px var(--fd);
                    color: var(--ink);
                    letter-spacing: -.6px;
                    white-space: nowrap
                }

            .sec-line {
                flex: 1;
                height: 1px;
                background: var(--line)
            }

            .chip {
                font-size: 12px;
                font-weight: 700;
                padding: 5px 14px;
                border-radius: 999px;
                background: var(--navy);
                color: var(--gold-2);
                white-space: nowrap
            }

            /* streams */
            .streams {
                display: flex;
                gap: 10px;
                overflow-x: auto;
                padding: 4px 2px 14px;
                margin-bottom: 30px;
                scroll-snap-type: x proximity;
                scrollbar-width: thin
            }

            .stream {
                display: flex;
                align-items: center;
                gap: 10px;
                flex-shrink: 0;
                scroll-snap-align: start;
                padding: 9px 16px 9px 10px;
                text-decoration: none;
                background: var(--glass);
                backdrop-filter: blur(10px);
                -webkit-backdrop-filter: blur(10px);
                border: 1px solid rgba(255,255,255,.9);
                border-radius: 999px;
                box-shadow: var(--sh);
                transition: all .25s var(--ease)
            }

                .stream:hover {
                    transform: translateY(-3px);
                    box-shadow: var(--sh-lg)
                }

                .stream .ic {
                    width: 34px;
                    height: 34px;
                    border-radius: 50%;
                    display: grid;
                    place-items: center;
                    background: #eaf0ff;
                    font-size: 17px
                }

                .stream .nm {
                    font-size: 13px;
                    font-weight: 600;
                    color: var(--ink);
                    white-space: nowrap
                }

                .stream .ct {
                    font-size: 11.5px;
                    font-weight: 700;
                    color: var(--sub);
                    background: #eef2f9;
                    border-radius: 999px;
                    padding: 2px 9px
                }

                .stream.active {
                    background: linear-gradient(135deg, var(--navy), var(--royal));
                    border-color: transparent
                }

                    .stream.active .nm {
                        color: #fff
                    }

                    .stream.active .ic {
                        background: rgba(255,255,255,.18)
                    }

                    .stream.active .ct {
                        background: var(--gold);
                        color: var(--navy)
                    }

            .content {
                display: grid;
                grid-template-columns: minmax(0, 1fr) 340px;
                gap: 28px;
                align-items: start
            }

            /* filter */
            .filter {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
                align-items: center;
                margin-bottom: 20px
            }

            .search-f {
                position: relative;
                flex: 1;
                min-width: 230px
            }

                .search-f i {
                    position: absolute;
                    left: 16px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--muted);
                    pointer-events: none
                }

                .search-f input {
                    width: 100%;
                    height: 48px;
                    padding: 0 16px 0 44px;
                    border: 1.5px solid transparent;
                    border-radius: 14px;
                    background: var(--glass);
                    backdrop-filter: blur(10px);
                    box-shadow: var(--sh);
                    font: 500 14px var(--fb);
                    color: var(--ink);
                    outline: 0;
                    transition: all .2s var(--ease)
                }

                    .search-f input:focus {
                        border-color: var(--gold);
                        box-shadow: 0 0 0 4px rgba(245,179,1,.2)
                    }

            .btn {
                height: 48px;
                padding: 0 20px;
                border-radius: 14px;
                font: 700 13px var(--fb);
                display: inline-flex;
                align-items: center;
                gap: 8px;
                cursor: pointer;
                text-decoration: none;
                transition: all .2s var(--ease)
            }

            .btn-p {
                border: 0;
                color: #fff;
                background: linear-gradient(135deg, var(--navy), var(--royal));
                box-shadow: 0 10px 20px -6px rgba(37,99,235,.5)
            }

                .btn-p:hover {
                    transform: translateY(-2px)
                }

            .btn-g {
                background: var(--glass);
                border: 1.5px solid var(--line);
                color: var(--sub)
            }

                .btn-g:hover {
                    border-color: var(--royal);
                    color: var(--navy)
                }

            .count {
                height: 48px;
                display: inline-flex;
                align-items: center;
                padding: 0 16px;
                border-radius: 14px;
                background: var(--glass);
                box-shadow: var(--sh);
                font-size: 12.5px;
                color: var(--sub);
                white-space: nowrap
            }

                .count b {
                    color: var(--navy);
                    margin-right: 5px;
                    font-size: 15px
                }

            /* college cards */
            .grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 16px
            }

            .card {
                content-visibility: auto;
                contain-intrinsic-size: 0 150px;
                position: relative;
                display: flex;
                flex-direction: column;
                gap: 16px;
                padding: 20px;
                text-align: left;
                cursor: pointer;
                font-family: inherit;
                background: var(--glass);
                backdrop-filter: blur(10px);
                -webkit-backdrop-filter: blur(10px);
                border: 1px solid rgba(255,255,255,.9);
                border-radius: 22px;
                box-shadow: var(--sh);
                transition: transform .3s var(--ease), box-shadow .3s var(--ease), background .3s
            }

                .card:hover {
                    transform: translateY(-5px);
                    box-shadow: var(--sh-lg);
                    background: rgba(255,255,255,.96)
                }

                .card:focus-visible {
                    outline: 3px solid var(--gold)
                }

            .c-top {
                display: flex;
                gap: 14px;
                align-items: flex-start
            }

            .c-av {
                width: 44px;
                height: 44px;
                border-radius: 14px;
                display: grid;
                place-items: center;
                flex-shrink: 0;
                font: 800 18px var(--fd);
                color: var(--gold-2);
                background: linear-gradient(135deg, var(--navy), var(--royal));
                box-shadow: 0 8px 16px -6px rgba(37,99,235,.55)
            }

            .c-name {
                font-size: 14px;
                font-weight: 700;
                color: var(--navy);
                line-height: 1.45;
                padding-right: 22px
            }

            .c-meta {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 8px;
                margin-top: auto;
                padding-top: 14px;
                border-top: 1px dashed var(--line)
            }

            .c-town {
                display: flex;
                align-items: center;
                gap: 6px;
                font-size: 12px;
                font-weight: 500;
                color: var(--sub)
            }

                .c-town i {
                    color: var(--royal)
                }

            .c-fac {
                font-size: 11px;
                font-weight: 600;
                color: var(--sub);
                background: #eef2f9;
                padding: 4px 11px;
                border-radius: 999px;
                white-space: nowrap
            }

            .c-go {
                position: absolute;
                top: 18px;
                right: 18px;
                width: 26px;
                height: 26px;
                border-radius: 50%;
                display: grid;
                place-items: center;
                font-size: 11px;
                color: var(--muted);
                background: #eef2f9;
                transition: all .25s var(--ease)
            }

            .card:hover .c-go {
                background: var(--gold);
                color: var(--navy);
                transform: rotate(45deg)
            }

            .card[hidden] {
                display: none
            }

            .empty {
                grid-column: 1/-1;
                text-align: center;
                padding: 60px 20px;
                color: var(--muted);
                background: var(--glass);
                border: 1.5px dashed var(--line);
                border-radius: 22px
            }

                .empty i {
                    font-size: 40px;
                    opacity: .4
                }

                .empty h4 {
                    font: 800 18px var(--fd);
                    color: var(--ink);
                    margin: 10px 0 4px
                }

                .empty .btn {
                    margin-top: 16px
                }

            .live-empty {
                display: none;
                margin-top: 16px
            }

            /* sidebar */
            aside {
                position: sticky;
                top: 98px;
                display: flex;
                flex-direction: column;
                gap: 16px;
                max-height: calc(100vh - 116px);
                overflow-y: auto;
                scrollbar-width: thin;
                padding: 2px 2px 6px
            }

            .widget {
                background: var(--glass);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border: 1px solid rgba(255,255,255,.9);
                border-radius: 22px;
                box-shadow: var(--sh);
                overflow: hidden
            }

            .w-head {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 15px 18px;
                border-bottom: 1px solid var(--line)
            }

                .w-head i {
                    width: 28px;
                    height: 28px;
                    border-radius: 9px;
                    display: grid;
                    place-items: center;
                    font-size: 13px;
                    background: linear-gradient(135deg, #fff8e1, #fdecb0);
                    color: var(--gold-d)
                }

                .w-head h3 {
                    font: 800 14px var(--fd);
                    color: var(--ink)
                }

            .upd {
                list-style: none
            }

                .upd li {
                    padding: 13px 18px;
                    border-bottom: 1px solid var(--line);
                    transition: background .2s
                }

                    .upd li:last-child {
                        border-bottom: 0
                    }

                    .upd li:hover {
                        background: rgba(234,240,255,.7)
                    }

                .upd a {
                    display: block;
                    font-size: 12.5px;
                    font-weight: 500;
                    line-height: 1.55;
                    text-decoration: none;
                    color: var(--text)
                }

                    .upd a:hover {
                        color: var(--royal)
                    }

            .tag {
                display: inline-block;
                font-size: 10.5px;
                font-weight: 700;
                padding: 2px 9px;
                border-radius: 999px;
                margin-bottom: 6px
            }

            .tag-new {
                background: #fff1f2;
                color: var(--red)
            }

            .tag-imp {
                background: #fff8e1;
                color: var(--gold-d)
            }

            .tag-info {
                background: #eaf0ff;
                color: var(--royal)
            }

            .upd small {
                display: flex;
                align-items: center;
                gap: 5px;
                margin-top: 4px;
                font-size: 11px;
                color: var(--muted)
            }

            .q-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 8px;
                padding: 12px
            }

            .q {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 7px;
                padding: 15px 8px;
                border-radius: 16px;
                background: #f4f7fd;
                text-decoration: none;
                font-size: 11.5px;
                font-weight: 600;
                color: var(--text);
                text-align: center;
                transition: all .25s var(--ease)
            }

                .q i {
                    font-size: 20px;
                    color: var(--royal)
                }

                .q:hover {
                    background: var(--navy);
                    color: #fff;
                    transform: translateY(-2px)
                }

                    .q:hover i {
                        color: var(--gold-2)
                    }

            .hl {
                padding: 14px 18px;
                display: flex;
                flex-direction: column;
                gap: 14px
            }

            .hl-row {
                display: flex;
                align-items: center;
                gap: 12px
            }

            .hl-ic {
                width: 38px;
                height: 38px;
                border-radius: 12px;
                background: #eaf0ff;
                display: grid;
                place-items: center;
                color: var(--royal);
                font-size: 15px;
                flex-shrink: 0
            }

            .hl-lbl {
                font-size: 11px;
                color: var(--muted)
            }

            .hl-val {
                font-size: 13px;
                font-weight: 600;
                color: var(--navy)
            }

                .hl-val a {
                    text-decoration: none
                }

                    .hl-val a:hover {
                        text-decoration: underline
                    }

            /* ═══ FOOTER ═══ */
            footer {
                margin-top: 40px;
                color: #fff;
                background: radial-gradient(500px 260px at 100% 0%, rgba(96,165,250,.25), transparent 70%), linear-gradient(180deg, var(--navy-d), #040f33);
                border-radius: 36px 36px 0 0;
                border-top: 3px solid var(--gold);
                overflow: hidden
            }

            .f-wm {
                position: absolute;
                left: -60px;
                bottom: -80px;
                width: 380px;
                opacity: .06;
                filter: grayscale(1) brightness(4);
                pointer-events: none
            }

            .f-grid {
                position: relative;
                display: grid;
                grid-template-columns: 2.2fr 1fr 1fr 1fr;
                gap: 36px;
                padding-top: 48px;
                padding-bottom: 28px
            }

            .f-brand {
                display: flex;
                align-items: center;
                gap: 13px;
                margin-bottom: 14px
            }

            .f-logo {
                width: 50px;
                height: 50px;
                border-radius: 14px;
                background: #fff;
                padding: 4px;
                object-fit: contain
            }

            .f-name {
                font: 800 15px/1.3 var(--fd)
            }

                .f-name span {
                    display: block;
                    font: 500 11px var(--fb);
                    color: rgba(255,255,255,.5);
                    margin-top: 3px
                }

            .f-desc {
                font-size: 12.5px;
                color: rgba(255,255,255,.58);
                line-height: 1.85;
                max-width: 440px
            }

            .f-col h5 {
                font: 700 12.5px var(--fd);
                color: var(--gold-2);
                padding-bottom: 11px;
                margin-bottom: 14px;
                border-bottom: 1px solid rgba(245,179,1,.28)
            }

            .f-col ul {
                list-style: none;
                display: flex;
                flex-direction: column;
                gap: 10px
            }

            .f-col a {
                display: inline-block;
                font-size: 12.5px;
                color: rgba(255,255,255,.62);
                text-decoration: none;
                transition: all .2s
            }

                .f-col a:hover {
                    color: var(--gold-2);
                    transform: translateX(3px)
                }

            .f-bar {
                position: relative;
                border-top: 1px solid rgba(255,255,255,.1)
            }

                .f-bar .wrap {
                    display: flex;
                    justify-content: space-between;
                    gap: 14px;
                    flex-wrap: wrap;
                    padding-top: 16px;
                    padding-bottom: 16px
                }

                .f-bar p {
                    font-size: 11.5px;
                    color: rgba(255,255,255,.45)
                }

                .f-bar a {
                    color: var(--gold-2);
                    text-decoration: none
                }

                    .f-bar a:hover {
                        text-decoration: underline
                    }

            /* ═══ COURSE DRAWER ═══ */
            dialog {
                border: 0;
                padding: 0;
                margin: 12px 12px 12px auto;
                height: calc(100dvh - 24px);
                max-height: calc(100dvh - 24px);
                width: min(500px, calc(100vw - 24px));
                border-radius: 28px;
                background: #fff;
                overflow: hidden;
                box-shadow: 0 40px 90px rgba(6,26,74,.45)
            }

                dialog[open] {
                    display: flex;
                    flex-direction: column;
                    animation: slide .35s var(--ease) both
                }

                dialog::backdrop {
                    background: rgba(6,26,74,.55);
                    backdrop-filter: blur(5px)
                }

            @@keyframes slide {
                from {
                    opacity: 0;
                    transform: translateX(36px)
                }

                to {
                    opacity: 1;
                    transform: none
                }
            }

            .d-head {
                position: relative;
                padding: 26px 28px 22px;
                color: #fff;
                flex-shrink: 0;
                background: radial-gradient(260px 160px at 100% 0%, rgba(245,179,1,.28), transparent 70%), linear-gradient(135deg, var(--navy-d), var(--navy))
            }

                .d-head img {
                    position: absolute;
                    right: -24px;
                    bottom: -34px;
                    width: 150px;
                    opacity: .12;
                    filter: grayscale(1) brightness(4);
                    pointer-events: none
                }

            .d-eyebrow {
                display: flex;
                align-items: center;
                gap: 7px;
                font-size: 12px;
                font-weight: 600;
                color: var(--gold-2);
                margin-bottom: 8px
            }

            .d-title {
                position: relative;
                font: 800 20px/1.3 var(--fd);
                letter-spacing: -.3px;
                padding-right: 40px
            }

            .d-meta {
                position: relative;
                display: flex;
                gap: 8px;
                flex-wrap: wrap;
                margin-top: 14px
            }

                .d-meta span {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    font-size: 12px;
                    padding: 5px 12px;
                    border-radius: 999px;
                    background: rgba(255,255,255,.12);
                    border: 1px solid rgba(255,255,255,.22)
                }

                .d-meta i {
                    color: var(--gold-2)
                }

            .d-close {
                position: absolute;
                top: 18px;
                right: 18px;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                cursor: pointer;
                border: 1px solid rgba(255,255,255,.3);
                background: rgba(255,255,255,.1);
                color: #fff;
                transition: all .2s
            }

                .d-close:hover {
                    background: var(--gold);
                    border-color: var(--gold);
                    color: var(--navy);
                    transform: rotate(90deg)
                }

            .d-body {
                flex: 1;
                overflow-y: auto;
                padding: 22px 28px
            }

            .d-sub {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 14px
            }

                .d-sub h4 {
                    display: flex;
                    align-items: center;
                    gap: 9px;
                    font: 800 16px var(--fd);
                    color: var(--ink)
                }

                    .d-sub h4 i {
                        color: var(--royal)
                    }

            .d-count {
                font-size: 11.5px;
                font-weight: 700;
                padding: 4px 13px;
                border-radius: 999px;
                background: var(--navy);
                color: var(--gold-2)
            }

            .courses {
                list-style: none;
                display: flex;
                flex-direction: column;
                gap: 8px
            }

                .courses li {
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    padding: 12px 14px;
                    border-radius: 14px;
                    background: #f4f7fd;
                    font-size: 13px;
                    font-weight: 500;
                    transition: all .2s var(--ease)
                }

                    .courses li:hover {
                        background: #eaf0ff;
                        transform: translateX(3px)
                    }

                .courses .n {
                    width: 28px;
                    height: 28px;
                    border-radius: 9px;
                    background: #fff;
                    display: grid;
                    place-items: center;
                    font-size: 11px;
                    font-weight: 700;
                    color: var(--royal);
                    flex-shrink: 0;
                    box-shadow: 0 2px 6px rgba(11,42,111,.08)
                }

            .d-state {
                text-align: center;
                padding: 48px 0;
                color: var(--muted);
                font-size: 13px
            }

                .d-state i {
                    display: block;
                    font-size: 34px;
                    margin-bottom: 12px;
                    opacity: .5
                }

            .spin {
                width: 34px;
                height: 34px;
                margin: 0 auto 14px;
                border-radius: 50%;
                border: 3px solid #e5eaf4;
                border-top-color: var(--royal);
                animation: rot .7s linear infinite
            }

            @@keyframes rot {
                to {
                    transform: rotate(360deg)
                }
            }

            .d-foot {
                display: flex;
                align-items: center;
                gap: 7px;
                padding: 13px 28px;
                background: #f4f7fd;
                border-top: 1px solid var(--line);
                font-size: 11.5px;
                color: var(--muted);
                flex-shrink: 0
            }

                .d-foot i {
                    color: var(--green)
                }

            /* ═══ RESPONSIVE ═══ */
            @@media (max-width: 1100px) {
                .nav {
                    display: none
                }

                .btn-login {
                    margin-left: auto
                }

                .content {
                    grid-template-columns: 1fr
                }

                aside {
                    position: static;
                    max-height: none;
                    overflow: visible;
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr))
                }

                .f-grid {
                    grid-template-columns: 1fr 1fr
                }
            }

            @@media (max-width: 720px) {
                .wrap {
                    padding: 0 14px
                }

                html {
                    font-size: 14.5px
                }

                .brand small {
                    display: none
                }

                .brand b {
                    font-size: 13.5px;
                    white-space: normal
                }

                .btn-login span {
                    display: none
                }

                .btn-login {
                    padding: 12px 14px
                }

                .ann-l span:last-child {
                    display: none
                }

                .grid {
                    grid-template-columns: 1fr
                }

                .f-grid {
                    grid-template-columns: 1fr
                }

                footer {
                    border-radius: 26px 26px 0 0
                }

                dialog {
                    margin: 8px;
                    width: calc(100vw - 16px);
                    height: calc(100dvh - 16px);
                    max-height: calc(100dvh - 16px)
                }

                .d-head, .d-body {
                    padding-left: 18px;
                    padding-right: 18px
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                *, *::before, *::after {
                    animation: none !important;
                    transition: none !important
                }
            }
    </style>
</head>
<body>

    <!-- LOGO WATERMARK -->
    <div class="wm" aria-hidden="true"><img src="~/images/newLogo.jpeg" alt="" /></div>

    <!-- ════ HEADER ════ -->
    <header class="top">
        <div class="wrap">
            <div class="top-bar">
                <a class="brand" href="#">
                    <div class="brand-logo"><img src="~/images/newLogo.jpeg" alt="RGUHS Logo" width="46" height="46" /></div>
                    <div>
                        <small>Government of Karnataka</small>
                        <b>Rajiv Gandhi University of Health Sciences</b>
                    </div>
                </a>
                <nav class="nav" aria-label="Quick navigation">
                    <a href="https://www.rguhs.ac.in" target="_blank" rel="noopener">RGUHS Website</a>
                    <a href="https://rguhs.karnataka.gov.in/rguhsec/" target="_blank" rel="noopener">Eligibility</a>
                    <a href="https://rguhs.karnataka.gov.in/rguhs_online/" target="_blank" rel="noopener">Results</a>
                    <a href="https://www.rguhs.ac.in/notification_circulars_rguhs.html" target="_blank" rel="noopener">Notifications</a>
                    <a href="https://www.rguhsaca.karnataka.gov.in/GuideRegistrationApplication/Home/Contact" target="_blank" rel="noopener">Help Desk</a>
                </nav>
                <a asp-controller="MainDashboard" asp-action="MultiLogin" class="btn-login" aria-label="Open official portal login">
                    <i class="bi bi-shield-lock-fill"></i><span>Official Portal Login</span>
                </a>
            </div>
        </div>
    </header>

    <!-- ════ ANNOUNCEMENTS ════ -->
    <div class="ann">
        <div class="wrap">
            <div class="ann-box" role="region" aria-label="Live updates">
                <div class="ann-l"><span class="dot"></span><span>Live Updates</span></div>
                <div class="ann-track">
                    <div class="ann-in">
                        <a href="http://www.rguhs.ac.in/"><i class="bi bi-megaphone-fill"></i>Visit the official RGUHS website</a>
                        <a href="https://rguhsaca.karnataka.gov.in/admissionaffiliation/MainDashboard/MultiLogin"><i class="bi bi-info-circle-fill"></i>Medical college details submission has commenced for existing colleges</a>
                        <a href="http://www.rguhs.ac.in/"><i class="bi bi-megaphone-fill"></i>Visit the official RGUHS website</a>
                        <a href="https://rguhsaca.karnataka.gov.in/admissionaffiliation/MainDashboard/MultiLogin"><i class="bi bi-info-circle-fill"></i>Medical college details submission has commenced for existing colleges</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ════ HERO ════ -->
    <section class="hero">
        <div class="wrap">
            @{
                var topFac = Model.Faculties.OrderByDescending(f => f.CollegeCount).Take(5).ToList();
                int maxCnt = topFac.Any() ? Math.Max(1, topFac.Max(f => Convert.ToInt32(f.CollegeCount))) : 1;
            }
            <div class="hero-card">
                <div class="aur" aria-hidden="true"><span></span><span></span><span></span></div>

                <div class="hero-l">
                    <div class="hero-top">
                        <span class="badge"><i class="bi bi-patch-check-fill"></i> Official Affiliation Portal</span>
                        <span class="badge alt"><i class="bi bi-calendar-check"></i> Academic year 2026–27</span>
                    </div>
                    <h1>Find every <span>affiliated college</span> across Karnataka</h1>
                    <p>Browse medical, dental, nursing, pharmacy, AYUSH and allied health institutions affiliated to RGUHS by stream, town or name.</p>

                    <form method="get" action="@Url.Action("Rguhsdashboard")#colleges" class="hs" role="search">
                        <label class="hs-field">
                            <i class="bi bi-search"></i>
                            <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search college name or town" autocomplete="off" aria-label="Search colleges" />
                        </label>
                        <label class="hs-sel">
                            <i class="bi bi-funnel"></i>
                            <select name="faculty" aria-label="Stream">
                                <option value="ALL" selected="@allActive">All streams</option>
                                @foreach (var fac in Model.Faculties)
                                {
                                    <option value="@fac.FacultyId" selected="@(Model.ActiveFaculty == fac.FacultyId)">@fac.FacultyName</option>
                                }
                            </select>
                        </label>
                        <button type="submit"><i class="bi bi-search"></i> Search</button>
                    </form>

                    @if (topFac.Any())
                    {
                        <div class="pop">
                            <span>Popular:</span>
                            @foreach (var fac in topFac.Take(4))
                            {
                                <a href="@(Url.Action("Rguhsdashboard", new { faculty = fac.FacultyId }) + "#colleges")">@fac.Icon @fac.FacultyName</a>
                            }
                        </div>
                    }

                    <div class="trust">
                        <span><i class="bi bi-shield-check"></i> Recognised by UGC, NMC &amp; ACU</span>
                        <span><i class="bi bi-award"></i> NAAC accredited</span>
                        <span><i class="bi bi-geo-alt-fill"></i> Jayanagar, Bangalore · Est. 1996</span>
                    </div>
                </div>

                <div class="glance" role="region" aria-label="Portal statistics">
                    <div class="gl-head"><span>Colleges at a glance</span><em>Live data</em></div>
                    <div class="gl-num">
                        <b data-count="@Model.TotalColleges">@Model.TotalColleges</b>
                        <span>affiliated colleges<br>across Karnataka</span>
                    </div>
                    <div class="gl-mini">
                        <div><i class="bi bi-diagram-3-fill"></i><span><b>@Model.Faculties.Count</b><small>Streams</small></span></div>
                        <div><i class="bi bi-mortarboard-fill"></i><span><b>2026–27</b><small>Academic year</small></span></div>
                    </div>
                    @if (topFac.Any())
                    {
                        <div class="gl-list">
                            <h4>Largest streams</h4>
                            @foreach (var fac in topFac)
                            {
                                int pct = (int)Math.Round(100.0 * Convert.ToInt32(fac.CollegeCount) / maxCnt);
                                <a class="gl-row" href="@(Url.Action("Rguhsdashboard", new { faculty = fac.FacultyId }) + "#colleges")">
                                    <span class="ic">@fac.Icon</span>
                                    <span class="nm">@fac.FacultyName</span>
                                    <span class="ct">@fac.CollegeCount</span>
                                    <span class="bar"><i style="--w:@(pct)%"></i></span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <main>
        <div class="wrap">

            <!-- ════ STREAMS ════ -->
            <div class="sec-head">
