@model List<Medical_Affiliation.ViewModels.CAProgressViewModel>

@{
    ViewData["Title"] = "CA Progress Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


<style>

    .page-wrapper{
        padding-top: 0;
    }

    .ca-progress-page {
        display: block !important;
        position: relative;
        width: 100%;
        padding: 25px !important;
        background: #f6f8fb;
        min-height: calc(100vh - 70px);
    }

    .ca-progress-page .page-header {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
        position: relative !important;
        z-index: 10 !important;
        width: 100%;
        background: #ffffff;
        border-radius: 14px;
        padding: 22px 25px;
        margin: 0 0 20px 0;
        box-shadow: 0 4px 18px rgba(0, 0, 0, .05);
        border: 1px solid #edf0f4;
    }

    .ca-progress-page .page-header-content {
        display: flex !important;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        width: 100%;
    }

    .ca-progress-page .page-title {
        display: block !important;
        visibility: visible !important;
        margin: 0;
        font-size: 24px;
        font-weight: 700;
        color: #1f2937;
    }

    .ca-progress-page .page-subtitle {
        display: block !important;
        visibility: visible !important;
        margin: 5px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .ca-progress-page .back-btn {
        display: inline-flex !important;
        visibility: visible !important;
        opacity: 1 !important;
        align-items: center;
        gap: 7px;
        padding: 9px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        background: #fff;
        color: #374151;
        border: 1px solid #d1d5db;
        white-space: nowrap;
    }

    .page-wrapper:has(.ca-progress-page) .page-shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0;
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0 1.25rem 2rem;
    }

    .page-wrapper:has(.ca-progress-page) .portal-sidebar-shell { display: none; }
    .page-wrapper:has(.ca-progress-page) .page-content,
    .page-wrapper:has(.ca-progress-page) .portal-main-card {
        width: 100%;
        max-width: none;
        min-width: 0;
        margin-left: 0;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        background: #fff;
        color: #374151;
        border: 1px solid #d1d5db;
        transition: .2s;
    }

    .back-btn:hover {
        background: #f3f4f6;
        color: #111827;
    }

    /* FILTER CARD */

    .filter-card {
        background: #fff;
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 20px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
        border: 1px solid #edf0f4;
    }

    .filter-title {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 18px;
        color: #374151;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #4b5563;
        margin-bottom: 6px;
    }

    .form-select {
        height: 42px;
        border-radius: 8px;
        border-color: #d9dee7;
        font-size: 14px;
    }

    .form-select:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 .2rem rgba(99,102,241,.12);
    }

    .filter-actions {
        display: flex;
        align-items: end;
        gap: 8px;
    }

    .btn-filter {
        height: 42px;
        padding: 0 18px;
        border-radius: 8px;
        border: none;
        background: #4f46e5;
        color: #fff;
        font-weight: 600;
    }

    .btn-filter:hover {
        background: #4338ca;
        color: #fff;
    }

    .btn-reset {
        height: 42px;
        padding: 0 18px;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        background: #fff;
        color: #374151;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .btn-reset:hover {
        background: #f3f4f6;
        color: #111827;
    }

    /* STAT CARDS */

    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 20px;
    }

    .stat-card {
        background: #fff;
        border-radius: 14px;
        padding: 18px 20px;
        border: 1px solid #edf0f4;
        box-shadow: 0 4px 18px rgba(0,0,0,.04);
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .stat-icon {
        width: 45px;
        height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .stat-total .stat-icon {
        background: #eef2ff;
        color: #4f46e5;
    }

    .stat-completed .stat-icon {
        background: #ecfdf5;
        color: #059669;
    }

    .stat-pending .stat-icon {
        background: #fff7ed;
        color: #ea580c;
    }

    .stat-label {
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 2px;
    }

    .stat-value {
        font-size: 22px;
        font-weight: 700;
        color: #1f2937;
    }

    /* TABLE */

    .table-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #edf0f4;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
        overflow: hidden;
    }

    .table-header {
        padding: 18px 22px;
        border-bottom: 1px solid #edf0f4;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .table-title {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        color: #374151;
    }

    .progress-table {
        margin: 0;
    }

    .progress-table thead th {
        background: #f8fafc;
        color: #4b5563;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
        padding: 13px 16px;
        border-bottom: 1px solid #e5e7eb;
        white-space: nowrap;
    }

    .progress-table tbody td {
        padding: 14px 16px;
        vertical-align: middle;
        font-size: 14px;
        color: #374151;
        border-bottom: 1px solid #f0f2f5;
    }

    .progress-table tbody tr:hover {
        background: #fafbff;
    }

    .step-key {
        font-family: Consolas, monospace;
        font-size: 13px;
        background: #f3f4f6;
        padding: 5px 8px;
        border-radius: 6px;
        color: #374151;
    }

    .level-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border-radius: 20px;
        background: #eef2ff;
        color: #4338ca;
        font-size: 12px;
        font-weight: 700;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-completed {
        background: #ecfdf5;
        color: #047857;
    }

    .status-pending {
        background: #fff7ed;
        color: #c2410c;
    }

    /* TOGGLE */

    .status-toggle {
        position: relative;
        display: inline-block;
        width: 48px;
        height: 26px;
    }

    .status-toggle input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .toggle-slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background: #d1d5db;
        transition: .25s;
        border-radius: 30px;
    }

    .toggle-slider:before {
        content: "";
        position: absolute;
        height: 20px;
        width: 20px;
        left: 3px;
        top: 3px;
        background: #fff;
        transition: .25s;
        border-radius: 50%;
        box-shadow: 0 1px 3px rgba(0,0,0,.25);
    }

    .status-toggle input:checked + .toggle-slider {
        background: #10b981;
    }

    .status-toggle input:checked + .toggle-slider:before {
        transform: translateX(22px);
    }

    .updated-date {
        color: #6b7280;
        font-size: 12px;
    }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
        color: #6b7280;
    }

    .empty-state i {
        font-size: 42px;
        color: #cbd5e1;
        margin-bottom: 10px;
    }


    .table-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 16px 20px;
        border-bottom: 1px solid #edf0f4;
    }

    .search-box {
        width: 320px;
    }

    .search-box .input-group-text {
        background: #fff;
        border-right: 0;
    }

    .search-box .form-control {
        border-left: 0;
    }

    .page-size-box {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #6b7280;
        font-size: 13px;
    }

    .page-size-box .form-select {
        width: 75px;
    }


    /* =========================================================
       PAGINATION
       ========================================================= */

    .pagination-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 16px 20px;
        border-top: 1px solid #edf0f4;
        background: #fff;
        flex-wrap: wrap;
    }

    .pagination-info {
        font-size: 13px;
        color: #6b7280;
        white-space: nowrap;
    }

    .pagination-info strong {
        color: #374151;
        font-weight: 600;
    }

    .pagination-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .page-btn {
        min-width: 34px;
        height: 34px;
        padding: 0 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e5e7eb;
        border-radius: 7px;
        background: #fff;
        color: #374151;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color .2s ease, color .2s ease, border-color .2s ease, transform .15s ease;
    }

    .page-btn:hover:not(:disabled) {
        background: #f5f7ff;
        border-color: #c7d2fe;
        color: #4f46e5;
    }

    .page-btn:active:not(:disabled) {
        transform: scale(.96);
    }

    .page-btn.active {
        background: #4f46e5;
        border-color: #4f46e5;
        color: #fff;
        box-shadow: 0 2px 6px rgba(79, 70, 229, .20);
    }

    .page-btn:disabled {
        opacity: .45;
        cursor: not-allowed;
        background: #f9fafb;
    }

    .pagination-dots {
        min-width: 25px;
        text-align: center;
        color: #9ca3af;
        font-size: 13px;
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 768px) {

        .pagination-container {
            justify-content: center;
            flex-direction: column;
            padding: 15px;
        }

        .pagination-info {
            width: 100%;
            text-align: center;
        }

        .pagination-controls {
            width: 100%;
            overflow-x: auto;
            padding-bottom: 3px;
        }

        .page-btn {
            flex-shrink: 0;
        }
    }

    @@media (max-width: 768px) {

        .table-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .search-box {
            width: 100%;
        }
    }

    @@media (max-width: 992px) {
        .stats-row {
            grid-template-columns: 1fr;
        }

        .page-header-content {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (max-width: 768px) {
        .ca-progress-page {
            padding: 15px;
        }

        .filter-actions {
            margin-top: 10px;
        }

        .table-card {
            overflow-x: auto;
        }
    }
</style>


<div class="ca-progress-page">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="page-header">

        <div class="page-header-content">

            <div>
                <h2 class="page-title">
                    <i class="bi bi-list-check me-2"></i>
                    CA Progress Management
                </h2>

                <p class="page-subtitle">
                    Manage and toggle completion status of Continuous Affiliation pages.
                </p>
            </div>

            <a asp-controller="Admin"
               asp-action="AdminDashboard"
               class="back-btn">
                <i class="bi bi-arrow-left"></i>
                Back to Dashboard
            </a>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- FILTERS -->
    <!-- ========================================================= -->

    <div class="filter-card">

        <div class="filter-title">
            <i class="bi bi-funnel me-2"></i>
            Filter CA Progress
        </div>

        <form asp-controller="CAProgress"
              asp-action="Index"
              method="get">

            <div class="row g-3">

                <!-- FACULTY -->

                <div class="col-lg-3 col-md-6">

                    <label class="form-label">
                        Faculty
                    </label>

                    <select name="facultyCode"
                            id="facultyCode"
                            class="form-select"
                            asp-items="ViewBag.Faculties">

                        <option value="">-- Select Faculty --</option>

                    </select>

                </div>


                <!-- COLLEGE -->

                <div class="col-lg-3 col-md-6">

                    <label class="form-label">
                        College
                    </label>

                    <select name="collegeCode"
                            id="collegeCode"
                            class="form-select"
                            asp-items="ViewBag.Colleges">

                        <option value="">-- Select College --</option>

                    </select>

                </div>


                <!-- COURSE LEVEL -->

                <div class="col-lg-2 col-md-6">

                    <label class="form-label">
                        Course Level
                    </label>

                    <select name="courseLevel"
                            id="courseLevel"
                            class="form-select"
                            asp-items="ViewBag.CourseLevels">
                    </select>

                </div>


                <!-- AFFILIATION TYPE -->

                <div class="col-lg-2 col-md-6">

                    <label class="form-label">
                        Type of Affiliation
                    </label>

                    <select name="typeId"
                            id="typeId"
                            class="form-select"
                            asp-items="ViewBag.AffiliationTypes">

                        <option value="">-- Select Affiliation Type --</option>

                    </select>

                </div>


                <!-- BUTTONS -->

                <div class="col-lg-2 col-md-12 filter-actions">

                    <button type="submit"
                            class="btn btn-filter">

                        <i class="bi bi-search me-1"></i>
                        Apply

                    </button>

                    <a asp-controller="CAProgress"
                       asp-action="Index"
                       class="btn-reset">

                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Reset

                    </a>

                </div>

            </div>

        </form>

    </div>


    <!-- ========================================================= -->
    <!-- STATISTICS -->
    <!-- ========================================================= -->
    @{
        var totalCount = Model?.Count ?? 0;

        var completedCount = Model?
            .Count(x => x.IsCompleted) ?? 0;

        var pendingCount = totalCount - completedCount;
    }

    <div class="stats-row">

        <div class="stat-card stat-total">

            <div class="stat-icon">
                <i class="bi bi-files"></i>
            </div>

            <div>
                <div class="stat-label">
                    Total Pages
                </div>

                <span class="text-muted small">
                    <span id="visibleRecordCount">@totalCount</span> record(s)
                </span>
            </div>

        </div>


        <div class="stat-card stat-completed">

            <div class="stat-icon">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <div class="stat-label">
                    Completed
                </div>

                <div class="stat-value"
                     id="completedCount">
                    @completedCount
                </div>
            </div>

        </div>


        <div class="stat-card stat-pending">

            <div class="stat-icon">
                <i class="bi bi-clock"></i>
            </div>

            <div>
                <div class="stat-label">
                    Not Completed
                </div>

                <div class="stat-value"
                     id="pendingCount">
                    @pendingCount
                </div>
            </div>

        </div>

    </div>


    <div class="table-toolbar">

        <div class="search-box">

            <div class="input-group">

                <span class="input-group-text">
                    <i class="bi bi-search"></i>
                </span>

                <input type="text"
                       id="tableSearch"
                       class="form-control"
                       placeholder="Search college code or page..." />

            </div>

        </div>


        <div class="page-size-box">

            <label>
                Show
            </label>

            <select id="pageSize"
                    class="form-select form-select-sm">

                <option value="10">10</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
                <option value="100">100</option>

            </select>

            <span>
                entries
            </span>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- TABLE -->
    <!-- ========================================================= -->

    <div class="table-card">

        <div class="table-header">

            <h5 class="table-title">
                <i class="bi bi-table me-2"></i>
                CA Progress Pages
            </h5>

            <span class="text-muted small">
                @totalCount record(s)
            </span>

        </div>


        <div class="table-responsive">

            <table class="table progress-table">

                <thead>

                    <tr>

                        <th>
                            #
                        </th>

                        <th class="sortable"
                            data-column="collegeCode">

                            College Code

                            <i class="bi bi-arrow-down-up"></i>

                        </th>

                        <th class="sortable"
                            data-column="courseLevel">

                            Course Level

                            <i class="bi bi-arrow-down-up"></i>

                        </th>

                        <th class="sortable"
                            data-column="stepKey">

                            Step / Page

                            <i class="bi bi-arrow-down-up"></i>

                        </th>

                        <th class="sortable"
                            data-column="status">

                            Status

                            <i class="bi bi-arrow-down-up"></i>

                        </th>

                        <th class="text-center">
                            Toggle
                        </th>

                        <th class="sortable"
                            data-column="updatedAt">

                            Updated At

                            <i class="bi bi-arrow-down-up"></i>

                        </th>
                    </tr>

                </thead>

                <tbody id="progressTableBody">

                    @if (Model != null && Model.Any())
                    {
                        var index = 1;

                        foreach (var item in Model)
                        {
                            <tr id="row-@item.Id" data-id="@item.Id">

                                <td>
                                    @index
                                </td>

                                <td>
                                    <strong>
                                        @item.CollegeCode
                                    </strong>
                                </td>

                                <td>

                                    <span class="level-badge">
                                        @item.CourseLevel
                                    </span>

                                </td>

                                <td>

                                    <span class="step-key">
                                        @item.StepKey
                                    </span>

                                </td>

                                <td>

                                    <span class="status-badge @(item.IsCompleted
                                                                                ? "status-completed"
                                                                                : "status-pending")"
                                          id="status-@item.Id">

                                        @if (item.IsCompleted)
                                        {
                                            <i class="bi bi-check-circle-fill"></i>
                                            <span>Completed</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-clock-fill"></i>
                                            <span>Not Completed</span>
                                        }

                                    </span>

                                </td>

                                <td class="text-center">

                                    <label class="status-toggle">

                                        <input type="checkbox"
                                               class="progress-toggle"
                                               data-id="@item.Id"
                                        @(item.IsCompleted ? "checked" : "") />

                                        <span class="toggle-slider"></span>

                                    </label>

                                </td>

                                <td>

                                    <span class="updated-date"
                                          id="updated-@item.Id">

                                        @(item.UpdatedAt.HasValue
                                            ? item.UpdatedAt.Value.ToString("dd-MM-yyyy hh:mm tt")
                                            : "-")

                                    </span>

                                </td>

                            </tr>

                            index++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7">

                                <div class="empty-state">

                                    <i class="bi bi-inbox d-block"></i>

                                    <strong>
                                        No CA Progress records found
                                    </strong>

                                    <div class="small mt-1">
                                        Select the required filters and apply them.
                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- PAGINATION -->

        <div class="pagination-container">

            <div id="paginationInfo"
                 class="pagination-info">
            </div>

            <div id="paginationContainer"
                 class="pagination-controls">
            </div>

        </div>
    </div>

</div>

@section Scripts {

    <script>

        let currentPage = 1;
        let pageSize = 25;

        let currentSortColumn = "";
        let currentSortDirection = "asc";

        let allRows = [];


        $(document).ready(function() {

            // =====================================================
            // STORE ORIGINAL TABLE ROWS
            // =====================================================

            allRows = Array.from(
                document.querySelectorAll("#progressTableBody tr[data-id]")
            );


            // =====================================================
            // SEARCH
            // =====================================================

            $("#tableSearch").on("input", function() {

                currentPage = 1;

                renderTable();

            });


            // =====================================================
            // PAGE SIZE
            // =====================================================

            $("#pageSize").on("change", function() {

                pageSize = parseInt($(this).val());

                currentPage = 1;

                renderTable();

            });


            // =====================================================
            // SORT
            // =====================================================

            $(".sortable").on("click", function() {

                const column = $(this).data("column");


                if (currentSortColumn === column) {

                    currentSortDirection =
                        currentSortDirection === "asc"
                            ? "desc"
                            : "asc";

                }
                else {

                    currentSortColumn = column;

                    currentSortDirection = "asc";

                }


                currentPage = 1;

                updateSortIcons();

                renderTable();

            });


            // =====================================================
            // INITIAL RENDER
            // =====================================================

            renderTable();

        });


        // =========================================================
        // GET FILTERED ROWS
        // =========================================================

        function getFilteredRows() {

            let rows = [...allRows];


            const search =
                ($("#tableSearch").val() || "")
                    .toString()
                    .trim()
                    .toLowerCase();


            // -----------------------------------------------------
            // SEARCH
            // -----------------------------------------------------

            if (search !== "") {

                rows = rows.filter(function(row) {

                    const text =
                        $(row)
                            .text()
                            .replace(/\s+/g, " ")
                            .trim()
                            .toLowerCase();


                    return text.includes(search);

                });

            }


            return rows;

        }


        // =========================================================
        // RENDER TABLE
        // =========================================================

        function renderTable() {

            let rows = getFilteredRows();


            // =====================================================
            // SORT
            // =====================================================

            if (currentSortColumn !== "") {

                rows.sort(function(a, b) {

                    const aValue =
                        getColumnValue(
                            a,
                            currentSortColumn
                        );

                    const bValue =
                        getColumnValue(
                            b,
                            currentSortColumn
                        );


                    if (aValue < bValue) {

                        return currentSortDirection === "asc"
                            ? -1
                            : 1;

                    }


                    if (aValue > bValue) {

                        return currentSortDirection === "asc"
                            ? 1
                            : -1;

                    }


                    return 0;

                });

            }


            // =====================================================
            // TOTAL
            // =====================================================

            const totalRecords = rows.length;


            const totalPages =
                Math.ceil(totalRecords / pageSize);


            if (currentPage > totalPages && totalPages > 0) {

                currentPage = totalPages;

            }


            // =====================================================
            // PAGINATION
            // =====================================================

            const startIndex =
                (currentPage - 1) * pageSize;


            const endIndex =
                startIndex + pageSize;


            const visibleRows =
                rows.slice(startIndex, endIndex);


            // =====================================================
            // HIDE ALL ORIGINAL ROWS
            // =====================================================

            allRows.forEach(function(row) {

                row.style.display = "none";

            });


            // =====================================================
            // SHOW CURRENT PAGE
            // =====================================================

            visibleRows.forEach(function(row, index) {

                row.style.display = "";


                const numberCell =
                    row.querySelector("td:first-child");


                if (numberCell) {

                    numberCell.textContent =
                        startIndex + index + 1;

                }

            });


            // =====================================================
            // EMPTY MESSAGE
            // =====================================================

            const tbody =
                document.getElementById(
                    "progressTableBody"
                );


            let emptyRow =
                document.getElementById(
                    "clientEmptyRow"
                );


            if (visibleRows.length === 0) {

                if (!emptyRow) {

                    emptyRow =
                        document.createElement("tr");

                    emptyRow.id =
                        "clientEmptyRow";

                    emptyRow.innerHTML = `
                                <td colspan="7">
                                    <div class="empty-state">
                                        <i class="bi bi-search d-block"></i>

                                        <strong>
                                            No records found
                                        </strong>

                                        <div class="small mt-1">
                                            Try changing your search.
                                        </div>
                                    </div>
                                </td>
                            `;

                    tbody.appendChild(emptyRow);

                }

                emptyRow.style.display = "";

            }
            else {

                if (emptyRow) {

                    emptyRow.style.display = "none";

                }

            }


            // =====================================================
            // UPDATE RECORD COUNT
            // =====================================================

            $("#visibleRecordCount")
                .text(totalRecords);


            // =====================================================
            // PAGINATION
            // =====================================================

            renderPagination(
                totalRecords,
                totalPages
            );

        }


        // =========================================================
        // GET COLUMN VALUE
        // =========================================================

        function getColumnValue(row, column) {

            switch (column) {

                case "collegeCode":

                    return $(row)
                        .find("td:eq(1)")
                        .text()
                        .trim()
                        .toLowerCase();


                case "courseLevel":

                    return $(row)
                        .find("td:eq(2)")
                        .text()
                        .trim()
                        .toLowerCase();


                case "stepKey":

                    return $(row)
                        .find("td:eq(3)")
                        .text()
                        .trim()
                        .toLowerCase();


                case "status":

                    return $(row)
                        .find(".progress-toggle")
                        .is(":checked")
                        ? 1
                        : 0;


                case "updatedAt":

                    return $(row)
                        .find("td:eq(6)")
                        .text()
                        .trim()
                        .toLowerCase();


                default:

                    return "";

            }

        }


        // =========================================================
        // PAGINATION
        // =========================================================

        function renderPagination(
            totalRecords,
            totalPages
        ) {

            const container =
                $("#paginationContainer");


            container.empty();


            if (totalRecords === 0) {

                $("#paginationInfo")
                    .text("Showing 0 records");

                return;

            }


            const start =
                ((currentPage - 1) * pageSize) + 1;


            const end =
                Math.min(
                    currentPage * pageSize,
                    totalRecords
                );


            $("#paginationInfo").text(
                `Showing ${start} - ${end} of ${totalRecords}`
            );


            if (totalPages <= 1) {

                return;

            }


            // =====================================================
            // PREVIOUS
            // =====================================================

            const previous =
                $("<button>")
                    .addClass("page-btn")
                    .attr("type", "button")
                    .html(
                        '<i class="bi bi-chevron-left"></i>'
                    )
                    .prop(
                        "disabled",
                        currentPage === 1
                    );


            previous.on("click", function() {

                if (currentPage > 1) {

                    currentPage--;

                    renderTable();

                }

            });


            container.append(previous);


            // =====================================================
            // PAGE NUMBERS
            // =====================================================

            for (
                let i = 1;
                i <= totalPages;
                i++
            ) {

                if (
                    i === 1 ||
                    i === totalPages ||
                    Math.abs(i - currentPage) <= 2
                ) {

                    const pageButton =
                        $("<button>")
                            .addClass("page-btn")
                            .attr("type", "button")
                            .toggleClass(
                                "active",
                                i === currentPage
                            )
                            .text(i);


                    pageButton.on(
                        "click",
                        function() {

                            currentPage = i;

                            renderTable();

                        }
                    );


                    container.append(pageButton);

                }
                else if (
                    i === currentPage - 3 ||
                    i === currentPage + 3
                ) {

                    container.append(
                        $("<span>")
                            .addClass("pagination-dots")
                            .text("...")
                    );

                }

            }


            // =====================================================
            // NEXT
            // =====================================================

            const next =
                $("<button>")
                    .addClass("page-btn")
                    .attr("type", "button")
                    .html(
                        '<i class="bi bi-chevron-right"></i>'
                    )
                    .prop(
                        "disabled",
                        currentPage === totalPages
                    );


            next.on("click", function() {

                if (currentPage < totalPages) {

                    currentPage++;

                    renderTable();

                }

            });


            container.append(next);

        }


        // =========================================================
        // SORT ICONS
        // =========================================================

        function updateSortIcons() {

            $(".sortable i")
                .removeClass()
                .addClass("bi bi-arrow-down-up");


            if (!currentSortColumn) {

                return;

            }


            const header =
                $(
                    `.sortable[data-column="${currentSortColumn}"]`
                );


            header.find("i")
                .removeClass()
                .addClass(
                    currentSortDirection === "asc"
                        ? "bi bi-arrow-up"
                        : "bi bi-arrow-down"
                );

        }


        // =========================================================
        // FACULTY → COLLEGE
        // =========================================================

        $("#facultyCode").on("change", function() {

            const facultyCode = $(this).val();

            const collegeDropdown =
                $("#collegeCode");


            collegeDropdown.empty();


            collegeDropdown.append(
                $("<option>", {
                    value: "",
                    text: "-- Select College --"
                })
            );


            if (!facultyCode) {

                return;

            }


            $.ajax({

                url:
                    '@Url.Action("GetCollegesByFaculty", "CAProgress")',

                type: "GET",

                data: {
                    facultyCode: facultyCode
                },

                success: function(data) {

                    $.each(
                        data,
                        function(index, college) {

                            collegeDropdown.append(
                                $("<option>", {
                                    value: college.collegeCode,
                                    text: college.collegeName
                                })
                            );

                        }
                    );

                },

                error: function() {

                    Swal.fire({

                        icon: "error",
                        title: "Error",
                        text: "Unable to load colleges."

                    });

                }

            });

        });


        // =========================================================
        // TOGGLE STATUS
        // =========================================================

        $(document).on(
            "change",
            ".progress-toggle",
            function() {

                const checkbox = $(this);

                const id =
                    checkbox.data("id");

                const newStatus =
                    checkbox.is(":checked");


                $.ajax({

                    url:
                        '@Url.Action("ToggleStatus", "CAProgress")',

                    type: "POST",

                    data: {

                        Id: id,

                        IsCompleted: newStatus,

                        __RequestVerificationToken:
                            $('input[name="__RequestVerificationToken"]')
                                .val()

                    },


                    success: function(response) {

                        if (!response.success) {

                            checkbox.prop(
                                "checked",
                                !newStatus
                            );

                            Swal.fire({

                                icon: "error",

                                title: "Unable to update",

                                text: response.message

                            });

                            return;

                        }


                        // -----------------------------------------
                        // Update original row
                        // -----------------------------------------

                        const originalRow =
                            allRows.find(
                                x =>
                                    $(x).data("id") == id
                            );


                        if (originalRow) {

                            const originalCheckbox =
                                $(originalRow)
                                    .find(".progress-toggle");


                            originalCheckbox.prop(
                                "checked",
                                response.isCompleted
                            );


                            const statusBadge =
                                $(originalRow)
                                    .find(".status-badge");


                            if (response.isCompleted) {

                                statusBadge
                                    .removeClass("status-pending")
                                    .addClass("status-completed")
                                    .html(
                                        '<i class="bi bi-check-circle-fill"></i>' +
                                        '<span>Completed</span>'
                                    );

                            }
                            else {

                                statusBadge
                                    .removeClass("status-completed")
                                    .addClass("status-pending")
                                    .html(
                                        '<i class="bi bi-clock-fill"></i>' +
                                        '<span>Not Completed</span>'
                                    );

                            }

                        }


                        // -----------------------------------------
                        // Re-render
                        // -----------------------------------------

                        renderTable();


                        Swal.fire({

                            toast: true,

                            position: "top-end",

                            icon:
                                response.isCompleted
                                    ? "success"
                                    : "info",

                            title:
                                response.isCompleted
                                    ? "Page marked as completed"
                                    : "Page marked as not completed",

                            showConfirmButton: false,

                            timer: 1500

                        });

                    },


                    error: function() {

                        checkbox.prop(
                            "checked",
                            !newStatus
                        );


                        Swal.fire({

                            icon: "error",

                            title: "Error",

                            text: "Unable to update page status."

                        });

                    }

                });

            }
        );

    </script>


    <!-- ========================================================= -->
    <!-- ANTI FORGERY TOKEN -->
    <!-- ========================================================= -->

    <form style="display:none;">
        @Html.AntiForgeryToken()
    </form>

}