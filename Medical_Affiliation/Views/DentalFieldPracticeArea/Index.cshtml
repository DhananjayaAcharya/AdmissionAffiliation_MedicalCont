@model Medical_Affiliation.Models.DentalFieldPracticeAreaViewModel

@{
    ViewData["Title"] = "Dental Field Practice Area";
    Layout = "~/Views/Shared/_CaLayout.cshtml";

    var isEditing = Model.DentalFieldPracticeAreaId > 0;
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .dental-field-practice-page {
        min-height: calc(100vh - 8rem);
        padding: 1.5rem 0 3rem;
        background: #f4f8fb;
        color: #18324b;
    }

    .dental-field-practice-page .page-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
        padding: 1.5rem 1.75rem;
        color: #fff;
        border-radius: .75rem;
        background: linear-gradient(120deg, #0e4d80, #1769aa);
    }

    .dental-field-practice-page .page-heading h1 {
        margin: 0;
        font-size: 1.8rem;
        font-weight: 600;
    }

    .dental-field-practice-page .page-heading p {
        margin: .35rem 0 0;
        color: rgba(255, 255, 255, .78);
    }

    .dental-field-practice-page .panel {
        border: 1px solid #dce7f0;
        border-radius: .7rem;
        background: #fff;
        box-shadow: 0 .5rem 1.5rem rgba(34, 67, 96, .07);
    }

    .dental-field-practice-page .section-title {
        font-size: 1rem;
        font-weight: 600;
        color: #18324b;
    }

    .dental-field-practice-page .form-label {
        color: #526b80;
        font-size: .75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .dental-field-practice-page .required::after {
        content: " *";
        color: #dc3545;
    }

    .dental-field-practice-page .form-control:focus {
        border-color: #1769aa;
        box-shadow: 0 0 0 .2rem rgba(23, 105, 170, .12);
    }

    .dental-field-practice-page textarea {
        min-height: 120px;
        resize: vertical;
    }

    .dental-field-practice-page .file-help {
        font-size: .75rem;
        color: #71869a;
        margin-top: .35rem;
    }

    .dental-field-practice-page .existing-file {
        margin-top: .5rem;
        padding: .55rem .75rem;
        border: 1px solid #dce7f0;
        border-radius: .45rem;
        background: #f7fafc;
    }

    .dental-field-practice-page .existing-file a {
        color: #1769aa;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
    }

    .dental-field-practice-page .existing-file a:hover {
        text-decoration: underline;
    }

    .dental-field-practice-page .table th {
        color: #62798d;
        background: #f1f6fa;
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .05em;
        white-space: nowrap;
    }

    .dental-field-practice-page .table td {
        vertical-align: middle;
    }

    .dental-field-practice-page .table tbody tr:hover {
        background: #f8fbfd;
    }

    .dental-field-practice-page .record-text {
        max-width: 260px;
        white-space: normal;
        word-break: break-word;
    }

    .dental-field-practice-page .action-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .dental-field-practice-page .btn-primary {
        background-color: #1769aa;
        border-color: #1769aa;
    }

    .dental-field-practice-page .btn-primary:hover {
        background-color: #0e4d80;
        border-color: #0e4d80;
    }

    .dental-field-practice-page .file-icon {
        color: #dc3545;
    }

    @@media (max-width: 767.98px) {

        .dental-field-practice-page .page-heading {
            align-items: start;
            flex-direction: column;
            padding: 1.25rem;
        }

        .dental-field-practice-page .page-heading h1 {
            font-size: 1.5rem;
        }

        .dental-field-practice-page .record-text {
            max-width: 180px;
        }
    }


    .dental-field-practice-page .pdf-viewer-modal .modal-content {
        border: 0;
        border-radius: .75rem;
        overflow: hidden;
    }

    #staffPdfViewerModal .modal-content {
        border-radius: .75rem;
        overflow: hidden;
    }

    #staffPdfViewerModal .modal-header {
        background: #f7fafc;
        border-bottom: 1px solid #dce7f0;
    }

    #staffPdfViewerModal .modal-footer {
        background: #f7fafc;
        border-top: 1px solid #dce7f0;
    }

    #staffPdfViewer {
        background: #525659;
    }
</style>


<div class="dental-field-practice-page">

    <div class="container-fluid">

        <!-- ========================================================= -->
        <!-- PAGE HEADER -->
        <!-- ========================================================= -->

        <div class="page-heading">

            <div>

                <h1>
                    <i class="bi bi-hospital me-2"></i>
                    Dental Field Practice Area
                </h1>

                <p>
                    Maintain details of dental field practice areas,
                    staff and population served.
                </p>

            </div>

        </div>


        <!-- ========================================================= -->
        <!-- ADD / EDIT FORM -->
        <!-- ========================================================= -->

        <div class="panel border-0 mb-4">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>

                        <h5 class="section-title mb-1">

                            <i class="bi bi-pencil-square me-1"></i>

                            @(isEditing
                                ? "Edit Field Practice Area"
                                : "Add Field Practice Area")

                        </h5>

                        <small class="text-muted">
                            Enter the particulars of the dental field practice area.
                        </small>

                    </div>


                    @if (isEditing)
                    {
                        <a asp-action="Index"
                           class="btn btn-sm btn-outline-secondary">

                            <i class="bi bi-x-circle me-1"></i>
                            Cancel

                        </a>
                    }

                </div>


                <form id="dentalFieldPracticeForm"
                      asp-action="@(isEditing ? "Edit" : "Create")"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()


                    @if (isEditing)
                    {
                        <input asp-for="DentalFieldPracticeAreaId"
                               type="hidden" />
                    }


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger small mb-3">
                    </div>


                    <div class="row g-4">

                        <!-- ================================================= -->
                        <!-- LOCATION -->
                        <!-- ================================================= -->

                        <div class="col-md-6">

                            <label asp-for="Location"
                                   class="form-label required">

                                <i class="bi bi-geo-alt me-1"></i>
                                Location

                            </label>

                            <input asp-for="Location"
                                   class="form-control"
                                   placeholder="Enter field practice area location" />

                            <span asp-validation-for="Location"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- ================================================= -->
                        <!-- MANAGED BY -->
                        <!-- ================================================= -->

                        <div class="col-md-6">

                            <label asp-for="ManagedBy"
                                   class="form-label required">

                                <i class="bi bi-building me-1"></i>
                                Managed By

                            </label>

                            <input asp-for="ManagedBy"
                                   class="form-control"
                                   placeholder="Enter managing organization / authority" />

                            <span asp-validation-for="ManagedBy"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- ================================================= -->
                        <!-- ADDRESS -->
                        <!-- ================================================= -->

                        <div class="col-md-12">

                            <label asp-for="Address"
                                   class="form-label required">

                                <i class="bi bi-pin-map me-1"></i>
                                Address

                            </label>

                            <textarea asp-for="Address"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter complete address of the field practice area"></textarea>

                            <span asp-validation-for="Address"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- ================================================= -->
                        <!-- STAFF LIST -->
                        <!-- ================================================= -->

                        <div class="col-md-6">

                            <label asp-for="StaffListFile"
                                   class="form-label">

                                <i class="bi bi-file-earmark-pdf me-1 file-icon"></i>
                                Staff List

                            </label>

                            <input asp-for="StaffListFile"
                                   type="file"
                                   class="form-control"
                                   accept=".pdf,application/pdf" />

                            <div class="file-help">
                                <i class="bi bi-info-circle me-1"></i>
                                PDF only. Maximum file size: 2 MB.
                            </div>


                            @if (isEditing &&
                                 !string.IsNullOrWhiteSpace(Model.StaffList))
                            {
                                <div class="existing-file">

                                    <i class="bi bi-file-earmark-pdf me-1 file-icon"></i>

                                    <a href="@Model.StaffList"
                                       target="_blank">

                                        View Existing Staff List

                                    </a>

                                </div>
                            }

                            <span asp-validation-for="StaffListFile"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- ================================================= -->
                        <!-- POPULATION SERVED -->
                        <!-- ================================================= -->

                        <div class="col-md-6">

                            <label asp-for="PopulationServed"
                                   class="form-label required">

                                <i class="bi bi-people me-1"></i>
                                Population Served

                            </label>

                            <input asp-for="PopulationServed"
                                   type="number"
                                   class="form-control"
                                   min="1"
                                   step="1"
                                   placeholder="Enter population served" />

                            <span asp-validation-for="PopulationServed"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- ================================================= -->
                        <!-- SAVE BUTTON -->
                        <!-- ================================================= -->

                        <div class="col-md-4 ms-auto">

                            <button type="submit"
                                    class="btn btn-primary w-100"
                                    id="saveDentalFieldPracticeBtn">

                                <i class="bi bi-save me-1"></i>

                                @(isEditing
                                    ? "Update Field Practice Area"
                                    : "Save Field Practice Area")

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>


        <!-- ========================================================= -->
        <!-- EXISTING RECORDS -->
        <!-- ========================================================= -->

        <div class="panel border-0">

            <div class="card-body p-0">

                <div class="p-4 border-bottom">

                    <h5 class="section-title mb-1">

                        <i class="bi bi-table me-1"></i>
                        Field Practice Area Records

                    </h5>

                    <small class="text-muted">
                        Existing dental field practice area details.
                    </small>

                </div>


                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>

                            <tr>

                                <th class="ps-4">
                                    Location
                                </th>

                                <th>
                                    Address
                                </th>

                                <th>
                                    Managed By
                                </th>

                                <th>
                                    Staff List
                                </th>

                                <th>
                                    Population Served
                                </th>

                                <th class="text-end pe-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @if (Model.DentalFieldPracticeRecords == null ||
                                 !Model.DentalFieldPracticeRecords.Any())
                            {
                                <tr>

                                    <td colspan="6"
                                        class="text-center text-muted py-5">

                                        <div class="mb-2">

                                            <i class="bi bi-inbox fs-2"></i>

                                        </div>

                                        No field practice area records found.

                                    </td>

                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.DentalFieldPracticeRecords)
                                {
                                    <tr>

                                        <!-- Location -->

                                        <td class="ps-4 fw-semibold">

                                            @item.Location

                                        </td>


                                        <!-- Address -->

                                        <td>

                                            <div class="record-text">

                                                @item.Address

                                            </div>

                                        </td>


                                        <!-- Managed By -->

                                        <td>

                                            <div class="record-text">

                                                @item.ManagedBy

                                            </div>

                                        </td>


                                        <!-- Staff List -->

                                        <td>

                                            @if (!string.IsNullOrWhiteSpace(item.StaffList))
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger view-staff-pdf-btn"
                                                        data-id="@item.DentalFieldPracticeAreaId">

                                                    <i class="bi bi-file-earmark-pdf me-1"></i>
                                                    View PDF

                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Not uploaded
                                                </span>
                                            }

                                        </td>


                                        <!-- Population Served -->

                                        <td class="fw-semibold">

                                            @item.PopulationServed

                                        </td>


                                        <!-- Actions -->

                                        <td class="text-end pe-4">

                                            <a asp-action="Edit"
                                               asp-route-id="@item.DentalFieldPracticeAreaId"
                                               class="btn btn-sm btn-outline-primary action-btn me-1"
                                               title="Edit">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <form asp-action="Delete"
                                                  asp-route-id="@item.DentalFieldPracticeAreaId"
                                                  method="post"
                                                  class="d-inline delete-dental-field-practice-form">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger action-btn"
                                                        title="Remove">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>

                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- ========================================================= -->
<!-- PDF VIEWER MODAL -->
<!-- ========================================================= -->

<div class="modal fade"
     id="staffPdfViewerModal"
     tabindex="-1"
     aria-labelledby="staffPdfViewerModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content">

            <!-- Header -->

            <div class="modal-header">

                <h5 class="modal-title"
                    id="staffPdfViewerModalLabel">

                    <i class="bi bi-file-earmark-pdf text-danger me-2"></i>

                    Staff List PDF

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <!-- Body -->

            <div class="modal-body p-0">

                <div id="staffPdfViewerLoading"
                     class="text-center py-5">

                    <div class="spinner-border text-primary"
                         role="status">

                        <span class="visually-hidden">
                            Loading...
                        </span>

                    </div>

                    <div class="mt-2 text-muted">
                        Loading PDF...
                    </div>

                </div>

                <iframe id="staffPdfViewer"
                        src=""
                        title="Staff List PDF Viewer"
                        style="
                    width: 100%;
                    height: 75vh;
                    border: 0;
                    display: none;
                    ">
                </iframe>

            </div>

            <!-- Footer -->

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    <i class="bi bi-x-circle me-1"></i>
                    Close

                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>


    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const form =
                document.getElementById(
                    "dentalFieldPracticeForm"
                );

            const isEditing =
                        @isEditing.ToString().ToLower();


            // ============================================================
            // SAVE / UPDATE
            // ============================================================

            if (form) {

                form.addEventListener(
                    "submit",
                    function(event) {

                        let errors = [];


                        const location =
                            document.getElementById("Location");

                        const address =
                            document.getElementById("Address");

                        const managedBy =
                            document.getElementById("ManagedBy");

                        const staffListFile =
                            document.getElementById("StaffListFile");

                        const populationServed =
                            document.getElementById(
                                "PopulationServed"
                            );


                        // ------------------------------------------------
                        // Location
                        // ------------------------------------------------

                        if (!location ||
                            !location.value.trim()) {

                            errors.push(
                                "Please enter Location."
                            );

                        }


                        // ------------------------------------------------
                        // Address
                        // ------------------------------------------------

                        if (!address ||
                            !address.value.trim()) {

                            errors.push(
                                "Please enter Address."
                            );

                        }


                        // ------------------------------------------------
                        // Managed By
                        // ------------------------------------------------

                        if (!managedBy ||
                            !managedBy.value.trim()) {

                            errors.push(
                                "Please enter Managed By."
                            );

                        }


                        // ------------------------------------------------
                        // Staff List
                        // ------------------------------------------------

                        if (staffListFile &&
                            staffListFile.files.length > 0) {

                            const file =
                                staffListFile.files[0];

                            const extension =
                                file.name
                                    .split(".")
                                    .pop()
                                    .toLowerCase();


                            if (extension !== "pdf") {

                                errors.push(
                                    "Staff List must be a PDF file."
                                );

                            }


                            const maxFileSize = 2 * 1024 * 1024; // 2 MB

                            if (file.size > maxFileSize) {

                                errors.push(
                                    "Staff List file size must not exceed 2 MB."
                                );

                            }

                        }


                        // ------------------------------------------------
                        // Population
                        // ------------------------------------------------

                        if (!populationServed ||
                            !populationServed.value ||
                            parseInt(
                                populationServed.value
                            ) <= 0) {

                            errors.push(
                                "Please enter a valid Population Served."
                            );

                        }


                        // =================================================
                        // VALIDATION ERROR
                        // =================================================

                        if (errors.length > 0) {

                            event.preventDefault();


                            Swal.fire({

                                icon: "warning",

                                title: "Validation Required",

                                html: errors.map(function(error) {

                                    return '<div class="text-start mb-1">• '
                                        + error +
                                        '</div>';

                                }).join(""),

                                confirmButtonText: "OK",

                                confirmButtonColor: "#1769aa"

                            });

                            return;

                        }


                        // =================================================
                        // CONFIRM SAVE / UPDATE
                        // =================================================

                        event.preventDefault();


                        Swal.fire({

                            icon: "question",

                            title: isEditing
                                ? "Update Field Practice Area?"
                                : "Save Field Practice Area?",

                            text: isEditing
                                ? "Are you sure you want to update this record?"
                                : "Are you sure you want to save this record?",

                            showCancelButton: true,

                            confirmButtonText: isEditing
                                ? "Yes, Update"
                                : "Yes, Save",

                            cancelButtonText: "Cancel",

                            reverseButtons: true,

                            confirmButtonColor: "#1769aa"

                        }).then(function(result) {

                            if (result.isConfirmed) {

                                const button =
                                    document.getElementById(
                                        "saveDentalFieldPracticeBtn"
                                    );


                                button.disabled = true;


                                button.innerHTML =
                                    '<span class="spinner-border spinner-border-sm me-1"></span>' +
                                    (
                                        isEditing
                                            ? "Updating..."
                                            : "Saving..."
                                    );


                                form.submit();

                            }

                        });

                    });

            }

            // ============================================================
            // STAFF LIST FILE VALIDATION
            // ============================================================

            const staffListInput =
                document.getElementById("StaffListFile");

            if (staffListInput) {

                staffListInput.addEventListener("change", function() {

                    const file = this.files[0];

                    if (!file) {
                        return;
                    }

                    const maxFileSize = 2 * 1024 * 1024; // 2 MB

                    const extension =
                        file.name
                            .split(".")
                            .pop()
                            .toLowerCase();

                    // ----------------------------------------------------
                    // PDF validation
                    // ----------------------------------------------------

                    if (extension !== "pdf") {

                        Swal.fire({
                            icon: "error",
                            title: "Invalid File",
                            text: "Only PDF files are allowed for Staff List.",
                            confirmButtonText: "OK",
                            confirmButtonColor: "#1769aa"
                        });

                        this.value = "";
                        return;
                    }

                    // ----------------------------------------------------
                    // File size validation
                    // ----------------------------------------------------

                    if (file.size > maxFileSize) {

                        Swal.fire({
                            icon: "error",
                            title: "File Too Large",
                            text: "Staff List PDF size must not exceed 2 MB.",
                            confirmButtonText: "OK",
                            confirmButtonColor: "#1769aa"
                        });

                        this.value = "";
                        return;
                    }

                });
            }


            // ============================================================
            // STAFF LIST PDF VIEWER
            // ============================================================

            const pdfModalElement =
                document.getElementById("staffPdfViewerModal");

            const pdfViewer =
                document.getElementById("staffPdfViewer");

            const pdfLoading =
                document.getElementById("staffPdfViewerLoading");

            const pdfModal =
                pdfModalElement
                    ? new bootstrap.Modal(pdfModalElement)
                    : null;

            document
                .querySelectorAll(".view-staff-pdf-btn")
                .forEach(function(button) {

                    button.addEventListener("click", function() {

                        const id = this.dataset.id;

                        if (!id || !pdfModal) {
                            return;
                        }

                        // Reset viewer
                        pdfViewer.style.display = "none";
                        pdfLoading.style.display = "block";
                        pdfViewer.src = "";

                        // Show modal
                        pdfModal.show();

                        // Load PDF
                        pdfViewer.src =
                            '@Url.Action("ViewStaffList", "DentalFieldPracticeArea")'
                            + '?id='
                            + encodeURIComponent(id);

                        pdfViewer.onload = function() {

                            pdfLoading.style.display = "none";
                            pdfViewer.style.display = "block";

                        };

                    });

                });


            // ------------------------------------------------------------
            // Clear PDF when modal closes
            // ------------------------------------------------------------

            if (pdfModalElement) {

                pdfModalElement.addEventListener(
                    "hidden.bs.modal",
                    function() {

                        pdfViewer.src = "";

                        pdfViewer.style.display = "none";

                        pdfLoading.style.display = "block";

                    }
                );

            }

            // ============================================================
            // DELETE CONFIRMATION
            // ============================================================

            document
                .querySelectorAll(
                    ".delete-dental-field-practice-form"
                )
                .forEach(function(deleteForm) {

                    deleteForm.addEventListener(
                        "submit",
                        function(event) {

                            event.preventDefault();


                            Swal.fire({

                                icon: "warning",

                                title:
                                    "Remove Field Practice Area?",

                                text:
                                    "Are you sure you want to remove this field practice area record?",

                                showCancelButton: true,

                                confirmButtonText:
                                    "Yes, Remove",

                                cancelButtonText:
                                    "Cancel",

                                reverseButtons: true,

                                confirmButtonColor:
                                    "#dc3545"

                            }).then(function(result) {

                                if (result.isConfirmed) {

                                    deleteForm.submit();

                                }

                            });

                        });

                });


            // ============================================================
            // SERVER VALIDATION SUMMARY
            // ============================================================

            const validationSummary =
                document.querySelector(
                    "[data-valmsg-summary='true']"
                );


            if (validationSummary) {

                const errorItems =
                    validationSummary.querySelectorAll("li");


                if (errorItems.length > 0) {

                    let messages = [];


                    errorItems.forEach(function(item) {

                        const message =
                            item.textContent.trim();


                        if (message) {

                            messages.push(message);

                        }

                    });


                    if (messages.length > 0) {

                        Swal.fire({

                            icon: "error",

                            title: "Unable to Save",

                            html: messages.map(function(message) {

                                return '<div class="text-start mb-1">• '
                                    + message +
                                    '</div>';

                            }).join(""),

                            confirmButtonText: "OK",

                            confirmButtonColor: "#1769aa"

                        });

                    }

                }

            }

        });

    </script>


    <!-- ============================================================= -->
    <!-- SUCCESS MESSAGE -->
    <!-- ============================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <script>

            Swal.fire({

                icon: "success",

                title: "Success",

                text: @Html.Raw(
                                System.Text.Json.JsonSerializer.Serialize(
                                TempData["SuccessMessage"]?.ToString()
                                )
                                ),

                confirmButtonText: "OK",

                confirmButtonColor: "#1769aa"

            });

        </script>
    }


    <!-- ============================================================= -->
    <!-- ERROR MESSAGE -->
    <!-- ============================================================= -->
    @if (TempData["ErrorMessage"] != null)
    {
        <script>

            Swal.fire({

                icon: "error",

                title: "Error",

                text: @Html.Raw(
                                System.Text.Json.JsonSerializer.Serialize(
                                TempData["ErrorMessage"]?.ToString()
                                )
                                ),

                confirmButtonText: "OK",

                confirmButtonColor: "#dc3545"

            });

        </script>
    }

}