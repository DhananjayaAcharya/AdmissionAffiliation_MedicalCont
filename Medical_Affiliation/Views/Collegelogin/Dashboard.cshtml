                            <i class="bi bi-check2-circle"></i> Save Logo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const dentalApplicationReportUrl =
        '@Url.Action("GetDentalApplicationReport", "Collegelogin")';
    </script>

    <script>
        window.CourseScheduleUrl = '@Url.Action("GetSchedule", "CourseLevelSchedule")';
    </script>
    <script src="~/js/course-schedule.js" asp-append-version="true"></script>

    <script>
        // Greeting + date
        (function () {
        var h = new Date().getHours();
        var g = h < 12 ? 'Good morning' : (h < 17 ? 'Good afternoon' : 'Good evening');
        var gEl = document.getElementById('greeting');
        if (gEl) gEl.textContent = g;
        var dEl = document.getElementById('todayLabel');
        if (dEl) dEl.textContent = new Date().toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
        })();

        // Password toggle
        (function () {
        const toggle = document.querySelector('.toggle-password');
        const input = document.getElementById('NewPassword');
        const icon = document.getElementById('toggleIcon');
        if (toggle && input) {
        toggle.addEventListener('click', function () {
        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        });
        }
        })();

        // Change password shortcut
        function goToChangePassword(e) {
        if (e) e.preventDefault();
        const modalElement = document.getElementById('updatePasswordModal');
        if (!modalElement) return;
        if (modalElement.parentElement !== document.body) document.body.appendChild(modalElement);
        bootstrap.Modal.getOrCreateInstance(modalElement).show();
        }

        // College Profile shortcut — fetch current values, then show modal
        function goToCollegeProfile(e) {
        if (e) e.preventDefault();

        var url = '@Url.Action("GetCollegeProfile", "Collegelogin")' + '?collegeCode=' + encodeURIComponent('@collegeCode');

        fetch(url)
        .then(function (r) { return r.json(); })
        .then(function (data) {
        if (!data || !data.success) return;
        document.getElementById('cpCollegeName').value = data.collegeName || '';
        document.getElementById('cpPrincipalName').value = data.principalName || '';
        document.getElementById('cpAddress').value = data.address || '';
        document.getElementById('cpEmail').value = data.email || '';
        document.getElementById('cpPhoneNumber').value = data.phoneNumber || '';
        document.getElementById('cpEstablishedYear').value = data.establishedYear || '';
        document.getElementById('cpWebsite').value = data.website || '';

        var img = document.getElementById('logoPreviewImg');
        var placeholder = document.getElementById('logoPreviewPlaceholder');
        if (data.logoPath) {
        img.src = data.logoPath + '?t=' + Date.now();
        img.style.display = 'block';
        placeholder.style.display = 'none';
        } else {
        img.style.display = 'none';
        placeholder.style.display = 'grid';
        }
        })
        .catch(function (err) { console.error('GetCollegeProfile error:', err); })
        .finally(function () {
        bootstrap.Modal.getOrCreateInstance(document.getElementById('collegeProfileModal')).show();
        });
        }

        // Live preview of a newly chosen logo file before it's uploaded
        document.getElementById('logoFileInput').addEventListener('change', function (e) {
        var file = e.target.files && e.target.files[0];
        if (!file) return;

        var img = document.getElementById('logoPreviewImg');
        var placeholder = document.getElementById('logoPreviewPlaceholder');
        var reader = new FileReader();
        reader.onload = function (evt) {
        img.src = evt.target.result;
        img.style.display = 'block';
        placeholder.style.display = 'none';
        };
        reader.readAsDataURL(file);
        });

        // Affiliation deadline notification
        @if (TempData["ShowAffiliationNotification"] != null && (bool)TempData["ShowAffiliationNotification"] || ViewBag.ShowAffiliationNotification == true)
        {
            <text>
                (function () {
                // Guard: never run this block more than once per page load,
                // even if the surrounding script were somehow injected twice.
                if (window.__affiliationNoticeInit) return;
                window.__affiliationNoticeInit = true;

                function forceUnlockPage() {
                document.querySelectorAll('.modal-backdrop').forEach(function (bd) { bd.remove(); });
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('overflow');
                document.body.style.removeProperty('padding-right');
                }

                window.addEventListener('load', function () {
                setTimeout(function () {
                var notificationModalElement = document.getElementById('affiliationNotificationModal');
                if (!notificationModalElement) return;

                // Clear out anything left over from an earlier/duplicate init
                // BEFORE we show, so we never stack two backdrops.
                forceUnlockPage();

                var notificationModal = new bootstrap.Modal(notificationModalElement, {
                // Keep the notification visible without blocking dashboard controls.
                backdrop: false,
                keyboard: true
                });

                notificationModalElement.addEventListener('hidden.bs.modal', forceUnlockPage);
                notificationModalElement.querySelectorAll('[data-bs-dismiss="modal"]').forEach(function (button) {
                button.addEventListener('click', function () {
                notificationModal.hide();
                forceUnlockPage();
                });
                });

                CourseSchedule.ready.then(function () { notificationModal.show(); });

                // Failsafe: if nothing has cleaned up after 20s (e.g. a click
                // never registered), force-unlock the page automatically so
                // it's never permanently stuck.
                setTimeout(function () {
                if (document.querySelectorAll('.modal-backdrop').length > 1) {
                forceUnlockPage();
                }
                }, 20000);
                }, 300);
                });

                // Manual escape hatch you can run from the browser console at any time:
                // window.__forceUnlockPage()
                window.__forceUnlockPage = forceUnlockPage;
                })();
            </text>
        }
    </script>
    <script src="~/js/ca-dental-application-status.js"></script>
</body>
</html>
