@using Microsoft.AspNetCore.Http
@model DashboardViewModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Dashboard";
    var repositoryRows = ViewBag.RepositoryRows as List<UgandPgrepository> ?? new List<UgandPgrepository>();
    var facultyCode = HttpContextAccessor.HttpContext?.Session.GetString("FacultyCode") ?? "";
    var facultyName = !string.IsNullOrWhiteSpace(Model?.FacultyName)
        ? Model.FacultyName
        : (ViewBag.FacultyName as string ?? HttpContextAccessor.HttpContext?.Session.GetString("FacultyName") ?? "");
    Context.Response.Headers["Cache-Control"] = "no-cache, no-store, must-revalidate";
    Context.Response.Headers["Pragma"] = "no-cache";
    Context.Response.Headers["Expires"] = "0";
    var collegeName = !string.IsNullOrWhiteSpace(Model?.CollegeName)
        ? Model.CollegeName
        : (ViewBag.CollegeName as string ?? "College");
    var collegeCode = !string.IsNullOrWhiteSpace(Model?.CollegeCode)
        ? Model.CollegeCode
        : (ViewBag.CollegeCode as string ?? "");
    var collegeLogoPath = !string.IsNullOrWhiteSpace(Model?.CollegeLogoPath)
        ? Model.CollegeLogoPath
        : (ViewBag.CollegeLogoPath as string ?? HttpContextAccessor.HttpContext?.Session.GetString("CollegeLogoPath") ?? "");
    var principalName = !string.IsNullOrWhiteSpace(Model?.PrincipalName)
        ? Model.PrincipalName
        : (ViewBag.PrincipalName as string ?? "");
    var actionCount = 3;   // Applications · Security Settings · College Profile
    var showDeadline = !string.IsNullOrEmpty(facultyCode);   // card is filled (or hidden) by course-schedule.js
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — RGUHS Academic Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
            /* ═══════════════════════════════════════════════════════════
                       RGUHS Portal · Dashboard — White & Gray design system
                       ═══════════════════════════════════════════════════════════ */
            :root {
                /* Neutral scale */
                --white: #ffffff;
                --g-25: #fcfcfd;
                --g-50: #f7f8fa;
                --g-100: #f1f3f6;
                --g-150: #eceff3;
                --g-200: #e3e7ed;
                --g-300: #cfd5de;
                --g-400: #a4adbb;
                --g-500: #7b8596;
                --g-600: #596273;
                --g-700: #3d4554;
                --g-800: #232936;
                --g-900: #111520;
                /* Semantic (used sparingly: status only) */
                --ok: #16a34a;
                --ok-bg: #ecfdf3;
                --ok-line: #bbf0cf;
                --warn: #b45309;
                --warn-bg: #fff8eb;
                --warn-line: #fde2a8;
                --bad: #dc2626;
                --bad-bg: #fff1f1;
                --bad-line: #fccaca;
                --ink: var(--g-900);
                --ink-2: var(--g-600);
                --ink-3: var(--g-500);
                --line: var(--g-200);
                --topbar-h: 66px;
                --r-sm: 10px;
                --r-md: 16px;
                --r-lg: 24px;
                --sh-xs: 0 1px 2px rgba(17,21,32,.05);
                --sh-sm: 0 2px 8px rgba(17,21,32,.06);
                --sh-md: 0 10px 30px rgba(17,21,32,.08);
                --sh-lg: 0 24px 60px rgba(17,21,32,.12);
                --ease: cubic-bezier(.22,.8,.3,1);
                --dur: .25s;
            }

            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html {
                scroll-behavior: smooth;
                font-size: 15px;
            }

            body {
                font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
                background: var(--g-50);
                color: var(--ink);
                min-height: 100vh;
                -webkit-font-smoothing: antialiased;
                position: relative;
                overflow-x: hidden;
            }

                /* faint dotted grid + soft gray glows */
                body::before {
                    content: '';
                    position: fixed;
                    inset: 0;
                    z-index: 0;
                    pointer-events: none;
                    background: radial-gradient(700px 380px at 92% -4%, rgba(17,21,32,.05), transparent 70%), radial-gradient(600px 360px at -4% 100%, rgba(17,21,32,.045), transparent 70%), radial-gradient(rgba(17,21,32,.06) 1px, transparent 1px);
                    background-size: auto, auto, 26px 26px;
                    mask-image: linear-gradient(180deg, #000 0%, rgba(0,0,0,.55) 100%);
                    -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0,0,0,.55) 100%);
                }

            /* ── Watermark ───────────────────────────────── */
            .wm {
                position: fixed;
                inset: 0;
                display: grid;
                place-items: center;
                pointer-events: none;
                user-select: none;
                z-index: 0;
                padding-top: calc(var(--topbar-h) + 3px);
            }

                .wm img {
                    width: min(42vw, 480px);
                    height: auto;
                    opacity: .05;
                    mix-blend-mode: multiply;
                    filter: grayscale(1);
                }

            /* ── Top accent line ─────────────────────────── */
            .gov-strip {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                z-index: 1001;
                background: linear-gradient(90deg, var(--g-900), var(--g-500) 50%, var(--g-900));
            }

            /* ── Topbar ──────────────────────────────────── */
            .topbar {
                position: fixed;
                inset: 3px 0 auto 0;
                height: var(--topbar-h);
                background: rgba(255,255,255,.86);
                backdrop-filter: saturate(180%) blur(18px);
                -webkit-backdrop-filter: saturate(180%) blur(18px);
                border-bottom: 1px solid var(--line);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 28px;
                z-index: 1000;
            }

            .tb-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                flex-shrink: 0;
            }

            .tb-logo {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                overflow: hidden;
                display: grid;
                place-items: center;
                background: #fff;
                border: 1px solid var(--line);
                box-shadow: var(--sh-sm);
            }

                .tb-logo img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }

            .tb-brand-text {
                line-height: 1.2;
            }

            .tb-brand-name {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 16px;
                font-weight: 800;
                color: var(--ink);
                letter-spacing: -.2px;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .tb-official-badge {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                font-family: 'Inter', sans-serif;
                font-size: 9px;
                font-weight: 700;
                letter-spacing: .06em;
                text-transform: uppercase;
                color: var(--g-700);
                background: var(--g-100);
                border: 1px solid var(--g-200);
                padding: 2px 8px;
                border-radius: 20px;
            }

            .tb-brand-sub {
                font-size: 10px;
                color: var(--g-400);
                text-transform: uppercase;
                letter-spacing: 1.3px;
                font-weight: 500;
            }

            .tb-centre {
                position: absolute;
                left: 50%;
                transform: translateX(-50%);
                display: flex;
                align-items: center;
                gap: 10px;
                background: var(--g-50);
                border: 1px solid var(--line);
                border-radius: 999px;
                padding: 6px 18px 6px 8px;
                max-width: 520px;
                min-width: 0;
            }

            .tb-centre-ico {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: var(--g-900);
                color: #fff;
                display: grid;
                place-items: center;
                font-size: 13px;
                flex-shrink: 0;
            }

            .tb-centre-logo {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                object-fit: cover;
                border: 1px solid var(--line);
                background: #fff;
                flex-shrink: 0;
            }

            .tb-centre-inner {
                min-width: 0;
            }

            .tb-centre-label {
                font-size: 9px;
                color: var(--g-400);
                text-transform: uppercase;
                letter-spacing: 1.1px;
                line-height: 1;
                margin-bottom: 2px;
                font-weight: 600;
            }

            .tb-centre-name {
                font-size: 13px;
                font-weight: 600;
                color: var(--ink);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .tb-right {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .tb-code {
                background: var(--g-900);
                color: #fff;
                padding: 6px 14px;
                border-radius: 999px;
                font-size: 11.5px;
                font-weight: 700;
                letter-spacing: .8px;
            }

            .btn-logout {
                display: flex;
                align-items: center;
                gap: 6px;
                background: #fff;
                border: 1px solid var(--g-300);
                color: var(--g-700);
                border-radius: 999px;
                padding: 7px 16px 7px 12px;
                font-family: inherit;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                transition: all var(--dur) var(--ease);
            }

                .btn-logout:hover {
                    background: var(--g-900);
                    border-color: var(--g-900);
                    color: #fff;
                    transform: translateY(-1px);
                    box-shadow: var(--sh-sm);
                }

            /* ── Layout ──────────────────────────────────── */
            .layout {
                position: relative;
                z-index: 1;
                display: flex;
                align-items: flex-start;
                padding-top: calc(var(--topbar-h) + 3px);
                min-height: 100vh;
            }

            .sidebar-wrap {
                width: 280px;
                flex-shrink: 0;
                position: sticky;
                top: calc(var(--topbar-h) + 3px);
                height: calc(100vh - var(--topbar-h) - 3px);
                background: transparent;
                padding: 0;
                transition: width var(--dur) var(--ease);
            }

            body.app-sidebar-collapsed .sidebar-wrap {
                width: 68px;
            }

            .main {
                flex: 1;
                min-width: 0;
                padding: 30px 40px 64px;
                max-width: 1440px;
                margin: 0 auto;
            }

            /* ── Sidebar (white / gray, overrides component CSS) ── */
            body .sidebar {
                background: #fff !important;
                color: var(--ink) !important;
                border: none !important;
                border-right: 1px solid var(--line) !important;
                border-radius: 0 !important;
                box-shadow: 10px 0 36px rgba(17,21,32,.04) !important;
                overflow-x: hidden;
            }

                body .sidebar::-webkit-scrollbar {
                    width: 6px;
                }

                body .sidebar::-webkit-scrollbar-thumb {
                    background: var(--g-300) !important;
                    border-radius: 99px;
                }

                body .sidebar::-webkit-scrollbar-track {
                    background: transparent;
                }

                body .sidebar .sidebar-header {
                    background: linear-gradient(180deg, var(--g-100), #fff) !important;
                    border-bottom: 1px solid var(--line) !important;
                }

                    body .sidebar .sidebar-header::after {
                        background: linear-gradient(90deg, var(--g-900), var(--g-400) 55%, transparent) !important;
                        height: 2px !important;
                    }

                    body .sidebar .sidebar-header h4 {
                        color: var(--ink) !important;
                        font-family: 'Plus Jakarta Sans', sans-serif !important;
                        font-weight: 800 !important;
                        letter-spacing: -.2px;
                    }

                body .sidebar .sidebar-header-sub {
                    color: var(--g-500) !important;
                }

                body .sidebar .sidebar-header-ico {
                    background: var(--g-900) !important;
                    border: none !important;
                    color: #fff !important;
                    box-shadow: 0 8px 18px rgba(17,21,32,.2) !important;
                }

                body .sidebar .sidebar-official-badge {
                    background: var(--g-100) !important;
                    border-color: var(--g-200) !important;
                    color: var(--g-700) !important;
                }

                body .sidebar .sidebar-section-label,
                body .sidebar .sidebar-footer-label {
                    color: var(--g-400) !important;
                    letter-spacing: 1.4px;
                    font-weight: 700;
                }

                body .sidebar .sidebar-link {
                    position: relative;
                    color: var(--g-700) !important;
                    border-radius: 12px !important;
                    border: 1px solid transparent !important;
                    transition: background .25s var(--ease), transform .25s var(--ease), color .2s, border-color .2s !important;
                }

                    body .sidebar .sidebar-link i:first-child {
                        width: 34px;
                        height: 34px;
                        display: inline-grid;
                        place-items: center;
                        flex-shrink: 0;
                        border-radius: 10px;
                        background: var(--g-100);
                        color: var(--g-600) !important;
                        transition: all .25s var(--ease);
                    }

                    body .sidebar .sidebar-link .notification-nav-icon i,
                    body .sidebar .sidebar-link .chevron {
                        color: var(--g-500) !important;
                    }

                    body .sidebar .sidebar-link:hover {
                        background: var(--g-100) !important;
                        border-color: var(--g-200) !important;
                        color: var(--ink) !important;
                        transform: translateX(3px);
                    }

                        body .sidebar .sidebar-link:hover i:first-child {
                            background: #fff;
                            color: var(--ink) !important;
                            box-shadow: var(--sh-xs);
                        }

                        body .sidebar .sidebar-link:hover .notification-nav-icon i {
                            color: var(--ink) !important;
                        }

                    body .sidebar .sidebar-link.active {
                        background: var(--g-900) !important;
                        border-color: var(--g-900) !important;
                        color: #fff !important;
                        font-weight: 600;
                        box-shadow: 0 12px 26px rgba(17,21,32,.22) !important;
                    }

                        body .sidebar .sidebar-link.active i:first-child {
                            background: rgba(255,255,255,.14);
                            color: #fff !important;
                        }

                        body .sidebar .sidebar-link.active .notification-nav-icon i,
                        body .sidebar .sidebar-link.active .chevron {
                            color: #fff !important;
                        }

                    body .sidebar .sidebar-link.expanded {
                        background: var(--g-100) !important;
                    }

                        body .sidebar .sidebar-link.expanded .chevron {
                            color: var(--ink) !important;
                        }

                body .sidebar .affiliation-dropdown {
                    background: var(--g-50) !important;
                    border: 1px solid var(--g-200) !important;
                    border-radius: 14px !important;
                }

                body .sidebar .affiliation-option {
                    color: var(--g-700) !important;
                    border-radius: 10px;
                }

                    body .sidebar .affiliation-option:hover {
                        background: var(--g-100) !important;
                        color: var(--ink) !important;
                    }

                    body .sidebar .affiliation-option i {
                        color: var(--g-400) !important;
                    }

                body .sidebar .affiliation-submenu {
                    background: #fff !important;
                    border-left: 2px solid var(--g-300);
                    border-radius: 0 0 12px 12px;
                }

                body .sidebar .affiliation-subitem {
                    color: var(--g-600) !important;
                    border-radius: 10px;
                }

                    body .sidebar .affiliation-subitem:hover {
                        background: var(--g-100) !important;
                        color: var(--ink) !important;
                    }

                    body .sidebar .affiliation-subitem.active {
                        background: var(--g-900) !important;
                        color: #fff !important;
                        font-weight: 700;
                    }

                    body .sidebar .affiliation-subitem.readonly {
                        color: var(--g-400) !important;
                    }

                body .sidebar .affiliation-loading {
                    color: var(--g-500) !important;
                }

                body .sidebar .sidebar-footer {
                    background: var(--g-50) !important;
                    border-top: 1px solid var(--line) !important;
                }

                body .sidebar .sidebar-action-btn {
                    background: #fff !important;
                    border: 1px solid var(--g-200) !important;
                    color: var(--g-700) !important;
                    border-radius: 12px !important;
                    transition: all .25s var(--ease) !important;
                }

                    body .sidebar .sidebar-action-btn i {
                        color: var(--g-500) !important;
                    }

                    body .sidebar .sidebar-action-btn:hover {
                        background: var(--g-100) !important;
                        border-color: var(--g-300) !important;
                        color: var(--ink) !important;
                        transform: translateY(-1px);
                    }

                        body .sidebar .sidebar-action-btn:hover i {
                            color: var(--ink) !important;
                        }

                    body .sidebar .sidebar-action-btn.primary {
                        background: var(--g-900) !important;
                        border-color: var(--g-900) !important;
                        color: #fff !important;
                        font-weight: 700;
                        box-shadow: 0 10px 22px rgba(17,21,32,.2) !important;
                    }

                        body .sidebar .sidebar-action-btn.primary i {
                            color: #fff !important;
                        }

                        body .sidebar .sidebar-action-btn.primary:hover {
                            background: var(--g-700) !important;
                            border-color: var(--g-700) !important;
                            color: #fff !important;
                        }

                body .sidebar .sidebar-handle {
                    background: #fff !important;
                    color: var(--ink) !important;
                    border: 1px solid var(--g-300) !important;
                    box-shadow: var(--sh-sm) !important;
                    transition: transform .25s var(--ease) !important;
                }

                    body .sidebar .sidebar-handle:hover {
                        background: var(--g-100) !important;
                        transform: scale(1.08);
                    }

                body .sidebar .notification-badge {
                    background: var(--g-900) !important;
                    color: #fff !important;
                    border: 2px solid #fff !important;
                }

            body .password-modal .modal-header {
                background: #fff !important;
                border-bottom: 1px solid var(--line) !important;
            }

            body .password-modal .modal-title {
                color: var(--ink) !important;
            }

            body .password-modal .btn-close {
                filter: none !important;
            }

            /* ── Page header ─────────────────────────────── */
            .page-header {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 20px;
                margin-bottom: 22px;
                flex-wrap: wrap;
            }

            .page-eyebrow {
                display: flex;
                align-items: center;
                gap: 6px;
                font-size: 11px;
                font-weight: 600;
                color: var(--g-500);
                text-transform: uppercase;
                letter-spacing: 1.2px;
                margin-bottom: 10px;
            }

                .page-eyebrow i {
                    font-size: 12px;
                }

            .page-title {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 32px;
                font-weight: 800;
                color: var(--ink);
                line-height: 1.12;
                letter-spacing: -.8px;
            }

            .header-chips {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
            }

            .chip {
                display: flex;
                align-items: center;
                gap: 8px;
                background: #fff;
                border: 1px solid var(--line);
                border-radius: 999px;
                padding: 8px 16px;
                font-size: 12.5px;
                font-weight: 600;
                color: var(--g-700);
                box-shadow: var(--sh-xs);
                white-space: nowrap;
            }

                .chip i {
                    color: var(--g-500);
                }

                .chip.live {
                    color: var(--g-700);
                }

            .status-dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--ok);
                animation: pulse 2s infinite;
            }

            @@keyframes pulse {
                0% {
                    box-shadow: 0 0 0 0 rgba(22,163,74,.45);
                }

                70% {
                    box-shadow: 0 0 0 8px rgba(22,163,74,0);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(22,163,74,0);
                }
            }

            /* ── Hero ────────────────────────────────────── */
            .hero {
                position: relative;
                overflow: hidden;
                border-radius: var(--r-lg);
                padding: 34px 38px;
                background: radial-gradient(520px 280px at 100% 0%, rgba(255,255,255,.10), transparent 70%), linear-gradient(135deg, var(--g-900) 0%, var(--g-800) 55%, var(--g-700) 100%);
                color: #fff;
                box-shadow: var(--sh-lg);
                margin-bottom: 20px;
                display: grid;
                grid-template-columns: minmax(0, 1fr) auto;
                gap: 28px;
                align-items: center;
            }

                .hero::after {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background-image: radial-gradient(rgba(255,255,255,.13) 1px, transparent 1px);
                    background-size: 22px 22px;
                    -webkit-mask-image: linear-gradient(110deg, transparent 35%, #000);
                    mask-image: linear-gradient(110deg, transparent 35%, #000);
                    pointer-events: none;
                }

                .hero > * {
                    position: relative;
                    z-index: 1;
                }

            .hero-badge {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                background: rgba(255,255,255,.10);
                border: 1px solid rgba(255,255,255,.2);
                padding: 5px 13px;
                border-radius: 999px;
                font-size: 10.5px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1.2px;
                margin-bottom: 16px;
            }

            .hero-id {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .hero-logo, .hero-logo-ph {
                width: 64px;
                height: 64px;
                border-radius: 18px;
                flex-shrink: 0;
            }

            .hero-logo {
                object-fit: cover;
                background: #fff;
                border: 3px solid rgba(255,255,255,.4);
                box-shadow: 0 10px 24px rgba(0,0,0,.3);
            }

            .hero-logo-ph {
                background: rgba(255,255,255,.1);
                border: 1.5px dashed rgba(255,255,255,.4);
                display: grid;
                place-items: center;
                font-size: 24px;
            }

            /* Logo states: working logo → image only · no/broken logo → dashed upload slot + hanging tag */
            .hero-logo {
                display: block;
                overflow: hidden;
            }

            .hero-id:not(.has-tag) .hero-logo-ph,
            .hero-id:not(.has-tag) .logo-tag {
                display: none;
            }

            .hero-id.has-tag .hero-logo {
                display: none;
            }

            .hero-id.has-tag .logo-edit-badge {
                display: none;
            }

            .hero-id.has-tag .hero-logo-ph {
                background: rgba(255,255,255,.12);
                border: 2px dashed rgba(255,255,255,.55);
                color: #fff;
                animation: slotGlow 2.6s ease-in-out infinite;
            }

            @@keyframes slotGlow {
                0%, 100% {
                    box-shadow: 0 0 0 0 rgba(255,255,255,.35);
                }

                50% {
                    box-shadow: 0 0 0 9px rgba(255,255,255,0);
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                .hero-id.has-tag .hero-logo-ph {
                    animation: none;
                }
            }

            /* Logo upload trigger + hanging tag */
            .hero-id.has-tag {
                margin-bottom: 78px;
            }

            .logo-slot {
                position: relative;
                flex-shrink: 0;
                width: 64px;
                height: 64px;
            }

            .logo-upload-trigger {
                position: relative;
                display: block;
                width: 64px;
                height: 64px;
                padding: 0;
                border: 0;
                background: none;
                border-radius: 18px;
                cursor: pointer;
                transition: transform var(--dur) var(--ease);
            }

                .logo-upload-trigger:hover {
                    transform: scale(1.05);
                }

                .logo-upload-trigger:focus-visible, .logo-tag:focus-visible {
                    outline: 2px solid #fff;
                    outline-offset: 3px;
                }

            .logo-edit-badge {
                position: absolute;
                right: -6px;
                bottom: -6px;
                width: 24px;
                height: 24px;
                border-radius: 50%;
                background: #fff;
                color: var(--g-900);
                display: grid;
                place-items: center;
                font-size: 11px;
                box-shadow: 0 4px 10px rgba(0,0,0,.3);
                border: 2px solid var(--g-800);
            }

            .logo-tag {
                position: absolute;
                top: 58px;
                left: 0;
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                padding: 0;
                border: 0;
                background: none;
                cursor: pointer;
                transform-origin: 31px 0;
                animation: tagSwing 3.4s ease-in-out infinite;
                z-index: 3;
                filter: drop-shadow(0 10px 14px rgba(0,0,0,.35));
            }

                .logo-tag:hover {
                    animation-play-state: paused;
                }

            .logo-tag-string {
                width: 2px;
                height: 24px;
                margin-left: 30px;
                background: repeating-linear-gradient(180deg, #e3e7ed 0 4px, #a4adbb 4px 8px);
                border-radius: 2px;
            }

            .logo-tag-body {
                position: relative;
                display: flex;
                align-items: center;
                gap: 9px;
                background: #fff;
                color: var(--g-900);
                padding: 20px 14px 11px 14px;
                border-radius: 6px 14px 14px 14px;
                border: 1px dashed var(--g-300);
                white-space: nowrap;
                transition: background var(--dur), transform var(--dur) var(--ease);
            }

                .logo-tag-body::before { /* punched hole the string runs through */
                    content: '';
                    position: absolute;
                    top: 6px;
                    left: 24px;
                    width: 14px;
                    height: 14px;
                    border-radius: 50%;
                    background: var(--g-800);
                    box-shadow: inset 0 1px 2px rgba(0,0,0,.5);
                }

                .logo-tag-body > i {
                    font-size: 20px;
                    color: var(--g-800);
                    margin-top: 6px;
                }

            .logo-tag:hover .logo-tag-body {
                background: var(--g-100);
                transform: scale(1.04);
            }

            .logo-tag-text {
                font-size: 12.5px;
                font-weight: 800;
                line-height: 1.15;
                font-family: 'Plus Jakarta Sans', sans-serif;
                letter-spacing: -.1px;
                margin-top: 6px;
            }

                .logo-tag-text small {
                    display: block;
                    font-family: 'Inter', sans-serif;
                    font-size: 9px;
                    font-weight: 700;
                    letter-spacing: 1.4px;
                    text-transform: uppercase;
                    color: var(--g-500);
                }

            @@keyframes tagSwing {
                0%, 100% {
                    transform: rotate(-7deg);
                }

                50% {
                    transform: rotate(7deg);
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                .logo-tag {
                    animation: none;
                }
            }

            .hero-title {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 26px;
                font-weight: 800;
                line-height: 1.2;
                letter-spacing: -.5px;
            }

            .hero-meta {
                display: flex;
                gap: 8px;
                flex-wrap: wrap;
                margin-top: 10px;
            }

            .hero-pill {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-size: 11.5px;
                font-weight: 600;
                background: rgba(255,255,255,.1);
                border: 1px solid rgba(255,255,255,.18);
                color: rgba(255,255,255,.88);
                padding: 4px 11px;
                border-radius: 999px;
            }

            .hero-desc {
                font-size: 14px;
                color: rgba(255,255,255,.72);
                line-height: 1.7;
                max-width: 560px;
                margin-top: 16px;
            }

            .hero-actions {
                display: flex;
                flex-direction: column;
                gap: 10px;
                min-width: 210px;
            }

            .btn-solid, .btn-ghost {
                display: inline-flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                font-family: inherit;
                font-size: 13px;
                font-weight: 600;
                border-radius: 12px;
                padding: 12px 16px;
                cursor: pointer;
                text-decoration: none;
                transition: all var(--dur) var(--ease);
            }

            .btn-solid {
                background: #fff;
                color: var(--g-900);
                border: 1px solid transparent;
                box-shadow: 0 8px 20px rgba(0,0,0,.22);
            }

                .btn-solid:hover {
                    transform: translateY(-2px);
                    color: var(--g-900);
                    box-shadow: 0 14px 28px rgba(0,0,0,.3);
                }

            .btn-ghost {
                background: rgba(255,255,255,.08);
                color: #fff;
                border: 1px solid rgba(255,255,255,.28);
            }

                .btn-ghost:hover {
                    background: rgba(255,255,255,.16);
                    color: #fff;
                    transform: translateY(-2px);
                }

            /* ── Deadline strip (filled by course-schedule.js) ── */
            .deadline {
                position: relative;
                overflow: hidden;
                display: flex;
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
                gap: 32px;
                flex-wrap: wrap;
                padding: 18px 26px 18px 30px;
                margin-bottom: 20px;
                background: #fff;
                border: 1px solid var(--line);
                border-radius: var(--r-md);
                box-shadow: var(--sh-xs);
            }

                .deadline::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 0;
                    bottom: 0;
                    width: 5px;
                    background: var(--g-500);
                }

                .deadline.danger::before {
                    background: var(--bad);
                }

                .deadline.safe::before {
                    background: var(--ok);
                }

                .deadline[hidden] {
                    display: none;
                }

            .dl-main {
                flex: 1;
                min-width: 260px;
            }

            .dl-label {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1.1px;
                color: var(--g-500);
            }

                .dl-label i {
                    color: var(--g-700);
                    font-size: 14px;
                }

            .dl-row {
                display: flex;
                align-items: baseline;
                gap: 16px;
                flex-wrap: wrap;
                margin-top: 4px;
            }

            .dl-big {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 38px;
                font-weight: 800;
                line-height: 1;
                letter-spacing: -1.2px;
                color: var(--ink);
            }

                .dl-big small {
                    font-size: 13px;
                    font-weight: 600;
                    letter-spacing: 0;
                    color: var(--g-600);
                    margin-left: 6px;
                }

            .dl-msg {
                font-size: 13px;
                color: var(--g-600);
                line-height: 1.55;
            }

            .dl-side {
                width: 320px;
                max-width: 100%;
            }

            .dl-bar {
                height: 7px;
                background: var(--g-150);
                border-radius: 99px;
                overflow: hidden;
            }

                .dl-bar > div {
                    height: 100%;
                    width: 0;
                    border-radius: 99px;
                    background: var(--g-700);
                    transition: width 1s var(--ease);
                }

            .deadline.danger .dl-bar > div {
                background: var(--bad);
            }

            .deadline.safe .dl-bar > div {
                background: var(--ok);
            }

            .dl-foot {
                display: flex;
                justify-content: space-between;
                font-size: 11px;
                color: var(--g-500);
                margin-top: 8px;
                font-weight: 500;
            }

            /* ── Stats ───────────────────────────────────── */
            .stat-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
                gap: 16px;
                margin-bottom: 20px;
            }

            .stat-card {
                position: relative;
                overflow: hidden;
                background: #fff;
                border: 1px solid var(--line);
                border-radius: var(--r-md);
                padding: 20px;
                display: flex;
                align-items: flex-start;
                gap: 16px;
                box-shadow: var(--sh-xs);
                transition: all var(--dur) var(--ease);
            }

                .stat-card::after {
                    content: '';
                    position: absolute;
                    left: 20px;
                    right: 20px;
                    bottom: 0;
                    height: 3px;
                    border-radius: 3px 3px 0 0;
                    background: var(--g-900);
                    opacity: 0;
                    transition: opacity var(--dur);
                }

                .stat-card:hover {
                    border-color: var(--g-300);
                    box-shadow: var(--sh-md);
                    transform: translateY(-3px);
                }

                    .stat-card:hover::after {
                        opacity: 1;
                    }

            .stat-icon-wrap {
                width: 48px;
                height: 48px;
                border-radius: 14px;
                display: grid;
                place-items: center;
                font-size: 20px;
                flex-shrink: 0;
                background: var(--g-100);
                color: var(--g-800);
                border: 1px solid var(--g-200);
                transition: all var(--dur) var(--ease);
            }

            .stat-card:hover .stat-icon-wrap {
                background: var(--g-900);
                color: #fff;
                border-color: var(--g-900);
            }

            .stat-label {
                font-size: 10px;
                font-weight: 700;
                color: var(--g-500);
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-bottom: 5px;
            }

            .stat-val {
                font-size: 16px;
                font-weight: 700;
                color: var(--ink);
                line-height: 1.25;
                overflow-wrap: anywhere;
            }

            .stat-hint {
                font-size: 12px;
                color: var(--g-400);
                margin-top: 3px;
            }

            /* ── Content grid / panels ───────────────────── */
            .content-grid {
                display: grid;
                grid-template-columns: minmax(0, 1fr) 340px;
                gap: 20px;
                align-items: start;
            }

            .panel, .info-panel, .progress-panel {
                background: #fff;
                border: 1px solid var(--line);
                border-radius: var(--r-md);
                overflow: hidden;
                box-shadow: var(--sh-xs);
            }

            .progress-panel {
                padding: 22px;
            }

            .panel-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 16px 22px;
                background: var(--g-50);
                border-bottom: 1px solid var(--line);
            }

            .panel-head-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .panel-head-ico {
                width: 36px;
                height: 36px;
                border-radius: 11px;
                background: #fff;
                border: 1px solid var(--g-200);
                display: grid;
                place-items: center;
                font-size: 15px;
                color: var(--g-800);
            }

            .panel-title {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 15px;
                font-weight: 700;
                color: var(--ink);
            }

            .panel-count {
                font-size: 11px;
                background: #fff;
                color: var(--g-700);
                border: 1px solid var(--g-200);
                border-radius: 999px;
                padding: 4px 12px;
                font-weight: 700;
            }

            .action-list {
                padding: 14px;
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
                gap: 12px;
            }

            .action-item {
                position: relative;
                overflow: hidden;
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 16px;
                border-radius: var(--r-md);
                text-decoration: none;
                color: var(--ink);
                cursor: pointer;
                border: 1px solid var(--g-200);
                background: #fff;
                width: 100%;
                text-align: left;
                font-family: inherit;
                transition: all var(--dur) var(--ease);
            }

                .action-item::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 14px;
                    bottom: 14px;
                    width: 3px;
                    border-radius: 0 3px 3px 0;
                    background: var(--g-900);
                    transform: scaleY(0);
                    transition: transform var(--dur) var(--ease);
                }

                .action-item:hover {
                    border-color: var(--g-300);
                    background: var(--g-25);
                    box-shadow: var(--sh-md);
                    transform: translateY(-3px);
                    color: var(--ink);
                    text-decoration: none;
                }

                    .action-item:hover::before {
                        transform: scaleY(1);
                    }

                .action-item:focus-visible, .quick-link:focus-visible, .btn-solid:focus-visible, .btn-ghost:focus-visible, .btn-logout:focus-visible {
                    outline: 2px solid var(--g-900);
                    outline-offset: 2px;
                }

            .action-ico {
                width: 46px;
                height: 46px;
                border-radius: 14px;
                display: grid;
                place-items: center;
                font-size: 19px;
                flex-shrink: 0;
                background: var(--g-100);
                color: var(--g-800);
                border: 1px solid var(--g-200);
                transition: all var(--dur) var(--ease);
            }

            .action-item:hover .action-ico {
                background: var(--g-900);
                color: #fff;
                border-color: var(--g-900);
                transform: scale(1.06) rotate(-4deg);
            }

            .action-text {
                flex: 1;
                min-width: 0;
            }

            .action-name {
                font-size: 14px;
                font-weight: 700;
                color: var(--ink);
                margin-bottom: 2px;
            }

            .action-desc {
                font-size: 12px;
                color: var(--g-500);
                line-height: 1.4;
            }

            .action-arr {
                color: var(--g-300);
                font-size: 14px;
                transition: all var(--dur) var(--ease);
            }

            .action-item:hover .action-arr {
                color: var(--ink);
                transform: translateX(3px);
            }

            .compliance-strip {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-wrap: wrap;
                margin: 0 14px 16px;
                padding-top: 14px;
                border-top: 1px dashed var(--g-200);
            }

            .compliance-chip {
                display: flex;
                align-items: center;
                gap: 6px;
                font-size: 11px;
                font-weight: 600;
                color: var(--g-700);
                background: var(--g-100);
                border: 1px solid var(--g-200);
                padding: 6px 12px;
                border-radius: 999px;
            }

                .compliance-chip i {
                    color: var(--g-800);
                    font-size: 12px;
                }

            /* ── Side column ─────────────────────────────── */
            .side-stack {
                display: flex;
                flex-direction: column;
                gap: 18px;
            }

            .info-head {
                padding: 14px 20px;
                background: var(--g-50);
                border-bottom: 1px solid var(--line);
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .info-head-dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--g-900);
            }

            .info-head-title {
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1.1px;
                color: var(--g-600);
            }

            .info-body {
                padding: 6px 20px 12px;
            }

            .detail-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 11px 0;
                gap: 14px;
            }

                .detail-row + .detail-row {
                    border-top: 1px dashed var(--g-200);
                }

            .detail-key {
                font-size: 12.5px;
                color: var(--g-500);
                display: flex;
                align-items: center;
                gap: 8px;
                white-space: nowrap;
            }

                .detail-key i {
                    font-size: 14px;
                    color: var(--g-700);
                }

            .detail-val {
                font-size: 13px;
                font-weight: 600;
                color: var(--ink);
                text-align: right;
                max-width: 190px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

                .detail-val.ok {
                    color: var(--ok);
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                }

                    .detail-val.ok::before {
                        content: '';
                        width: 7px;
                        height: 7px;
                        border-radius: 50%;
                        background: var(--ok);
                    }

            .prog-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 16px;
            }

            .dental-prog-header {
                flex-direction: column;
                align-items: stretch;
                gap: 14px;
                margin-bottom: 0;
            }

            .prog-title {
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1.1px;
                color: var(--g-600);
            }

            .notice-box {
                display: flex;
                gap: 11px;
                background: var(--g-50);
                border: 1px solid var(--g-200);
                border-radius: var(--r-sm);
                padding: 13px 15px;
                font-size: 12.5px;
                color: var(--g-700);
                line-height: 1.65;
            }

                .notice-box i {
                    font-size: 16px;
                    color: var(--g-800);
                    flex-shrink: 0;
                    margin-top: 1px;
                }

            .dental-notice-box {
                border-left: none;
                border-right: none;
                border-radius: 0;
                padding: 14px 28px;
                align-items: center;
            }

            .quick-links {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .quick-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 14px 16px;
                border-radius: var(--r-md);
                background: #fff;
                border: 1px solid var(--line);
                text-decoration: none;
                color: var(--g-800);
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                transition: all var(--dur) var(--ease);
            }

                .quick-link:hover {
                    background: var(--g-100);
                    border-color: var(--g-300);
                    color: var(--ink);
                    text-decoration: none;
                    transform: translateY(-2px);
                    box-shadow: var(--sh-sm);
                }

                .quick-link i {
                    font-size: 17px;
                    color: var(--g-700);
                }

                    .quick-link i.ms-auto {
                        color: var(--g-400);
                        font-size: 13px;
                    }

            .progress-report-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: .6rem;
                padding: 12px 16px;
                width: 100%;
                border: none;
                border-radius: 12px;
                background: var(--g-900);
                color: #fff;
                font-family: inherit;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                transition: all var(--dur) var(--ease);
                box-shadow: 0 10px 22px rgba(17,21,32,.2);
            }

                .progress-report-btn:hover {
                    transform: translateY(-2px);
                    background: var(--g-700);
                    box-shadow: 0 16px 30px rgba(17,21,32,.28);
                }

                .progress-report-btn:active {
                    transform: translateY(1px);
                }

            /* ── Modals ──────────────────────────────────── */
            .modal-content {
                border: 1px solid var(--line);
                border-radius: 22px;
                overflow: hidden;
                box-shadow: 0 30px 80px rgba(17,21,32,.22);
                background: #fff;
            }

            .modal-header {
                background: linear-gradient(180deg, var(--g-100), #fff);
                padding: 22px 28px;
                border-bottom: 1px solid var(--line);
                position: relative;
            }

            .modal-header-inner {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .modal-ico {
                width: 46px;
                height: 46px;
                border-radius: 14px;
                background: var(--g-900);
                display: grid;
                place-items: center;
                font-size: 19px;
                color: #fff;
                box-shadow: 0 8px 18px rgba(17,21,32,.25);
            }

            .modal-title {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 19px;
                font-weight: 800;
                color: var(--ink);
                margin: 0;
                line-height: 1.2;
                letter-spacing: -.3px;
            }

            .modal-sub {
                font-size: 12px;
                color: var(--g-500);
                margin-top: 3px;
            }

            .modal-body {
                padding: 26px 30px 18px;
            }

                .modal-body p {
                    color: var(--g-600);
                    font-size: 14px;
                    line-height: 1.75;
                }

                .modal-body strong {
                    color: var(--ink);
                }

            .modal-footer {
                padding: 16px 30px 26px;
                border: none;
                gap: 10px;
            }

            .btn-primary-modal {
                background: var(--g-900);
                color: #fff;
                border: none;
                border-radius: 12px;
                padding: 11px 24px;
                font-size: 13.5px;
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 8px;
                font-family: inherit;
                transition: all var(--dur) var(--ease);
                box-shadow: 0 8px 20px rgba(17,21,32,.2);
            }

                .btn-primary-modal:hover {
                    transform: translateY(-1px);
                    background: var(--g-700);
                    box-shadow: 0 14px 28px rgba(17,21,32,.28);
                }

            .btn-dismiss, .modal-footer .btn-secondary {
                background: #fff;
                color: var(--g-600);
                border: 1px solid var(--g-300);
                border-radius: 12px;
                padding: 10px 20px;
                font-size: 13.5px;
                font-weight: 500;
                font-family: inherit;
            }

                .btn-dismiss:hover, .modal-footer .btn-secondary:hover {
                    background: var(--g-100);
                    color: var(--ink);
                }

            .modal-footer .btn-primary {
                background: var(--g-900);
                border: none;
                border-radius: 12px;
                padding: 10px 22px;
                font-weight: 600;
            }

                .modal-footer .btn-primary:hover {
                    background: var(--g-700);
                }

            .form-label {
                font-size: 13px;
                font-weight: 600;
                color: var(--g-600);
                margin-bottom: 6px;
            }

            .form-control, .form-select {
                font-size: 14px;
                border: 1px solid var(--g-300);
                border-radius: 12px;
                padding: 10px 14px;
                font-family: inherit;
                transition: all var(--dur);
            }

                .form-control:focus, .form-select:focus {
                    border-color: var(--g-800);
                    box-shadow: 0 0 0 4px rgba(17,21,32,.08);
                    outline: none;
                }

                .form-control[readonly] {
                    background: var(--g-50);
                    color: var(--g-600);
                }

            .progress-bar {
                background: var(--g-900);
            }

            .modal-fieldset {
                border: 1px solid var(--g-200) !important;
                border-radius: var(--r-md);
                padding: 18px !important;
                background: var(--g-50);
            }

                .modal-fieldset legend {
                    float: none;
                    width: auto;
                    padding: 0 8px;
                    margin: 0;
                    font-size: 12px;
                    font-weight: 700;
                    color: var(--g-600);
                    text-transform: uppercase;
                    letter-spacing: .8px;
                }

            .logo-upload-row {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .logo-preview {
                width: 76px;
                height: 76px;
                border-radius: 18px;
                object-fit: cover;
                border: 1px solid var(--line);
                background: #fff;
                flex-shrink: 0;
            }

            .logo-preview-placeholder {
                width: 76px;
                height: 76px;
                border-radius: 18px;
                border: 1.5px dashed var(--g-300);
                background: #fff;
                display: grid;
                place-items: center;
                color: var(--g-400);
                font-size: 26px;
                flex-shrink: 0;
            }

            .logo-upload-btn {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                font-size: 12.5px;
                font-weight: 600;
                color: var(--g-800);
                background: #fff;
                border: 1px solid var(--g-300);
                border-radius: 10px;
                padding: 8px 14px;
                cursor: pointer;
                transition: all .16s;
            }

                .logo-upload-btn:hover {
                    background: var(--g-100);
                }

            .logo-upload-hint {
                font-size: 11px;
                color: var(--g-500);
                margin-top: 6px;
            }

            .alert-warning {
                background: var(--warn-bg);
                border-color: var(--warn-line);
                color: #92400e;
                border-radius: var(--r-sm);
                font-size: 13.5px;
            }

            .table {
                font-size: 13.5px;
            }

            .table-light {
                --bs-table-bg: var(--g-100);
            }

            #locationModal {
                z-index: 1060 !important;
            }

            body > .modal-backdrop {
                z-index: 1055 !important;
            }

            body > .modal {
                z-index: 1060 !important;
            }

            #reportAffiliationType, #reportCourseLevel {
                cursor: pointer;
            }

            /* ── Entrance animation ──────────────────────── */
            .fade-up {
                animation: fadeUp .55s var(--ease) both;
            }

            .fade-up-1 {
                animation-delay: .06s;
            }

            .fade-up-2 {
                animation-delay: .12s;
            }

            .fade-up-3 {
                animation-delay: .18s;
            }

            .fade-up-4 {
                animation-delay: .24s;
            }

            @@keyframes fadeUp {
                from {
                    opacity: 0;
                    transform: translateY(16px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                .fade-up, .status-dot {
                    animation: none;
                }

                .dl-bar > div {
                    transition: none;
                }

                html {
                    scroll-behavior: auto;
                }
            }

            /* ── Responsive ──────────────────────────────── */
            @@media (max-width: 1100px) {
                .content-grid {
                    grid-template-columns: 1fr;
                }

                .side-stack {
                    flex-direction: row;
                    flex-wrap: wrap;
                }

                .info-panel, .progress-panel {
                    flex: 1;
                    min-width: 260px;
                }

                .quick-links {
                    flex: 1 1 100%;
                    flex-direction: row;
                }

                .quick-link {
                    flex: 1;
                }
            }

            @@media (max-width: 1200px) and (min-width: 992px) {
                .sidebar-wrap {
                    width: 240px;
                }

                body.app-sidebar-collapsed .sidebar-wrap {
                    width: 68px;
                }
            }

            @@media (max-width: 991px) {
                .layout {
                    flex-direction: column;
                }

                .sidebar-wrap, body.app-sidebar-collapsed .sidebar-wrap {
                    width: 100%;
                    height: auto;
                    position: relative;
                    top: 0;
                }

                .main {
                    padding: 24px 20px 48px;
                }

                .hero {
                    grid-template-columns: 1fr;
                }

                .hero-actions {
                    flex-direction: row;
                    flex-wrap: wrap;
                    min-width: 0;
                }

                    .hero-actions > * {
                        flex: 1;
                        min-width: 180px;
                    }
            }

            @@media (max-width: 900px) {
                .dl-side {
                    width: 100%;
                }
            }

            @@media (max-width: 640px) {
                .tb-centre, .tb-code {
                    display: none;
                }

                .topbar {
                    padding: 0 16px;
                }

                .hero {
                    padding: 24px 20px;
                }

                .hero-title {
                    font-size: 20px;
                }

                .page-title {
                    font-size: 26px;
                }

                .quick-links {
                    flex-direction: column;
                }
            }
    </style>
    <script>
            // Saved logo path exists but the file can't be loaded → treat as "no logo": show upload slot + hanging tag
            function logoMissing() {
                var el = document.getElementById('heroId');
                if (el) el.classList.add('has-tag');
            }
    </script>
</head>
<body>

    <!-- Logo watermark -->
    <div class="wm" aria-hidden="true">
        <img src="~/images/newLogo.jpeg" alt="" />
    </div>

    <div class="gov-strip"></div>

    <!-- ── TOPBAR ──────────────────────────────────────────── -->
    <header class="topbar">
        <a class="tb-brand" href="#">
            <div class="tb-logo">
                <img src="~/images/newLogo.jpeg" alt="RGUHS Logo" />
            </div>
            <div class="tb-brand-text">
                <div class="tb-brand-name">
                    RGUHS Portal
                    <span class="tb-official-badge"><i class="bi bi-patch-check-fill"></i> Official</span>
                </div>
                <div class="tb-brand-sub">Affiliation Management</div>
            </div>
        </a>

        <div class="tb-centre">
            @if (!string.IsNullOrWhiteSpace(collegeLogoPath))
            {
                <img src="@Url.Content(collegeLogoPath)" alt="" width="28" height="28" class="tb-centre-logo"
                     onerror="this.style.display='none'; document.getElementById('tbCentreIco').style.display='grid';" />
                <div class="tb-centre-ico" id="tbCentreIco" style="display:none"><i class="bi bi-buildings-fill"></i></div>
            }
            else
            {
                <div class="tb-centre-ico" id="tbCentreIco"><i class="bi bi-buildings-fill"></i></div>
            }
            <div class="tb-centre-inner">
                <div class="tb-centre-label">Institution</div>
                <div class="tb-centre-name" title="@collegeName">@collegeName</div>
            </div>
        </div>

        <div class="tb-right">
            @if (!string.IsNullOrEmpty(collegeCode))
            {
                <span class="tb-code">@collegeCode</span>
            }
            <form asp-action="Logout" asp-controller="Login" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">
                    <i class="bi bi-box-arrow-right"></i>
                    Sign Out
                </button>
            </form>
        </div>
    </header>

    <!-- ── LAYOUT ──────────────────────────────────────────── -->
    <div class="layout">

        @if (!string.IsNullOrEmpty(facultyCode))
        {
            <div class="sidebar-wrap">
                @await Component.InvokeAsync("Sidebar")
            </div>
        }

        <main class="main">

            <!-- Page Header -->
            <div class="page-header fade-up">
                <div>
                    <div class="page-eyebrow">
                        <i class="bi bi-house-door"></i> Home
                        <i class="bi bi-chevron-right"></i>
                        Dashboard
                    </div>
                    <h1 class="page-title"><span id="greeting">Welcome back</span></h1>
                </div>
                <div class="header-chips">
                    <div class="chip"><i class="bi bi-calendar3"></i><span id="todayLabel">Today</span></div>
                    <div class="chip live"><div class="status-dot"></div> Portal Active</div>
                </div>
            </div>

            <!-- Hero -->
            <section class="hero fade-up fade-up-1">
                <div>
                    <div class="hero-badge"><i class="bi bi-stars"></i> Affiliation Workspace</div>
                    @{
                        var hasLogo = !string.IsNullOrWhiteSpace(collegeLogoPath);
                    }
                    @* has-tag = no usable logo: either none saved, or the saved file fails to load (onerror below flips it) *@
                    <div class="hero-id @(hasLogo ? "" : "has-tag")" id="heroId">
                        <div class="logo-slot">
                            <button type="button"
                                    class="logo-upload-trigger"
                                    onclick="goToCollegeProfile(event)"
                                    title="Upload college logo"
                                    aria-label="Upload college logo">
                                @if (hasLogo)
                                {
                                    <img src="@Url.Content(collegeLogoPath)" alt="" width="64" height="64" class="hero-logo"
                                         onerror="logoMissing()" />
                                }
                                <div class="hero-logo-ph"><i class="bi bi-building"></i></div>
                                <span class="logo-edit-badge"><i class="bi bi-camera-fill"></i></span>
                            </button>

                            <!-- Hanging tag: visible only while there is no working college logo -->
                            <button type="button" class="logo-tag" onclick="goToCollegeProfile(event)" aria-label="Upload college logo">
                                <span class="logo-tag-string"></span>
                                <span class="logo-tag-body">
                                    <i class="bi bi-cloud-arrow-up-fill"></i>
                                    <span class="logo-tag-text"><small>Upload</small>College Logo</span>
                                </span>
                            </button>
                        </div>
                        <div>
                            <div class="hero-title">@collegeName</div>
                            <div class="hero-meta">
                                @if (!string.IsNullOrEmpty(collegeCode))
                                {
                                    <span class="hero-pill"><i class="bi bi-upc-scan"></i> @collegeCode</span>
                                }
                                @if (!string.IsNullOrEmpty(facultyName))
                                {
                                    <span class="hero-pill"><i class="bi bi-mortarboard"></i> @facultyName</span>
                                }
                                <span class="hero-pill"><i class="bi bi-shield-check"></i> Verified account</span>
                            </div>
                        </div>
                    </div>
                    <p class="hero-desc">
                        Track your affiliation applications, keep your institution profile current and stay ahead of submission deadlines — all from one place.
                    </p>
                </div>
                <div class="hero-actions">
                    <button type="button" class="btn-solid" onclick="goToCollegeProfile(event)">
                        <span><i class="bi bi-person-vcard me-2"></i>College Profile</span>
                        <i class="bi bi-arrow-up-right"></i>
                    </button>
                </div>
            </section>

            <!-- Deadline strip (hidden until course-schedule.js decides there is a deadline) -->
            @if (showDeadline)
            {
                <aside class="deadline fade-up fade-up-2" id="deadlineCard" hidden>
                    <div class="dl-main">
                        <div class="dl-label"><i class="bi bi-alarm-fill"></i> <span id="dlLabel">Submission deadline</span></div>
                        <div class="dl-row">
                            <div class="dl-big"><span id="dlDays">–</span><small id="dlUnit">days left</small></div>
                            <div class="dl-msg" id="dlMsg">Loading…</div>
                        </div>
                    </div>
                    <div class="dl-side">
                        <div class="dl-bar"><div id="dlBar"></div></div>
                        <div class="dl-foot"><span id="dlStartLabel"></span><span id="dlEndLabel"></span></div>
                    </div>
                </aside>
            }

            <!-- Stat Cards -->
            <div class="stat-grid fade-up fade-up-2">
                <div class="stat-card">
                    <div class="stat-icon-wrap"><i class="bi bi-bank2"></i></div>
                    <div>
                        <div class="stat-label">Institution</div>
                        <div class="stat-val">@collegeName</div>
                        <div class="stat-hint">Registered college</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon-wrap"><i class="bi bi-upc-scan"></i></div>
                    <div>
                        <div class="stat-label">College Code</div>
                        <div class="stat-val">@(string.IsNullOrEmpty(collegeCode) ? "—" : collegeCode)</div>
                        <div class="stat-hint">Unique identifier</div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(facultyName))
                {
                    <div class="stat-card">
                        <div class="stat-icon-wrap"><i class="bi bi-mortarboard"></i></div>
                        <div>
                            <div class="stat-label">Stream</div>
                            <div class="stat-val">@facultyName</div>
                            <div class="stat-hint">Faculty stream</div>
                        </div>
                    </div>
                }
            </div>

            <!-- Content Grid -->
            <div class="content-grid fade-up fade-up-3">

                <!-- Quick Actions -->
                <div class="panel">
                    <div class="panel-head">
                        <div class="panel-head-left">
                            <div class="panel-head-ico"><i class="bi bi-grid-1x2-fill"></i></div>
                            <div class="panel-title">Quick Actions</div>
                        </div>
                        <span class="panel-count">@actionCount actions</span>
                    </div>
                    <div class="action-list">

                        <a href="@Url.Action("Dashboard", "Collegelogin")" class="action-item">
                            <div class="action-ico"><i class="bi bi-clipboard-data"></i></div>
                            <div class="action-text">
                                <div class="action-name">Applications</div>
                                <div class="action-desc">Monitor and track submitted applications</div>
                            </div>
                            <i class="bi bi-chevron-right action-arr"></i>
                        </a>

                        <button type="button" class="action-item" onclick="goToChangePassword(event)">
                            <div class="action-ico"><i class="bi bi-shield-lock"></i></div>
                            <div class="action-text">
                                <div class="action-name">Security Settings</div>
                                <div class="action-desc">Update your account password</div>
                            </div>
                            <i class="bi bi-chevron-right action-arr"></i>
                        </button>

                        <button type="button" class="action-item" onclick="goToCollegeProfile(event)">
                            <div class="action-ico"><i class="bi bi-person-vcard"></i></div>
                            <div class="action-text">
                                <div class="action-name">College Profile</div>
                                <div class="action-desc">View college details and update logo</div>
                            </div>
                            <i class="bi bi-chevron-right action-arr"></i>
                        </button>
                    </div>

                    <div class="compliance-strip">
                        <div class="compliance-chip"><i class="bi bi-shield-fill-check"></i> 256-bit TLS Encrypted</div>
                        <div class="compliance-chip"><i class="bi bi-patch-check-fill"></i> GIGW Compliant</div>
                        <div class="compliance-chip"><i class="bi bi-award-fill"></i> NMC Recognized</div>
                    </div>
                </div>

                <!-- Side Stack -->
                <div class="side-stack">

                    <!-- Account details -->
                    <div class="info-panel">
                        <div class="info-head">
                            <div class="info-head-dot"></div>
                            <div class="info-head-title">Account Details</div>
                        </div>
                        <div class="info-body">
                            <div class="detail-row">
                                <span class="detail-key"><i class="bi bi-building"></i> College</span>
                                <span class="detail-val" title="@collegeName">@collegeName</span>
                            </div>
                            @if (!string.IsNullOrEmpty(collegeCode))
                            {
                                <div class="detail-row">
                                    <span class="detail-key"><i class="bi bi-upc-scan"></i> Code</span>
                                    <span class="detail-val">@collegeCode</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(facultyName))
                            {
                                <div class="detail-row">
                                    <span class="detail-key"><i class="bi bi-person-badge"></i> Stream</span>
                                    <span class="detail-val" title="@facultyName">@facultyName</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(principalName))
                            {
                                <div class="detail-row">
                                    <span class="detail-key"><i class="bi bi-person-check"></i> Principal</span>
                                    <span class="detail-val" title="@principalName">@principalName</span>
                                </div>
                            }
                            <div class="detail-row">
                                <span class="detail-key"><i class="bi bi-shield-check"></i> Status</span>
                                <span class="detail-val ok">Active</span>
                            </div>
                        </div>
                    </div>

                    <!-- Dental report (faculty 2 only) -->
                    @if (facultyCode == "2")
                    {
                        <div class="progress-panel">
                            <div class="prog-header dental-prog-header">
                                <div class="prog-title">Application Completion</div>
                                <button type="button"
                                        class="progress-report-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#dentalApplicationReportModal"
                                        title="View Dental Application Report">
                                    <i class="bi bi-bar-chart-line"></i>
                                    <span>View Dental Report</span>
                                </button>
                            </div>
                        </div>
                    }

                    <!-- Help links -->
                    <div class="quick-links">
                        <a href="#" class="quick-link">
                            <i class="bi bi-file-earmark-text"></i>
                            Application Guidelines
                            <i class="bi bi-arrow-up-right ms-auto"></i>
                        </a>
                        <a href="#" class="quick-link">
                            <i class="bi bi-headset"></i>
                            Contact Support
                            <i class="bi bi-arrow-up-right ms-auto"></i>
                        </a>
                    </div>

                </div>
            </div>

        </main>
    </div>

    @if (facultyCode == "2")
    {
        <div class="modal fade"
             id="dentalApplicationReportModal"
             tabindex="-1"
             aria-labelledby="dentalApplicationReportModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="dentalApplicationReportModalLabel">
                            Dental Application Report
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="notice-box dental-notice-box">
                        <i class="bi bi-info-circle-fill"></i>
                        <div>
                            Select Type of Affiliation and Course Level
                            to view the application completion status.
                        </div>
                    </div>

                    <div class="modal-body d-modal-body">

                        <!-- Type of Affiliation -->
                        <div class="mb-3">
                            <label for="reportAffiliationType" class="form-label">Type of Affiliation</label>
                            <select id="reportAffiliationType" class="form-select">
                                <option value="">-- Select Type of Affiliation --</option>
                                @foreach (var type in ViewBag.AffiliationTypes)
                                {
                                    if (type.Id == 2)
                                    {
                                        <option value="@type.Id" selected>@type.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@type.Id" disabled>@type.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Course Level -->
                        <div class="mb-3">
                            <label for="reportCourseLevel" class="form-label">Course Level</label>
                            <select id="reportCourseLevel" class="form-select">
                                <option value="">-- Select Course Level --</option>
                                <option value="UG">UG</option>
                                <option value="PG">PG</option>
                            </select>
                        </div>

                        <!-- Loading -->
                        <div id="dentalReportLoading" class="text-center d-none">
                            <div class="spinner-border" role="status"></div>
                            <div class="mt-2">Fetching application status...</div>
                        </div>

                        <!-- Result -->
                        <div id="dentalReportResult" class="d-none">
                            <hr>
                            <div class="text-center">
                                <div class="text-muted">Application Completion</div>
                                <div class="display-4 fw-bold" id="reportPercentage">0%</div>
                                <div class="progress mt-3" style="height:12px;">
                                    <div class="progress-bar" id="reportProgressBar" style="width:0%;"></div>
                                </div>
                                <div class="mt-3 text-muted" id="reportStepCount">0 of 0 steps completed</div>
                            </div>
                        </div>

                        <!-- Error -->
                        <div id="dentalReportError" class="alert alert-danger d-none"></div>

                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" id="btnFetchDentalReport" onclick="fetchDentalApplicationReport()">
                            <i class="bi bi-bar-chart-line"></i>
                            View Status
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }

    <!-- ── AFFILIATION DEADLINE NOTIFICATION ─────────────────── -->
    @* One notification for every faculty: the table is built from dbo.Mst_CourseLevelSchedule by course-schedule.js *@
    @if (!string.IsNullOrEmpty(facultyCode) && ((TempData["ShowAffiliationNotification"] != null && (bool)TempData["ShowAffiliationNotification"]) || ViewBag.ShowAffiliationNotification == true))
    {
        var ugLateFee = Model.LateSubmissionFees.FirstOrDefault(x => string.Equals(x.CourseLevel, "UG", StringComparison.OrdinalIgnoreCase));
        var pgLateFee = Model.LateSubmissionFees.FirstOrDefault(x => string.Equals(x.CourseLevel, "PG", StringComparison.OrdinalIgnoreCase));

        <div class="modal fade" id="affiliationNotificationModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="modal-header-inner">
                            <div class="modal-ico"><i class="bi bi-megaphone-fill"></i></div>
                            <div>
                                <div class="modal-title">Important Affiliation Notification</div>
                                <div class="modal-sub">Please note the application submission deadlines</div>
                            </div>
                        </div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div id="affNoticeBody">Loading…</div>
                    </div>
                    <div class="modal-footer justify-content-center">
                        <button type="button" class="btn-primary-modal" data-bs-dismiss="modal">I Understand</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ── COLLEGE PROFILE MODAL ─────────────────────────────── -->
    <div class="modal fade" id="collegeProfileModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <form id="collegeProfileForm"
                      asp-action="UpdateCollegeProfile"
                      asp-controller="Collegelogin"
                      method="post"
                      enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CollegeCode" value="@collegeCode" />

                    <div class="modal-header">
                        <div class="modal-header-inner">
                            <div class="modal-ico"><i class="bi bi-person-vcard"></i></div>
                            <div>
                                <div class="modal-title">College Profile</div>
                                <div class="modal-sub">Update institution logo</div>
                            </div>
                        </div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">

                        <fieldset class="modal-fieldset mb-4">
                            <legend>College Logo</legend>
                            <div class="logo-upload-row">
                                <img id="logoPreviewImg" class="logo-preview" style="display:none" alt=""
                                     onerror="this.style.display='none'; document.getElementById('logoPreviewPlaceholder').style.display='grid';" />
                                <div id="logoPreviewPlaceholder" class="logo-preview-placeholder">
                                    <i class="bi bi-building"></i>
                                </div>
                                <div>
                                    <label for="logoFileInput" class="logo-upload-btn">
                                        <i class="bi bi-upload"></i> Choose Logo
                                    </label>
                                    <input type="file" id="logoFileInput" name="Logo" accept=".jpg,.jpeg,.png,.webp" hidden />
                                    <div class="logo-upload-hint">JPG, PNG or WEBP · up to 5 MB · square image recommended</div>
                                </div>
                            </div>
                        </fieldset>

                        <fieldset class="modal-fieldset">
                            <legend>Institution Details</legend>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="cpCollegeName" class="form-label">College Name</label>
                                    <input type="text" id="cpCollegeName" class="form-control" readonly tabindex="-1" />
                                </div>
                                <div class="col-md-6">
                                    <label for="cpPrincipalName" class="form-label">Principal / Dean Name</label>
                                    <input type="text" id="cpPrincipalName" class="form-control" tabindex="-1" />
                                </div>
                                <div class="col-12">
                                    <label for="cpAddress" class="form-label">Address</label>
                                    <input type="text" id="cpAddress" class="form-control" tabindex="-1" />
                                </div>
                                <div class="col-md-4">
                                    <label for="cpEmail" class="form-label">Email</label>
                                    <input type="email" id="cpEmail" class="form-control" tabindex="-1" />
                                </div>
                                <div class="col-md-4">
                                    <label for="cpPhoneNumber" class="form-label">Phone Number</label>
                                    <input type="text" id="cpPhoneNumber" class="form-control" tabindex="-1" />
                                </div>
                                <div class="col-md-4">
                                    <label for="cpEstablishedYear" class="form-label">Established Year</label>
                                    <input type="text" id="cpEstablishedYear" class="form-control" tabindex="-1" />
                                </div>
                                <div class="col-12">
                                    <label for="cpWebsite" class="form-label">Website</label>
                                    <input type="url" id="cpWebsite" class="form-control" tabindex="-1" />
                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn-dismiss" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-primary-modal">
                            <i class="bi bi-check2-circle"></i> Save Logo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const dentalApplicationReportUrl = '@Url.Action("GetDentalApplicationReport", "Collegelogin")';
    </script>

    <script>
        window.CourseScheduleUrl = '@Url.Action("GetSchedule", "CourseLevelSchedule")';
    </script>
    <script src="~/js/course-schedule.js" asp-append-version="true"></script>

    <script>
        // Greeting + date
        (function () {
        var h = new Date().getHours();
        var g = h < 12 ? 'Good morning' : (h < 17 ? 'Good afternoon' : 'Good evening');
        var gEl = document.getElementById('greeting');
        if (gEl) gEl.textContent = g;
        var dEl = document.getElementById('todayLabel');
        if (dEl) dEl.textContent = new Date().toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
        })();

        // Password toggle
        (function () {
        const toggle = document.querySelector('.toggle-password');
        const input = document.getElementById('NewPassword');
        const icon = document.getElementById('toggleIcon');
        if (toggle && input) {
        toggle.addEventListener('click', function () {
        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        });
        }
        })();

        // Change password shortcut
        function goToChangePassword(e) {
        if (e) e.preventDefault();
        const modalElement = document.getElementById('updatePasswordModal');
        if (!modalElement) return;
        if (modalElement.parentElement !== document.body) document.body.appendChild(modalElement);
        bootstrap.Modal.getOrCreateInstance(modalElement).show();
        }

        // College Profile shortcut — fetch current values, then show modal
        function goToCollegeProfile(e) {
        if (e) e.preventDefault();

        var url = '@Url.Action("GetCollegeProfile", "Collegelogin")' + '?collegeCode=' + encodeURIComponent('@collegeCode');

        fetch(url)
        .then(function (r) { return r.json(); })
        .then(function (data) {
        if (!data || !data.success) return;
        document.getElementById('cpCollegeName').value = data.collegeName || '';
        document.getElementById('cpPrincipalName').value = data.principalName || '';
        document.getElementById('cpAddress').value = data.address || '';
        document.getElementById('cpEmail').value = data.email || '';
        document.getElementById('cpPhoneNumber').value = data.phoneNumber || '';
        document.getElementById('cpEstablishedYear').value = data.establishedYear || '';
        document.getElementById('cpWebsite').value = data.website || '';

        var img = document.getElementById('logoPreviewImg');
        var placeholder = document.getElementById('logoPreviewPlaceholder');
        if (data.logoPath) {
        img.src = data.logoPath + '?t=' + Date.now();
        img.style.display = 'block';
        placeholder.style.display = 'none';
        } else {
        img.style.display = 'none';
        placeholder.style.display = 'grid';
        }
        })
        .catch(function (err) { console.error('GetCollegeProfile error:', err); })
        .finally(function () {
        bootstrap.Modal.getOrCreateInstance(document.getElementById('collegeProfileModal')).show();
        });
        }

        // Live preview of a newly chosen logo file before it's uploaded
        document.getElementById('logoFileInput').addEventListener('change', function (e) {
        var file = e.target.files && e.target.files[0];
        if (!file) return;

        var img = document.getElementById('logoPreviewImg');
        var placeholder = document.getElementById('logoPreviewPlaceholder');
        var reader = new FileReader();
        reader.onload = function (evt) {
        img.src = evt.target.result;
        img.style.display = 'block';
        placeholder.style.display = 'none';
        };
        reader.readAsDataURL(file);
        });

        // Affiliation deadline notification
        @if (TempData["ShowAffiliationNotification"] != null && (bool)TempData["ShowAffiliationNotification"] || ViewBag.ShowAffiliationNotification == true)
        {
            <text>
                (function () {
                // Guard: never run this block more than once per page load.
                if (window.__affiliationNoticeInit) return;
                window.__affiliationNoticeInit = true;

                function forceUnlockPage() {
                document.querySelectorAll('.modal-backdrop').forEach(function (bd) { bd.remove(); });
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('overflow');
                document.body.style.removeProperty('padding-right');
                }

                window.addEventListener('load', function () {
                setTimeout(function () {
                var notificationModalElement = document.getElementById('affiliationNotificationModal');
                if (!notificationModalElement) return;

                // Clear anything left over from an earlier init BEFORE showing.
                forceUnlockPage();

                var notificationModal = new bootstrap.Modal(notificationModalElement, {
                // Keep the notification visible without blocking dashboard controls.
                backdrop: false,
                keyboard: true
                });

                notificationModalElement.addEventListener('hidden.bs.modal', forceUnlockPage);
                notificationModalElement.querySelectorAll('[data-bs-dismiss="modal"]').forEach(function (button) {
                button.addEventListener('click', function () {
                notificationModal.hide();
                forceUnlockPage();
                });
                });

                CourseSchedule.ready.then(function () { notificationModal.show(); });

                // Failsafe: auto-unlock if a stray backdrop is still around after 20s.
                setTimeout(function () {
                if (document.querySelectorAll('.modal-backdrop').length > 1) {
                forceUnlockPage();
                }
                }, 20000);
                }, 300);
                });

                // Manual escape hatch from the browser console: window.__forceUnlockPage()
                window.__forceUnlockPage = forceUnlockPage;
                })();
            </text>
        }
    </script>
    <script src="~/js/ca-dental-application-status.js"></script>
</body>
</html>
