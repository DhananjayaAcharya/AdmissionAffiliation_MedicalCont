@using Microsoft.AspNetCore.Http
@model DashboardViewModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Dashboard";
    var repositoryRows = ViewBag.RepositoryRows as List<UgandPgrepository> ?? new List<UgandPgrepository>();
    var facultyCode = HttpContextAccessor.HttpContext?.Session.GetString("FacultyCode") ?? "";
    var facultyName = !string.IsNullOrWhiteSpace(Model?.FacultyName)
        ? Model.FacultyName
        : (ViewBag.FacultyName as string ?? HttpContextAccessor.HttpContext?.Session.GetString("FacultyName") ?? "");
    Context.Response.Headers["Cache-Control"] = "no-cache, no-store, must-revalidate";
    Context.Response.Headers["Pragma"] = "no-cache";
    Context.Response.Headers["Expires"] = "0";
    var collegeName = !string.IsNullOrWhiteSpace(Model?.CollegeName)
        ? Model.CollegeName
        : (ViewBag.CollegeName as string ?? "College");
    var collegeCode = !string.IsNullOrWhiteSpace(Model?.CollegeCode)
        ? Model.CollegeCode
        : (ViewBag.CollegeCode as string ?? "");
    var collegeLogoPath = !string.IsNullOrWhiteSpace(Model?.CollegeLogoPath)
        ? Model.CollegeLogoPath
        : (ViewBag.CollegeLogoPath as string ?? HttpContextAccessor.HttpContext?.Session.GetString("CollegeLogoPath") ?? "");
    var principalName = !string.IsNullOrWhiteSpace(Model?.PrincipalName)
        ? Model.PrincipalName
        : (ViewBag.PrincipalName as string ?? "");
    var actionCount = (facultyCode == "1" ? 1 : 0) + 4;
    var showDeadline = !string.IsNullOrEmpty(facultyCode);   // card is filled (or hidden) by course-schedule.js
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — RGUHS Academic Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
            :root {
                /* Palette: indigo (primary) · sky (info) · mint (success) · amber (attention) */
                --indigo-700: #3730a3;
                --indigo-600: #4f46e5;
                --indigo-500: #6366f1;
                --indigo-100: #e0e7ff;
                --indigo-50: #eef2ff;
                --sky-500: #0ea5e9;
                --sky-50: #f0f9ff;
                --mint-600: #059669;
                --mint-500: #10b981;
                --mint-50: #ecfdf5;
                --amber-600: #d97706;
                --amber-50: #fffbeb;
                --rose-600: #e11d48;
                --rose-50: #fff1f2;
                --ink: #0b1220;
                --ink-2: #475569;
                --ink-3: #94a3b8;
                --line: #e9edf5;
                --line-2: #d8dfec;
                --soft: #f7f8fc;
                --glass: rgba(255,255,255,.82);
                --topbar-h: 68px;
                --r-sm: 12px;
                --r-md: 18px;
                --r-lg: 26px;
                --sh-xs: 0 1px 2px rgba(11,18,32,.05);
                --sh-sm: 0 4px 14px rgba(11,18,32,.06);
                --sh-md: 0 14px 34px rgba(11,18,32,.08);
                --sh-glow: 0 18px 44px rgba(79,70,229,.22);
                --ease: cubic-bezier(.22,.8,.3,1);
                --dur: .25s;
            }

            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html {
                scroll-behavior: smooth;
                font-size: 15px;
            }

            body {
                font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
                background: #ffffff;
                color: var(--ink);
                min-height: 100vh;
                -webkit-font-smoothing: antialiased;
                position: relative;
                overflow-x: hidden;
            }

                /* soft colour glows behind content (keeps page white) */
                body::before {
                    content: '';
                    position: fixed;
                    inset: 0;
                    z-index: 0;
                    pointer-events: none;
                    background: radial-gradient(520px 320px at 88% 6%, rgba(99,102,241,.10), transparent 70%), radial-gradient(460px 300px at 8% 92%, rgba(14,165,233,.08), transparent 70%);
                }

            /* ── WATERMARK ──────────────────────────────────── */
            .wm {
                position: fixed;
                inset: 0;
                display: grid;
                place-items: center;
                pointer-events: none;
                user-select: none;
                z-index: 0;
                padding-top: var(--topbar-h);
            }

                .wm img {
                    width: min(46vw, 520px);
                    height: auto;
                    opacity: .07;
                    mix-blend-mode: multiply;
                    filter: saturate(.8);
                }

            /* ── TOP ACCENT ─────────────────────────────────── */
            .gov-strip {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                z-index: 1001;
                background: linear-gradient(90deg, var(--indigo-600), var(--sky-500) 50%, var(--mint-500));
            }

            /* ── TOPBAR ─────────────────────────────────────── */
            .topbar {
                position: fixed;
                inset: 3px 0 auto 0;
                height: var(--topbar-h);
                background: rgba(255,255,255,.85);
                backdrop-filter: saturate(180%) blur(16px);
                -webkit-backdrop-filter: saturate(180%) blur(16px);
                border-bottom: 1px solid var(--line);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 28px;
                z-index: 1000;
            }

            .tb-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                flex-shrink: 0;
            }

            .tb-logo {
                width: 44px;
                height: 44px;
                border-radius: 13px;
                overflow: hidden;
                display: grid;
                place-items: center;
                background: #fff;
                border: 1px solid var(--line);
                box-shadow: var(--sh-sm);
            }

                .tb-logo img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }

            .tb-brand-text {
                line-height: 1.2;
            }

            .tb-brand-name {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 16px;
                font-weight: 800;
                color: var(--ink);
                letter-spacing: -.2px;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .tb-official-badge {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                font-family: 'Inter', sans-serif;
                font-size: 9px;
                font-weight: 700;
                letter-spacing: .06em;
                text-transform: uppercase;
                color: var(--mint-600);
                background: var(--mint-50);
                border: 1px solid #a7f3d0;
                padding: 2px 8px;
                border-radius: 20px;
            }

            .tb-brand-sub {
                font-size: 10px;
                color: var(--ink-3);
                text-transform: uppercase;
                letter-spacing: 1.3px;
                font-weight: 500;
            }

            .tb-centre {
                position: absolute;
                left: 50%;
                transform: translateX(-50%);
                display: flex;
                align-items: center;
                gap: 10px;
                background: var(--soft);
                border: 1px solid var(--line);
                border-radius: 999px;
                padding: 6px 18px 6px 8px;
                max-width: 520px;
                min-width: 0;
            }

            .tb-centre-ico {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: var(--indigo-50);
                display: grid;
                place-items: center;
                color: var(--indigo-600);
                font-size: 13px;
                flex-shrink: 0;
            }

            .tb-centre-logo {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                object-fit: cover;
                border: 1px solid var(--line);
                background: #fff;
                flex-shrink: 0;
            }

            .tb-centre-inner {
                min-width: 0;
            }

            .tb-centre-label {
                font-size: 9px;
                color: var(--ink-3);
                text-transform: uppercase;
                letter-spacing: 1.1px;
                line-height: 1;
                margin-bottom: 2px;
                font-weight: 600;
            }

            .tb-centre-name {
                font-size: 13px;
                font-weight: 600;
                color: var(--ink);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .tb-right {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .tb-code {
                background: var(--indigo-50);
                border: 1px solid var(--indigo-100);
                color: var(--indigo-600);
                padding: 6px 14px;
                border-radius: 999px;
                font-size: 11.5px;
                font-weight: 700;
                letter-spacing: .8px;
            }

            .btn-logout {
                display: flex;
                align-items: center;
                gap: 6px;
                background: #fff;
                border: 1px solid #fecdd3;
                color: var(--rose-600);
                border-radius: 999px;
                padding: 7px 16px 7px 12px;
                font-family: inherit;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                transition: all var(--dur) var(--ease);
            }

                .btn-logout:hover {
                    background: var(--rose-50);
                    transform: translateY(-1px);
                    box-shadow: var(--sh-sm);
                }

            /* ── LAYOUT ─────────────────────────────────────── */
            .layout {
                position: relative;
                z-index: 1;
                display: flex;
                align-items: flex-start;
                padding-top: calc(var(--topbar-h) + 3px);
                min-height: 100vh;
            }

            .sidebar-wrap {
                width: 280px;
                flex-shrink: 0;
                position: sticky;
                top: calc(var(--topbar-h) + 3px);
                height: calc(100vh - var(--topbar-h) - 3px);
                background: transparent;
                padding: 0;
                transition: width var(--dur) var(--ease);
            }

            body.app-sidebar-collapsed .sidebar-wrap {
                width: 68px;
            }

            .main {
                flex: 1;
                min-width: 0;
                padding: 32px 44px 64px;
                max-width: 1400px;
                margin: 0 auto;
            }

            /* ── SIDEBAR (white, indigo accents) ────────────── */
            body .sidebar {
                background: rgba(255,255,255,.96) !important;
                color: var(--ink) !important;
                border-right: 1px solid var(--line) !important;
                box-shadow: 8px 0 30px rgba(11,18,32,.04) !important;
            }

                body .sidebar::-webkit-scrollbar-thumb {
                    background: var(--line-2) !important;
                }

                body .sidebar .sidebar-header {
                    background: linear-gradient(180deg, var(--indigo-50), #fff) !important;
                    border-bottom: 1px solid var(--line) !important;
                }

                    body .sidebar .sidebar-header::after {
                        background: linear-gradient(90deg, var(--indigo-600), var(--sky-500) 55%, transparent) !important;
                    }

                    body .sidebar .sidebar-header h4 {
                        color: var(--ink) !important;
                        font-family: 'Plus Jakarta Sans', sans-serif !important;
                        font-weight: 800 !important;
                    }

                body .sidebar .sidebar-header-sub {
                    color: var(--ink-3) !important;
                }

                body .sidebar .sidebar-header-ico {
                    background: #fff !important;
                    border-color: var(--indigo-100) !important;
                    color: var(--indigo-600) !important;
                }

                body .sidebar .sidebar-official-badge {
                    background: var(--mint-50) !important;
                    border-color: #a7f3d0 !important;
                    color: var(--mint-600) !important;
                }

                body .sidebar .sidebar-section-label, body .sidebar .sidebar-footer-label {
                    color: var(--ink-3) !important;
                }

                body .sidebar .sidebar-link {
                    color: #334155 !important;
                }

                    body .sidebar .sidebar-link i:first-child, body .sidebar .sidebar-link .notification-nav-icon i, body .sidebar .sidebar-link .chevron {
                        color: #64748b !important;
                    }

                    body .sidebar .sidebar-link:hover {
                        background: var(--indigo-50) !important;
                        color: var(--indigo-600) !important;
                        border-color: var(--indigo-100) !important;
                    }

                        body .sidebar .sidebar-link:hover i:first-child, body .sidebar .sidebar-link:hover .notification-nav-icon i {
                            color: var(--indigo-600) !important;
                        }

                    body .sidebar .sidebar-link.active {
                        background: linear-gradient(135deg, var(--indigo-500), var(--indigo-700)) !important;
                        color: #fff !important;
                        box-shadow: 0 10px 22px rgba(79,70,229,.30) !important;
                    }

                        body .sidebar .sidebar-link.active i:first-child, body .sidebar .sidebar-link.active .notification-nav-icon i, body .sidebar .sidebar-link.active .chevron {
                            color: #fff !important;
                        }

                    body .sidebar .sidebar-link.expanded .chevron {
                        color: var(--indigo-600) !important;
                    }

                body .sidebar .affiliation-dropdown {
                    background: var(--soft) !important;
                    border-color: var(--line) !important;
                }

                body .sidebar .affiliation-option {
                    color: #334155 !important;
                }

                    body .sidebar .affiliation-option:hover {
                        background: var(--indigo-50) !important;
                        color: var(--indigo-600) !important;
                    }

                    body .sidebar .affiliation-option i {
                        color: #94a3b8 !important;
                    }

                body .sidebar .affiliation-submenu {
                    background: #fff !important;
                }

                body .sidebar .affiliation-subitem {
                    color: #475569 !important;
                }

                    body .sidebar .affiliation-subitem:hover {
                        background: var(--indigo-50) !important;
                        color: var(--indigo-600) !important;
                    }

                    body .sidebar .affiliation-subitem.active {
                        background: linear-gradient(135deg, var(--indigo-500), var(--indigo-700)) !important;
                        color: #fff !important;
                    }

                    body .sidebar .affiliation-subitem.readonly {
                        color: #94a3b8 !important;
                    }

                body .sidebar .affiliation-loading {
                    color: var(--ink-3) !important;
                }

                body .sidebar .sidebar-footer {
                    border-top: 1px solid var(--line) !important;
                }

                body .sidebar .sidebar-action-btn {
                    background: #fff !important;
                    border: 1px solid var(--line) !important;
                    color: #334155 !important;
                }

                    body .sidebar .sidebar-action-btn i {
                        color: #64748b !important;
                    }

                    body .sidebar .sidebar-action-btn:hover {
                        background: var(--indigo-50) !important;
                        border-color: var(--indigo-100) !important;
                        color: var(--indigo-600) !important;
                    }

                        body .sidebar .sidebar-action-btn:hover i {
                            color: var(--indigo-600) !important;
                        }

                    body .sidebar .sidebar-action-btn.primary {
                        background: var(--indigo-50) !important;
                        border-color: var(--indigo-100) !important;
                        color: var(--indigo-600) !important;
                    }

                        body .sidebar .sidebar-action-btn.primary i {
                            color: var(--indigo-600) !important;
                        }

                        body .sidebar .sidebar-action-btn.primary:hover {
                            background: var(--indigo-600) !important;
                            border-color: var(--indigo-600) !important;
                            color: #fff !important;
                            box-shadow: 0 8px 18px rgba(79,70,229,.28) !important;
                        }

                            body .sidebar .sidebar-action-btn.primary:hover i {
                                color: #fff !important;
                            }

                body .sidebar .sidebar-handle {
                    background: #fff !important;
                    color: var(--indigo-600) !important;
                    border: 1px solid var(--line-2) !important;
                    box-shadow: var(--sh-sm) !important;
                }

                    body .sidebar .sidebar-handle:hover {
                        background: var(--indigo-50) !important;
                    }

                body .sidebar .notification-badge {
                    border-color: #fff !important;
                }

            body .password-modal .modal-header {
                background: #fff !important;
                border-bottom: 1px solid var(--line) !important;
            }

            body .password-modal .modal-title {
                color: var(--ink) !important;
            }

            body .password-modal .btn-close {
                filter: none !important;
            }

            /* ── PAGE HEADER ────────────────────────────────── */
            .page-header {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 20px;
                margin-bottom: 24px;
                flex-wrap: wrap;
            }

            .page-eyebrow {
                display: flex;
                align-items: center;
                gap: 6px;
                font-size: 11px;
                font-weight: 600;
                color: var(--ink-3);
                text-transform: uppercase;
                letter-spacing: 1.2px;
                margin-bottom: 10px;
            }

                .page-eyebrow i {
                    font-size: 12px;
                }

            .page-title {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 32px;
                font-weight: 800;
                color: var(--ink);
                line-height: 1.12;
                letter-spacing: -.8px;
            }

                .page-title span {
                    background: linear-gradient(90deg, var(--indigo-600), var(--sky-500));
                    -webkit-background-clip: text;
                    background-clip: text;
                    color: transparent;
                }

            .page-sub {
                font-size: 14px;
                color: var(--ink-2);
                margin-top: 6px;
            }

            .header-chips {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
            }

            .chip {
                display: flex;
                align-items: center;
                gap: 8px;
                background: var(--glass);
                border: 1px solid var(--line);
                border-radius: 999px;
                padding: 8px 16px;
                font-size: 12.5px;
                font-weight: 600;
                color: var(--ink-2);
                box-shadow: var(--sh-xs);
                white-space: nowrap;
            }

                .chip.live {
                    color: var(--mint-600);
                    background: var(--mint-50);
                    border-color: #a7f3d0;
                }

                .chip i {
                    color: var(--indigo-600);
                }

            .status-dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--mint-500);
                animation: pulse 2s infinite;
            }

            @@keyframes pulse {
                0% {
                    box-shadow: 0 0 0 0 rgba(16,185,129,.5);
                }

                70% {
                    box-shadow: 0 0 0 8px rgba(16,185,129,0);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(16,185,129,0);
                }
            }

            /* ── HERO ───────────────────────────────────────── */
            .hero-row {
                display: grid;
                grid-template-columns: minmax(0, 1fr) 300px;
                gap: 20px;
                margin-bottom: 20px;
            }

            .hero {
                position: relative;
                overflow: hidden;
                border-radius: var(--r-lg);
                padding: 32px 36px;
                background: radial-gradient(420px 260px at 100% 0%, rgba(14,165,233,.35), transparent 70%), radial-gradient(380px 260px at 0% 100%, rgba(167,139,250,.35), transparent 70%), linear-gradient(135deg, var(--indigo-600), var(--indigo-700));
                color: #fff;
                box-shadow: var(--sh-glow);
            }

                .hero::after {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background-image: radial-gradient(rgba(255,255,255,.14) 1px, transparent 1px);
                    background-size: 22px 22px;
                    mask-image: linear-gradient(120deg, transparent 30%, #000);
                    -webkit-mask-image: linear-gradient(120deg, transparent 30%, #000);
                    pointer-events: none;
                }

                .hero > * {
                    position: relative;
                    z-index: 1;
                }

            .hero-badge {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                background: rgba(255,255,255,.16);
                border: 1px solid rgba(255,255,255,.28);
                color: #fff;
                padding: 5px 13px;
                border-radius: 999px;
                font-size: 10.5px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1.2px;
                margin-bottom: 18px;
                backdrop-filter: blur(6px);
            }

            .hero-id {
                display: flex;
                align-items: center;
                gap: 16px;
                margin-bottom: 12px;
            }

            .hero-logo {
                width: 62px;
                height: 62px;
                border-radius: 18px;
                object-fit: cover;
                background: #fff;
                border: 3px solid rgba(255,255,255,.55);
                box-shadow: 0 10px 24px rgba(0,0,0,.2);
                flex-shrink: 0;
            }

            .hero-logo-ph {
                width: 62px;
                height: 62px;
                border-radius: 18px;
                background: rgba(255,255,255,.14);
                border: 1.5px dashed rgba(255,255,255,.5);
                display: grid;
                place-items: center;
                color: #fff;
                font-size: 22px;
                flex-shrink: 0;
            }

            .hero-title {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 25px;
                font-weight: 800;
                line-height: 1.22;
                letter-spacing: -.5px;
                color: #fff;
            }

            .hero-desc {
                font-size: 14px;
                color: rgba(255,255,255,.82);
                line-height: 1.7;
                max-width: 560px;
            }

            .hero-actions {
                display: flex;
                gap: 10px;
                margin-top: 22px;
                flex-wrap: wrap;
            }

            .btn-solid, .btn-ghost {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-family: inherit;
                font-size: 13px;
                font-weight: 600;
                border-radius: 12px;
                padding: 11px 18px;
                cursor: pointer;
                text-decoration: none;
                transition: all var(--dur) var(--ease);
            }

            .btn-solid {
                background: #fff;
                color: var(--indigo-700);
                border: 1px solid transparent;
                box-shadow: 0 8px 20px rgba(0,0,0,.18);
            }

                .btn-solid:hover {
                    transform: translateY(-2px);
                    color: var(--indigo-700);
                    box-shadow: 0 14px 28px rgba(0,0,0,.24);
                }

            .btn-ghost {
                background: rgba(255,255,255,.14);
                color: #fff;
                border: 1px solid rgba(255,255,255,.35);
                backdrop-filter: blur(6px);
            }

                .btn-ghost:hover {
                    background: rgba(255,255,255,.24);
                    color: #fff;
                    transform: translateY(-2px);
                }

            .hero-steps {
                display: flex;
                gap: 22px;
                margin-top: 26px;
                padding-top: 18px;
                border-top: 1px solid rgba(255,255,255,.2);
                flex-wrap: wrap;
            }

            .hstep {
                display: flex;
                align-items: center;
                gap: 9px;
                font-size: 12px;
                font-weight: 600;
                color: rgba(255,255,255,.6);
            }

                .hstep .dot {
                    width: 22px;
                    height: 22px;
                    border-radius: 50%;
                    display: grid;
                    place-items: center;
                    font-size: 11px;
                    background: rgba(255,255,255,.14);
                    border: 1px solid rgba(255,255,255,.3);
                }

                .hstep.done {
                    color: #fff;
                }

                    .hstep.done .dot {
                        background: var(--mint-500);
                        border-color: var(--mint-500);
                    }

                .hstep.active {
                    color: #fff;
                }

                    .hstep.active .dot {
                        background: #fff;
                        color: var(--indigo-700);
                        border-color: #fff;
                    }

            /* ── DEADLINE CARD ──────────────────────────────── */
            .deadline {
                border-radius: var(--r-lg);
                padding: 24px;
                background: var(--glass);
                border: 1px solid var(--line);
                box-shadow: var(--sh-md);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                backdrop-filter: blur(8px);
                -webkit-backdrop-filter: blur(8px);
                position: relative;
                overflow: hidden;
            }

                .deadline::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    right: 0;
                    top: 0;
                    height: 4px;
                    background: linear-gradient(90deg, var(--amber-600), #fbbf24);
                }

                .deadline.danger::before {
                    background: linear-gradient(90deg, var(--rose-600), #fb7185);
                }

                .deadline.safe::before {
                    background: linear-gradient(90deg, var(--mint-600), var(--mint-500));
                }

            .dl-label {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1.1px;
                color: var(--ink-3);
            }

                .dl-label i {
                    color: var(--amber-600);
                    font-size: 14px;
                }

            .dl-big {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 54px;
                font-weight: 800;
                line-height: 1;
                letter-spacing: -2px;
                color: var(--ink);
                margin-top: 12px;
            }

                .dl-big small {
                    font-size: 15px;
                    font-weight: 600;
                    letter-spacing: 0;
                    color: var(--ink-2);
                    margin-left: 6px;
                }

            .dl-msg {
                font-size: 13px;
                color: var(--ink-2);
                margin-top: 8px;
                line-height: 1.55;
            }

            .dl-bar {
                height: 6px;
                background: #eef1f7;
                border-radius: 99px;
                overflow: hidden;
                margin-top: 16px;
            }

                .dl-bar > div {
                    height: 100%;
                    width: 0;
                    border-radius: 99px;
                    background: linear-gradient(90deg, var(--amber-600), #fbbf24);
                    transition: width 1s var(--ease);
                }

            .deadline.danger .dl-bar > div {
                background: linear-gradient(90deg, var(--rose-600), #fb7185);
            }

            .deadline.safe .dl-bar > div {
                background: linear-gradient(90deg, var(--mint-600), var(--mint-500));
            }

            .dl-foot {
                display: flex;
                justify-content: space-between;
                font-size: 11px;
                color: var(--ink-3);
                margin-top: 8px;
                font-weight: 500;
            }

            /* ── STATS ──────────────────────────────────────── */
            .stat-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 16px;
                margin-bottom: 20px;
            }

            .stat-card {
                position: relative;
                background: var(--glass);
                border: 1px solid var(--line);
                border-radius: var(--r-md);
                padding: 20px;
                display: flex;
                align-items: flex-start;
                gap: 16px;
                box-shadow: var(--sh-xs);
                backdrop-filter: blur(8px);
                -webkit-backdrop-filter: blur(8px);
                transition: all var(--dur) var(--ease);
                overflow: hidden;
            }

                .stat-card::after {
                    content: '';
                    position: absolute;
                    left: 20px;
                    right: 20px;
                    bottom: 0;
                    height: 3px;
                    border-radius: 3px 3px 0 0;
                    background: var(--accent, var(--indigo-500));
                    opacity: 0;
                    transition: opacity var(--dur);
                }

                .stat-card:hover {
                    border-color: var(--line-2);
                    box-shadow: var(--sh-md);
                    transform: translateY(-3px);
                }

                    .stat-card:hover::after {
                        opacity: 1;
                    }

            .stat-icon-wrap {
                width: 50px;
                height: 50px;
                border-radius: 15px;
                display: grid;
                place-items: center;
                font-size: 21px;
                flex-shrink: 0;
            }

            .si-blue {
                background: var(--indigo-50);
                color: var(--indigo-600);
                --accent: var(--indigo-500);
            }

            .si-amber {
                background: var(--amber-50);
                color: var(--amber-600);
            }

            .si-teal {
                background: var(--mint-50);
                color: var(--mint-600);
            }

            .stat-card:has(.si-amber) {
                --accent: var(--amber-600);
            }

            .stat-card:has(.si-teal) {
                --accent: var(--mint-500);
            }

            .stat-label {
                font-size: 10px;
                font-weight: 700;
                color: var(--ink-3);
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-bottom: 5px;
            }

            .stat-val {
                font-size: 16px;
                font-weight: 700;
                color: var(--ink);
                line-height: 1.25;
                overflow-wrap: anywhere;
            }

            .stat-hint {
                font-size: 12px;
                color: var(--ink-3);
                margin-top: 3px;
            }

            /* ── CONTENT ────────────────────────────────────── */
            .content-grid {
                display: grid;
                grid-template-columns: minmax(0, 1fr) 340px;
                gap: 20px;
            }

            .panel, .info-panel, .progress-panel {
                background: var(--glass);
                border: 1px solid var(--line);
                border-radius: var(--r-md);
                overflow: hidden;
                box-shadow: var(--sh-xs);
                backdrop-filter: blur(8px);
                -webkit-backdrop-filter: blur(8px);
            }

            .progress-panel {
                padding: 22px;
            }

            .panel-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 18px 22px;
                border-bottom: 1px solid var(--line);
            }

            .panel-head-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .panel-head-ico {
                width: 36px;
                height: 36px;
                border-radius: 11px;
                background: var(--indigo-50);
                display: grid;
                place-items: center;
                font-size: 15px;
                color: var(--indigo-600);
            }

            .panel-title {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 15px;
                font-weight: 700;
                color: var(--ink);
            }

            .panel-count {
                font-size: 11px;
                background: var(--indigo-50);
                color: var(--indigo-600);
                border-radius: 999px;
                padding: 4px 12px;
                font-weight: 700;
            }

            .action-list {
                padding: 16px;
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 12px;
            }

            .action-item {
                position: relative;
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 16px;
                border-radius: var(--r-md);
                text-decoration: none;
                color: var(--ink);
                cursor: pointer;
                border: 1px solid var(--line);
                background: #fff;
                width: 100%;
                text-align: left;
                font-family: inherit;
                transition: all var(--dur) var(--ease);
                overflow: hidden;
            }

                .action-item::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 14px;
                    bottom: 14px;
                    width: 3px;
                    border-radius: 0 3px 3px 0;
                    background: var(--accent, var(--indigo-500));
                    transform: scaleY(0);
                    transition: transform var(--dur) var(--ease);
                }

                .action-item:hover {
                    border-color: var(--indigo-100);
                    box-shadow: 0 14px 30px rgba(79,70,229,.10);
                    transform: translateY(-3px);
                    color: var(--ink);
                    text-decoration: none;
                }

                    .action-item:hover::before {
                        transform: scaleY(1);
                    }

            .action-ico {
                width: 46px;
                height: 46px;
                border-radius: 14px;
                display: grid;
                place-items: center;
                font-size: 19px;
                flex-shrink: 0;
                transition: transform var(--dur) var(--ease);
            }

            .action-item:hover .action-ico {
                transform: scale(1.08) rotate(-4deg);
            }

            .ai-navy {
                background: var(--indigo-50);
                color: var(--indigo-600);
            }

            .ai-gold {
                background: var(--amber-50);
                color: var(--amber-600);
            }

            .ai-teal {
                background: var(--mint-50);
                color: var(--mint-600);
            }

            .ai-slate {
                background: var(--sky-50);
                color: var(--sky-500);
            }

            .action-item:has(.ai-gold) {
                --accent: var(--amber-600);
            }

            .action-item:has(.ai-teal) {
                --accent: var(--mint-500);
            }

            .action-item:has(.ai-slate) {
                --accent: var(--sky-500);
            }

            .action-text {
                flex: 1;
                min-width: 0;
            }

            .action-name {
                font-size: 14px;
                font-weight: 700;
                color: var(--ink);
                margin-bottom: 2px;
            }

            .action-desc {
                font-size: 12px;
                color: var(--ink-3);
                line-height: 1.4;
            }

            .action-arr {
                color: var(--line-2);
                font-size: 14px;
                transition: all var(--dur) var(--ease);
            }

            .action-item:hover .action-arr {
                color: var(--indigo-600);
                transform: translateX(3px);
            }

            .compliance-strip {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-wrap: wrap;
                margin: 0 16px 18px;
                padding-top: 16px;
                border-top: 1px solid var(--line);
            }

            .compliance-chip {
                display: flex;
                align-items: center;
                gap: 6px;
                font-size: 11px;
                font-weight: 600;
                color: var(--ink-2);
                background: var(--soft);
                border: 1px solid var(--line);
                padding: 6px 12px;
                border-radius: 999px;
            }

                .compliance-chip i {
                    color: var(--mint-600);
                    font-size: 12px;
                }

            .side-stack {
                display: flex;
                flex-direction: column;
                gap: 18px;
            }

            .info-head {
                padding: 16px 20px;
                border-bottom: 1px solid var(--line);
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .info-head-dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--indigo-500), var(--sky-500));
            }

            .info-head-title {
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1.1px;
                color: var(--ink-3);
            }

            .info-body {
                padding: 6px 20px 12px;
            }

            .detail-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 11px 0;
                gap: 14px;
            }

                .detail-row + .detail-row {
                    border-top: 1px dashed var(--line);
                }

            .detail-key {
                font-size: 12.5px;
                color: var(--ink-3);
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .detail-key i {
                    font-size: 14px;
                    color: var(--indigo-500);
                }

            .detail-val {
                font-size: 13px;
                font-weight: 600;
                color: var(--ink);
                text-align: right;
                max-width: 180px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

                .detail-val.ok {
                    color: var(--mint-600);
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                }

                    .detail-val.ok::before {
                        content: '';
                        width: 7px;
                        height: 7px;
                        border-radius: 50%;
                        background: var(--mint-500);
                    }

            .prog-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 16px;
            }

            .dental-prog-header {
                flex-direction: column;
                align-items: stretch;
                gap: 14px;
                margin-bottom: 0;
            }

            .prog-title {
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1.1px;
                color: var(--ink-3);
            }

            .ring-row {
                display: flex;
                align-items: center;
                gap: 18px;
                margin-bottom: 16px;
            }

            .ring {
                width: 88px;
                height: 88px;
                border-radius: 50%;
                flex-shrink: 0;
                display: grid;
                place-items: center;
                background: conic-gradient(var(--indigo-600) 0 40%, #e8ecf6 0);
                animation: ringIn .9s var(--ease) both;
            }

            .ring-inner {
                width: 68px;
                height: 68px;
                border-radius: 50%;
                background: #fff;
                display: grid;
                place-items: center;
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 18px;
                font-weight: 800;
                color: var(--indigo-600);
            }

            .ring-text {
                font-size: 13px;
                color: var(--ink-2);
                line-height: 1.5;
            }

                .ring-text strong {
                    display: block;
                    color: var(--ink);
                    font-size: 14px;
                    margin-bottom: 2px;
                }

            @@keyframes ringIn {
                from {
                    opacity: 0;
                    transform: scale(.85) rotate(-30deg);
                }

                to {
                    opacity: 1;
                    transform: scale(1) rotate(0);
                }
            }

            .notice-box {
                display: flex;
                gap: 11px;
                background: var(--sky-50);
                border: 1px solid #bae6fd;
                border-radius: var(--r-sm);
                padding: 13px 15px;
                font-size: 12.5px;
                color: #075985;
                line-height: 1.65;
            }

                .notice-box i {
                    font-size: 16px;
                    color: var(--sky-500);
                    flex-shrink: 0;
                    margin-top: 1px;
                }

            .dental-notice-box {
                border: none;
                border-radius: 0;
                padding: 14px 28px;
                font-size: 12.5px;
                align-items: center;
            }

            .quick-links {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .quick-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 14px 16px;
                border-radius: var(--r-md);
                background: var(--glass);
                border: 1px solid var(--line);
                text-decoration: none;
                color: var(--ink);
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                transition: all var(--dur) var(--ease);
                backdrop-filter: blur(8px);
            }

                .quick-link:hover {
                    background: #fff;
                    border-color: var(--indigo-100);
                    color: var(--indigo-600);
                    text-decoration: none;
                    transform: translateY(-2px);
                    box-shadow: var(--sh-sm);
                }

                .quick-link i {
                    font-size: 17px;
                    color: var(--indigo-500);
                }

                    .quick-link i.ms-auto {
                        color: var(--ink-3);
                        font-size: 13px;
                    }

            .progress-report-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: .6rem;
                padding: 12px 16px;
                width: 100%;
                border: none;
                border-radius: 12px;
                background: linear-gradient(135deg, var(--indigo-500), var(--indigo-700));
                color: #fff;
                font-family: inherit;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                transition: all var(--dur) var(--ease);
                box-shadow: 0 10px 22px rgba(79,70,229,.26);
            }

                .progress-report-btn:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 16px 30px rgba(79,70,229,.34);
                }

                .progress-report-btn:active {
                    transform: translateY(1px);
                }

            /* ── MODALS ─────────────────────────────────────── */
            .modal-content {
                border: 1px solid var(--line);
                border-radius: 24px;
                overflow: hidden;
                box-shadow: 0 30px 80px rgba(11,18,32,.2);
                background: #fff;
            }

            .modal-header {
                background: linear-gradient(180deg, var(--indigo-50), #fff);
                padding: 22px 28px;
                border-bottom: 1px solid var(--line);
                position: relative;
            }

            .modal-header-inner {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .modal-ico {
                width: 46px;
                height: 46px;
                border-radius: 15px;
                background: linear-gradient(135deg, var(--indigo-500), var(--indigo-700));
                display: grid;
                place-items: center;
                font-size: 19px;
                color: #fff;
                box-shadow: 0 8px 18px rgba(79,70,229,.3);
            }

            .modal-title {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 19px;
                font-weight: 800;
                color: var(--ink);
                margin: 0;
                line-height: 1.2;
                letter-spacing: -.3px;
            }

            .modal-sub {
                font-size: 12px;
                color: var(--ink-3);
                margin-top: 3px;
            }

            .modal-body {
                padding: 26px 30px 18px;
            }

                .modal-body p {
                    color: var(--ink-2);
                    font-size: 14px;
                    line-height: 1.75;
                }

                .modal-body strong {
                    color: var(--ink);
                }

            .modal-footer {
                padding: 16px 30px 26px;
                border: none;
                gap: 10px;
            }

            .btn-primary-modal {
                background: linear-gradient(135deg, var(--indigo-500), var(--indigo-700));
                color: #fff;
                border: none;
                border-radius: 12px;
                padding: 11px 24px;
                font-size: 13.5px;
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 8px;
                font-family: inherit;
                transition: all var(--dur) var(--ease);
                box-shadow: 0 8px 20px rgba(79,70,229,.26);
            }

                .btn-primary-modal:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 14px 28px rgba(79,70,229,.34);
                }

            .btn-dismiss, .modal-footer .btn-secondary {
                background: #fff;
                color: var(--ink-2);
                border: 1px solid var(--line-2);
                border-radius: 12px;
                padding: 10px 20px;
                font-size: 13.5px;
                font-weight: 500;
                font-family: inherit;
            }

                .btn-dismiss:hover, .modal-footer .btn-secondary:hover {
                    background: var(--soft);
                    color: var(--ink);
                }

            .modal-footer .btn-primary {
                background: linear-gradient(135deg, var(--indigo-500), var(--indigo-700));
                border: none;
                border-radius: 12px;
                padding: 10px 22px;
                font-weight: 600;
            }

            .form-label {
                font-size: 13px;
                font-weight: 600;
                color: var(--ink-2);
                margin-bottom: 6px;
            }

            .form-control, .form-select {
                font-size: 14px;
                border: 1px solid var(--line-2);
                border-radius: 12px;
                padding: 10px 14px;
                font-family: inherit;
                transition: all var(--dur);
            }

                .form-control:focus, .form-select:focus {
                    border-color: var(--indigo-500);
                    box-shadow: 0 0 0 4px rgba(99,102,241,.14);
                    outline: none;
                }

                .form-control[readonly] {
                    background: var(--soft);
                    color: var(--ink-2);
                }

            .progress-bar {
                background: linear-gradient(90deg, var(--indigo-500), var(--sky-500));
            }

            .modal-fieldset {
                border: 1px solid var(--line) !important;
                border-radius: var(--r-md);
                padding: 18px !important;
                background: var(--soft);
            }

                .modal-fieldset legend {
                    float: none;
                    width: auto;
                    padding: 0 8px;
                    margin: 0;
                    font-size: 12px;
                    font-weight: 700;
                    color: var(--ink-2);
                    text-transform: uppercase;
                    letter-spacing: .8px;
                }

            .logo-upload-row {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .logo-preview {
                width: 76px;
                height: 76px;
                border-radius: 18px;
                object-fit: cover;
                border: 1px solid var(--line);
                background: #fff;
                flex-shrink: 0;
            }

            .logo-preview-placeholder {
                width: 76px;
                height: 76px;
                border-radius: 18px;
                border: 1.5px dashed var(--line-2);
                background: #fff;
                display: grid;
                place-items: center;
                color: var(--ink-3);
                font-size: 26px;
                flex-shrink: 0;
            }

            .logo-upload-btn {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                font-size: 12.5px;
                font-weight: 600;
                color: var(--indigo-600);
                background: #fff;
                border: 1px solid var(--indigo-100);
                border-radius: 10px;
                padding: 8px 14px;
                cursor: pointer;
                transition: all .16s;
            }

                .logo-upload-btn:hover {
                    background: var(--indigo-50);
                }

            .logo-upload-hint {
                font-size: 11px;
                color: var(--ink-3);
                margin-top: 6px;
            }

            .alert-warning {
                background: var(--amber-50);
                border-color: #fde68a;
                color: #92400e;
                border-radius: var(--r-sm);
                font-size: 13.5px;
            }

            .table {
                font-size: 13.5px;
            }

            .table-light {
                --bs-table-bg: var(--soft);
            }

            #locationModal {
                z-index: 1060 !important;
            }

            body > .modal-backdrop {
                z-index: 1055 !important;
            }

            body > .modal {
                z-index: 1060 !important;
            }

            #reportAffiliationType, #reportCourseLevel {
                cursor: pointer;
            }

            /* ── RESPONSIVE ─────────────────────────────────── */
            @@media (max-width: 1200px) {
                .hero-row {
                    grid-template-columns: 1fr;
                }

                .deadline {
                    flex-direction: row;
                    align-items: center;
                    gap: 24px;
                    flex-wrap: wrap;
                }

                    .deadline > div {
                        flex: 1;
                        min-width: 220px;
                    }
            }

            @@media (max-width: 1100px) {
                .content-grid {
                    grid-template-columns: 1fr;
                }

                .side-stack {
                    flex-direction: row;
                    flex-wrap: wrap;
                }

                .info-panel, .progress-panel {
                    flex: 1;
                    min-width: 260px;
                }

                .quick-links {
                    flex: 1 1 100%;
                    flex-direction: row;
                }

                .quick-link {
                    flex: 1;
                }
            }

            @@media (max-width: 1200px) and (min-width: 992px) {
                .sidebar-wrap {
                    width: 240px;
                }

                body.app-sidebar-collapsed .sidebar-wrap {
                    width: 68px;
                }
            }

            @@media (max-width: 991px) {
                .layout {
                    flex-direction: column;
                }

                .sidebar-wrap, body.app-sidebar-collapsed .sidebar-wrap {
                    width: 100%;
                    height: auto;
                    position: relative;
                    top: 0;
                }

                .main {
                    padding: 24px 20px 48px;
                }
            }

            @@media (max-width: 900px) {
                .stat-grid {
                    grid-template-columns: 1fr 1fr;
                }

                .action-list {
                    grid-template-columns: 1fr;
                }
            }

            @@media (max-width: 640px) {
                .stat-grid {
                    grid-template-columns: 1fr;
                }

                .tb-centre, .tb-code {
                    display: none;
                }

                .topbar {
                    padding: 0 16px;
                }

                .hero {
                    padding: 24px 20px;
                }

                .hero-title {
                    font-size: 20px;
                }

                .page-title {
                    font-size: 26px;
                }

                .hero-steps {
                    gap: 14px;
                }
            }

            .fade-up {
                animation: fadeUp .55s var(--ease) both;
            }

            .fade-up-1 {
                animation-delay: .06s;
            }

            .fade-up-2 {
                animation-delay: .12s;
            }

            .fade-up-3 {
                animation-delay: .18s;
            }

            @@keyframes fadeUp {
                from {
                    opacity: 0;
                    transform: translateY(16px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                .fade-up, .ring, .status-dot {
                    animation: none;
                }

                .dl-bar > div {
                    transition: none;
                }
            }

            /* ═══ v3 overrides: blue + gold header, flat open layout ═══ */
            :root {
                --navy: #0b2a6f;
                --royal: #1d4ed8;
                --gold: #f5b301;
                --gold-lt: #fcd34d;
            }

            .gov-strip {
                background: linear-gradient(90deg, var(--gold), var(--gold-lt), var(--gold));
            }

            .topbar {
                background: linear-gradient(100deg, var(--navy) 0%, #12399a 55%, var(--royal) 100%);
                border-bottom: 3px solid var(--gold);
                backdrop-filter: none;
                -webkit-backdrop-filter: none;
                box-shadow: 0 10px 28px rgba(11,42,111,.22);
            }

            .tb-logo {
                border-color: rgba(245,179,1,.7);
                box-shadow: 0 0 0 3px rgba(245,179,1,.18);
            }

            .tb-brand-name {
                color: #fff;
            }

            .tb-brand-sub {
                color: rgba(255,255,255,.6);
            }

            .tb-official-badge {
                color: var(--gold-lt);
                background: rgba(245,179,1,.14);
                border-color: rgba(245,179,1,.45);
            }

            .tb-centre {
                background: rgba(255,255,255,.10);
                border-color: rgba(255,255,255,.22);
            }

            .tb-centre-ico {
                background: var(--gold);
                color: var(--navy);
            }

            .tb-centre-logo {
                border-color: rgba(245,179,1,.6);
            }

            .tb-centre-label {
                color: var(--gold-lt);
            }

            .tb-centre-name {
                color: #fff;
            }

            .tb-code {
                background: var(--gold);
                color: var(--navy);
                border-color: var(--gold);
            }

            .btn-logout {
                background: transparent;
                color: #fff;
                border-color: rgba(255,255,255,.4);
            }

                .btn-logout:hover {
                    background: rgba(255,255,255,.14);
                    border-color: var(--gold);
                    color: #fff;
                    box-shadow: none;
                }

            .wm {
                padding-top: calc(var(--topbar-h) + 3px);
            }

            /* header text block */
            .page-header {
                margin-bottom: 22px;
            }

            .college-line {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-top: 10px;
            }

            .college-line-logo, .college-line-ph {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                object-fit: cover;
                border: 1px solid var(--line);
                background: #fff;
                display: grid;
                place-items: center;
                color: var(--ink-3);
                font-size: 14px;
            }

            .college-line-name {
                font-size: 14.5px;
                font-weight: 600;
                color: var(--ink-2);
            }

            /* deadline: slim open strip */
            .deadline {
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
                gap: 32px;
                flex-wrap: wrap;
                padding: 18px 4px 18px 22px;
                margin-bottom: 8px;
                border: none;
                border-radius: 0;
                box-shadow: none;
                background: transparent;
                backdrop-filter: none;
                -webkit-backdrop-filter: none;
                border-top: 1px solid var(--line);
                border-bottom: 1px solid var(--line);
            }

                .deadline::before {
                    left: 0;
                    right: auto;
                    top: 14px;
                    bottom: 14px;
                    width: 4px;
                    height: auto;
                    border-radius: 4px;
                }

            .dl-main {
                flex: 1;
                min-width: 260px;
            }

            .dl-row {
                display: flex;
                align-items: baseline;
                gap: 16px;
                flex-wrap: wrap;
                margin-top: 4px;
            }

            .dl-big {
                font-size: 38px;
                margin-top: 0;
                letter-spacing: -1.2px;
            }

                .dl-big small {
                    font-size: 13px;
                }

            .dl-msg {
                margin-top: 0;
                font-size: 13px;
            }

            .dl-side {
                width: 320px;
                max-width: 100%;
            }

            .dl-bar {
                margin-top: 0;
            }

            /* stats: one flat metric row */
            .stat-grid {
                gap: 0;
                margin-bottom: 26px;
                border-bottom: 1px solid var(--line);
            }

            .stat-card {
                background: transparent;
                border: none;
                border-radius: 0;
                box-shadow: none;
                backdrop-filter: none;
                -webkit-backdrop-filter: none;
                padding: 20px 26px;
                border-right: 1px solid var(--line);
            }

                .stat-card:first-child {
                    padding-left: 4px;
                }

                .stat-card:last-child {
                    border-right: none;
                }

                .stat-card:hover {
                    box-shadow: none;
                    transform: none;
                    border-color: var(--line);
                }

                .stat-card::after {
                    left: 0;
                    right: 0;
                    height: 2px;
                }

                .stat-card:first-child::after {
                    left: 4px;
                }

            .stat-icon-wrap {
                width: 44px;
                height: 44px;
                border-radius: 50%;
                font-size: 18px;
            }

            /* actions: open list with dividers */
            .panel {
                background: transparent;
                border: none;
                box-shadow: none;
                backdrop-filter: none;
                -webkit-backdrop-filter: none;
                overflow: visible;
            }

            .panel-head {
                padding: 0 0 14px;
                border-bottom: 1px solid var(--line);
            }

            .action-list {
                padding: 0;
                gap: 0 36px;
            }

            .action-item {
                background: transparent;
                border: none;
                border-bottom: 1px solid var(--line);
                border-radius: 0;
                padding: 18px 6px;
            }

                .action-item::before {
                    display: none;
                }

                .action-item:hover {
                    background: linear-gradient(90deg, var(--indigo-50), transparent);
                    box-shadow: none;
                    transform: none;
                }

            .action-ico {
                border-radius: 50%;
            }

            .compliance-strip {
                margin: 20px 0 0;
                border-top: none;
                padding-top: 0;
            }

            /* side column: soft tinted blocks, no borders */
            .info-panel, .progress-panel {
                background: var(--soft);
                border: none;
                box-shadow: none;
                border-radius: 22px;
                backdrop-filter: none;
                -webkit-backdrop-filter: none;
            }

            .info-head {
                border-bottom: none;
                padding-bottom: 4px;
            }

            .quick-link {
                background: transparent;
                border: none;
                border-bottom: 1px solid var(--line);
                border-radius: 0;
                padding: 14px 4px;
                backdrop-filter: none;
            }

                .quick-link:hover {
                    background: transparent;
                    border-color: var(--indigo-100);
                    transform: none;
                    box-shadow: none;
                }

            @@media (max-width: 900px) {
                .stat-card {
                    border-right: none;
                    border-bottom: 1px solid var(--line);
                    padding-left: 4px;
                }

                .stat-grid {
                    border-bottom: none;
                }

                .dl-side {
                    width: 100%;
                }
            }

            /* ═══ v4: gray accents for section highlights ═══ */
            :root {
                --gray-50: #f6f7fa;
                --gray-100: #eef0f5;
                --gray-200: #e1e5ec;
                --gray-300: #cbd1dc;
                --gray-500: #6b7488;
                --gray-700: #3b4254;
            }

            /* deadline strip → gray band with gold-ish accent kept */
            .deadline {
                background: linear-gradient(90deg, var(--gray-100), rgba(238,240,245,.35));
                border-top: none;
                border-bottom: none;
                border-radius: 18px;
                padding: 18px 24px 18px 28px;
            }

                .deadline::before {
                    left: 10px;
                }

            .dl-bar {
                background: var(--gray-300);
            }

            .dl-foot {
                color: var(--gray-500);
            }

            /* stats → gray highlighted band */
            .stat-grid {
                background: var(--gray-50);
                border: 1px solid var(--gray-200);
                border-radius: 20px;
                margin-top: 18px;
                overflow: hidden;
            }

            .stat-card {
                border-right: 1px solid var(--gray-200);
                padding: 20px 26px;
            }

                .stat-card:first-child {
                    padding-left: 26px;
                }

                    .stat-card:first-child::after {
                        left: 0;
                    }

                .stat-card:hover {
                    background: #fff;
                }

            .stat-label {
                color: var(--gray-500);
            }

            /* section headers → gray pill bar */
            .panel-head {
                background: var(--gray-100);
                border: 1px solid var(--gray-200);
                border-radius: 14px;
                padding: 12px 16px;
                margin-bottom: 4px;
            }

            .panel-head-ico {
                background: #fff;
                border: 1px solid var(--gray-200);
            }

            .panel-count {
                background: #fff;
                color: var(--gray-700);
                border: 1px solid var(--gray-200);
            }

            .panel-title, .info-head-title, .prog-title {
                color: var(--gray-700);
            }

            /* action rows: alternate gray hover + gray dividers */
            .action-item {
                border-bottom-color: var(--gray-200);
            }

                .action-item:hover {
                    background: linear-gradient(90deg, var(--gray-100), transparent);
                }

            .action-desc {
                color: var(--gray-500);
            }

            /* side blocks → gray cards with white inner rows */
            .info-panel, .progress-panel {
                background: var(--gray-100);
                border: 1px solid var(--gray-200);
            }

            .info-head {
                background: transparent;
            }

            .detail-row + .detail-row {
                border-top: 1px dashed var(--gray-300);
            }

            .detail-key {
                color: var(--gray-500);
            }

            .notice-box {
                background: #fff;
                border-color: var(--gray-200);
                color: var(--gray-700);
            }

            .ring-inner {
                background: var(--gray-50);
            }

            .ring {
                background: conic-gradient(var(--indigo-600) 0 40%, var(--gray-300) 0);
            }

            /* chips, links, compliance */
            .compliance-chip {
                background: var(--gray-100);
                border-color: var(--gray-200);
                color: var(--gray-700);
            }

            .chip {
                background: var(--gray-50);
                border-color: var(--gray-200);
            }

                .chip.live {
                    background: var(--mint-50);
                    border-color: #a7f3d0;
                }

            .quick-link {
                border-bottom-color: var(--gray-200);
                color: var(--gray-700);
            }

                .quick-link:hover {
                    background: var(--gray-100);
                    border-radius: 12px;
                    border-color: transparent;
                    padding-left: 14px;
                }

            .college-line-name {
                color: var(--gray-700);
            }

            .page-eyebrow {
                color: var(--gray-500);
            }

            /* sidebar sections */
            body .sidebar .sidebar-header {
                background: linear-gradient(180deg, var(--gray-100), #fff) !important;
            }

            body .sidebar .affiliation-dropdown {
                background: var(--gray-100) !important;
                border-color: var(--gray-200) !important;
            }

            body .sidebar .sidebar-footer {
                background: var(--gray-50);
            }

            /* modals */
            .modal-fieldset {
                background: var(--gray-50);
                border-color: var(--gray-200) !important;
            }

            .table-light {
                --bs-table-bg: var(--gray-100);
            }

            @@media (max-width: 900px) {
                .stat-card {
                    border-right: none;
                    border-bottom: 1px solid var(--gray-200);
                }

                    .stat-card:last-child {
                        border-bottom: none;
                    }
            }

            /* ═══ v6: modern sidebar — deep navy glass, gold accents (sidebar only) ═══ */
            body .sidebar {
                background: radial-gradient(260px 200px at 0% 0%, rgba(245,179,1,.14), transparent 70%), radial-gradient(300px 260px at 100% 100%, rgba(59,130,246,.28), transparent 70%), linear-gradient(180deg, #081f55 0%, #0b2a6f 55%, #0e338a 100%) !important;
                color: #fff !important;
                border: none !important;
                border-radius: 0 28px 28px 0 !important;
                box-shadow: 14px 0 40px rgba(8,31,85,.28), inset -1px 0 0 rgba(255,255,255,.08) !important;
                overflow-x: hidden;
            }

                body .sidebar::-webkit-scrollbar {
                    width: 6px;
                }

                body .sidebar::-webkit-scrollbar-thumb {
                    background: rgba(255,255,255,.18) !important;
                    border-radius: 99px;
                }

                body .sidebar::-webkit-scrollbar-track {
                    background: transparent;
                }

                /* header */
                body .sidebar .sidebar-header {
                    background: linear-gradient(180deg, rgba(255,255,255,.09), rgba(255,255,255,0)) !important;
                    border-bottom: 1px solid rgba(255,255,255,.10) !important;
                    backdrop-filter: blur(6px);
                }

                    body .sidebar .sidebar-header::after {
                        background: linear-gradient(90deg, var(--gold), var(--gold-lt) 50%, transparent) !important;
                        height: 2px !important;
                    }

                    body .sidebar .sidebar-header h4 {
                        color: #fff !important;
                        letter-spacing: -.2px;
                    }

                body .sidebar .sidebar-header-sub {
                    color: rgba(255,255,255,.55) !important;
                }

                body .sidebar .sidebar-header-ico {
                    background: linear-gradient(135deg, var(--gold), var(--gold-lt)) !important;
                    border: none !important;
                    color: var(--navy) !important;
                    box-shadow: 0 8px 18px rgba(245,179,1,.35) !important;
                }

                body .sidebar .sidebar-official-badge {
                    background: rgba(245,179,1,.14) !important;
                    border-color: rgba(245,179,1,.4) !important;
                    color: var(--gold-lt) !important;
                }

                body .sidebar .sidebar-section-label,
                body .sidebar .sidebar-footer-label {
                    color: rgba(252,211,77,.8) !important;
                    letter-spacing: 1.4px;
                    font-weight: 700;
                }

                /* links */
                body .sidebar .sidebar-link {
                    position: relative;
                    color: rgba(255,255,255,.82) !important;
                    border-radius: 14px !important;
                    border: 1px solid transparent !important;
                    transition: background .25s var(--ease), transform .25s var(--ease), color .2s, border-color .2s !important;
                }

                    body .sidebar .sidebar-link i:first-child {
                        width: 34px;
                        height: 34px;
                        display: inline-grid;
                        place-items: center;
                        flex-shrink: 0;
                        border-radius: 10px;
                        background: rgba(255,255,255,.08);
                        color: rgba(255,255,255,.75) !important;
                        transition: all .25s var(--ease);
                    }

                    body .sidebar .sidebar-link .notification-nav-icon i,
                    body .sidebar .sidebar-link .chevron {
                        color: rgba(255,255,255,.6) !important;
                    }

                    body .sidebar .sidebar-link:hover {
                        background: rgba(255,255,255,.09) !important;
                        border-color: rgba(255,255,255,.12) !important;
                        color: #fff !important;
                        transform: translateX(3px);
                    }

                        body .sidebar .sidebar-link:hover i:first-child {
                            background: rgba(245,179,1,.22);
                            color: var(--gold-lt) !important;
                            transform: scale(1.06);
                        }

                        body .sidebar .sidebar-link:hover .notification-nav-icon i {
                            color: var(--gold-lt) !important;
                        }

                    body .sidebar .sidebar-link.active {
                        background: linear-gradient(90deg, rgba(245,179,1,.24), rgba(245,179,1,.06)) !important;
                        border-color: rgba(245,179,1,.35) !important;
                        color: #fff !important;
                        font-weight: 600;
                        box-shadow: 0 10px 24px rgba(0,0,0,.18) !important;
                    }

                        body .sidebar .sidebar-link.active::before {
                            content: '';
                            position: absolute;
                            left: -1px;
                            top: 10px;
                            bottom: 10px;
                            width: 4px;
                            border-radius: 0 4px 4px 0;
                            background: linear-gradient(180deg, var(--gold-lt), var(--gold));
                            box-shadow: 0 0 12px rgba(245,179,1,.7);
                        }

                        body .sidebar .sidebar-link.active i:first-child {
                            background: linear-gradient(135deg, var(--gold), var(--gold-lt));
                            color: var(--navy) !important;
                            box-shadow: 0 6px 14px rgba(245,179,1,.4);
                        }

                        body .sidebar .sidebar-link.active .notification-nav-icon i,
                        body .sidebar .sidebar-link.active .chevron {
                            color: var(--gold-lt) !important;
                        }

                    body .sidebar .sidebar-link.expanded {
                        background: rgba(255,255,255,.07) !important;
                    }

                        body .sidebar .sidebar-link.expanded .chevron {
                            color: var(--gold-lt) !important;
                        }

                /* affiliation dropdown */
                body .sidebar .affiliation-dropdown {
                    background: rgba(255,255,255,.06) !important;
                    border: 1px solid rgba(255,255,255,.12) !important;
                    border-radius: 16px !important;
                    backdrop-filter: blur(8px);
                }

                body .sidebar .affiliation-option {
                    color: rgba(255,255,255,.85) !important;
                    border-radius: 10px;
                }

                    body .sidebar .affiliation-option:hover {
                        background: rgba(255,255,255,.11) !important;
                        color: var(--gold-lt) !important;
                    }

                    body .sidebar .affiliation-option i {
                        color: rgba(255,255,255,.5) !important;
                    }

                body .sidebar .affiliation-submenu {
                    background: rgba(4,18,56,.45) !important;
                    border-left: 2px solid rgba(245,179,1,.35);
                    border-radius: 0 0 12px 12px;
                }

                body .sidebar .affiliation-subitem {
                    color: rgba(255,255,255,.75) !important;
                    border-radius: 10px;
                }

                    body .sidebar .affiliation-subitem:hover {
                        background: rgba(255,255,255,.10) !important;
                        color: var(--gold-lt) !important;
                    }

                    body .sidebar .affiliation-subitem.active {
                        background: linear-gradient(135deg, var(--gold), var(--gold-lt)) !important;
                        color: var(--navy) !important;
                        font-weight: 700;
                    }

                    body .sidebar .affiliation-subitem.readonly {
                        color: rgba(255,255,255,.35) !important;
                    }

                body .sidebar .affiliation-loading {
                    color: rgba(255,255,255,.55) !important;
                }

                /* footer */
                body .sidebar .sidebar-footer {
                    background: linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,.22)) !important;
                    border-top: 1px solid rgba(255,255,255,.10) !important;
                }

                body .sidebar .sidebar-action-btn {
                    background: rgba(255,255,255,.07) !important;
                    border: 1px solid rgba(255,255,255,.16) !important;
                    color: #fff !important;
                    border-radius: 12px !important;
                    transition: all .25s var(--ease) !important;
                }

                    body .sidebar .sidebar-action-btn i {
                        color: rgba(255,255,255,.7) !important;
                    }

                    body .sidebar .sidebar-action-btn:hover {
                        background: rgba(255,255,255,.15) !important;
                        border-color: rgba(245,179,1,.6) !important;
                        transform: translateY(-1px);
                    }

                        body .sidebar .sidebar-action-btn:hover i {
                            color: var(--gold-lt) !important;
                        }

                    body .sidebar .sidebar-action-btn.primary {
                        background: linear-gradient(135deg, var(--gold), var(--gold-lt)) !important;
                        border-color: transparent !important;
                        color: var(--navy) !important;
                        font-weight: 700;
                        box-shadow: 0 10px 22px rgba(245,179,1,.28) !important;
                    }

                        body .sidebar .sidebar-action-btn.primary i {
                            color: var(--navy) !important;
                        }

                        body .sidebar .sidebar-action-btn.primary:hover {
                            box-shadow: 0 14px 28px rgba(245,179,1,.42) !important;
                            color: var(--navy) !important;
                        }

                            body .sidebar .sidebar-action-btn.primary:hover i {
                                color: var(--navy) !important;
                            }

                /* collapse handle + badge */
                body .sidebar .sidebar-handle {
                    background: linear-gradient(135deg, var(--gold), var(--gold-lt)) !important;
                    color: var(--navy) !important;
                    border: 3px solid #fff !important;
                    box-shadow: 0 8px 18px rgba(11,42,111,.3) !important;
                    transition: transform .25s var(--ease) !important;
                }

                    body .sidebar .sidebar-handle:hover {
                        transform: scale(1.1);
                    }

                body .sidebar .notification-badge {
                    background: var(--rose-600) !important;
                    color: #fff !important;
                    border: 2px solid #0b2a6f !important;
                }

            /* dynamic deadline card: stays hidden until the schedule says there is a deadline */
            .deadline[hidden] {
                display: none;
            }
    </style>
</head>
<body>

    <!-- Logo watermark -->
    <div class="wm" aria-hidden="true">
        <img src="~/images/newLogo.jpeg" alt="" />
    </div>

    <div class="gov-strip"></div>

    <!-- ── TOPBAR ──────────────────────────────────────────── -->
    <header class="topbar">
        <a class="tb-brand" href="#">
            <div class="tb-logo">
                <img src="~/images/newLogo.jpeg" alt="RGUHS Logo" />
            </div>
            <div class="tb-brand-text">
                <div class="tb-brand-name">
                    RGUHS Portal
                    <span class="tb-official-badge"><i class="bi bi-patch-check-fill"></i> Official</span>
                </div>
                <div class="tb-brand-sub">Affiliation Management</div>
            </div>
        </a>

        <div class="tb-centre">
            @if (!string.IsNullOrWhiteSpace(collegeLogoPath))
            {
                <img src="@Url.Content(collegeLogoPath)" alt="@collegeName logo" class="tb-centre-logo" />
            }
            else
            {
                <div class="tb-centre-ico"><i class="bi bi-buildings-fill"></i></div>
            }
            <div class="tb-centre-inner">
                <div class="tb-centre-label">Institution</div>
                <div class="tb-centre-name" title="@collegeName">@collegeName</div>
            </div>
        </div>

        <div class="tb-right">
            @if (!string.IsNullOrEmpty(collegeCode))
            {
                <span class="tb-code">@collegeCode</span>
            }
            <form asp-action="Logout" asp-controller="Login" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">
                    <i class="bi bi-box-arrow-right"></i>
                    Sign Out
                </button>
            </form>
        </div>
    </header>

    <!-- ── LAYOUT ──────────────────────────────────────────── -->
    <div class="layout">

        @if (!string.IsNullOrEmpty(facultyCode))
        {
            <div class="sidebar-wrap">
                @await Component.InvokeAsync("Sidebar")
            </div>
        }

        <main class="main">

            <!-- Page Header -->
            <div class="page-header fade-up">
                <div>
                    <div class="page-eyebrow">
                        <i class="bi bi-house-door"></i> Home
                        <i class="bi bi-chevron-right"></i>
                        Dashboard
                    </div>
                    <h1 class="page-title"><span id="greeting">Welcome back</span></h1>
                    <div class="college-line">
                        @if (!string.IsNullOrWhiteSpace(collegeLogoPath))
                        {
                            <img src="@Url.Content(collegeLogoPath)" alt="@collegeName logo" class="college-line-logo" />
                        }
                        else
                        {
                            <span class="college-line-ph"><i class="bi bi-building"></i></span>
                        }
                        <span class="college-line-name">@collegeName</span>
                    </div>
                </div>
                <div class="header-chips">
                    <div class="chip"><i class="bi bi-calendar3"></i><span id="todayLabel">Today</span></div>
                    <div class="chip live"><div class="status-dot"></div> Portal Active</div>
                </div>
            </div>

            <!-- Deadline strip -->
            @if (showDeadline)
            {
                <aside class="deadline fade-up fade-up-1" id="deadlineCard" hidden>
                    <div class="dl-main">
                        <div class="dl-label"><i class="bi bi-alarm-fill"></i> <span id="dlLabel">Submission deadline</span></div>
                        <div class="dl-row">
                            <div class="dl-big"><span id="dlDays">–</span><small id="dlUnit">days left</small></div>
                            <div class="dl-msg" id="dlMsg">Loading…</div>
                        </div>
                    </div>
                    <div class="dl-side">
                        <div class="dl-bar"><div id="dlBar"></div></div>
                        <div class="dl-foot"><span id="dlStartLabel"></span><span id="dlEndLabel"></span></div>
                    </div>
                </aside>
            }

            <!-- Stat Cards -->
            <div class="stat-grid fade-up fade-up-2">
                <div class="stat-card">
                    <div class="stat-icon-wrap si-blue"><i class="bi bi-bank2"></i></div>
                    <div>
                        <div class="stat-label">Institution</div>
                        <div class="stat-val">@collegeName</div>
                        <div class="stat-hint">Registered college</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon-wrap si-amber"><i class="bi bi-upc-scan"></i></div>
                    <div>
                        <div class="stat-label">College Code</div>
                        <div class="stat-val">@(string.IsNullOrEmpty(collegeCode) ? "—" : collegeCode)</div>
                        <div class="stat-hint">Unique identifier</div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(facultyName))
                {
                    <div class="stat-card">
                        <div class="stat-icon-wrap si-teal"><i class="bi bi-mortarboard"></i></div>
                        <div>
                            <div class="stat-label">Stream</div>
                            <div class="stat-val">@facultyName</div>
                            <div class="stat-hint">stream</div>
                        </div>
                    </div>
                }
            </div>

            <!-- Content Grid -->
            <div class="content-grid fade-up fade-up-3">

                <!-- Quick Actions -->
                <div class="panel">
                    <div class="panel-head">
                        <div class="panel-head-left">
                            <div class="panel-head-ico"><i class="bi bi-grid-1x2-fill"></i></div>
                            <div class="panel-title">Quick Actions</div>
                        </div>
                        <span class="panel-count">@actionCount actions</span>
                    </div>
                    <div class="action-list">

                        
                        <a href="@Url.Action("Dashboard", "Collegelogin")" class="action-item">
                            <div class="action-ico ai-teal"><i class="bi bi-clipboard-data"></i></div>
                            <div class="action-text">
                                <div class="action-name">Applications</div>
                                <div class="action-desc">Monitor and track submitted applications</div>
                            </div>
                            <i class="bi bi-chevron-right action-arr"></i>
                        </a>
                        <button type="button" class="action-item" onclick="goToChangePassword(event)">
                            <div class="action-ico ai-slate"><i class="bi bi-shield-lock"></i></div>
                            <div class="action-text">
                                <div class="action-name">Security Settings</div>
                                <div class="action-desc">Update your account password</div>
                            </div>
                            <i class="bi bi-chevron-right action-arr"></i>
                        </button>
                        <button type="button" class="action-item" onclick="goToCollegeProfile(event)">
                            <div class="action-ico ai-gold"><i class="bi bi-person-vcard"></i></div>
                            <div class="action-text">
                                <div class="action-name">College Profile</div>
                                <div class="action-desc">View college details and update logo</div>
                            </div>
                            <i class="bi bi-chevron-right action-arr"></i>
                        </button>
                    </div>

                    <div class="compliance-strip">
                        <div class="compliance-chip"><i class="bi bi-shield-fill-check"></i> 256-bit TLS Encrypted</div>
                        <div class="compliance-chip"><i class="bi bi-patch-check-fill"></i> GIGW Compliant</div>
                        <div class="compliance-chip"><i class="bi bi-award-fill"></i> NMC Recognized</div>
                    </div>
                </div>

                <!-- Side Stack -->
                <div class="side-stack">

                    <!-- Account Details -->
                    <div class="info-panel">
                        <div class="info-head">
                            <div class="info-head-dot"></div>
                            <div class="info-head-title">Account Details</div>
                        </div>
                        <div class="info-body">
                            <div class="detail-row">
                                <span class="detail-key"><i class="bi bi-building"></i> College</span>
                                <span class="detail-val" title="@collegeName">@collegeName</span>
                            </div>
                            @if (!string.IsNullOrEmpty(collegeCode))
                            {
                                <div class="detail-row">
                                    <span class="detail-key"><i class="bi bi-upc-scan"></i> Code</span>
                                    <span class="detail-val">@collegeCode</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(facultyName))
                            {
                                <div class="detail-row">
                                    <span class="detail-key"><i class="bi bi-person-badge"></i> Stream</span>
                                    <span class="detail-val">@facultyName</span>
                                </div>
                            }
                            <div class="detail-row">
                                <span class="detail-key"><i class="bi bi-shield-check"></i> Status</span>
                                <span class="detail-val ok">Active</span>
                            </div>
                        </div>
                    </div>

                    <!-- Progress -->
                    @if (facultyCode == "2")
                    {
                        <div class="progress-panel">
                            <div class="prog-header dental-prog-header">
                                <div class="prog-title">Application Completion</div>
                                <button type="button"
                                        class="progress-report-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#dentalApplicationReportModal"
                                        title="View Dental Application Report">
                                    <i class="bi bi-bar-chart-line"></i>
                                    <span>View Dental Report</span>
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="progress-panel">
                            <div class="prog-header">
                                <div class="prog-title">Intake Completion</div>
                            </div>
                            <div class="ring-row">
                                <div class="ring"><div class="ring-inner">40%</div></div>
                                <div class="ring-text">
                                    <strong>In progress</strong>
                                    Remaining intake details are still pending.
                                </div>
                            </div>
                            <div class="notice-box">
                                <i class="bi bi-info-circle-fill"></i>
                                <div>
                                    Ensure all intake details are submitted before the deadline.
                                    Contact the admissions office for any discrepancies.
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Help links -->
                    <div class="quick-links">
                        <a href="#" class="quick-link">
                            <i class="bi bi-file-earmark-text"></i>
                            Application Guidelines
                            <i class="bi bi-arrow-up-right ms-auto"></i>
                        </a>
                        <a href="#" class="quick-link">
                            <i class="bi bi-headset"></i>
                            Contact Support
                            <i class="bi bi-arrow-up-right ms-auto"></i>
                        </a>
                    </div>

                </div>
            </div>

        </main>
    </div>

    @if (facultyCode == "2")
    {
        <div class="modal fade"
             id="dentalApplicationReportModal"
             tabindex="-1"
             aria-labelledby="dentalApplicationReportModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title"
                            id="dentalApplicationReportModalLabel">
                            Dental Application Report
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <div class="notice-box dental-notice-box">

                        <i class="bi bi-info-circle-fill"></i>

                        <div>
                            Select Type of Affiliation and Course Level
                            to view the application completion status.
                        </div>

                    </div>

                    <div class="modal-body d-modal-body">

                        <!-- Type of Affiliation -->
                        <div class="mb-3">

                            <label for="reportAffiliationType"
                                   class="form-label">
                                Type of Affiliation
                            </label>

                            <select id="reportAffiliationType"
                                    class="form-select">

                                <option value="">
                                    -- Select Type of Affiliation --
                                </option>

                                @foreach (var type in ViewBag.AffiliationTypes)
                                {
                                    if (type.Id == 2)
                                    {
                                        <option value="@type.Id" selected>
                                            @type.Name
                                        </option>
                                    }
                                    else
                                    {

                                        <option value="@type.Id" disabled>
                                            @type.Name
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- Course Level -->
                        <div class="mb-3">

                            <label for="reportCourseLevel"
                                   class="form-label">
                                Course Level
                            </label>

                            <select id="reportCourseLevel"
                                    class="form-select">

                                <option value="">
                                    -- Select Course Level --
                                </option>

                                <option value="UG">UG</option>
                                <option value="PG">PG</option>

                            </select>

                        </div>


                        <!-- Loading -->
                        <div id="dentalReportLoading"
                             class="text-center d-none">

                            <div class="spinner-border"
                                 role="status">
                            </div>

                            <div class="mt-2">
                                Fetching application status...
                            </div>

                        </div>


                        <!-- Result -->
                        <div id="dentalReportResult"
                             class="d-none">

                            <hr>

                            <div class="text-center">

                                <div class="text-muted">
                                    Application Completion
                                </div>

                                <div class="display-4 fw-bold"
                                     id="reportPercentage">
                                    0%
                                </div>

                                <div class="progress mt-3"
                                     style="height:12px;">

                                    <div class="progress-bar"
                                         id="reportProgressBar"
                                         style="width:0%;">
                                    </div>

                                </div>

                                <div class="mt-3 text-muted"
                                     id="reportStepCount">
                                    0 of 0 steps completed
                                </div>

                            </div>

                        </div>


                        <!-- Error -->
                        <div id="dentalReportError"
                             class="alert alert-danger d-none">
                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Close
                        </button>

                        <button type="button"
                                class="btn btn-primary"
                                id="btnFetchDentalReport"
                                onclick="fetchDentalApplicationReport()">

                            <i class="bi bi-bar-chart-line"></i>
                            View Status

                        </button>

                    </div>

                </div>

            </div>

        </div>
    }

    <!-- ── AFFILIATION DEADLINE NOTIFICATION ─────────────────── -->
    @* One notification for every faculty: the table is built from dbo.Mst_CourseLevelSchedule by course-schedule.js *@
    @if (!string.IsNullOrEmpty(facultyCode) && ((TempData["ShowAffiliationNotification"] != null && (bool)TempData["ShowAffiliationNotification"]) || ViewBag.ShowAffiliationNotification == true))
    {
        <div class="modal fade" id="affiliationNotificationModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="modal-header-inner">
                            <div class="modal-ico"><i class="bi bi-megaphone-fill"></i></div>
                            <div>
                                <div class="modal-title">Important Affiliation Notification</div>
                                <div class="modal-sub">Please note the application submission deadlines</div>
                            </div>
                        </div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div id="affNoticeBody">Loading…</div>
                    </div>
                    <div class="modal-footer justify-content-center">
                        <button type="button" class="btn-primary-modal" data-bs-dismiss="modal">I Understand</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ── COLLEGE PROFILE MODAL ─────────────────────────────── -->
    <div class="modal fade" id="collegeProfileModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <form id="collegeProfileForm"
                      asp-action="UpdateCollegeProfile"
                      asp-controller="Collegelogin"
                      method="post"
                      enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CollegeCode" value="@collegeCode" />

                    <div class="modal-header">
                        <div class="modal-header-inner">
                            <div class="modal-ico"><i class="bi bi-person-vcard"></i></div>
                            <div>
                                <div class="modal-title">College Profile</div>
                                <div class="modal-sub">Update institution logo</div>
                            </div>
                        </div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">

                        <fieldset class="modal-fieldset mb-4">
                            <legend>College Logo</legend>
                            <div class="logo-upload-row">
                                <img id="logoPreviewImg" class="logo-preview" style="display:none" alt="Logo preview" />
                                <div id="logoPreviewPlaceholder" class="logo-preview-placeholder">
                                    <i class="bi bi-building"></i>
                                </div>
                                <div>
                                    <label for="logoFileInput" class="logo-upload-btn">
                                        <i class="bi bi-upload"></i> Choose Logo
                                    </label>
                                    <input type="file" id="logoFileInput" name="Logo" accept=".jpg,.jpeg,.png,.webp" hidden />
                                    <div class="logo-upload-hint">JPG, PNG or WEBP · up to 5 MB · square image recommended</div>
                                </div>
                            </div>
                        </fieldset>

                        <fieldset class="modal-fieldset">
                            <legend>Institution Details </legend>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="cpCollegeName" class="form-label">College Name</label>
                                    <input type="text" id="cpCollegeName" class="form-control" readonly tabindex="-1" />
                                </div>
                                <div class="col-md-6">
                                    <label for="cpPrincipalName" class="form-label">Principal / Dean Name</label>
                                    <input type="text" id="cpPrincipalName" class="form-control" tabindex="-1" />
                                </div>
                                <div class="col-12">
                                    <label for="cpAddress" class="form-label">Address</label>
                                    <input type="text" id="cpAddress" class="form-control" tabindex="-1" />
                                </div>
                                <div class="col-md-4">
                                    <label for="cpEmail" class="form-label">Email</label>
                                    <input type="email" id="cpEmail" class="form-control" tabindex="-1" />
                                </div>
                                <div class="col-md-4">
                                    <label for="cpPhoneNumber" class="form-label">Phone Number</label>
                                    <input type="text" id="cpPhoneNumber" class="form-control" tabindex="-1" />
                                </div>
                                <div class="col-md-4">
                                    <label for="cpEstablishedYear" class="form-label">Established Year</label>
                                    <input type="text" id="cpEstablishedYear" class="form-control" tabindex="-1" />
                                </div>
                                <div class="col-12">
                                    <label for="cpWebsite" class="form-label">Website</label>
                                    <input type="url" id="cpWebsite" class="form-control" tabindex="-1" />
                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn-dismiss" data-bs-dismiss="modal">Cancel</button>
