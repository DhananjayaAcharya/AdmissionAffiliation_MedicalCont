@model Medical_Affiliation.Models.ActionTakenDeficiencyReportViewModel

@{
    ViewData["Title"] = "Action Taken Deficiency Report";
    Layout = "~/Views/Shared/_CaLayout.cshtml";

    var isEdit = Model.ActionTakenDeficiencyReportId > 0;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    .page-wrapper {
        padding-top: 0;
    }

    .page-header {
        background: linear-gradient(135deg, #0d6efd, #084298);
        color: #fff;
        border-radius: 14px;
        padding: 22px 25px;
        margin-bottom: 22px;
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
    }

    .page-header h4 {
        margin: 0;
        font-weight: 600;
    }

    .page-header p {
        margin: 5px 0 0;
        opacity: .9;
        font-size: .92rem;
    }

    .panel {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(0,0,0,.06);
        border: 1px solid #e9ecef;
        margin-bottom: 22px;
    }

    .panel-header {
        padding: 16px 20px;
        border-bottom: 1px solid #e9ecef;
        font-weight: 600;
        color: #212529;
    }

    .panel-body {
        padding: 22px;
    }

    .section-title {
        font-size: 1rem;
        font-weight: 600;
        color: #0d6efd;
        margin-bottom: 15px;
    }

    .form-label {
        font-weight: 500;
        color: #343a40;
    }

    .required::after {
        content: " *";
        color: #dc3545;
    }

    textarea.form-control {
        min-height: 110px;
        resize: vertical;
    }

    .file-info {
        font-size: .82rem;
        color: #6c757d;
        margin-top: 5px;
    }

    .btn-action {
        min-width: 100px;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .record-text {
        white-space: pre-line;
        max-width: 450px;
        line-height: 1.5;
    }

    .report-link {
        text-decoration: none;
        font-size: .9rem;
    }

    .report-link:hover {
        text-decoration: underline;
    }

    .empty-state {
        padding: 45px 20px;
        text-align: center;
        color: #6c757d;
    }

    .empty-state i {
        font-size: 2.5rem;
        opacity: .5;
    }

    .table thead th {
        background: #f8f9fa;
        font-size: .88rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .table tbody td {
        vertical-align: middle;
    }
</style>


<div class="page-wrapper">

    <!-- ============================================================
         PAGE HEADER
    ============================================================= -->
    <div class="page-header">
        <div class="d-flex align-items-center gap-3">
            <div>
                <i class="bi bi-clipboard-check fs-2"></i>
            </div>

            <div>
                <h4>Action Taken Deficiency Report</h4>
                <p>
                    Give particulars of action taken to correct the deficiencies,
                    if any, pointed out during the previous inspection.
                </p>
            </div>
        </div>
    </div>


    <!-- ============================================================
         INFORMATION
    ============================================================= -->
    <div class="panel">
        <div class="panel-header">
            <i class="bi bi-info-circle me-2 text-primary"></i>
            Action Taken Report
        </div>

        <div class="panel-body">

            <p class="mb-0 text-muted">
                Give particulars of action taken to correct the deficiencies,
                if any, pointed out during the previous inspection by any of
                the bodies mentioned in Section B of Part 1.
                Please attach a copy of the relevant report.
            </p>

        </div>
    </div>


    <!-- ============================================================
         ADD / EDIT FORM
    ============================================================= -->
    <div class="panel">

        <div class="panel-header d-flex justify-content-between align-items-center">

            <span>
                <i class="bi bi-file-earmark-text me-2 text-primary"></i>

                @(isEdit
                    ? "Edit Action Taken Report"
                    : "Add Action Taken Report")
            </span>

            @if (isEdit)
            {
                <a asp-action="Index"
                   class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i>
                    Cancel Edit
                </a>
            }

        </div>


        <div class="panel-body">

            <form asp-action="@(isEdit ? "Edit" : "Create")"
                  method="post"
                  enctype="multipart/form-data"
                  id="actionTakenForm">

                @Html.AntiForgeryToken()

                @if (isEdit)
                {
                    <input type="hidden"
                           name="id"
                           value="@Model.ActionTakenDeficiencyReportId" />
                }


                <!-- ------------------------------------------------
                     DEFICIENCY
                ------------------------------------------------- -->
                <div class="mb-4">

                    <div class="section-title">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Deficiency Pointed Out
                    </div>

                    <label class="form-label required">
                        Deficiencies pointed out in the last inspection by
                    </label>

                    <textarea class="form-control"
                              name="deficiencyPointedOut"
                              id="deficiencyPointedOut"
                              placeholder="Enter the deficiency pointed out during the last inspection..."
                              maxlength="5000">@Model.DeficiencyPointedOut</textarea>

                    <div class="file-info">
                        Mention the deficiency as recorded in the previous inspection report.
                    </div>

                </div>


                <!-- ------------------------------------------------
                     EXTENT REMEDIED
                ------------------------------------------------- -->
                <div class="mb-4">

                    <div class="section-title">
                        <i class="bi bi-check2-circle me-1"></i>
                        Extent to Which Remedied
                    </div>

                    <label class="form-label required">
                        Extent to which remedied
                    </label>

                    <textarea class="form-control"
                              name="extentRemedied"
                              id="extentRemedied"
                              placeholder="Enter the action taken and extent to which the deficiency has been remedied..."
                              maxlength="5000">@Model.ExtentRemedied</textarea>

                </div>


                <!-- ------------------------------------------------
                     REPORT UPLOAD
                ------------------------------------------------- -->
                <div class="mb-4">

                    <div class="section-title">
                        <i class="bi bi-file-earmark-pdf me-1"></i>
                        Relevant Inspection Report
                    </div>

                    <label class="form-label">
                        Attach a copy of the relevant report
                    </label>

                    <input type="file"
                           class="form-control"
                           name="relevantReportFile"
                           id="relevantReportFile"
                           accept=".pdf" />

                    <div class="file-info">
                        PDF only. Maximum file size: 1 MB.
                    </div>


                    @if (!string.IsNullOrWhiteSpace(Model.RelevantReportPath))
                    {
                        <div class="mt-3 p-3 bg-light rounded border">

                            <div class="d-flex align-items-center justify-content-between">

                                <div>
                                    <i class="bi bi-file-earmark-pdf text-danger me-2"></i>

                                    <span class="fw-semibold">
                                        Existing Report
                                    </span>
                                </div>

                                <a href="@Model.RelevantReportPath"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>
                                    View Report
                                </a>

                            </div>

                            @if (isEdit)
                            {
                                <div class="small text-muted mt-2">
                                    Leave the file empty if you want to keep the existing report.
                                </div>
                            }

                        </div>
                    }

                </div>


                <!-- ------------------------------------------------
                     BUTTONS
                ------------------------------------------------- -->
                <div class="d-flex justify-content-end gap-2">

                    @if (isEdit)
                    {
                        <a asp-action="Index"
                           class="btn btn-outline-secondary btn-action">
                            <i class="bi bi-x-circle me-1"></i>
                            Cancel
                        </a>
                    }

                    <button type="submit"
                            class="btn btn-primary btn-action">

                        @if (isEdit)
                        {
                            <i class="bi bi-check2-circle me-1"></i>
                            <span>Update</span>
                        }
                        else
                        {
                            <i class="bi bi-plus-circle me-1"></i>
                            <span>Save</span>
                        }

                    </button>

                </div>

            </form>

        </div>
    </div>


    <!-- ============================================================
         EXISTING RECORDS
    ============================================================= -->
    <div class="panel">

        <div class="panel-header d-flex justify-content-between align-items-center">

            <span>
                <i class="bi bi-list-check me-2 text-primary"></i>
                Previous Inspection Deficiencies
            </span>

            <span class="badge bg-primary">
                @(Model.ActionTakenDeficiencyRecords?.Count ?? 0)
            </span>

        </div>


        <div class="panel-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>

                            <th class="ps-4" style="width:35%;">
                                Deficiencies Pointed Out
                            </th>

                            <th style="width:35%;">
                                Extent to Which Remedied
                            </th>

                            <th style="width:15%;">
                                Relevant Report
                            </th>

                            <th class="text-end pe-4" style="width:15%;">
                                Actions
                            </th>

                        </tr>
                    </thead>


                    <tbody>

                        @if (Model.ActionTakenDeficiencyRecords == null ||
                             !Model.ActionTakenDeficiencyRecords.Any())
                        {
                            <tr>
                                <td colspan="4">

                                    <div class="empty-state">

                                        <div class="mb-2">
                                            <i class="bi bi-inbox"></i>
                                        </div>

                                        <div class="fw-semibold">
                                            No deficiency records found.
                                        </div>

                                        <div class="small mt-1">
                                            Add the deficiencies identified during the previous inspection.
                                        </div>

                                    </div>

                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.ActionTakenDeficiencyRecords)
                            {
                                <tr>

                                    <!-- Deficiency -->
                                    <td class="ps-4">
                                        <div class="record-text">
                                            @item.DeficiencyPointedOut
                                        </div>
                                    </td>


                                    <!-- Extent remedied -->
                                    <td>
                                        <div class="record-text">
                                            @item.ExtentRemedied
                                        </div>
                                    </td>


                                    <!-- Report -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.RelevantReportPath))
                                        {
                                            <a href="@item.RelevantReportPath"
                                               target="_blank"
                                               class="report-link">

                                                <i class="bi bi-file-earmark-pdf text-danger me-1"></i>
                                                View Report

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                Not attached
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td class="text-end pe-4">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.ActionTakenDeficiencyReportId"
                                           class="btn btn-sm btn-outline-primary action-btn me-1"
                                           title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <form asp-action="Delete"
                                              asp-route-id="@item.ActionTakenDeficiencyReportId"
                                              method="post"
                                              class="d-inline delete-report-form">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger action-btn"
                                                    title="Remove">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- ================================================================
     SWEETALERT
================================================================ -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

    document.addEventListener("DOMContentLoaded", function() {

        const form = document.getElementById("actionTakenForm");

        if (form) {

            form.addEventListener("submit", function(e) {

                const deficiency =
                    document.getElementById("deficiencyPointedOut").value.trim();

                const extent =
                    document.getElementById("extentRemedied").value.trim();

                const fileInput =
                    document.getElementById("relevantReportFile");


                // ----------------------------------------------------
                // Deficiency validation
                // ----------------------------------------------------

                if (!deficiency) {

                    e.preventDefault();

                    Swal.fire({
                        icon: "warning",
                        title: "Deficiency Required",
                        text: "Please enter the deficiency pointed out during the last inspection.",
                        confirmButtonText: "OK"
                    });

                    return;
                }


                // ----------------------------------------------------
                // Extent remedied validation
                // ----------------------------------------------------

                if (!extent) {

                    e.preventDefault();

                    Swal.fire({
                        icon: "warning",
                        title: "Extent Required",
                        text: "Please enter the extent to which the deficiency was remedied.",
                        confirmButtonText: "OK"
                    });

                    return;
                }


                // ----------------------------------------------------
                // File validation
                // ----------------------------------------------------

                if (fileInput &&
                    fileInput.files.length > 0) {

                    const file =
                        fileInput.files[0];

                    const fileName =
                        file.name.toLowerCase();

                    const maxSize =
                        1 * 1024 * 1024;


                    if (!fileName.endsWith(".pdf")) {

                        e.preventDefault();

                        Swal.fire({
                            icon: "error",
                            title: "Invalid File",
                            text: "Only PDF files are allowed.",
                            confirmButtonText: "OK"
                        });

                        return;
                    }


                    if (file.size > maxSize) {

                        e.preventDefault();

                        Swal.fire({
                            icon: "error",
                            title: "File Too Large",
                            text: "Report file size must not exceed 1 MB.",
                            confirmButtonText: "OK"
                        });

                        return;
                    }

                }


                // ----------------------------------------------------
                // Confirmation
                // ----------------------------------------------------

                e.preventDefault();

                const isEdit =
                        @isEdit.ToString().ToLower();

                Swal.fire({
                    icon: "question",
                    title: isEdit
                        ? "Update Report?"
                        : "Save Report?",

                    text: isEdit
                        ? "Do you want to update this action taken report?"
                        : "Do you want to save this action taken report?",

                    showCancelButton: true,

                    confirmButtonText: isEdit
                        ? "Yes, Update"
                        : "Yes, Save",

                    cancelButtonText: "Cancel",

                    reverseButtons: true
                }).then((result) => {

                    if (result.isConfirmed) {
                        form.submit();
                    }

                });

            });

        }


        // ------------------------------------------------------------
        // DELETE CONFIRMATION
        // ------------------------------------------------------------

        document.querySelectorAll(".delete-report-form")
            .forEach(function(deleteForm) {

                deleteForm.addEventListener("submit", function(e) {

                    e.preventDefault();

                    Swal.fire({

                        icon: "warning",

                        title: "Remove Report?",

                        text: "Are you sure you want to remove this deficiency record?",

                        showCancelButton: true,

                        confirmButtonText: "Yes, Remove",

                        cancelButtonText: "Cancel",

                        reverseButtons: true

                    }).then((result) => {

                        if (result.isConfirmed) {

                            deleteForm.submit();

                        }

                    });

                });

            });


        // ------------------------------------------------------------
        // TEMP DATA MESSAGES
        // ------------------------------------------------------------

        @if (TempData["Success"] != null)
            {
                <text>

                    Swal.fire({
                        icon: "success",
                        title: "Success",
                        text: "@Html.Raw(TempData["Success"])",
                        confirmButtonText: "OK"
                    });

                </text>
        }

            @if (TempData["Error"] != null)
            {
                <text>
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: "@Html.Raw(TempData["Error"])",
                        confirmButtonText: "OK"
                    });
                </text>
        }

        });

</script>